                        newVal = c.Value
                    end
                    if c.Path and c.Path ~= "" then
                        local inst = GetInstanceByPath(c.Path)
                        newVal = ExtractValueFromInstance(inst)
                    end
                    if c.Raw or c.RawUrl or c.Link or c.Url then
                        local url = c.Raw or c.RawUrl or c.Link or c.Url
                        local key = c.Key or c.JsonKey or c.PathKey or ""
                        -- اذا رابط راو وفيه Value ثابت لا نتجاهله، الراو له اولوية اذا موجود
                        if IsUrlImage(url) or tostring(url):match("^https?://") then
