-- Create a single element row. Used by Tab for every control type.
local function buildElementRow(windowController, tabController, elementName, elementHeight)
	local elementContainer = createInstance("Frame", {
		Name = elementName or "Element",
		Size = UDim2.new(1, -16, 0, elementHeight or 44),
		BackgroundColor3 = windowController.activeTheme.ElementBackground,
		BorderSizePixel = 0,
	}, tabController.elementContainer)
	addCorner(elementContainer, 10)
	addStroke(elementContainer, windowController.activeTheme.Stroke, 1, 0.85)
	local padding = createInstance("UIPadding", {
		PaddingLeft = UDim.new(0, 12),
		PaddingRight = UDim.new(0, 12),
		PaddingTop = UDim.new(0, 6),
		PaddingBottom = UDim.new(0, 6),
	}, elementContainer)
	return elementContainer, padding
end

local function runGuardedCallback(windowController, control, callback, ...)
	if type(callback) ~= "function" then return end
	local ok, err = pcall(callback, ...)
	if not ok then
		warn("[GGH] Callback error in '" .. tostring(control.name or control.__type or "element") .. "': " .. tostring(err))
		if windowController.Notify then
			windowController:Notify({ title = "GGH - Error", content = "An error was recorded in the console." })
		end
	end
end

