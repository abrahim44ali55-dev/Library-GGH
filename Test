        FloatingIcon.InputBegan:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                dragging = true
                hasDragged = false
                dragStartPos = input.Position
                startGuiPos = FloatingIcon.Position
            end
        end)
        local function ClampMainFloat(pos)
            local vp = ScreenGui.AbsoluteSize
            if vp.X < 10 or vp.Y < 10 then
                vp = workspace.CurrentCamera and workspace.CurrentCamera.ViewportSize or Vector2.new(1920,1080)
            end
            local sz = FloatingIcon.AbsoluteSize
            if sz.X < 10 then sz = Vector2.new(40,40) end
            local x = pos.X.Offset
            local y = pos.Y.Offset
            x = math.clamp(x, 4, vp.X - sz.X - 4)
            y = math.clamp(y, 4, vp.Y - sz.Y - 4)
            return UDim2.fromOffset(x, y)
        end
        UserInputService.InputChanged:Connect(function(input)
            if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
                local delta = input.Position - dragStartPos
                if delta.Magnitude > 5 then hasDragged = true end
                local rawPos = UDim2.new(startGuiPos.X.Scale, startGuiPos.X.Offset + delta.X, startGuiPos.Y.Scale, startGuiPos.Y.Offset + delta.Y)
                FloatingIcon.Position = ClampMainFloat(rawPos)
            end
        end)
        -- loop حماية اضافية
        task.spawn(function()
            while FloatingIcon and FloatingIcon.Parent do
                local vp = ScreenGui.AbsoluteSize
                if vp.X > 10 then
                    local sz = FloatingIcon.AbsoluteSize
                    if sz.X > 10 then
                        local absPos = FloatingIcon.AbsolutePosition
                        local clampedX = math.clamp(absPos.X, 4, vp.X - sz.X - 4)
                        local clampedY = math.clamp(absPos.Y, 4, vp.Y - sz.Y - 4)
                        if absPos.X ~= clampedX or absPos.Y ~= clampedY then
                            FloatingIcon.Position = UDim2.fromOffset(clampedX, clampedY)
                        end
                    end
                end
                task.wait(0.2)
            end
        end)
        UserInputService.InputEnded:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                dragging = false
                task.wait(0.05)
                hasDragged = false
            end
        end)
