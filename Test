        local function IsUrlImage(str)
            if not str then return false end
            str = tostring(str):lower()
            return str:match("^https?://") ~= nil
        end

        local function ResolveImageAsset(inputStr)
            if not inputStr or inputStr == "" then return "" end
            local s = tostring(inputStr)
            -- اذا رابط مباشر png/jpg/webp/gif
            if IsUrlImage(s) then
                return s
            end
            -- اذا rbxassetid كامل
            if s:match("rbxassetid://%d+") then
                return s
            end
            -- استخرج الايدي
            local id = s:match("id=(%d+)") or s:match("rbxassetid://(%d+)") or s:match("(%d+)")
            if id then
                return "rbxassetid://"..id
            end
            -- اذا رابط لكن بدون https ؟ جرب ارجاعه كما هو
            return s
        end

