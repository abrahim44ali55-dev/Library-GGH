local function clampNumber(value, minValue, maxValue)
	if value < minValue then return minValue end
	if value > maxValue then return maxValue end
	return value
end

local function hexToColor3(hex)
	hex = string.gsub(hex, "#", "")
	local r = tonumber(string.sub(hex, 1, 2), 16) or 255
	local g = tonumber(string.sub(hex, 3, 4), 16) or 255
	local b = tonumber(string.sub(hex, 5, 6), 16) or 255
	return Color3.fromRGB(r, g, b)
end

local function tween(instance, duration, properties, easingStyle, easingDirection)
	local info = TweenInfo.new(
		duration or 0.22,
		easingStyle or Enum.EasingStyle.Quint,
		easingDirection or Enum.EasingDirection.Out
	)
	local tweenObject = TweenService:Create(instance, info, properties)
	tweenObject:Play()
	return tweenObject
end

local function createInstance(className, properties, parent)
	local instance = Instance.new(className)
	for propertyName, propertyValue in pairs(properties or {}) do
		if propertyName ~= "Parent" then
			pcall(function() instance[propertyName] = propertyValue end)
		end
	end
	if parent then
		instance.Parent = parent
	end
	return instance
end

local function addCorner(instance, radius)
	return createInstance("UICorner", { CornerRadius = UDim.new(0, radius or 10) }, instance)
end

local function addStroke(instance, color, thickness, transparency)
	return createInstance("UIStroke", {
		Color = color,
		Thickness = thickness or 1,
		Transparency = transparency or 0.85,
		ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
	}, instance)
end

local function getProp(props, ...)
	for _, key in ipairs({...}) do
		if props[key] ~= nil then return props[key] end
	end
	return nil
end


