    local function ApplyTheme(themeName)
        local theme = Themes[themeName]
        if not theme then return end
        local function GetLum(c) return 0.299*c.R+0.587*c.G+0.114*c.B end
        local lum = GetLum(theme.MainBg)
        if lum > 0.5 then
            theme.Text = Color3.fromRGB(20,20,25)
            theme.SubText = Color3.fromRGB(80,80,85)
            theme.SectionText = Color3.fromRGB(100,100,105)
            theme.ParagraphText = Color3.fromRGB(40,40,45)
        else
            theme.Text = Color3.fromRGB(240,240,245)
            theme.SubText = Color3.fromRGB(180,180,190)
            theme.SectionText = Color3.fromRGB(150,150,160)
            theme.ParagraphText = Color3.fromRGB(220,220,230)
        end
        CurrentTheme = theme
        -- تحديث فوري وكامل لكل شي بدون انتظار
        Main.BackgroundColor3 = theme.MainBg
        Header.BackgroundColor3 = theme.HeaderBg
        HeaderFix.BackgroundColor3 = theme.HeaderBg
        TabList.BackgroundColor3 = theme.TabListBg
        AccentLine.BackgroundColor3 = theme.Accent
        TabList.ScrollBarImageColor3 = theme.Accent
        ThemeList.ScrollBarImageColor3 = theme.Accent
        MainStroke.Color = theme.Stroke
        TitleLabel.TextColor3 = theme.Text
        SubLabel.TextColor3 = theme.SubText
        if SearchBtn then SearchBtn.BackgroundColor3 = theme.ElementBg2; SearchBtn.TextColor3 = theme.Text end
        if ThemeBtn then ThemeBtn.BackgroundColor3 = theme.ElementBg2; ThemeBtn.TextColor3 = theme.Text end
        MinBtn.BackgroundColor3 = theme.ElementBg2
        MinBtn.TextColor3 = theme.Text
        MaxBtn.BackgroundColor3 = theme.ElementBg2
        MaxBtn.TextColor3 = theme.Text
        if FloatBtn then FloatBtn.BackgroundColor3 = floatEnabled and theme.Accent or theme.ElementBg2; FloatBtn.TextColor3 = theme.Text end
        CloseBtn.BackgroundColor3 = theme.CloseBg
        CloseBtn.TextColor3 = theme.CloseText
        SearchBar.BackgroundColor3 = theme.ElementBg
        SBStroke.Color = theme.Accent
        SearchBox.TextColor3 = theme.Text
        SearchBox.PlaceholderColor3 = theme.SubText
        SearchClose.BackgroundColor3 = theme.ElementBg2
        SearchClose.TextColor3 = theme.Text
        ThemeDropdown.BackgroundColor3 = theme.ElementBg
        ConfirmBox.BackgroundColor3 = theme.ElementBg
        CT.TextColor3 = theme.Text
        CT2.TextColor3 = theme.SubText
        YesBtn.BackgroundColor3 = theme.Accent
        NoBtn.BackgroundColor3 = theme.ElementBg2
        NoBtn.TextColor3 = theme.Text
        -- حدث كل العناصر المسجلة فورا + توين خفيف
        for _, item in ipairs(ThemableElements) do
            if item.obj and item.obj.Parent then
                if item.prop == "BackgroundColor3" then
                    item.obj.BackgroundColor3 = theme[item.key]
                    Tween(item.obj, {BackgroundColor3 = theme[item.key]}, 0.15)
                elseif item.prop == "TextColor3" then
                    item.obj.TextColor3 = theme[item.key]
                elseif item.prop == "Stroke" then
                    item.obj.Color = theme[item.key]
                elseif item.prop == "ScrollBar" then
                    item.obj.ScrollBarImageColor3 = theme.Accent
                end
            end
        end
        -- حدث كل الفريمات داخل الصفحات بشكل مباشر (للعناصر اللي ما تسجلت)
        for _, page in ipairs(Container:GetChildren()) do
            if page:IsA("ScrollingFrame") then
                for _, v in ipairs(page:GetDescendants()) do
                    if v:IsA("Frame") then
                        if v.BackgroundColor3 == CurrentTheme.ElementBg or v.BackgroundColor3 == CurrentTheme.ElementBg2 or v.BackgroundColor3 == CurrentTheme.TabListBg then
                            -- لا نغير الاكسنت
                        end
                    end
                end
                page.ScrollBarImageColor3 = theme.Accent
            end
        end
        -- حدث ازرار التابات
        for _, t in pairs(Tabs) do
            if t.Button then
                if t.Page and t.Page.Visible then
                    t.Button.BackgroundColor3 = theme.Accent
                    t.Button.TextColor3 = Color3.fromRGB(255,255,255)
                    local ic = t.Button:FindFirstChild("TabIcon")
                    if ic then ic.ImageColor3 = Color3.fromRGB(255,255,255) end
                else
                    t.Button.BackgroundColor3 = theme.ElementBg
                    t.Button.TextColor3 = Color3.fromRGB(170,170,180)
                    local ic2 = t.Button:FindFirstChild("TabIcon")
                    if ic2 then ic2.ImageColor3 = Color3.fromRGB(170,170,180) end
                end
            end
        end
    end

