    local HeaderFix = Instance.new("Frame", Header)
    HeaderFix.Size = UDim2.new(1,0,0,12)
    HeaderFix.Position = UDim2.new(0,0,1,-6)
    HeaderFix.BackgroundColor3 = CurrentTheme.HeaderBg
    HeaderFix.BorderSizePixel = 0

    local TitleLabel = Instance.new("TextLabel", Header)
    TitleLabel.Size = UDim2.new(1,-20,1,0)
    TitleLabel.Position = UDim2.new(0,15,0,0)
    TitleLabel.BackgroundTransparency = 1
    TitleLabel.Text = Title
    TitleLabel.Font = Enum.Font.GothamBold
    TitleLabel.TextSize = 16
    TitleLabel.TextColor3 = CurrentTheme.Text
    TitleLabel.TextXAlignment = Enum.TextXAlignment.Left

    local Desc = Instance.new("TextLabel", Main)
    Desc.Size = UDim2.new(1,-30,0,20)
    Desc.Position = UDim2.new(0,15,0,58)
    Desc.BackgroundTransparency = 1
    Desc.Text = Description
    Desc.Font = Enum.Font.Gotham
    Desc.TextSize = 12
    Desc.TextColor3 = CurrentTheme.SubText
    Desc.TextXAlignment = Enum.TextXAlignment.Left

    local InputFrame = Instance.new("Frame", Main)
    InputFrame.Size = UDim2.new(1,-30,0,42)
    InputFrame.Position = UDim2.new(0,15,0,88)
    InputFrame.BackgroundColor3 = CurrentTheme.ElementBg
    Corner(InputFrame, 8)
    Stroke(InputFrame, CurrentTheme.StrokeLight, 1)

    local InputBox = Instance.new("TextBox", InputFrame)
    InputBox.Size = UDim2.new(1,-16,1,0)
    InputBox.Position = UDim2.new(0,8,0,0)
    InputBox.BackgroundTransparency = 1
    InputBox.PlaceholderText = "Enter Key Here..."
    InputBox.Text = ""
    InputBox.Font = Enum.Font.Gotham
    InputBox.TextSize = 13
    InputBox.TextColor3 = CurrentTheme.Text
    InputBox.PlaceholderColor3 = CurrentTheme.SubText
    InputBox.ClearTextOnFocus = false

    local StatusLabel = Instance.new("TextLabel", Main)
    StatusLabel.Size = UDim2.new(1,-30,0,18)
    StatusLabel.Position = UDim2.new(0,15,0,135)
    StatusLabel.BackgroundTransparency = 1
    StatusLabel.Text = ""
    StatusLabel.Font = Enum.Font.GothamMedium
    StatusLabel.TextSize = 11
    StatusLabel.TextColor3 = Color3.fromRGB(255,100,100)
    StatusLabel.TextXAlignment = Enum.TextXAlignment.Left

    local SubmitBtn = Instance.new("TextButton", Main)
    SubmitBtn.Size = UDim2.new(1,-30,0,40)
    SubmitBtn.Position = UDim2.new(0,15,0,160)
    SubmitBtn.BackgroundColor3 = CurrentTheme.Accent
    SubmitBtn.Text = "Unlock"
    SubmitBtn.Font = Enum.Font.GothamBold
    SubmitBtn.TextSize = 14
    SubmitBtn.TextColor3 = Color3.new(1,1,1)
    Corner(SubmitBtn, 8)

    local BottomRow = Instance.new("Frame", Main)
    BottomRow.Size = UDim2.new(1,-30,0,38)
    BottomRow.Position = UDim2.new(0,15,0,210)
    BottomRow.BackgroundTransparency = 1

    local function CreateBottomBtn(text, pos, size)
        local btn = Instance.new("TextButton", BottomRow)
        btn.Size = size
        btn.Position = pos
        btn.BackgroundColor3 = CurrentTheme.ElementBg2
        btn.Text = text
        btn.Font = Enum.Font.GothamMedium
        btn.TextSize = 12
        btn.TextColor3 = CurrentTheme.Text
        Corner(btn, 8)
        Stroke(btn, CurrentTheme.Stroke, 1)
        return btn
    end

    local GetKeyBtn = CreateBottomBtn("Get Key", UDim2.new(0,0,0,0), UDim2.new(0.5,-4,1,0))
    local DiscordBtn = CreateBottomBtn("Copy Server", UDim2.new(0.5,4,0,0), UDim2.new(0.5,-4,1,0))

    pcall(function()
        if SaveKey and isfile and isfile(FileName) then
            local saved = readfile(FileName)
            if saved and saved ~= "" then
                InputBox.Text = saved
                local valid = ValidateKey(saved)
                if valid then
                    ScreenGui:Destroy()
                    OnSuccess(saved)
                    return
                end
            end
        end
    end)

    local function SetStatus(text, color)
        StatusLabel.Text = text
        StatusLabel.TextColor3 = color or Color3.fromRGB(255,100,100)
    end

    SubmitBtn.MouseButton1Click:Connect(function()
        local key = InputBox.Text
        if key == "" then SetStatus("Please enter a key") return end
        SetStatus("Checking...", CurrentTheme.SubText)
        Tween(SubmitBtn, {BackgroundColor3 = Color3.fromRGB(70,70,80)}, 0.1)

        task.wait(0.2)
        local valid, err = ValidateKey(key)
        if valid then
            SetStatus("Success! Loading...", Color3.fromRGB(80,255,120))
            if SaveKey then
                pcall(function()
                    if writefile then writefile(FileName, key) end
                end)
            end
            Tween(Main, {Size = UDim2.new(0, 380, 0, 0)}, 0.25)
            task.wait(0.26)
            ScreenGui:Destroy()
            OnSuccess(key)
        else
            SetStatus("Invalid Key! Please try again.", Color3.fromRGB(255,80,80))
            OnFail(err)
            local orig = Main.Position
            for i=1,3 do
                Tween(Main, {Position = orig + UDim2.new(0,5,0,0)}, 0.05)
                task.wait(0.05)
                Tween(Main, {Position = orig + UDim2.new(0,-5,0,0)}, 0.05)
                task.wait(0.05)
            end
            Tween(Main, {Position = orig}, 0.08)
            Tween(SubmitBtn, {BackgroundColor3 = CurrentTheme.Accent}, 0.2)
        end
    end)

    GetKeyBtn.MouseButton1Click:Connect(function()
        if GetKeyUrl and GetKeyUrl ~= "" then
            pcall(function() setclipboard(GetKeyUrl) end)
            SetStatus("Link copied to clipboard!", Color3.fromRGB(80,200,255))
        else
            SetStatus("No key link set by developer", Color3.fromRGB(255,200,80))
        end
    end)

    DiscordBtn.MouseButton1Click:Connect(function()
        if DiscordUrl and DiscordUrl ~= "" then
            pcall(function() setclipboard(DiscordUrl) end)
            SetStatus("Server link copied!", Color3.fromRGB(80,200,255))
        else
            SetStatus("No server link set", Color3.fromRGB(255,200,80))
        end
    end)

    SubmitBtn.MouseEnter:Connect(function() Tween(SubmitBtn, {BackgroundColor3 = Color3.fromRGB(CurrentTheme.Accent.R*255+20, CurrentTheme.Accent.G*255+20, CurrentTheme.Accent.B*255+20)}, 0.15) end)
    SubmitBtn.MouseLeave:Connect(function() Tween(SubmitBtn, {BackgroundColor3 = CurrentTheme.Accent}, 0.15) end)

    return ScreenGui
end

GGH.CreateKey = GGH.MakeKeySystem
GGH.KeySystem = GGH.MakeKeySystem
GGH.AddKeySystem = GGH.MakeKeySystem

return GGH
