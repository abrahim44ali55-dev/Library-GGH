        local function GetInstanceByPath(pathStr)
            if not pathStr or pathStr == "" then return nil end
            local parts = {}
            for p in string.gmatch(tostring(pathStr), "[^%.]+") do table.insert(parts, p) end
            if #parts == 0 then return nil end
            local first = string.lower(parts[1])
            local cur = nil
            if first == "workspace" then cur = workspace
            elseif first == "game" then cur = game
            elseif first == "players" then cur = Players
            elseif first == "replicatedstorage" then cur = game:GetService("ReplicatedStorage")
            elseif first == "replicatedfirst" then cur = game:GetService("ReplicatedFirst")
            elseif first == "startergui" then cur = game:GetService("StarterGui")
            elseif first == "lighting" then cur = game:GetService("Lighting")
            elseif first == "localplayer" then cur = Players.LocalPlayer
            else
                -- جرب من workspace مباشرة
                cur = workspace
                -- اعد الاجزاء كاملة
                parts = {}
                for p in string.gmatch(tostring(pathStr), "[^%.]+") do table.insert(parts, p) end
            end

            local startIdx = 2
            if first ~= "workspace" and first ~= "game" and first ~= "players" and first ~= "replicatedstorage" and first ~= "replicatedfirst" and first ~= "startergui" and first ~= "lighting" and first ~= "localplayer" then
                startIdx = 1
                cur = workspace
                -- اذا ما لقى حاول من game
                local tryGame = game
                local found = tryGame
                for i=1,#parts do
                    local child = found:FindFirstChild(parts[i])
                    if child then found = child else found = nil break end
                end
                if found then return found end
            end

            for i=startIdx,#parts do
                if not cur then break end
                local name = parts[i]
                local nextInst = cur:FindFirstChild(name)
                if nextInst then
                    cur = nextInst
                else
                    -- اذا الخاصية وليس instance
                    local ok, val = pcall(function() return cur[name] end)
                    if ok then
                        if i == #parts then
                            return val
                        else
                            cur = val
                        end
                    else
                        cur = nil
                        break
                    end
                end
            end
            return cur
        end

        local function ExtractValueFromInstance(obj)
            if obj == nil then return "N/A" end
            if type(obj) ~= "userdata" and type(obj) ~= "table" then return tostring(obj) end
            -- ValueBase
            local ok, v = pcall(function() return obj.Value end)
            if ok then return v end
            -- TextLabel etc
            local ok2, t = pcall(function() return obj.Text end)
            if ok2 then return t end
            return tostring(obj)
        end

