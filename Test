                return SliderAPI
            end
            function SliderAPI:GetValue() return Value end
            function SliderAPI:Refresh(newCfg)
                if newCfg then
                    if newCfg.Min then Cfg.Min = newCfg.Min end
                    if newCfg.Max then Cfg.Max = newCfg.Max end
                    if newCfg.Title then Label.Text = newCfg.Title.." : "..Value; Cfg.Title = newCfg.Title end
