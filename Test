                    for _, it in ipairs(statLabels) do it.row:Destroy() end
                    table.clear(statLabels)
                    for i, s in ipairs(newCfg.Stats) do
                        local obj = CreateSingleStatRow(s, i)
                        table.insert(statLabels, obj)
                    end
                    StatsContainer.Size = UDim2.new(1,-12,0, #statLabels * 32)
                end
                UpdateAllStats()
                return API
            end
            function API:Update() UpdateAllStats() return API end
            return API
        end

        

