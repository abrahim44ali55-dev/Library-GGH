        local function CreateSliderWithInput(Cfg)
            Cfg.Min = Cfg.Min or 0
            Cfg.Max = Cfg.Max or 100
            Cfg.Default = Cfg.Default or Cfg.Min
            Cfg.Decimals = Cfg.Decimals or Cfg.Precision or Cfg.FloatPrecision or (Cfg.Float and 2 or 0)
            if Cfg.Increment then
                local s = tostring(Cfg.Increment)
                if s:find("%.") then
                    local parts = string.split(s, ".")
                    local dec = parts[2] and #parts[2] or 0
                    if dec > Cfg.Decimals then Cfg.Decimals = dec end
                end
            end
            local isFloat = Cfg.Float or Cfg.Decimals > 0 or Cfg.AllowDecimals or Cfg.Precision ~= nil
            local function FormatVal(v)
                if isFloat or Cfg.Decimals > 0 then
                    local dec = Cfg.Decimals
                    if dec == 0 and isFloat then dec = 2 end
                    return string.format("%."..tostring(dec).."f", v)
                else
                    return tostring(math.floor(v*100)/100):gsub("%.0+$","")
                end
            end
            local function SnapValue(v)
                if Cfg.Increment and Cfg.Increment > 0 then
                    v = math.floor((v / Cfg.Increment)+0.5) * Cfg.Increment
                    v = tonumber(string.format("%."..tostring(Cfg.Decimals+4).."f", v))
                end
                return v
            end
            local Value = math.clamp(Cfg.Default, Cfg.Min, Cfg.Max)
            Value = SnapValue(Value)

            local Frame = Instance.new("Frame", TabPage)
            Frame.Size = UDim2.new(1,-4,0,58)
            Frame.BackgroundColor3 = CurrentTheme.ElementBg
            Corner(Frame, 9)
            RegisterThemable(Frame, "BackgroundColor3", "ElementBg")
            AddSearch(Frame, Cfg.Title, "SliderInput", Name)

            local TitleLabel = Instance.new("TextLabel", Frame)
            TitleLabel.Size = UDim2.new(1,-90,0,18)
            TitleLabel.Position = UDim2.new(0,10,0,6)
            TitleLabel.BackgroundTransparency = 1
            TitleLabel.TextXAlignment = Enum.TextXAlignment.Left
            TitleLabel.Font = Enum.Font.GothamMedium
            TitleLabel.TextSize = 12
            TitleLabel.TextColor3 = CurrentTheme.Text
            TitleLabel.Text = Cfg.Title or "Slider"
            TitleLabel.AutoLocalize = true
            RegisterThemable(TitleLabel, "TextColor3", "Text")

            local NumberBox = Instance.new("TextBox", Frame)
            NumberBox.Size = UDim2.new(0,70,0,20)
            NumberBox.Position = UDim2.new(1,-80,0,5)
            NumberBox.BackgroundColor3 = CurrentTheme.ElementBg2
            NumberBox.Text = FormatVal(Value)
            NumberBox.Font = Enum.Font.Gotham
            NumberBox.TextSize = 12
            NumberBox.TextColor3 = CurrentTheme.Text
            NumberBox.PlaceholderColor3 = CurrentTheme.SubText
            NumberBox.ClearTextOnFocus = false
            Corner(NumberBox, 6)
            Stroke(NumberBox, CurrentTheme.Stroke, 1)
            RegisterThemable(NumberBox, "BackgroundColor3", "ElementBg2")

            local Bar = Instance.new("Frame", Frame)
            Bar.Size = UDim2.new(1,-90,0,8)
            Bar.Position = UDim2.new(0,10,0,32)
            Bar.BackgroundColor3 = CurrentTheme.ElementBg2
            Corner(Bar, 4)
            RegisterThemable(Bar, "BackgroundColor3", "ElementBg2")

            local Fill = Instance.new("Frame", Bar)
            Fill.Size = UDim2.new((Value - Cfg.Min) / math.max(1, Cfg.Max - Cfg.Min),0,1,0)
            Fill.BackgroundColor3 = CurrentTheme.Accent
            Corner(Fill, 4)
            RegisterThemable(Fill, "BackgroundColor3", "Accent")

            local Circle = Instance.new("Frame", Frame)
            Circle.Size = UDim2.new(0,16,0,16)
            Circle.AnchorPoint = Vector2.new(0.5,0.5)
            Circle.Position = UDim2.new(0,10,0,36)
            Circle.BackgroundColor3 = Color3.fromRGB(255,255,255)
            Circle.ZIndex = 10
            Corner(Circle, 8)
            local S = Stroke(Circle, CurrentTheme.Accent, 2)
            RegisterThemable(S, "Stroke", "Accent")

            local dragging = false

            local function UpdateVisuals(newVal, tween)
                newVal = SnapValue(math.clamp(newVal, Cfg.Min, Cfg.Max))
                Value = newVal
                local rel = (Value - Cfg.Min)/math.max(1,Cfg.Max-Cfg.Min)
                if tween then
                    Tween(Fill, {Size = UDim2.new(rel,0,1,0)}, 0.15)
                    Tween(Circle, {Position = UDim2.new(0, 10 + rel*Bar.AbsoluteSize.X, 0, 36)}, 0.15)
                else
                    Fill.Size = UDim2.new(rel,0,1,0)
                    Circle.Position = UDim2.new(0, 10 + rel*Bar.AbsoluteSize.X, 0, 36)
                end
                NumberBox.Text = FormatVal(Value)
                TitleLabel.Text = (Cfg.Title or "Slider").." : "..FormatVal(Value)
                pcall(Cfg.Callback or function() end, Value)
            end

            task.spawn(function()
                task.wait(0.08)
                local rel = (Value - Cfg.Min)/math.max(1,Cfg.Max-Cfg.Min)
                local barSize = Bar.AbsoluteSize.X
                if barSize <= 0 then barSize = 200 end
                Circle.Position = UDim2.new(0, 10 + rel*barSize, 0, 36)
            end)

            local function UpdateFromInputPos(inputX)
                local barPos = Bar.AbsolutePosition.X
                local barSize = Bar.AbsoluteSize.X
                if barSize <= 0 then barSize = 200 end
                local rel = math.clamp((inputX - barPos)/barSize, 0, 1)
                local newVal = Cfg.Min + (Cfg.Max - Cfg.Min)*rel
                newVal = SnapValue(newVal)
                UpdateVisuals(newVal, false)
            end

            local DragArea = Instance.new("TextButton", Bar)
            DragArea.Size = UDim2.new(1,0,2.5,0)
            DragArea.Position = UDim2.new(0,0,0.5,-10)
