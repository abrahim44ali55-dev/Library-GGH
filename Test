local function CreateDropdown(Cfg)
    local isMulti = Cfg.Multi or Cfg.MultiSelect or Cfg.Multiple or false
    Cfg.Options = Cfg.Options or {}
    local Selected = Cfg.Default or Cfg.Options[1]
    if isMulti then
        if type(Selected) ~= "table" then Selected = {Selected} end
        local valid = {}
        for _, v in ipairs(Selected) do for _, o in ipairs(Cfg.Options) do if v==o then table.insert(valid,v) break end end end
        Selected = valid
    end

    local Frame = Instance.new("Frame", TabPage)
    Frame.Size = UDim2.new(1,-4,0,38)
    Frame.BackgroundColor3 = CurrentTheme.ElementBg
    Frame.ClipsDescendants = true
    Corner(Frame, 9)
    RegisterThemable(Frame, "BackgroundColor3", "ElementBg")
    AddSearch(Frame, Cfg.Title, "Dropdown", Name)

    local function GetDisplayText()
        if isMulti then
            if #Selected == 0 then return Cfg.Title.." : (None)"
            elseif #Selected == 1 then return Cfg.Title.." : "..Selected[1]
            else return Cfg.Title.." : "..#Selected.." selected ("..table.concat(Selected, ", "):sub(1,20)..")"
            end
        else
            return Cfg.Title.." : "..tostring(Selected)
        end
    end

    local Btn = Instance.new("TextButton", Frame)
    Btn.Size = UDim2.new(1,0,0,38)
    Btn.BackgroundTransparency = 1
    Btn.Text = GetDisplayText()
    Btn.Font = Enum.Font.GothamMedium
    Btn.TextSize = 12
    Btn.TextColor3 = CurrentTheme.Text
    Btn.AutoLocalize = true
    Btn.TextTruncate = Enum.TextTruncate.AtEnd
    RegisterThemable(Btn, "TextColor3", "Text")
    AddTextStroke(Btn)

    local List = Instance.new("Frame", Frame)
    List.Position = UDim2.new(0,0,0,38)
    List.Size = UDim2.new(1,0,0,#Cfg.Options*30)
    List.BackgroundTransparency = 1
    local ll = Instance.new("UIListLayout", List)
    ll.Padding = UDim.new(0,2)

    local Open = false
    Btn.MouseButton1Click:Connect(function()
        if IsScrolling then return end
        Open = not Open
        local targetH = Open and (38 + #Cfg.Options*30 + 6) or 38
        Tween(Frame, {Size = UDim2.new(1,-4,0,targetH)}, 0.2)
    end)

    local function IsSelected(opt)
        if not isMulti then return opt == Selected end
        for _, v in ipairs(Selected) do if v == opt then return true end end
        return false
    end

    local function RefreshOptions()
        for _, child in ipairs(List:GetChildren()) do
            if child:IsA("TextButton") then
                local name = child:GetAttribute("OptName") or child.Text:gsub("✓ ","")
                local sel = IsSelected(name)
                child.BackgroundColor3 = sel and CurrentTheme.Accent or CurrentTheme.ElementBg2
                child.Text = (sel and "✓ " or "")..name
            end
        end
        Btn.Text = GetDisplayText()
    end

    local function CreateOptionButton(opt)
        local O = Instance.new("TextButton", List)
        O.Size = UDim2.new(1,0,0,28)
        O.BackgroundColor3 = IsSelected(opt) and CurrentTheme.Accent or CurrentTheme.ElementBg2
        O.Text = (IsSelected(opt) and "✓ " or "")..opt
        O.Font = Enum.Font.Gotham
        O.TextSize = 11
        O.TextColor3 = CurrentTheme.Text
        O.AutoLocalize = true
        Corner(O, 6)
        AddBlackBorder(O, 0.8, 0.8)
        RegisterThemable(O, "BackgroundColor3", "ElementBg2")
        AddTextStroke(O)
        O:SetAttribute("OptName", opt)
        O.MouseButton1Click:Connect(function()
            if isMulti then
                if IsSelected(opt) then
                    for i,v in ipairs(Selected) do if v==opt then table.remove(Selected,i) break end end
                else
                    table.insert(Selected, opt)
                end
                RefreshOptions()
                pcall(Cfg.Callback or function() end, Selected)
            else
                Selected = opt
                RefreshOptions()
                Open = false
                Tween(Frame, {Size = UDim2.new(1,-4,0,38)}, 0.2)
                pcall(Cfg.Callback or function() end, Selected)
            end
        end)
        return O
    end

    for _, opt in ipairs(Cfg.Options) do
        CreateOptionButton(opt)
    end

    -- [[ REFRESH API START - FULL SUPPORT ]]
    local DropdownAPI = {}
    function DropdownAPI:Refresh(newOptions)
        if newOptions and type(newOptions) == "table" then
            Cfg.Options = newOptions
        end
        -- clear old buttons
        for _, child in ipairs(List:GetChildren()) do
            if child:IsA("TextButton") then child:Destroy() end
        end
        -- validate Selected against new options
        if not isMulti then
            local stillExists = false
            for _, o in ipairs(Cfg.Options) do if o == Selected then stillExists = true break end end
            if not stillExists then Selected = Cfg.Options[1] end
        else
            local newSel = {}
            for _, s in ipairs(Selected) do for _, o in ipairs(Cfg.Options) do if s==o then table.insert(newSel,s) break end end end
            Selected = newSel
        end
        -- rebuild
        List.Size = UDim2.new(1,0,0,#Cfg.Options*30)
        for _, opt in ipairs(Cfg.Options) do CreateOptionButton(opt) end
        RefreshOptions()
        if Open then
            Tween(Frame, {Size = UDim2.new(1,-4,0,38 + #Cfg.Options*30 + 6)}, 0.2)
        end
        return DropdownAPI
    end
    function DropdownAPI:SetOptions(newOptions) return self:Refresh(newOptions) end
    function DropdownAPI:Set(option)
        if isMulti then
            if type(option) == "table" then Selected = option else Selected = {option} end
        else
            Selected = option
        end
        RefreshOptions()
        pcall(Cfg.Callback or function() end, Selected)
        return DropdownAPI
    end
    function DropdownAPI:Get() return Selected end
    function DropdownAPI:Clear()
        if isMulti then Selected = {} else Selected = nil end
        RefreshOptions()
        return DropdownAPI
    end
    function DropdownAPI:AddOption(opt)
        table.insert(Cfg.Options, opt)
        self:Refresh()
        return DropdownAPI
    end
    function DropdownAPI:RemoveOption(opt)
        for i,o in ipairs(Cfg.Options) do if o==opt then table.remove(Cfg.Options,i) break end end
        self:Refresh()
        return DropdownAPI
    end
    DropdownAPI.Refresh = DropdownAPI.Refresh
    -- [[ REFRESH API END ]]

    return DropdownAPI
end


