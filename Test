		local sectionName = getProp(props, "name", "Name") or "Section"
		local header = createInstance("Frame", {
			Name = "Section_" .. sectionName,
			Size = UDim2.new(1, -16, 0, 26),
			BackgroundTransparency = 1,
		}, tabController.elementContainer)
		createInstance("TextLabel", {
			Text = sectionName,
			TextColor3 = windowController.activeTheme.Text,
			TextSize = 13,
			Font = Enum.Font.GothamBold,
			TextXAlignment = Enum.TextXAlignment.Left,
			Size = UDim2.fromScale(1, 1),
			BackgroundTransparency = 1,
		}, header)
		local sectionController = { name = sectionName, __type = "Section", instance = header, tab = tabController }
		return sectionController
	end
	function tabController:CreateProgress(props)
		local progressController = createText(windowController, tabController, props or {})
		progressController.__type = "Progress"
		return progressController
	end
	function tabController:CreateStat(props)
		local statController = createText(windowController, tabController, props or {})
		statController.__type = "Stat"
		return statController
	end

	return tabController
end

-- ===========================================================================
-- Window creation
-- ===========================================================================
function GGH.CreateWindow(props)
	props = props or {}
	local windowController = {}
	windowController.__type = "Window"
	windowController.name = getProp(props, "name", "Name") or "GGH Window"
	windowController.title = getProp(props, "title", "Title") or windowController.name
	windowController.subtitle = getProp(props, "subtitle", "Subtitle") or ("by " .. GGH._DEVELOPER)
	windowController.activeTheme = resolveTheme(getProp(props, "theme", "Theme"))
	windowController.controls = {}
	windowController.tabs = {}
	windowController.selectedTab = nil
	windowController.hidden = false
	windowController.minimized = false
	windowController.unloaded = false
	windowController.configuration = getProp(props, "configuration", "Configuration") or {}
	windowController.layoutMode = "sidebar"
	-- GGH forces the vertical sidebar. The original layout.mode top is
	-- intentionally not offered, so old + new tab systems cannot conflict.
	windowController.layout = { mode = "sidebar", railWidth = SIDEBAR_WIDTH }

	-- Root GUI
	local screenGui = createInstance("ScreenGui", {
		Name = "GGH_" .. HttpService:GenerateGUID(false),
		IgnoreGuiInset = true,
		ResetOnSpawn = false,
		DisplayOrder = 1000,
		ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
	}, PlayerGui)
	windowController.screenGui = screenGui
	windowController.guiContainer = screenGui

	-- Main window
	local mainFrame = createInstance("Frame", {
		Name = "GGH_Main",
		Size = UDim2.fromOffset(DEFAULT_WINDOW_WIDTH, DEFAULT_WINDOW_HEIGHT),
		Position = UDim2.fromScale(0.5, 0.5),
		AnchorPoint = Vector2.new(0.5, 0.5),
		BackgroundColor3 = windowController.activeTheme.Background,
		BorderSizePixel = 0,
	}, screenGui)
	addCorner(mainFrame, 14)
	addStroke(mainFrame, windowController.activeTheme.Stroke, 1, 0.7)
	windowController.main = mainFrame
	windowController.mainFrame = mainFrame

	-- Top bar (title + GGH logo + window controls)
	local topBar = createInstance("Frame", {
		Name = "TopBar",
		Size = UDim2.new(1, 0, 0, TOPBAR_HEIGHT),
		BackgroundColor3 = windowController.activeTheme.SecondaryBackground,
		BorderSizePixel = 0,
	}, mainFrame)
	addCorner(topBar, 14)
	windowController.topBar = topBar

	local logoFrame = createInstance("Frame", {
		Name = "GGH_Logo",
		Size = UDim2.fromOffset(36, 36),
		Position = UDim2.new(0, 12, 0.5, 0),
		AnchorPoint = Vector2.new(0, 0.5),
		BackgroundColor3 = windowController.activeTheme.Accent,
		BorderSizePixel = 0,
	}, topBar)
	addCorner(logoFrame, 9)
	createInstance("TextLabel", {
		Name = "GGH_LogoText",
		Text = "G",
		TextColor3 = Color3.fromRGB(255, 255, 255),
		TextSize = 20,
		Font = Enum.Font.GothamBlack,
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
	}, logoFrame)
	-- Accent sparkle from GGH_ASSETS.ggh_logo: represented as a small dot
	-- because the SVG itself cannot be drawn directly in Roblox.
	createInstance("Frame", {
		Name = "GGH_AccentDot",
		Size = UDim2.fromOffset(6, 6),
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -3, 0, 3),
		BackgroundColor3 = Color3.fromRGB(255, 255, 255),
		BorderSizePixel = 0,
	}, logoFrame)

	createInstance("TextLabel", {
		Name = "WindowTitle",
		Text = windowController.title,
		TextColor3 = windowController.activeTheme.Text,
		TextSize = 16,
		Font = Enum.Font.GothamBold,
		TextXAlignment = Enum.TextXAlignment.Left,
		Position = UDim2.new(0, 58, 0, 8),
		Size = UDim2.new(1, -180, 0, 20),
		BackgroundTransparency = 1,
	}, topBar)
	createInstance("TextLabel", {
		Name = "WindowSubtitle",
		Text = windowController.subtitle,
		TextColor3 = windowController.activeTheme.SubText,
		TextSize = 11,
		Font = Enum.Font.Gotham,
		TextXAlignment = Enum.TextXAlignment.Left,
		Position = UDim2.new(0, 58, 0, 28),
		Size = UDim2.new(1, -180, 0, 16),
		BackgroundTransparency = 1,
	}, topBar)

	-- Window controls: search, minimize, close - never overlapping tabs
	local controlsContainer = createInstance("Frame", {
		Name = "WindowControls",
		Size = UDim2.new(0, 116, 0, 28),
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, -12, 0.5, 0),
		BackgroundTransparency = 1,
	}, topBar)
	createInstance("UIListLayout", {
		FillDirection = Enum.FillDirection.Horizontal,
		Padding = UDim.new(0, 6),
		HorizontalAlignment = Enum.HorizontalAlignment.Right,
		SortOrder = Enum.SortOrder.LayoutOrder,
	}, controlsContainer)
	windowController.actionContainer = controlsContainer

	local function makeControlButton(iconKey, onClick)
		local button = createInstance("TextButton", {
			Size = UDim2.fromOffset(28, 28),
			BackgroundColor3 = windowController.activeTheme.ElementBackground,
			Text = "",
			BorderSizePixel = 0,
		}, controlsContainer)
		addCorner(button, 8)
		local icon = createIcon(iconKey, button, 14, windowController.activeTheme.Text)
		icon.AnchorPoint = Vector2.new(0.5, 0.5)
		icon.Position = UDim2.fromScale(0.5, 0.5)
		button.MouseButton1Click:Connect(onClick)
		return button
	end

	makeControlButton("search_filter", function()
		windowController:ToggleSearch()
	end)
	makeControlButton("minimize", function()
		windowController:Minimize()
	end)
	makeControlButton("close", function()
		windowController:Hide()
	end)

	-- Sidebar container (left, vertical, scrollable)
	local sidebarContainer = createInstance("ScrollingFrame", {
		Name = "Sidebar",
		Size = UDim2.new(0, SIDEBAR_WIDTH, 1, -TOPBAR_HEIGHT - 46),
		Position = UDim2.new(0, 0, 0, TOPBAR_HEIGHT),
		BackgroundColor3 = windowController.activeTheme.SecondaryBackground,
		BorderSizePixel = 0,
		ScrollBarThickness = 0,
		ScrollingDirection = Enum.ScrollingDirection.Y,
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		CanvasSize = UDim2.new(0, 0, 0, 0),
	}, mainFrame)
	windowController.sidebarContainer = sidebarContainer
	createInstance("UIListLayout", {
		FillDirection = Enum.FillDirection.Vertical,
		Padding = UDim.new(0, 6),
		HorizontalAlignment = Enum.HorizontalAlignment.Center,
		SortOrder = Enum.SortOrder.LayoutOrder,
	}, sidebarContainer)
	createInstance("UIPadding", {
		PaddingTop = UDim.new(0, 10),
		PaddingBottom = UDim.new(0, 10),
	}, sidebarContainer)

	-- Search box under sidebar
	local searchBox = createInstance("TextBox", {
		Name = "GGH_Search",
		Size = UDim2.new(0, SIDEBAR_WIDTH - 20, 0, 32),
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0, SIDEBAR_WIDTH / 2, 1, -8),
		BackgroundColor3 = windowController.activeTheme.ElementBackground,
		TextColor3 = windowController.activeTheme.Text,
		PlaceholderColor3 = windowController.activeTheme.SubText,
		PlaceholderText = "Search tabs...",
		Text = "",
		TextSize = 13,
		Font = Enum.Font.Gotham,
	}, mainFrame)
	addCorner(searchBox, 9)
	addStroke(searchBox, windowController.activeTheme.Stroke, 1, 0.8)
	windowController.searchBox = searchBox
	windowController._searching = false
	searchBox:GetPropertyChangedSignal("Text"):Connect(function()
		local query = string.lower(searchBox.Text)
		for _, tabController in ipairs(windowController.tabs) do
			local matches = query == "" or string.find(string.lower(tabController.name), query, 1, true) ~= nil
			tabController.sidebarRow.Visible = matches
			-- Keep selected tab visible even when searching; others hide
			if not matches and tabController == windowController.selectedTab then
				tabController.sidebarRow.Visible = true
			end
		end
	end)

	-- Content container (right of sidebar)
	local contentContainer = createInstance("Frame", {
		Name = "Content",
		Position = UDim2.new(0, SIDEBAR_WIDTH, 0, TOPBAR_HEIGHT),
		Size = UDim2.new(1, -SIDEBAR_WIDTH, 1, -TOPBAR_HEIGHT),
		BackgroundTransparency = 1,
	}, mainFrame)
	windowController.contentContainer = contentContainer
	windowController.elements = contentContainer

	-- Dragging
	local dragging = false
	local dragStart = nil
	local frameStart = nil
	topBar.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			dragging = true
			dragStart = input.Position
			frameStart = mainFrame.Position
		end
	end)
	UserInputService.InputChanged:Connect(function(input)
		if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
			local delta = input.Position - dragStart
			mainFrame.Position = UDim2.new(
				frameStart.X.Scale, frameStart.X.Offset + delta.X,
				frameStart.Y.Scale, frameStart.Y.Offset + delta.Y
			)
		end
	end)
	UserInputService.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			dragging = false
		end
	end)

	-- Public window methods
	function windowController:CreateTab(props)
		local tabController = createTabController(windowController, props or {})
		table.insert(windowController.tabs, tabController)
		if tabController == windowController.gghSettingsTab then
			tabController.sidebarRow.LayoutOrder = 1000
			windowController:SelectTab(tabController)
		elseif windowController.selectedTab == nil or windowController.selectedTab == windowController.gghSettingsTab then
			windowController:SelectTab(tabController)
		end
		return tabController
	end

	function windowController:SelectTab(tabController)
		for _, otherTab in ipairs(windowController.tabs) do
			otherTab:SetActive(otherTab == tabController)
		end
		windowController.selectedTab = tabController
	end

	function windowController:CreateSection(props)
		-- Original Rayfield warned this needs the sidebar layout.
		-- In GGH the sidebar is always active, so this forwards to the
		-- first tab if one exists, otherwise creates a fallback tab.
		if #windowController.tabs == 0 then
			windowController:CreateTab({ name = "Main", icon = "layout_sidebar" })
		end
		return windowController.tabs[1]:CreateSection(props or {})
	end

	function windowController:Show()
		windowController.hidden = false
		windowController.main.Visible = true
		windowController.minimized = false
	end

	function windowController:Hide()
		windowController.hidden = true
		windowController.main.Visible = false
	end

	function windowController:Minimize()
		windowController.minimized = true
		windowController.main.Visible = false
		-- A small restore hint - the user can call :Show() to restore.
		-- This mirrors the original behaviour (hidden until Show).
	end

	function windowController:Toggle()
		if windowController.hidden or windowController.minimized then
			windowController:Show()
		else
			windowController:Hide()
		end
	end

	function windowController:ToggleSearch()
		windowController._searching = not windowController._searching
		windowController.searchBox.Visible = windowController._searching
		if windowController._searching then
			windowController.searchBox:CaptureFocus()
		end
	end

	function windowController:Notify(props)
		return notificationService:notify(windowController, props or {})
	end

	-- Alias used by older Rayfield scripts: :Notify + :Toast
	windowController.Toast = windowController.Notify

	function windowController:ChangeTheme(themeValue)
		windowController.activeTheme = resolveTheme(themeValue)
		-- Simplest correct behaviour: update main surfaces.
		windowController.main.BackgroundColor3 = windowController.activeTheme.Background
		topBar.BackgroundColor3 = windowController.activeTheme.SecondaryBackground
		sidebarContainer.BackgroundColor3 = windowController.activeTheme.SecondaryBackground
	end

	function windowController:SaveConfiguration(configurationName, folderName)
		return configurationManager:save(windowController, configurationName or windowController.configuration.fileName or "GGH", folderName or windowController.configuration.customFolder)
	end

	function windowController:LoadConfiguration(configurationName, folderName)
		return configurationManager:load(windowController, configurationName or windowController.configuration.fileName or "GGH", folderName or windowController.configuration.customFolder)
	end

	function windowController:Unload()
		if windowController.unloaded then return end
		windowController.unloaded = true
		for _, connection in ipairs(windowController.connections or {}) do
			pcall(function() connection:Disconnect() end)
		end
		if windowController.screenGui then
			windowController.screenGui:Destroy()
		end
	end

	-- Compatibility: original scripts often call window:Destroy / :Close
	windowController.Destroy = windowController.Unload
	windowController.Close = windowController.Hide

	-- Menu toggle keybind (default RightShift, overridable by props)
	local menuKey = getProp(props, "toggleKey", "ToggleKey", "toggleKeybind", "ToggleKeybind") or Enum.KeyCode.RightShift
	windowController.settings = { toggleKeybind = menuKey }
	UserInputService.InputBegan:Connect(function(input, gameProcessed)
		if gameProcessed then return end
		if input.KeyCode == menuKey then
			windowController:Toggle()
		end
	end)

	-- GGH Settings tab - replaces "Rayfield Settings"
	local settingsTab = windowController:CreateTab({ name = "GGH Settings", icon = "settings" })
	windowController.settingsTab = settingsTab
	-- Settings content is built lazily via CreateSection / CreateToggle
	-- below; keep the tab present so old scripts that expect a settings
	-- tab do not error. It will be the last tab and is not auto-selected.
	windowController.gghSettingsTab = settingsTab
	windowController.Flags = setmetatable({}, {
		__index = function(_, flagName)
			local control = windowController.controls[flagName]
			return control and control.value or nil
		end,
		__newindex = function(_, flagName, newValue)
			local control = windowController.controls[flagName]
			if not control then
				warn("[GGH] No flag '" .. tostring(flagName) .. "' to set")
				return
			end
			if control.Set then control:Set(newValue) end
		end,
	})
	-- Move settings tab to end visually by re-ordering sidebar rows:
	-- (It was created first, so SelectTab already picked it - fix that)
	-- We correct selection: if a user tab exists later, it will be selected
	-- by SelectTab when created. Until then, keep GGH Settings visible.

	-- Auto-load configuration if requested
	if windowController.configuration.autoLoad then
		task.spawn(function()
			task.wait(0.2)
			windowController:LoadConfiguration()
		end)
	end

	return windowController
end

-- Compatibility aliases for old code
GGH.CreateWindow = GGH.CreateWindow
GGH.Window = GGH
GGH.Rayfield = GGH

return GGH
