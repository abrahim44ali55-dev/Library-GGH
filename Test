local notificationService = {}
notificationService._container = nil

function notificationService:ensureContainer(windowController)
	if self._container and self._container.Parent then return self._container end
	local parentGui = windowController and windowController.screenGui or PlayerGui
	if not parentGui then return nil end
	local container = createInstance("Frame", {
		Name = "GGH_Notifications",
		AnchorPoint = Vector2.new(1, 1),
		Position = UDim2.new(1, -16, 1, -16),
		Size = UDim2.new(0, 320, 1, 0),
		BackgroundTransparency = 1,
	}, parentGui)
	createInstance("UIListLayout", {
		FillDirection = Enum.FillDirection.Vertical,
		HorizontalAlignment = Enum.HorizontalAlignment.Right,
		VerticalAlignment = Enum.VerticalAlignment.Bottom,
		Padding = UDim.new(0, 10),
		SortOrder = Enum.SortOrder.LayoutOrder,
	}, container)
	self._container = container
	return container
end

function notificationService:notify(windowController, props)
	props = props or {}
	local container = self:ensureContainer(windowController)
	if not container then return nil end
	local activeTheme = windowController and windowController.activeTheme or GGH_THEMES.Default
	local card = createInstance("Frame", {
		Name = "GGH_Notify",
		Size = UDim2.new(1, 0, 0, 72),
		BackgroundColor3 = activeTheme.ElementBackground,
		BorderSizePixel = 0,
	}, container)
	addCorner(card, 12)
	addStroke(card, activeTheme.Stroke, 1, 0.7)
	local accentBar = createInstance("Frame", {
		Size = UDim2.new(0, 4, 1, -16),
		Position = UDim2.new(0, 8, 0, 8),
		BackgroundColor3 = activeTheme.Accent,
		BorderSizePixel = 0,
	}, card)
	addCorner(accentBar, 2)
	createInstance("TextLabel", {
		Name = "Title",
		Text = props.title or props.Title or "GGH",
		TextColor3 = activeTheme.Text,
		TextSize = 14,
		Font = Enum.Font.GothamBold,
		TextXAlignment = Enum.TextXAlignment.Left,
		Position = UDim2.new(0, 20, 0, 10),
		Size = UDim2.new(1, -30, 0, 18),
		BackgroundTransparency = 1,
	}, card)
	createInstance("TextLabel", {
		Name = "Content",
		Text = props.content or props.Content or "",
		TextColor3 = activeTheme.SubText,
		TextSize = 12,
		Font = Enum.Font.Gotham,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextYAlignment = Enum.TextYAlignment.Top,
		TextWrapped = true,
		Position = UDim2.new(0, 20, 0, 30),
		Size = UDim2.new(1, -30, 0, 34),
		BackgroundTransparency = 1,
	}, card)
	card.Position = UDim2.new(0, 340, 0, 0)
	tween(card, 0.35, { Position = UDim2.new(0, 0, 0, 0) })
	task.delay(props.duration or props.Duration or 4, function()
		if card.Parent then
			tween(card, 0.3, { Position = UDim2.new(0, 340, 0, 0), BackgroundTransparency = 1 })
			task.wait(0.32)
			card:Destroy()
		end
	end)
	return card
end
