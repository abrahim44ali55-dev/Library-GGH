        local function CreateFloatingButton(Cfg)
            Cfg = Cfg or {}
            local title = Cfg.Title or Cfg.Name or "Button"
            local callback = Cfg.Callback or function() end
            local floatEnabledDefault = Cfg.FloatDefault or Cfg.ToggleDefault or false
            local floatDraggable = Cfg.FloatDraggable
            if floatDraggable == nil then floatDraggable = true end
            if Cfg.Draggable ~= nil then floatDraggable = Cfg.Draggable end
            local floatText = Cfg.FloatText or Cfg.FloatName or title
            local floatImage = Cfg.FloatImage or Cfg.FloatIcon or Cfg.Image or nil
            local floatPosCfg = Cfg.FloatPosition or Cfg.Position or "Center"
            local floatSize = Cfg.FloatSize or Vector2.new(50,50)
            
            local Frame = Instance.new("Frame", TabPage)
            Frame.Size = UDim2.new(1,-4,0,38)
            Frame.BackgroundColor3 = CurrentTheme.ElementBg
            Corner(Frame, 9)
            RegisterThemable(Frame, "BackgroundColor3", "ElementBg")
            AddSearch(Frame, title, "FloatingButton", Name)

            local TitleLabel = Instance.new("TextLabel", Frame)
            TitleLabel.Size = UDim2.new(1,-100,1,0)
            TitleLabel.Position = UDim2.new(0,10,0,0)
            TitleLabel.BackgroundTransparency = 1
            TitleLabel.Text = title
            TitleLabel.Font = Enum.Font.GothamMedium
            TitleLabel.TextSize = 12
            TitleLabel.TextColor3 = CurrentTheme.Text
            TitleLabel.TextXAlignment = Enum.TextXAlignment.Left
            TitleLabel.AutoLocalize = true
            RegisterThemable(TitleLabel, "TextColor3", "Text")

            local ToggleBg = Instance.new("Frame", Frame)
            ToggleBg.Size = UDim2.new(0,38,0,20)
            ToggleBg.Position = UDim2.new(1,-88,0.5,-10)
            ToggleBg.BackgroundColor3 = floatEnabledDefault and CurrentTheme.Accent or CurrentTheme.ElementBg2
            Corner(ToggleBg, 10)

            local ToggleCircle = Instance.new("Frame", ToggleBg)
            ToggleCircle.Size = UDim2.new(0,14,0,14)
            ToggleCircle.Position = floatEnabledDefault and UDim2.new(1,-17,0.5,-7) or UDim2.new(0,3,0.5,-7)
            ToggleCircle.BackgroundColor3 = Color3.fromRGB(255,255,255)
            Corner(ToggleCircle, 7)

            local ToggleBtn = Instance.new("TextButton", Frame)
            ToggleBtn.Size = UDim2.new(0,38,0,20)
            ToggleBtn.Position = ToggleBg.Position
            ToggleBtn.BackgroundTransparency = 1
            ToggleBtn.Text = ""

            local MainBtn = Instance.new("TextButton", Frame)
            MainBtn.Size = UDim2.new(0,44,0,24)
            MainBtn.Position = UDim2.new(1,-42,0.5,-12)
            MainBtn.BackgroundColor3 = CurrentTheme.ElementBg2
            MainBtn.Text = "▶"
            MainBtn.Font = Enum.Font.GothamBold
            MainBtn.TextSize = 12
            MainBtn.TextColor3 = CurrentTheme.Text
            Corner(MainBtn, 7)
            Stroke(MainBtn, CurrentTheme.StrokeLight, 1)

            local floatingInstance = nil
            local isFloatEnabled = floatEnabledDefault

            local function GetViewport()
                local vp = ScreenGui.AbsoluteSize
                if vp.X < 10 then
                    vp = workspace.CurrentCamera and workspace.CurrentCamera.ViewportSize or Vector2.new(1920,1080)
                end
                return vp
            end

            local function ClampFloatPartial(pos, size)
                local vp = GetViewport()
                local minX = -size.X * 0.5
                local maxX = vp.X - size.X * 0.5
                local minY = -size.Y * 0.5
                local maxY = vp.Y - size.Y * 0.5
                local x = math.clamp(pos.X.Offset, minX, maxX)
                local y = math.clamp(pos.Y.Offset, minY, maxY)
                return UDim2.fromOffset(x, y)
            end

            local function ResolveFloatPosition()
                if typeof(floatPosCfg) == "UDim2" then
                    return floatPosCfg
                elseif type(floatPosCfg) == "string" then
                    local vp = GetViewport()
                    local p = string.lower(floatPosCfg)
                    if p == "center" or p == "middle" then
                        return UDim2.fromOffset(vp.X/2 - floatSize.X/2, vp.Y/2 - floatSize.Y/2)
                    elseif p == "top" then
                        return UDim2.fromOffset(vp.X/2 - floatSize.X/2, 20)
                    elseif p == "bottom" then
                        return UDim2.fromOffset(vp.X/2 - floatSize.X/2, vp.Y - floatSize.Y - 20)
                    elseif p == "topleft" then
                        return UDim2.fromOffset(20, 20)
                    elseif p == "topright" then
                        return UDim2.fromOffset(vp.X - floatSize.X - 20, 20)
                    else
                        return UDim2.fromOffset(vp.X/2 - floatSize.X/2, vp.Y/2 - floatSize.Y/2)
                    end
                else
                    local vp = GetViewport()
                    return UDim2.fromOffset(vp.X/2 - floatSize.X/2, vp.Y/2 - floatSize.Y/2)
                end
            end

            local function CreateFloat()
                if floatingInstance then floatingInstance:Destroy() end
                local btn
                if floatImage and floatImage ~= "" then
                    btn = Instance.new("ImageButton", ScreenGui)
                    btn.Image = ResolveImageAsset(floatImage)
                else
                    btn = Instance.new("TextButton", ScreenGui)
                    btn.Text = floatText
                    btn.Font = Enum.Font.GothamBold
                    btn.TextSize = 12
                    btn.TextColor3 = Color3.new(1,1,1)
                    btn.TextWrapped = true
                end
                btn.Name = "GGH_Float_"..title
                btn.Size = UDim2.new(0, floatSize.X, 0, floatSize.Y)
                btn.Position = ResolveFloatPosition()
                btn.BackgroundColor3 = CurrentTheme.Accent
                btn.ZIndex = 199
                btn.AutoButtonColor = false
                Corner(btn, 12)
                Stroke(btn, Color3.new(1,1,1), 1).Transparency = 0.5
                btn.Active = true

                local dragging = false
                local dragStart, startPos
                local hasDragged = false

                btn.InputBegan:Connect(function(input)
                    if floatDraggable and (input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch) then
                        dragging = true
                        hasDragged = false
                        dragStart = input.Position
                        startPos = btn.Position
                    end
                end)
                UserInputService.InputChanged:Connect(function(input)
                    if dragging and floatDraggable and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
                        local delta = input.Position - dragStart
                        if delta.Magnitude > 4 then hasDragged = true end
                        local newPos = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
                        btn.Position = ClampFloatPartial(newPos, floatSize)
                    end
                end)
                UserInputService.InputEnded:Connect(function(input)
                    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                        dragging = false
                        task.wait(0.05)
                        hasDragged = false
                    end
                end)

                btn.MouseButton1Click:Connect(function()
                    if hasDragged then return end
                    pcall(callback)
                end)

                task.spawn(function()
                    while btn and btn.Parent do
                        local vp = GetViewport()
                        local abs = btn.AbsolutePosition
                        local sz = btn.AbsoluteSize
                        if sz.X > 5 then
                            local minX = -sz.X * 0.5
                            local maxX = vp.X - sz.X * 0.5
                            local minY = -sz.Y * 0.5
                            local maxY = vp.Y - sz.Y * 0.5
                            if abs.X < minX or abs.X > maxX or abs.Y < minY or abs.Y > maxY then
                                local clampedX = math.clamp(abs.X, minX, maxX)
                                local clampedY = math.clamp(abs.Y, minY, maxY)
                                btn.Position = UDim2.fromOffset(clampedX, clampedY)
                            end
                        end
                        task.wait(0.3)
                    end
                end)

                floatingInstance = btn
                return btn
            end

            local function RemoveFloat()
                if floatingInstance then
                    floatingInstance:Destroy()
                    floatingInstance = nil
                end
            end

            local function SetToggleState(state)
                isFloatEnabled = state
                if state then
                    Tween(ToggleBg, {BackgroundColor3 = CurrentTheme.Accent}, 0.15)
                    Tween(ToggleCircle, {Position = UDim2.new(1,-17,0.5,-7)}, 0.15)
                    CreateFloat()
                else
                    Tween(ToggleBg, {BackgroundColor3 = CurrentTheme.ElementBg2}, 0.15)
                    Tween(ToggleCircle, {Position = UDim2.new(0,3,0.5,-7)}, 0.15)
                    RemoveFloat()
                end
            end

            ToggleBtn.MouseButton1Click:Connect(function()
                SetToggleState(not isFloatEnabled)
            end)

            MainBtn.MouseButton1Click:Connect(function()
                Tween(MainBtn, {BackgroundColor3 = CurrentTheme.ElementBg}, 0.08)
                task.wait(0.08)
                Tween(MainBtn, {BackgroundColor3 = CurrentTheme.ElementBg2}, 0.08)
                pcall(callback)
            end)

            if isFloatEnabled then
                task.spawn(function() task.wait(0.2) CreateFloat() end)
            end

            local API = {}
            function API:SetValue(v) SetToggleState(v) return API end
            function API:GetValue() return isFloatEnabled end
            function API:SetTitle(t) TitleLabel.Text = t return API end
            function API:Fire() pcall(callback) return API end
            function API:Destroy()
                RemoveFloat()
                Frame:Destroy()
            end
            function API:Refresh(newCfg)
                if not newCfg then return API end
                if newCfg.Title then TitleLabel.Text = newCfg.Title end
                if newCfg.Callback then callback = newCfg.Callback end
                if newCfg.FloatText then floatText = newCfg.FloatText if floatingInstance and floatingInstance:IsA("TextButton") then floatingInstance.Text = floatText end end
                if newCfg.FloatImage and floatingInstance and floatingInstance:IsA("ImageButton") then floatingInstance.Image = ResolveImageAsset(newCfg.FloatImage) end
                return API
            end
            return API
        end

