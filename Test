function GGH:GetHWID()
    local hwid = "UNKNOWN"
    pcall(function()
        if gethwid then hwid = gethwid()
        elseif syn and syn.get_hwid then hwid = syn.get_hwid()
        else
            local ok, id = pcall(function() return game:GetService("RbxAnalyticsService"):GetClientId() end)
            if ok and id then hwid = id end
        end
    end)
    return tostring(hwid)
end

function GGH:MakeKeySystem(Config)
    Config = Config or {}
    local Title = Config.Title or "Key System"
    local Description = Config.Description or "Enter your key to continue"
    local GetKeyUrl = Config.GetKeyUrl or Config.GetKeyLink or Config.KeyLink or ""
    local DiscordUrl = Config.DiscordUrl or Config.ServerUrl or Config.Discord or ""
    local CustomKeys = Config.Keys or Config.ValidKeys or Config.CustomKeys or {}
    local RawUrl = Config.RawUrl or Config.PastebinUrl or Config.GitHubUrl or ""
    local APIUrl = Config.APIUrl or Config.ApiUrl or ""
    local SaveKey = Config.SaveKey ~= false
    local FileName = Config.FileName or Config.SaveFileName or "GGH_Key.txt"
    local UseHWID = Config.UseHWID or Config.HWID or false
    local HWIDList = Config.HWIDList or {}
    local OnSuccess = Config.OnSuccess or Config.SuccessCallback or function() end
    local OnFail = Config.OnFailed or Config.OnFail or function() end
    local ThemeName = Config.Theme or "Dark"
    local CurrentTheme = Themes[ThemeName] or Themes["Dark"]

    -- Executor request wrapper
    local function HttpGet(url)
        local success, result = pcall(function()
            if syn and syn.request then
                return syn.request({Url = url, Method = "GET"})
            elseif http_request then
                return http_request({Url = url, Method = "GET"})
            elseif request then
                return request({Url = url, Method = "GET"})
            elseif http and http.request then
                return http.request({Url = url, Method = "GET"})
            else
                return game:HttpGet(url)
            end
        end)
        if not success then return nil end
        if type(result) == "string" then return result end
        if type(result) == "table" and result.Body then return result.Body end
        return nil
    end

    -- Secure key validation - NO LEAK
    local function ValidateKey(inputKey)
        if not inputKey or inputKey == "" then return false, "Empty key" end
        inputKey = tostring(inputKey):gsub("^%s+", ""):gsub("%s+$", "")

        -- Method 1: Custom Developer Keys
        if #CustomKeys > 0 then
            for _, k in pairs(CustomKeys) do
                if tostring(k) == inputKey then
                    return true
                end
            end
        end

        -- Method 2: API Validation
        if APIUrl and APIUrl ~= "" then
            local url = APIUrl:gsub("{key}", inputKey):gsub("%%s", inputKey):gsub("{KEY}", inputKey)
            if not url:find(inputKey) then
                if url:find("?") then url = url .. "&key=" .. inputKey else url = url .. "?key=" .. inputKey end
            end
            local body = HttpGet(url)
            if body then
                local lower = string.lower(body)
                if lower:find('"valid"%s*:%s*true') or lower:find('"success"%s*:%s*true') or lower:find('true') and #body < 50 then
                    -- Try JSON decode
                    local ok, decoded = pcall(function() return game:GetService("HttpService"):JSONDecode(body) end)
                    if ok and decoded then
                        if decoded.valid == true or decoded.success == true or decoded.Valid == true or decoded.status == "valid" then
                            return true
                        end
                    else
                        if lower:find("valid") or lower:match("^%s*true%s*$") then
                            return true
                        end
                    end
                end
            end
        end

        -- Method 3: Raw URL / Pastebin / GitHub Raw
        if RawUrl and RawUrl ~= "" then
            local body = HttpGet(RawUrl)
            if body then
                for line in body:gmatch("[^\r\n]+") do
                    if line:gsub("%s+", "") == inputKey then
                        return true
                    end
                end
            end
        end

        -- Method 4: HWID Check (Optional)
        if UseHWID then
            local currentHwid = GGH:GetHWID()
            if #HWIDList > 0 then
                for _, v in pairs(HWIDList) do
                    if tostring(v) == currentHwid or tostring(v) == inputKey then
                        return true
                    end
                end
            end
        end

        -- If no validation method set, allow any non-empty key (dev can set CustomKeys to enforce)
        if #CustomKeys == 0 and (APIUrl == "" or not APIUrl) and (RawUrl == "" or not RawUrl) and not UseHWID then
            -- If developer didn't set any method but provided callback, we treat as valid to let dev handle custom logic outside
            -- But default: require at least 4 chars
            if #inputKey >= 3 then return true end
        end

        return false, "Invalid key"
    end

    -- Build UI
    local GuiParent = GetGuiParent()
    if GuiParent:FindFirstChild("GGH_KeySystem") then GuiParent:FindFirstChild("GGH_KeySystem"):Destroy() end

    local ScreenGui = Instance.new("ScreenGui")
    ScreenGui.Name = "GGH_KeySystem"
    ScreenGui.ResetOnSpawn = false
    ScreenGui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
    ScreenGui.Parent = GuiParent

    local Main = Instance.new("Frame", ScreenGui)
    Main.Size = UDim2.new(0, 380, 0, 270)
    Main.Position = UDim2.new(0.5, -190, 0.5, -135)
    Main.BackgroundColor3 = CurrentTheme.MainBg
    Main.BorderSizePixel = 0
    Main.ClipsDescendants = true
    Main.Active = true
    Main.Draggable = true
    Corner(Main, 12)
    Stroke(Main, CurrentTheme.Stroke, 1)

    local Header = Instance.new("Frame", Main)
    Header.Size = UDim2.new(1,0,0,48)
    Header.BackgroundColor3 = CurrentTheme.HeaderBg
    Corner(Header, 12)
    local HeaderFix = Instance.new("Frame", Header)
    HeaderFix.Size = UDim2.new(1,0,0,12)
    HeaderFix.Position = UDim2.new(0,0,1,-6)
    HeaderFix.BackgroundColor3 = CurrentTheme.HeaderBg
    HeaderFix.BorderSizePixel = 0

    local TitleLabel = Instance.new("TextLabel", Header)
    TitleLabel.Size = UDim2.new(1,-20,1,0)
    TitleLabel.Position = UDim2.new(0,15,0,0)
    TitleLabel.BackgroundTransparency = 1
    TitleLabel.Text = Title
    TitleLabel.Font = Enum.Font.GothamBold
    TitleLabel.TextSize = 16
    TitleLabel.TextColor3 = CurrentTheme.Text
    TitleLabel.TextXAlignment = Enum.TextXAlignment.Left

    local Desc = Instance.new("TextLabel", Main)
    Desc.Size = UDim2.new(1,-30,0,20)
    Desc.Position = UDim2.new(0,15,0,58)
    Desc.BackgroundTransparency = 1
    Desc.Text = Description
    Desc.Font = Enum.Font.Gotham
    Desc.TextSize = 12
    Desc.TextColor3 = CurrentTheme.SubText
    Desc.TextXAlignment = Enum.TextXAlignment.Left

    local InputFrame = Instance.new("Frame", Main)
    InputFrame.Size = UDim2.new(1,-30,0,42)
    InputFrame.Position = UDim2.new(0,15,0,88)
    InputFrame.BackgroundColor3 = CurrentTheme.ElementBg
    Corner(InputFrame, 8)
    Stroke(InputFrame, CurrentTheme.StrokeLight, 1)

    local InputBox = Instance.new("TextBox", InputFrame)
    InputBox.Size = UDim2.new(1,-16,1,0)
    InputBox.Position = UDim2.new(0,8,0,0)
    InputBox.BackgroundTransparency = 1
    InputBox.PlaceholderText = "Enter Key Here..."
    InputBox.Text = ""
    InputBox.Font = Enum.Font.Gotham
    InputBox.TextSize = 13
    InputBox.TextColor3 = CurrentTheme.Text
    InputBox.PlaceholderColor3 = CurrentTheme.SubText
    InputBox.ClearTextOnFocus = false

    local StatusLabel = Instance.new("TextLabel", Main)
    StatusLabel.Size = UDim2.new(1,-30,0,18)
    StatusLabel.Position = UDim2.new(0,15,0,135)
    StatusLabel.BackgroundTransparency = 1
    StatusLabel.Text = ""
    StatusLabel.Font = Enum.Font.GothamMedium
    StatusLabel.TextSize = 11
    StatusLabel.TextColor3 = Color3.fromRGB(255,100,100)
    StatusLabel.TextXAlignment = Enum.TextXAlignment.Left

    local SubmitBtn = Instance.new("TextButton", Main)
    SubmitBtn.Size = UDim2.new(1,-30,0,40)
    SubmitBtn.Position = UDim2.new(0,15,0,160)
    SubmitBtn.BackgroundColor3 = CurrentTheme.Accent
    SubmitBtn.Text = "Unlock"
    SubmitBtn.Font = Enum.Font.GothamBold
    SubmitBtn.TextSize = 14
    SubmitBtn.TextColor3 = Color3.new(1,1,1)
    Corner(SubmitBtn, 8)

    local BottomRow = Instance.new("Frame", Main)
    BottomRow.Size = UDim2.new(1,-30,0,38)
    BottomRow.Position = UDim2.new(0,15,0,210)
    BottomRow.BackgroundTransparency = 1

    local function CreateBottomBtn(text, pos, size)
        local btn = Instance.new("TextButton", BottomRow)
        btn.Size = size
        btn.Position = pos
        btn.BackgroundColor3 = CurrentTheme.ElementBg2
        btn.Text = text
        btn.Font = Enum.Font.GothamMedium
        btn.TextSize = 12
        btn.TextColor3 = CurrentTheme.Text
        Corner(btn, 8)
        Stroke(btn, CurrentTheme.Stroke, 1)
        return btn
    end

    local GetKeyBtn = CreateBottomBtn("Get Key", UDim2.new(0,0,0,0), UDim2.new(0.5,-4,1,0))
    local DiscordBtn = CreateBottomBtn("Copy Server", UDim2.new(0.5,4,0,0), UDim2.new(0.5,-4,1,0))

    -- Auto load saved key
    pcall(function()
        if SaveKey and isfile and isfile(FileName) then
            local saved = readfile(FileName)
            if saved and saved ~= "" then
                InputBox.Text = saved
                local valid = ValidateKey(saved)
                if valid then
                    ScreenGui:Destroy()
                    OnSuccess(saved)
                    return
                end
            end
        end
    end)

    local function SetStatus(text, color)
        StatusLabel.Text = text
        StatusLabel.TextColor3 = color or Color3.fromRGB(255,100,100)
    end

    SubmitBtn.MouseButton1Click:Connect(function()
        local key = InputBox.Text
        if key == "" then SetStatus("Please enter a key") return end
        SetStatus("Checking...", CurrentTheme.SubText)
        Tween(SubmitBtn, {BackgroundColor3 = Color3.fromRGB(70,70,80)}, 0.1)

        task.wait(0.2)
        local valid, err = ValidateKey(key)
        if valid then
            SetStatus("Success! Loading...", Color3.fromRGB(80,255,120))
            if SaveKey then
                pcall(function()
                    if writefile then writefile(FileName, key) end
                end)
            end
            Tween(Main, {Size = UDim2.new(0, 380, 0, 0)}, 0.25)
            task.wait(0.26)
            ScreenGui:Destroy()
            OnSuccess(key)
        else
            SetStatus("Invalid Key! Please try again.", Color3.fromRGB(255,80,80))
            OnFail(err)
            -- shake
            local orig = Main.Position
            for i=1,3 do
                Tween(Main, {Position = orig + UDim2.new(0,5,0,0)}, 0.05)
                task.wait(0.05)
                Tween(Main, {Position = orig + UDim2.new(0,-5,0,0)}, 0.05)
                task.wait(0.05)
            end
            Tween(Main, {Position = orig}, 0.08)
            Tween(SubmitBtn, {BackgroundColor3 = CurrentTheme.Accent}, 0.2)
        end
    end)

    GetKeyBtn.MouseButton1Click:Connect(function()
        if GetKeyUrl and GetKeyUrl ~= "" then
            pcall(function() setclipboard(GetKeyUrl) end)
            SetStatus("Link copied to clipboard!", Color3.fromRGB(80,200,255))
        else
            SetStatus("No key link set by developer", Color3.fromRGB(255,200,80))
        end
    end)

    DiscordBtn.MouseButton1Click:Connect(function()
        if DiscordUrl and DiscordUrl ~= "" then
            pcall(function() setclipboard(DiscordUrl) end)
            SetStatus("Server link copied!", Color3.fromRGB(80,200,255))
        else
            SetStatus("No server link set", Color3.fromRGB(255,200,80))
        end
    end)

    -- Hover effects
    SubmitBtn.MouseEnter:Connect(function() Tween(SubmitBtn, {BackgroundColor3 = Color3.fromRGB(CurrentTheme.Accent.R*255+20, CurrentTheme.Accent.G*255+20, CurrentTheme.Accent.B*255+20)}, 0.15) end)
    SubmitBtn.MouseLeave:Connect(function() Tween(SubmitBtn, {BackgroundColor3 = CurrentTheme.Accent}, 0.15) end)

    return ScreenGui
end

