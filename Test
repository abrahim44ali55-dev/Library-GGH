            -- الحجم المناسب حسب قياس الشاشة - 85% عرض و 80% ارتفاع كحد اقصى
            local maxW = math.clamp(vp.X * 0.88, 340, 620)
            local maxH = math.clamp(vp.Y * 0.78, 300, 500)
            local curSize = Main.AbsoluteSize
            -- اذا الحجم الحالي اكبر من الشاشة، صغره تلقائيا
            if curSize.X > vp.X - 20 or curSize.Y > vp.Y - 80 then
                Main.Size = UDim2.fromOffset(math.min(curSize.X, maxW), math.min(curSize.Y, maxH))
            end
            ClampFrameToScreen(Main, ScreenGui)
        end

