function GGH:MakeKeySystem(Config)
    Config = Config or {}
    local Title = Config.Title or "Key System"
    local Description = Config.Description or "Enter your key to continue"
    local GetKeyUrl = Config.GetKeyUrl or Config.GetKeyLink or Config.KeyLink or ""
    local DiscordUrl = Config.DiscordUrl or Config.ServerUrl or Config.Discord or ""
    local CustomKeys = Config.Keys or Config.ValidKeys or Config.CustomKeys or {}
    local RawUrl = Config.RawUrl or Config.PastebinUrl or Config.GitHubUrl or ""
    local APIUrl = Config.APIUrl or Config.ApiUrl or ""
    local SaveKey = Config.SaveKey ~= false
    local FileName = Config.FileName or Config.SaveFileName or "GGH_Key.txt"
    local UseHWID = Config.UseHWID or Config.HWID or false
    local HWIDList = Config.HWIDList or {}
    local OnSuccess = Config.OnSuccess or Config.SuccessCallback or function() end
    local OnFail = Config.OnFailed or Config.OnFail or function() end
    local ThemeName = Config.Theme or "Dark"
    local CurrentTheme = Themes[ThemeName] or Themes["Dark"]

    local function HttpGet(url)
        local success, result = pcall(function()
            if syn and syn.request then
                return syn.request({Url = url, Method = "GET"})
            elseif http_request then
                return http_request({Url = url, Method = "GET"})
            elseif request then
                return request({Url = url, Method = "GET"})
            elseif http and http.request then
                return http.request({Url = url, Method = "GET"})
            else
                return game:HttpGet(url)
            end
        end)
        if not success then return nil end
        if type(result) == "string" then return result end
        if type(result) == "table" and result.Body then return result.Body end
        return nil
    end

    local function ValidateKey(inputKey)
        if not inputKey or inputKey == "" then return false, "Empty key" end
        inputKey = tostring(inputKey):gsub("^%s+", ""):gsub("%s+$", "")

        if #CustomKeys > 0 then
            for _, k in pairs(CustomKeys) do
                if tostring(k) == inputKey then
                    return true
                end
            end
        end

        if APIUrl and APIUrl ~= "" then
            local url = APIUrl:gsub("{key}", inputKey):gsub("%%s", inputKey):gsub("{KEY}", inputKey)
            if not url:find(inputKey) then
                if url:find("?") then url = url .. "&key=" .. inputKey else url = url .. "?key=" .. inputKey end
            end
            local body = HttpGet(url)
            if body then
                local lower = string.lower(body)
                if lower:find('"valid"%s*:%s*true') or lower:find('"success"%s*:%s*true') or lower:find('true') and #body < 50 then
                    local ok, decoded = pcall(function() return game:GetService("HttpService"):JSONDecode(body) end)
                    if ok and decoded then
                        if decoded.valid == true or decoded.success == true or decoded.Valid == true or decoded.status == "valid" then
                            return true
                        end
                    else
                        if lower:find("valid") or lower:match("^%s*true%s*$") then
                            return true
                        end
                    end
                end
            end
        end

        if RawUrl and RawUrl ~= "" then
            local body = HttpGet(RawUrl)
            if body then
                for line in body:gmatch("[^\r\n]+") do
                    if line:gsub("%s+", "") == inputKey then
                        return true
                    end
                end
            end
        end

        if UseHWID then
            local currentHwid = GGH:GetHWID()
            if #HWIDList > 0 then
                for _, v in pairs(HWIDList) do
                    if tostring(v) == currentHwid or tostring(v) == inputKey then
                        return true
                    end
                end
            end
        end

        if #CustomKeys == 0 and (APIUrl == "" or not APIUrl) and (RawUrl == "" or not RawUrl) and not UseHWID then
            if #inputKey >= 3 then return true end
        end

        return false, "Invalid key"
    end

    local GuiParent = GetGuiParent()
    if GuiParent:FindFirstChild("GGH_KeySystem") then GuiParent:FindFirstChild("GGH_KeySystem"):Destroy() end

    local ScreenGui = Instance.new("ScreenGui")
    ScreenGui.Name = "GGH_KeySystem"
    ScreenGui.ResetOnSpawn = false
    ScreenGui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
    ScreenGui.Parent = GuiParent

    local Main = Instance.new("Frame", ScreenGui)
    Main.Size = UDim2.new(0, 380, 0, 270)
