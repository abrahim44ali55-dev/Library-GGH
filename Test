local function resolveTheme(themeValue)
	if type(themeValue) == "table" and themeValue.Background then
		return themeValue
	end
	if type(themeValue) == "string" and GGH_THEMES[themeValue] then
		return GGH_THEMES[themeValue]
	end
	if type(themeValue) == "string" then
		warn("[GGH] Unknown theme '" .. themeValue .. "', using Default")
	end
	return GGH_THEMES.Default
end


-- ===========================================================================
-- ConfigurationManager - load / save flags, in-memory + executor file fallback
-- ===========================================================================
local configurationManager = {}
configurationManager._memory = {}

function configurationManager:cleanName(name)
	name = tostring(name or "")
	name = string.gsub(name, "[^%w%-_]", "")
	return name
end

function configurationManager:getPath(configurationName, folderName)
	local cleanName = self:cleanName(configurationName)
	if cleanName == "" then
		warn("[GGH] Configuration name has no usable characters")
		return nil
	end
	local folder = folderName or "GGH"
	-- Only executor environments provide writefile/readfile. In normal
	-- Roblox this is intentionally unused; we keep in-memory state.
	if type(getgenv) == "function" and type(writefile) == "function" then
		return folder, cleanName
	end
	return nil, cleanName
end

function configurationManager:save(windowController, configurationName, folderName)
	local data = {}
	for flagName, control in pairs(windowController.controls or {}) do
		if control.GetValue then
			local ok, value = pcall(function() return control:GetValue() end)
			if ok then data[flagName] = value end
		end
	end
	self._memory[configurationName or "GGH"] = data
	local folder, cleanName = self:getPath(configurationName, folderName)
	if folder and type(writefile) == "function" then
		local ok, encoded = pcall(function() return HttpService:JSONEncode(data) end)
		if ok then
			pcall(function()
				if not isfolder(folder) then makefolder(folder) end
				writefile(folder .. "/" .. cleanName .. ".json", encoded)
			end)
		end
	end
	return true
end

function configurationManager:load(windowController, configurationName, folderName)
	local data = self._memory[configurationName or "GGH"]
	if not data then
		local folder, cleanName = self:getPath(configurationName, folderName)
		if folder and type(readfile) == "function" then
			local ok, content = pcall(function() return readfile(folder .. "/" .. cleanName .. ".json") end)
			if ok and content then
				local decodeOk, decoded = pcall(function() return HttpService:JSONDecode(content) end)
				if decodeOk then data = decoded end
			end
		end
	end
	if type(data) ~= "table" then return false end
	for flagName, value in pairs(data) do
		local control = windowController.controls and windowController.controls[flagName]
		if control and control.Set then
			pcall(function() control:Set(value) end)
		end
	end
	return true
end

GGH.ConfigurationManager = configurationManager

