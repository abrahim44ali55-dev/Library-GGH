            end
        end
        task.spawn(function()
            while mainFrame.Parent do
                enforce()
                task.wait(0.2)
            end
        end)
        workspace.CurrentCamera:GetPropertyChangedSignal("ViewportSize"):Connect(function()
            enforce()
        end)
        return enforce
    end

    local function SafeSetPosition(frame, xScale, xOffset, yScale, yOffset)
        local vp = GetViewportSize()
        local size = frame.AbsoluteSize
        if size.X == 0 then size = Vector2.new(frame.Size.X.Offset, frame.Size.Y.Offset) end
        local clampedX = math.clamp(xOffset, 0, math.max(0, vp.X - size.X - 8))
        local clampedY = math.clamp(yOffset, 0, math.max(0, vp.Y - size.Y - 8))
        frame.Position = UDim2.new(xScale, clampedX, yScale, clampedY)
    end

