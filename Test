-- Creates a local icon: an ImageLabel when an override exists, else a
-- TextLabel glyph. Returns the label so callers can tint it.
local function createIcon(iconValue, parent, size, textColor)
	size = size or 20
	local override = nil
	if type(iconValue) == "string" and GGH.AssetOverrides[iconValue] then
		override = GGH.AssetOverrides[iconValue]
	end
	if type(iconValue) == "string" and string.find(iconValue, "rbxasset") then
		override = iconValue
	end
	if override then
		return createInstance("ImageLabel", {
			Name = "GGH_Icon",
			Size = UDim2.fromOffset(size, size),
			BackgroundTransparency = 1,
			Image = override,
			ScaleType = Enum.ScaleType.Fit,
			ImageColor3 = textColor or Color3.fromRGB(255, 255, 255),
		}, parent)
	end
	local glyph = "•"
	if type(iconValue) == "string" then
		local entry = iconRegistry[iconValue] or iconRegistry.default
		glyph = entry.glyph
		if string.len(iconValue) <= 3 and iconValue ~= "GGH" then
			glyph = iconValue
		end
	end
	if type(iconValue) == "string" and string.len(iconValue) > 3 and not iconRegistry[iconValue] then
		-- A custom single emoji / character passed as tab icon.
		glyph = iconValue
	end
	return createInstance("TextLabel", {
		Name = "GGH_Icon",
		Size = UDim2.fromOffset(size, size),
		BackgroundTransparency = 1,
		Text = glyph,
		TextColor3 = textColor or Color3.fromRGB(255, 255, 255),
		TextSize = size - 2,
		Font = Enum.Font.GothamBold,
		TextXAlignment = Enum.TextXAlignment.Center,
		TextYAlignment = Enum.TextYAlignment.Center,
	}, parent)
end

