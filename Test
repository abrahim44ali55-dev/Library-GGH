            end
            function API:GetStat(nameOrIndex)
                for idx, it in ipairs(statLabels) do
                    if type(nameOrIndex) == "number" and idx == nameOrIndex then
                        return it.valueLabel.Text
                    elseif string.lower(it.cfg.Name or "") == string.lower(tostring(nameOrIndex)) then
