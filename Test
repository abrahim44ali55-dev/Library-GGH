    local function ClampFrameInsideScreen(frame, padding)
        padding = padding or 8
        local vp = GetViewportSize()
        local absPos = frame.AbsolutePosition
        local absSize = frame.AbsoluteSize
        if absSize.X == 0 or absSize.Y == 0 then return end
        local minX = padding
        local minY = padding
        local maxX = vp.X - absSize.X - padding
        local maxY = vp.Y - absSize.Y - padding
        if maxX < minX then maxX = minX end
        if maxY < minY then maxY = minY end
        local curX = frame.Position.X.Offset
        local curY = frame.Position.Y.Offset
        local newX = math.clamp(curX, minX, maxX)
        local newY = math.clamp(curY, minY, maxY)
        if newX ~= curX or newY ~= curY then
            frame.Position = UDim2.new(frame.Position.X.Scale, newX, frame.Position.Y.Scale, newY)
        end
        return newX, newY
    end

    local function PreventWindowOutsideScreen(mainFrame, floatingIcon)
        local function enforce()
            ClampFrameInsideScreen(mainFrame, 4)
            if floatingIcon and floatingIcon.Parent then
