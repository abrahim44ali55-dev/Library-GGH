        local useExpire = Config.KeyExpiration or Config.Expiration or Config.KeyExpires or false
        local duration = Config.KeyDuration or Config.Duration or 86400
        local saveFolder = "GGH_Keys"
        local function getHWID()
            local hwid = "UNKNOWN"
            local ok, res = pcall(function() return gethwid and gethwid() or "" end)
            if ok and res and res ~= "" then hwid = res
            else
                local ok2, res2 = pcall(function() return game:GetService("RbxAnalyticsService"):GetClientId() end)
                if ok2 and res2 ~= "" then hwid = res2
                else hwid = tostring(Player.UserId).."-"..tostring(Player.AccountAge)
                end
            end
            return hwid
        end
        local function loadSavedKey()
            if not (isfolder and isfile and readfile) then return nil end
            if not isfolder(saveFolder) then return nil end
            local hwid = getHWID()
            for _, key in ipairs(correctKeys) do
                local path = saveFolder.."/"..key:gsub("[^%w]", "_")..".json"
                if isfile(path) then
                    local ok, content = pcall(function() return readfile(path) end)
                    if ok and content then
                        local data = {}
                        pcall(function() data = HttpService:JSONDecode(content) end)
                        if useHWID and data.hwid and data.hwid ~= hwid then
                        else
                            if useExpire and data.timestamp then
                                local elapsed = os.time() - data.timestamp
                                if elapsed > duration then
                                    pcall(function() delfile(path) end)
                                else
                                    return {valid=true, key=key, remaining=duration - elapsed}
                                end
                            else
                                return {valid=true, key=key}
                            end
                        end
                    end
                end
            end
            return nil
        end
        local function saveKey(key)
