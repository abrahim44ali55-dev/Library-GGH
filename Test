            function API:RemoveStat(nameOrIndex)
                for i=#statLabels,1,-1 do
                    local it = statLabels[i]
                    local match = false
                    if type(nameOrIndex) == "number" and i == nameOrIndex then match = true end
                    if type(nameOrIndex) == "string" and string.lower(it.cfg.Name or "") == string.lower(nameOrIndex) then match = true end
                    if match then
