            local function FetchRawValue(rawUrl, keyPath)
                if not rawUrl or rawUrl == "" then return nil end
                local ok, result = pcall(function()
                    return game:HttpGet(rawUrl)
                end)
                if not ok then return nil end
                -- حاول JSON
                local ok2, json = pcall(function() return HttpService:JSONDecode(result) end)
                if ok2 and type(json) == "table" then
                    if keyPath and keyPath ~= "" then
                        -- دعم key مثل a.b.c
                        local cur = json
                        for k in string.gmatch(keyPath, "[^%.]+") do
                            if type(cur) == "table" then cur = cur[k] else cur = nil break end
                        end
                        return cur
                    else
                        return json
                    end
                else
                    return result
                end
            end

