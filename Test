local Elements = {}
        local AllElements = {}
        local function RegisterElement(api, typeName, cfg)
            if api and type(api)=="table" then
                api.Type = typeName
                api.Config = cfg
                table.insert(AllElements, api)
            end
            return api
        end

        function Elements:Add(Type, Cfg)
            Cfg = Cfg or {}
            Type = string.lower(tostring(Type))
            local api = nil
            if Type == "section" then api = CreateSection(Cfg)
            elseif Type == "paragraph" then api = CreateParagraph(Cfg)
            elseif Type == "button" then api = CreateButton(Cfg)
            elseif Type == "toggle" then api = CreateToggle(Cfg)
            elseif Type == "slider" then api = CreateSlider(Cfg)
            elseif Type == "input" then api = CreateInput(Cfg)
            elseif Type == "dropdown" then api = CreateDropdown(Cfg)
            elseif Type == "colorpicker" or Type == "color" then api = CreateColorpicker(Cfg)
            elseif Type == "keybind" or Type == "key" then api = CreateKeybind(Cfg)
            elseif Type == "code" then api = CreateCode(Cfg)
            elseif Type == "label" then api = CreateLabel(Cfg)
            elseif Type == "separator" or Type == "line" or Type == "divider" then api = CreateSeparator(Cfg)
            elseif Type == "image" or Type == "img" or Type == "logo" then api = CreateImage(Cfg)
            else warn("[GGH Library v1.8.1] Unknown Add type: "..tostring(Type))
            end
            if api and type(api)=="table" and not api.Refresh then
                function api:Refresh(newCfg)
                    if newCfg and type(newCfg)=="table" then
                        for k,v in pairs(newCfg) do Cfg[k]=v end
                    end
                    return api
                end
            end
            return RegisterElement(api, Type, Cfg)
        end

        function Elements:RefreshAll()
            for _, el in ipairs(AllElements) do
                if el and el.Refresh then pcall(function() el:Refresh() end) end
            end
        end
        function Elements:GetAll() return AllElements end
        function Elements:Section(Cfg) return self:Add("Section", Cfg) end
        function Elements:Paragraph(Cfg) return self:Add("Paragraph", Cfg) end
        function Elements:Button(Cfg) return self:Add("Button", Cfg) end
