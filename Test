local function createSlider(windowController, tabController, props)
	local sliderController = {}
	sliderController.__type = "Slider"
	sliderController.name = getProp(props, "name", "Name") or "Slider"
	sliderController.flag = getProp(props, "flag", "Flag")
	sliderController.callback = getProp(props, "callback", "Callback") or function() end
	sliderController.min = getProp(props, "min", "Min") or 0
	sliderController.max = getProp(props, "max", "Max") or 100
	sliderController.increment = getProp(props, "increment", "Increment") or 1
	sliderController.current = getProp(props, "default", "Default", "value", "Value") or sliderController.min
	sliderController.value = sliderController.current
	local row = buildElementRow(windowController, tabController, sliderController.name, 54)
	createInstance("TextLabel", {
		Text = sliderController.name,
		TextColor3 = windowController.activeTheme.Text,
		TextSize = 14,
		Font = Enum.Font.GothamMedium,
		TextXAlignment = Enum.TextXAlignment.Left,
		Size = UDim2.new(1, -50, 0, 18),
		BackgroundTransparency = 1,
	}, row)
	local valueLabel = createInstance("TextLabel", {
		Text = tostring(sliderController.current),
		TextColor3 = windowController.activeTheme.SubText,
		TextSize = 13,
		Font = Enum.Font.Gotham,
		TextXAlignment = Enum.TextXAlignment.Right,
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, 0, 0, 0),
		Size = UDim2.new(0, 46, 0, 18),
		BackgroundTransparency = 1,
	}, row)
	local track = createInstance("Frame", {
		Size = UDim2.new(1, 0, 0, 6),
		Position = UDim2.new(0, 0, 0, 32),
		BackgroundColor3 = windowController.activeTheme.ElementBackgroundHover,
		BorderSizePixel = 0,
	}, row)
	addCorner(track, 3)
	local fill = createInstance("Frame", {
		Size = UDim2.new(0.5, 0, 1, 0),
		BackgroundColor3 = windowController.activeTheme.Accent,
		BorderSizePixel = 0,
	}, track)
	addCorner(fill, 3)
	local function applySlider()
		local ratio = 0
		if sliderController.max ~= sliderController.min then
			ratio = (sliderController.current - sliderController.min) / (sliderController.max - sliderController.min)
		end
		ratio = clampNumber(ratio, 0, 1)
		fill.Size = UDim2.new(ratio, 0, 1, 0)
		valueLabel.Text = tostring(sliderController.current)
	end
	function sliderController:Set(newValue)
		sliderController.current = clampNumber(newValue, sliderController.min, sliderController.max)
		sliderController.value = sliderController.current
		applySlider()
		runGuardedCallback(windowController, sliderController, sliderController.callback, sliderController.current)
	end
	function sliderController:GetValue() return sliderController.current end
	local dragging = false
	local function updateFromInput(input)
		local relative = (input.Position.X - track.AbsolutePosition.X) / math.max(track.AbsoluteSize.X, 1)
		relative = clampNumber(relative, 0, 1)
		local raw = sliderController.min + (sliderController.max - sliderController.min) * relative
		local stepped = math.floor(raw / sliderController.increment + 0.5) * sliderController.increment
		sliderController:Set(stepped)
	end
	track.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			dragging = true
			updateFromInput(input)
		end
	end)
	UserInputService.InputChanged:Connect(function(input)
		if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
			updateFromInput(input)
		end
	end)
	UserInputService.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			dragging = false
		end
	end)
	applySlider()
	sliderController.instance = row
	if sliderController.flag then windowController.controls[sliderController.flag] = sliderController end
	return sliderController
end

