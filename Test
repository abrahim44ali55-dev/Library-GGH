    function Window:SetTransparency(winT, elemT)
        if winT then
            if winT>1 then winT=winT/100 end
            WindowAPI_Trans_W = math.clamp(winT,0,0.7)
            Main.BackgroundTransparency = WindowAPI_Trans_W
            Header.BackgroundTransparency = WindowAPI_Trans_W
            HeaderFix.BackgroundTransparency = WindowAPI_Trans_W
            TabList.BackgroundTransparency = WindowAPI_Trans_W
        end
        if elemT then
            if elemT>1 then elemT=elemT/100 end
            WindowAPI_Trans_E = math.clamp(elemT,0,0.7)
            for _,b in ipairs(TabList:GetChildren()) do if b:IsA("TextButton") then b.BackgroundTransparency = WindowAPI_Trans_E end end
            for _,page in ipairs(Container:GetChildren()) do
                if page:IsA("ScrollingFrame") then
                    for _,v in ipairs(page:GetDescendants()) do
                        if v:IsA("Frame") or v:IsA("TextButton") then
                            if v.BackgroundColor3==CurrentTheme.ElementBg or v.BackgroundColor3==CurrentTheme.ElementBg2 or v.BackgroundColor3==CurrentTheme.TabListBg then
                                v.BackgroundTransparency = WindowAPI_Trans_E
                            end
                        end
                    end
                end
            end
        end
    end
    function Window:Update(newCfg)
        newCfg = newCfg or {}
        if newCfg.Title then TitleLabel.Text = newCfg.Title end
        if newCfg.SubTitle then SubLabel.Text = newCfg.SubTitle end
        if newCfg.WindowTransparency or newCfg.ElementTransparency or newCfg.WindowTrans or newCfg.ElementTrans then
            self:SetTransparency(newCfg.WindowTransparency or newCfg.WindowTrans, newCfg.ElementTransparency or newCfg.ElementTrans)
        end
        if newCfg.Theme and Themes[newCfg.Theme] then
            CurrentTheme = Themes[newCfg.Theme]
            local function GetLum(c) return 0.299*c.R+0.587*c.G+0.114*c.B end
            local lum = GetLum(CurrentTheme.MainBg)
            if lum>0.5 then CurrentTheme.Text=Color3.fromRGB(20,20,25) CurrentTheme.SubText=Color3.fromRGB(80,80,85) else CurrentTheme.Text=Color3.fromRGB(240,240,245) CurrentTheme.SubText=Color3.fromRGB(180,180,190) end
            Main.BackgroundColor3 = CurrentTheme.MainBg
            Header.BackgroundColor3 = CurrentTheme.HeaderBg
            HeaderFix.BackgroundColor3 = CurrentTheme.HeaderBg
            TabList.BackgroundColor3 = CurrentTheme.TabListBg
            TitleLabel.TextColor3 = CurrentTheme.Text
            SubLabel.TextColor3 = CurrentTheme.SubText
        end
    end
    function Window:Refresh() self:Update({}) end
    function Window:ClearAllTabs()
        for _,b in ipairs(TabList:GetChildren()) do if b:IsA("TextButton") then b:Destroy() end end
        for _,p in ipairs(Container:GetChildren()) do if p:IsA("ScrollingFrame") then p:Destroy() end end
        table.clear(Tabs)
    end
    function Window:RemoveTab(name)
        if Tabs[name] then
            Tabs[name].Button:Destroy()
            Tabs[name].Page:Destroy()
            Tabs[name]=nil
        end
    end
    function Window:GetTab(name) return Tabs[name] end

        return Window
end

function GGH:GetHWID()
    local hwid = "UNKNOWN"
    pcall(function()
        if gethwid then hwid = gethwid()
        elseif syn and syn.get_hwid then hwid = syn.get_hwid()
        else
            local ok, id = pcall(function() return game:GetService("RbxAnalyticsService"):GetClientId() end)
            if ok and id then hwid = id end
        end
    end)
    return tostring(hwid)
end

function GGH:MakeKeySystem(Config)
    Config = Config or {}
    local Title = Config.Title or "Key System"
    local Description = Config.Description or "Enter your key to continue"
    local GetKeyUrl = Config.GetKeyUrl or Config.GetKeyLink or Config.KeyLink or ""
    local DiscordUrl = Config.DiscordUrl or Config.ServerUrl or Config.Discord or ""
    local CustomKeys = Config.Keys or Config.ValidKeys or Config.CustomKeys or {}
    local RawUrl = Config.RawUrl or Config.PastebinUrl or Config.GitHubUrl or ""
    local APIUrl = Config.APIUrl or Config.ApiUrl or ""
    local SaveKey = Config.SaveKey ~= false
    local FileName = Config.FileName or Config.SaveFileName or "GGH_Key.txt"
    local UseHWID = Config.UseHWID or Config.HWID or false
    local HWIDList = Config.HWIDList or {}
    local OnSuccess = Config.OnSuccess or Config.SuccessCallback or function() end
    local OnFail = Config.OnFailed or Config.OnFail or function() end
    local ThemeName = Config.Theme or "Dark"
    local CurrentTheme = Themes[ThemeName] or Themes["Dark"]

    local function HttpGet(url)
        local success, result = pcall(function()
            if syn and syn.request then
                return syn.request({Url = url, Method = "GET"})
            elseif http_request then
                return http_request({Url = url, Method = "GET"})
            elseif request then
                return request({Url = url, Method = "GET"})
            elseif http and http.request then
                return http.request({Url = url, Method = "GET"})
            else
                return game:HttpGet(url)
            end
        end)
        if not success then return nil end
        if type(result) == "string" then return result end
        if type(result) == "table" and result.Body then return result.Body end
        return nil
    end

    local function ValidateKey(inputKey)
        if not inputKey or inputKey == "" then return false, "Empty key" end
        inputKey = tostring(inputKey):gsub("^%s+", ""):gsub("%s+$", "")

        if #CustomKeys > 0 then
            for _, k in pairs(CustomKeys) do
                if tostring(k) == inputKey then
                    return true
                end
            end
        end

        if APIUrl and APIUrl ~= "" then
            local url = APIUrl:gsub("{key}", inputKey):gsub("%%s", inputKey):gsub("{KEY}", inputKey)
            if not url:find(inputKey) then
                if url:find("?") then url = url .. "&key=" .. inputKey else url = url .. "?key=" .. inputKey end
            end
            local body = HttpGet(url)
            if body then
                local lower = string.lower(body)
                if lower:find('"valid"%s*:%s*true') or lower:find('"success"%s*:%s*true') or lower:find('true') and #body < 50 then
                    local ok, decoded = pcall(function() return game:GetService("HttpService"):JSONDecode(body) end)
                    if ok and decoded then
                        if decoded.valid == true or decoded.success == true or decoded.Valid == true or decoded.status == "valid" then
                            return true
                        end
                    else
                        if lower:find("valid") or lower:match("^%s*true%s*$") then
                            return true
                        end
                    end
                end
            end
        end

        if RawUrl and RawUrl ~= "" then
            local body = HttpGet(RawUrl)
            if body then
                for line in body:gmatch("[^\r\n]+") do
                    if line:gsub("%s+", "") == inputKey then
                        return true
                    end
                end
            end
        end

        if UseHWID then
            local currentHwid = GGH:GetHWID()
            if #HWIDList > 0 then
                for _, v in pairs(HWIDList) do
                    if tostring(v) == currentHwid or tostring(v) == inputKey then
                        return true
                    end
                end
            end
        end

        if #CustomKeys == 0 and (APIUrl == "" or not APIUrl) and (RawUrl == "" or not RawUrl) and not UseHWID then
            if #inputKey >= 3 then return true end
        end

        return false, "Invalid key"
    end

    local GuiParent = GetGuiParent()
    if GuiParent:FindFirstChild("GGH_KeySystem") then GuiParent:FindFirstChild("GGH_KeySystem"):Destroy() end

    local ScreenGui = Instance.new("ScreenGui")
    ScreenGui.Name = "GGH_KeySystem"
    ScreenGui.ResetOnSpawn = false
    ScreenGui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
    ScreenGui.Parent = GuiParent

    local Main = Instance.new("Frame", ScreenGui)
    Main.Size = UDim2.new(0, 380, 0, 270)
    Main.Position = UDim2.new(0.5, -190, 0.5, -135)
    Main.BackgroundColor3 = CurrentTheme.MainBg
    Main.BorderSizePixel = 0
    Main.ClipsDescendants = true
    Main.Active = true
    Main.Draggable = true
    Corner(Main, 12)
    Stroke(Main, CurrentTheme.Stroke, 1)

    local Header = Instance.new("Frame", Main)
    Header.Size = UDim2.new(1,0,0,48)
    Header.BackgroundColor3 = CurrentTheme.HeaderBg
    Corner(Header, 12)
    local HeaderFix = Instance.new("Frame", Header)
    HeaderFix.Size = UDim2.new(1,0,0,12)
    HeaderFix.Position = UDim2.new(0,0,1,-6)
    HeaderFix.BackgroundColor3 = CurrentTheme.HeaderBg
    HeaderFix.BorderSizePixel = 0

    local TitleLabel = Instance.new("TextLabel", Header)
