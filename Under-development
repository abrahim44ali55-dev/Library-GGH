	local increment = tonumber(config.Increment) or 1
	assert(maximum >= minimum, "Stepper Max cannot be smaller than Min.")
	assert(increment > 0 and increment ~= math.huge, "Stepper Increment must be a finite positive number.")
	local handle, _, control = self:_createBase(config, 54)
	local value = clamp(tonumber(config.Default) or minimum, minimum, maximum)
	local display = label(control, tostring(value), UDim2.new(1, -72, 1, 0), UDim2.fromOffset(36, 0), self.window:_theme().Text, 12, {
		TextXAlignment = Enum.TextXAlignment.Center,
