function Tab:CreateInput(config)
	config = config or {}
	local handle, _, control = self:_createBase(config, config.Multiline and 82 or 58)
	local value = config.Default == nil and "" or tostring(config.Default)
	local input = make("TextBox", control, {
		BackgroundColor3 = self.window:_theme().ComponentBackground,
		BorderSizePixel = 0,
		ClearTextOnFocus = false,
		Font = Enum.Font.Gotham,
		MultiLine = config.Multiline == true,
		PlaceholderText = tostring(config.Placeholder or "Enter text"),
		Position = UDim2.new(0, 0, 0, config.Multiline and 4 or 12),
		Size = UDim2.new(1, 0, 0, config.Multiline and 64 or 34),
		Text = value,
		TextColor3 = self.window:_theme().Text,
		TextSize = 11,
		TextWrapped = config.Multiline == true,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextYAlignment = config.Multiline and Enum.TextYAlignment.Top or Enum.TextYAlignment.Center,
	})
	rounded(input, 6)
	make("UIPadding", input, {
		PaddingLeft = UDim.new(0, 9), PaddingRight = UDim.new(0, 8),
		PaddingTop = UDim.new(0, config.Multiline and 8 or 0),
	})
	local suppressedTextChange
	local function setValue(nextValue, notify)
		value = tostring(nextValue == nil and "" or nextValue)
		if input.Text ~= value then
			suppressedTextChange = value
			input.Text = value
		end
