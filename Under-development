function Tab:CreateColorPicker(config)
	config = config or {}
	local handle, root, control = self:_createBase(config, 58)
	local value = typeof(config.Default) == "Color3" and config.Default or Color3.fromRGB(111, 126, 255)
	local transparency = clamp(tonumber(config.TransparencyValue) or 0, 0, 1)
	local expanded = false
	local swatch = button(control, "", UDim2.fromOffset(44, 30), UDim2.new(1, -44, 0.5, -15))
	local panel = make("Frame", root, {
		BackgroundColor3 = self.window:_theme().SecondaryBackground,
