function Tab:Select()
	return self.window:_selectTab(self, true)
end

function Tab:_createBase(config, height)
	local window = self.window
	assert(not window._destroyed and not self._removed, "Cannot add a component to a destroyed tab.")
	config = config or {}
	local theme = window:_theme()
	window._componentOrder = window._componentOrder + 1
	local root = make("Frame", self.page, {
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		LayoutOrder = window._componentOrder,
		Size = UDim2.new(1, 0, 0, height or 58),
	})
	root:SetAttribute("ConfigKey", tostring(config.ConfigKey or (self.name .. "/" .. tostring(config.Name or config.Title or ("Component" .. tostring(window._componentOrder))))))
	local title = label(root, tostring(config.Name or config.Title or ""), UDim2.new(0.53, -8, 0, 20), UDim2.fromOffset(0, 2), theme.Text, 13, {
		Name = "ComponentTitle",
		Font = Enum.Font.GothamMedium,
		TextTruncate = Enum.TextTruncate.AtEnd,
	})
	local description
	if config.Description then
		description = label(root, tostring(config.Description), UDim2.new(0.53, -8, 0, 28), UDim2.fromOffset(0, 23), theme.SecondaryText, 10, {
			Name = "ComponentDescription",
			TextWrapped = true,
			TextYAlignment = Enum.TextYAlignment.Top,
		})
		title.Position = UDim2.fromOffset(0, 0)
	end
	local control = make("Frame", root, {
		BackgroundTransparency = 1,
		Position = UDim2.new(0.53, 0, 0, 0),
		Size = UDim2.new(0.47, 0, 1, 0),
	})
	local disabledOverlay = make("TextButton", root, {
		Active = true,
		AutoButtonColor = false,
		BackgroundColor3 = theme.Background,
		BackgroundTransparency = 0.42,
		BorderSizePixel = 0,
		Size = UDim2.new(1, 0, 1, 0),
		Text = "",
		Visible = false,
		ZIndex = 50,
	})
	disabledOverlay.Name = "DisabledOverlay"
	local handle = setmetatable({
		window = window,
		tab = self,
		Root = root,
		TitleLabel = title,
		DescriptionLabel = description,
		Control = control,
		Enabled = true,
		Visible = true,
		_callback = config.Callback,
		_connections = {},
		_destroyed = false,
	}, Component)
	function handle:_connect(signal, callback)
		return window:_connect(signal, callback, self._connections)
	end
	function handle:Invoke(...)
		if self.Enabled and not self._destroyed then
			invoke(window, self._callback, ...)
		end
	end
	function handle:SetCallback(callback)
		assert(callback == nil or type(callback) == "function", "Callback must be a function or nil.")
		self._callback = callback
	end
	function handle:SetVisible(visible)
		self.Visible = visible == true
		if root.Parent then
			root.Visible = self.Visible
		end
	end
	function handle:SetEnabled(enabled)
		self.Enabled = enabled == true
		if disabledOverlay.Parent then
			disabledOverlay.Visible = not self.Enabled
		end
	end
	function handle:SetText(text)
		if self.TitleLabel and self.TitleLabel.Parent then
			self.TitleLabel.Text = tostring(text)
		end
	end
	function handle:SetDescription(text)
		if not self.DescriptionLabel and text ~= nil and text ~= "" then
			self.DescriptionLabel = label(root, tostring(text), UDim2.new(0.53, -8, 0, 28), UDim2.fromOffset(0, 23), window:_theme().SecondaryText, 10, {
				Name = "ComponentDescription",
				TextWrapped = true,
				TextYAlignment = Enum.TextYAlignment.Top,
			})
			self.TitleLabel.Position = UDim2.fromOffset(0, 0)
		end
		if self.DescriptionLabel and self.DescriptionLabel.Parent then
			self.DescriptionLabel.Text = tostring(text or "")
			self.DescriptionLabel.Visible = text ~= nil and text ~= ""
		end
	end
	function handle:Destroy()
		if self._destroyed then
			return
		end
		self._destroyed = true
		for _, connection in ipairs(self._connections) do
			connection:Disconnect()
		end
		table.clear(self._connections)
		if self._valueCleanup then
			self._valueCleanup()
		end
		if self._applyTheme then
			for i, item in ipairs(window._components) do
				if item == self then
					table.remove(window._components, i)
					break
				end
			end
		end
		for instance, tween in pairs(window._tweens) do
			if instance == root or instance:IsDescendantOf(root) then
				tween:Cancel()
				window._tweens[instance] = nil
			end
		end
		for i, item in ipairs(self.tab.components) do
			if item == self then
				table.remove(self.tab.components, i)
				break
			end
		end
		if root.Parent then
			root:Destroy()
		end
	end
	function handle:Update()
		if self._applyTheme then
			self._applyTheme(window:_theme())
		end
	end
	function handle:_setValueMethods(getter, setter)
		self._getValue = getter
		self._setValue = setter
		function self:GetValue()
			return getter()
		end
		function self:SetValue(value, shouldNotify)
			setter(value, shouldNotify == true)
		end
	end
	handle._applyTheme = function(currentTheme)
		title.TextColor3 = currentTheme.Text
		if description then
			description.TextColor3 = currentTheme.SecondaryText
		end
		disabledOverlay.BackgroundColor3 = currentTheme.Background
	end
	table.insert(window._components, handle)
	table.insert(self.components, handle)
	return handle, root, control, theme
end

