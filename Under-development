        function tabObj:CreateToggle(o) local c=ComponentFactory:CreateToggle(tabContent, o, ThemeManager.Current, cleanup); table.insert(self._components,c); return c end
        function tabObj:CreateSlider(o) local c=ComponentFactory:CreateSlider(tabContent, o, ThemeManager.Current, cleanup); table.insert(self._components,c); return c end
        function tabObj:CreateDropdown(o) local c=ComponentFactory:CreateDropdown(tabContent, o, ThemeManager.Current, cleanup); table.insert(self._components,c); return c end
        function tabObj:CreateInput(o) local c=ComponentFactory:CreateInput(tabContent, o, ThemeManager.Current, cleanup); table.insert(self._components,c); return c end
        function tabObj:CreateTextbox(o) return self:CreateInput(o) end
        function tabObj:CreateLabel(o) local c=ComponentFactory:CreateLabel(tabContent, o, ThemeManager.Current); table.insert(self._components,c); return c end
        function tabObj:CreateParagraph(o) local c=ComponentFactory:CreateParagraph(tabContent, o, ThemeManager.Current); table.insert(self._components,c); return c end
        function tabObj:CreateSection(o) local c=ComponentFactory:CreateSection(tabContent, o, ThemeManager.Current); table.insert(self._components,c); return c end
        function tabObj:CreateDivider(o) local c=ComponentFactory:CreateDivider(tabContent, o, ThemeManager.Current); table.insert(self._components,c); return c end
        function tabObj:CreateColorPicker(o) local c=ComponentFactory:CreateColorPicker(tabContent, o, ThemeManager.Current, cleanup); table.insert(self._components,c); return c end
        function tabObj:CreateKeybind(o) local c=ComponentFactory:CreateKeybind(tabContent, o, ThemeManager.Current, cleanup); table.insert(self._components,c); return c end
        -- aliases for compatibility
        function tabObj:CreateCheckbox(o) return self:CreateToggle(o) end
        function tabObj:CreateColorPickerWithTransparency(o) return self:CreateColorPicker(o) end
        function tabObj:CreateSearchBar(o) return self:CreateInput(o) end
        function tabObj:CreateBadge(o) return self:CreateLabel(o) end
        function tabObj:CreateProgressBar(o) return self:CreateSlider(o) end

        tabBtn.MouseButton1Click:Connect(function() selfObj:SelectTab(tabName) end)

        selfObj.Tabs[tabName]=tabObj
        if not selfObj.SelectedTab then selfObj:SelectTab(tabName) end
        return tabObj
    end

    function selfObj:SelectTab(name)
        if selfObj.State:Get()=="SETTINGS_OPEN" then
            -- close settings page
            for _,c in ipairs(contentFrame:GetChildren()) do
                if c.Name=="SettingsPage" then c:Destroy() end
                if c:IsA("GuiObject") and c.Name~="UIListLayout" and c.Name~="UIPadding" and c.Name~="Nav" then c.Visible=true end
            end
            selfObj.State:Transition("NORMAL")
        end
        for tName,tObj in pairs(selfObj.Tabs) do
            local active = tName==name
            tObj.Content.Visible=active
            tObj.Button.BackgroundColor3= active and ThemeManager.Current.ActiveTab or ThemeManager.Current.ComponentBackground
            tObj.Button.TextColor3= active and Color3.new(1,1,1) or ThemeManager.Current.SecondaryText
            if active then selfObj.SelectedTab=tObj end
        end
    end

    function selfObj:RemoveTab(name)
        local t=selfObj.Tabs[name]
        if not t then return end
        pcall(function() t.Button:Destroy() end)
        pcall(function() t.Content:Destroy() end)
        selfObj.Tabs[name]=nil
        if selfObj.SelectedTab and selfObj.SelectedTab.Name==name then
            local nextTab = next(selfObj.Tabs)
            if nextTab then selfObj:SelectTab(nextTab) else selfObj.SelectedTab=nil end
        end
    end

    function selfObj:GetSelectedTab() return selfObj.SelectedTab end
    function selfObj:GetTabs() return selfObj.Tabs end
    function selfObj:Minimize() doMinimize() end
    function selfObj:Restore() if state:Get()=="MINIMIZED" then doExpand() elseif state:Get()=="HIDDEN" then doShow() end end
    function selfObj:Hide() doHide() end
    function selfObj:Show() doShow() end
    function selfObj:Resize(size) selfObj.NormalSize=size; if state:Get()=="NORMAL" then AnimationManager:Tween(mainFrame,{Size=size},0.25) end end
    function selfObj:Reposition(pos) mainFrame.Position=Utility:ClampUDim2(pos, mainFrame.Size) end
    function selfObj:Destroy()
        if state:Get()=="DESTROYED" then return end
        state:Transition("DESTROYED")
        cleanup:Cleanup()
        pcall(function() screenGui:Destroy() end)
    end
    function selfObj:Notify(o) selfObj.NotificationManager:Notify(o) end

    return selfObj
end

