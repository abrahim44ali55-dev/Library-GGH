function Tab:CreateKeybind(config)
	config = config or {}
	local handle, _, control = self:_createBase(config, 58)
	local keyCode = config.Default or Enum.KeyCode.Unknown
	if type(keyCode) == "string" then keyCode = Enum.KeyCode[keyCode] or Enum.KeyCode.Unknown end
	local capturing = false
	local keyButton = button(control, tostring(keyCode):gsub("Enum.KeyCode.", ""), UDim2.fromOffset(94, 32), UDim2.new(1, -94, 0.5, -16))
	local function setValue(value, notify)
		local candidate = keyCode
		if typeof(value) == "EnumItem" and value.EnumType == Enum.KeyCode then
			candidate = value
		elseif type(value) == "string" and Enum.KeyCode[value] then
			candidate = Enum.KeyCode[value]
		end
		if candidate ~= Enum.KeyCode.Unknown then
			for _, other in ipairs(self.window._components) do
				if other ~= handle and other._keyCode == candidate and not other._destroyed then
					warn("[RobloxUIFramework] Keybind conflict for " .. tostring(candidate) .. ".")
					keyButton.Text = keyCode == Enum.KeyCode.Unknown and "Unbound" or tostring(keyCode):gsub("Enum.KeyCode.", "")
					return false
				end
			end
		end
		keyCode = candidate
		handle._keyCode = keyCode
		keyButton.Text = keyCode == Enum.KeyCode.Unknown and "Unbound" or tostring(keyCode):gsub("Enum.KeyCode.", "")
		if notify then handle:Invoke(keyCode) end
		return true
	end
	handle:_setValueMethods(function() return keyCode end, setValue)
	handle:_connect(keyButton.Activated, function()
		capturing = true
		self.window._captureKeybind = handle
		keyButton.Text = "Press a key"
		keyButton.BackgroundColor3 = self.window:_theme().Accent
	end)
	handle._captureKey = function(nextKey)
		capturing = false
		self.window._captureKeybind = nil
		setValue(nextKey, true)
		handle._applyTheme(self.window:_theme())
	end
	handle._cancelCapture = function()
		capturing = false
		self.window._captureKeybind = nil
		keyButton.Text = keyCode == Enum.KeyCode.Unknown and "Unbound" or tostring(keyCode):gsub("Enum.KeyCode.", "")
		handle._applyTheme(self.window:_theme())
	end
	handle._applyTheme = function(theme)
		handle.TitleLabel.TextColor3 = theme.Text
		keyButton.BackgroundColor3 = capturing and theme.Accent or theme.ComponentBackground
		keyButton.TextColor3 = theme.Text
	end
	if keyCode ~= Enum.KeyCode.Unknown then
		for _, other in ipairs(self.window._components) do
			if other._keyCode == keyCode and not other._destroyed then
				keyCode = Enum.KeyCode.Unknown
				warn("[RobloxUIFramework] Duplicate default keybind; this control starts unbound.")
				break
			end
		end
	end
	handle._keyCode = keyCode
	setValue(keyCode, false)
	table.insert(self.window._keybinds, handle)
	handle._valueCleanup = function()
		if self.window._captureKeybind == handle then self.window._captureKeybind = nil end
		for index, registered in ipairs(self.window._keybinds) do
			if registered == handle then table.remove(self.window._keybinds, index) break end
		end
	end
	return handle
end

