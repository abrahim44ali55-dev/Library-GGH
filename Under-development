--// ANIMATION MANAGER
local AnimationManager = {}
AnimationManager.Enabled = true
AnimationManager.Speed = 1
AnimationManager.Style = Enum.EasingStyle.Quint
function AnimationManager:Tween(inst, props, duration, style, dir)
    if not self.Enabled or not TweenService then
        for k,v in pairs(props) do pcall(function() inst[k]=v end) end
        return {Cancel=function() end, Completed={Wait=function() end}}
    end
    local info = TweenInfo.new((duration or 0.25)/self.Speed, style or self.Style, dir or Enum.EasingDirection.Out)
    local ok, tw = pcall(function() return TweenService:Create(inst, info, props) end)
    if ok and tw then tw:Play() return tw end
    for k,v in pairs(props) do pcall(function() inst[k]=v end) end
    return {Cancel=function() end}
end
function AnimationManager:SetEnabled(b) self.Enabled=b end
function AnimationManager:SetSpeed(s) self.Speed=s end

--// STATE MANAGER
local StateManager = {}
StateManager.__index = StateManager
StateManager.Valid = {
    NORMAL = {"MINIMIZED","HIDDEN","SETTINGS_OPEN","DESTROYED"},
    MINIMIZED = {"NORMAL","HIDDEN","DESTROYED"},
    HIDDEN = {"NORMAL","DESTROYED"},
    SETTINGS_OPEN = {"NORMAL","HIDDEN","DESTROYED"},
    DESTROYED = {}
}
function StateManager.new(initial)
    return setmetatable({
        current = initial or "NORMAL",
        prev = nil,
        locked = false,
        listeners = {},
        settingsReturnTab = nil,
        normalSize = nil,
        normalPos = nil,
    }, StateManager)
end
function StateManager:Can(to) 
    local allowed = self.Valid[self.current]
    if not allowed then return false end
    for _,v in ipairs(allowed) do if v==to then return true end end
    return false
end
function StateManager:Transition(to, data)
    if self.current=="DESTROYED" then return false end
    if self.locked then return false end
    if not self:Can(to) then warn("[GGH State] Invalid "..self.current.."->"..to) return false end
    self.locked=true
    local from = self.current
    if to=="SETTINGS_OPEN" then self.settingsReturnTab = data and data.returnTab end
    if from=="NORMAL" then self.prev = from end
    self.current = to
    for _,cb in ipairs(self.listeners) do pcall(cb, from, to, data) end
    self.locked=false
    return true
end
function StateManager:OnChange(cb) table.insert(self.listeners, cb) end
function StateManager:Get() return self.current end

--// ENVIRONMENT ADAPTER
local EnvironmentAdapter = {}
function EnvironmentAdapter:GetGuiParent(preferred)
    if preferred and preferred.Parent~=nil then
        local ok = pcall(function() preferred.Parent = preferred.Parent end)
        if ok then return preferred end
    end
    -- try gethui (Delta)
    local ok, hui = pcall(function() return gethui and gethui() end)
    if ok and hui then return hui end
    -- try CoreGui if accessible
    if CoreGui then
        local ok2 = pcall(function() Instance.new("ScreenGui").Parent = CoreGui end)
        if ok2 then return CoreGui end
    end
    if LocalPlayer then
        local pg = LocalPlayer:FindFirstChild("PlayerGui")
        if pg then return pg end
    end
    return nil
end
function EnvironmentAdapter:CreateScreenGui(parent)
    local sg = Instance.new("ScreenGui")
    sg.Name = "GGH_UI_"..tostring(math.random(10000,99999))
    sg.ResetOnSpawn = false
    sg.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
    sg.IgnoreGuiInset = true
    -- parenting handled by caller to avoid crash
    return sg
end

