function ComponentFactory:CreateSlider(tabContent, opts, theme, cleanup)
    opts=opts or {}
    local minV = opts.Min or 0; local maxV = opts.Max or 100; local val = opts.Default or 50
    local frame = Utility:Create("Frame", {Size=UDim2.new(1,-20,0,56), BackgroundColor3=theme.ComponentBackground, Parent=tabContent})
    Utility:RoundCorners(frame,8); Utility:Stroke(frame, theme.Border,1)
    local lbl = Utility:Create("TextLabel", {Text=(opts.Name or "Slider").." : "..val, Size=UDim2.new(1,-20,0,20), Position=UDim2.fromOffset(10,4), BackgroundTransparency=1, TextColor3=theme.Text, Font=Enum.Font.GothamMedium, TextSize=13, TextXAlignment=Enum.TextXAlignment.Left, Parent=frame})
    local track = Utility:Create("Frame", {Size=UDim2.new(1,-20,0,6), Position=UDim2.fromOffset(10,36), BackgroundColor3=theme.Border, Parent=frame})
    Utility:RoundCorners(track,3)
    local fill = Utility:Create("Frame", {Size=UDim2.new((val-minV)/(maxV-minV),0,1,0), BackgroundColor3=theme.Accent, Parent=track})
    Utility:RoundCorners(fill,3)
    local dragging=false
    local function setFromPos(x)
        local rel = math.clamp((x-track.AbsolutePosition.X)/track.AbsoluteSize.X,0,1)
        local raw = minV + rel*(maxV-minV)
        if opts.Increment then raw = math.floor(raw/opts.Increment+0.5)*opts.Increment end
        val = math.clamp(raw,minV,maxV)
        fill.Size=UDim2.new((val-minV)/(maxV-minV),0,1,0)
        lbl.Text=(opts.Name or "Slider").." : "..tostring(val)
        if opts.Callback then task.spawn(opts.Callback,val) end
    end
    local btn = Utility:Create("TextButton", {Size=UDim2.new(1,0,1,0), BackgroundTransparency=1, Text="", Parent=track})
    local c1 = btn.InputBegan:Connect(function(inp) if inp.UserInputType==Enum.UserInputType.MouseButton1 or inp.UserInputType==Enum.UserInputType.Touch then dragging=true; setFromPos(inp.Position.X) end end)
    local c2, c3
    if UserInputService then
        c2 = UserInputService.InputChanged:Connect(function(inp) if dragging and (inp.UserInputType==Enum.UserInputType.MouseMovement or inp.UserInputType==Enum.UserInputType.Touch) then setFromPos(inp.Position.X) end end)
        c3 = UserInputService.InputEnded:Connect(function(inp) if inp.UserInputType==Enum.UserInputType.MouseButton1 or inp.UserInputType==Enum.UserInputType.Touch then dragging=false end end)
    end
    cleanup:AddConnection(c1); if c2 then cleanup:AddConnection(c2) end; if c3 then cleanup:AddConnection(c3) end
    local api={}
    function api:SetValue(v) val=v; fill.Size=UDim2.new((val-minV)/(maxV-minV),0,1,0); lbl.Text=(opts.Name or "Slider").." : "..val end
    function api:GetValue() return val end
    function api:SetVisible(v) frame.Visible=v end
    function api:Destroy() pcall(function() frame:Destroy() end) end
    function api:SetCallback(cb) opts.Callback=cb end
    return api
end

