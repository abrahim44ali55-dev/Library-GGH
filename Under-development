--// UTILITY
local Utility = {}
function Utility:ClampUDim2(pos, size, viewport)
    local absSize = size or UDim2.fromOffset(650,480)
    local vp = viewport or Vector2.new(1920,1080)
    if GuiService then
        local ok, v = pcall(function() return GuiService:GetScreenResolution() end)
        if ok then vp = v end
    end
    local x = math.clamp(pos.X.Offset, 0, vp.X - absSize.X.Offset)
    local y = math.clamp(pos.Y.Offset, 0, vp.Y - absSize.Y.Offset)
    return UDim2.fromOffset(x,y)
end
function Utility:Validate(t, schema)
    for k,v in pairs(schema) do
        if t[k]==nil and v.required then error(k.." required") end
    end
end
function Utility:DeepCopy(o)
    if type(o)~="table" then return o end
    local c={}; for k,v in pairs(o) do c[k]=Utility:DeepCopy(v) end
    return c
end
function Utility:Create(class, props, children)
    local inst = Instance.new(class)
    for k,v in pairs(props or {}) do
        if k~="Parent" then pcall(function() inst[k]=v end) end
    end
    for _,child in ipairs(children or {}) do child.Parent = inst end
    if props and props.Parent then inst.Parent = props.Parent end
    return inst
end
function Utility:RoundCorners(inst, radius)
    local c = Instance.new("UICorner"); c.CornerRadius = UDim.new(0,radius or 10); c.Parent = inst; return c
end
function Utility:Stroke(inst, color, thickness)
    local s = Instance.new("UIStroke"); s.Color=color; s.Thickness=thickness or 1; s.ApplyStrokeMode=Enum.ApplyStrokeMode.Border; s.Parent=inst; return s
end

--// CLEANUP MANAGER
local CleanupManager = {}
CleanupManager.__index = CleanupManager
function CleanupManager.new()
    return setmetatable({cons={}, instances={}, tweens={}}, CleanupManager)
end
function CleanupManager:AddConnection(c) table.insert(self.cons, c) end
function CleanupManager:AddInstance(i) table.insert(self.instances, i) end
function CleanupManager:AddTween(t) table.insert(self.tweens, t) end
function CleanupManager:Cleanup()
    for _,c in ipairs(self.cons) do pcall(function() c:Disconnect() end) end
    for _,t in ipairs(self.tweens) do pcall(function() t:Cancel() end) end
    for _,i in ipairs(self.instances) do pcall(function() i:Destroy() end) end
    self.cons={}; self.instances={}; self.tweens={}
end

