	end
	handle:_setValueMethods(function() return value end, setValue)
	handle:_connect(input:GetPropertyChangedSignal("Text"), function()
		value = input.Text
		if suppressedTextChange == value then
			suppressedTextChange = nil
			return
		end
		suppressedTextChange = nil
		if config.Live then handle:Invoke(value) end
	end)
	handle:_connect(input.FocusLost, function(enterPressed)
		value = input.Text
		if config.Live ~= true and config.FireOnFocusLost ~= false then handle:Invoke(value, enterPressed) end
	end)
	handle._applyTheme = function(theme)
		handle.TitleLabel.TextColor3 = theme.Text
		input.BackgroundColor3 = theme.ComponentBackground
		input.TextColor3 = theme.Text
	end
	return handle
end

