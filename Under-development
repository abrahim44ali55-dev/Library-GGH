function Tab:CreateTabbedContainer(config)
	config = config or {}
	local handle, root = self:_createBase(config, tonumber(config.Height) or 210)
	handle.Control.Visible = false
	local tabsBar = make("Frame", root, {
		BackgroundTransparency = 1, Position = UDim2.fromOffset(0, 23), Size = UDim2.new(1, 0, 0, 32),
	})
	make("UIListLayout", tabsBar, {
		FillDirection = Enum.FillDirection.Horizontal,
		Padding = UDim.new(0, 6),
		SortOrder = Enum.SortOrder.LayoutOrder,
	})
	local body = make("Frame", root, {
		BackgroundColor3 = self.window:_theme().SecondaryBackground,
		BorderSizePixel = 0,
		Position = UDim2.fromOffset(0, 60),
		Size = UDim2.new(1, 0, 1, -60),
	})
	rounded(body, 6)
	local tabs = {}
	local function select(item)
		for _, candidate in ipairs(tabs) do
			candidate.page.Visible = candidate == item
			candidate.button.BackgroundColor3 = candidate == item and self.window:_theme().ActiveTab or self.window:_theme().ComponentBackground
		end
	end
	handle.AddTab = function(_, name)
		local tabButton = button(tabsBar, tostring(name), UDim2.fromOffset(105, 28))
		tabButton.Size = UDim2.new(0, 105, 1, 0)
		tabButton.LayoutOrder = #tabs + 1
		local page = make("ScrollingFrame", body, {
			Active = true, AutomaticCanvasSize = Enum.AutomaticSize.Y, BackgroundTransparency = 1,
			BorderSizePixel = 0, CanvasSize = UDim2.new(), ScrollBarThickness = 3,
			Size = UDim2.new(1, -10, 1, -10), Position = UDim2.fromOffset(5, 5), Visible = false,
		})
		make("UIListLayout", page, { Padding = UDim.new(0, 6), SortOrder = Enum.SortOrder.LayoutOrder })
		local item = { name = tostring(name), button = tabButton, page = page }
		table.insert(tabs, item)
		handle:_connect(tabButton.Activated, function() select(item) end)
		if #tabs == 1 then select(item) end
		return page
	end
	handle.SelectTab = function(_, name)
		for _, item in ipairs(tabs) do
			if item.name == name then select(item) return true end
		end
		return false
	end
	handle._applyTheme = function(theme)
		handle.TitleLabel.TextColor3 = theme.Text
		body.BackgroundColor3 = theme.SecondaryBackground
		for _, item in ipairs(tabs) do
			item.button.TextColor3 = theme.Text
		end
	end
	return handle
end

function Window:_createSettingsPage()
	if self._settingsTab then
		return self._settingsTab
	end
	local page = make("ScrollingFrame", self.pages, {
		Active = true, AutomaticCanvasSize = Enum.AutomaticSize.Y, BackgroundTransparency = 1,
		BorderSizePixel = 0, CanvasSize = UDim2.new(), ScrollBarThickness = 4, Size = UDim2.new(1, 0, 1, 0),
		Visible = false,
	})
	make("UIPadding", page, {
		PaddingBottom = UDim.new(0, 12), PaddingLeft = UDim.new(0, 14), PaddingRight = UDim.new(0, 14), PaddingTop = UDim.new(0, 12),
	})
	make("UIListLayout", page, { Padding = UDim.new(0, self._contentSpacing or 8), SortOrder = Enum.SortOrder.LayoutOrder })
	local settingsTab = setmetatable({
		window = self, id = "settings", name = "Settings", page = page, components = {}, _removed = false,
	}, Tab)
	self._settingsTab = settingsTab
	settingsTab:CreateSection({ Name = "Appearance" })
	settingsTab:CreateDropdown({
		Name = "Theme",
		Default = self._themeName,
		Options = { "Dark", "Light", "AMOLED", "Midnight", "Dracula", "Monokai", "HighContrast" },
		Callback = function(value)
			if Library._themes[value] then self:SetTheme(value) end
		end,
	})
	settingsTab:CreateToggle({
		Name = "Animations",
		Default = self._animationsEnabled,
		Callback = function(value) self._animationsEnabled = value end,
	})
	settingsTab:CreateSlider({
		Name = "Animation speed",
		Min = 0.5,
		Max = 2,
		Increment = 0.1,
		Default = self._animationSpeed,
		Callback = function(value) self._animationSpeed = value end,
	})
	settingsTab:CreateSlider({
		Name = "UI scale",
		Min = 0.75,
		Max = 1.2,
		Increment = 0.05,
		Default = self._scale,
		Callback = function(value) self:SetScale(value) end,
	})
	settingsTab:CreateSection({ Name = "Layout" })
	settingsTab:CreateSlider({
		Name = "Content spacing",
		Min = 2,
		Max = 20,
		Increment = 1,
		Default = self._contentSpacing or 8,
		Callback = function(value) self:SetContentSpacing(value) end,
	})
	settingsTab:CreateSection({ Name = "Notifications" })
	settingsTab:CreateDropdown({
		Name = "Notification position",
		Default = self._notificationPosition,
		Options = { "TopLeft", "TopRight", "BottomLeft", "BottomRight" },
		Callback = function(value) self:SetNotificationPosition(value) end,
	})
	settingsTab:CreateSection({ Name = "Window" })
	settingsTab:CreateToggle({
		Name = "Remember position this session",
		Default = true,
		Callback = function(value) self._rememberPosition = value end,
	})
	settingsTab:CreateButton({
		Name = "Restore library defaults",
		ButtonText = "Reset",
		Callback = function()
			self:SetTheme("Dark")
			self:SetScale(1)
			self._animationsEnabled = true
			self._animationSpeed = 1
			self:SetContentSpacing(8)
			self.frame.Size = self._defaultSize
			self.frame.Position = self._defaultPosition
			self:_fitToViewport()
		end,
	})
	return settingsTab
end

function Window:CreateSettings()
	if self._destroyed or self.state == "HIDDEN" then
		return false
	end
	if self.state == "MINIMIZED" then
		self:Restore()
	end
	if self.state == "SETTINGS_OPEN" then
		self.state = "NORMAL"
		self:_refreshActivePage()
		self:_updateTabButtons()
		return false
	end
	self:_createSettingsPage()
	self.state = "SETTINGS_OPEN"
	self:_refreshActivePage()
	self:_updateTabButtons()
	return true
end

function Window:Minimize()
	if self._destroyed or self.state == "HIDDEN" then return false end
	if self.state == "MINIMIZED" then return self:Restore() end
	if self.state == "SETTINGS_OPEN" then self.state = "NORMAL" end
	self._normalSize = self.frame.Size
	self.state = "MINIMIZED"
	if self._minimizeButton then self._minimizeButton.Text = "+" end
	self:_refreshActivePage()
	self.body.Visible = false
	if self.resizeGrip then self.resizeGrip.Visible = false end
	self:_animate(self.frame, {
		Size = UDim2.new(self.frame.Size.X.Scale, self.frame.Size.X.Offset, 0, self._headerHeight),
	}, 0.2)
	return true
end

function Window:Restore()
	if self._destroyed or self.state == "HIDDEN" then return false end
	if self.state ~= "MINIMIZED" then return false end
	self.state = "NORMAL"
	if self._minimizeButton then self._minimizeButton.Text = "−" end
	self.body.Visible = true
	if self.resizeGrip then self.resizeGrip.Visible = true end
	self:_animate(self.frame, { Size = self._normalSize }, 0.2)
	self:_refreshActivePage()
	self:_updateTabButtons()
	task.delay(self._animationsEnabled and 0.22 * self._animationSpeed or 0, function()
		if not self._destroyed then self:_clampPosition() end
	end)
	return true
end

function Window:Hide()
	if self._destroyed or self.state == "HIDDEN" then return false end
	self._beforeHide = self.state
	self.state = "HIDDEN"
	self._restorePosition = self.frame.Position
	local screen = viewportSize()
	self.floatingButton.Visible = true
	self:_animate(self.frame, { Position = UDim2.fromOffset(screen.X + 8, self.frame.Position.Y.Offset) }, 0.2)
	task.delay(self._animationsEnabled and 0.22 * self._animationSpeed or 0, function()
		if not self._destroyed and self.state == "HIDDEN" then
			self.frame.Visible = false
		end
	end)
	return true
end

function Window:Show()
	if self._destroyed or self.state ~= "HIDDEN" then return false end
	self.state = self._beforeHide or "NORMAL"
	self._beforeHide = nil
	local target = self._restorePosition or self._defaultPosition
	local screen = viewportSize()
	self.frame.Position = UDim2.fromOffset(screen.X + 8, target.Y.Offset)
	self.frame.Visible = true
	self.floatingButton.Visible = false
	self:_animate(self.frame, { Position = target }, 0.2)
	if self.state ~= "MINIMIZED" then self.body.Visible = true end
	self:_refreshActivePage()
	self:_updateTabButtons()
	return true
end

function Window:Resize(size)
	assert(typeof(size) == "UDim2", "Resize expects a UDim2.")
	if self._destroyed then return false end
	local screen = viewportSize()
	local widthLimit = math.max(180, math.min(self._maxSize.X, screen.X - 24))
	local heightLimit = math.max(120, math.min(self._maxSize.Y, screen.Y - 36))
	local width = clamp(size.X.Offset, math.min(self._minSize.X, widthLimit), widthLimit)
	local height = clamp(size.Y.Offset, math.min(self._minSize.Y, heightLimit), heightLimit)
	self._normalSize = UDim2.fromOffset(width, height)
	if self.state ~= "MINIMIZED" then self.frame.Size = self._normalSize end
	self:_clampPosition()
	return true
end

function Window:Reposition(position)
	assert(typeof(position) == "UDim2", "Reposition expects a UDim2.")
	if self._destroyed then return false end
	self.frame.Position = position
	self:_clampPosition()
	self._defaultPosition = self.frame.Position
	return true
end

function Window:SetScale(scale)
	if self._destroyed then return false end
	self._scale = clamp(tonumber(scale) or 1, 0.5, 1.5)
	self._uiScale.Scale = self._scale
	return true
end

function Window:SetContentSpacing(spacing)
	if self._destroyed then return false end
	self._contentSpacing = clamp(math.floor(tonumber(spacing) or 8), 2, 24)
	local pages = {}
	for _, tab in ipairs(self.tabs) do table.insert(pages, tab.page) end
	if self._settingsTab then table.insert(pages, self._settingsTab.page) end
	for _, page in ipairs(pages) do
		local layout = page:FindFirstChildOfClass("UIListLayout")
		if layout then layout.Padding = UDim.new(0, self._contentSpacing) end
	end
	return true
end

function Window:SaveConfig()
	assert(not self._destroyed, "Cannot save config for a destroyed window.")
	local values = {}
	for _, component in ipairs(self._components) do
		if component._getValue and not component._destroyed then
			values[component.Root:GetAttribute("ConfigKey") or component.TitleLabel.Text] = component:GetValue()
		end
	end
	return {
		Theme = self._themeName,
		Scale = self._scale,
		Size = self._normalSize,
		Position = self.frame.Position,
		SelectedTab = self._selectedTab and self._selectedTab.name or nil,
		Values = values,
	}
end

function Window:LoadConfig(config)
	assert(not self._destroyed, "Cannot load config into a destroyed window.")
	assert(type(config) == "table", "LoadConfig expects a table.")
	if config.Theme and Library._themes[config.Theme] then self:SetTheme(config.Theme) end
	if config.Scale then self:SetScale(config.Scale) end
	if typeof(config.Size) == "UDim2" then self:Resize(config.Size) end
	if typeof(config.Position) == "UDim2" then self:Reposition(config.Position) end
	for _, tab in ipairs(self.tabs) do
		if tab.name == config.SelectedTab then self:SelectTab(tab) break end
	end
	for _, component in ipairs(self._components) do
		if component._setValue and not component._destroyed then
			local key = component.Root:GetAttribute("ConfigKey") or component.TitleLabel.Text
			if config.Values and config.Values[key] ~= nil then
				component:SetValue(config.Values[key], false)
			end
		end
	end
	return true
end

function Window:SetNotificationPosition(position)
	local positions = {
		TopLeft = { AnchorPoint = Vector2.new(0, 0), Position = UDim2.new(0, 12, 0, 12), Horizontal = Enum.HorizontalAlignment.Left, Vertical = Enum.VerticalAlignment.Top },
		TopRight = { AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -12, 0, 12), Horizontal = Enum.HorizontalAlignment.Right, Vertical = Enum.VerticalAlignment.Top },
		BottomLeft = { AnchorPoint = Vector2.new(0, 1), Position = UDim2.new(0, 12, 1, -12), Horizontal = Enum.HorizontalAlignment.Left, Vertical = Enum.VerticalAlignment.Bottom },
		BottomRight = { AnchorPoint = Vector2.new(1, 1), Position = UDim2.new(1, -12, 1, -12), Horizontal = Enum.HorizontalAlignment.Right, Vertical = Enum.VerticalAlignment.Bottom },
	}
	assert(positions[position], "Notification position must be TopLeft, TopRight, BottomLeft, or BottomRight.")
	self._notificationPosition = position
	self:_applyNotificationPosition()
	return true
end

function Window:_applyNotificationPosition()
	if not self._notificationStack then return end
	local position = self._notificationPosition or "BottomRight"
	local positions = {
		TopLeft = { AnchorPoint = Vector2.new(0, 0), Position = UDim2.new(0, 12, 0, 12), Horizontal = Enum.HorizontalAlignment.Left, Vertical = Enum.VerticalAlignment.Top },
		TopRight = { AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -12, 0, 12), Horizontal = Enum.HorizontalAlignment.Right, Vertical = Enum.VerticalAlignment.Top },
		BottomLeft = { AnchorPoint = Vector2.new(0, 1), Position = UDim2.new(0, 12, 1, -12), Horizontal = Enum.HorizontalAlignment.Left, Vertical = Enum.VerticalAlignment.Bottom },
		BottomRight = { AnchorPoint = Vector2.new(1, 1), Position = UDim2.new(1, -12, 1, -12), Horizontal = Enum.HorizontalAlignment.Right, Vertical = Enum.VerticalAlignment.Bottom },
	}
	local config = positions[position] or positions.BottomRight
	self._notificationStack.AnchorPoint = config.AnchorPoint
	self._notificationStack.Position = config.Position
	local layout = self._notificationStack:FindFirstChildOfClass("UIListLayout")
	if layout then
		layout.HorizontalAlignment = config.Horizontal
		layout.VerticalAlignment = config.Vertical
	end
end

function Window:Notify(config)
	if self._destroyed then return nil end
	config = config or {}
	if config.Position then self:SetNotificationPosition(config.Position) end
	local theme = self:_theme()
	while #self._notifications >= self._notificationLimit do
		local oldest = self._notifications[1]
		if not oldest then break end
		oldest:Destroy()
	end
	local notification = { _destroyed = false }
	self._notificationSequence = self._notificationSequence + 1
	local screen = viewportSize()
	local noticeWidth = math.max(180, math.min(300, screen.X - 20))
	local duration = math.max(0, tonumber(config.Duration) or 4)
	local frame = make("Frame", self._notificationStack, {
		BackgroundColor3 = theme.SecondaryBackground,
		BorderSizePixel = 0,
		LayoutOrder = self._notificationSequence,
		Size = UDim2.fromOffset(noticeWidth, 76),
	})
	rounded(frame, 9)
	stroke(frame, theme.Border, 1, 0.15)
	local accentName = tostring(config.Type or "Information")
	local accent = typeof(config.Accent) == "Color3" and config.Accent or theme[accentName] or theme.Information
	local bar = make("Frame", frame, {
		BackgroundColor3 = accent,
		BorderSizePixel = 0,
		Size = UDim2.new(0, 3, 1, 0),
	})
	rounded(bar, 2)
	local titleOffset = config.Icon and 37 or 13
	if config.Icon then
		label(frame, tostring(config.Icon), UDim2.fromOffset(18, 22), UDim2.fromOffset(12, 8), accent, 14, {
			TextXAlignment = Enum.TextXAlignment.Center,
		})
	end
	local titleLabel = label(frame, tostring(config.Title or accentName), UDim2.new(1, -(titleOffset + 30), 0, 22), UDim2.fromOffset(titleOffset, 8), theme.Text, 12, {
		Font = Enum.Font.GothamSemibold,
	})
	local descriptionLabel = label(frame, tostring(config.Description or ""), UDim2.new(1, -titleOffset - 18, 0, 34), UDim2.fromOffset(titleOffset, 33), theme.SecondaryText, 10, {
		TextWrapped = true,
		TextYAlignment = Enum.TextYAlignment.Top,
	})
	local progressFill
	if config.ProgressIndicator == true or config.Progress == true then
		make("Frame", frame, {
			BackgroundColor3 = theme.Border,
			BorderSizePixel = 0,
			Position = UDim2.new(0, 5, 1, -3),
			Size = UDim2.new(1, -10, 0, 2),
		})
		progressFill = make("Frame", frame, {
			BackgroundColor3 = accent,
			BorderSizePixel = 0,
			Position = UDim2.new(0, 5, 1, -3),
			Size = UDim2.new(1, -10, 0, 2),
		})
	end
	if config.Dismissible ~= false then
		local close = button(frame, "×", UDim2.fromOffset(24, 24), UDim2.new(1, -31, 0, 5))
		close.BackgroundTransparency = 1
		close.TextSize = 17
		close.Activated:Connect(function()
			if type(config.Callback) == "function" then invoke(self, config.Callback) end
			notification:Destroy()
		end)
	end
	notification.Frame = frame
	notification._applyTheme = function(nextTheme)
		if frame.Parent then
			frame.BackgroundColor3 = nextTheme.SecondaryBackground
			bar.BackgroundColor3 = notification._accentColor or nextTheme[accentName] or nextTheme.Information
			titleLabel.TextColor3 = nextTheme.Text
			descriptionLabel.TextColor3 = nextTheme.SecondaryText
			if progressFill and not notification._accentColor then progressFill.BackgroundColor3 = nextTheme[accentName] or nextTheme.Information end
		end
	end
	notification._accentColor = typeof(config.Accent) == "Color3" and config.Accent or nil
	local selfWindow = self
	function notification:Destroy()
		if self._destroyed then return end
		self._destroyed = true
		if self._progressTween then
			self._progressTween:Cancel()
			selfWindow._tweens[progressFill] = nil
		end
		for i, item in ipairs(selfWindow._notifications) do
			if item == self then table.remove(selfWindow._notifications, i) break end
		end
		if frame.Parent then frame:Destroy() end
	end
	table.insert(self._notifications, notification)
	if progressFill and duration > 0 and self._animationsEnabled then
		local tween = TweenService:Create(progressFill, TweenInfo.new(duration, Enum.EasingStyle.Linear), { Size = UDim2.new(0, 0, 0, 2) })
		notification._progressTween = tween
		self._tweens[progressFill] = tween
		tween:Play()
	end
	if duration > 0 then
		task.delay(duration, function()
			if not notification._destroyed then notification:Destroy() end
		end)
	end
	return notification
end

function Window:ConfirmDialog(config)
	if self._destroyed then return nil end
	config = config or {}
	local overlay = make("Frame", self.screenGui, {
		BackgroundColor3 = Color3.new(0, 0, 0),
		BackgroundTransparency = 0.45,
		BorderSizePixel = 0,
		Size = UDim2.fromScale(1, 1),
		ZIndex = 40,
	})
	local dialog = make("Frame", overlay, {
		AnchorPoint = Vector2.new(0.5, 0.5),
		BackgroundColor3 = self:_theme().SecondaryBackground,
		BorderSizePixel = 0,
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromOffset(340, 180),
		ZIndex = 41,
	})
	rounded(dialog, 10)
	stroke(dialog, self:_theme().Border, 1, 0.1)
	label(dialog, tostring(config.Title or "Confirm"), UDim2.new(1, -28, 0, 26), UDim2.fromOffset(14, 12), self:_theme().Text, 15, {
		Font = Enum.Font.GothamSemibold, ZIndex = 42,
	})
	label(dialog, tostring(config.Description or "Are you sure?"), UDim2.new(1, -28, 0, 66), UDim2.fromOffset(14, 46), self:_theme().SecondaryText, 12, {
		TextWrapped = true, TextYAlignment = Enum.TextYAlignment.Top, ZIndex = 42,
	})
	local cancel = button(dialog, tostring(config.CancelText or "Cancel"), UDim2.fromOffset(96, 34), UDim2.new(1, -210, 1, -48))
	cancel.ZIndex = 42
	local confirm = button(dialog, tostring(config.ConfirmText or "Confirm"), UDim2.fromOffset(96, 34), UDim2.new(1, -108, 1, -48))
	confirm.ZIndex = 42
	confirm.BackgroundColor3 = self:_theme().Accent
	local closed = false
	local function close(answer)
		if closed then return end
		closed = true
		overlay:Destroy()
		if answer then invoke(self, config.OnConfirm or config.Callback) else invoke(self, config.OnCancel) end
	end
	cancel.Activated:Connect(function() close(false) end)
	confirm.Activated:Connect(function() close(true) end)
	return { Close = close, Destroy = function() close(false) end }
end

function Window:CustomDialog(config)
	if self._destroyed then return nil end
	config = config or {}
	local actions = config.Actions or config.Buttons or {}
	assert(type(actions) == "table", "CustomDialog Actions must be an array.")
	local overlay = make("Frame", self.screenGui, {
		BackgroundColor3 = Color3.new(0, 0, 0),
		BackgroundTransparency = 0.45,
		BorderSizePixel = 0,
		Size = UDim2.fromScale(1, 1),
		ZIndex = 40,
	})
	local count = math.min(#actions, 4)
	local height = clamp(126 + count * 42, 168, 300)
	local dialog = make("Frame", overlay, {
		AnchorPoint = Vector2.new(0.5, 0.5),
		BackgroundColor3 = self:_theme().SecondaryBackground,
		BorderSizePixel = 0,
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromOffset(360, height),
		ZIndex = 41,
	})
	rounded(dialog, 10)
	stroke(dialog, self:_theme().Border, 1, 0.1)
	label(dialog, tostring(config.Title or "Dialog"), UDim2.new(1, -28, 0, 26), UDim2.fromOffset(14, 12), self:_theme().Text, 15, {
		Font = Enum.Font.GothamSemibold, ZIndex = 42,
	})
	label(dialog, tostring(config.Description or ""), UDim2.new(1, -28, 1, -86), UDim2.fromOffset(14, 44), self:_theme().SecondaryText, 12, {
		TextWrapped = true, TextYAlignment = Enum.TextYAlignment.Top, ZIndex = 42,
	})
	local closed = false
	local function close(result)
		if closed then return end
		closed = true
		overlay:Destroy()
		invoke(self, config.OnClose, result)
	end
	for index = 1, count do
		local action = actions[index]
		local actionButton = button(dialog, tostring(action.Label or action.Text or ("Action " .. index)), UDim2.new(1, -28, 0, 32), UDim2.new(0, 14, 1, -((count - index + 1) * 38)))
		actionButton.ZIndex = 42
		if action.Primary then actionButton.BackgroundColor3 = self:_theme().Accent end
		actionButton.Activated:Connect(function()
			if type(action.Callback) == "function" then invoke(self, action.Callback) end
			close(action.Value ~= nil and action.Value or action.Label or action.Text)
		end)
	end
	return { Close = close, Destroy = function() close(nil) end }
end

function Window:Destroy()
	if self._destroyed then return end
	self.state = "DESTROYED"
	self._destroyed = true
	for _, tween in pairs(self._tweens) do
		tween:Cancel()
	end
	table.clear(self._tweens)
	for _, connection in ipairs(self._connections) do
		connection:Disconnect()
	end
	table.clear(self._connections)
	for _, component in ipairs(copyArray(self._components)) do
		component:Destroy()
	end
	for _, notification in ipairs(copyArray(self._notifications)) do
		notification:Destroy()
	end
	for i, window in ipairs(Library._windows) do
		if window == self then table.remove(Library._windows, i) break end
	end
	if self.screenGui and self.screenGui.Parent then
		self.screenGui:Destroy()
	end
end

local function resolvePlayerGui(parent)
	local playerGui = LOCAL_PLAYER:FindFirstChildOfClass("PlayerGui")
	if not playerGui then
		playerGui = LOCAL_PLAYER:WaitForChild("PlayerGui", 10)
	end
	assert(playerGui and playerGui:IsA("PlayerGui"), "PlayerGui is unavailable.")
	if parent ~= nil then
		assert(typeof(parent) == "Instance", "Parent must be a PlayerGui Instance.")
		assert(parent == playerGui, "The UI parent must be the local player's PlayerGui.")
		return parent, playerGui
	end
	return playerGui, playerGui
end

function Library:CreateWindow(options)
	options = options or {}
	local parent, playerGui = resolvePlayerGui(options.Parent)
	local frameworkId = tostring(options.ID or HttpService:GenerateGUID(false))
	local initial = options.Size or UDim2.fromOffset(620, 440)
	local minSize = options.MinSize or UDim2.fromOffset(340, 280)
	local maxSize = options.MaxSize or UDim2.fromOffset(1200, 900)
	assert(typeof(initial) == "UDim2" and typeof(minSize) == "UDim2" and typeof(maxSize) == "UDim2", "Window sizes must be UDim2 values.")
	assert(initial.X.Scale == 0 and initial.Y.Scale == 0 and minSize.X.Scale == 0 and minSize.Y.Scale == 0 and maxSize.X.Scale == 0 and maxSize.Y.Scale == 0, "Window sizes must use UDim2.fromOffset values.")
	assert(maxSize.X.Offset >= minSize.X.Offset and maxSize.Y.Offset >= minSize.Y.Offset, "MaxSize cannot be smaller than MinSize.")
	assert(options.Header == nil or type(options.Header) == "table", "Header options must be a table.")
	assert(options.Position == nil or typeof(options.Position) == "UDim2", "Position must be a UDim2.")
	assert(options.FloatingPosition == nil or typeof(options.FloatingPosition) == "UDim2", "FloatingPosition must be a UDim2.")
	assert(options.Position == nil or (options.Position.X.Scale == 0 and options.Position.Y.Scale == 0), "Position must use UDim2.fromOffset values.")
	assert(options.FloatingPosition == nil or (options.FloatingPosition.X.Scale == 0 and options.FloatingPosition.Y.Scale == 0), "FloatingPosition must use UDim2.fromOffset values.")
	local headerOptions = options.Header or {}
	assert(headerOptions.ButtonOrder == nil or type(headerOptions.ButtonOrder) == "table", "Header.ButtonOrder must be an array.")
	local headerHeight = clamp(tonumber(options.HeaderHeight) or 54, 44, 80)
	assert(maxSize.Y.Offset >= headerHeight, "MaxSize height must fit the window header.")
	local themeName = options.Theme or "Dark"
	assert(self._themes[themeName], "Unknown theme: " .. tostring(themeName))
	local notificationPosition = options.NotificationPosition or "BottomRight"
	assert(NOTIFICATION_POSITIONS[notificationPosition], "Unknown notification position: " .. tostring(notificationPosition))
	local screen = viewportSize()
	local widthLimit = math.max(180, math.min(maxSize.X.Offset, screen.X - 24))
	local heightLimit = math.max(120, math.min(maxSize.Y.Offset, screen.Y - 36))
	local initialWidth = clamp(initial.X.Offset, math.min(minSize.X.Offset, widthLimit), widthLimit)
	local minHeight = math.max(minSize.Y.Offset, headerHeight)
	local initialHeight = clamp(initial.Y.Offset, math.min(minHeight, heightLimit), heightLimit)
	if options.ID ~= nil then
		for _, existingWindow in ipairs(copyArray(self._windows)) do
			if existingWindow._id == frameworkId then existingWindow:Destroy() end
		end
		for _, existing in ipairs(parent:GetChildren()) do
			if existing:IsA("ScreenGui")
				and existing:GetAttribute("FrameworkOwner") == "RobloxStudioUIFramework"
				and existing:GetAttribute("FrameworkId") == frameworkId then
				existing:Destroy()
			end
		end
	end
	local screenGui = make("ScreenGui", parent, {
		DisplayOrder = tonumber(options.DisplayOrder) or 20,
		IgnoreGuiInset = false,
		Name = "RobloxUIFramework_" .. frameworkId,
		ResetOnSpawn = false,
		ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
	})
	screenGui:SetAttribute("FrameworkOwner", "RobloxStudioUIFramework")
	screenGui:SetAttribute("FrameworkId", frameworkId)
	local window = setmetatable({
		screenGui = screenGui,
		_id = frameworkId,
		parent = playerGui,
		state = "NORMAL",
		tabs = {},
		_components = {},
		_connections = {},
		_keybinds = {},
		_tweens = {},
		_notifications = {},
		_notificationSequence = 0,
		_notificationLimit = clamp(math.floor(tonumber(options.MaxNotifications) or 4), 1, 10),
		_notificationPosition = notificationPosition,
		_componentOrder = 0,
		_contentSpacing = 8,
		_themeName = themeName,
		_themeData = copyTable(self._themes[themeName]),
		_animationsEnabled = not (options.Animations == false),
		_animationSpeed = clamp(tonumber(options.AnimationSpeed) or 1, 0.1, 3),
		_scale = clamp(tonumber(options.Scale) or 1, 0.5, 1.5),
		_minSize = Vector2.new(minSize.X.Offset, minHeight),
		_maxSize = Vector2.new(maxSize.X.Offset, maxSize.Y.Offset),
		_headerHeight = headerHeight,
		_destroyed = false,
		_rememberPosition = true,
		_defaultSize = UDim2.fromOffset(initialWidth, initialHeight),
	}, Window)
	window:_connect(UserInputService.InputBegan, function(input, processed)
		if input.UserInputType ~= Enum.UserInputType.Keyboard then return end
		local capture = window._captureKeybind
		if capture and not capture._destroyed then
			if input.KeyCode == Enum.KeyCode.Escape then
				capture._cancelCapture()
			else
				capture._captureKey(input.KeyCode)
			end
			return
		end
		if processed then return end
		for _, keybind in ipairs(copyArray(window._keybinds)) do
			if not keybind._destroyed and keybind.Enabled and keybind._keyCode == input.KeyCode and input.KeyCode ~= Enum.KeyCode.Unknown then
				keybind:Invoke(input.KeyCode)
			end
		end
	end)
	window.frame = make("Frame", screenGui, {
		AnchorPoint = Vector2.new(0, 0),
		BackgroundColor3 = window:_theme().Background,
		BorderSizePixel = 0,
		ClipsDescendants = true,
		Position = options.Position or UDim2.fromOffset((viewportSize().X - initialWidth) / 2, (viewportSize().Y - initialHeight) / 2),
		Size = UDim2.fromOffset(initialWidth, initialHeight),
	})
	rounded(window.frame, tonumber(options.CornerRadius) or 11)
	local outline = stroke(window.frame, window:_theme().Border, 1, 0.08)
	outline.Name = "FrameworkOutline"
	window._outline = outline
	window._uiScale = make("UIScale", window.frame, { Scale = window._scale })
	window._normalSize = window.frame.Size
	window._defaultPosition = window.frame.Position
	window.header = make("Frame", window.frame, {
		BackgroundColor3 = window:_theme().Header,
		BorderSizePixel = 0,
		Size = UDim2.new(1, 0, 0, window._headerHeight),
	})
	local titleText = tostring(options.Title or "Roblox UI")
	local subtitleText = tostring(options.Subtitle or "")
	local titleFraction = initialWidth < 440 and 0.30 or 0.38
	local controlsStart = titleFraction + 0.02
	label(window.header, titleText, UDim2.new(titleFraction, -8, 0, subtitleText ~= "" and 20 or 30), UDim2.fromOffset(16, subtitleText ~= "" and 8 or 12), window:_theme().Text, 14, {
		Name = "WindowTitle",
		Font = Enum.Font.GothamSemibold,
		TextTruncate = Enum.TextTruncate.AtEnd,
	})
	if subtitleText ~= "" then
		label(window.header, subtitleText, UDim2.new(titleFraction, -8, 0, 16), UDim2.fromOffset(16, 29), window:_theme().SecondaryText, 10, {
			Name = "WindowSubtitle",
			TextTruncate = Enum.TextTruncate.AtEnd,
		})
	end
	local controls = make("Frame", window.header, {
		BackgroundTransparency = 1,
		Position = UDim2.new(controlsStart, 0, 0, 0),
		Size = UDim2.new(1 - controlsStart, -8, 1, 0),
	})
	local controlLayout = make("UIListLayout", controls, {
		FillDirection = Enum.FillDirection.Horizontal,
		HorizontalAlignment = Enum.HorizontalAlignment.Right,
		VerticalAlignment = Enum.VerticalAlignment.Center,
		Padding = UDim.new(0, 5),
		SortOrder = Enum.SortOrder.LayoutOrder,
	})
	local headerButtons = {}
	local function headerButton(key, text, order, visible)
		local item = button(controls, text, UDim2.fromOffset(32, 32))
		item.LayoutOrder = order
		item.Visible = visible ~= false
		item.Name = key .. "Button"
		item.BackgroundColor3 = window:_theme().ComponentBackground
		item.TextColor3 = window:_theme().SecondaryText
		table.insert(headerButtons, item)
		return item
	end
	local requestedOrder = headerOptions.ButtonOrder or { "Hide", "Drag", "Minimize", "Settings" }
	local orderMap = {}
	for index, name in ipairs(requestedOrder) do orderMap[name] = index end
	local hideButton = headerButton("Hide", headerOptions.HideIcon or "●", orderMap.Hide or 1, headerOptions.Hide ~= false)
	local dragButton = headerButton("Drag", headerOptions.DragIcon or "⠿", orderMap.Drag or 2, headerOptions.Drag ~= false)
	local minimizeButton = headerButton("Minimize", "−", orderMap.Minimize or 3, headerOptions.Minimize ~= false)
	local settingsButton = headerButton("Settings", headerOptions.SettingsIcon or "⚙", orderMap.Settings or 4, headerOptions.Settings ~= false)
	window._headerButtons = headerButtons
	window.body = make("Frame", window.frame, {
		BackgroundTransparency = 1,
		Position = UDim2.fromOffset(0, window._headerHeight),
		Size = UDim2.new(1, 0, 1, -window._headerHeight),
	})
	window._navWidth = math.min(148, math.max(100, math.floor(initialWidth * 0.32)))
	window.nav = make("ScrollingFrame", window.body, {
		Active = true,
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		BackgroundColor3 = window:_theme().Navigation,
		BorderSizePixel = 0,
		CanvasSize = UDim2.new(),
		ScrollBarThickness = 3,
		Size = UDim2.new(0, window._navWidth, 1, 0),
	})
	make("UIPadding", window.nav, {
		PaddingBottom = UDim.new(0, 10), PaddingLeft = UDim.new(0, 8),
		PaddingRight = UDim.new(0, 8), PaddingTop = UDim.new(0, 10),
	})
	make("UIListLayout", window.nav, { Padding = UDim.new(0, 5), SortOrder = Enum.SortOrder.LayoutOrder })
	window.pages = make("Frame", window.body, {
		BackgroundColor3 = window:_theme().Background,
		BorderSizePixel = 0,
		Position = UDim2.new(0, window._navWidth, 0, 0),
		Size = UDim2.new(1, -window._navWidth, 1, 0),
	})
	window._notificationStack = make("Frame", screenGui, {
		BackgroundTransparency = 1,
		Position = UDim2.new(1, -320, 1, -12),
		Size = UDim2.fromOffset(300, 320),
	})
	window._notificationStack.AnchorPoint = Vector2.new(0, 1)
	make("UIListLayout", window._notificationStack, {
		HorizontalAlignment = Enum.HorizontalAlignment.Right,
		SortOrder = Enum.SortOrder.LayoutOrder,
		VerticalAlignment = Enum.VerticalAlignment.Bottom,
		Padding = UDim.new(0, 8),
	})
	window.floatingButton = button(screenGui, tostring(headerOptions.FloatingIcon or "◉"), UDim2.fromOffset(54, 54), options.FloatingPosition or UDim2.fromOffset(24, 150))
	window.floatingButton.Name = "RestoreButton"
	window.floatingButton.Visible = false
	window.floatingButton.TextSize = 20
	window.floatingButton.BackgroundColor3 = window:_theme().Accent
	rounded(window.floatingButton, 27)
	local resizeGrip
	if options.Resizable ~= false then
		resizeGrip = button(window.frame, "◢", UDim2.fromOffset(22, 22), UDim2.new(1, -22, 1, -22))
		resizeGrip.Name = "ResizeGrip"
		resizeGrip.BackgroundTransparency = 1
		resizeGrip.TextColor3 = window:_theme().SecondaryText
		resizeGrip.TextSize = 13
		resizeGrip.ZIndex = 10
	end
	local dragInput, dragStart, dragOrigin, dragMode
	local floatingDragged = false
	local dragConnections = {}
	local function disconnectDrag()
		for _, connection in ipairs(dragConnections) do connection:Disconnect() end
		table.clear(dragConnections)
		dragInput, dragMode = nil, nil
	end
	local function startDrag(input, mode)
		if input.UserInputType ~= Enum.UserInputType.MouseButton1 and input.UserInputType ~= Enum.UserInputType.Touch then return end
		disconnectDrag()
		dragInput = input
		if mode == "floating" then floatingDragged = false end
		dragStart = input.Position
		dragOrigin = mode == "window" and window.frame.Position or window.floatingButton.Position
		dragMode = mode
		local changed = UserInputService.InputChanged:Connect(function(nextInput)
			if dragMode ~= mode then return end
			if nextInput.UserInputType == Enum.UserInputType.MouseMovement or nextInput.UserInputType == Enum.UserInputType.Touch then
				local delta = nextInput.Position - dragStart
				if mode == "floating" and delta.Magnitude > 5 then floatingDragged = true end
				if mode == "window" then
					window.frame.Position = dragOrigin + UDim2.fromOffset(delta.X, delta.Y)
					window:_clampPosition()
					if window._rememberPosition then window._defaultPosition = window.frame.Position end
				else
					local screen = viewportSize()
					local width, height = window.floatingButton.AbsoluteSize.X, window.floatingButton.AbsoluteSize.Y
					window.floatingButton.Position = UDim2.fromOffset(
						clamp(dragOrigin.X.Offset + delta.X, 0, math.max(0, screen.X - width)),
						clamp(dragOrigin.Y.Offset + delta.Y, 0, math.max(0, screen.Y - height))
					)
				end
			end
		end)
		local ended = UserInputService.InputEnded:Connect(function(endInput)
			if dragInput and endInput.UserInputType == dragInput.UserInputType then
				disconnectDrag()
			end
		end)
		table.insert(dragConnections, changed)
		table.insert(dragConnections, ended)
		table.insert(window._connections, changed)
		table.insert(window._connections, ended)
	end
	window:_connect(dragButton.InputBegan, function(input) startDrag(input, "window") end)
	window:_connect(window.floatingButton.InputBegan, function(input) startDrag(input, "floating") end)
	if resizeGrip then
		window:_connect(resizeGrip.InputBegan, function(input)
			if input.UserInputType ~= Enum.UserInputType.MouseButton1 and input.UserInputType ~= Enum.UserInputType.Touch then return end
			local start = input.Position
			local initialSize = window.frame.Size
			local changed, ended
			changed = UserInputService.InputChanged:Connect(function(nextInput)
				if nextInput.UserInputType == Enum.UserInputType.MouseMovement or nextInput.UserInputType == Enum.UserInputType.Touch then
					local delta = nextInput.Position - start
					window:Resize(UDim2.fromOffset(initialSize.X.Offset + delta.X, initialSize.Y.Offset + delta.Y))
				end
			end)
			ended = UserInputService.InputEnded:Connect(function(endInput)
				if endInput.UserInputType == input.UserInputType then
					changed:Disconnect()
					ended:Disconnect()
				end
			end)
			table.insert(window._connections, changed)
			table.insert(window._connections, ended)
		end)
	end
	window.resizeGrip = resizeGrip
	window._minimizeButton = minimizeButton
	window:_connect(hideButton.Activated, function() window:Hide() end)
	window:_connect(minimizeButton.Activated, function()
		if window.state == "MINIMIZED" then window:Restore() else window:Minimize() end
	end)
	window:_connect(settingsButton.Activated, function() window:CreateSettings() end)
	window:_connect(window.floatingButton.Activated, function()
		if not floatingDragged then window:Show() end
	end)
	if headerOptions.Title == false then
		local title = window.header:FindFirstChild("WindowTitle")
		if title then title.Visible = false end
	end
	local cameraConnection
	local function watchCamera()
		if cameraConnection then cameraConnection:Disconnect() end
		local camera = workspace.CurrentCamera
		if camera then
			cameraConnection = camera:GetPropertyChangedSignal("ViewportSize"):Connect(function()
				window:_fitToViewport()
			end)
			table.insert(window._connections, cameraConnection)
		end
	end
	watchCamera()
	window:_connect(workspace:GetPropertyChangedSignal("CurrentCamera"), watchCamera)
	window:_connect(screenGui.AncestryChanged, function(_, newParent)
		if newParent ~= playerGui and not window._destroyed then
			window:Destroy()
		end
	end)
	window:SetNotificationPosition(window._notificationPosition)
	window:_fitToViewport()
	self._windows[#self._windows + 1] = window
	return window
end

function Library:RegisterTheme(name, theme)
	assert(type(name) == "string" and name ~= "", "Theme name must be a non-empty string.")
	assert(BUILTIN_THEMES[name] == nil, "Choose a new name; built-in themes cannot be replaced.")
	assert(type(theme) == "table", "Theme must be a table.")
	local merged = copyTable(DEFAULT_THEME)
	for key in pairs(DEFAULT_THEME) do
		assert(typeof(theme[key]) == "Color3", "Theme is missing a Color3 token: " .. key)
		merged[key] = theme[key]
	end
	self._themes[name] = merged
	return true
end

function Library:RemoveCustomTheme(name)
	assert(BUILTIN_THEMES[name] == nil, "Built-in themes cannot be removed.")
	self._themes[name] = nil
	for _, window in ipairs(self._windows) do
		if window._themeName == name then window:SetTheme("Dark") end
	end
	return true
end

function Library:GetTheme(name)
	local theme = self._themes[name]
	return theme and copyTable(theme) or nil
end

function Library:SetTheme(name, window)
	assert(self._themes[name], "Unknown theme: " .. tostring(name))
	if window then
		window:SetTheme(name)
	else
		for _, activeWindow in ipairs(self._windows) do
			activeWindow:SetTheme(name)
		end
	end
end

function Library:SetScale(scale, window)
	if window then
		return window:SetScale(scale)
	end
	for _, activeWindow in ipairs(self._windows) do
		activeWindow:SetScale(scale)
	end
end

function Library:Notify(config)
	local window = config and config.Window
	if not window then
		window = self._windows[#self._windows]
	end
	assert(window and not window._destroyed, "Create a window or pass config.Window before calling Notify.")
	local options = {}
	for key, value in pairs(config or {}) do
		if key ~= "Window" then
			options[key] = value
		end
	end
	return window:Notify(options)
end

function Library:Destroy()
	for _, window in ipairs(copyArray(self._windows)) do
		window:Destroy()
	end
end

Library.Create = function(first, second)
	local options = first == Library and second or first
	return Library:CreateWindow(options)
end
Library.Themes = {}
for themeName in pairs(BUILTIN_THEMES) do
	table.insert(Library.Themes, themeName)
end
table.sort(Library.Themes)

return Library
