local Window = {}
Window.__index = Window

function Window.new(lib, config)
    config=config or {}
    local cleanup = CleanupManager.new()
    local state = StateManager.new("NORMAL")
    local theme = ThemeManager.Current
    local envParent = EnvironmentAdapter:GetGuiParent(config.GuiParent)
    if not envParent then error("[GGH] No valid GuiParent found") end

