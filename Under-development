		Position = UDim2.new(0.53, 0, 0, 58),
		Size = UDim2.new(0.47, 0, 0, 0),
		Visible = false,
	})
	rounded(panel, 7)
	local hueBar = make("Frame", panel, {
		BorderSizePixel = 0, Position = UDim2.fromOffset(8, 8), Size = UDim2.new(1, -16, 0, 12),
	})
	make("UIGradient", hueBar, {
		Color = ColorSequence.new({
			ColorSequenceKeypoint.new(0, Color3.fromRGB(255, 0, 0)),
			ColorSequenceKeypoint.new(0.17, Color3.fromRGB(255, 255, 0)),
			ColorSequenceKeypoint.new(0.33, Color3.fromRGB(0, 255, 0)),
			ColorSequenceKeypoint.new(0.5, Color3.fromRGB(0, 255, 255)),
			ColorSequenceKeypoint.new(0.67, Color3.fromRGB(0, 0, 255)),
			ColorSequenceKeypoint.new(0.83, Color3.fromRGB(255, 0, 255)),
			ColorSequenceKeypoint.new(1, Color3.fromRGB(255, 0, 0)),
		}),
	})
	rounded(hueBar, 5)
	local satBox = make("Frame", panel, {
		BackgroundColor3 = Color3.new(1, 1, 1),
		BorderSizePixel = 0,
		Position = UDim2.fromOffset(8, 28),
		Size = UDim2.new(1, -16, 0, 90),
	})
	make("UIGradient", satBox, {
		Color = ColorSequence.new(Color3.new(1, 1, 1), value),
	})
	local darkOverlay = make("Frame", satBox, {
		BackgroundColor3 = Color3.new(0, 0, 0),
		BorderSizePixel = 0,
		Size = UDim2.new(1, 0, 1, 0),
	})
	make("UIGradient", darkOverlay, {
		Rotation = 90,
		Transparency = NumberSequence.new({
			NumberSequenceKeypoint.new(0, 1),
			NumberSequenceKeypoint.new(1, 0),
		}),
	})
	local marker = make("Frame", satBox, {
		AnchorPoint = Vector2.new(0.5, 0.5), BackgroundColor3 = Color3.new(1, 1, 1),
		BorderSizePixel = 0, Size = UDim2.fromOffset(10, 10), ZIndex = 3,
	})
	rounded(marker, 5)
	stroke(marker, Color3.new(0, 0, 0), 1, 0.1)
	local hexInput = make("TextBox", panel, {
		BackgroundColor3 = self.window:_theme().ComponentBackground,
		BorderSizePixel = 0,
		ClearTextOnFocus = false,
		Font = Enum.Font.Gotham,
		Position = UDim2.fromOffset(8, 125),
		Size = UDim2.new(1, -16, 0, 27),
		Text = "",
		TextColor3 = self.window:_theme().Text,
		TextSize = 11,
	})
	rounded(hexInput, 5)
	local rgbInputs = {}
	for index, channel in ipairs({ "R", "G", "B" }) do
		local input = make("TextBox", panel, {
			BackgroundColor3 = self.window:_theme().ComponentBackground,
			BorderSizePixel = 0,
			ClearTextOnFocus = false,
			Font = Enum.Font.Gotham,
			PlaceholderText = channel,
			Position = UDim2.new((index - 1) / 3, 8, 0, 157),
			Size = UDim2.new(1 / 3, -11, 0, 26),
			Text = "",
			TextColor3 = self.window:_theme().Text,
			TextSize = 10,
		})
		rounded(input, 5)
		table.insert(rgbInputs, input)
	end
	local alphaBar
	if config.Transparency == true or config.WithTransparency == true then
		alphaBar = make("Frame", panel, {
			BackgroundColor3 = self.window:_theme().Border,
			BorderSizePixel = 0,
			Position = UDim2.fromOffset(8, 190),
			Size = UDim2.new(1, -16, 0, 6),
		})
		rounded(alphaBar, 3)
	end
	local alphaFill
	if alphaBar then
		alphaFill = make("Frame", alphaBar, {
			BackgroundColor3 = self.window:_theme().Accent,
			BorderSizePixel = 0,
			Size = UDim2.new(transparency, 0, 1, 0),
		})
		rounded(alphaFill, 3)
	end
	local function hexString(color)
		return string.format("#%02X%02X%02X", math.floor(color.R * 255 + 0.5), math.floor(color.G * 255 + 0.5), math.floor(color.B * 255 + 0.5))
	end
	local hue, saturation, brightness = value:ToHSV()
	local function render(notify)
		value = Color3.fromHSV(hue, saturation, brightness)
		swatch.BackgroundColor3 = value
		hexInput.Text = hexString(value)
		local red, green, blue = math.floor(value.R * 255 + 0.5), math.floor(value.G * 255 + 0.5), math.floor(value.B * 255 + 0.5)
		for index, channelValue in ipairs({ red, green, blue }) do
			if not rgbInputs[index]:IsFocused() then rgbInputs[index].Text = tostring(channelValue) end
		end
		satBox:FindFirstChildOfClass("UIGradient").Color = ColorSequence.new(Color3.new(1, 1, 1), Color3.fromHSV(hue, 1, 1))
		marker.Position = UDim2.new(saturation, 0, 1 - brightness, 0)
		if alphaBar then
			alphaBar.BackgroundColor3 = self.window:_theme().Border
			alphaFill.Size = UDim2.new(transparency, 0, 1, 0)
		end
		if notify then handle:Invoke(value, transparency) end
	end
	local function bindDrag(target, callback, twoDimensional)
		local active
		handle:_connect(target.InputBegan, function(input)
			if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
				active = input
				callback(input.Position.X, input.Position.Y)
			end
		end)
		handle:_connect(UserInputService.InputChanged, function(input)
			if active and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
				callback(input.Position.X, input.Position.Y)
			end
		end)
		handle:_connect(UserInputService.InputEnded, function(input)
			if active and input.UserInputType == active.UserInputType then active = nil end
		end)
	end
	bindDrag(hueBar, function(x)
		hue = clamp((x - hueBar.AbsolutePosition.X) / math.max(hueBar.AbsoluteSize.X, 1), 0, 1)
		render(true)
	end)
	bindDrag(satBox, function(x, y)
		saturation = clamp((x - satBox.AbsolutePosition.X) / math.max(satBox.AbsoluteSize.X, 1), 0, 1)
		brightness = 1 - clamp((y - satBox.AbsolutePosition.Y) / math.max(satBox.AbsoluteSize.Y, 1), 0, 1)
		render(true)
	end, true)
	if alphaBar then
		bindDrag(alphaBar, function(x)
			transparency = clamp((x - alphaBar.AbsolutePosition.X) / math.max(alphaBar.AbsoluteSize.X, 1), 0, 1)
			handle:Invoke(value, transparency)
		end)
	end
	handle:_connect(hexInput.FocusLost, function()
		local hex = string.gsub(hexInput.Text, "^#", "")
		if #hex == 6 and string.match(hex, "^[%x]+$") then
			local red = tonumber(string.sub(hex, 1, 2), 16)
			local green = tonumber(string.sub(hex, 3, 4), 16)
			local blue = tonumber(string.sub(hex, 5, 6), 16)
			value = Color3.fromRGB(red, green, blue)
			hue, saturation, brightness = value:ToHSV()
			render(true)
		else
			hexInput.Text = hexString(value)
		end
	end)
	for _, input in ipairs(rgbInputs) do
		handle:_connect(input.FocusLost, function()
			local channels = {}
			for _, field in ipairs(rgbInputs) do
				local channel = tonumber(field.Text)
				if not channel or channel < 0 or channel > 255 then
					render(false)
					return
				end
				table.insert(channels, math.floor(channel + 0.5))
			end
			value = Color3.fromRGB(channels[1], channels[2], channels[3])
			hue, saturation, brightness = value:ToHSV()
			render(true)
		end)
	end
	handle:_connect(swatch.Activated, function()
		expanded = not expanded
		panel.Visible = expanded
		local height = alphaBar and 214 or 184
		self.window:_animate(panel, { Size = UDim2.new(0.47, 0, 0, expanded and height or 0) }, 0.14)
		root.Size = UDim2.new(1, 0, 0, expanded and height + 62 or 58)
	end)
	handle:_setValueMethods(function() return value end, function(nextValue, notify)
		if typeof(nextValue) == "Color3" then
			value = nextValue
			hue, saturation, brightness = value:ToHSV()
			render(notify)
		end
	end)
	handle.GetTransparency = function() return transparency end
	handle.SetTransparency = function(_, nextValue, notify)
		transparency = clamp(tonumber(nextValue) or 0, 0, 1)
		if alphaFill then alphaFill.Size = UDim2.new(transparency, 0, 1, 0) end
		if notify then handle:Invoke(value, transparency) end
	end
	handle._applyTheme = function(theme)
		handle.TitleLabel.TextColor3 = theme.Text
		panel.BackgroundColor3 = theme.SecondaryBackground
		hexInput.BackgroundColor3 = theme.ComponentBackground
		hexInput.TextColor3 = theme.Text
		for _, input in ipairs(rgbInputs) do
			input.BackgroundColor3 = theme.ComponentBackground
			input.TextColor3 = theme.Text
		end
		if alphaBar then alphaBar.BackgroundColor3 = theme.Border end
		if alphaFill then alphaFill.BackgroundColor3 = theme.Accent end
	end
	render(false)
	return handle
end

