function Tab:CreateCollapsibleSection(config)
	config = config or {}
	local handle, root = self:_createBase(config, 36)
	local toggle = button(root, "▾", UDim2.fromOffset(28, 26), UDim2.new(1, -28, 0, 4))
	toggle.BackgroundTransparency = 1
	toggle.TextSize = 16
	handle.Control.Visible = false
	local collapsed = config.Collapsed == true
	local items = {}
	local function setCollapsed(value)
		collapsed = value == true
		toggle.Text = collapsed and "▸" or "▾"
		for _, item in ipairs(items) do item:SetVisible(not collapsed) end
		if config.AutoHeight ~= false then
			root.Size = UDim2.new(1, 0, 0, 36)
		end
	end
	handle:_connect(toggle.Activated, function() setCollapsed(not collapsed) end)
	handle.Add = function(_, component)
		if component then
			table.insert(items, component)
			component:SetVisible(not collapsed)
		end
		return component
	end
	handle.SetCollapsed = function(_, value) setCollapsed(value) end
	handle.GetCollapsed = function() return collapsed end
	handle._applyTheme = function(theme)
		handle.TitleLabel.TextColor3 = theme.Accent
		toggle.TextColor3 = theme.SecondaryText
	end
	return handle
end

