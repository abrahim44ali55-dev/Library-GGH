function Tab:CreateSlider(config)
	config = config or {}
	local minimum = tonumber(config.Min) or 0
	local maximum = tonumber(config.Max) or 100
	assert(maximum > minimum, "Slider Max must be greater than Min.")
	local increment = math.max(tonumber(config.Increment) or 1, 0.000001)
	local handle, _, control = self:_createBase(config, 62)
	local value = clamp(tonumber(config.Default) or minimum, minimum, maximum)
	local valueLabel = label(control, tostring(value), UDim2.new(1, 0, 0, 17), UDim2.fromOffset(0, 0), self.window:_theme().SecondaryText, 10, {
		TextXAlignment = Enum.TextXAlignment.Right,
	})
	local rail = make("Frame", control, {
		BackgroundColor3 = self.window:_theme().Border,
		BorderSizePixel = 0,
		Position = UDim2.new(0, 0, 0, 32),
		Size = UDim2.new(1, 0, 0, 6),
	})
	rounded(rail, 3)
	local fill = make("Frame", rail, {
		BackgroundColor3 = self.window:_theme().Accent,
		BorderSizePixel = 0,
		Size = UDim2.new(0, 0, 1, 0),
	})
	rounded(fill, 3)
	local knob = make("Frame", rail, {
		AnchorPoint = Vector2.new(0.5, 0.5),
		BackgroundColor3 = Color3.new(1, 1, 1),
		BorderSizePixel = 0,
		Position = UDim2.new(0, 0, 0.5, 0),
		Size = UDim2.fromOffset(13, 13),
	})
	rounded(knob, 7)
	local function setValue(nextValue, notify)
		local number = tonumber(nextValue)
		if not isFiniteNumber(number) then
			return false
		end
		value = clamp(math.floor((number - minimum) / increment + 0.5) * increment + minimum, minimum, maximum)
		local alpha = (value - minimum) / (maximum - minimum)
		valueLabel.Text = tostring(value)
		fill.Size = UDim2.new(alpha, 0, 1, 0)
		knob.Position = UDim2.new(alpha, 0, 0.5, 0)
		if notify then
			handle:Invoke(value)
		end
		return true
	end
	handle:_setValueMethods(function() return value end, setValue)
	local dragging = false
	local activeInput
	handle:_connect(rail.InputBegan, function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			dragging = true
			activeInput = input
			local alpha = clamp((input.Position.X - rail.AbsolutePosition.X) / math.max(rail.AbsoluteSize.X, 1), 0, 1)
			setValue(minimum + alpha * (maximum - minimum), true)
		end
	end)
	handle:_connect(UserInputService.InputChanged, function(input)
		if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
			local alpha = clamp((input.Position.X - rail.AbsolutePosition.X) / math.max(rail.AbsoluteSize.X, 1), 0, 1)
			setValue(minimum + alpha * (maximum - minimum), true)
		end
	end)
	handle:_connect(UserInputService.InputEnded, function(input)
		if activeInput and input.UserInputType == activeInput.UserInputType then
			dragging = false
			activeInput = nil
		end
	end)
	handle._applyTheme = function(theme)
		handle.TitleLabel.TextColor3 = theme.Text
		valueLabel.TextColor3 = theme.SecondaryText
		rail.BackgroundColor3 = theme.Border
		fill.BackgroundColor3 = theme.Accent
	end
	setValue(value, false)
	return handle
end

function Tab:CreateRangeSlider(config)
	config = config or {}
	local minimum, maximum = tonumber(config.Min) or 0, tonumber(config.Max) or 100
	assert(maximum > minimum, "RangeSlider Max must be greater than Min.")
	local handle, _, control = self:_createBase(config, 66)
	local initial = config.Default or { minimum, maximum }
	assert(type(initial) == "table", "RangeSlider Default must be a { low, high } array.")
	local low, high = tonumber(initial[1]) or minimum, tonumber(initial[2]) or maximum
	if low > high then low, high = high, low end
	local rail = make("Frame", control, {
		BackgroundColor3 = self.window:_theme().Border,
		BorderSizePixel = 0,
		Position = UDim2.new(0, 0, 0, 36),
		Size = UDim2.new(1, 0, 0, 6),
	})
	rounded(rail, 3)
	local fill = make("Frame", rail, { BackgroundColor3 = self.window:_theme().Accent, BorderSizePixel = 0 })
	rounded(fill, 3)
	local lowKnob = make("Frame", rail, {
		AnchorPoint = Vector2.new(0.5, 0.5), BackgroundColor3 = Color3.new(1, 1, 1),
		BorderSizePixel = 0, Size = UDim2.fromOffset(13, 13), ZIndex = 2,
	})
	local highKnob = lowKnob:Clone()
	highKnob.Parent = rail
	rounded(lowKnob, 7)
	rounded(highKnob, 7)
	local valueLabel = label(control, "", UDim2.new(1, 0, 0, 18), UDim2.new(0, 0, 0, 4), self.window:_theme().SecondaryText, 10, {
		TextXAlignment = Enum.TextXAlignment.Right,
	})
	local dragging
	local activeInput
	local function setRange(a, b, notify)
		a, b = tonumber(a), tonumber(b)
		if not isFiniteNumber(a) or not isFiniteNumber(b) then
			return false
		end
		low = clamp(a, minimum, maximum)
		high = clamp(b, minimum, maximum)
		if low > high then low, high = high, low end
		local alphaA, alphaB = (low - minimum) / (maximum - minimum), (high - minimum) / (maximum - minimum)
		lowKnob.Position = UDim2.new(alphaA, 0, 0.5, 0)
		highKnob.Position = UDim2.new(alphaB, 0, 0.5, 0)
		fill.Position = UDim2.new(alphaA, 0, 0, 0)
		fill.Size = UDim2.new(alphaB - alphaA, 0, 1, 0)
		valueLabel.Text = tostring(low) .. " — " .. tostring(high)
		if notify then handle:Invoke({ low, high }) end
		return true
	end
	handle:_setValueMethods(function() return { low, high } end, function(value, notify)
		if type(value) == "table" then setRange(value[1], value[2], notify) end
	end)
	local function updateAt(x)
		local alpha = clamp((x - rail.AbsolutePosition.X) / math.max(rail.AbsoluteSize.X, 1), 0, 1)
		local number = minimum + alpha * (maximum - minimum)
		if dragging == "low" then setRange(math.min(number, high), high, true)
		else setRange(low, math.max(number, low), true) end
	end
	local function beginDrag(input)
		if input.UserInputType ~= Enum.UserInputType.MouseButton1 and input.UserInputType ~= Enum.UserInputType.Touch then return end
		activeInput = input
		local alphaLow = (low - minimum) / (maximum - minimum)
		local alphaHigh = (high - minimum) / (maximum - minimum)
		local alpha = clamp((input.Position.X - rail.AbsolutePosition.X) / math.max(rail.AbsoluteSize.X, 1), 0, 1)
		dragging = math.abs(alpha - alphaLow) <= math.abs(alpha - alphaHigh) and "low" or "high"
		updateAt(input.Position.X)
	end
	handle:_connect(rail.InputBegan, beginDrag)
	handle:_connect(UserInputService.InputChanged, function(input)
		if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
			updateAt(input.Position.X)
		end
	end)
	handle:_connect(UserInputService.InputEnded, function(input)
		if activeInput and input.UserInputType == activeInput.UserInputType then
			dragging, activeInput = nil, nil
		end
	end)
	handle._applyTheme = function(theme)
		handle.TitleLabel.TextColor3 = theme.Text
		valueLabel.TextColor3 = theme.SecondaryText
		rail.BackgroundColor3 = theme.Border
		fill.BackgroundColor3 = theme.Accent
	end
	setRange(low, high, false)
	return handle
end

function Tab:CreateNumberInput(config)
	config = config or {}
	local minimum, maximum = tonumber(config.Min), tonumber(config.Max)
	assert(not (minimum and maximum) or maximum >= minimum, "NumberInput Max cannot be smaller than Min.")
	local inputConfig = {}
	for key, value in pairs(config) do inputConfig[key] = value end
	inputConfig.FireOnFocusLost = false
	inputConfig.Live = false
	local handle = self:CreateInput(inputConfig)
	local input = handle.Control:FindFirstChildWhichIsA("TextBox")
	if input then
		local function validate()
			local number = tonumber(input.Text)
			if number and number == number and number ~= math.huge and number ~= -math.huge then
				if minimum then number = math.max(minimum, number) end
				if maximum then number = math.min(maximum, number) end
				input.Text = tostring(number)
				handle:SetValue(number, true)
			else
				input.Text = tostring(handle:GetValue() or config.Default or "")
			end
		end
		handle:_connect(input.FocusLost, validate)
	end
	return handle
end

local function optionList(config)
	local result = {}
	for _, option in ipairs(config.Options or {}) do
		if type(option) == "table" then
			local value = option.Value
			if value == nil then value = option.Name end
			if value == nil then value = option.Label end
			local labelText = option.Label
			if labelText == nil then labelText = option.Name end
			if labelText == nil then labelText = value end
			table.insert(result, { Value = value, Label = tostring(labelText) })
		else
			table.insert(result, { Value = option, Label = tostring(option) })
		end
	end
	return result
end

function Tab:_createDropdown(config, multi, searchable)
	config = config or {}
	local options = optionList(config)
	local handle, root, control = self:_createBase(config, 58)
	local current = multi and (type(config.Default) == "table" and copyTable(config.Default) or {}) or config.Default
	local expanded = false
	local searchInput
	local choices
	local trigger = button(control, "", UDim2.new(1, 0, 0, 32), UDim2.new(0, 0, 0.5, -16))
	local panel = make("Frame", root, {
		BackgroundColor3 = self.window:_theme().SecondaryBackground,
		BorderSizePixel = 0,
		ClipsDescendants = true,
		Position = UDim2.new(0.53, 0, 0, 58),
		Size = UDim2.new(0.47, 0, 0, 0),
		Visible = false,
		ZIndex = 4,
	})
	rounded(panel, 7)
	stroke(panel, self.window:_theme().Border, 1, 0.2)
	if searchable then
		searchInput = make("TextBox", panel, {
			BackgroundColor3 = self.window:_theme().ComponentBackground,
			BorderSizePixel = 0,
			ClearTextOnFocus = false,
			Font = Enum.Font.Gotham,
			PlaceholderText = "Filter options",
			Size = UDim2.new(1, -12, 0, 28),
			Position = UDim2.fromOffset(6, 6),
			Text = "",
			TextColor3 = self.window:_theme().Text,
			TextSize = 11,
			ZIndex = 5,
		})
		rounded(searchInput, 5)
	end
	choices = make("ScrollingFrame", panel, {
		Active = true,
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		CanvasSize = UDim2.new(),
		Position = UDim2.fromOffset(4, searchable and 40 or 4),
		ScrollBarThickness = 3,
		Size = UDim2.new(1, -8, 1, searchable and -44 or -8),
		ZIndex = 5,
	})
	make("UIListLayout", choices, { Padding = UDim.new(0, 3), SortOrder = Enum.SortOrder.LayoutOrder })
	local optionButtons = {}
	local function isChosen(value)
		if multi then
			for _, item in ipairs(current) do if item == value then return true end end
			return false
		end
		return current == value
	end
	local function renderValue()
		if multi then
			local values = {}
			for _, option in ipairs(options) do
				if isChosen(option.Value) then table.insert(values, option.Label) end
			end
			trigger.Text = (#values > 0 and table.concat(values, ", ") or tostring(config.Placeholder or "Choose options")) .. (expanded and "  ▴" or "  ▾")
		else
			local text = tostring(config.Placeholder or "Choose an option")
			for _, option in ipairs(options) do if option.Value == current then text = option.Label break end end
			trigger.Text = text .. (expanded and "  ▴" or "  ▾")
		end
		for _, item in ipairs(optionButtons) do
			item.button.BackgroundColor3 = isChosen(item.option.Value) and self.window:_theme().ActiveTab or self.window:_theme().SecondaryBackground
			item.check.Visible = isChosen(item.option.Value)
		end
	end
	local function updateHeight()
		local count = 0
		for _, item in ipairs(optionButtons) do if item.button.Visible then count = count + 1 end end
		local panelHeight = math.min((searchable and 40 or 0) + count * 31 + 8, 190)
		self.window:_animate(panel, { Size = UDim2.new(0.47, 0, 0, expanded and panelHeight or 0) }, 0.14)
		root.Size = UDim2.new(1, 0, 0, expanded and 62 + panelHeight or 58)
	end
	local function setValue(value, notify)
		if multi then
			assert(type(value) == "table", "MultiDropdown value must be an array.")
			current = copyTable(value)
		else
			current = value
		end
		renderValue()
		if notify then handle:Invoke(multi and copyTable(current) or current) end
	end
	for index, option in ipairs(options) do
		local optionButton = button(choices, "", UDim2.new(1, -2, 0, 28))
		optionButton.LayoutOrder = index
		optionButton.TextXAlignment = Enum.TextXAlignment.Left
		optionButton.Text = "   " .. option.Label
		optionButton.ZIndex = 6
		local check = label(optionButton, multi and "✓" or "●", UDim2.fromOffset(18, 26), UDim2.new(1, -23, 0, 1), self.window:_theme().Accent, 12, {
			Name = "SelectedMark",
			TextXAlignment = Enum.TextXAlignment.Center,
			ZIndex = 7,
		})
		table.insert(optionButtons, { button = optionButton, option = option, check = check })
		handle:_connect(optionButton.Activated, function()
			if multi then
				local nextValue = copyTable(current)
				local found
				for i, item in ipairs(nextValue) do
					if item == option.Value then table.remove(nextValue, i) found = true break end
				end
				if not found then table.insert(nextValue, option.Value) end
				setValue(nextValue, true)
			else
				setValue(option.Value, true)
				expanded = false
				panel.Visible = false
				updateHeight()
			end
		end)
	end
	if searchable then
		handle:_connect(searchInput:GetPropertyChangedSignal("Text"), function()
			local query = string.lower(searchInput.Text)
			for _, item in ipairs(optionButtons) do
				item.button.Visible = string.find(string.lower(item.option.Label), query, 1, true) ~= nil
			end
			updateHeight()
		end)
	end
	handle:_connect(trigger.Activated, function()
		expanded = not expanded
		panel.Visible = expanded
		renderValue()
		updateHeight()
	end)
	handle:_setValueMethods(function() return multi and copyTable(current) or current end, setValue)
	handle._applyTheme = function(theme)
		handle.TitleLabel.TextColor3 = theme.Text
		trigger.BackgroundColor3 = theme.ComponentBackground
		trigger.TextColor3 = theme.Text
		panel.BackgroundColor3 = theme.SecondaryBackground
		if searchInput then
			searchInput.BackgroundColor3 = theme.ComponentBackground
			searchInput.TextColor3 = theme.Text
		end
		renderValue()
	end
	renderValue()
	return handle
end

