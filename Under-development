local Window = {}
Window.__index = Window

local Tab = {}
Tab.__index = Tab

local Component = {}
Component.__index = Component

local function invoke(window, callback, ...)
	if type(callback) ~= "function" or window._destroyed then
		return
	end
	local args = table.pack(...)
	task.spawn(function()
		if window._destroyed then
			return
		end
		local ok, err = pcall(callback, table.unpack(args, 1, args.n))
		if not ok then
			warn("[RobloxUIFramework] Callback failed: " .. tostring(err))
		end
	end)
end

function Window:_connect(signal, callback, bucket)
	local connection = signal:Connect(callback)
	local collection = bucket or self._connections
	table.insert(collection, connection)
	return connection
end

function Window:_animate(instance, properties, duration)
	if not instance or not instance.Parent then
		return nil
	end
	local oldTween = self._tweens[instance]
	if oldTween then
		oldTween:Cancel()
	end
	if not self._animationsEnabled then
		for key, value in pairs(properties) do
			instance[key] = value
		end
		self._tweens[instance] = nil
		return nil
	end
	local tween = TweenService:Create(
		instance,
		TweenInfo.new((duration or 0.18) * self._animationSpeed, Enum.EasingStyle.Quint, Enum.EasingDirection.Out),
		properties
	)
	self._tweens[instance] = tween
	local connection
	connection = tween.Completed:Connect(function()
		if connection then
			connection:Disconnect()
		end
		if self._tweens[instance] == tween then
			self._tweens[instance] = nil
		end
	end)
	tween:Play()
	return tween
end

function Window:_theme()
	return self._themeData
end

function Window:_applyTheme()
	if self._destroyed then
		return
	end
	local theme = self:_theme()
	self.frame.BackgroundColor3 = theme.Background
	self.header.BackgroundColor3 = theme.Header
	self.nav.BackgroundColor3 = theme.Navigation
	self.pages.BackgroundColor3 = theme.Background
	if self._outline then
		self._outline.Color = theme.Border
	end
	local windowTitle = self.header:FindFirstChild("WindowTitle")
	local windowSubtitle = self.header:FindFirstChild("WindowSubtitle")
	if windowTitle then windowTitle.TextColor3 = theme.Text end
	if windowSubtitle then windowSubtitle.TextColor3 = theme.SecondaryText end
	for _, headerButton in ipairs(self._headerButtons or {}) do
		if headerButton.Parent then
			headerButton.BackgroundColor3 = theme.ComponentBackground
			headerButton.TextColor3 = theme.SecondaryText
		end
	end
	if self.floatingButton then self.floatingButton.BackgroundColor3 = theme.Accent end
	if self.resizeGrip then self.resizeGrip.TextColor3 = theme.SecondaryText end
	for _, tab in ipairs(self.tabs) do
		if tab.button and tab.button.Parent then
			tab.button.TextColor3 = tab == self._selectedTab and theme.Text or theme.SecondaryText
			tab.button.BackgroundColor3 = tab == self._selectedTab and theme.ActiveTab or theme.Navigation
		end
	end
	for _, component in ipairs(self._components) do
		if component._applyTheme and not component._destroyed then
			component._applyTheme(theme)
		end
	end
	for _, notification in ipairs(self._notifications) do
		if notification._applyTheme then
			notification._applyTheme(theme)
		end
	end
end

function Window:SetTheme(themeName)
	if self._destroyed then return false end
	local theme = Library._themes[themeName]
	assert(theme, "Unknown theme: " .. tostring(themeName))
	self._themeName = themeName
	self._themeData = copyTable(theme)
	self:_applyTheme()
	return true
end

function Window:_getThemeName()
	return self._themeName
end

function Window:_clampPosition()
	if self._destroyed or not self.frame.Parent then
		return
	end
	local size = viewportSize()
	local width = self.frame.AbsoluteSize.X
	local height = self.frame.AbsoluteSize.Y
	if width <= 0 then width = self.frame.Size.X.Offset * self._scale end
	if height <= 0 then height = self.frame.Size.Y.Offset * self._scale end
	local position = self.frame.Position
	local x = clamp(position.X.Offset, 0, math.max(0, size.X - width))
	local y = clamp(position.Y.Offset, 0, math.max(0, size.Y - height))
	self.frame.Position = UDim2.fromOffset(x, y)
end

function Window:_fitToViewport()
	if self._destroyed then
		return
	end
	local screen = viewportSize()
	local maxWidth = math.max(180, screen.X - 24)
	local maxHeight = math.max(self._headerHeight, screen.Y - 36)
	local current = self.frame.Size
	local width = math.min(current.X.Offset, self._maxSize.X, maxWidth)
	local height = math.min(current.Y.Offset, self._maxSize.Y, maxHeight)
	self.frame.Size = UDim2.fromOffset(width, height)
	if self.nav and self.pages then
		self._navWidth = math.min(148, math.max(100, math.floor(width * 0.32)))
		self.nav.Size = UDim2.new(0, self._navWidth, 1, 0)
		self.pages.Position = UDim2.new(0, self._navWidth, 0, 0)
		self.pages.Size = UDim2.new(1, -self._navWidth, 1, 0)
	end
	self:_clampPosition()
	if self.floatingButton and self.floatingButton.Parent then
		local floatingSize = self.floatingButton.AbsoluteSize
		self.floatingButton.Position = UDim2.fromOffset(
			clamp(self.floatingButton.Position.X.Offset, 0, math.max(0, screen.X - floatingSize.X)),
			clamp(self.floatingButton.Position.Y.Offset, 0, math.max(0, screen.Y - floatingSize.Y))
		)
	end
	if self._notificationStack then
		local stackWidth = math.max(180, math.min(300, screen.X - 20))
		self._notificationStack.Size = UDim2.fromOffset(stackWidth, self._notificationStack.Size.Y.Offset)
		self:_applyNotificationPosition()
	end
end

function Window:_setPage(page)
	for _, tab in ipairs(self.tabs) do
		tab.page.Visible = false
	end
	if self._settingsTab then
		self._settingsTab.page.Visible = false
	end
	if page then
		page.Visible = true
	end
end

function Window:_refreshActivePage()
	if self._destroyed then
		return
	end
	if self.state == "SETTINGS_OPEN" and self._settingsTab then
		self:_setPage(self._settingsTab.page)
	elseif self._selectedTab then
		self:_setPage(self._selectedTab.page)
	end
end

function Window:_updateTabButtons()
	local theme = self:_theme()
	for _, tab in ipairs(self.tabs) do
		if tab.button and tab.button.Parent then
			tab.button.BackgroundColor3 = tab == self._selectedTab and theme.ActiveTab or theme.Navigation
			tab.button.TextColor3 = tab == self._selectedTab and theme.Text or theme.SecondaryText
			local indicator = tab.button:FindFirstChild("ActiveIndicator")
			if indicator then
				indicator.Visible = tab == self._selectedTab
			end
		end
	end
end

function Window:_selectTab(tab, fireCallback)
	if self._destroyed or type(tab) ~= "table" or tab.window ~= self or tab._removed then
		return false
	end
	if self.state == "SETTINGS_OPEN" then
		self.state = "NORMAL"
	end
	self._selectedTab = tab
	self._lastNormalTab = tab
	self:_refreshActivePage()
	self:_updateTabButtons()
	if fireCallback then
		invoke(self, tab._onSelected, tab)
	end
	return true
end

function Window:SelectTab(tabOrName)
	local tab = tabOrName
	if type(tabOrName) == "string" then
		tab = nil
		for _, candidate in ipairs(self.tabs) do
			if candidate.name == tabOrName or candidate.id == tabOrName then
				tab = candidate
				break
			end
		end
	end
	return self:_selectTab(tab, true)
end

function Window:GetSelectedTab()
	return self._selectedTab
end

function Window:GetTabs()
	local result = {}
	for _, tab in ipairs(self.tabs) do
		if not tab._removed then
			table.insert(result, tab)
		end
	end
	return result
end

function Window:CreateTab(options)
	assert(not self._destroyed, "Cannot create a tab on a destroyed window.")
	options = options or {}
	local tabName = tostring(options.Name or options.Title or ("Tab " .. tostring(#self.tabs + 1)))
	for _, existing in ipairs(self.tabs) do
		assert(existing.name ~= tabName, "A tab with this name already exists: " .. tabName)
	end
	local theme = self:_theme()
	local tabId = HttpService:GenerateGUID(false)
	local tabButton = button(self.nav, "", UDim2.new(1, -10, 0, 38))
	tabButton.Name = "Tab_" .. tabId
	tabButton.LayoutOrder = #self.tabs + 1
	tabButton.TextXAlignment = Enum.TextXAlignment.Left
	tabButton.TextSize = 12
	tabButton.BackgroundColor3 = theme.Navigation
	tabButton.TextColor3 = theme.SecondaryText
	local iconText = tostring(options.Icon or "•")
	label(tabButton, iconText, UDim2.fromOffset(22, 28), UDim2.fromOffset(8, 5), theme.SecondaryText, 14, {
		Name = "Icon",
		TextXAlignment = Enum.TextXAlignment.Center,
	})
	local title = label(tabButton, tabName, UDim2.new(1, -42, 1, 0), UDim2.fromOffset(34, 0), theme.SecondaryText, 12, {
		Name = "Title",
		TextTruncate = Enum.TextTruncate.AtEnd,
	})
	if options.Badge ~= nil then
		local badge = label(tabButton, tostring(options.Badge), UDim2.fromOffset(24, 18), UDim2.new(1, -30, 0, 10), theme.Accent, 10, {
			Name = "Badge",
			TextXAlignment = Enum.TextXAlignment.Center,
		})
		badge.BackgroundTransparency = 0
		badge.BackgroundColor3 = theme.ActiveTab
		rounded(badge, 8)
	end
	local indicator = make("Frame", tabButton, {
		Name = "ActiveIndicator",
		AnchorPoint = Vector2.new(0, 0.5),
		BackgroundColor3 = theme.Accent,
		BorderSizePixel = 0,
		Position = UDim2.new(0, 2, 0.5, 0),
		Size = UDim2.fromOffset(3, 20),
		Visible = false,
	})
	rounded(indicator, 2)
	local page = make("ScrollingFrame", self.pages, {
		Name = "Page_" .. tabId,
		Active = true,
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		CanvasSize = UDim2.new(),
		ScrollBarImageColor3 = theme.Accent,
		ScrollBarThickness = 4,
		Size = UDim2.new(1, 0, 1, 0),
		Visible = false,
	})
	make("UIPadding", page, {
		PaddingBottom = UDim.new(0, 12),
		PaddingLeft = UDim.new(0, 14),
		PaddingRight = UDim.new(0, 14),
		PaddingTop = UDim.new(0, 12),
	})
	make("UIListLayout", page, {
		Padding = UDim.new(0, window._contentSpacing or 8),
		SortOrder = Enum.SortOrder.LayoutOrder,
	})
	local tab = setmetatable({
		window = self,
		id = tabId,
		name = tabName,
		description = options.Description,
		button = tabButton,
		page = page,
		components = {},
		_onSelected = options.OnSelected,
		_removed = false,
	}, Tab)
	table.insert(self.tabs, tab)
	self:_connect(tabButton.Activated, function()
		self:_selectTab(tab, true)
	end)
	if not self._selectedTab then
		self:_selectTab(tab, false)
	end
	return tab
end

function Window:RemoveTab(tabOrName)
	local target = tabOrName
	if type(tabOrName) == "string" then
		target = nil
		for _, tab in ipairs(self.tabs) do
			if tab.name == tabOrName or tab.id == tabOrName then
				target = tab
				break
			end
		end
	end
	if type(target) ~= "table" or target.window ~= self or target._removed then
		return false
	end
	local index
	for i, tab in ipairs(self.tabs) do
		if tab == target then
			index = i
			break
		end
	end
	target._removed = true
	for _, component in ipairs(copyArray(target.components)) do
		component:Destroy()
	end
	if target.button then
		target.button:Destroy()
	end
	if target.page then
		target.page:Destroy()
	end
	if index then
		table.remove(self.tabs, index)
	end
	if self._selectedTab == target then
		self._selectedTab = nil
		local replacement = self.tabs[math.max(1, math.min(index or 1, #self.tabs))]
		if replacement then
			self:_selectTab(replacement, true)
		else
			self:_setPage(nil)
		end
	end
	return true
end

function Tab:GetName()
	return self.name
