    if not ok then
        if LocalPlayer and LocalPlayer:FindFirstChild("PlayerGui") then
            screenGui.Parent = LocalPlayer.PlayerGui
        else
            error("[GGH] Failed to parent ScreenGui: "..tostring(err))
        end
    end
    cleanup:AddInstance(screenGui)

    local mainSize = config.Size or UDim2.fromOffset(650,480)
    local minSize = config.MinSize or UDim2.fromOffset(350,300)
    local startPos = config.Position or UDim2.fromOffset(100,100)

    local mainFrame = Utility:Create("Frame", {
        Name="MainWindow",
        Size=mainSize,
        Position=startPos,
        BackgroundColor3=theme.Background,
        Parent=screenGui,
        ClipsDescendants=false,
    })
    Utility:RoundCorners(mainFrame,14)
    Utility:Stroke(mainFrame, theme.Border,1)
    cleanup:AddInstance(mainFrame)

    -- Shadow (simple)
    local shadow = Utility:Create("ImageLabel", {Image="rbxassetid://5554236805", Size=UDim2.new(1,40,1,40), Position=UDim2.fromOffset(-20,-20), BackgroundTransparency=1, ImageTransparency=0.5, ImageColor3=Color3.new(0,0,0), ZIndex=-1, Parent=mainFrame})

    -- Header
    local headerHeight = (config.Header and config.Header.Height) or 48
    local header = Utility:Create("Frame", {
        Name="Header",
        Size=UDim2.new(1,0,0,headerHeight),
        BackgroundColor3=theme.Header,
        Parent=mainFrame,
        ZIndex=2,
    })
    Utility:RoundCorners(header,14)
    local headerFix = Utility:Create("Frame", {Size=UDim2.new(1,0,0,14), Position=UDim2.new(0,0,1,-14), BackgroundColor3=theme.Header, BorderSizePixel=0, ZIndex=1, Parent=header})

    local titleLbl = Utility:Create("TextLabel", {
        Text=config.Title or "GGH Premium",
        Position=UDim2.fromOffset(16,0),
        Size=UDim2.new(0.5,0,1,0),
        BackgroundTransparency=1,
        TextColor3=theme.Text,
        Font=Enum.Font.GothamBold,
        TextSize=15,
        TextXAlignment=Enum.TextXAlignment.Left,
        Parent=header,
    })
    if config.Subtitle then
        Utility:Create("TextLabel", {Text=config.Subtitle, Position=UDim2.fromOffset(16,18), Size=UDim2.new(0.5,0,0,14), BackgroundTransparency=1, TextColor3=theme.SecondaryText, Font=Enum.Font.Gotham, TextSize=11, TextXAlignment=Enum.TextXAlignment.Left, Parent=header})
        titleLbl.Position=UDim2.fromOffset(16,-6)
    end

    -- Header Buttons Container
    local btnContainer = Utility:Create("Frame", {Size=UDim2.new(0,140,1,0), Position=UDim2.new(1,-150,0,0), BackgroundTransparency=1, Parent=header})
    Utility:Create("UIListLayout", {FillDirection=Enum.FillDirection.Horizontal, HorizontalAlignment=Enum.HorizontalAlignment.Right, VerticalAlignment=Enum.VerticalAlignment.Center, Padding=UDim.new(0,6), Parent=btnContainer})

    local function makeHeaderBtn(icon, tooltip)
        local b = Utility:Create("TextButton", {Size=UDim2.fromOffset(28,28), BackgroundColor3=theme.ComponentBackground, Text=icon, TextColor3=theme.Text, Font=Enum.Font.GothamBold, TextSize=14, AutoButtonColor=false, Parent=btnContainer})
        Utility:RoundCorners(b,8)
        Utility:Stroke(b, theme.Border,1)
        b.MouseEnter:Connect(function() AnimationManager:Tween(b,{BackgroundColor3=theme.Hover},0.15) end)
        b.MouseLeave:Connect(function() AnimationManager:Tween(b,{BackgroundColor3=theme.ComponentBackground},0.15) end)
        return b
    end

    local dragBtn = makeHeaderBtn("✥","Drag")
    local hideBtn = makeHeaderBtn("—","Hide")
    local minBtn = makeHeaderBtn("–","Minimize")
    local settingsBtn = makeHeaderBtn("⚙","Settings")

    -- Navigation + Content
    local navWidth = 160
    local navFrame = Utility:Create("Frame", {Name="Nav", Size=UDim2.new(0,navWidth,1,-headerHeight), Position=UDim2.new(0,0,0,headerHeight), BackgroundColor3=theme.Navigation, Parent=mainFrame})
    local navLayout = Utility:Create("UIListLayout", {Padding=UDim.new(0,4), SortOrder=Enum.SortOrder.LayoutOrder, Parent=navFrame})
    Utility:Create("UIPadding", {PaddingTop=UDim.new(0,10), PaddingLeft=UDim.new(0,8), PaddingRight=UDim.new(0,8), Parent=navFrame})

    local contentFrame = Utility:Create("ScrollingFrame", {
        Name="Content",
        Size=UDim2.new(1,-navWidth,1,-headerHeight),
        Position=UDim2.new(0,navWidth,0,headerHeight),
        BackgroundColor3=theme.SecondaryBackground,
        BorderSizePixel=0,
        ScrollBarThickness=4,
        ScrollBarImageColor3=theme.Border,
        CanvasSize=UDim2.new(0,0,0,0),
        AutomaticCanvasSize=Enum.AutomaticSize.Y,
        Parent=mainFrame,
    })
    local contentLayout = Utility:Create("UIListLayout", {Padding=UDim.new(0,8), SortOrder=Enum.SortOrder.LayoutOrder, Parent=contentFrame})
    Utility:Create("UIPadding", {PaddingAll=UDim.new(0,10), Parent=contentFrame})

    -- Floating button
    local floatingBtn = Utility:Create("TextButton", {
        Name="Floating",
        Size=UDim2.fromOffset(52,52),
        Position=UDim2.fromOffset(20,200),
        BackgroundColor3=theme.Accent,
        Text="G",
        TextColor3=Color3.new(1,1,1),
        Font=Enum.Font.GothamBold,
        TextSize=20,
        Visible=false,
        Parent=screenGui,
        ZIndex=50,
    })
    Utility:RoundCorners(floatingBtn,26)
    cleanup:AddInstance(floatingBtn)

    -- State logic
    local selfObj = setmetatable({
        _lib=lib,
        Config=config,
        Cleanup=cleanup,
        State=state,
        ScreenGui=screenGui,
        MainFrame=mainFrame,
        Header=header,
        NavFrame=navFrame,
        ContentFrame=contentFrame,
        FloatingButton=floatingBtn,
        Tabs={},
        SelectedTab=nil,
        SettingsTab=nil,
        PreviousTab=nil,
        NormalSize=mainSize,
        Minimized=false,
        NotificationManager=NotificationManager.new(screenGui, cleanup),
    }, Window)

    -- Drag handling for main frame via dragBtn + floatingBtn
    local function enableDrag(handle, target, isFloating)
        local dragging=false; local dragStart, startPos
        local function update(inp)
            if not dragging then return end
            local delta = inp.Position - dragStart
            local newPos = UDim2.fromOffset(startPos.X.Offset+delta.X, startPos.Y.Offset+delta.Y)
            newPos = Utility:ClampUDim2(newPos, target.Size)
            target.Position=newPos
            if isFloating then selfObj._floatingPos=newPos end
        end
        handle.InputBegan:Connect(function(inp)
            if inp.UserInputType==Enum.UserInputType.MouseButton1 or inp.UserInputType==Enum.UserInputType.Touch then
                dragging=true; dragStart=inp.Position; startPos=target.Position
            end
        end)
        if UserInputService then
            cleanup:AddConnection(UserInputService.InputChanged:Connect(function(inp)
                if dragging and (inp.UserInputType==Enum.UserInputType.MouseMovement or inp.UserInputType==Enum.UserInputType.Touch) then update(inp) end
            end))
            cleanup:AddConnection(UserInputService.InputEnded:Connect(function(inp)
                if inp.UserInputType==Enum.UserInputType.MouseButton1 or inp.UserInputType==Enum.UserInputType.Touch then dragging=false end
            end))
        end
    end
    enableDrag(dragBtn, mainFrame, false)
    enableDrag(header, mainFrame, false)
    enableDrag(floatingBtn, floatingBtn, true)

    -- Hide / Show
    local function doHide()
        if not state:Can("HIDDEN") then return end
        state:Transition("HIDDEN")
        local tw = AnimationManager:Tween(mainFrame, {Size=UDim2.fromOffset(0,0), BackgroundTransparency=1}, 0.25)
        task.wait(0.25)
        mainFrame.Visible=false
        floatingBtn.Visible=true
        AnimationManager:Tween(floatingBtn, {Size=UDim2.fromOffset(52,52)},0.2)
    end
    local function doShow()
        if state:Get()~="HIDDEN" then return end
        floatingBtn.Visible=false
        mainFrame.Visible=true
        mainFrame.Size=UDim2.fromOffset(0,0)
        state:Transition("NORMAL")
        AnimationManager:Tween(mainFrame, {Size=selfObj.NormalSize, BackgroundTransparency=0},0.3)
    end
    hideBtn.MouseButton1Click:Connect(doHide)
    floatingBtn.MouseButton1Click:Connect(doShow)

    -- Minimize / Expand
    local function doMinimize()
        if not state:Can("MINIMIZED") then return end
        state:Transition("MINIMIZED")
        selfObj.NormalSize=mainFrame.Size
        navFrame.Visible=false; contentFrame.Visible=false
        AnimationManager:Tween(mainFrame, {Size=UDim2.new(mainFrame.Size.X.Scale, mainFrame.Size.X.Offset, 0, headerHeight)},0.25)
        minBtn.Text="+"
    end
    local function doExpand()
        if state:Get()~="MINIMIZED" then return end
        navFrame.Visible=true; contentFrame.Visible=true
        state:Transition("NORMAL")
        AnimationManager:Tween(mainFrame, {Size=selfObj.NormalSize},0.25)
        minBtn.Text="–"
    end
    minBtn.MouseButton1Click:Connect(function()
        if state:Get()=="MINIMIZED" then doExpand() else doMinimize() end
    end)

    -- Settings
    local settingsContent = nil
    local function openSettings()
        if state:Get()=="SETTINGS_OPEN" then
            -- close
            if settingsContent then settingsContent.Visible=false end
            if selfObj.PreviousTab then selfObj:SelectTab(selfObj.PreviousTab.Name) end
            state:Transition("NORMAL")
            settingsContent=nil
            return
        end
        if state:Get()=="MINIMIZED" then doExpand() task.wait(0.26) end
        if not state:Can("SETTINGS_OPEN") then return end
        selfObj.PreviousTab=selfObj.SelectedTab
        state:Transition("SETTINGS_OPEN", {returnTab=selfObj.PreviousTab})
        -- clear content visuals for settings
        for _,c in ipairs(contentFrame:GetChildren()) do if c:IsA("GuiObject") and c.Name~="UIListLayout" and c.Name~="UIPadding" then c.Visible=false end end
        settingsContent = Utility:Create("Frame", {Name="SettingsPage", Size=UDim2.new(1,0,0,0), AutomaticSize=Enum.AutomaticSize.Y, BackgroundTransparency=1, Parent=contentFrame})
        Utility:Create("UIListLayout", {Padding=UDim.new(0,8), Parent=settingsContent})
        -- Build settings UI
        local factory = ComponentFactory
        factory:CreateSection(settingsContent, {Name="Appearance"}, theme)
        factory:CreateDropdown(settingsContent, {Name="Theme", Options={"Dark","Light","AMOLED","Midnight","Dracula","Monokai","HighContrast"}, Default="Dark", Callback=function(v) ThemeManager:SetTheme(v) end}, theme, cleanup)
        factory:CreateToggle(settingsContent, {Name="Enable Animations", Default=true, Callback=function(v) AnimationManager:SetEnabled(v) end}, theme, cleanup)
        factory:CreateSlider(settingsContent, {Name="Animation Speed", Min=0.5, Max=2, Default=1, Increment=0.1, Callback=function(v) AnimationManager:SetSpeed(v) end}, theme, cleanup)
        factory:CreateButton(settingsContent, {Name="Reset Window Position", Callback=function() mainFrame.Position=UDim2.fromOffset(100,100) end}, theme, cleanup)
    end
    settingsBtn.MouseButton1Click:Connect(openSettings)

    -- Theme subscription
    ThemeManager:Subscribe(function(newTheme)
        mainFrame.BackgroundColor3=newTheme.Background
        header.BackgroundColor3=newTheme.Header
        headerFix.BackgroundColor3=newTheme.Header
        navFrame.BackgroundColor3=newTheme.Navigation
        contentFrame.BackgroundColor3=newTheme.SecondaryBackground
        titleLbl.TextColor3=newTheme.Text
        -- update existing components (best effort)
        for _,tab in pairs(selfObj.Tabs) do
            for _,comp in ipairs(tab._components or {}) do
                -- handled by token references if needed
            end
        end
    end)

    -- Window methods
    function selfObj:CreateTab(opts)
        opts=opts or {}
        local tabName = opts.Name or "Tab "..(#selfObj.Tabs+1)
        local tabBtn = Utility:Create("TextButton", {
            Name=tabName,
