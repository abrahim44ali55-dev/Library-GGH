	local increase = button(control, "+", UDim2.fromOffset(30, 30), UDim2.new(1, -30, 0.5, -15))
	local function setValue(nextValue, notify)
		local number = tonumber(nextValue)
		if not isFiniteNumber(number) then
			return false
		end
		value = clamp(number, minimum, maximum)
		display.Text = tostring(value)
		if notify then handle:Invoke(value) end
		return true
	end
	handle:_setValueMethods(function() return value end, setValue)
	handle:_connect(decrease.Activated, function() setValue(value - increment, true) end)
	handle:_connect(increase.Activated, function() setValue(value + increment, true) end)
	handle._applyTheme = function(theme)
		handle.TitleLabel.TextColor3 = theme.Text
		display.TextColor3 = theme.Text
		decrease.BackgroundColor3, increase.BackgroundColor3 = theme.ComponentBackground, theme.ComponentBackground
