        })
        Utility:RoundCorners(tabBtn,8)
        local tabContent = Utility:Create("Frame", {Name=tabName.."_Content", Size=UDim2.new(1,0,0,0), AutomaticSize=Enum.AutomaticSize.Y, BackgroundTransparency=1, Visible=false, Parent=contentFrame})
        Utility:Create("UIListLayout", {Padding=UDim.new(0,8), Parent=tabContent})

        local tabObj = {
            Name=tabName,
