	rounded(dot, 6)
	handle.Control.Visible = false
	local status = config.Status or "Success"
	local statusColors = { Success = "Success", Warning = "Warning", Error = "Error", Information = "Information" }
	local function setValue(nextValue, notify)
		status = tostring(nextValue)
		dot.BackgroundColor3 = self.window:_theme()[statusColors[status] or "Information"]
		if notify then handle:Invoke(status) end
	end
	handle:_setValueMethods(function() return status end, setValue)
	handle._applyTheme = function(theme)
		handle.TitleLabel.TextColor3 = theme.Text
		setValue(status)
	end
	return handle
end

function Tab:CreateSelectableCard(config)
