local function clamp(value, low, high)
	return math.max(low, math.min(high, value))
end

local function isFiniteNumber(value)
	return type(value) == "number" and value == value and value ~= math.huge and value ~= -math.huge
end

local function copyTable(source)
	local result = {}
	for key, value in pairs(source) do
		if type(value) == "table" then
			result[key] = copyTable(value)
		else
			result[key] = value
		end
	end
	return result
end

local function copyArray(source)
	local result = {}
	for index, value in ipairs(source) do
		result[index] = value
	end
	return result
end

local function make(className, parent, properties)
	local instance = Instance.new(className)
	for key, value in pairs(properties or {}) do
		instance[key] = value
	end
	instance.Parent = parent
	return instance
end

local function rounded(instance, radius)
	make("UICorner", instance, { CornerRadius = UDim.new(0, radius or 8) })
end

local function stroke(instance, color, thickness, transparency)
	return make("UIStroke", instance, {
		Color = color or DEFAULT_THEME.Border,
		Thickness = thickness or 1,
		Transparency = transparency or 0,
	})
end

local function label(parent, text, size, position, color, fontSize, properties)
	local props = {
		BackgroundTransparency = 1,
		Position = position or UDim2.new(),
		Size = size or UDim2.new(1, 0, 1, 0),
		Font = Enum.Font.Gotham,
		Text = text or "",
		TextColor3 = color or DEFAULT_THEME.Text,
		TextSize = fontSize or 13,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextYAlignment = Enum.TextYAlignment.Center,
	}
	for key, value in pairs(properties or {}) do
		props[key] = value
	end
	return make("TextLabel", parent, props)
end

local function button(parent, text, size, position)
	local result = make("TextButton", parent, {
		AutoButtonColor = false,
		BackgroundColor3 = DEFAULT_THEME.ComponentBackground,
		BorderSizePixel = 0,
		Position = position or UDim2.new(),
		Size = size or UDim2.new(1, 0, 1, 0),
		Font = Enum.Font.GothamMedium,
		Text = text or "",
		TextColor3 = DEFAULT_THEME.Text,
		TextSize = 12,
	})
	rounded(result, 7)
	return result
end

local function viewportSize()
	local camera = workspace.CurrentCamera
	if camera then
		return camera.ViewportSize
	end
	return Vector2.new(800, 600)
end

