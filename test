        -- Dropdown (Single & Multi-Select)
        local function CreateDropdown(Cfg)
            Cfg = Cfg or {}
            local isMulti = Cfg.Multi or Cfg.MultiSelect or Cfg.Multiple or false
            Cfg.Options = Cfg.Options or {}
            local Selected = Cfg.Default or (isMulti and {} or Cfg.Options[1])

            local Frame = Instance.new("Frame", TabPage)
            Frame.Size = UDim2.new(1, -4, 0, 38)
            Frame.BackgroundColor3 = CurrentTheme.ElementBg
            Frame.ClipsDescendants = true
            Corner(Frame, 8)
            Stroke(Frame, CurrentTheme.Stroke, 1, 0.6)
            AddSearch(Frame, Cfg.Title or "Dropdown", "Dropdown", Name)

            local function GetTitleText()
                if isMulti then
                    if type(Selected) ~= "table" then Selected = {Selected} end
                    if #Selected == 0 then return (Cfg.Title or "Dropdown") .. ": (None)" end
                    return (Cfg.Title or "Dropdown") .. ": " .. #Selected .. " selected"
                else
                    return (Cfg.Title or "Dropdown") .. ": " .. tostring(Selected or "None")
                end
            end

            local HeaderBtn = Instance.new("TextButton", Frame)
            HeaderBtn.Size = UDim2.new(1, 0, 0, 38)
            HeaderBtn.BackgroundTransparency = 1
            HeaderBtn.Text = GetTitleText()
            HeaderBtn.Font = Enum.Font.GothamMedium
            HeaderBtn.TextSize = 12
            HeaderBtn.TextColor3 = CurrentTheme.Text
            HeaderBtn.TextXAlignment = Enum.TextXAlignment.Left

            local padH = Instance.new("UIPadding", HeaderBtn)
            padH.PaddingLeft = UDim.new(0, 12)

            local Chev = MakeIcon(HeaderBtn, "chevron-down", 14, CurrentTheme.SubText)
            Chev.AnchorPoint = Vector2.new(1, 0.5)
            Chev.Position = UDim2.new(1, -12, 0.5, 0)

            local List = Instance.new("ScrollingFrame", Frame)
            List.Position = UDim2.new(0, 6, 0, 40)
            List.Size = UDim2.new(1, -12, 0, 0)
            List.BackgroundTransparency = 1
            List.ScrollBarThickness = 3
            List.ScrollBarImageColor3 = CurrentTheme.Accent
            List.CanvasSize = UDim2.new(0, 0, 0, 0)
            List.AutomaticCanvasSize = Enum.AutomaticSize.Y

            local LLayout = Instance.new("UIListLayout", List)
            LLayout.Padding = UDim.new(0, 3)

            local open = false
            local function RefreshDisplay()
                HeaderBtn.Text = GetTitleText()
            end

            local function Populate()
                for _, ch in ipairs(List:GetChildren()) do
                    if ch:IsA("TextButton") then ch:Destroy() end
                end
                for _, opt in ipairs(Cfg.Options) do
                    local b = Instance.new("TextButton", List)
                    b.Size = UDim2.new(1, 0, 0, 28)
                    b.BackgroundColor3 = CurrentTheme.ElementBg2
                    b.Text = opt
                    b.Font = Enum.Font.Gotham
                    b.TextSize = 11
                    b.TextColor3 = CurrentTheme.Text
                    Corner(b, 6)

                    local isSel = false
                    if isMulti then
                        for _, s in ipairs(Selected) do if s == opt then isSel = true break end end
                    else
                        isSel = (Selected == opt)
                    end
                    if isSel then b.BackgroundColor3 = CurrentTheme.Accent end

                    b.MouseButton1Click:Connect(function()
                        if isMulti then
                            local found = false
                            for i, s in ipairs(Selected) do
                                if s == opt then
                                    table.remove(Selected, i)
                                    found = true
                                    break
                                end
                            end
                            if not found then table.insert(Selected, opt) end
                            Populate()
                            pcall(Cfg.Callback or function() end, Selected)
                        else
                            Selected = opt
                            open = false
                            Tween(Frame, {Size = UDim2.new(1, -4, 0, 38)}, 0.18)
                            Tween(Chev, {Rotation = 0}, 0.18)
                            Populate()
                            pcall(Cfg.Callback or function() end, Selected)
                        end
                        RefreshDisplay()
                        SaveMgr.MarkDirty()
                    end)
                end
            end

            HeaderBtn.MouseButton1Click:Connect(function()
                open = not open
                if open then
                    local h = math.clamp(#Cfg.Options * 31, 35, 170)
                    List.Size = UDim2.new(1, -12, 0, h)
                    Tween(Frame, {Size = UDim2.new(1, -4, 0, 44 + h)}, 0.2)
                    Tween(Chev, {Rotation = 180}, 0.2)
                else
                    Tween(Frame, {Size = UDim2.new(1, -4, 0, 38)}, 0.18)
                    Tween(Chev, {Rotation = 0}, 0.18)
                end
            end)

            Populate()

            local api = {}
            function api:Set(val)
                Selected = val
                RefreshDisplay()
                Populate()
                SaveMgr.MarkDirty()
                return api
            end
            function api:Get() return Selected end
            function api:Refresh(newOpts)
                if newOpts and type(newOpts) == "table" then Cfg.Options = newOpts end
                Populate()
                return api
            end
            return api
        end

