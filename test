        -- Slider
        local function CreateSlider(Cfg)
            Cfg = Cfg or {}
            local minVal = Cfg.Min or 0
            local maxVal = Cfg.Max or 100
            local decimals = Cfg.Decimals or (Cfg.Float and 2 or 0)
            local inc = Cfg.Increment or (decimals > 0 and 0.1 or 1)
            local val = math.clamp(Cfg.Default or minVal, minVal, maxVal)

            local Frame = Instance.new("Frame", TabPage)
            Frame.Size = UDim2.new(1, -4, 0, 56)
            Frame.BackgroundColor3 = CurrentTheme.ElementBg
            Corner(Frame, 8)
            Stroke(Frame, CurrentTheme.Stroke, 1, 0.6)
            AddSearch(Frame, Cfg.Title or "Slider", "Slider", Name)

            local Label = Instance.new("TextLabel", Frame)
            Label.Size = UDim2.new(1, -16, 0, 20)
            Label.Position = UDim2.new(0, 10, 0, 6)
            Label.BackgroundTransparency = 1
            Label.TextXAlignment = Enum.TextXAlignment.Left
            Label.Font = Enum.Font.GothamMedium
            Label.TextSize = 12
            Label.TextColor3 = CurrentTheme.Text
            Label.Text = (Cfg.Title or "Slider") .. ": " .. string.format("%." .. decimals .. "f", val)

            local Bar = Instance.new("Frame", Frame)
            Bar.Size = UDim2.new(1, -20, 0, 6)
            Bar.Position = UDim2.new(0, 10, 0, 34)
            Bar.BackgroundColor3 = CurrentTheme.ElementBg2
            Corner(Bar, 3)

            local rel = math.clamp((val - minVal) / math.max(1, (maxVal - minVal)), 0, 1)
            local Fill = Instance.new("Frame", Bar)
            Fill.Size = UDim2.new(rel, 0, 1, 0)
            Fill.BackgroundColor3 = CurrentTheme.Accent
            Corner(Fill, 3)

            local Circle = Instance.new("Frame", Bar)
            Circle.Size = UDim2.fromOffset(16, 16)
            Circle.AnchorPoint = Vector2.new(0.5, 0.5)
            Circle.Position = UDim2.new(rel, 0, 0.5, 0)
            Circle.BackgroundColor3 = Color3.new(1, 1, 1)
            Corner(Circle, 8)
            Stroke(Circle, CurrentTheme.Accent, 2)

            local DragArea = Instance.new("TextButton", Bar)
            DragArea.Size = UDim2.new(1, 0, 3, 0)
            DragArea.Position = UDim2.new(0, 0, 0.5, -10)
            DragArea.BackgroundTransparency = 1
            DragArea.Text = ""

            local dragging = false
            local function Update(posX)
                local bPos = Bar.AbsolutePosition.X
                local bSize = Bar.AbsoluteSize.X
                if bSize <= 0 then return end
                local r = math.clamp((posX - bPos) / bSize, 0, 1)
                local rawVal = minVal + (maxVal - minVal) * r
                if inc > 0 then
                    rawVal = math.floor(rawVal / inc + 0.5) * inc
                end
                val = math.clamp(rawVal, minVal, maxVal)
                local newR = math.clamp((val - minVal) / math.max(1, (maxVal - minVal)), 0, 1)
                Fill.Size = UDim2.new(newR, 0, 1, 0)
                Circle.Position = UDim2.new(newR, 0, 0.5, 0)
                Label.Text = (Cfg.Title or "Slider") .. ": " .. string.format("%." .. decimals .. "f", val)
                pcall(Cfg.Callback or function() end, val)
                SaveMgr.MarkDirty()
            end

            DragArea.InputBegan:Connect(function(i)
                if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
                    dragging = true
                    Update(i.Position.X)
                end
            end)

            UserInputService.InputChanged:Connect(function(i)
                if dragging and (i.UserInputType == Enum.UserInputType.MouseMovement or i.UserInputType == Enum.UserInputType.Touch) then
                    Update(i.Position.X)
                end
            end)

            UserInputService.InputEnded:Connect(function(i)
                if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
                    dragging = false
                end
            end)

            local api = {}
            function api:SetValue(v)
                val = math.clamp(v, minVal, maxVal)
                local newR = math.clamp((val - minVal) / math.max(1, (maxVal - minVal)), 0, 1)
                Fill.Size = UDim2.new(newR, 0, 1, 0)
                Circle.Position = UDim2.new(newR, 0, 0.5, 0)
                Label.Text = (Cfg.Title or "Slider") .. ": " .. string.format("%." .. decimals .. "f", val)
                pcall(Cfg.Callback or function() end, val)
                SaveMgr.MarkDirty()
                return api
            end
            function api:GetValue() return val end
            function api:Refresh(newCfg)
                if newCfg and newCfg.Default then api:SetValue(newCfg.Default) end
                return api
            end
            return api
        end

