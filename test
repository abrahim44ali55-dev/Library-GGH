    img.Image = ResolveIcon(icon) or ""
    img.ImageColor3 = color or Color3.new(1, 1, 1)
    img.ScaleType = Enum.ScaleType.Fit
    img.Parent = parent
    return img
end

local function BindIconToText(btn, img)
