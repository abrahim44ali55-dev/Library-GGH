    -- Window Dragging & Screen Clamping
    do
        local dragging = false
        local potentialDrag = false
        local dragStart, startPos
        local DRAG_THRESHOLD = 6
        local dragObjects = {Header, TitleLabel, SubLabel, HeaderFix}

        local function StartDrag(input)
            if ScreenGui:FindFirstChild("GGH_ColorPicker_Overlay") then return end
            if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                potentialDrag = true
                dragging = false
                dragStart = input.Position
                startPos = Main.Position
            end
        end

        for _, obj in ipairs(dragObjects) do obj.InputBegan:Connect(StartDrag) end

        UserInputService.InputChanged:Connect(function(input)
            if potentialDrag and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
                local delta = input.Position - dragStart
                if not dragging and delta.Magnitude >= DRAG_THRESHOLD then dragging = true end
                if dragging then
                    local newX = startPos.X.Offset + delta.X
                    local newY = startPos.Y.Offset + delta.Y
                    local viewportSize = ScreenGui.AbsoluteSize
                    local frameSize = Main.AbsoluteSize
                    local clampedX = math.clamp(newX, 4, math.max(4, viewportSize.X - frameSize.X - 4))
                    local clampedY = math.clamp(newY, 4, math.max(4, viewportSize.Y - frameSize.Y - 4))
                    Main.Position = UDim2.fromOffset(clampedX, clampedY)
                end
            end
        end)

        UserInputService.InputEnded:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                dragging = false
                potentialDrag = false
            end
        end)
    end

