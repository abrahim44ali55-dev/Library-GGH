-- core_engine.lua: Engine implementation for GGH UI Library Premium

GGH.Icons = GGH_ICONS

local function ResolveIcon(v)
    if v == nil or v == "" or v == false then return nil end
    if typeof(v) == "number" then return "rbxassetid://" .. tostring(math.floor(v)) end
    local s = tostring(v)
    if GGH_ICONS[s] then return GGH_ICONS[s] end
    local norm = s:lower()
    norm = norm:gsub("^lucide[:/]", "")
    norm = norm:gsub("[_%s]+", "-")
    if GGH_ICONS[norm] then return GGH_ICONS[norm] end
    if s:match("^rbxassetid://%d+$") or s:match("^rbxasset://") or s:match("^https?://") then return s end
    local id = s:match("^(%d+)$") or s:match("id=(%d+)") or s:match("rbxassetid://(%d+)")
    if id then return "rbxassetid://" .. id end
    return nil
end
GGH.ResolveIcon = ResolveIcon

function GGH:GetIcon(name) return ResolveIcon(name) end
function GGH:HasIcon(name) return GGH_ICONS[tostring(name)] ~= nil end
function GGH:ListIcons()
    local t = {}
    for k in pairs(GGH_ICONS) do table.insert(t, k) end
    table.sort(t)
    return t
end
function GGH:SearchIcons(query)
    query = tostring(query or ""):lower()
    local t = {}
    for k in pairs(GGH_ICONS) do
        if query == "" or string.find(k, query, 1, true) then table.insert(t, k) end
    end
    table.sort(t)
    return t
end

local function MakeIcon(parent, icon, size, color)
    local img = Instance.new("ImageLabel")
    img.Name = "Icon"
