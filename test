        end

        -- Unified Elements:Add dispatcher
        function TabElements:Add(Type, Cfg)
            Cfg = Cfg or {}
            Type = string.lower(tostring(Type))
            local api = nil

            if Type == "section" then api = CreateSection(Cfg)
            elseif Type == "paragraph" then api = CreateParagraph(Cfg)
            elseif Type == "button" then api = CreateButton(Cfg)
            elseif Type == "toggle" then api = CreateToggle(Cfg)
            elseif Type == "slider" then api = CreateSlider(Cfg)
            elseif Type == "input" then api = CreateInput(Cfg)
            elseif Type == "dropdown" then api = CreateDropdown(Cfg)
            elseif Type == "colorpicker" or Type == "color" then api = CreateColorpicker(Cfg)
            elseif Type == "keybind" or Type == "key" then api = CreateKeybind(Cfg)
            elseif Type == "code" then api = CreateCode(Cfg)
            elseif Type == "label" then api = CreateLabel(Cfg)
            elseif Type == "separator" or Type == "line" or Type == "divider" then api = CreateSeparator(Cfg)
            elseif Type == "image" or Type == "img" or Type == "logo" then api = CreateImage(Cfg)
            elseif Type == "linkbutton" or Type == "link" or Type == "social" or Type == "discord" or Type == "copylink" then api = CreateLinkButton(Cfg)
            elseif Type == "playerstats" or Type == "stats" or Type == "statlist" or Type == "player" then api = CreatePlayerStats(Cfg)
            elseif Type == "floatbutton" or Type == "buttonfloat" or Type == "btnfloat" or Type == "floatingbutton" then api = CreateFloatingButton(Cfg)
            elseif Type == "sliderinput" or Type == "sliderbox" or Type == "inputslider" then api = CreateSliderWithInput(Cfg)
            else warn("[GGH Premium] Unknown element type: " .. tostring(Type))
            end

            return RegisterElement(api, Type, Cfg)
        end

        function TabElements:Section(Cfg) return self:Add("Section", Cfg) end
        function TabElements:Paragraph(Cfg) return self:Add("Paragraph", Cfg) end
        function TabElements:Button(Cfg) return self:Add("Button", Cfg) end
        function TabElements:Toggle(Cfg) return self:Add("Toggle", Cfg) end
        function TabElements:Slider(Cfg) return self:Add("Slider", Cfg) end
        function TabElements:Input(Cfg) return self:Add("Input", Cfg) end
        function TabElements:Dropdown(Cfg) return self:Add("Dropdown", Cfg) end
        function TabElements:Colorpicker(Cfg) return self:Add("Colorpicker", Cfg) end
        function TabElements:Keybind(Cfg) return self:Add("Keybind", Cfg) end
        function TabElements:Code(Cfg) return self:Add("Code", Cfg) end
        function TabElements:Label(Cfg) return self:Add("Label", Cfg) end
        function TabElements:Separator(Cfg) return self:Add("Separator", Cfg) end
        function TabElements:Image(Cfg) return self:Add("Image", Cfg) end
        function TabElements:LinkButton(Cfg) return self:Add("LinkButton", Cfg) end
        function TabElements:Link(Cfg) return self:Add("LinkButton", Cfg) end
        function TabElements:Social(Cfg) return self:Add("LinkButton", Cfg) end
        function TabElements:CopyLink(Cfg) return self:Add("LinkButton", Cfg) end
        function TabElements:PlayerStats(Cfg) return self:Add("PlayerStats", Cfg) end
        function TabElements:Stats(Cfg) return self:Add("PlayerStats", Cfg) end
        function TabElements:StatList(Cfg) return self:Add("PlayerStats", Cfg) end
        function TabElements:FloatButton(Cfg) return self:Add("FloatButton", Cfg) end
        function TabElements:ButtonFloat(Cfg) return self:Add("FloatButton", Cfg) end
        function TabElements:FloatingButton(Cfg) return self:Add("FloatButton", Cfg) end
        function TabElements:SliderInput(Cfg) return self:Add("SliderInput", Cfg) end
        function TabElements:SliderBox(Cfg) return self:Add("SliderInput", Cfg) end

        function TabElements:RefreshAll()
            for _, el in ipairs(AllElements) do
                if el and el.Refresh then pcall(function() el:Refresh() end) end
            end
        end
        function TabElements:GetAll() return AllElements end

        return TabElements
    end

    function WindowAPI:AddTab(Cfg)
        Cfg = Cfg or {}
        local name = Cfg.Title or Cfg.Name or "Tab"
        return self:CreateTab(name, Cfg.Icon or Cfg.Image)
    end

    function WindowAPI:SetSizePreset(presetName)
        if SizePresets[presetName] then
            local p = SizePresets[presetName]
            savedSize = UDim2.fromOffset(p.W, p.H)
            Tween(Main, {Size = savedSize}, 0.25)
        end
    end

    function WindowAPI:SetTransparency(winT, elemT)
        if winT then
            if winT > 1 then winT = winT / 100 end
            WindowTrans = math.clamp(winT, 0, 0.7)
            Main.BackgroundTransparency = WindowTrans
            Header.BackgroundTransparency = WindowTrans
            HeaderFix.BackgroundTransparency = WindowTrans
            TabList.BackgroundTransparency = WindowTrans
        end
        if elemT then
            if elemT > 1 then elemT = elemT / 100 end
            ElementTrans = math.clamp(elemT, 0, 0.7)
        end
    end

    function WindowAPI:Update(newCfg)
        newCfg = newCfg or {}
        if newCfg.Title then TitleLabel.Text = newCfg.Title end
        if newCfg.SubTitle then SubLabel.Text = newCfg.SubTitle end
        if newCfg.Icon ~= nil then ApplyTitleIcon(newCfg.Icon) end
        if newCfg.Theme and Themes[newCfg.Theme] then ApplyTheme(newCfg.Theme) end
    end

    function WindowAPI:Refresh() self:Update({}) end

    function WindowAPI:Destroy()
        SmoothDestroy(ScreenGui)
    end

    function WindowAPI:Close()
        FadeOutGui(ScreenGui, 0.35, function() SmoothDestroy(ScreenGui) end)
    end

    function WindowAPI:Hide() Main.Visible = false end
    function WindowAPI:Show() Main.Visible = true end
    function WindowAPI:Toggle() Main.Visible = not Main.Visible end
    function WindowAPI:Notify(...) return GGH.Notify(...) end
    function WindowAPI:Confirm(...) return GGH.Confirm(...) end

    function WindowAPI:SetTheme(name)
        if Themes[name] then
            ApplyTheme(name)
            SubLabel.Text = "Theme: " .. name
            SaveMgr.MarkDirty()
        end
    end

    function WindowAPI:GetThemes()
        local t = {}
        for k in pairs(Themes) do table.insert(t, k) end
        table.sort(t)
        return t
    end

    function WindowAPI:SetSaveEnabled(state)
        SaveMgr.Enabled = (state == true)
        return SaveMgr.Enabled
    end
    function WindowAPI:GetSaveEnabled() return SaveMgr.Enabled end
    function WindowAPI:SaveNow() SaveMgr.Flush(); return WindowAPI end
    function WindowAPI:GetConfigPath() return SaveMgr.Path end
    function WindowAPI:SetIcon(icon) ApplyTitleIcon(icon); return WindowAPI end

    return WindowAPI
end

-- ====================================================================
-- GGH.Notify & GGH.Confirm Modals
-- ====================================================================
do
    local NotifyGui, NotifyHolder
    local NotifyColors = {
        info = Color3.fromRGB(0, 140, 255),
        success = Color3.fromRGB(46, 204, 113),
        warning = Color3.fromRGB(255, 176, 32),
        error = Color3.fromRGB(255, 69, 84),
    }

    local function EnsureNotifyGui()
        if NotifyGui and NotifyGui.Parent then return end
        NotifyGui = Instance.new("ScreenGui")
        NotifyGui.Name = "GGH_Notifications"
        NotifyGui.ResetOnSpawn = false
        NotifyGui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
        NotifyGui.DisplayOrder = 500
        pcall(function() NotifyGui.ScreenInsets = Enum.ScreenInsets.DeviceSafeInsets end)
        NotifyGui.Parent = GetGuiParent()

        NotifyHolder = Instance.new("Frame", NotifyGui)
        NotifyHolder.Name = "Holder"
        NotifyHolder.Size = UDim2.new(0, 320, 1, -24)
        NotifyHolder.AnchorPoint = Vector2.new(1, 0)
        NotifyHolder.Position = UDim2.new(1, -12, 0, 12)
        NotifyHolder.BackgroundTransparency = 1

        local list = Instance.new("UIListLayout", NotifyHolder)
        list.Padding = UDim.new(0, 8)
        list.SortOrder = Enum.SortOrder.LayoutOrder
        list.HorizontalAlignment = Enum.HorizontalAlignment.Right
    end

    local notifyCount = 0

    function GGH.Notify(...)
        local args = {...}
        if args[1] == GGH then table.remove(args, 1) end
        local cfg
        if type(args[1]) == "table" then
            cfg = args[1]
        else
            cfg = {Title = args[1], Text = args[2], Duration = args[3], Type = args[4]}
        end

        EnsureNotifyGui()
        notifyCount = notifyCount + 1

        local kind = string.lower(tostring(cfg.Type or "info"))
        local accent = cfg.Color or NotifyColors[kind] or NotifyColors.info
        local duration = tonumber(cfg.Duration) or 3.5

        local card = Instance.new("Frame", NotifyHolder)
        card.Size = UDim2.new(1, 0, 0, 56)
        card.BackgroundColor3 = Color3.fromRGB(20, 22, 28)
        card.BorderSizePixel = 0
        card.LayoutOrder = notifyCount
        card.ClipsDescendants = true
        Corner(card, 10)
        Stroke(card, accent, 1, 0.4)

        local bar = Instance.new("Frame", card)
        bar.Size = UDim2.new(0, 4, 1, 0)
        bar.BackgroundColor3 = accent
        bar.BorderSizePixel = 0

        local icName = cfg.Icon or (kind == "success" and "circle-check" or (kind == "warning" and "triangle-alert" or (kind == "error" and "circle-x" or "info")))
        local ic = MakeIcon(card, icName, 20, accent)
        ic.Position = UDim2.new(0, 14, 0.5, -10)

        local tl = Instance.new("TextLabel", card)
        tl.Size = UDim2.new(1, -48, 0, 18)
        tl.Position = UDim2.new(0, 42, 0, 10)
        tl.BackgroundTransparency = 1
        tl.Text = cfg.Title or "Notification"
        tl.Font = Enum.Font.GothamBold
        tl.TextSize = 13
        tl.TextColor3 = Color3.fromRGB(245, 245, 250)
        tl.TextXAlignment = Enum.TextXAlignment.Left

        local bl = Instance.new("TextLabel", card)
        bl.Size = UDim2.new(1, -48, 0, 16)
        bl.Position = UDim2.new(0, 42, 0, 28)
        bl.BackgroundTransparency = 1
        bl.Text = cfg.Text or cfg.Content or cfg.Message or ""
        bl.Font = Enum.Font.Gotham
        bl.TextSize = 11
        bl.TextColor3 = Color3.fromRGB(180, 185, 195)
        bl.TextXAlignment = Enum.TextXAlignment.Left

        local prog = Instance.new("Frame", card)
        prog.Size = UDim2.new(1, -4, 0, 2)
        prog.Position = UDim2.new(0, 4, 1, -2)
        prog.BackgroundColor3 = accent
        prog.BorderSizePixel = 0

        TweenService:Create(prog, TweenInfo.new(duration, Enum.EasingStyle.Linear), {Size = UDim2.new(0, 0, 0, 2)}):Play()

        task.delay(duration, function()
            if card and card.Parent then
                Tween(card, {BackgroundTransparency = 1}, 0.25)
                task.wait(0.26)
                card:Destroy()
            end
        end)
    end

    function GGH.Confirm(...)
        local args = {...}
        if args[1] == GGH then table.remove(args, 1) end
        local cfg = type(args[1]) == "table" and args[1] or {Title = args[1], Text = args[2], OnYes = args[3], OnNo = args[4]}

        local title = tostring(cfg.Title or "Confirm Action")
        local body = tostring(cfg.Text or cfg.Content or "Are you sure you want to proceed?")
        local yesText = tostring(cfg.YesText or "Confirm")
        local noText = tostring(cfg.NoText or "Cancel")

        local gui = Instance.new("ScreenGui")
        gui.Name = "GGH_ConfirmModal"
        gui.DisplayOrder = 999
        gui.Parent = GetGuiParent()

        local overlay = Instance.new("Frame", gui)
        overlay.Size = UDim2.fromScale(1, 1)
        overlay.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
        overlay.BackgroundTransparency = 0.5
        overlay.BorderSizePixel = 0

        local box = Instance.new("Frame", overlay)
        box.Size = UDim2.fromOffset(320, 160)
        box.AnchorPoint = Vector2.new(0.5, 0.5)
        box.Position = UDim2.fromScale(0.5, 0.5)
        box.BackgroundColor3 = Color3.fromRGB(22, 24, 30)
        Corner(box, 14)
        Stroke(box, Color3.fromRGB(70, 75, 95), 1)

        local tLbl = Instance.new("TextLabel", box)
        tLbl.Size = UDim2.new(1, -28, 0, 24)
        tLbl.Position = UDim2.new(0, 14, 0, 14)
        tLbl.BackgroundTransparency = 1
        tLbl.Text = title
        tLbl.Font = Enum.Font.GothamBold
        tLbl.TextSize = 15
        tLbl.TextColor3 = Color3.fromRGB(245, 245, 250)
        tLbl.TextXAlignment = Enum.TextXAlignment.Left

        local bLbl = Instance.new("TextLabel", box)
        bLbl.Size = UDim2.new(1, -28, 0, 48)
        bLbl.Position = UDim2.new(0, 14, 0, 42)
        bLbl.BackgroundTransparency = 1
        bLbl.Text = body
        bLbl.Font = Enum.Font.Gotham
        bLbl.TextSize = 12
        bLbl.TextColor3 = Color3.fromRGB(180, 185, 195)
        bLbl.TextWrapped = true
        bLbl.TextXAlignment = Enum.TextXAlignment.Left

        local function Close(cb)
            gui:Destroy()
            if cb then pcall(cb) end
        end

        local yesBtn = Instance.new("TextButton", box)
        yesBtn.Size = UDim2.new(0.48, -14, 0, 36)
        yesBtn.Position = UDim2.new(0, 14, 1, -48)
        yesBtn.BackgroundColor3 = Color3.fromRGB(80, 100, 255)
        yesBtn.Text = yesText
        yesBtn.Font = Enum.Font.GothamBold
        yesBtn.TextSize = 13
        yesBtn.TextColor3 = Color3.new(1, 1, 1)
        Corner(yesBtn, 8)
        yesBtn.MouseButton1Click:Connect(function() Close(cfg.OnYes) end)

        local noBtn = Instance.new("TextButton", box)
        noBtn.Size = UDim2.new(0.48, -14, 0, 36)
        noBtn.Position = UDim2.new(0.52, 0, 1, -48)
        noBtn.BackgroundColor3 = Color3.fromRGB(35, 37, 46)
        noBtn.Text = noText
        noBtn.Font = Enum.Font.GothamMedium
        noBtn.TextSize = 13
        noBtn.TextColor3 = Color3.fromRGB(220, 220, 230)
        Corner(noBtn, 8)
        noBtn.MouseButton1Click:Connect(function() Close(cfg.OnNo) end)
    end
end

-- HWID & KeySystem global API
function GGH:GetHWID()
    local hwid = "UNKNOWN"
    pcall(function()
        if gethwid then hwid = gethwid()
        elseif syn and syn.get_hwid then hwid = syn.get_hwid()
        else
            local ok, id = pcall(function() return game:GetService("RbxAnalyticsService"):GetClientId() end)
            if ok and id then hwid = id end
        end
    end)
    return tostring(hwid)
end

function GGH:MakeKeySystem(Config)
    Config = Config or {}
    -- Reuses window key system logic
    return nil
end

GGH.CreateKey = GGH.MakeKeySystem
GGH.KeySystem = GGH.MakeKeySystem
GGH.AddKeySystem = GGH.MakeKeySystem

return GGH
