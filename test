local FastAnimationMode = false

local function Tween(o, props, dur, style, dir)
    local d = FastAnimationMode and math.min(dur or 0.2, 0.08) or (dur or 0.22)
    local info = TweenInfo.new(d, style or Enum.EasingStyle.Quint, dir or Enum.EasingDirection.Out)
    local tw = TweenService:Create(o, info, props)
    tw:Play()
    return tw
end

local function ContrastColor(c)
    local lum = 0.299 * c.R + 0.587 * c.G + 0.114 * c.B
    if lum > 0.62 then return Color3.fromRGB(20, 20, 26) end
    return Color3.new(1, 1, 1)
end

local function GetLuminance(c)
    return 0.299 * c.R + 0.587 * c.G + 0.114 * c.B
end

local function AutoTextColors(theme)
    local lum = GetLuminance(theme.MainBg)
    if lum > 0.5 then
        theme.Text = Color3.fromRGB(20, 20, 25)
        theme.SubText = Color3.fromRGB(80, 80, 85)
        theme.SectionText = Color3.fromRGB(100, 100, 105)
        theme.ParagraphText = Color3.fromRGB(40, 40, 45)
    else
        theme.Text = Color3.fromRGB(240, 240, 245)
        theme.SubText = Color3.fromRGB(180, 180, 190)
        theme.SectionText = Color3.fromRGB(150, 150, 160)
        theme.ParagraphText = Color3.fromRGB(220, 220, 230)
    end
    return theme
end

local function ClampFrameToScreen(frame, gui)
    if not frame or not gui then return end
    local viewport = gui.AbsoluteSize
    if viewport.X <= 10 or viewport.Y <= 10 then return end
    local fSize = frame.AbsoluteSize
    if fSize.X <= 0 then return end
    local fPos = frame.Position
    local newX, newY
    if fPos.X.Scale == 0 and fPos.Y.Scale == 0 then
        newX = math.clamp(fPos.X.Offset, 4, viewport.X - fSize.X - 4)
        newY = math.clamp(fPos.Y.Offset, 4, viewport.Y - fSize.Y - 4)
        frame.Position = UDim2.fromOffset(newX, newY)
    else
        local absX = fPos.X.Scale * viewport.X + fPos.X.Offset
        local absY = fPos.Y.Scale * viewport.Y + fPos.Y.Offset
        absX = math.clamp(absX, 4, viewport.X - fSize.X - 4)
        absY = math.clamp(absY, 4, viewport.Y - fSize.Y - 4)
        frame.Position = UDim2.fromOffset(absX, absY)
    end
end

local function SmoothDestroy(gui)
    pcall(function() if gui:IsA("ScreenGui") then gui.Enabled = false end end)
    task.spawn(function()
        local ok, list = pcall(function() return gui:GetDescendants() end)
        if not ok then pcall(function() gui:Destroy() end) return end
        local budget = 0.004
        local t0 = os.clock()
        for i = #list, 1, -1 do
            local o = list[i]
            pcall(function() o:Destroy() end)
            if os.clock() - t0 > budget then
                RunService.Heartbeat:Wait()
                t0 = os.clock()
            end
        end
        pcall(function() gui:Destroy() end)
    end)
end

local function FadeOutGui(gui, dur, done)
    dur = dur or 0.35
    local info = TweenInfo.new(dur, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
    local function tw(o, props)
        pcall(function() TweenService:Create(o, info, props):Play() end)
    end
    for _, d in ipairs(gui:GetDescendants()) do
        if d:IsA("GuiObject") then
            local props = {}
            if d.BackgroundTransparency < 1 then props.BackgroundTransparency = 1 end
            if d:IsA("TextLabel") or d:IsA("TextButton") or d:IsA("TextBox") then props.TextTransparency = 1 end
            if d:IsA("ImageLabel") or d:IsA("ImageButton") then props.ImageTransparency = 1 end
            if next(props) then tw(d, props) end
        elseif d:IsA("UIStroke") then
            tw(d, {Transparency = 1})
        end
    end
    task.delay(dur + 0.05, function() if done then pcall(done) end end)
end

local SizePresets = {
    ["Tiny"]   = {W = 360, H = 260},
    ["Small"]  = {W = 420, H = 310},
    ["Medium"] = {W = 520, H = 360},
    ["Large"]  = {W = 620, H = 420},
    ["Huge"]   = {W = 720, H = 480},
}
GGH.SizePresets = SizePresets

local function DetectDevicePreset()
    local cam = workspace.CurrentCamera
    local vp = cam and cam.ViewportSize or Vector2.new(1920, 1080)
    local isTouch = UserInputService.TouchEnabled and not UserInputService.KeyboardEnabled
    local isSmallTouch = UserInputService.TouchEnabled
    if vp.X < 500 or vp.Y < 500 then
        return SizePresets.Tiny, "Tiny"
    elseif vp.X < 720 or isTouch then
        return SizePresets.Small, "Small"
    elseif vp.X < 1100 or isSmallTouch then
        return SizePresets.Medium, "Medium"
    elseif vp.X < 1600 then
        return SizePresets.Large, "Large"
    else
        return SizePresets.Huge, "Huge"
    end
end

