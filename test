    local function WriteFile(payload)
        if not SaveMgr.CanWrite then return false end
        local ok = pcall(function()
            if type(isfolder) == "function" and type(makefolder) == "function" and not isfolder(SaveMgr.Folder) then
                makefolder(SaveMgr.Folder)
            end
            writefile(SaveMgr.Path, HttpService:JSONEncode(payload))
        end)
        return ok
    end

    function SaveMgr.Flush()
        if not SaveMgr.Enabled or not SaveMgr.CanWrite then return end
        local merged = {}
        for k, v in pairs(SaveMgr.Stored) do merged[k] = v end
        for key, entry in pairs(SaveMgr.Registry) do
            if entry.applied then
                local ok, v = pcall(entry.get)
                if ok and v ~= nil then merged[key] = v end
            end
        end
        SaveMgr.Stored = merged
        WriteFile({Version = 2, SaveEnabled = true, Theme = CurrentThemeName, Elements = merged})
        SaveStatusBadge.Text = "Settings Saved Successfully ✓ (" .. os.date("%X") .. ")"
        SaveStatusBadge.TextColor3 = Color3.fromRGB(80, 220, 120)
    end

    local scheduled = false
    function SaveMgr.MarkDirty()
        if not SaveMgr.Enabled or not SaveMgr.CanWrite or scheduled then return end
        scheduled = true
        SaveStatusBadge.Text = "Pending Changes..."
        SaveStatusBadge.TextColor3 = Color3.fromRGB(255, 180, 60)
        task.delay(0.6, function()
            scheduled = false
            SaveMgr.Flush()
        end)
    end

