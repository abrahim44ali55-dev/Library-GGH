            if SaveKey and writefile then pcall(function() writefile(KeyFile, KeyBox.Text) end) end
            CreateTween({Main, "Size", UDim2.fromOffset(0,0), 0.3})
            task.wait(0.3) Blur:Destroy() ScreenGui:Destroy() pcall(Callback)
        else
            Status.Text="Invalid Key!" Status.TextColor3=Color3.fromRGB(255,80,80)
            local orig=Main.Position for i=1,4 do Main.Position=orig+UDim2.fromOffset(6,0) task.wait(0.04) Main.Position=orig+UDim2.fromOffset(-6,0) task.wait(0.04) end Main.Position=orig
        end
    end)
    GetBtn.MouseButton1Click:Connect(function() if setclipboard then setclipboard(KeyLink) Status.Text="Link Copied! ✓" Status.TextColor3=Color3.fromRGB(0,200,255) end end)
    CopyBtn.MouseButton1Click:Connect(function() if setclipboard then setclipboard(KeyLink) Status.Text="Copied! ✓" Status.TextColor3=Color3.fromRGB(0,255,100) end end)
    CloseBtn.MouseButton1Click:Connect(function() Blur:Destroy() ScreenGui:Destroy() end)

    return {Close=function() Blur:Destroy() ScreenGui:Destroy() end}
end

