NiceLib.ConfigSystem = {}
function NiceLib.ConfigSystem:SaveConfig(folder, name, data)
    if not isfolder then return end
    if not isfolder(folder) then makefolder(folder) end
    local path = folder.."/"..name..".json"
    writefile(path, HttpService:JSONEncode(data))
    NiceLib:Notify({Title="Config Saved", Content=name.." saved!", Duration=2})
end
function NiceLib.ConfigSystem:LoadConfig(folder, name)
    if not isfile then return nil end
    local path = folder.."/"..name..".json"
    if isfile(path) then
        local ok, result = pcall(function() return HttpService:JSONDecode(readfile(path)) end)
        if ok then return result end
    end
    return nil
end
function NiceLib.ConfigSystem:ListConfigs(folder)
    if not isfolder or not listfiles then return {} end
    if not isfolder(folder) then return {} end
    local files = listfiles(folder)
    local configs = {}
    for _,file in ipairs(files) do
        if file:match("%.json$") then
            table.insert(configs, file:match("([^/\\]+)%.json$"))
        end
    end
    return configs
end

