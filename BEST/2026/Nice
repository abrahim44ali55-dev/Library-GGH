function Library:Create(config)
	config = config or {}
	local title = config.Title or "لوحة التحكم"
	local description = config.Description or "مكتبة سكربات متطورة"
	local currentTheme = Themes[config.Theme] or Themes.DarkModern

	if CoreGui:FindFirstChild("CustomUILibrary") then
		CoreGui["CustomUILibrary"]:Destroy()
	end

	local ScreenGui = Instance.new("ScreenGui")
	ScreenGui.Name = "CustomUILibrary"
	ScreenGui.ResetOnSpawn = false
	pcall(function() ScreenGui.Parent = CoreGui end)
	if not ScreenGui.Parent then ScreenGui.Parent = Players.LocalPlayer:WaitForChild("PlayerGui") end

	-- نظام الإشعارات
	local NotifHolder = Instance.new("Frame")
	NotifHolder.Size = UDim2.new(0, 260, 0, 400)
	NotifHolder.Position = UDim2.new(0, 15, 0.5, -200)
	NotifHolder.BackgroundTransparency = 1
	NotifHolder.ZIndex = 100
	NotifHolder.Parent = ScreenGui

	local NotifLayout = Instance.new("UIListLayout")
	NotifLayout.SortOrder = Enum.SortOrder.LayoutOrder
	NotifLayout.VerticalAlignment = Enum.VerticalAlignment.Center
	NotifLayout.Padding = UDim.new(0, 8)
	NotifLayout.Parent = NotifHolder

	local function Notify(titleText, descText, duration)
		duration = duration or 3
		local NotifBox = Instance.new("Frame")
		NotifBox.Size = UDim2.new(1, 0, 0, 55)
		NotifBox.BackgroundColor3 = currentTheme.TopBar
		NotifBox.BackgroundTransparency = 0.05
		NotifBox.BorderSizePixel = 0
		NotifBox.Position = UDim2.new(-1.2, 0, 0, 0)
		NotifBox.ZIndex = 101
		NotifBox.Parent = NotifHolder
		
		local Corner = Instance.new("UICorner")
		Corner.CornerRadius = UDim.new(0, 10)
		Corner.Parent = NotifBox

		local NTitle = Instance.new("TextLabel")
		NTitle.Size = UDim2.new(1, -15, 0, 20)
		NTitle.Position = UDim2.new(0, 12, 0, 6)
		NTitle.BackgroundTransparency = 1
		NTitle.Text = titleText
		NTitle.TextColor3 = currentTheme.Accent
		NTitle.TextSize = 12
		NTitle.Font = Enum.Font.GothamBold
		NTitle.TextXAlignment = Enum.TextXAlignment.Left
		NTitle.ZIndex = 101
		NTitle.Parent = NotifBox

		local NDesc = Instance.new("TextLabel")
		NDesc.Size = UDim2.new(1, -15, 0, 20)
		NDesc.Position = UDim2.new(0, 12, 0, 26)
		NDesc.BackgroundTransparency = 1
		NDesc.Text = descText
		NDesc.TextColor3 = currentTheme.Text
		NDesc.TextSize = 11
		NDesc.Font = Enum.Font.Gotham
		NDesc.TextXAlignment = Enum.TextXAlignment.Left
		NDesc.ZIndex = 101
		NDesc.Parent = NotifBox

		TweenService:Create(NotifBox, TweenInfo.new(0.3, Enum.EasingStyle.Back), {Position = UDim2.new(0, 0, 0, 0)}):Play()

		task.spawn(function()
			task.wait(duration)
			TweenService:Create(NotifBox, TweenInfo.new(0.3, Enum.EasingStyle.Quad), {Position = UDim2.new(-1.2, 0, 0, 0)}):Play()
			task.wait(0.3)
			NotifBox:Destroy()
		end)
	end

