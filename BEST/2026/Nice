            return {SetTitle = function(_, t) Btn.Text = t end}
        end
        
        function Tab:CreateToggle(Config)
            Config = Config or {}
            local Value = Config.Default or false
            local ToggleFrame = Create("Frame", {
                Parent = TabContent,
                Size = UDim2.new(1,0,0,42),
                BackgroundColor3 = Theme.Background2,
                BackgroundTransparency = 0.2,
            }, {
                Create("UICorner", {CornerRadius = UDim.new(0,8)}),
                Create("UIStroke", {Color = Theme.Border, Thickness = 1, Transparency = 0.8}),
            })
            Create("TextLabel", {
                Parent = ToggleFrame,
                Position = UDim2.fromOffset(12,0),
                Size = UDim2.new(1,-70,1,0),
                BackgroundTransparency = 1,
                Text = Config.Title or "Toggle",
                TextColor3 = Theme.Text,
                Font = Enum.Font.GothamMedium,
                TextSize = 13,
                TextXAlignment = Enum.TextXAlignment.Left,
            })
            local Switch = Create("Frame", {
                Parent = ToggleFrame,
                AnchorPoint = Vector2.new(1,0.5),
                Position = UDim2.new(1,-12,0.5,0),
                Size = UDim2.fromOffset(44,24),
                BackgroundColor3 = Value and Theme.Accent or Theme.Border,
            }, {
                Create("UICorner", {CornerRadius = UDim.new(1,0)}),
                Create("Frame", {
                    Name = "Dot",
                    Position = Value and UDim2.fromOffset(22,2) or UDim2.fromOffset(2,2),
                    Size = UDim2.fromOffset(20,20),
                    BackgroundColor3 = Color3.new(1,1,1),
                }, {Create("UICorner", {CornerRadius = UDim.new(1,0)})})
            })
            local function Update(v)
                Value = v
                Tween(Switch, {BackgroundColor3 = v and Theme.Accent or Theme.Border}, 0.25):Play()
                Tween(Switch.Dot, {Position = v and UDim2.fromOffset(22,2) or UDim2.fromOffset(2,2)}, 0.25, Enum.EasingStyle.Back):Play()
                NovaUI.Options[Config.Flag or Config.Title] = {Value = v, Type = "Toggle"}
                if Config.Callback then Config.Callback(v) end
            end
            ToggleFrame.InputBegan:Connect(function(i) if i.UserInputType == Enum.UserInputType.MouseButton1 then Update(not Value) end end)
            return {Value = Value, SetValue = Update}
        end
        
        function Tab:CreateSlider(Config)
            Config = Config or {}
            local Value = Config.Default or Config.Min or 0
            local Min = Config.Min or 0
            local Max = Config.Max or 100
            local Frame = Create("Frame", {
                Parent = TabContent,
                Size = UDim2.new(1,0,0,52),
                BackgroundColor3 = Theme.Background2,
                BackgroundTransparency = 0.2,
            }, {Create("UICorner", {CornerRadius = UDim.new(0,8)})})
            Create("TextLabel", {
                Parent = Frame,
                Position = UDim2.fromOffset(12,6),
                Size = UDim2.new(1,-24,0,16),
                BackgroundTransparency = 1,
                Text = (Config.Title or "Slider") .. ": " .. Value,
                TextColor3 = Theme.Text,
                Font = Enum.Font.GothamMedium,
                TextSize = 12,
                TextXAlignment = Enum.TextXAlignment.Left,
                Name = "Label",
            })
            local Track = Create("Frame", {
                Parent = Frame,
                Position = UDim2.fromOffset(12,32),
                Size = UDim2.new(1,-24,0,6),
                BackgroundColor3 = Theme.Border,
            }, {Create("UICorner", {CornerRadius = UDim.new(1,0)}),
                Create("Frame", {
                    Name = "Fill",
                    Size = UDim2.fromScale((Value-Min)/(Max-Min),1),
                    BackgroundColor3 = Theme.Accent,
                }, {Create("UICorner", {CornerRadius = UDim.new(1,0)})})
            })
            local dragging = false
            Track.InputBegan:Connect(function(i) if i.UserInputType == Enum.UserInputType.MouseButton1 then dragging = true end end)
            UserInputService.InputEnded:Connect(function(i) if i.UserInputType == Enum.UserInputType.MouseButton1 then dragging = false end end)
            UserInputService.InputChanged:Connect(function(i)
                if dragging and i.UserInputType == Enum.UserInputType.MouseMovement then
                    local pct = math.clamp((i.Position.X - Track.AbsolutePosition.X)/Track.AbsoluteSize.X,0,1)
                    Value = math.floor(Min + pct*(Max-Min))
                    Frame.Label.Text = (Config.Title or "Slider") .. ": " .. Value
                    Track.Fill.Size = UDim2.fromScale(pct,1)
                    if Config.Callback then Config.Callback(Value) end
                    NovaUI.Options[Config.Flag or Config.Title] = {Value = Value, Type = "Slider"}
                end
            end)
            return {Value = Value, SetValue = function(_,v) Value = v Frame.Label.Text = (Config.Title or "Slider")..": "..v Track.Fill.Size = UDim2.fromScale((v-Min)/(Max-Min),1) end}
        end
        
        function Tab:CreateDropdown(Config)
            Config = Config or {}
            local Options = Config.Options or {"Option 1"}
            local Selected = Config.Default or Options[1]
            local Multi = Config.Multi or false
            local DropFrame = Create("Frame", {
                Parent = TabContent,
                Size = UDim2.new(1,0,0,38),
                BackgroundColor3 = Theme.Background2,
                ClipsDescendants = false,
                ZIndex = 2,
            }, {Create("UICorner", {CornerRadius = UDim.new(0,8)}), Create("UIStroke", {Color = Theme.Border, Thickness = 1, Transparency = 0.7})})
            Create("TextLabel", {
                Parent = DropFrame,
                Position = UDim2.fromOffset(12,0),
                Size = UDim2.new(1,-80,1,0),
                BackgroundTransparency = 1,
                Text = Config.Title or "Dropdown",
                TextColor3 = Theme.Text,
                Font = Enum.Font.GothamMedium,
                TextSize = 13,
                TextXAlignment = Enum.TextXAlignment.Left,
            })
            local SelectedLabel = Create("TextLabel", {
                Parent = DropFrame,
                Position = UDim2.new(1,-70,0,0),
                Size = UDim2.new(0,60,1,0),
                BackgroundTransparency = 1,
                Text = Selected,
                TextColor3 = Theme.Text2,
                Font = Enum.Font.Gotham,
                TextSize = 12,
                TextXAlignment = Enum.TextXAlignment.Right,
            })
            local List = Create("Frame", {
                Parent = DropFrame,
                Position = UDim2.fromOffset(0,42),
                Size = UDim2.new(1,0,0,0),
                BackgroundColor3 = Theme.Background2,
                Visible = false,
                ClipsDescendants = true,
                ZIndex = 10,
            }, {Create("UICorner", {CornerRadius = UDim.new(0,8)}), Create("UIListLayout", {Padding = UDim.new(0,2)}), Create("UIPadding", {PaddingTop = UDim.new(0,4), PaddingBottom = UDim.new(0,4), PaddingLeft = UDim.new(0,4), PaddingRight = UDim.new(0,4)})})
            for _,opt in ipairs(Options) do
                local OptBtn = Create("TextButton", {
                    Parent = List,
                    Size = UDim2.new(1,0,0,30),
                    BackgroundColor3 = Theme.Background,
                    Text = opt,
                    TextColor3 = Theme.Text,
                    Font = Enum.Font.Gotham,
                    TextSize = 12,
                }, {Create("UICorner", {CornerRadius = UDim.new(0,6)})})
                OptBtn.MouseButton1Click:Connect(function()
                    Selected = opt
                    SelectedLabel.Text = opt
                    List.Visible = false
                    Tween(List, {Size = UDim2.new(1,0,0,0)}, 0.2):Play()
                    if Config.Callback then Config.Callback(opt) end
                    NovaUI.Options[Config.Flag or Config.Title] = {Value = opt, Type = "Dropdown"}
                end)
            end
            local Open = false
            DropFrame.InputBegan:Connect(function(i)
                if i.UserInputType == Enum.UserInputType.MouseButton1 then
                    Open = not Open
                    List.Visible = true
                    Tween(List, {Size = Open and UDim2.new(1,0,0,#Options*32+8) or UDim2.new(1,0,0,0)}, 0.25, Enum.EasingStyle.Quint):Play()
                    if not Open then task.delay(0.25, function() List.Visible = false end) end
                end
            end)
            return {Value = Selected}
        end
        
        function Tab:CreateInput(Config)
            Config = Config or {}
