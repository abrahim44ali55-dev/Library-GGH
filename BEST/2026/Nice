function AcrylicModule.Enable()
    -- simple blur using DepthOfField trick
    pcall(function()
        if not workspace.CurrentCamera:FindFirstChild("GGH_Blur") then
            local blur = Instance.new("BlurEffect")
            blur.Name="GGH_Blur"
            blur.Size=12
            blur.Parent = game:GetService("Lighting")
