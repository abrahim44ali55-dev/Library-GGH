			animConnection = RunService.RenderStepped:Connect(function(deltaTime)
				UIGradient.Rotation = (UIGradient.Rotation + (deltaTime * 120)) % 360
				local hue = (tick() * 0.3) % 1
				UIGradient.Color = ColorSequence.new({
					ColorSequenceKeypoint.new(0, Color3.fromHSV(hue, 0.9, 1)),
					ColorSequenceKeypoint.new(0.5, Color3.fromHSV((hue + 0.33) % 1, 0.9, 1)),
					ColorSequenceKeypoint.new(1, Color3.fromHSV((hue + 0.66) % 1, 0.9, 1))
				})
			end)
		else
			UIGradient.Enabled = false
			UIStroke.Color = currentTheme.Accent
		end
	end
