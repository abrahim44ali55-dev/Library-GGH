function Theme:Get(name)
    return self.Themes[name] or self.Themes.Midnight
end

function Theme:Set(nameOrTable)
    local newTheme
    if typeof(nameOrTable) == "string" then
        newTheme = self:Get(nameOrTable)
    else
        newTheme = nameOrTable
    end
    self.Current = newTheme
    for _, callback in ipairs(self._listeners) do
        task.spawn(callback, newTheme)
    end
end

function Theme:OnChanged(callback)
    table.insert(self._listeners, callback)
end

