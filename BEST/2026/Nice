-- UTILITIES (Object Creation, Layout Helpers, Drag, Responsive)
-- ============================================================================
local Util = {}
function Util:Create(className, properties)
    local inst = Instance.new(className)
    for k,v in pairs(properties or {}) do
        if k ~= "Parent" then
            pcall(function() inst[k] = v end)
        end
    end
    if properties and properties.Parent then
        inst.Parent = properties.Parent
    end
    return inst
end

function Util:Corner(parent, radius)
    return self:Create("UICorner", {CornerRadius = UDim.new(0, radius or 10), Parent = parent})
end

function Util:Stroke(parent, color, thickness, transparency)
    return self:Create("UIStroke", {
        Color = color or Color3.fromRGB(70,70,85),
        Thickness = thickness or 1,
        Transparency = transparency or 0.25,
        ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
        Parent = parent
    })
end

function Util:Padding(parent, paddingTable)
    -- paddingTable = {Top, Bottom, Left, Right} or {All}
    local t = paddingTable or {8,8,8,8}
    if #t == 1 then t = {t[1], t[1], t[1], t[1]} end
    return self:Create("UIPadding", {
        PaddingTop = UDim.new(0, t[1]),
        PaddingBottom = UDim.new(0, t[2]),
        PaddingLeft = UDim.new(0, t[3]),
        PaddingRight = UDim.new(0, t[4]),
        Parent = parent
    })
end

function Util:List(parent, direction, padding, alignment)
    local layout = self:Create("UIListLayout", {
        FillDirection = direction or Enum.FillDirection.Vertical,
        Padding = UDim.new(0, padding or 8),
        SortOrder = Enum.SortOrder.LayoutOrder,
        HorizontalAlignment = alignment or Enum.HorizontalAlignment.Left,
        Parent = parent
    })
    return layout
end

function Util:MakeDraggable(handle, target)
    local dragging = false
    local dragStart = Vector2.new(0,0)
    local startPos = UDim2.new(0,0,0,0)
    local dragInput = nil

    handle.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            dragStart = input.Position
            startPos = target.Position
            input.Changed:Connect(function()
                if input.UserInputState == Enum.UserInputState.End then
                    dragging = false
                end
            end)
        end
    end)

    handle.InputChanged:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
            dragInput = input
        end
    end)

    UserInputService.InputChanged:Connect(function(input)
        if input == dragInput and dragging then
            local delta = input.Position - dragStart
            target.Position = UDim2.new(
                startPos.X.Scale, startPos.X.Offset + delta.X,
                startPos.Y.Scale, startPos.Y.Offset + delta.Y
            )
        end
    end)
end

function Util:GetTextBounds(text, font, size, maxWidth)
    -- Estimate text bounds for wrapping
    local TextService = game:GetService("TextService")
    local bounds = TextService:GetTextSize(text, size, font, Vector2.new(maxWidth or 500, 10000))
    return bounds
end

-- ============================================================================
-- ANIMATION ENGINE (Tween, Ripple, Spring, Hover, Scale)
-- ============================================================================
local Anim = {}
function Anim:Tween(obj, props, info)
    info = info or TweenInfo.new(0.22, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
    local tween = TweenService:Create(obj, info, props)
    tween:Play()
    return tween
end

function Anim:Ripple(button)
    local circle = Util:Create("Frame", {
        Name = "Ripple",
        AnchorPoint = Vector2.new(0.5, 0.5),
        BackgroundColor3 = Color3.fromRGB(255,255,255),
        BackgroundTransparency = 0.7,
        Size = UDim2.fromOffset(0,0),
        Position = UDim2.fromScale(0.5,0.5),
        ZIndex = 20,
        Parent = button
    })
    Util:Corner(circle, 100)
    Anim:Tween(circle, {
        Size = UDim2.fromOffset(button.AbsoluteSize.X * 3, button.AbsoluteSize.X * 3),
        BackgroundTransparency = 1
    }, TweenInfo.new(0.55, Enum.EasingStyle.Quad, Enum.EasingDirection.Out))
    game.Debris:AddItem(circle, 0.6)
end

function Anim:Hover(button, normalColor, hoverColor)
    button.MouseEnter:Connect(function()
        Anim:Tween(button, {BackgroundColor3 = hoverColor}, TweenInfo.new(0.14, Enum.EasingStyle.Quad, Enum.EasingDirection.Out))
    end)
    button.MouseLeave:Connect(function()
        Anim:Tween(button, {BackgroundColor3 = normalColor}, TweenInfo.new(0.14, Enum.EasingStyle.Quad, Enum.EasingDirection.Out))
    end)
end

function Anim:ScaleIn(gui)
    gui.Size = UDim2.fromOffset(0,0)
    Anim:Tween(gui, {Size = UDim2.fromOffset(200,38)}, TweenInfo.new(0.45, Enum.EasingStyle.Back, Enum.EasingDirection.Out))
end

function Anim:ScaleOut(gui, onDone)
    local tw = Anim:Tween(gui, {Size = UDim2.fromOffset(0,0)}, TweenInfo.new(0.28, Enum.EasingStyle.Back, Enum.EasingDirection.In))
    tw.Completed:Connect(function() if onDone then onDone() end end)
end

