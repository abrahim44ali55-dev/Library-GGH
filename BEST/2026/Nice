function redzlib:CreateCustomTheme(name, colors)
    -- colors = {Hub1 = Color3, Hub2 = Color3, Stroke = Color3, Theme = Color3, Text = Color3, DarkText = Color3}
    self.Themes[name] = {
        ["Color Hub 1"] = ColorSequence.new(colors.Hub1 or Color3.fromRGB(30,30,30), colors.Hub1 and Color3.new(colors.Hub1.R*0.8, colors.Hub1.G*0.8, colors.Hub1.B*0.8) or Color3.fromRGB(40,40,40)),
        ["Color Hub 2"] = colors.Hub2 or Color3.fromRGB(30,30,30),
        ["Color Stroke"] = colors.Stroke or Color3.fromRGB(60,60,60),
        ["Color Theme"] = colors.Theme or Color3.fromRGB(88,101,242),
        ["Color Text"] = colors.Text or Color3.fromRGB(245,245,245),
        ["Color Dark Text"] = colors.DarkText or Color3.fromRGB(180,180,180),
        ["Color Glow"] = colors.Theme or Color3.fromRGB(88,101,242)
    }
    self.CustomThemes[name] = true
    return self.Themes[name]
end

function redzlib:SetLanguage(code)
    if self.Languages[code] then self.CurrentLanguage=code return true end
    return false
end
function redzlib:Translate(k) local l=self.Languages[self.CurrentLanguage] or self.Languages["en"] return l[k] or k end

