    return {
        Instance = frame,
        Set = function(_, progress)
            fill.Size = UDim2.new(math.clamp(progress,0,1),0,1,0)
        end
    }
end

-- ============================================================================
-- WINDOW BUILDER V4 - Premium, Responsive, Collect Animation
-- ============================================================================
local function BuildWindow(screenGui, options)
    local th = Theme.Current
    local viewport = workspace.CurrentCamera.ViewportSize
    local isMobile = viewport.X < 700
    local isTablet = viewport.X >= 700 and viewport.X < 1200

    local windowWidth = 560
    local windowHeight = 380

    if isMobile then
        windowWidth = math.min(viewport.X - 24, 480)
        windowHeight = math.min(viewport.Y - 120, 360)
    elseif isTablet then
        windowWidth = 520
        windowHeight = 380
    end

    local main = Util:Create("Frame", {
        Name = "GGH_Window",
        BackgroundColor3 = th.Bg,
        BorderSizePixel = 0,
        Size = UDim2.fromOffset(windowWidth, windowHeight),
        Position = UDim2.new(0.5, -windowWidth/2, 0.5, -windowHeight/2),
