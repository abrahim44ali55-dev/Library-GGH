        Position = UDim2.fromOffset(12,0),
        TextXAlignment = Enum.TextXAlignment.Left,
        Parent = btnFrame
    })

    local clickBtn = UI.Create("TextButton", {
        Text = "",
        BackgroundTransparency = 1,
        Size = UDim2.fromScale(1,1),
        Parent = btnFrame
    })
    UI.Ripple(clickBtn)

    clickBtn.MouseButton1Click:Connect(function()
        if config.Callback then task.spawn(config.Callback) end
        Anim.Tween(btnFrame, {BackgroundColor3 = th.Accent}, 0.08)
        task.wait(0.08)
        Anim.Tween(btnFrame, {BackgroundColor3 = th.Panel}, 0.18)
    end)

    return {Instance = btnFrame, SetText = function(t) label.Text = t end}
end

local function CreateToggle(tabPage, config)
    local th = Theme.Current
    local holder = UI.Create("Frame", {
        Size = UDim2.new(1,0,0,44),
        BackgroundColor3 = th.Panel,
        Parent = tabPage
    })
    UI.Corner(holder, 10)
    UI.Stroke(holder, th.Border, 1, 0.28)

    local title = UI.Create("TextLabel", {
        Text = config.Title or "Toggle",
        Font = Enum.Font.Gotham,
        TextSize = 13,
        TextColor3 = th.Text,
        BackgroundTransparency = 1,
        Size = UDim2.new(1,-70,1,0),
        Position = UDim2.fromOffset(12,0),
        TextXAlignment = Enum.TextXAlignment.Left,
        Parent = holder
    })

    local track = UI.Create("Frame", {
        Size = UDim2.fromOffset(44,24),
        Position = UDim2.new(1,-56,0.5,-12),
        BackgroundColor3 = th.Secondary,
        Parent = holder
    })
    UI.Corner(track, 12)

    local knob = UI.Create("Frame", {
        Size = UDim2.fromOffset(18,18),
        Position = UDim2.fromOffset(3,3),
        BackgroundColor3 = Color3.new(1,1,1),
        Parent = track
    })
    UI.Corner(knob, 9)

    local enabled = config.Default or false
    local function Update()
        Anim.Tween(track, {BackgroundColor3 = enabled and th.Accent or th.Secondary}, 0.22)
        Anim.Tween(knob, {Position = enabled and UDim2.fromOffset(23,3) or UDim2.fromOffset(3,3)}, 0.26, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
    end
    Update()

    local btn = UI.Create("TextButton", {Text="", BackgroundTransparency=1, Size=UDim2.fromScale(1,1), Parent=holder})
    btn.MouseButton1Click:Connect(function()
        enabled = not enabled
        Update()
        if config.Callback then config.Callback(enabled) end
    end)

    return {Instance=holder, Get=function() return enabled end, Set=function(v) enabled=v Update() end}
end

local function CreateSlider(tabPage, config)
    local th = Theme.Current
    local min = config.Min or 0
    local max = config.Max or 100
    local val = config.Default or 50
    local container = UI.Create("Frame", {Size=UDim2.new(1,0,0,58), BackgroundColor3=th.Panel, Parent=tabPage})
    UI.Corner(container, 10)
    UI.Stroke(container, th.Border, 1, 0.28)

    local title = UI.Create("TextLabel", {Text=config.Title or "Slider", Font=Enum.Font.Gotham, TextSize=12, TextColor3=th.Text, BackgroundTransparency=1, Size=UDim2.new(1,-60,0,18), Position=UDim2.fromOffset(12,6), TextXAlignment=Enum.TextXAlignment.Left, Parent=container})
    local valLabel = UI.Create("TextLabel", {Text=tostring(val), Font=Enum.Font.GothamBold, TextSize=12, TextColor3=th.Accent, BackgroundTransparency=1, Size=UDim2.new(0,50,0,18), Position=UDim2.new(1,-50,0,6), TextXAlignment=Enum.TextXAlignment.Right, Parent=container})
    local track = UI.Create("Frame", {Size=UDim2.new(1,-24,0,6), Position=UDim2.fromOffset(12,36), BackgroundColor3=th.Secondary, Parent=container})
    UI.Corner(track, 3)
    local fill = UI.Create("Frame", {Size=UDim2.new((val-min)/(max-min),0,1,0), BackgroundColor3=th.Accent, Parent=track})
    UI.Corner(fill, 3)
    local dragArea = UI.Create("TextButton", {Text="", BackgroundTransparency=1, Size=UDim2.fromScale(1,1), Parent=track})
    local dragging = false
    dragArea.InputBegan:Connect(function(i) if i.UserInputType==Enum.UserInputType.MouseButton1 then dragging=true end end)
    UserInputService.InputEnded:Connect(function(i) if i.UserInputType==Enum.UserInputType.MouseButton1 then dragging=false end end)
    UserInputService.InputChanged:Connect(function(i)
        if dragging and i.UserInputType==Enum.UserInputType.MouseMovement then
            local rel = (i.Position.X - track.AbsolutePosition.X)/track.AbsoluteSize.X
            local clamped = math.clamp(rel,0,1)
            val = min + (max-min)*clamped
            fill.Size = UDim2.new(clamped,0,1,0)
            valLabel.Text = tostring(math.floor(val))
            if config.Callback then config.Callback(val) end
        end
    end)
    return {Instance=container}
end

local function CreateDropdown(tabPage, config)
    local th = Theme.Current
    local options = config.Options or {"Option 1","Option 2"}
    local selected = config.Default or options[1]
    local container = UI.Create("Frame", {Size=UDim2.new(1,0,0,42), BackgroundColor3=th.Panel, Parent=tabPage})
    UI.Corner(container,10)
    UI.Stroke(container, th.Border,1,0.28)
    local title = UI.Create("TextLabel", {Text=config.Title or "Dropdown", Font=Enum.Font.Gotham, TextSize=12, TextColor3=th.Text, BackgroundTransparency=1, Size=UDim2.new(0.4,0,1,0), Position=UDim2.fromOffset(12,0), TextXAlignment=Enum.TextXAlignment.Left, Parent=container})
    local selectedLabel = UI.Create("TextLabel", {Text=selected, Font=Enum.Font.GothamSemibold, TextSize=12, TextColor3=th.SubText, BackgroundTransparency=1, Size=UDim2.new(0.5,-20,1,0), Position=UDim2.new(0.4,0,0,0), TextXAlignment=Enum.TextXAlignment.Right, Parent=container})
    local arrow = UI.Create("TextLabel", {Text="▼", Font=Enum.Font.GothamBold, TextSize=10, TextColor3=th.SubText, BackgroundTransparency=1, Size=UDim2.new(0,20,1,0), Position=UDim2.new(1,-20,0,0), Parent=container})
    local isOpen = false
    local listFrame
    local btn = UI.Create("TextButton", {Text="", BackgroundTransparency=1, Size=UDim2.fromScale(1,1), Parent=container})
    btn.MouseButton1Click:Connect(function()
        isOpen = not isOpen
        if isOpen then
            listFrame = UI.Create("Frame", {Size=UDim2.new(1,0,0,#options*34+8), Position=UDim2.new(0,0,1,6), BackgroundColor3=th.Panel, Parent=container, ZIndex=20})
            UI.Corner(listFrame,10)
            UI.Stroke(listFrame, th.Border,1,0.2)
            UI.List(listFrame, Enum.FillDirection.Vertical,4)
            UI.Padding(listFrame,4,4,4,4)
            for _,opt in ipairs(options) do
                local optBtn = UI.Create("TextButton", {Text=opt, Font=Enum.Font.Gotham, TextSize=12, TextColor3=th.Text, BackgroundColor3=th.Secondary, Size=UDim2.new(1,0,0,30), Parent=listFrame})
                UI.Corner(optBtn,8)
                optBtn.MouseButton1Click:Connect(function()
                    selected=opt selectedLabel.Text=opt isOpen=false if listFrame then listFrame:Destroy() end if config.Callback then config.Callback(opt) end
                end)
            end
        else
            if listFrame then listFrame:Destroy() end
        end
    end)
    return {Instance=container}
end

