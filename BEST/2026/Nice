    local btnHolder=Util:Create("Frame",{BackgroundTransparency=1,Size=UDim2.fromOffset(68,28),Position=UDim2.new(1,-76,0,5),ZIndex=4,Parent=topBar})
    Util:List(btnHolder,Enum.FillDirection.Horizontal,6)
    local minimizeBtn=Util:Create("TextButton",{Text="_",Font=Enum.Font.GothamBold,TextSize=14,TextColor3=th.Sub,BackgroundColor3=th.Sec,Size=UDim2.fromOffset(28,28),AutoButtonColor=false,ZIndex=4,Parent=btnHolder}); Util:Corner(minimizeBtn,7); minimizeBtn.AutoLocalize=false
    local closeBtn=Util:Create("TextButton",{Text="X",Font=Enum.Font.GothamBold,TextSize=12,TextColor3=Color3.fromRGB(255,95,95),BackgroundColor3=th.Sec,Size=UDim2.fromOffset(28,28),AutoButtonColor=false,ZIndex=4,Parent=btnHolder}); Util:Corner(closeBtn,7); closeBtn.AutoLocalize=false

    local content=Util:Create("Frame",{Name="Content",BackgroundTransparency=1,Size=UDim2.new(1,0,1,-38),Position=UDim2.fromOffset(0,38),ClipsDescendants=true,ZIndex=3,Parent=main})
    local tabBar=Util:Create("ScrollingFrame",{Name="TabBar",BackgroundColor3=th.Panel,BackgroundTransparency=0.2,Size=UDim2.new(0,130,1,0),ScrollBarThickness=2,CanvasSize=UDim2.new(0,0,0,0),AutomaticCanvasSize=Enum.AutomaticSize.Y,BorderSizePixel=0,ZIndex=3,Parent=content,ScrollingDirection=Enum.ScrollingDirection.Y})
    Util:List(tabBar,Enum.FillDirection.Vertical,4); Util:Padding(tabBar,{6,6,6,40})
    local tabContent=Util:Create("Frame",{Name="TabContent",BackgroundTransparency=1,Size=UDim2.new(1,-130,1,0),Position=UDim2.new(0,130,0,0),ZIndex=3,Parent=content})

    local resizeHandle=Util:Create("Frame",{Name="Resize",BackgroundTransparency=1,AnchorPoint=Vector2.new(1,1),Position=UDim2.new(1,0,1,0),Size=UDim2.fromOffset(20,20),ZIndex=10,Parent=main})
    local rg=Util:Create("TextLabel",{Text="o",Font=Enum.Font.Gotham,TextSize=10,TextColor3=th.Sub,BackgroundTransparency=1,Size=UDim2.fromScale(1,1),Parent=resizeHandle}); rg.AutoLocalize=false

    local floatBar=Util:Create("Frame",{Name="FloatingBar",BackgroundColor3=th.Panel,Size=UDim2.fromOffset(200,38),Position=UDim2.new(0.5,-100,0,12),Visible=false,ZIndex=50,Parent=gui})
    Util:Corner(floatBar,19); Util:Stroke(floatBar,th.Border,1,0.1)
    local dragBtn=Util:Create("TextButton",{Text="=",Font=Enum.Font.GothamBold,TextSize=14,TextColor3=th.Sub,BackgroundColor3=th.Sec,Size=UDim2.fromOffset(30,30),Position=UDim2.fromOffset(4,4),AutoButtonColor=false,Parent=floatBar}); Util:Corner(dragBtn,15); dragBtn.AutoLocalize=false
    local floatLbl=Util:Create("TextLabel",{Text="GGH Lib",Font=Enum.Font.GothamBold,TextSize=11,TextColor3=th.Text,BackgroundTransparency=1,Size=UDim2.new(1,-80,1,0),Position=UDim2.fromOffset(40,0),TextXAlignment=Enum.TextXAlignment.Left,Parent=floatBar}); floatLbl.AutoLocalize=false
    local restoreBtn=Util:Create("TextButton",{Text="^",Font=Enum.Font.GothamBold,TextSize=12,TextColor3=th.Accent,BackgroundColor3=th.Bg,Size=UDim2.fromOffset(30,30),Position=UDim2.new(1,-34,0,4),AutoButtonColor=false,Parent=floatBar}); Util:Corner(restoreBtn,15); restoreBtn.AutoLocalize=false

    -- Drag main
    local dragging, dragStart, startPos, dragInput
    topBar.InputBegan:Connect(function(input) if input.UserInputType==Enum.UserInputType.MouseButton1 or input.UserInputType==Enum.UserInputType.Touch then dragging=true; dragStart=input.Position; startPos=main.Position end end)
    topBar.InputChanged:Connect(function(input) if input.UserInputType==Enum.UserInputType.MouseMovement or input.UserInputType==Enum.UserInputType.Touch then dragInput=input end end)
    UserInputService.InputChanged:Connect(function(input) if input==dragInput and dragging then local d=input.Position-dragStart; main.Position=UDim2.new(startPos.X.Scale,startPos.X.Offset+d.X,startPos.Y.Scale,startPos.Y.Offset+d.Y) end end)
    UserInputService.InputEnded:Connect(function(input) if input.UserInputType==Enum.UserInputType.MouseButton1 or input.UserInputType==Enum.UserInputType.Touch then dragging=false end end)

    -- Resize
    local resizing, rStart, rSize, rInput
    resizeHandle.InputBegan:Connect(function(input) if input.UserInputType==Enum.UserInputType.MouseButton1 or input.UserInputType==Enum.UserInputType.Touch then resizing=true; rStart=input.Position; rSize=main.Size end end)
    resizeHandle.InputChanged:Connect(function(input) if input.UserInputType==Enum.UserInputType.MouseMovement or input.UserInputType==Enum.UserInputType.Touch then rInput=input end end)
    UserInputService.InputChanged:Connect(function(input) if input==rInput and resizing then local d=input.Position-rStart; local newW=math.clamp(rSize.X.Offset+d.X, 320, math.min(vp.X-20,800)); local newH=math.clamp(rSize.Y.Offset+d.Y, 220, math.min(vp.Y-20,600)); main.Size=UDim2.new(0,newW,0,newH) end end)
    UserInputService.InputEnded:Connect(function() resizing=false end)

    -- Collect animation for minimize
    local function collectAnimation(toPos, isMinimize, onComplete)
        local allElements={}
        for _,child in ipairs(tabContent:GetDescendants()) do
            if child:IsA("Frame") or child:IsA("TextButton") or child:IsA("ScrollingFrame") then
                if child.Parent and child.Parent.Parent==tabContent or child.Parent==tabContent or child.Parent:IsA("ScrollingFrame") then
                    if child.Name~="FloatingBar" and child.Size.X.Offset>20 then
                        table.insert(allElements, child)
                    end
                end
            end
        end
        for _,child in ipairs(tabBar:GetChildren()) do
            if child:IsA("TextButton") then table.insert(allElements, child) end
        end

        if isMinimize then
            -- Shrink all to dragBtn
            for i,el in ipairs(allElements) do
                local delay = i*0.015
                task.delay(delay, function()
                    if el and el.Parent then
                        TweenService:Create(el,TweenInfo.new(0.22,Enum.EasingStyle.Back,Enum.EasingDirection.In),{Size=UDim2.fromOffset(0,0),Position=UDim2.new(0.5,0,0.5,0)}):Play()
                    end
                end)
            end
            task.wait(#allElements*0.015+0.22)
            if onComplete then onComplete() end
        else
            -- Restore
            for i,el in ipairs(allElements) do
                el.Size=UDim2.fromOffset(0,0)
                local delay=i*0.02
                task.delay(delay, function()
                    if el and el.Parent then
                        TweenService:Create(el,TweenInfo.new(0.28,Enum.EasingStyle.Back,Enum.EasingDirection.Out),{Size=el:GetAttribute("OriginalSize") or UDim2.new(1,0,0,38)}):Play()
                    end
                end)
            end
            if onComplete then task.delay(#allElements*0.02+0.3, onComplete) end
        end
    end

    local function setMinimized(state)
        if state then
            -- Collect to dragBtn
            task.spawn(function()
                -- save original sizes
                for _,child in ipairs(tabContent:GetDescendants()) do
                    if child:IsA("Frame") and child.Size.Y.Offset>10 then
                        child:SetAttribute("OriginalSize", child.Size)
                    end
                end
                for _,child in ipairs(tabBar:GetChildren()) do
                    if child:IsA("TextButton") then child:SetAttribute("OriginalSize", child.Size) end
                end
                -- animate collect
                local tweenInfos={}
                for _,c in ipairs(tabContent:GetDescendants()) do
                    if c:IsA("GuiObject") and c.Parent and c.Parent:IsA("ScrollingFrame") then
                        TweenService:Create(c,TweenInfo.new(0.18,Enum.EasingStyle.Quad,Enum.EasingDirection.In),{Size=UDim2.fromOffset(0,0)}):Play()
                    end
                end
                for _,c in ipairs(tabBar:GetChildren()) do
                    if c:IsA("GuiObject") then TweenService:Create(c,TweenInfo.new(0.18,Enum.EasingStyle.Quad,Enum.EasingDirection.In),{Size=UDim2.fromOffset(0,0)}):Play() end
                end
                task.wait(0.2)
                -- shrink window to floatBar
                local targetPos=floatBar.Position
                TweenService:Create(main,TweenInfo.new(0.32,Enum.EasingStyle.Back,Enum.EasingDirection.In),{Size=UDim2.fromOffset(0,0),Position=UDim2.new(targetPos.X.Scale,targetPos.X.Offset+100,targetPos.Y.Scale,targetPos.Y.Offset+19)}):Play()
                task.wait(0.32)
                main.Visible=false
                floatBar.Visible=true
                floatBar.Size=UDim2.fromOffset(0,38)
                TweenService:Create(floatBar,TweenInfo.new(0.38,Enum.EasingStyle.Back,Enum.EasingDirection.Out),{Size=UDim2.fromOffset(200,38)}):Play()
            end)
        else
            floatBar.Visible=false
            main.Visible=true
            main.Size=UDim2.fromOffset(0,0)
            main.Position=UDim2.new(0.5,-winW/2,0.5,-winH/2)
            TweenService:Create(main,TweenInfo.new(0.42,Enum.EasingStyle.Back,Enum.EasingDirection.Out),{Size=UDim2.fromOffset(winW,winH)}):Play()
            task.wait(0.32)
            -- restore elements
            for _,c in ipairs(tabContent:GetDescendants()) do
                if c:IsA("Frame") and c:GetAttribute("OriginalSize") then
                    local orig=c:GetAttribute("OriginalSize")
                    c.Size=UDim2.fromOffset(0,0)
                    TweenService:Create(c,TweenInfo.new(0.3,Enum.EasingStyle.Back,Enum.EasingDirection.Out),{Size=orig}):Play()
                    task.wait(0.01)
                end
            end
            for _,c in ipairs(tabBar:GetChildren()) do
                if c:IsA("TextButton") and c:GetAttribute("OriginalSize") then
                    local orig=c:GetAttribute("OriginalSize")
                    c.Size=UDim2.fromOffset(0,0)
                    TweenService:Create(c,TweenInfo.new(0.3,Enum.EasingStyle.Back,Enum.EasingDirection.Out),{Size=orig}):Play()
                    task.wait(0.015)
                end
            end
        end
    end

    minimizeBtn.MouseButton1Click:Connect(function() setMinimized(true) end)
    restoreBtn.MouseButton1Click:Connect(function() setMinimized(false) end)
    closeBtn.MouseButton1Click:Connect(function() ShowConfirm(gui, function() gui:Destroy() end) end)
    Util:MakeDraggable(dragBtn,floatBar)
    Util:MakeDraggable(topBar,main)

    Theme:OnChanged(function(t) main.BackgroundColor3=t.Bg; topBar.BackgroundColor3=t.Panel; title.TextColor3=t.Text; mainStroke.Color=t.Border; glowStroke.Color=t.Accent; tabBar.BackgroundColor3=t.Panel; floatBar.BackgroundColor3=t.Panel; floatLbl.TextColor3=t.Text end)

    -- Responsive listener
    workspace.CurrentCamera:GetPropertyChangedSignal("ViewportSize"):Connect(function()
        local vp2=workspace.CurrentCamera.ViewportSize
        if vp2.X<700 then
            if main.Size.X.Offset>vp2.X-20 then main.Size=UDim2.fromOffset(vp2.X-20, main.Size.Y.Offset) end
            if main.Position.X.Offset+main.Size.X.Offset>vp2.X then main.Position=UDim2.new(0.5,-main.Size.X.Offset/2,main.Position.Y.Scale,main.Position.Y.Offset) end
        end
    end)

    return {Main=main, TabBar=tabBar, TabContent=tabContent}
end

