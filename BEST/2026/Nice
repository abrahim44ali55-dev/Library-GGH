-- ============================================================================
-- ULTRA MINIMIZE SYSTEM - 2 PHASES - CORE OF THIS LIBRARY
-- Phase 1: Window Content -> Collapse to Header
-- Phase 2: Header -> Morph to Pill Dock (180x48)
-- ============================================================================
local MinimizeSystem = {}
MinimizeSystem.States = {}
MinimizeSystem.Locked = false
MinimizeSystem.Config = {
    HeaderHeight = 50,
    PillSize = UDim2.fromOffset(200, 48),
    CornerNormal = 14,
    CornerPill = 24,
    Duration1 = 0.32,
    Duration2 = 0.42,
}

function MinimizeSystem:Register(window)
    self.States[window.Id] = {
        IsMinimized = false,
        IsAnimating = false,
        OriginalSize = window.Main.Size,
        OriginalPos = window.Main.Position,
        OriginalContentSize = window.Content.Size,
        DockPos = UDim2.fromOffset(24, 24),
    }
end

function MinimizeSystem:Phase1_Collapse(window)
    local state = self.States[window.Id]
    if not state then return end
    state.IsAnimating = true

    -- Fade all content children
    for _, child in ipairs(window.Content:GetDescendants()) do
        if child:IsA("GuiObject") then
            if child:IsA("TextLabel") or child:IsA("TextButton") or child:IsA("TextBox") then
                Anim.Tween(child, {TextTransparency = 1}, 0.14, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
            end
            if child:IsA("ImageLabel") or child:IsA("ImageButton") then
                Anim.Tween(child, {ImageTransparency = 1}, 0.14)
            end
            Anim.Tween(child, {BackgroundTransparency = 1}, 0.15)
            if child:FindFirstChildOfClass("UIStroke") then
                Anim.Tween(child:FindFirstChildOfClass("UIStroke"), {Transparency = 1}, 0.15)
            end
        end
    end
    -- Tabs fade
    for _, tab in ipairs(window.TabContainer:GetDescendants()) do
        if tab:IsA("GuiObject") then
            Anim.Tween(tab, {BackgroundTransparency = 1}, 0.13)
            if tab:IsA("TextLabel") or tab:IsA("TextButton") then
                Anim.Tween(tab, {TextTransparency = 1}, 0.12)
            end
        end
    end

    -- Collapse content frames
    Anim.Tween(window.Content, {
        Size = UDim2.new(1, -150, 0, 0),
        BackgroundTransparency = 1
    }, self.Config.Duration1, Enum.EasingStyle.Expo, Enum.EasingDirection.InOut)
    
    Anim.Tween(window.TabContainer, {
        Size = UDim2.new(0, 150, 0, 0),
        BackgroundTransparency = 1
    }, self.Config.Duration1 - 0.06, Enum.EasingStyle.Quad, Enum.EasingDirection.InOut)

    -- Main window shrinks to header height
    Anim.Tween(window.Main, {
        Size = UDim2.new(window.Main.Size.X.Scale, window.Main.Size.X.Offset, 0, self.Config.HeaderHeight + 2)
    }, self.Config.Duration1, Enum.EasingStyle.Cubic, Enum.EasingDirection.InOut)

    task.wait(self.Config.Duration1 + 0.04)
    window.Content.Visible = false
    window.TabContainer.Visible = false
end

function MinimizeSystem:Phase2_MorphToPill(window)
    local state = self.States[window.Id]
    if not state then return end

    -- Background becomes slightly transparent for dock feel
    Anim.Tween(window.Main, {BackgroundTransparency = 0.08}, 0.18)

    -- Morph to pill
    Anim.Tween(window.Main, {
        Size = self.Config.PillSize,
        Position = state.DockPos
    }, self.Config.Duration2, Enum.EasingStyle.Back, Enum.EasingDirection.Out)

    Anim.Tween(window.Header, {
        Size = self.Config.PillSize
    }, self.Config.Duration2, Enum.EasingStyle.Back, Enum.EasingDirection.Out)

    Anim.Tween(window.Corner, {
        CornerRadius = UDim.new(0, self.Config.CornerPill)
    }, 0.35, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)

    Anim.Tween(window.HeaderCorner, {
        CornerRadius = UDim.new(0, self.Config.CornerPill)
    }, 0.35)

    -- Show logo in pill
    if window.Logo then
        window.Logo.Visible = true
        window.Logo.Size = UDim2.fromOffset(0,0)
        Anim.Tween(window.Logo, {
            Size = UDim2.fromOffset(26,26),
            ImageTransparency = 0
        }, 0.38, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
    end

    -- Title smaller and moved
    Anim.Tween(window.Title, {
        TextSize = 12,
        Position = UDim2.fromOffset(44, 0),
        TextTransparency = 0.08
    }, 0.3)

    -- Shadow stronger for dock
    local shadow = window.Main:FindFirstChild("Shadow")
    if shadow then Anim.Tween(shadow, {ImageTransparency = 0.38}, 0.22) end

    task.wait(self.Config.Duration2 + 0.03)
    state.IsMinimized = true
    state.IsAnimating = false
    window.IsMinimized = true
    self.Locked = false
end

function MinimizeSystem:Restore_Phase1(window)
    local state = self.States[window.Id]
    if not state then return end
    state.IsAnimating = true

    Anim.Tween(window.Main, {
        Size = UDim2.new(state.OriginalSize.X.Scale, state.OriginalSize.X.Offset, 0, self.Config.HeaderHeight + 2),
        Position = state.OriginalPos,
        BackgroundTransparency = 0
    }, 0.40, Enum.EasingStyle.Back, Enum.EasingDirection.Out)

    Anim.Tween(window.Header, {
        Size = UDim2.new(1,0,0,self.Config.HeaderHeight)
    }, 0.38, Enum.EasingStyle.Back, Enum.EasingDirection.Out)

    Anim.Tween(window.Corner, {CornerRadius = UDim.new(0, self.Config.CornerNormal)}, 0.3)
    Anim.Tween(window.HeaderCorner, {CornerRadius = UDim.new(0, self.Config.CornerNormal)}, 0.3)

    if window.Logo then
        Anim.Tween(window.Logo, {ImageTransparency = 1, Size = UDim2.fromOffset(0,0)}, 0.18)
        task.wait(0.19)
        window.Logo.Visible = false
    end

    Anim.Tween(window.Title, {
        TextSize = 14,
        Position = UDim2.fromOffset(16,0),
        TextTransparency = 0
    }, 0.28)

    task.wait(0.18)
end

function MinimizeSystem:Restore_Phase2(window)
    local state = self.States[window.Id]
    if not state then return end

    window.Content.Visible = true
    window.TabContainer.Visible = true

    Anim.Tween(window.Main, {Size = state.OriginalSize}, 0.44, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
    Anim.Tween(window.Content, {
        Size = state.OriginalContentSize,
        BackgroundTransparency = 0
    }, 0.38, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
    Anim.Tween(window.TabContainer, {
        Size = UDim2.new(0,150,1,-50),
        BackgroundTransparency = 0.12
    }, 0.36, Enum.EasingStyle.Back, Enum.EasingDirection.Out)

    -- Restore children
    for _, child in ipairs(window.Content:GetChildren()) do
        if child:IsA("GuiObject") then
            Anim.Tween(child, {BackgroundTransparency = 0}, 0.22)
        end
        for _, sub in ipairs(child:GetDescendants()) do
            if sub:IsA("GuiObject") then
                Anim.Tween(sub, {BackgroundTransparency = 0}, 0.20)
                if sub:IsA("TextLabel") or sub:IsA("TextButton") then
                    Anim.Tween(sub, {TextTransparency = 0}, 0.18)
                end
            end
        end
    end

    for _, tab in ipairs(window.TabContainer:GetChildren()) do
        if tab:IsA("GuiObject") then
            Anim.Tween(tab, {BackgroundTransparency = 0.1}, 0.20)
            if tab:IsA("TextLabel") or tab:IsA("TextButton") then
                Anim.Tween(tab, {TextTransparency = 0}, 0.18)
            end
        end
    end

    task.wait(0.45)
    state.IsMinimized = false
    state.IsAnimating = false
    window.IsMinimized = false
    self.Locked = false
end

function MinimizeSystem:Toggle(window)
    if self.Locked then return end
    self.Locked = true
    local state = self.States[window.Id]
    if not state then self:Register(window) state = self.States[window.Id] end

    if not state.IsMinimized then
        self:Phase1_Collapse(window)
        self:Phase2_MorphToPill(window)
    else
        self:Restore_Phase1(window)
        self:Restore_Phase2(window)
    end
end

function MinimizeSystem:MakeDockDraggable(window)
    local state = self.States[window.Id]
    if not state then return end
    local dragging = false
    local dragStart, startPos
    local conn1, conn2, conn3
    conn1 = window.Header.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 and window.IsMinimized then
            dragging = true
            dragStart = input.Position
            startPos = window.Main.Position
        end
    end)
    conn2 = UserInputService.InputChanged:Connect(function(input)
        if dragging and input.UserInputType == Enum.UserInputType.MouseMovement then
            local delta = input.Position - dragStart
            local newPos = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
            window.Main.Position = newPos
            state.DockPos = newPos
        end
    end)
    conn3 = UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then dragging = false end
    end)
end

