    if type(SaveKey)=="string" then KeyFile=SaveKey SaveKey=true end
    if SaveKey==nil then SaveKey=true end
    local KeyLink = Configs.KeyLink or "https://linkvertise.com"
    local Keys = Configs.Keys or {"GGH_FREE"}
    if type(Keys)=="string" then Keys={Keys} end
    local Enable = Configs.EnableKeySystem
    if Enable==nil then Enable=true end
    if Enable==false then if Configs.Callback then pcall(Configs.Callback) end return {Close=function() end} end
    local Callback = Configs.Callback or function() end
    local ThemeName = Configs.Theme or "Darker"
    local Theme = redzlib.Themes[ThemeName] or redzlib.Themes.Darker
