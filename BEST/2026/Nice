-- KitagawaUI - Clean Library v2.0
-- مستوحاة من KitagawaHub

local KitagawaUI = {}
local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")

KitagawaUI.Themes = {
    ["Blue Space"] = Color3.fromRGB(0,150,255),
    ["Purple Cyber"] = Color3.fromRGB(168,85,247),
    ["Acid Lime"] = Color3.fromRGB(34,197,94),
    ["Fiery Rose"] = Color3.fromRGB(236,72,153),
    ["Amber Neon"] = Color3.fromRGB(245,158,11),
}

function KitagawaUI:New(config)
    config = config or {}
    local Title = config.Title or "KitagawaHub"
    local Accent = config.Accent or Color3.fromRGB(0,150,255)
    local self = {}
    
    -- GUI Setup
    local ScreenGui = Instance.new("ScreenGui")
    ScreenGui.Name = "KitagawaUI"
    ScreenGui.Parent = game.CoreGui
    ScreenGui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
    
    local MainFrame = Instance.new("Frame")
    MainFrame.Parent = ScreenGui
    MainFrame.BackgroundColor3 = Color3.fromRGB(11,11,16)
    MainFrame.AnchorPoint = Vector2.new(0.5,0.5)
    MainFrame.Position = UDim2.new(0.5,0,0.5,0)
    MainFrame.Size = UDim2.new(0,640,0,420)
    Instance.new("UICorner", MainFrame).CornerRadius = UDim.new(0,14)
    local Stroke = Instance.new("UIStroke", MainFrame)
    Stroke.Color = Color3.fromRGB(35,35,50)
    Stroke.Thickness = 1.5

    -- Title & Drag
    local TitleLabel = Instance.new("TextLabel", MainFrame)
    TitleLabel.Size = UDim2.new(1,0,0,50)
    TitleLabel.BackgroundTransparency = 1
    TitleLabel.Text = Title
    TitleLabel.Font = Enum.Font.GothamBold
    TitleLabel.TextColor3 = Color3.fromRGB(255,255,255)
    TitleLabel.TextSize = 20

    -- Sidebar
    local Sidebar = Instance.new("Frame", MainFrame)
    Sidebar.BackgroundColor3 = Color3.fromRGB(15,15,22)
    Sidebar.Position = UDim2.new(0,0,0,50)
    Sidebar.Size = UDim2.new(0,170,1,-50)
    Instance.new("UICorner", Sidebar).CornerRadius = UDim.new(0,14)

    local TabContainer = Instance.new("Frame", Sidebar)
    TabContainer.BackgroundTransparency = 1
    TabContainer.Position = UDim2.new(0,12,0,15)
    TabContainer.Size = UDim2.new(1,-24,1,-20)
    local ListLayout = Instance.new("UIListLayout", TabContainer)
    ListLayout.Padding = UDim.new(0,10)

    local ContentArea = Instance.new("Frame", MainFrame)
    ContentArea.BackgroundTransparency = 1
    ContentArea.Position = UDim2.new(0,185,0,60)
    ContentArea.Size = UDim2.new(1,-200,1,-75)

    local tabs = {}
    
    function self:AddTab(name)
        local Page = Instance.new("ScrollingFrame", ContentArea)
        Page.BackgroundTransparency = 1
        Page.Size = UDim2.new(1,0,1,0)
        Page.Visible = #tabs == 0
        Page.ScrollBarThickness = 0
        Page.CanvasSize = UDim2.new(0,0,0,0)
        Page.AutomaticCanvasSize = Enum.AutomaticSize.Y
        local pageLayout = Instance.new("UIListLayout", Page)
        pageLayout.Padding = UDim.new(0,10)

        local TabBtn = Instance.new("TextButton", TabContainer)
        TabBtn.Size = UDim2.new(1,0,0,40)
        TabBtn.Text = name
        TabBtn.Font = Enum.Font.GothamSemibold
        TabBtn.TextSize = 14
        TabBtn.BackgroundColor3 = (#tabs == 0 and Accent) or Color3.fromRGB(20,20,28)
        TabBtn.TextColor3 = (#tabs == 0 and Color3.fromRGB(255,255,255)) or Color3.fromRGB(150,150,170)
        Instance.new("UICorner", TabBtn).CornerRadius = UDim.new(0,10)

        TabBtn.MouseButton1Click:Connect(function()
            for i, t in pairs(tabs) do
                t.Page.Visible = false
                TweenService:Create(t.Button, TweenInfo.new(0.2), {BackgroundColor3 = Color3.fromRGB(20,20,28)}):Play()
            end
            Page.Visible = true
            TweenService:Create(TabBtn, TweenInfo.new(0.2), {BackgroundColor3 = Accent}):Play()
        end)

        table.insert(tabs, {Button = TabBtn, Page = Page})
        
        local tabAPI = {}
        function tabAPI:AddToggle(text, default, callback)
            local Frame = Instance.new("Frame", Page)
            Frame.BackgroundColor3 = Color3.fromRGB(16,16,23)
            Frame.Size = UDim2.new(1,-10,0,56)
            Instance.new("UICorner", Frame).CornerRadius = UDim.new(0,10)
            
            local Label = Instance.new("TextLabel", Frame)
            Label.Text = text
            Label.Position = UDim2.new(0,16,0,0)
            Label.Size = UDim2.new(0.7,0,1,0)
            Label.BackgroundTransparency = 1
            Label.Font = Enum.Font.GothamBold
            Label.TextColor3 = Color3.fromRGB(255,255,255)
            Label.TextXAlignment = Enum.TextXAlignment.Left

            -- Switch logic (مختصر)
            local enabled = default
            local Switch = Instance.new("TextButton", Frame)
            Switch.Position = UDim2.new(1,-65,0.5,-14)
            Switch.Size = UDim2.new(0,50,0,28)
            Switch.Text = ""
            Switch.BackgroundColor3 = enabled and Color3.fromRGB(34,197,94) or Color3.fromRGB(40,40,55)
            Instance.new("UICorner", Switch).CornerRadius = UDim.new(0,14)

            Switch.MouseButton1Click:Connect(function()
                enabled = not enabled
                callback(enabled)
                TweenService:Create(Switch, TweenInfo.new(0.2), {BackgroundColor3 = enabled and Color3.fromRGB(34,197,94) or Color3.fromRGB(40,40,55)}):Play()
            end)
        end

        function tabAPI:AddSlider(text, min, max, default, callback)
            -- نفس فكرة السلايدر مالتك بس كدالة
            local Frame = Instance.new("Frame", Page)
            Frame.BackgroundColor3 = Color3.fromRGB(16,16,23)
            Frame.Size = UDim2.new(1,-10,0,68)
            Instance.new("UICorner", Frame).CornerRadius = UDim.new(0,10)
            
            local Label = Instance.new("TextLabel", Frame)
            Label.Text = text..": "..default
            Label.Position = UDim2.new(0,16,0,8)
            Label.Size = UDim2.new(1,-32,0,20)
            Label.BackgroundTransparency = 1
            Label.TextColor3 = Color3.fromRGB(200,200,220)
            -- باقي منطق السحب...
        end

        function tabAPI:AddButton(text, callback)
            local Btn = Instance.new("TextButton", Page)
            Btn.Size = UDim2.new(1,-10,0,44)
            Btn.Text = text
            Btn.BackgroundColor3 = Accent
            Btn.Font = Enum.Font.GothamBold
            Btn.TextColor3 = Color3.fromRGB(255,255,255)
            Instance.new("UICorner", Btn).CornerRadius = UDim.new(0,10)
            Btn.MouseButton1Click:Connect(callback)
        end

        function tabAPI:AddDropdown(text, options, callback)
            local Btn = Instance.new("TextButton", Page)
            Btn.Size = UDim2.new(1,-10,0,46)
            Btn.Text = text.." v"
            Btn.BackgroundColor3 = Color3.fromRGB(16,16,23)
            Instance.new("UICorner", Btn).CornerRadius = UDim.new(0,10)
            -- منطق الدروب داون مالك القديم هنا
        end

        return tabAPI
    end

    -- سحب النافذة
    local dragging
    MainFrame.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then dragging = true end
    end)
    UserInputService.InputEnded:Connect(function() dragging = false end)

    return self
end

return KitagawaUI
