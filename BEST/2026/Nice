            local Lbl = Instance.new("TextLabel")
            Lbl.Size = UDim2.new(1, 0, 1, 0)
            Lbl.BackgroundTransparency = 1
            Lbl.Text = "-- " .. string.upper(Name or "SECTION") .. " --"
            Lbl.TextColor3 = CurrentTheme.SubText
            Lbl.TextSize = 11
            Lbl.Font = Enum.Font.GothamBold
            Lbl.Parent = SecFrame

            return SecFrame
        end

        return TabObj
    end

    return WindowObj
end

-- ================================================================
-- 4. NOTIFICATION SYSTEM
-- ================================================================
function Library:Notify(Config)
    Config = Config or {}
    local NotifFrame = Instance.new("Frame")
    NotifFrame.Size = UDim2.new(0, 240, 0, 55)
    NotifFrame.Position = UDim2.new(1, 10, 1, -70)
    NotifFrame.BackgroundColor3 = Library.Themes[Library.CurrentTheme].Secondary
    NotifFrame.BorderColor3 = Library.Themes[Library.CurrentTheme].Border
    NotifFrame.Parent = ScreenGui
    Instance.new("UICorner", NotifFrame).CornerRadius = UDim.new(0, 8)

    local NTitle = Instance.new("TextLabel")
    NTitle.Size = UDim2.new(1, -16, 0, 20)
    NTitle.Position = UDim2.new(0, 10, 0, 4)
    NTitle.BackgroundTransparency = 1
    NTitle.Text = Config.Title or "Notification"
    NTitle.TextColor3 = Library.Themes[Library.CurrentTheme].Accent
    NTitle.TextSize = 13
    NTitle.Font = Enum.Font.GothamBold
    NTitle.TextXAlignment = Enum.TextXAlignment.Left
    NTitle.Parent = NotifFrame

    local NContent = Instance.new("TextLabel")
    NContent.Size = UDim2.new(1, -16, 0, 26)
    NContent.Position = UDim2.new(0, 10, 0, 24)
    NContent.BackgroundTransparency = 1
    NContent.Text = Config.Content or ""
    NContent.TextColor3 = Library.Themes[Library.CurrentTheme].Text
    NContent.TextSize = 11
    NContent.Font = Enum.Font.Gotham
    NContent.TextXAlignment = Enum.TextXAlignment.Left
    NContent.Parent = NotifFrame

    Tween(NotifFrame, TweenInfo.new(0.3, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {Position = UDim2.new(1, -250, 1, -70)})

    task.delay(Config.Duration or 3, function()
        local tw = Tween(NotifFrame, TweenInfo.new(0.3, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {Position = UDim2.new(1, 10, 1, -70)})
        tw.Completed:Connect(function() NotifFrame:Destroy() end)
    end)
end

return Library
