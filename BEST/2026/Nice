    local card = Util.Create("Frame", {
        Size = UDim2.fromOffset(320, 0),
        AutomaticSize = Enum.AutomaticSize.Y,
        BackgroundColor3 = theme.Background2,
        Parent = NotificationManager.Holder
    })
    Util.Corner(card, 14)
    Util.Stroke(card, theme.Border, 1, 0.3)
    Util.Padding(card, 14,12,14,12)

    local layout = Util.List(card, Enum.FillDirection.Vertical, 4)

    local title = Util.Create("TextLabel", {
        Text = opts.Title or "Notification",
        Font = Enum.Font.GothamBold,
        TextSize = 14,
        TextColor3 = theme.Text,
        TextXAlignment = Enum.TextXAlignment.Left,
        BackgroundTransparency = 1,
        Size = UDim2.new(1,0,0,18),
        LayoutOrder = 1,
        Parent = card
    })

    local content = Util.Create("TextLabel", {
        Text = opts.Content or "",
        Font = Enum.Font.Gotham,
        TextSize = 12,
        TextColor3 = theme.TextDim,
        TextXAlignment = Enum.TextXAlignment.Left,
        TextWrapped = true,
        BackgroundTransparency = 1,
        AutomaticSize = Enum.AutomaticSize.Y,
        Size = UDim2.new(1,0,0,0),
        LayoutOrder = 2,
        Parent = card
    })

    card.Size = UDim2.fromOffset(320, 70)
    card.Position = UDim2.new(0,400,0,0)
    Anim.Tween(card, {Position = UDim2.new(0,0,0,0)}, 0.4, Enum.EasingStyle.Back)

    task.delay(opts.Duration or 4, function()
        if card.Parent then
            local tw = Anim.Tween(card, {BackgroundTransparency = 1}, 0.3)
            tw.Completed:Wait()
            card:Destroy()
        end
    end)
end

