-- KitagawaUI - Library v1.0
-- مكتبة واجهات نظيفة مستوحاة من KitagawaHub
local KitagawaUI = {}
KitagawaUI.__index = KitagawaUI

local TweenService = game:GetService("TweenService")
local Players = game:GetService("Players")

local Themes = {
    BlueSpace = {Color3.fromRGB(0,150,255), Color3.fromRGB(0,70,200), "Blue Space"},
    PurpleCyber = {Color3.fromRGB(168,85,247), Color3.fromRGB(100,30,180), "Purple Cyber"},
    AcidLime = {Color3.fromRGB(34,197,94), Color3.fromRGB(20,100,50), "Acid Lime"},
    FieryRose = {Color3.fromRGB(236,72,153), Color3.fromRGB(150,20,80), "Fiery Rose"},
    AmberNeon = {Color3.fromRGB(245,158,11), Color3.fromRGB(160,80,0), "Amber Neon"},
}

function KitagawaUI:CreateWindow(config)
    local self = setmetatable({}, KitagawaUI)
    self.Accent = Themes.BlueSpace[1]
    self.Tabs = {}

    -- هنا بناء الـ MainFrame والـ Shadow والـ Sidebar
    -- نفس ستايل سكربتك القديم بس بدون هوس
    local ScreenGui = Instance.new("ScreenGui")
    ScreenGui.Name = config.Name or "KitagawaHub"
    ScreenGui.Parent = game.CoreGui
    ScreenGui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling

    local MainFrame = Instance.new("Frame")
    MainFrame.Name = "MainFrame"
    MainFrame.Parent = ScreenGui
    MainFrame.BackgroundColor3 = Color3.fromRGB(11,11,16)
    MainFrame.Size = UDim2.new(0,640,0,420)
    MainFrame.Position = UDim2.new(0.5, -320, 0.5, -210)
    MainFrame.AnchorPoint = Vector2.new(0,0)
    Instance.new("UICorner", MainFrame).CornerRadius = UDim.new(0,14)

    self.MainFrame = MainFrame
    self.ScreenGui = ScreenGui

    -- Sidebar
    local Sidebar = Instance.new("Frame")
    Sidebar.Parent = MainFrame
    Sidebar.Size = UDim2.new(0,170,1,0)
    Sidebar.BackgroundColor3 = Color3.fromRGB(15,15,22)
    Instance.new("UICorner", Sidebar).CornerRadius = UDim.new(0,14)
    self.Sidebar = Sidebar

    -- Content
    local ContentArea = Instance.new("Frame")
    ContentArea.Parent = MainFrame
    ContentArea.BackgroundTransparency = 1
    ContentArea.Position = UDim2.new(0,185,0,15)
    ContentArea.Size = UDim2.new(1, -200, 1, -30)
    self.ContentArea = ContentArea

    local TabContainer = Instance.new("Frame")
    TabContainer.Parent = Sidebar
    TabContainer.BackgroundTransparency = 1
    TabContainer.Position = UDim2.new(0,12,0,70)
    TabContainer.Size = UDim2.new(1, -24, 1, -85)
    local List = Instance.new("UIListLayout", TabContainer)
    List.Padding = UDim.new(0,10)
    self.TabContainer = TabContainer

    return self
end

function KitagawaUI:CreateTab(name)
    local TabButton = Instance.new("TextButton")
    TabButton.Parent = self.TabContainer
    TabButton.Size = UDim2.new(1,0,0,40)
    TabButton.Text = name
    TabButton.BackgroundColor3 = Color3.fromRGB(20,20,28)
    TabButton.TextColor3 = Color3.fromRGB(150,150,170)
    TabButton.Font = Enum.Font.GothamSemibold
    TabButton.TextSize = 14
    Instance.new("UICorner", TabButton).CornerRadius = UDim.new(0,10)

    local Page = Instance.new("Frame")
    Page.Parent = self.ContentArea
    Page.BackgroundTransparency = 1
    Page.Size = UDim2.new(1,0,1,0)
    Page.Visible = #self.Tabs == 0

    TabButton.MouseButton1Click:Connect(function()
        for _, t in pairs(self.Tabs) do
            t.Page.Visible = false
            TweenService:Create(t.Button, TweenInfo.new(0.2), {BackgroundColor3 = Color3.fromRGB(20,20,28)}):Play()
        end
        Page.Visible = true
        TweenService:Create(TabButton, TweenInfo.new(0.2), {BackgroundColor3 = self.Accent}):Play()
    end)

    if #self.Tabs == 0 then
        TabButton.BackgroundColor3 = self.Accent
        TabButton.TextColor3 = Color3.fromRGB(255,255,255)
    end

    local tabObj = {Button = TabButton, Page = Page}
    table.insert(self.Tabs, tabObj)

    -- API مال التاب
    local TabAPI = {}

    function TabAPI:CreateToggle(text, default, callback)
        -- يبني توكل مثل مالتك بالضبط مع Animation
        local Frame = Instance.new("Frame")
        Frame.Parent = Page
        Frame.BackgroundColor3 = Color3.fromRGB(16,16,23)
        Frame.Size = UDim2.new(0.96,0,0,56)
        Instance.new("UICorner", Frame).CornerRadius = UDim.new(0,10)
        --... كود التوكل والانميشن...
        return Frame
    end

    function TabAPI:CreateSlider(text, min, max, default, callback)
        -- يبني سلايدر مثل Speed Slider مالتك
        return {}
    end

    function TabAPI:CreateDropdown(text, options, callback)
        -- يبني دروب داون مثل WinsFarmer
        return {}
    end

    function TabAPI:CreateButton(text, callback)
        local Btn = Instance.new("TextButton")
        Btn.Parent = Page
        Btn.Size = UDim2.new(0.96,0,0,44)
        Btn.Text = text
        Btn.BackgroundColor3 = self.Accent
        Instance.new("UICorner", Btn).CornerRadius = UDim.new(0,10)
        Btn.MouseButton1Click:Connect(callback)
        return Btn
    end

    return TabAPI
end

function KitagawaUI:SetTheme(themeName)
    local theme = Themes[themeName]
    if theme then
        self.Accent = theme[1]
        -- يحدث كل الالوان
    end
end

return KitagawaUI
