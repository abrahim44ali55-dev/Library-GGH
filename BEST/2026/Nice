-- =====================================================================
-- Universal Script Library - Full All-In-One Script (All 7 Elements)
-- =====================================================================
local TweenService = game:GetService("TweenService")
local CoreGui = game:GetService("CoreGui")
local UserInputService = game:GetService("UserInputService")
local Players = game:GetService("Players")

local Library = {}
Library.__index = Library

function Library:Create(config)
	config = config or {}
	local title = config.Title or "Global Control Panel"
	local description = config.Description or "Advanced System"
	local toggleKey = config.Keybind or Enum.KeyCode.RightShift
	local currentTheme = {
		Bg = Color3.fromRGB(15, 15, 18),
		Top = Color3.fromRGB(22, 22, 26),
		Elem = Color3.fromRGB(26, 26, 32),
		Text = Color3.fromRGB(240, 240, 245),
		Sub = Color3.fromRGB(140, 140, 155),
		Accent = Color3.fromRGB(0, 162, 255)
	}

	if CoreGui:FindFirstChild("UniversalScriptHub") then CoreGui["UniversalScriptHub"]:Destroy() end
	if CoreGui:FindFirstChild("UniversalScriptHub_Notifications") then CoreGui["UniversalScriptHub_Notifications"]:Destroy() end

	local ScreenGui = Instance.new("ScreenGui")
	ScreenGui.Name = "UniversalScriptHub"
	ScreenGui.ResetOnSpawn = false
	pcall(function() ScreenGui.Parent = CoreGui end)
	if not ScreenGui.Parent then ScreenGui.Parent = Players.LocalPlayer:WaitForChild("PlayerGui") end

	local NotifScreenGui = Instance.new("ScreenGui")
	NotifScreenGui.Name = "UniversalScriptHub_Notifications"
	NotifScreenGui.ResetOnSpawn = false
	pcall(function() NotifScreenGui.Parent = CoreGui end)
	if not NotifScreenGui.Parent then NotifScreenGui.Parent = Players.LocalPlayer:WaitForChild("PlayerGui") end

	local ActiveNotifHolder = Instance.new("Frame")
	ActiveNotifHolder.Size = UDim2.new(0, 260, 1, 0)
	ActiveNotifHolder.Position = UDim2.new(0, 15, 0, 0)
	ActiveNotifHolder.BackgroundTransparency = 1
	ActiveNotifHolder.Parent = NotifScreenGui

	local NotifLayout = Instance.new("UIListLayout")
	NotifLayout.SortOrder = Enum.SortOrder.LayoutOrder
	NotifLayout.VerticalAlignment = Enum.VerticalAlignment.Bottom
	NotifLayout.Padding = UDim.new(0, 8)
	NotifLayout.Parent = ActiveNotifHolder

	local function Notify(titleText, descText, duration)
		duration = duration or 3
		local NotifBox = Instance.new("Frame")
		NotifBox.Size = UDim2.new(1, 0, 0, 55)
		NotifBox.BackgroundColor3 = currentTheme.Top
		NotifBox.Position = UDim2.new(-1.2, 0, 0, 0)
		NotifBox.Parent = ActiveNotifHolder
		Instance.new("UICorner", NotifBox).CornerRadius = UDim.new(0, 8)

		local NTitle = Instance.new("TextLabel")
		NTitle.Size = UDim2.new(1, -15, 0, 20)
		NTitle.Position = UDim2.new(0, 12, 0, 6)
		NTitle.BackgroundTransparency = 1
		NTitle.Text = titleText
		NTitle.TextColor3 = currentTheme.Accent
		NTitle.TextSize = 12
		NTitle.Font = Enum.Font.GothamBold
		NTitle.Parent = NotifBox

		local NDesc = Instance.new("TextLabel")
		NDesc.Size = UDim2.new(1, -15, 0, 20)
		NDesc.Position = UDim2.new(0, 12, 0, 26)
		NDesc.BackgroundTransparency = 1
		NDesc.Text = descText
		NDesc.TextColor3 = currentTheme.Text
		NDesc.TextSize = 11
		NDesc.Font = Enum.Font.Gotham
		NDesc.Parent = NotifBox

		TweenService:Create(NotifBox, TweenInfo.new(0.3, Enum.EasingStyle.Back), {Position = UDim2.new(0, 0, 0, 0)}):Play()
		task.spawn(function()
			task.wait(duration)
			TweenService:Create(NotifBox, TweenInfo.new(0.3), {Position = UDim2.new(-1.2, 0, 0, 0)}):Play()
			task.wait(0.3)
			NotifBox:Destroy()
		end)
	end

	local MainFrame = Instance.new("Frame")
	MainFrame.Size = UDim2.new(0, 500, 0, 340)
	MainFrame.Position = UDim2.new(0.5, -250, 0.5, -170)
	MainFrame.BackgroundColor3 = currentTheme.Bg
	MainFrame.Visible = true
	MainFrame.Parent = ScreenGui
	Instance.new("UICorner", MainFrame).CornerRadius = UDim.new(0, 12)

	local UIStroke = Instance.new("UIStroke")
	UIStroke.Thickness = 2.5
	UIStroke.Color = currentTheme.Accent
	UIStroke.Parent = MainFrame

	local TopBar = Instance.new("Frame")
	TopBar.Size = UDim2.new(1, 0, 0, 38)
	TopBar.BackgroundColor3 = currentTheme.Top
	TopBar.Parent = MainFrame
	Instance.new("UICorner", TopBar).CornerRadius = UDim.new(0, 12)

	local TitleLabel = Instance.new("TextLabel")
	TitleLabel.Size = UDim2.new(1, -50, 1, 0)
	TitleLabel.Position = UDim2.new(0, 12, 0, 0)
	TitleLabel.BackgroundTransparency = 1
	TitleLabel.Text = title .. " | " .. description
	TitleLabel.TextColor3 = currentTheme.Text
	TitleLabel.TextSize = 11
	TitleLabel.Font = Enum.Font.GothamBold
	TitleLabel.TextXAlignment = Enum.TextXAlignment.Left
	TitleLabel.Parent = TopBar

	local CloseButton = Instance.new("TextButton")
	CloseButton.Size = UDim2.new(0, 24, 0, 24)
	CloseButton.Position = UDim2.new(1, -32, 0, 7)
	CloseButton.BackgroundColor3 = currentTheme.Elem
	CloseButton.Text = "×"
	CloseButton.TextColor3 = currentTheme.Text
	CloseButton.TextSize = 15
	CloseButton.Font = Enum.Font.GothamBold
	CloseButton.Parent = TopBar
	Instance.new("UICorner", CloseButton).CornerRadius = UDim.new(0, 6)

	CloseButton.MouseButton1Click:Connect(function() ScreenGui:Destroy() NotifScreenGui:Destroy() end)

	local ContainerHolder = Instance.new("ScrollingFrame")
	ContainerHolder.Size = UDim2.new(1, -20, 1, -50)
	ContainerHolder.Position = UDim2.new(0, 10, 0, 45)
	ContainerHolder.BackgroundTransparency = 1
	ContainerHolder.BorderSizePixel = 0
	ContainerHolder.ScrollBarThickness = 4
	ContainerHolder.Parent = MainFrame

	local ContainerLayout = Instance.new("UIListLayout")
	ContainerLayout.SortOrder = Enum.SortOrder.LayoutOrder
	ContainerLayout.Padding = UDim.new(0, 8)
	ContainerLayout.Parent = ContainerHolder

	ContainerLayout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
		ContainerHolder.CanvasSize = UDim2.new(0, 0, 0, ContainerLayout.AbsoluteContentSize.Y + 20)
	end)

	local WindowObj = {}

	-- 1. زر عادي
	function WindowObj:AddButton(name, desc, callback)
		local Btn = Instance.new("TextButton")
		Btn.Size = UDim2.new(1, 0, 0, 40)
		Btn.BackgroundColor3 = currentTheme.Elem
		Btn.Text = ""
		Btn.Parent = ContainerHolder
		Instance.new("UICorner", Btn).CornerRadius = UDim.new(0, 6)

		local Txt = Instance.new("TextLabel")
		Txt.Size = UDim2.new(1, -15, 1, 0)
		Txt.Position = UDim2.new(0, 10, 0, 0)
		Txt.BackgroundTransparency = 1
		Txt.Text = name .. " - " .. desc
		Txt.TextColor3 = currentTheme.Text
		Txt.TextSize = 11
		Txt.Font = Enum.Font.GothamBold
		Txt.TextXAlignment = Enum.TextXAlignment.Left
		Txt.Parent = Btn

		Btn.MouseButton1Click:Connect(function() if callback then callback() end end)
	end

	-- 2. تكت بوتون
	function WindowObj:AddTicketButton(name, desc, btnText, callback)
		local Frame = Instance.new("Frame")
		Frame.Size = UDim2.new(1, 0, 0, 40)
		Frame.BackgroundColor3 = currentTheme.Elem
		Frame.Parent = ContainerHolder
		Instance.new("UICorner", Frame).CornerRadius = UDim.new(0, 6)

		local Txt = Instance.new("TextLabel")
		Txt.Size = UDim2.new(1, -100, 1, 0)
		Txt.Position = UDim2.new(0, 10, 0, 0)
		Txt.BackgroundTransparency = 1
		Txt.Text = name
		Txt.TextColor3 = currentTheme.Text
		Txt.TextSize = 11
		Txt.Font = Enum.Font.GothamBold
		Txt.TextXAlignment = Enum.TextXAlignment.Left
		Txt.Parent = Frame

		local Action = Instance.new("TextButton")
		Action.Size = UDim2.new(0, 80, 0, 26)
		Action.Position = UDim2.new(1, -90, 0.5, -13)
		Action.BackgroundColor3 = currentTheme.Accent
		Action.Text = btnText
		Action.TextColor3 = Color3.fromRGB(255, 255, 255)
		Action.TextSize = 10
		Action.Font = Enum.Font.GothamBold
		Action.Parent = Frame
		Instance.new("UICorner", Action).CornerRadius = UDim.new(0, 4)

		Action.MouseButton1Click:Connect(function() if callback then callback() end end)
	end

	-- 3. توجل
	function WindowObj:AddToggle(name, desc, default, callback)
		local toggled = default
		local Btn = Instance.new("TextButton")
		Btn.Size = UDim2.new(1, 0, 0, 40)
		Btn.BackgroundColor3 = currentTheme.Elem
		Btn.Text = ""
		Btn.Parent = ContainerHolder
		Instance.new("UICorner", Btn).CornerRadius = UDim.new(0, 6)

		local Txt = Instance.new("TextLabel")
		Txt.Size = UDim2.new(1, -60, 1, 0)
		Txt.Position = UDim2.new(0, 10, 0, 0)
		Txt.BackgroundTransparency = 1
		Txt.Text = name
		Txt.TextColor3 = currentTheme.Text
		Txt.TextSize = 11
		Txt.Font = Enum.Font.GothamBold
		Txt.TextXAlignment = Enum.TextXAlignment.Left
		Txt.Parent = Btn

		local Switch = Instance.new("Frame")
		Switch.Size = UDim2.new(0, 34, 0, 18)
		Switch.Position = UDim2.new(1, -44, 0.5, -9)
		Switch.BackgroundColor3 = toggled and currentTheme.Accent or Color3.fromRGB(50, 50, 60)
		Switch.Parent = Btn
		Instance.new("UICorner", Switch).CornerRadius = UDim.new(1, 0)

		Btn.MouseButton1Click:Connect(function()
			toggled = not toggled
			Switch.BackgroundColor3 = toggled and currentTheme.Accent or Color3.fromRGB(50, 50, 60)
			if callback then callback(toggled) end
		end)
	end

	-- 4. تكس بوكس (خانة كتابة)
	function WindowObj:AddTextBox(name, placeholder, callback)
		local Frame = Instance.new("Frame")
		Frame.Size = UDim2.new(1, 0, 0, 40)
		Frame.BackgroundColor3 = currentTheme.Elem
		Frame.Parent = ContainerHolder
		Instance.new("UICorner", Frame).CornerRadius = UDim.new(0, 6)

		local Txt = Instance.new("TextLabel")
		Txt.Size = UDim2.new(1, -130, 1, 0)
		Txt.Position = UDim2.new(0, 10, 0, 0)
		Txt.BackgroundTransparency = 1
		Txt.Text = name
		Txt.TextColor3 = currentTheme.Text
		Txt.TextSize = 11
		Txt.Font = Enum.Font.GothamBold
		Txt.TextXAlignment = Enum.TextXAlignment.Left
		Txt.Parent = Frame

		local Box = Instance.new("TextBox")
		Box.Size = UDim2.new(0, 110, 0, 26)
		Box.Position = UDim2.new(1, -120, 0.5, -13)
		Box.BackgroundColor3 = currentTheme.Top
		Box.PlaceholderText = placeholder
		Box.Text = ""
		Box.TextColor3 = currentTheme.Text
		Box.TextSize = 10
		Box.Parent = Frame
		Instance.new("UICorner", Box).CornerRadius = UDim.new(0, 4)

		Box.FocusLost = function(enter)
			if callback then callback(Box.Text, enter) end
		end
	end

	-- 5. كي بيند (مفتاح الاختصار)
	function WindowObj:AddKeybind(name, defaultKey, callback)
		local currentKey = defaultKey
		local listening = false

		local Frame = Instance.new("Frame")
		Frame.Size = UDim2.new(1, 0, 0, 40)
		Frame.BackgroundColor3 = currentTheme.Elem
		Frame.Parent = ContainerHolder
		Instance.new("UICorner", Frame).CornerRadius = UDim.new(0, 6)

		local Txt = Instance.new("TextLabel")
		Txt.Size = UDim2.new(1, -110, 1, 0)
		Txt.Position = UDim2.new(0, 10, 0, 0)
		Txt.BackgroundTransparency = 1
		Txt.Text = name
		Txt.TextColor3 = currentTheme.Text
		Txt.TextSize = 11
		Txt.Font = Enum.Font.GothamBold
		Txt.TextXAlignment = Enum.TextXAlignment.Left
		Txt.Parent = Frame

		local KeyBtn = Instance.new("TextButton")
		KeyBtn.Size = UDim2.new(0, 90, 0, 26)
		KeyBtn.Position = UDim2.new(1, -100, 0.5, -13)
		KeyBtn.BackgroundColor3 = currentTheme.Top
		KeyBtn.Text = tostring(currentKey.Name)
		KeyBtn.TextColor3 = currentTheme.Accent
		KeyBtn.TextSize = 10
		KeyBtn.Font = Enum.Font.GothamBold
		KeyBtn.Parent = Frame
		Instance.new("UICorner", KeyBtn).CornerRadius = UDim.new(0, 4)

		KeyBtn.MouseButton1Click:Connect(function()
			if listening then return end
			listening = true
			KeyBtn.Text = "..."
			local conn
			conn = UserInputService.InputBegan:Connect(function(input)
				if input.UserInputType == Enum.UserInputType.Keyboard then
					currentKey = input.KeyCode
					KeyBtn.Text = tostring(currentKey.Name)
					listening = false
					conn:Disconnect()
				end
			end)
		end)

		UserInputService.InputBegan:Connect(function(input, gp)
			if not gp and input.KeyCode == currentKey then
				if callback then callback(currentKey) end
			end
		end)
	end

	-- 6. سلايدر (Slider)
	function WindowObj:AddSlider(name, min, max, default, callback)
		local val = default
		local Frame = Instance.new("Frame")
		Frame.Size = UDim2.new(1, 0, 0, 50)
		Frame.BackgroundColor3 = currentTheme.Elem
		Frame.Parent = ContainerHolder
		Instance.new("UICorner", Frame).CornerRadius = UDim.new(0, 6)

		local Txt = Instance.new("TextLabel")
		Txt.Size = UDim2.new(1, -60, 0, 20)
		Txt.Position = UDim2.new(0, 10, 0, 5)
		Txt.BackgroundTransparency = 1
		Txt.Text = name
		Txt.TextColor3 = currentTheme.Text
		Txt.TextSize = 11
		Txt.Font = Enum.Font.GothamBold
		Txt.TextXAlignment = Enum.TextXAlignment.Left
		Txt.Parent = Frame

		local ValLbl = Instance.new("TextLabel")
		ValLbl.Size = UDim2.new(0, 50, 0, 20)
		ValLbl.Position = UDim2.new(1, -60, 0, 5)
		ValLbl.BackgroundTransparency = 1
		ValLbl.Text = tostring(val)
		ValLbl.TextColor3 = currentTheme.Accent
		ValLbl.TextSize = 11
		ValLbl.Font = Enum.Font.GothamBold
		ValLbl.TextXAlignment = Enum.TextXAlignment.Right
		ValLbl.Parent = Frame

		local Bar = Instance.new("Frame")
		Bar.Size = UDim2.new(1, -20, 0, 6)
		Bar.Position = UDim2.new(0, 10, 0, 32)
		Bar.BackgroundColor3 = Color3.fromRGB(45, 45, 55)
		Bar.Parent = Frame
		Instance.new("UICorner", Bar).CornerRadius = UDim.new(1, 0)

		local Fill = Instance.new("Frame")
		Fill.Size = UDim2.new((val - min)/(max - min), 0, 1, 0)
		Fill.BackgroundColor3 = currentTheme.Accent
		Fill.Parent = Bar
		Instance.new("UICorner", Fill).CornerRadius = UDim.new(1, 0)

		local dragging = false
		Bar.InputBegan:Connect(function(input)
			if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then dragging = true end
		end)
		UserInputService.InputEnded:Connect(function(input)
			if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then dragging = false end
		end)
		UserInputService.InputChanged:Connect(function(input)
			if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
				local pos = math.clamp((input.Position.X - Bar.AbsolutePosition.X) / Bar.AbsoluteSize.X, 0, 1)
				val = math.floor(min + ((max - min) * pos))
				Fill.Size = UDim2.new(pos, 0, 1, 0)
				ValLbl.Text = tostring(val)
				if callback then callback(val) end
			end
		end)
	end

	-- 7. دروب داون (Dropdown)
	function WindowObj:AddDropdown(name, list, callback)
		local isOpen = false
		local Frame = Instance.new("Frame")
		Frame.Size = UDim2.new(1, 0, 0, 40)
		Frame.BackgroundColor3 = currentTheme.Elem
		Frame.ClipsDescendants = true
		Frame.Parent = ContainerHolder
		Instance.new("UICorner", Frame).CornerRadius = UDim.new(0, 6)

		local Btn = Instance.new("TextButton")
		Btn.Size = UDim2.new(1, 0, 0, 40)
		Btn.BackgroundTransparency = 1
		Btn.Text = ""
		Btn.Parent = Frame

		local Txt = Instance.new("TextLabel")
		Txt.Size = UDim2.new(1, -20, 0, 40)
		Txt.Position = UDim2.new(0, 10, 0, 0)
		Txt.BackgroundTransparency = 1
		Txt.Text = name .. " (Click)"
		Txt.TextColor3 = currentTheme.Text
		Txt.TextSize = 11
		Txt.Font = Enum.Font.GothamBold
		Txt.TextXAlignment = Enum.TextXAlignment.Left
		Txt.Parent = Btn

		local ListHolder = Instance.new("ScrollingFrame")
		ListHolder.Size = UDim2.new(1, -20, 0, 110)
		ListHolder.Position = UDim2.new(0, 10, 0, 45)
		ListHolder.BackgroundTransparency = 1
		ListHolder.ScrollBarThickness = 3
		ListHolder.Parent = Frame

		local UIList = Instance.new("UIListLayout")
		UIList.Padding = UDim.new(0, 4)
		UIList.Parent = ListHolder

		UIList:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
			ListHolder.CanvasSize = UDim2.new(0, 0, 0, UIList.AbsoluteContentSize.Y)
		end)

		for _, opt in ipairs(list) do
			local OptBtn = Instance.new("TextButton")
			OptBtn.Size = UDim2.new(1, 0, 0, 26)
			OptBtn.BackgroundColor3 = currentTheme.Top
			OptBtn.Text = opt
			OptBtn.TextColor3 = currentTheme.Sub
			OptBtn.TextSize = 10
			OptBtn.Font = Enum.Font.GothamMedium
			OptBtn.Parent = ListHolder
			Instance.new("UICorner", OptBtn).CornerRadius = UDim.new(0, 4)

			OptBtn.MouseButton1Click:Connect(function()
				Txt.Text = name .. ": " .. opt
				isOpen = false
				TweenService:Create(Frame, TweenInfo.new(0.2), {Size = UDim2.new(1, 0, 0, 40)}):Play()
				if callback then callback(opt) end
			end)
		end

		Btn.MouseButton1Click:Connect(function()
			isOpen = not isOpen
			local target = isOpen and 160 or 40
			TweenService:Create(Frame, TweenInfo.new(0.2), {Size = UDim2.new(1, 0, 0, target)}):Play()
		end)
	end

	WindowObj.Notify = Notify
	return WindowObj
end

-- ==========================================
-- تشغيل العناصر السبعة بالكامل
-- ==========================================
local Window = Library:Create({ Title = "All Elements Hub", Description = "Test" })

Window:AddButton("Normal Button", "Clicks successfully", function()
	print("Button clicked")
end)

Window:AddTicketButton("Ticket Button", "Redeems code", "Claim", function()
	Window.Notify("System", "Claimed!", 2)
end)

Window:AddToggle("Auto Farm", "Enables farming", false, function(state)
	print("Toggle:", state)
end)

Window:AddTextBox("WalkSpeed Box", "Type speed...", function(text)
	print("Text entered:", text)
end)

Window:AddKeybind("Action Keybind", Enum.KeyCode.E, function(key)
	Window.Notify("Keybind", "Pressed key: " .. key.Name, 2)
end)

Window:AddSlider("JumpPower Slider", 50, 300, 50, function(val)
	print("Slider value:", val)
end)

Window:AddDropdown("Weapon Dropdown", {"Sword", "Bow", "Shield"}, function(choice)
	Window.Notify("Dropdown", "Chosen: " .. choice, 2)
end)
