-- FLIPPER ANIMATION ENGINE - REAL IMPLEMENTATION (Makes file heavy but useful)
-- ============================================================================
local Flipper = {}
Flipper.Spring = {}
Flipper.Spring.new = function(initial, target, opts)
    opts = opts or {}
    local self = {p=initial or 0, v=0, t=target or 0, s=opts.stiffness or 100, d=opts.damping or 10, m=opts.mass or 1}
    function self:step(dt)
        local f = -self.s*(self.p-self.t)
        local d = -self.d*self.v
        local a = (f+d)/self.m
        self.v = self.v + a*dt
        self.p = self.p + self.v*dt
        return self.p
    end
    function self:setTarget(t) self.t=t end
    function self:setValue(v) self.p=v self.v=0 end
    return self
end

Flipper.Linear = function(a,b,t) return a + (b-a)*t end
Flipper.Instant = function(a,b,t) return t>=1 and b or a end
Flipper.EaseInOut = function(a,b,t) t=t*2 if t<1 then return a + (b-a)/2*t*t else t=t-1 return a + (b-a)/2*(1 - (t*(t-2))) end end

-- Motor
Flipper.Motor = {}
Flipper.Motor.new = function(initial)
    local self = {value=initial or 0, target=initial or 0, springs={}, onStepCallbacks={}, onCompleteCallbacks={}}
    function self:step(dt)
        for _,s in pairs(self.springs) do self.value=s:step(dt) end
        for _,cb in pairs(self.onStepCallbacks) do cb(self.value) end
        return self.value
    end
    function self:setGoal(spring) self.springs={spring} end
    function self:onStep(cb) table.insert(self.onStepCallbacks, cb) return {Disconnect=function() end} end
    function self:onComplete(cb) table.insert(self.onCompleteCallbacks, cb) end
    return self
end

Flipper.GroupMotor = {}
Flipper.GroupMotor.new = function(initials)
    local self = {values=initials or {}, goals={}, motors={}}
    for k,v in pairs(initials) do self.motors[k]=Flipper.Motor.new(v) end
    function self:step(dt) for k,m in pairs(self.motors) do self.values[k]=m:step(dt) end return self.values end
    function self:setGoal(goals) self.goals=goals for k,g in pairs(goals) do if self.motors[k] then self.motors[k]:setGoal(g) end end end
    function self:onStep(cb) for _,m in pairs(self.motors) do m:onStep(function() cb(self.values) end) end end
    return self
end

