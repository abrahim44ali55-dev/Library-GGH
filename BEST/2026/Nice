-- PERFORMANCE UTILITIES - REAL CODE
NovaUI.Utils = {}
function NovaUI.Utils:Debounce(func, wait)
    local last = 0
    return function(...)
        local now = tick()
        if now - last >= wait then last = now return func(...) end
    end
end

function NovaUI.Utils:Throttle(func, wait)
    local last = 0
    local timeout
    return function(...)
        local args = {...}
        local now = tick()
        if now - last >= wait then last = now func(unpack(args)) end
    end
end

function NovaUI.Utils:DeepCopy(orig)
    local orig_type = type(orig)
    local copy
    if orig_type == 'table' then
        copy = {}
        for orig_key, orig_value in next, orig, nil do
            copy[NovaUI.Utils:DeepCopy(orig_key)] = NovaUI.Utils:DeepCopy(orig_value)
        end
        setmetatable(copy, NovaUI.Utils:DeepCopy(getmetatable(orig)))
    else
        copy = orig
    end
    return copy
end

function NovaUI.Utils:MergeTables(t1, t2)
    local result = NovaUI.Utils:DeepCopy(t1)
    for k,v in pairs(t2) do
        if type(v) == "table" and type(result[k]) == "table" then
            result[k] = NovaUI.Utils:MergeTables(result[k], v)
        else
            result[k] = v
        end
    end
    return result
end

function NovaUI.Utils:Clamp(val, min, max) return math.max(min, math.min(max, val)) end
function NovaUI.Utils:Lerp(a,b,t) return a + (b-a)*t end
function NovaUI.Utils:Round(num, decimals) local mult = 10^(decimals or 0) return math.floor(num*mult+0.5)/mult end
function NovaUI.Utils:FormatNumber(num) if num>=1000000 then return string.format("%.1fM", num/1000000) elseif num>=1000 then return string.format("%.1fK", num/1000) else return tostring(num) end end

-- MATH UTILITIES
NovaUI.Math = {}
function NovaUI.Math:Distance(a,b) return math.sqrt((a.X-b.X)^2 + (a.Y-b.Y)^2) end
function NovaUI.Math:Distance3D(a,b) return math.sqrt((a.X-b.X)^2 + (a.Y-b.Y)^2 + (a.Z-b.Z)^2) end
function NovaUI.Math:Angle(a,b) return math.atan2(b.Y-a.Y, b.X-a.X) end
function NovaUI.Math:RotatePoint(point, center, angle) local s=math.sin(angle) local c=math.cos(angle) local x=point.X-center.X local y=point.Y-center.Y return Vector2.new(x*c - y*s + center.X, x*s + y*c + center.Y) end
function NovaUI.Math:Bezier(t, p0,p1,p2,p3) local u=1-t local tt=t*t local uu=u*u local uuu=uu*u local ttt=tt*t local p = uuu*p0 p = p + 3*uu*t*p1 p = p + 3*u*tt*p2 p = p + ttt*p3 return p end

-- COLOR UTILITIES
NovaUI.Color = {}
function NovaUI.Color:RGBToHSV(r,g,b) return Color3.toHSV(Color3.fromRGB(r,g,b)) end
function NovaUI.Color:HSVToRGB(h,s,v) return Color3.fromHSV(h,s,v) end
function NovaUI.Color:Lerp(c1,c2,t) return Color3.new(c1.R + (c2.R-c1.R)*t, c1.G + (c2.G-c1.G)*t, c1.B + (c2.B-c1.B)*t) end
function NovaUI.Color:ToHex(c) return string.format("#%02X%02X%02X", math.floor(c.R*255), math.floor(c.G*255), math.floor(c.B*255)) end
function NovaUI.Color:FromHex(hex) hex=hex:gsub("#","") return Color3.fromRGB(tonumber("0x"..hex:sub(1,2)), tonumber("0x"..hex:sub(3,4)), tonumber("0x"..hex:sub(5,6))) end
function NovaUI.Color:AdjustBrightness(c, amount) local h,s,v=Color3.toHSV(c) return Color3.fromHSV(h,s, math.clamp(v+amount,0,1)) end
function NovaUI.Color:AdjustSaturation(c, amount) local h,s,v=Color3.toHSV(c) return Color3.fromHSV(h, math.clamp(s+amount,0,1), v) end

