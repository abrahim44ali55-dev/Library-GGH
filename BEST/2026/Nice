        function Tab:AddSlider(configs)
            local name = configs.Name or configs[1] or "Slider"
            local min = configs.Min or 0
            local max = configs.Max or 100
            local default = configs.Default or min
            local callback = configs.Callback or function() end
            local holder = Create("Frame", Container, {Size=UDim2.new(1,0,0,58), BackgroundColor3=Theme["Color Hub 2"], BackgroundTransparency=0.15})
            Make("Corner", holder, UDim.new(0,10)) Make("Stroke", holder, Theme["Color Stroke"])
            Create("TextLabel", holder, {Text=name, Font=Enum.Font.GothamSemibold, TextSize=13, TextColor3=Theme["Color Text"], BackgroundTransparency=1, Size=UDim2.new(1,-70,0,20), Position=UDim2.new(0,12,0,6), TextXAlignment="Left"})
            local valLabel = Create("TextLabel", holder, {Text=tostring(default), Font=Enum.Font.GothamBold, TextSize=13, TextColor3=Theme["Color Theme"], BackgroundTransparency=1, Size=UDim2.new(0,50,0,20), Position=UDim2.new(1,-60,0,6), TextXAlignment="Right"})
            local bg = Create("Frame", holder, {Size=UDim2.new(1,-24,0,8), Position=UDim2.new(0,12,0,36), BackgroundColor3=Color3.fromRGB(50,50,50)})
            Make("Corner", bg, UDim.new(1,0))
            local fill = Create("Frame", bg, {Size=UDim2.new((default-min)/(max-min),0,1,0), BackgroundColor3=Theme["Color Theme"]})
            Make("Corner", fill, UDim.new(1,0))
            local dragging=false
            local function update(input) local pos=math.clamp((input.Position.X-bg.AbsolutePosition.X)/bg.AbsoluteSize.X,0,1) local val=math.floor(min+(max-min)*pos) fill.Size=UDim2.new(pos,0,1,0) valLabel.Text=tostring(val) pcall(callback,val) end
            bg.InputBegan:Connect(function(i) if i.UserInputType==Enum.UserInputType.MouseButton1 then dragging=true end end)
            UserInputService.InputChanged:Connect(function(i) if dragging and i.UserInputType==Enum.UserInputType.MouseMovement then update(i) end end)
            UserInputService.InputEnded:Connect(function(i) dragging=false end)
            return {Set=function(_,v) fill.Size=UDim2.new((v-min)/(max-min),0,1,0) valLabel.Text=tostring(v) end, Destroy=function() holder:Destroy() end}
        end

