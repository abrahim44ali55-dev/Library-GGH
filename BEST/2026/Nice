function Library:CreateWindow(Settings)
    Settings = Settings or {}
    local Title = Settings.Title or "GGH HUB"
    local SubTitle = Settings.SubTitle or "v3.0 Engine"
    local Size = Settings.Size or UDim2.fromOffset(620, 500)
    local ThemeName = Settings.Theme or "Dark"
    local CurrentTheme = Library.Themes[ThemeName] or Library.Themes.Dark
    Library.CurrentTheme = ThemeName

    local MainFrame = Instance.new("Frame")
    MainFrame.Name = "MainFrame"
    MainFrame.Size = Size
