-- ========= نظام الاحجام الذكي =========
local DeviceSizes = {
    {Name = "Mobile_S", MaxWidth = 500, Size = UDim2.new(0, 360, 0, 310)},
    {Name = "Mobile_L", MaxWidth = 700, Size = UDim2.new(0, 420, 0, 350)},
    {Name = "Tablet", MaxWidth = 1000, Size = UDim2.new(0, 520, 0, 400)},
    {Name = "Laptop", MaxWidth = 1400, Size = UDim2.new(0, 640, 0, 420)},
    {Name = "Desktop", MaxWidth = 9999, Size = UDim2.new(0, 780, 0, 500)},
}

local function GetAutoSize()
    local viewport = workspace.CurrentCamera.ViewportSize
    local width = viewport.X
    for _, device in ipairs(DeviceSizes) do
        if width <= device.MaxWidth then
            return device.Size, device.Name
        end
    end
    return DeviceSizes[5].Size, "Desktop"
end

function KitagawaUI:New(config)
    config = config or {}
    local Title = config.Title or "KitagawaHub"
    local Accent = config.Accent or Color3.fromRGB(0,150,255)
    -- لو المطور حدد حجم، استخدمه، لو لا خلي الاوتو
    local MainSize, DeviceName = config.Size or GetAutoSize()
    local isMinimized = false
    local oldSize = MainSize

    print("[KitagawaUI] Device Detected:", DeviceName, "Size:", MainSize)

    local self = {}
    local ScreenGui = Instance.new("ScreenGui")
    ScreenGui.Name = "KitagawaUI"
    ScreenGui.Parent = CoreGui
    ScreenGui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
    ScreenGui.ResetOnSpawn = false

    local MainFrame = Instance.new("Frame")
    MainFrame.Name = "MainFrame"
    MainFrame.Parent = ScreenGui
    MainFrame.BackgroundColor3 = Color3.fromRGB(11,11,16)
    MainFrame.AnchorPoint = Vector2.new(0.5,0.5)
    MainFrame.Position = UDim2.new(0.5,0,0.5,0)
    MainFrame.Size = MainSize
    MainFrame.ClipsDescendants = false
    Instance.new("UICorner", MainFrame).CornerRadius = UDim.new(0,14)
    local Stroke = Instance.new("UIStroke", MainFrame)
    Stroke.Color = Color3.fromRGB(35,35,50)
    Stroke.Thickness = 1.5

    -- ===== TopBar للسحب =====
    local TopBar = Instance.new("Frame", MainFrame)
    TopBar.Name = "TopBar"
    TopBar.BackgroundTransparency = 1
    TopBar.Size = UDim2.new(1,0,0,50)
    TopBar.ZIndex = 10

    local TitleLabel = Instance.new("TextLabel", TopBar)
    TitleLabel.Size = UDim2.new(1,-90,1,0)
    TitleLabel.Position = UDim2.new(0,15,0,0)
    TitleLabel.BackgroundTransparency = 1
    TitleLabel.Text = Title.. " ["..DeviceName.."]"
    TitleLabel.Font = Enum.Font.GothamBold
    TitleLabel.TextColor3 = Color3.fromRGB(255,255,255)
    TitleLabel.TextSize = 18
    TitleLabel.TextXAlignment = Enum.TextXAlignment.Left

    -- ===== ازرار التحكم (تصغير و اغلاق) =====
    local Controls = Instance.new("Frame", TopBar)
    Controls.BackgroundTransparency = 1
    Controls.Position = UDim2.new(1,-75,0,10)
    Controls.Size = UDim2.new(0,65,0,30)

    local MinBtn = Instance.new("TextButton", Controls)
    MinBtn.Size = UDim2.new(0,28,0,28)
    MinBtn.Position = UDim2.new(0,0,0,0)
    MinBtn.Text = "—"
    MinBtn.Font = Enum.Font.GothamBold
    MinBtn.TextSize = 18
    MinBtn.BackgroundColor3 = Color3.fromRGB(25,25,30)
    MinBtn.TextColor3 = Color3.fromRGB(200,200,200)
    Instance.new("UICorner", MinBtn).CornerRadius = UDim.new(0,6)

    local CloseBtn = Instance.new("TextButton", Controls)
    CloseBtn.Size = UDim2.new(0,28,0,28)
    CloseBtn.Position = UDim2.new(0,35,0,0)
    CloseBtn.Text = "X"
    CloseBtn.Font = Enum.Font.GothamBold
    CloseBtn.TextSize = 16
    CloseBtn.BackgroundColor3 = Color3.fromRGB(35,20)
    CloseBtn.TextColor3 = Color3.fromRGB(255,90,90)
    Instance.new("UICorner", CloseBtn).CornerRadius = UDim.new(0,6)

    -- ===== نافذة تأكيد الاغلاق =====
    local ConfirmFrame = Instance.new("Frame", ScreenGui)
    ConfirmFrame.Size = UDim2.new(0,280,0,150)
    ConfirmFrame.Position = UDim2.new(0.5,0,0.5,0)
    ConfirmFrame.AnchorPoint = Vector2.new(0.5,0.5)
    ConfirmFrame.BackgroundColor3 = Color3.fromRGB(18,18,25)
    ConfirmFrame.Visible = false
    ConfirmFrame.ZIndex = 100
    Instance.new("UICorner", ConfirmFrame).CornerRadius = UDim.new(0,12)
    Instance.new("UIStroke", ConfirmFrame).Color = Color3.fromRGB(50,50,60)

    local ConfirmLabel = Instance.new("TextLabel", ConfirmFrame)
    ConfirmLabel.Text = KitagawaUI.Emojis.Warning.." تريد تسد الواجهة؟"
    ConfirmLabel.Size = UDim2.new(1,0,0,50)
    ConfirmLabel.BackgroundTransparency = 1
    ConfirmLabel.Font = Enum.Font.GothamBold
    ConfirmLabel.TextColor3 = Color3.fromRGB(255,255,255)
    ConfirmLabel.TextSize = 16

    local YesBtn = Instance.new("TextButton", ConfirmFrame)
    YesBtn.Text = KitagawaUI.Emojis.Check.." نعم"
    YesBtn.Position = UDim2.new(0,15,0,80)
    YesBtn.Size = UDim2.new(0,115,0,40)
    YesBtn.BackgroundColor3 = Color3.fromRGB(200,60,60)
    YesBtn.TextColor3 = Color3.fromRGB(255,255,255)
    YesBtn.Font = Enum.Font.GothamBold
    Instance.new("UICorner", YesBtn).CornerRadius = UDim.new(0,8)

    local NoBtn = Instance.new("TextButton", ConfirmFrame)
    NoBtn.Text = KitagawaUI.Emojis.Cross.." لا"
    NoBtn.Position = UDim2.new(1,-130,0,80)
    NoBtn.Size = UDim2.new(0,115,0,40)
    NoBtn.BackgroundColor3 = Color3.fromRGB(35,35,45)
    NoBtn.TextColor3 = Color3.fromRGB(255,255,255)
    NoBtn.Font = Enum.Font.GothamBold
    Instance.new("UICorner", NoBtn).CornerRadius = UDim.new(0,8)

    CloseBtn.MouseButton1Click:Connect(function() ConfirmFrame.Visible = true end)
    NoBtn.MouseButton1Click:Connect(function() ConfirmFrame.Visible = false end)
    YesBtn.MouseButton1Click:Connect(function() ScreenGui:Destroy() end)

    -- ===== منطق التصغير =====
    MinBtn.MouseButton1Click:Connect(function()
        isMinimized = not isMinimized
        if isMinimized then
            oldSize = MainFrame.Size
            TweenService:Create(MainFrame, TweenInfo.new(0.3, Enum.EasingStyle.Quart), {Size = UDim2.new(oldSize.X.Scale, oldSize.X.Offset, 0, 50)}):Play()
            MinBtn.Text = "□"
        else
            TweenService:Create(MainFrame, TweenInfo.new(0.3, Enum.EasingStyle.Quart), {Size = oldSize}):Play()
            MinBtn.Text = "—"
        end
    end)

    -- ===== منطق السحب الحقيقي =====
    local dragging, dragInput, dragStart, startPos
    TopBar.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            dragStart = input.Position
            startPos = MainFrame.Position
            input.Changed:Connect(function()
                if input.UserInputState == Enum.UserInputState.End then dragging = false end
            end)
        end
    end)
    TopBar.InputChanged:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then dragInput = input end
    end)
    UserInputService.InputChanged:Connect(function(input)
        if input == dragInput and dragging then
            local delta = input.Position - dragStart
            MainFrame.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
        end
    end)

    -- باقي الكود مال التابات مثل قبل...
    -- (اختصرتها هنا علمود لا يصير كلش طويل، بس انسخ نفس كود التابات من النسخة السابقة)

    return self
end

return KitagawaUI
