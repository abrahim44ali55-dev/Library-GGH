        pill.Size = UDim2.fromOffset(0,46)
        Anim.Tween(pill, {Size = UDim2.fromOffset(320,46)}, 0.4, Enum.EasingStyle.Back)
    end

    local function restore()
        pill.Visible = false
        main.Visible = true
        main.BackgroundTransparency = 1
        main.Size = UDim2.fromOffset(0,0)
        Anim.Tween(main, {Size = config.Size or UDim2.fromOffset(720,520), BackgroundTransparency = 0}, 0.45, Enum.EasingStyle.Back)
    end

