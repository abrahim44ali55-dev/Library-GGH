local function BuildWindow(gui, opts)
    local th=Theme.Current
    local main=Util:Create("Frame",{Name="GGH_Window",BackgroundColor3=th.Bg,BorderSizePixel=0,Size=opts.Size or UDim2.fromOffset(580,420),Position=opts.Position or UDim2.fromOffset(120,100),ClipsDescendants=false,ZIndex=2,Parent=gui})
