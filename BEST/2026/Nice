    local Controls = New("Frame", {Size=UDim2.new(0,80,0,32), Position=UDim2.new(1,-90,0,9), BackgroundTransparency=1, Parent=Top}, {New("UIListLayout", {FillDirection=Enum.FillDirection.Horizontal, Padding=UDim.new(0,8)})})
