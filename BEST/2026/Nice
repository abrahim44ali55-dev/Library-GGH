    Container.Size = UDim2.new(1,-174,1,-64)
    Container.Position = UDim2.new(0,166,0,58)
    Container.BackgroundTransparency = 1
    Container.ClipsDescendants = true
    Container.ZIndex = 1
    
    -- Center Top Button - Instant + Always Center
    local CenterTopButton = Instance.new("TextButton", ScreenGui)
    CenterTopButton.Name = "CenterTopButton"
    CenterTopButton.Size = UDim2.new(0,110,0,36)
    CenterTopButton.Position = UDim2.new(0.5, -55, 0, 20)
    CenterTopButton.AnchorPoint = Vector2.new(0.5,0)
    CenterTopButton.BackgroundColor3 = CurrentTheme.Accent
    CenterTopButton.BackgroundTransparency = 0.1
    CenterTopButton.Text = "GGH • Wind"
    CenterTopButton.Font = Enum.Font.GothamBold
    CenterTopButton.TextSize = 14
    CenterTopButton.TextColor3 = Color3.fromRGB(255,255,255)
    CenterTopButton.Visible = false
    CenterTopButton.ZIndex = 100
    CenterTopButton.AutoButtonColor = false
    Corner(CenterTopButton, 12)
    Stroke(CenterTopButton, CurrentTheme.Stroke, 1, 0.3)
    
    do
        local dragging = false
        local dragStart, startPos
        CenterTopButton.InputBegan:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                dragging = true
                dragStart = input.Position
                startPos = CenterTopButton.Position
            end
        end)
        UserInputService.InputChanged:Connect(function(input)
            if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
                local delta = input.Position - dragStart
                CenterTopButton.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
            end
        end)
        UserInputService.InputEnded:Connect(function(input) if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then dragging = false end end)
    end
    
    local ThemeOpen = false
    local SearchOpen = false
    ThemeBtn.MouseButton1Click:Connect(function()
        ThemeOpen = not ThemeOpen
        ThemeDropdown.Visible = ThemeOpen
        SearchBar.Visible = false
        SearchOpen = false
        if ThemeOpen then ThemeList.CanvasPosition = Vector2.new(0,0) task.wait(0.05) ThemeList.CanvasSize = UDim2.new(0,0,0,TL.AbsoluteContentSize.Y + 50) end
    end)
    SearchBtn.MouseButton1Click:Connect(function()
        SearchOpen = not SearchOpen
        SearchBar.Visible = SearchOpen
        ThemeDropdown.Visible = false
        ThemeOpen = false
    end)
    SearchClose.MouseButton1Click:Connect(function() SearchBar.Visible = false SearchOpen = false end)
    
    MinBtn.MouseButton1Click:Connect(function()
        if not minimized then
            minimized = true
            savedSize = Main.Size
            Main.Visible = false
            TabList.Visible = false
            Container.Visible = false
            ThemeDropdown.Visible = false
            SearchBar.Visible = false
            Shadow.Visible = false
            CenterTopButton.Visible = true
            CenterTopButton.Position = UDim2.new(0.5, -55, 0, 20)
            CenterTopButton.Size = UDim2.new(0,110,0,36)
        end
    end)
    
    local function RestoreWindow()
        if minimized then
            minimized = false
            local centerPos = UDim2.new(0.5, -Main.Size.X.Offset/2, 0.5, -Main.Size.Y.Offset/2)
            Main.Position = centerPos
            Main.Visible = true
            TabList.Visible = true
            Container.Visible = true
            Shadow.Visible = true
            Shadow.Position = UDim2.new(0, Main.Position.X.Offset -20, 0, Main.Position.Y.Offset -20)
            CenterTopButton.Visible = false
        end
    end
    CenterTopButton.MouseButton1Click:Connect(RestoreWindow)
    
    CloseBtn.MouseButton1Click:Connect(function() ScreenGui:Destroy() Shadow:Destroy() CenterTopButton:Destroy() end)
    
    -- Dragging - no clamp
    do
        local draggingMain = false
        local dragInput, dragStart, startPos
        Header.InputBegan:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                draggingMain = true
                dragStart = input.Position
                startPos = Main.Position
            end
        end)
        Header.InputChanged:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then dragInput = input end
        end)
        UserInputService.InputChanged:Connect(function(input)
            if input == dragInput and draggingMain and not minimized then
                local delta = input.Position - dragStart
                local newPos = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
                Main.Position = newPos
                Shadow.Position = UDim2.new(0, newPos.X.Offset -20, 0, newPos.Y.Offset -20)
            end
        end)
        UserInputService.InputEnded:Connect(function(input) if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then draggingMain = false end end)
    end
    
    -- Theme buttons
    for name, th in pairs(Themes) do
        local Btn = Instance.new("TextButton", ThemeList)
        Btn.Size = UDim2.new(1,0,0,36)
        Btn.BackgroundColor3 = th.ElementBg2
        Btn.BackgroundTransparency = 0.2
        Btn.Text = name
        Btn.Font = Enum.Font.GothamMedium
        Btn.TextSize = 12
        Btn.TextColor3 = th.Text
        Btn.ZIndex = 102
        Btn.LayoutOrder = 110
        Btn.AutoButtonColor = false
        Corner(Btn, 10)
        Btn.MouseButton1Click:Connect(function()
            CurrentTheme = th
            Main.BackgroundColor3 = th.MainBg
            Main.BackgroundTransparency = currentTransparency
            Header.BackgroundColor3 = th.HeaderBg
            HeaderFix.BackgroundColor3 = th.HeaderBg
            TabList.BackgroundColor3 = th.TabListBg
            ThemeDropdown.BackgroundColor3 = th.ElementBg
            CenterTopButton.BackgroundColor3 = th.Accent
            TitleLabel.TextColor3 = th.Text
            SubLabel.TextColor3 = th.SubText
            SearchBar.BackgroundColor3 = th.ElementBg
            for _, v in pairs(Main:GetDescendants()) do
                if v:IsA("TextLabel") or v:IsA("TextButton") then
                    if v.Name ~= "CenterTopButton" then
                        -- Keep theming
                    end
                end
            end
            ThemeDropdown.Visible = false
            ThemeOpen = false
        end)
    end
    
    local tabs = {}
    local firstTab = nil
    
    local Window = {}
    function Window:CreateTab(name, icon)
        local TabBtn = Instance.new("TextButton", TabList)
        TabBtn.Size = UDim2.new(1,0,0,38)
        TabBtn.BackgroundColor3 = CurrentTheme.ElementBg
        TabBtn.BackgroundTransparency = 0.4
        TabBtn.Text = (icon and icon.." " or "• ") .. name
        TabBtn.Font = Enum.Font.GothamMedium
        TabBtn.TextSize = 13
        TabBtn.TextColor3 = CurrentTheme.SubText
        TabBtn.TextXAlignment = Enum.TextXAlignment.Left
        TabBtn.ZIndex = 2
        TabBtn.AutoButtonColor = false
        Corner(TabBtn, 10)
        
        local TabPage = Instance.new("ScrollingFrame", Container)
        TabPage.Name = name
        TabPage.Size = UDim2.new(1,0,1,0)
        TabPage.BackgroundTransparency = 1
        TabPage.CanvasSize = UDim2.new(0,0,0,0)
        TabPage.AutomaticCanvasSize = Enum.AutomaticSize.Y
        TabPage.ScrollBarThickness = 3
        TabPage.ScrollBarImageColor3 = CurrentTheme.Accent
        TabPage.Visible = false
        TabPage.ClipsDescendants = true
        TabPage.ZIndex = 1
        local PageLayout = Instance.new("UIListLayout", TabPage)
        PageLayout.Padding = UDim.new(0,8)
        PageLayout.SortOrder = Enum.SortOrder.LayoutOrder
        local PagePad = Instance.new("UIPadding", TabPage)
        PagePad.PaddingTop = UDim.new(0,6) PagePad.PaddingBottom = UDim.new(0,20) PagePad.PaddingLeft = UDim.new(0,6) PagePad.PaddingRight = UDim.new(0,6)
        
        if not firstTab then
            firstTab = {btn=TabBtn, page=TabPage}
            TabPage.Visible = true
            TabBtn.BackgroundColor3 = CurrentTheme.Accent
            TabBtn.BackgroundTransparency = 0.1
            TabBtn.TextColor3 = Color3.fromRGB(255,255,255)
        end
        
        TabBtn.MouseButton1Click:Connect(function()
            for _, t in pairs(tabs) do
                t.page.Visible = false
                t.btn.BackgroundColor3 = CurrentTheme.ElementBg
                t.btn.BackgroundTransparency = 0.4
                t.btn.TextColor3 = CurrentTheme.SubText
            end
            TabPage.Visible = true
            TabBtn.BackgroundColor3 = CurrentTheme.Accent
            TabBtn.BackgroundTransparency = 0.1
            TabBtn.TextColor3 = Color3.fromRGB(255,255,255)
        end)
        
        -- Hover
        TabBtn.MouseEnter:Connect(function()
            if TabPage.Visible == false then
                Tween(TabBtn, {BackgroundTransparency = 0.2}, 0.2)
            end
        end)
        TabBtn.MouseLeave:Connect(function()
            if TabPage.Visible == false then
                Tween(TabBtn, {BackgroundTransparency = 0.4}, 0.2)
            end
        end)
        
        local Elements = {}
        local function AddSearch(frame, txt, typeName, tabName)
            -- search placeholder
        end
        
        local function CreateSection(Cfg)
            local Frame = Instance.new("Frame", TabPage)
            Frame.Size = UDim2.new(1,-8,0,32)
            Frame.BackgroundTransparency = 1
            local Label = Instance.new("TextLabel", Frame)
            Label.Size = UDim2.new(1,0,1,0)
            Label.BackgroundTransparency = 1
            Label.Text = Cfg.Title or "Section"
            Label.Font = Enum.Font.GothamBold
            Label.TextSize = 14
            Label.TextColor3 = CurrentTheme.Text
            Label.TextXAlignment = Enum.TextXAlignment.Left
            local Line = Instance.new("Frame", Frame)
            Line.Size = UDim2.new(1,0,0,1)
            Line.Position = UDim2.new(0,0,1,-1)
            Line.BackgroundColor3 = CurrentTheme.Stroke
            Line.BackgroundTransparency = 0.5
            Line.BorderSizePixel = 0
        end
        
        local function CreateButton(Cfg)
            local Frame = Instance.new("Frame", TabPage)
            Frame.Size = UDim2.new(1,-8,0,42)
            Frame.BackgroundColor3 = CurrentTheme.ElementBg
            Frame.BackgroundTransparency = 0.2
            Frame.BorderSizePixel = 0
            Corner(Frame, 12)
            Stroke(Frame, CurrentTheme.Stroke, 1, 0.5)
            local Btn = Instance.new("TextButton", Frame)
            Btn.Size = UDim2.new(1,-12,1,-8)
            Btn.Position = UDim2.new(0,6,0,4)
            Btn.BackgroundColor3 = CurrentTheme.ElementBg2
            Btn.BackgroundTransparency = 0.1
            Btn.Text = Cfg.Title or "Button"
            Btn.Font = Enum.Font.GothamMedium
            Btn.TextSize = 13
            Btn.TextColor3 = CurrentTheme.Text
            Btn.AutoButtonColor = false
            Corner(Btn, 10)
            Btn.MouseButton1Click:Connect(function()
                Tween(Btn, {BackgroundColor3 = CurrentTheme.Accent}, 0.1)
                task.wait(0.1)
                Tween(Btn, {BackgroundColor3 = CurrentTheme.ElementBg2}, 0.2)
                if Cfg.Callback then Cfg.Callback() end
            end)
            Btn.MouseEnter:Connect(function() Tween(Btn, {BackgroundColor3 = CurrentTheme.Accent, BackgroundTransparency = 0.1}, 0.2) end)
            Btn.MouseLeave:Connect(function() Tween(Btn, {BackgroundColor3 = CurrentTheme.ElementBg2, BackgroundTransparency = 0.1}, 0.2) end)
        end
        
        local function CreateToggle(Cfg)
            local Frame = Instance.new("Frame", TabPage)
            Frame.Size = UDim2.new(1,-8,0,44)
            Frame.BackgroundColor3 = CurrentTheme.ElementBg
            Frame.BackgroundTransparency = 0.2
            Corner(Frame, 12)
            Stroke(Frame, CurrentTheme.Stroke, 1, 0.5)
            local Label = Instance.new("TextLabel", Frame)
            Label.Size = UDim2.new(1,-70,1,0)
            Label.Position = UDim2.new(0,12,0,0)
            Label.BackgroundTransparency = 1
            Label.Text = Cfg.Title or "Toggle"
            Label.Font = Enum.Font.Gotham
            Label.TextSize = 13
            Label.TextColor3 = CurrentTheme.Text
            Label.TextXAlignment = Enum.TextXAlignment.Left
            local ToggleBG = Instance.new("Frame", Frame)
            ToggleBG.Size = UDim2.new(0,44,0,24)
            ToggleBG.Position = UDim2.new(1,-56,0.5,-12)
            ToggleBG.BackgroundColor3 = CurrentTheme.TabListBg
            ToggleBG.BorderSizePixel = 0
            Corner(ToggleBG, 12)
            local Circle = Instance.new("Frame", ToggleBG)
            Circle.Size = UDim2.new(0,18,0,18)
            Circle.Position = UDim2.new(0,3,0.5,-9)
            Circle.BackgroundColor3 = Color3.fromRGB(255,255,255)
            Circle.BorderSizePixel = 0
            Corner(Circle, 9)
            local enabled = Cfg.Default or false
            local function Update()
                if enabled then
                    Tween(ToggleBG, {BackgroundColor3 = CurrentTheme.Accent}, 0.25)
                    Tween(Circle, {Position = UDim2.new(1,-21,0.5,-9)}, 0.25)
                else
                    Tween(ToggleBG, {BackgroundColor3 = CurrentTheme.TabListBg}, 0.25)
                    Tween(Circle, {Position = UDim2.new(0,3,0.5,-9)}, 0.25)
                end
            end
            Update()
            local Btn = Instance.new("TextButton", Frame)
            Btn.Size = UDim2.new(1,0,1,0)
            Btn.BackgroundTransparency = 1
            Btn.Text = ""
            Btn.MouseButton1Click:Connect(function()
                enabled = not enabled
                Update()
                if Cfg.Callback then Cfg.Callback(enabled) end
            end)
        end
        
        local function CreateSlider(Cfg)
            local Frame = Instance.new("Frame", TabPage)
            Frame.Size = UDim2.new(1,-8,0,54)
            Frame.BackgroundColor3 = CurrentTheme.ElementBg
            Frame.BackgroundTransparency = 0.2
            Corner(Frame, 12)
            Stroke(Frame, CurrentTheme.Stroke, 1, 0.5)
            local Label = Instance.new("TextLabel", Frame)
            Label.Size = UDim2.new(1,-12,0,18)
            Label.Position = UDim2.new(0,12,0,6)
            Label.BackgroundTransparency = 1
            Label.Text = (Cfg.Title or "Slider").." : "..(Cfg.Default or Cfg.Min or 0)
            Label.Font = Enum.Font.Gotham
            Label.TextSize = 12
            Label.TextColor3 = CurrentTheme.Text
            Label.TextXAlignment = Enum.TextXAlignment.Left
            local Bar = Instance.new("Frame", Frame)
            Bar.Size = UDim2.new(1,-24,0,6)
            Bar.Position = UDim2.new(0,12,0,32)
            Bar.BackgroundColor3 = CurrentTheme.TabListBg
            Bar.BorderSizePixel = 0
            Corner(Bar, 3)
            local Fill = Instance.new("Frame", Bar)
            local percent = ((Cfg.Default or Cfg.Min or 0) - (Cfg.Min or 0)) / ((Cfg.Max or 100) - (Cfg.Min or 0))
            Fill.Size = UDim2.new(percent,0,1,0)
            Fill.BackgroundColor3 = CurrentTheme.Accent
            Fill.BorderSizePixel = 0
            Corner(Fill, 3)
            local Btn = Instance.new("Frame", Bar)
            Btn.Size = UDim2.new(0,14,0,14)
            Btn.Position = UDim2.new(percent,-7,0.5,-7)
            Btn.BackgroundColor3 = Color3.fromRGB(255,255,255)
            Btn.BorderSizePixel = 0
            Corner(Btn, 7)
            local dragging = false
            Btn.InputBegan:Connect(function(input) if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then dragging = true end end)
            UserInputService.InputEnded:Connect(function(input) if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then dragging = false end end)
            UserInputService.InputChanged:Connect(function(input)
                if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
                    local p = math.clamp((input.Position.X - Bar.AbsolutePosition.X) / Bar.AbsoluteSize.X, 0, 1)
                    local val = math.floor((Cfg.Min or 0) + p * ((Cfg.Max or 100) - (Cfg.Min or 0)))
                    Fill.Size = UDim2.new(p,0,1,0)
                    Btn.Position = UDim2.new(p,-7,0.5,-7)
                    Label.Text = (Cfg.Title or "Slider").." : "..val
                    if Cfg.Callback then Cfg.Callback(val) end
                end
            end)
        end
        
        local function CreateParagraph(Cfg)
            local Frame = Instance.new("Frame", TabPage)
            Frame.Size = UDim2.new(1,-8,0,60)
            Frame.AutomaticSize = Enum.AutomaticSize.Y
            Frame.BackgroundColor3 = CurrentTheme.ElementBg
            Frame.BackgroundTransparency = 0.2
            Corner(Frame, 12)
            Stroke(Frame, CurrentTheme.Stroke, 1, 0.5)
            local Title = Instance.new("TextLabel", Frame)
            Title.Size = UDim2.new(1,-12,0,20)
            Title.Position = UDim2.new(0,12,0,8)
            Title.BackgroundTransparency = 1
            Title.Text = Cfg.Title or "Title"
            Title.Font = Enum.Font.GothamBold
            Title.TextSize = 13
            Title.TextColor3 = CurrentTheme.Text
            Title.TextXAlignment = Enum.TextXAlignment.Left
            local Content = Instance.new("TextLabel", Frame)
            Content.Size = UDim2.new(1,-12,0,20)
            Content.Position = UDim2.new(0,12,0,28)
            Content.AutomaticSize = Enum.AutomaticSize.Y
            Content.BackgroundTransparency = 1
            Content.Text = Cfg.Content or ""
            Content.Font = Enum.Font.Gotham
            Content.TextSize = 11
            Content.TextColor3 = CurrentTheme.SubText
            Content.TextXAlignment = Enum.TextXAlignment.Left
            Content.TextWrapped = true
        end
        
        function Elements:Add(Type, Cfg)
            Cfg = Cfg or {}
            Type = string.lower(tostring(Type))
            if Type == "section" then CreateSection(Cfg)
            elseif Type == "button" then CreateButton(Cfg)
            elseif Type == "toggle" then CreateToggle(Cfg)
            elseif Type == "slider" then CreateSlider(Cfg)
            elseif Type == "paragraph" then CreateParagraph(Cfg)
            elseif Type == "label" then CreateSection(Cfg)
            else
                -- Fallback to button for unknown
                CreateButton(Cfg)
            end
        end
        
        function Elements:Section(Cfg) return self:Add("Section", Cfg) end
        function Elements:Paragraph(Cfg) return self:Add("Paragraph", Cfg) end
        function Elements:Button(Cfg) return self:Add("Button", Cfg) end
        function Elements:Toggle(Cfg) return self:Add("Toggle", Cfg) end
        function Elements:Slider(Cfg) return self:Add("Slider", Cfg) end
        function Elements:Label(Cfg) return self:Add("Label", Cfg) end
        
        tabs[name] = {btn=TabBtn, page=TabPage}
        return Elements
    end
    
    return Window
end

return GGH
