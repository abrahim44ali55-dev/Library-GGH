        function Elements:Slider(Cfg)
            Cfg.Min = Cfg.Min or 0
            Cfg.Max = Cfg.Max or 100
            Cfg.Default = Cfg.Default or Cfg.Min
            local Value = math.clamp(Cfg.Default, Cfg.Min, Cfg.Max)
            local Frame = Instance.new("Frame", TabPage)
            Frame.Size = UDim2.new(1,-4,0,58)
            Frame.BackgroundColor3 = Color3.fromRGB(26,26,32)
            Frame.BorderSizePixel = 0
            Frame.ClipsDescendants = false
            Corner(Frame, 9)
            local Label = Instance.new("TextLabel", Frame)
            Label.Size = UDim2.new(1,-16,0,18)
            Label.Position = UDim2.new(0,10,0,6)
            Label.BackgroundTransparency = 1
            Label.TextXAlignment = Enum.TextXAlignment.Left
            Label.Font = Enum.Font.GothamMedium
            Label.TextSize = 12
            Label.TextColor3 = Color3.fromRGB(230,230,235)
            Label.Text = Cfg.Title.." : "..Value
            local Bar = Instance.new("Frame", Frame)
            Bar.Name = "Bar"
            Bar.Size = UDim2.new(1,-20,0,8)
            Bar.Position = UDim2.new(0,10,0,32)
            Bar.BackgroundColor3 = Color3.fromRGB(40,40,50)
            Bar.BorderSizePixel = 0
            Bar.ClipsDescendants = false
            Corner(Bar, 4)
            local Fill = Instance.new("Frame", Bar)
            Fill.Name = "Fill"
            Fill.Size = UDim2.new((Value - Cfg.Min) / math.max(1, Cfg.Max - Cfg.Min),0,1,0)
            Fill.BackgroundColor3 = Color3.fromRGB(90,70,255)
            Fill.BorderSizePixel = 0
            Corner(Fill, 4)
            local Circle = Instance.new("Frame", Frame)
            Circle.Name = "Circle"
            Circle.Size = UDim2.new(0,18,0,18)
            Circle.AnchorPoint = Vector2.new(0.5,0.5)
            Circle.Position = UDim2.new(0, 10 + ((Value - Cfg.Min)/math.max(1,Cfg.Max-Cfg.Min))*200, 0, 36)
            Circle.BackgroundColor3 = Color3.fromRGB(255,255,255)
            Circle.BorderSizePixel = 0
            Circle.ZIndex = 10
            Corner(Circle, 9)
            local S = Instance.new("UIStroke", Circle)
            S.Color = Color3.fromRGB(90,70,255)
            S.Thickness = 2
            local DragArea = Instance.new("TextButton", Bar)
            DragArea.Size = UDim2.new(1,0,2.5,0)
            DragArea.Position = UDim2.new(0,0,0.5,-10)
            DragArea.BackgroundTransparency = 1
            DragArea.Text = ""
            DragArea.ZIndex = 5
            local dragging = false
            local function UpdateSlider(inputX)
                local barPos = Bar.AbsolutePosition.X
                local barSize = Bar.AbsoluteSize.X
                if barSize <= 0 then barSize = 200 end
                local rel = math.clamp((inputX - barPos) / barSize, 0, 1)
                Value = math.floor(Cfg.Min + (Cfg.Max - Cfg.Min) * rel)
                Fill.Size = UDim2.new(rel,0,1,0)
                Circle.Position = UDim2.new(0, 10 + rel*barSize, 0, 36)
                Label.Text = Cfg.Title.." : "..Value
                pcall(Cfg.Callback or function() end, Value)
            end
            task.spawn(function()
                task.wait(0.05)
                local barSize = Bar.AbsoluteSize.X
                if barSize <= 0 then barSize = 200 end
                local rel = (Value - Cfg.Min)/math.max(1,Cfg.Max-Cfg.Min)
                Circle.Position = UDim2.new(0, 10 + rel*barSize, 0, 36)
            end)
            DragArea.InputBegan:Connect(function(input)
                if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                    dragging = true
                    UpdateSlider(input.Position.X)
                end
            end)
            Circle.InputBegan:Connect(function(input)
                if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                    dragging = true
                end
            end)
            UserInputService.InputChanged:Connect(function(input)
                if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
                    UpdateSlider(input.Position.X)
                end
            end)
            UserInputService.InputEnded:Connect(function(input)
                if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                    dragging = false
                end
            end)
        end

