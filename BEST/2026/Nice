    UserInputService.InputChanged:Connect(function(input) if dragging and (input.UserInputType==Enum.UserInputType.MouseMovement or input.UserInputType==Enum.UserInputType.Touch) then local pct=(input.Position.X-track.AbsolutePosition.X)/track.AbsoluteSize.X; setFromPct(pct) end end)
    track.InputBegan:Connect(function(input) if input.UserInputType==Enum.UserInputType.MouseButton1 then local pct=(input.Position.X-track.AbsolutePosition.X)/track.AbsoluteSize.X; setFromPct(pct) end end)
    setFromPct((val-minV)/(maxV-minV))
    return {Instance=frame}
end

local function CreateDropdown(parent, opts)
    local th=Theme.Current
    local frame = Utilities:Create("Frame", {BackgroundColor3=th.Panel, Size=UDim2.new(1,0,0,44), ClipsDescendants=false, ZIndex=5, Parent=parent})
    Utilities:Corner(frame,10); Utilities:Stroke(frame, th.Border,1,0.4)
    local btn = Utilities:Create("TextButton", {Text=(opts.Name or "Dropdown").."  ▾", Font=Enum.Font.Gotham, TextSize=13, TextColor3=th.Text, BackgroundTransparency=1, Size=UDim2.fromScale(1,1), TextXAlignment=Enum.TextXAlignment.Left, Parent=frame})
    Utilities:Padding(btn,{0,0,12,12})
    local listFrame = Utilities:Create("Frame", {BackgroundColor3=th.Panel, Size=UDim2.new(1,0,0,0), Position=UDim2.new(0,0,1,6), Visible=false, ZIndex=10, Parent=frame})
    Utilities:Corner(listFrame,10); Utilities:Stroke(listFrame, th.Border,1,0.2); Utilities:List(listFrame, Enum.FillDirection.Vertical,2); Utilities:Padding(listFrame,{6,6,6,6})
    local open=false
    local function toggle() open=not open; listFrame.Visible=open; if open then listFrame.Size=UDim2.new(1,0,0,0); Animation:Tween(listFrame, {Size=UDim2.new(1,0,0,math.min(#(opts.Options or {})*34+12,180))}, TweenInfo.new(0.25, Enum.EasingStyle.Back, Enum.EasingDirection.Out)) end end
    btn.MouseButton1Click:Connect(toggle)
    for _,opt in ipairs(opts.Options or {"Option 1","Option 2"}) do
        local oBtn = Utilities:Create("TextButton", {Text=opt, Font=Enum.Font.Gotham, TextSize=12, TextColor3=th.Text, BackgroundColor3=th.Secondary, Size=UDim2.new(1,0,0,32), AutoButtonColor=false, Parent=listFrame})
        Utilities:Corner(oBtn,8)
        oBtn.MouseButton1Click:Connect(function() btn.Text=(opts.Name or "Dropdown").." : "..opt; toggle(); if opts.Callback then task.spawn(opts.Callback,opt) end end)
    end
    return {Instance=frame}
end

