NovaUI.Utils = {}
function NovaUI.Utils:Clamp(v,mn,mx) return math.max(mn, math.min(mx, v)) end
function NovaUI.Utils:Lerp(a,b,t) return a + (b-a)*t end
function NovaUI.Utils:Round(n,d) local m=10^(d or 0) return math.floor(n*m+0.5)/m end
function NovaUI.Utils:DeepCopy(o) if type(o)~="table" then return o end local c={} for k,v in pairs(o) do c[k]=NovaUI.Utils:DeepCopy(v) end return c end

NovaUI.Color = {}
function NovaUI.Color:ToHex(c) return string.format("#%02X%02X%02X", math.floor(c.R*255), math.floor(c.G*255), math.floor(c.B*255)) end
function NovaUI.Color:FromHex(h) h=h:gsub("#","") return Color3.fromRGB(tonumber("0x"..h:sub(1,2)), tonumber("0x"..h:sub(3,4)), tonumber("0x"..h:sub(5,6))) end
function NovaUI.Color:Lerp(c1,c2,t) return Color3.new(c1.R+(c2.R-c1.R)*t, c1.G+(c2.G-c1.G)*t, c1.B+(c2.B-c1.B)*t) end

