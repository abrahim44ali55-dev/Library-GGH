local Config = {Profiles={}, CurrentProfile="Default", AutoSave=true, _flags={}, _saveCallback=nil}
function Config:RegisterFlag(name, default, setter) self._flags[name]={value=default, setter=setter} end
function Config:Set(name, value) if self._flags[name] then self._flags[name].value=value if self._flags[name].setter then pcall(self._flags[name].setter, value) end end end
function Config:Get(name) return self._flags[name] and self._flags[name].value end
function Config:Export() local data={} for k,v in pairs(self._flags) do data[k]=v.value end return HttpService:JSONEncode(data) end
function Config:Import(json) local ok,data=pcall(function() return HttpService:JSONDecode(json) end) if not ok then return false end for k,v in pairs(data) do if self._flags[k] then self:Set(k,v) end end return true end

