    -- Confirm
    local Confirm = New("Frame", {Size=UDim2.new(1,0,1,0), BackgroundColor3=Color3.new(0,0,0), BackgroundTransparency=0.5, Visible=false, ZIndex=50, Parent=Main}, {Corner(14)})
    local CBox = New("Frame", {Size=UDim2.new(0,280,0,130), Position=UDim2.new(0.5,-140,0.5,-65), BackgroundColor3=Color3.fromRGB(40,40,45), Parent=Confirm}, {Corner(12), Padding(nil,14)})
    New("TextLabel", {Text="تأكيد الاغلاق؟", Font=Enum.Font.GothamBold, TextSize=14, TextColor3=Color3.new(1,1,1), Size=UDim2.new(1,0,0,20), BackgroundTransparency=1, TextXAlignment=Left, Parent=CBox})
    New("TextLabel", {Text="هل تريد اغلاق الواجهة؟", Font=Enum.Font.Gotham, TextSize=12, TextColor3=Color3.fromRGB(160,160,160), Position=UDim2.new(0,0,0,28), Size=UDim2.new(1,0,0,20), BackgroundTransparency=1, TextXAlignment=Left, Parent=CBox})
    local Yes = New("TextButton", {Size=UDim2.new(0,110,0,34), Position=UDim2.new(0,0,1,-34), BackgroundColor3=Color3.fromRGB(200,60,60), Text="اغلاق", Font=Enum.Font.GothamBold, TextSize=12, TextColor3=Color3.new(1,1,1), Parent=CBox}, {Corner(8)})
