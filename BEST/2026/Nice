        return {Get = function() return box.Text end, Set = function(_,v) box.Text = v end, Instance = box}
    end

    function Elements:CreateParagraph(opts: {Title: string?, Content: string})
        local theme = self._window._theme
        local frame = Util.Create("Frame", {
            Size = UDim2.new(1,0,0,0),
            AutomaticSize = Enum.AutomaticSize.Y,
            BackgroundColor3 = theme.Background3,
            Parent = self._frame
        })
        Util.Corner(frame, 10)
        Util.Padding(frame, 12,10,12,10)
        Util.List(frame, Enum.FillDirection.Vertical, 4)

        if opts.Title then
            local t = Util.Create("TextLabel", {
                Text = opts.Title,
                Font = Enum.Font.GothamBold,
                TextSize = 13,
                TextColor3 = theme.Text,
                TextXAlignment = Enum.TextXAlignment.Left,
                BackgroundTransparency = 1,
                Size = UDim2.new(1,0,0,18),
                Parent = frame
            })
        end
        local c = Util.Create("TextLabel", {
            Text = opts.Content,
            Font = Enum.Font.Gotham,
            TextSize = 12,
            TextColor3 = theme.TextDim,
            TextXAlignment = Enum.TextXAlignment.Left,
            TextWrapped = true,
            AutomaticSize = Enum.AutomaticSize.Y,
            BackgroundTransparency = 1,
            Size = UDim2.new(1,0,0,0),
            Parent = frame
        })
        return frame
    end

    function Elements:CreateColorPicker(opts: {Name: string, Default: Color3?, Callback: (Color3)->()?})
        local theme = self._window._theme
        local container = Util.Create("Frame", {
            Size = UDim2.new(1,0,0,44),
            BackgroundColor3 = theme.Background3,
            Parent = self._frame
        })
        Util.Corner(container, 10)
        Util.Padding(container, 12,0,12,0)

        local label = Util.Create("TextLabel", {
            Text = opts.Name or "Color",
            Font = Enum.Font.Gotham,
            TextSize = 12,
            TextColor3 = theme.Text,
            TextXAlignment = Enum.TextXAlignment.Left,
            BackgroundTransparency = 1,
            Size = UDim2.new(0.5,0,1,0),
            Parent = container
        })

        local preview = Util.Create("Frame", {
            Size = UDim2.fromOffset(28,28),
            Position = UDim2.new(1,-34,0.5,-14),
            BackgroundColor3 = opts.Default or theme.Primary,
            Parent = container
        })
        Util.Corner(preview, 8)
        Util.Stroke(preview, Color3.new(1,1,1), 1, 0.7)

        local colors = {
            Color3.fromRGB(255, 80, 80), Color3.fromRGB(80,255,120),
            Color3.fromRGB(80,140,255), Color3.fromRGB(255,230,80),
            Color3.fromRGB(200,80,255), Color3.fromRGB(255,140,80)
        }
        local idx = 1
        preview.InputBegan:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 then
                idx = idx % #colors + 1
                local newC = colors[idx]
                Anim.Tween(preview, {BackgroundColor3 = newC}, 0.2)
                if opts.Callback then task.spawn(opts.Callback, newC) end
            end
        end)

        return {Set = function(_,c) preview.BackgroundColor3 = c end, Get = function() return preview.BackgroundColor3 end}
    end

