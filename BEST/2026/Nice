function NovaUI:CreateWindow(Cfg)
    Cfg = Cfg or {}
    local Theme = NovaUI.Themes.List[Cfg.Theme] or NovaUI.Themes.List.Dark
    NovaUI.CurrentTheme = Theme
    local Size = Cfg.Size or UDim2.fromOffset(480, 320)
    local Title = Cfg.Title or "NovaUI"
    local Sub = Cfg.SubTitle or "WORKING"

    local sgParent
    pcall(function() sgParent = gethui and gethui() end)
    if not sgParent then sgParent = CoreGui end
    if RS:IsStudio() then pcall(function() sgParent = Player.PlayerGui end) end

    local ScreenGui = Create("ScreenGui", {Name="NovaUI_"..tostring(math.random(1000,9999)), ZIndexBehavior=Enum.ZIndexBehavior.Sibling, ResetOnSpawn=false, Parent=sgParent})

    local Main = Create("Frame", {Parent=ScreenGui, AnchorPoint=Vector2.new(0.5,0.5), Position=UDim2.fromScale(0.5,0.5), Size=Size, BackgroundColor3=Theme.B, BorderSizePixel=0}, {Create("UICorner",{CornerRadius=UDim.new(0,8)}), Create("UIStroke",{Color=Theme.Bo, Thickness=1, Transparency=0.3})})

    local TitleBar = Create("Frame", {Parent=Main, Size=UDim2.new(1,0,0,32), BackgroundColor3=Theme.B2, BorderSizePixel=0}, {Create("UICorner",{CornerRadius=UDim.new(0,8)}), Create("Frame",{Size=UDim2.new(1,0,0,8), Position=UDim2.new(0,0,1,-4), BackgroundColor3=Theme.B2, BorderSizePixel=0})})
    Create("TextLabel", {Parent=TitleBar, Position=UDim2.fromOffset(10,0), Size=UDim2.new(1,-60,1,0), BackgroundTransparency=1, Text=Title.." - "..Sub, TextColor3=Theme.T, Font=Enum.Font.GothamBold, TextSize=12, TextXAlignment=Enum.TextXAlignment.Left})

    local dragging, dragStart, startPos
    TitleBar.InputBegan:Connect(function(input)
        if input.UserInputType==Enum.UserInputType.MouseButton1 or input.UserInputType==Enum.UserInputType.Touch then
            dragging=true
            dragStart=input.Position
            startPos=Main.Position
        end
    end)
    UIS.InputChanged:Connect(function(input)
        if dragging and (input.UserInputType==Enum.UserInputType.MouseMovement or input.UserInputType==Enum.UserInputType.Touch) then
            local delta=input.Position-dragStart
            Main.Position=UDim2.new(startPos.X.Scale, startPos.X.Offset+delta.X, startPos.Y.Scale, startPos.Y.Offset+delta.Y)
        end
    end)
    UIS.InputEnded:Connect(function(input) if input.UserInputType==Enum.UserInputType.MouseButton1 or input.UserInputType==Enum.UserInputType.Touch then dragging=false end end)

    local CloseBtn = Create("TextButton", {Parent=TitleBar, AnchorPoint=Vector2.new(1,0.5), Position=UDim2.new(1,-6,0.5,0), Size=UDim2.fromOffset(22,22), BackgroundColor3=Color3.fromRGB(255,80,80), Text="X", TextColor3=Color3.new(1,1,1), Font=Enum.Font.GothamBold, TextSize=10}, {Create("UICorner",{CornerRadius=UDim.new(0,4)})})
    CloseBtn.MouseButton1Click:Connect(function() ScreenGui:Destroy() end)

    local Left = Create("Frame", {Parent=Main, Position=UDim2.fromOffset(0,32), Size=UDim2.new(0,110,1,-32), BackgroundColor3=Theme.B2, BackgroundTransparency=0.3, BorderSizePixel=0}, {Create("UIListLayout",{Padding=UDim.new(0,3)}), Create("UIPadding",{PaddingAll=UDim.new(0,5)})})
    local Right = Create("Frame", {Parent=Main, Position=UDim2.new(0,110,0,32), Size=UDim2.new(1,-110,1,-32), BackgroundTransparency=1, ClipsDescendants=true})

    local Window = {Tabs={}, Theme=Theme, Frame=Main, ScreenGui=ScreenGui}

    function Window:CreateTab(Cfg2)
        Cfg2=Cfg2 or {}
        local Name=Cfg2.Name or "Tab"
        local Icon=Cfg2.Icon or ""
        local Btn = Create("TextButton", {Parent=Left, Size=UDim2.new(1,0,0,28), BackgroundColor3=Theme.B, BackgroundTransparency=0.5, Text=Icon.." "..Name, TextColor3=Theme.T2, Font=Enum.Font.GothamMedium, TextSize=11, TextXAlignment=Enum.TextXAlignment.Left}, {Create("UIPadding",{PaddingLeft=UDim.new(0,8)}), Create("UICorner",{CornerRadius=UDim.new(0,5)})})
        local Content = Create("ScrollingFrame", {Parent=Right, Size=UDim2.fromScale(1,1), BackgroundTransparency=1, Visible=false, ScrollBarThickness=2, ScrollBarImageColor3=Theme.A, CanvasSize=UDim2.new(0,0,0,0), AutomaticCanvasSize=Enum.AutomaticSize.Y, BorderSizePixel=0}, {Create("UIListLayout",{Padding=UDim.new(0,5)}), Create("UIPadding",{PaddingAll=UDim.new(0,6)})})
        Btn.MouseButton1Click:Connect(function()
            for _,t in pairs(Window.Tabs) do t.Content.Visible=false t.Button.BackgroundTransparency=0.5 t.Button.BackgroundColor3=Theme.B t.Button.TextColor3=Theme.T2 end
            Content.Visible=true Btn.BackgroundTransparency=0.1 Btn.BackgroundColor3=Theme.A Btn.TextColor3=Color3.new(1,1,1)
        end)
        local Tab={}
        function Tab:CreateSection(Name)
            local f=Create("Frame",{Parent=Content, Size=UDim2.new(1,0,0,18), BackgroundTransparency=1})
            Create("TextLabel",{Parent=f, Size=UDim2.fromScale(1,1), BackgroundTransparency=1, Text=Name:upper(), TextColor3=Theme.T2, Font=Enum.Font.GothamBold, TextSize=10, TextXAlignment=Enum.TextXAlignment.Left})
            return f
        end
        function Tab:CreateButton(Cfg3)
            Cfg3=Cfg3 or {}
            local b=Create("TextButton",{Parent=Content, Size=UDim2.new(1,0,0,30), BackgroundColor3=Theme.B2, Text=Cfg3.Title or "Button", TextColor3=Theme.T, Font=Enum.Font.GothamMedium, TextSize=11},{Create("UICorner",{CornerRadius=UDim.new(0,5)}), Create("UIStroke",{Color=Theme.Bo, Transparency=0.6})})
            if Cfg3.Callback then b.MouseButton1Click:Connect(Cfg3.Callback) end
            return b
        end
        function Tab:CreateToggle(Cfg3)
            Cfg3=Cfg3 or {}
            local val=Cfg3.Default or false
            local f=Create("Frame",{Parent=Content, Size=UDim2.new(1,0,0,30), BackgroundColor3=Theme.B2},{Create("UICorner",{CornerRadius=UDim.new(0,5)})})
            Create("TextLabel",{Parent=f, Position=UDim2.fromOffset(8,0), Size=UDim2.new(1,-50,1,0), BackgroundTransparency=1, Text=Cfg3.Title or "Toggle", TextColor3=Theme.T, Font=Enum.Font.GothamMedium, TextSize=11, TextXAlignment=Enum.TextXAlignment.Left})
            local sw=Create("Frame",{Parent=f, AnchorPoint=Vector2.new(1,0.5), Position=UDim2.new(1,-8,0.5,0), Size=UDim2.fromOffset(34,18), BackgroundColor3=val and Theme.A or Theme.Bo},{Create("UICorner",{CornerRadius=UDim.new(1,0)}), Create("Frame",{Name="Dot", Position=val and UDim2.fromOffset(18,2) or UDim2.fromOffset(2,2), Size=UDim2.fromOffset(14,14), BackgroundColor3=Color3.new(1,1,1)},{Create("UICorner",{CornerRadius=UDim.new(1,0)})})})
            local function upd(v) val=v TS:Create(sw,TweenInfo.new(0.2),{BackgroundColor3=v and Theme.A or Theme.Bo}):Play() TS:Create(sw.Dot,TweenInfo.new(0.2),{Position=v and UDim2.fromOffset(18,2) or UDim2.fromOffset(2,2)}):Play() if Cfg3.Callback then Cfg3.Callback(v) end end
            f.InputBegan:Connect(function(i) if i.UserInputType==Enum.UserInputType.MouseButton1 then upd(not val) end end)
            return {SetValue=function(_,v) upd(v) end}
        end
        function Tab:CreateSlider(Cfg3)
            Cfg3=Cfg3 or {}
            local min=Cfg3.Min or 0
            local max=Cfg3.Max or 100
            local val=Cfg3.Default or min
            local f=Create("Frame",{Parent=Content, Size=UDim2.new(1,0,0,36), BackgroundColor3=Theme.B2},{Create("UICorner",{CornerRadius=UDim.new(0,5)})})
            local lb=Create("TextLabel",{Parent=f, Position=UDim2.fromOffset(8,2), Size=UDim2.new(1,-16,0,12), BackgroundTransparency=1, Text=(Cfg3.Title or "Slider")..": "..val, TextColor3=Theme.T, Font=Enum.Font.GothamMedium, TextSize=10, TextXAlignment=Enum.TextXAlignment.Left})
            local tr=Create("Frame",{Parent=f, Position=UDim2.fromOffset(8,20), Size=UDim2.new(1,-16,0,5), BackgroundColor3=Theme.Bo},{Create("UICorner",{CornerRadius=UDim.new(1,0)}), Create("Frame",{Name="Fill", Size=UDim2.fromScale((val-min)/math.max(1,max-min),1), BackgroundColor3=Theme.A},{Create("UICorner",{CornerRadius=UDim.new(1,0)})})})
            local dragging=false
            local function setPos(x)
                local pct=math.clamp((x-tr.AbsolutePosition.X)/math.max(1,tr.AbsoluteSize.X),0,1)
                val=math.floor(min+pct*(max-min))
                lb.Text=(Cfg3.Title or "Slider")..": "..val
                tr.Fill.Size=UDim2.fromScale(pct,1)
                if Cfg3.Callback then Cfg3.Callback(val) end
            end
            tr.InputBegan:Connect(function(i) if i.UserInputType==Enum.UserInputType.MouseButton1 or i.UserInputType==Enum.UserInputType.Touch then dragging=true setPos(i.Position.X) end end)
            UIS.InputEnded:Connect(function() dragging=false end)
            UIS.InputChanged:Connect(function(i) if dragging and (i.UserInputType==Enum.UserInputType.MouseMovement or i.UserInputType==Enum.UserInputType.Touch) then setPos(i.Position.X) end end)
            return {SetValue=function(_,v) val=v lb.Text=(Cfg3.Title or "Slider")..": "..v tr.Fill.Size=UDim2.fromScale((v-min)/math.max(1,max-min),1) end}
        end
        function Tab:CreateDropdown(Cfg3)
            Cfg3=Cfg3 or {}
            local opts=Cfg3.Options or {"A"}
            local sel=opts[1]
            local f=Create("Frame",{Parent=Content, Size=UDim2.new(1,0,0,30), BackgroundColor3=Theme.B2},{Create("UICorner",{CornerRadius=UDim.new(0,5)})})
            Create("TextLabel",{Parent=f, Position=UDim2.fromOffset(8,0), Size=UDim2.new(0.5,0,1,0), BackgroundTransparency=1, Text=Cfg3.Title or "Dropdown", TextColor3=Theme.T, Font=Enum.Font.GothamMedium, TextSize=11, TextXAlignment=Enum.TextXAlignment.Left})
            local lb=Create("TextLabel",{Parent=f, Position=UDim2.new(1,-60,0,0), Size=UDim2.new(0,50,1,0), BackgroundTransparency=1, Text=sel, TextColor3=Theme.T2, Font=Enum.Font.Gotham, TextSize=10, TextXAlignment=Enum.TextXAlignment.Right})
            f.InputBegan:Connect(function(i) if i.UserInputType==Enum.UserInputType.MouseButton1 then local idx=table.find(opts,lb.Text) or 0 sel=opts[idx%#opts+1] lb.Text=sel if Cfg3.Callback then Cfg3.Callback(sel) end end end)
            return {}
        end
        function Tab:CreateInput(Cfg3)
            Cfg3=Cfg3 or {}
            local f=Create("Frame",{Parent=Content, Size=UDim2.new(1,0,0,30), BackgroundColor3=Theme.B2},{Create("UICorner",{CornerRadius=UDim.new(0,5)})})
            local box=Create("TextBox",{Parent=f, Size=UDim2.fromScale(1,1), BackgroundTransparency=1, PlaceholderText=Cfg3.Placeholder or "...", Text=Cfg3.Default or "", TextColor3=Theme.T, PlaceholderColor3=Theme.T2, Font=Enum.Font.Gotham, TextSize=11},{Create("UIPadding",{PaddingLeft=UDim.new(0,8),PaddingRight=UDim.new(0,8)})})
            box.FocusLost:Connect(function() if Cfg3.Callback then Cfg3.Callback(box.Text) end end)
            return {}
        end
        function Tab:CreateParagraph(Cfg3)
            Cfg3=Cfg3 or {}
            local f=Create("Frame",{Parent=Content, Size=UDim2.new(1,0,0,45), BackgroundColor3=Theme.B2, BackgroundTransparency=0.5},{Create("UICorner",{CornerRadius=UDim.new(0,5)}), Create("UIPadding",{PaddingAll=UDim.new(0,6)})})
            Create("TextLabel",{Parent=f, Size=UDim2.new(1,0,0,12), BackgroundTransparency=1, Text=Cfg3.Title or "Info", TextColor3=Theme.T, Font=Enum.Font.GothamBold, TextSize=11, TextXAlignment=Enum.TextXAlignment.Left})
            Create("TextLabel",{Parent=f, Position=UDim2.fromOffset(0,14), Size=UDim2.new(1,0,1,-14), BackgroundTransparency=1, Text=Cfg3.Content or "", TextColor3=Theme.T2, Font=Enum.Font.Gotham, TextSize=10, TextWrapped=true, TextXAlignment=Enum.TextXAlignment.Left, TextYAlignment=Enum.TextYAlignment.Top})
            return f
        end
        Tab.Button=Btn
        Tab.Content=Content
        table.insert(Window.Tabs, Tab)
        if #Window.Tabs==1 then Content.Visible=true Btn.BackgroundTransparency=0.1 Btn.BackgroundColor3=Theme.A Btn.TextColor3=Color3.new(1,1,1) end
        return Tab
    end
    Main.Size=UDim2.fromOffset(0,0)
    Tween(Main,{Size=Size},0.3,Enum.EasingStyle.Back):Play()
    table.insert(NovaUI.Windows, Window)
    return Window
end

function NovaUI:Notify(Cfg)
    Cfg=Cfg or {}
    local sg = CoreGui:FindFirstChild("NovaUI") or Players.LocalPlayer.PlayerGui:FindFirstChild("NovaUI")
    if not sg then sg=Create("ScreenGui",{Name="NovaUI", Parent=CoreGui}) end
    local f=Create("Frame",{Parent=sg, AnchorPoint=Vector2.new(1,1), Position=UDim2.new(1,20,1,-20), Size=UDim2.fromOffset(240,45), BackgroundColor3=NovaUI.CurrentTheme.B2, BorderSizePixel=0, ZIndex=100},{Create("UICorner",{CornerRadius=UDim.new(0,6)}), Create("UIStroke",{Color=NovaUI.CurrentTheme.Bo})})
    Create("TextLabel",{Parent=f, Position=UDim2.fromOffset(10,4), Size=UDim2.new(1,-20,0,12), BackgroundTransparency=1, Text=Cfg.Title or "Nova", TextColor3=NovaUI.CurrentTheme.T, Font=Enum.Font.GothamBold, TextSize=11, TextXAlignment=Enum.TextXAlignment.Left})
    Create("TextLabel",{Parent=f, Position=UDim2.fromOffset(10,18), Size=UDim2.new(1,-20,0,20), BackgroundTransparency=1, Text=Cfg.Content or "", TextColor3=NovaUI.CurrentTheme.T2, Font=Enum.Font.Gotham, TextSize=10, TextWrapped=true, TextXAlignment=Enum.TextXAlignment.Left})
    Tween(f,{Position=UDim2.new(1,-8,1,-20)},0.25):Play()
    task.delay(Cfg.Duration or 3, function() Tween(f,{Position=UDim2.new(1,20,1,-20)},0.25):Play() task.wait(0.25) f:Destroy() end)
end


