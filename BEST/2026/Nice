    end
    apply(state,true)
    local btn=Util:Create("TextButton",{Text="",BackgroundTransparency=1,Size=UDim2.fromScale(1,1),ZIndex=2,Parent=frame})
    btn.MouseButton1Click:Connect(function() th=Theme.Current; apply(not state) end)
    Theme:OnChanged(function(t) th=t; frame.BackgroundColor3=t.Panel; label.TextColor3=t.Text; st.Color=t.Border; bg.BackgroundColor3=state and t.Accent or t.Sec end)
    return {Instance=frame, Set=function(_,v) apply(v) end}
end

local function CreateSlider(parent, opts)
    local th=Theme.Current
    local frame=Util:Create("Frame",{BackgroundColor3=th.Panel,Size=UDim2.new(1,0,0,56),Parent=parent})
    Util:Corner(frame,10); local st=Util:Stroke(frame,th.Border,1,0.35)
    local label=Util:Create("TextLabel",{Text=(opts.Name or "Slider").." : "..(opts.Default or opts.Min or 0),Font=Enum.Font.Gotham,TextSize=12,TextColor3=th.Text,BackgroundTransparency=1,Size=UDim2.new(1,0,0,18),Position=UDim2.fromOffset(12,6),TextXAlignment=Enum.TextXAlignment.Left,Parent=frame})
    local track=Util:Create("Frame",{BackgroundColor3=th.Sec,Size=UDim2.new(1,-24,0,6),Position=UDim2.new(0,12,0,32),Parent=frame})
    Util:Corner(track,3)
    local fill=Util:Create("Frame",{BackgroundColor3=th.Accent,Size=UDim2.new(0,0,1,0),Parent=track})
    Util:Corner(fill,3)
    local knob=Util:Create("Frame",{BackgroundColor3=Color3.new(1,1,1),Size=UDim2.fromOffset(16,16),AnchorPoint=Vector2.new(0.5,0.5),Position=UDim2.new(0,0,0.5,0),Parent=track})
    Util:Corner(knob,8); local knobSt=Util:Stroke(knob,th.Accent,2,0)
    local minV=opts.Min or 0; local maxV=opts.Max or 100; local val=opts.Default or minV
    local function setPct(pct, noCb)
        pct=math.clamp(pct,0,1)
        val=math.floor(minV+(maxV-minV)*pct+0.5)
        fill.Size=UDim2.new(pct,0,1,0)
        knob.Position=UDim2.new(pct,0,0.5,0)
        label.Text=(opts.Name or "Slider").." : "..val
        if not noCb and opts.Callback then task.spawn(opts.Callback,val) end
    end
    local dragging=false; local dragInput=nil
    track.InputBegan:Connect(function(input) if input.UserInputType==Enum.UserInputType.MouseButton1 or input.UserInputType==Enum.UserInputType.Touch then dragging=true; dragInput=input; setPct((input.Position.X-track.AbsolutePosition.X)/track.AbsoluteSize.X) end end)
    UserInputService.InputChanged:Connect(function(input) if dragging and input==dragInput then setPct((input.Position.X-track.AbsolutePosition.X)/track.AbsoluteSize.X) end end)
    UserInputService.InputEnded:Connect(function(input) if input.UserInputType==Enum.UserInputType.MouseButton1 or input.UserInputType==Enum.UserInputType.Touch then dragging=false end end)
    -- Also global mouse move
    UserInputService.InputChanged:Connect(function(input)
        if dragging and (input.UserInputType==Enum.UserInputType.MouseMovement or input.UserInputType==Enum.UserInputType.Touch) then
            setPct((input.Position.X-track.AbsolutePosition.X)/track.AbsoluteSize.X)
        end
    end)
    setPct((val-minV)/(maxV-minV), true)
    Theme:OnChanged(function(t) frame.BackgroundColor3=t.Panel; track.BackgroundColor3=t.Sec; fill.BackgroundColor3=t.Accent; label.TextColor3=t.Text; st.Color=t.Border; knobSt.Color=t.Accent end)
    return {Instance=frame, Set=function(_,v) setPct((v-minV)/(maxV-minV)) end}
end

