            end)
            return Sld
        end

        -- [عنصر 4] قائمة منسدلة محمية من البروز (Dropdown)
        function TabObj:CreateDropdown(Config)
            local Expanded = false
            local DropFrame = Instance.new("Frame")
            DropFrame.Size = UDim2.new(1, -10, 0, 35)
            DropFrame.BackgroundColor3 = CurrentTheme.Container
            DropFrame.ClipsDescendants = true -- **الحل النهائي لمنع خروج القائمة عند الإغلاق**
            DropFrame.Parent = TabPage
            Instance.new("UICorner", DropFrame).CornerRadius = UDim.new(0, 6)

            local DropBtn = Instance.new("TextButton")
            DropBtn.Size = UDim2.new(1, 0, 0, 35)
            DropBtn.BackgroundTransparency = 1
            DropBtn.Text = (Config.Name or "Dropdown") .. " ▼"
            DropBtn.TextColor3 = CurrentTheme.Text
            DropBtn.Parent = DropFrame

            local Container = Instance.new("Frame")
            Container.Size = UDim2.new(1, 0, 0, 0)
            Container.Position = UDim2.new(0, 0, 0, 35)
            Container.BackgroundTransparency = 1
            Container.Parent = DropFrame

            local CList = Instance.new("UIListLayout", Container)

            for _, Opt in pairs(Config.Options or {}) do
                local OBtn = Instance.new("TextButton")
                OBtn.Size = UDim2.new(1, 0, 0, 28)
                OBtn.BackgroundColor3 = CurrentTheme.Background
                OBtn.Text = tostring(Opt)
                OBtn.TextColor3 = CurrentTheme.Text
                OBtn.Parent = Container
                OBtn.MouseButton1Click:Connect(function()
                    DropBtn.Text = (Config.Name or "Dropdown") .. " : " .. tostring(Opt)
                    DropFrame:TweenSize(UDim2.new(1, -10, 0, 35), Enum.EasingDirection.Out, Enum.EasingStyle.Quad, 0.2, true)
                    Expanded = false
                    pcall(Config.Callback or function() end, Opt)
                end)
            end

            DropBtn.MouseButton1Click:Connect(function()
                Expanded = not Expanded
                local TargetHeight = Expanded and (35 + (#(Config.Options or {}) * 28)) or 35
                DropFrame:TweenSize(UDim2.new(1, -10, 0, TargetHeight), Enum.EasingDirection.Out, Enum.EasingStyle.Quad, 0.2, true)
            end)
            return DropFrame
        end

