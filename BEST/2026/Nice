        TabButton.MouseButton1Click:Connect(function()
            for _,t in pairs(Window.Tabs) do
                t.Content.Visible = false
                Tween(t.Button, {BackgroundColor3 = Theme.Background, BackgroundTransparency = 0.5}, 0.2):Play()
                Tween(t.Button, {TextColor3 = Theme.Text2}, 0.2):Play()
            end
            TabContent.Visible = true
            Tween(TabButton, {BackgroundColor3 = Theme.Accent, BackgroundTransparency = 0.15}, 0.2):Play()
            Tween(TabButton, {TextColor3 = Theme.Text}, 0.2):Play()
            Window.CurrentTab = Tab
