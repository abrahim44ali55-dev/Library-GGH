function Notification:Notify(opts)
    opts=opts or {}
    local theme = Theme.Current
    local colorMap = {Success=theme.Success, Error=theme.Error, Warning=theme.Warning, Info=theme.Accent}
    local accent = colorMap[opts.Type or "Info"] or theme.Accent
    local frame = Utilities:Create("Frame", {Size=UDim2.fromOffset(340,0), AutomaticSize=Enum.AutomaticSize.Y, BackgroundColor3=theme.Panel, BorderSizePixel=0, ZIndex=101})
    Utilities:Corner(frame,12)
