        -- [عنصر 10] عنوان قسم (Section)
        function TabObj:CreateSection(Name)
            return TabObj:CreateLabel("-- " .. (Name or "Section") .. " --")
        end

        return TabObj
    end

    return WindowObj
end

-- ==========================================
-- 4. نظام الإشعارات (Notify)
-- ==========================================
function Library:Notify(Config)
    local Notif = Instance.new("Frame")
    Notif.Size = UDim2.new(0, 220, 0, 50)
    Notif.Position = UDim2.new(1, -230, 1, -60)
    Notif.BackgroundColor3 = Color3.fromRGB(25, 25, 30)
    Notif.Parent = ScreenGui
    Instance.new("UICorner", Notif).CornerRadius = UDim.new(0, 8)

    local NTitle = Instance.new("TextLabel")
    NTitle.Size = UDim2.new(1, -10, 0, 20)
    NTitle.Position = UDim2.new(0, 5, 0, 2)
    NTitle.BackgroundTransparency = 1
    NTitle.Text = Config.Title or "Notification"
    NTitle.TextColor3 = Color3.fromRGB(45, 120, 240)
    NTitle.Font = Enum.Font.SourceSansBold
    NTitle.Parent = Notif

    local NContent = Instance.new("TextLabel")
    NContent.Size = UDim2.new(1, -10, 0, 25)
    NContent.Position = UDim2.new(0, 5, 0, 22)
    NContent.BackgroundTransparency = 1
    NContent.Text = Config.Content or ""
    NContent.TextColor3 = Color3.fromRGB(255, 255, 255)
    NContent.TextSize = 12
    NContent.Parent = Notif

    task.delay(Config.Duration or 3, function()
        Notif:Destroy()
    end)
end

return Library
