		TabButton.TextColor3 = currentTheme.Sub
		TabButton.TextSize = 11
		TabButton.Font = Enum.Font.GothamMedium
		TabButton.TextXAlignment = Enum.TextXAlignment.Center
		TabButton.Parent = Sidebar
		Instance.new("UICorner", TabButton).CornerRadius = UDim.new(0, 6)

		local TabPage = Instance.new("ScrollingFrame")
		TabPage.Size = UDim2.new(1, 0, 1, 0)
		TabPage.BackgroundTransparency = 1
		TabPage.BorderSizePixel = 0
		TabPage.Visible = false
		TabPage.AutomaticCanvasSize = Enum.AutomaticSize.Y
		TabPage.ScrollBarThickness = 3
		TabPage.Parent = ContainerHolder

		local PageLayout = Instance.new("UIListLayout")
		PageLayout.SortOrder = Enum.SortOrder.LayoutOrder
		PageLayout.Padding = UDim.new(0, 6)
		PageLayout.Parent = TabPage

		local PagePadding = Instance.new("UIPadding")
		PagePadding.PaddingRight = UDim.new(0, 8)
		PagePadding.PaddingBottom = UDim.new(0, 15)
		PagePadding.Parent = TabPage

		if firstTab then
			firstTab = false
			TabPage.Visible = true
			TabButton.TextColor3 = currentTheme.Text
			TabButton.BackgroundColor3 = currentTheme.Top
		end

		TabButton.MouseButton1Click:Connect(function()
			for _, page in ipairs(ContainerHolder:GetChildren()) do if page:IsA("ScrollingFrame") then page.Visible = false end end
			for _, btn in ipairs(Sidebar:GetChildren()) do
				if btn:IsA("TextButton") then TweenService:Create(btn, TweenInfo.new(0.2), {TextColor3 = currentTheme.Sub, BackgroundColor3 = currentTheme.Elem}):Play() end
			end
			TabPage.Visible = true
			TweenService:Create(TabButton, TweenInfo.new(0.2), {TextColor3 = currentTheme.Text, BackgroundColor3 = currentTheme.Top}):Play()
		end)

		local TabObj = {}

		function TabObj:AddDeveloperNote(noteText)
			local NoteFrame = Instance.new("Frame")
			NoteFrame.Size = UDim2.new(1, 0, 0, 35)
			NoteFrame.BackgroundColor3 = currentTheme.Top
			NoteFrame.Parent = TabPage
			Instance.new("UICorner", NoteFrame).CornerRadius = UDim.new(0, 6)

			local NoteLbl = Instance.new("TextLabel")
			NoteLbl.Size = UDim2.new(1, -15, 1, 0)
			NoteLbl.Position = UDim2.new(0, 10, 0, 0)
			NoteLbl.BackgroundTransparency = 1
			NoteLbl.Text = "📝 ملاحظة: " .. noteText
			NoteLbl.TextColor3 = currentTheme.Accent
			NoteLbl.TextSize = 10
			NoteLbl.Font = Enum.Font.GothamBold
			NoteLbl.TextXAlignment = Enum.TextXAlignment.Left
			NoteLbl.Parent = NoteFrame
		end

		function TabObj:AddButton(name, desc, showNotify, notifyMsg, callback)
			local notifyEnabled = false
			local customMsg = nil
			local cb = callback

			if type(showNotify) == "function" then
				cb = showNotify
			elseif type(showNotify) == "boolean" then
				notifyEnabled = showNotify
				if type(notifyMsg) == "function" then
					cb = notifyMsg
				else
					customMsg = notifyMsg
				end
			end

			local Button = Instance.new("TextButton")
			Button.Size = UDim2.new(1, 0, 0, 42)
			Button.BackgroundColor3 = currentTheme.Elem
			Button.Text = ""
			Button.AutoButtonColor = false
			Button.Parent = TabPage
			Instance.new("UICorner", Button).CornerRadius = UDim.new(0, 6)

			local TitleLbl = Instance.new("TextLabel")
			TitleLbl.Size = UDim2.new(1, -15, 0, 18)
			TitleLbl.Position = UDim2.new(0, 10, 0, 4)
			TitleLbl.BackgroundTransparency = 1
			TitleLbl.Text = name
			TitleLbl.TextColor3 = currentTheme.Text
			TitleLbl.TextSize = 11
			TitleLbl.Font = Enum.Font.GothamBold
			TitleLbl.TextXAlignment = Enum.TextXAlignment.Left
			TitleLbl.Parent = Button

			local DescLbl = Instance.new("TextLabel")
			DescLbl.Size = UDim2.new(1, -15, 0, 14)
			DescLbl.Position = UDim2.new(0, 10, 0, 22)
			DescLbl.BackgroundTransparency = 1
			DescLbl.Text = desc
			DescLbl.TextColor3 = currentTheme.Sub
			DescLbl.TextSize = 9
			DescLbl.Font = Enum.Font.Gotham
			DescLbl.TextXAlignment = Enum.TextXAlignment.Left
			DescLbl.Parent = Button

			Button.MouseButton1Click:Connect(function()
				if notifyEnabled then
					Notify("تم التشغيل", customMsg or ("تم تفعيل الأمر: " .. name), 2.5)
				end
				if cb then cb() end
			end)
		end

		function TabObj:AddToggle(name, desc, defaultState, callback)
			local toggled = defaultState or false
			local ToggleFrame = Instance.new("TextButton")
			ToggleFrame.Size = UDim2.new(1, 0, 0, 42)
			ToggleFrame.BackgroundColor3 = currentTheme.Elem
			ToggleFrame.Text = ""
			ToggleFrame.AutoButtonColor = false
			ToggleFrame.Parent = TabPage
			Instance.new("UICorner", ToggleFrame).CornerRadius = UDim.new(0, 6)

			local TitleLbl = Instance.new("TextLabel")
			TitleLbl.Size = UDim2.new(1, -55, 0, 18)
			TitleLbl.Position = UDim2.new(0, 10, 0, 4)
			TitleLbl.BackgroundTransparency = 1
			TitleLbl.Text = name
			TitleLbl.TextColor3 = currentTheme.Text
			TitleLbl.TextSize = 11
			TitleLbl.Font = Enum.Font.GothamBold
			TitleLbl.TextXAlignment = Enum.TextXAlignment.Left
			TitleLbl.Parent = ToggleFrame

			local DescLbl = Instance.new("TextLabel")
			DescLbl.Size = UDim2.new(1, -55, 0, 14)
			DescLbl.Position = UDim2.new(0, 10, 0, 22)
			DescLbl.BackgroundTransparency = 1
			DescLbl.Text = desc
			DescLbl.TextColor3 = currentTheme.Sub
			DescLbl.TextSize = 9
			DescLbl.Font = Enum.Font.Gotham
			DescLbl.TextXAlignment = Enum.TextXAlignment.Left
			DescLbl.Parent = ToggleFrame

			local Switch = Instance.new("Frame")
			Switch.Size = UDim2.new(0, 34, 0, 18)
			Switch.Position = UDim2.new(1, -44, 0.5, -9)
			Switch.BackgroundColor3 = toggled and currentTheme.Accent or Color3.fromRGB(50, 50, 60)
			Switch.Parent = ToggleFrame
			Instance.new("UICorner", Switch).CornerRadius = UDim.new(1, 0)

			local Circle = Instance.new("Frame")
			Circle.Size = UDim2.new(0, 14, 0, 14)
			Circle.Position = toggled and UDim2.new(1, -16, 0.5, -7) or UDim2.new(0, 2, 0.5, -7)
			Circle.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
			Circle.Parent = Switch
			Instance.new("UICorner", Circle).CornerRadius = UDim.new(1, 0)

			ToggleFrame.MouseButton1Click:Connect(function()
				toggled = not toggled
				TweenService:Create(Switch, TweenInfo.new(0.2), {BackgroundColor3 = toggled and currentTheme.Accent or Color3.fromRGB(50, 50, 60)}):Play()
				TweenService:Create(Circle, TweenInfo.new(0.2), {Position = toggled and UDim2.new(1, -16, 0.5, -7) or UDim2.new(0, 2, 0.5, -7)}):Play()
				if callback then callback(toggled) end
			end)
		end

		function TabObj:AddSlider(name, min, max, default, callback)
			local val = default or min
			local SliderFrame = Instance.new("Frame")
			SliderFrame.Size = UDim2.new(1, 0, 0, 50)
			SliderFrame.BackgroundColor3 = currentTheme.Elem
			SliderFrame.Parent = TabPage
			Instance.new("UICorner", SliderFrame).CornerRadius = UDim.new(0, 6)

			local TitleLbl = Instance.new("TextLabel")
			TitleLbl.Size = UDim2.new(1, -15, 0, 18)
			TitleLbl.Position = UDim2.new(0, 10, 0, 5)
			TitleLbl.BackgroundTransparency = 1
			TitleLbl.Text = name
			TitleLbl.TextColor3 = currentTheme.Text
			TitleLbl.TextSize = 11
			TitleLbl.Font = Enum.Font.GothamBold
			TitleLbl.TextXAlignment = Enum.TextXAlignment.Left
			TitleLbl.Parent = SliderFrame

			local ValueLbl = Instance.new("TextLabel")
			ValueLbl.Size = UDim2.new(0, 50, 0, 18)
			ValueLbl.Position = UDim2.new(1, -60, 0, 5)
			ValueLbl.BackgroundTransparency = 1
			ValueLbl.Text = tostring(val)
			ValueLbl.TextColor3 = currentTheme.Accent
			ValueLbl.TextSize = 11
			ValueLbl.Font = Enum.Font.GothamBold
			ValueLbl.TextXAlignment = Enum.TextXAlignment.Right
			ValueLbl.Parent = SliderFrame

			local Bar = Instance.new("Frame")
			Bar.Size = UDim2.new(1, -20, 0, 6)
			Bar.Position = UDim2.new(0, 10, 0, 32)
			Bar.BackgroundColor3 = Color3.fromRGB(45, 45, 55)
			Bar.Parent = SliderFrame
			Instance.new("UICorner", Bar).CornerRadius = UDim.new(1, 0)

			local Fill = Instance.new("Frame")
			Fill.Size = UDim2.new((val - min) / (max - min), 0, 1, 0)
			Fill.BackgroundColor3 = currentTheme.Accent
			Fill.Parent = Bar
			Instance.new("UICorner", Fill).CornerRadius = UDim.new(1, 0)

			local Knob = Instance.new("Frame")
			Knob.Size = UDim2.new(0, 12, 0, 12)
			Knob.Position = UDim2.new(1, -6, 0.5, -6)
			Knob.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
			Knob.Parent = Fill
			Instance.new("UICorner", Knob).CornerRadius = UDim.new(1, 0)

			local draggingSlider = false
			Bar.InputBegan:Connect(function(input)
				if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
					draggingSlider = true
				end
			end)
			UserInputService.InputEnded:Connect(function(input)
				if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
					draggingSlider = false
				end
			end)
			UserInputService.InputChanged:Connect(function(input)
				if draggingSlider and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
					local pos = math.clamp((input.Position.X - Bar.AbsolutePosition.X) / Bar.AbsoluteSize.X, 0, 1)
					val = math.floor(min + ((max - min) * pos))
					Fill.Size = UDim2.new(pos, 0, 1, 0)
					ValueLbl.Text = tostring(val)
					if callback then callback(val) end
				end
			end)
		end

		function TabObj:AddDropdown(name, list, callback)
			local isOpen = false
			local maxVisibleItems = 4
			local itemHeight = 28
			local paddingHeight = 4
			local headerHeight = 42
			
			local calculatedListHeight = math.min(#list, maxVisibleItems) * (itemHeight + paddingHeight)
			local closedHeight = headerHeight
			local openedHeight = headerHeight + calculatedListHeight + 12

			local DropMain = Instance.new("Frame")
			DropMain.Size = UDim2.new(1, 0, 0, closedHeight)
			DropMain.BackgroundColor3 = currentTheme.Elem
			DropMain.ClipsDescendants = true
			DropMain.Parent = TabPage
			Instance.new("UICorner", DropMain).CornerRadius = UDim.new(0, 6)

			local DropBtn = Instance.new("TextButton")
			DropBtn.Size = UDim2.new(1, 0, 0, headerHeight)
			DropBtn.BackgroundTransparency = 1
			DropBtn.Text = ""
			DropBtn.Parent = DropMain

			local TitleLbl = Instance.new("TextLabel")
			TitleLbl.Size = UDim2.new(1, -30, 0, headerHeight)
			TitleLbl.Position = UDim2.new(0, 10, 0, 0)
			TitleLbl.BackgroundTransparency = 1
			TitleLbl.Text = name .. " : اختر عنصر"
			TitleLbl.TextColor3 = currentTheme.Text
			TitleLbl.TextSize = 11
			TitleLbl.Font = Enum.Font.GothamBold
			TitleLbl.TextXAlignment = Enum.TextXAlignment.Left
			TitleLbl.Parent = DropBtn

			local DropScroll = Instance.new("ScrollingFrame")
			DropScroll.Size = UDim2.new(1, -20, 0, calculatedListHeight)
			DropScroll.Position = UDim2.new(0, 10, 0, headerHeight + 4)
			DropScroll.BackgroundTransparency = 1
			DropScroll.BorderSizePixel = 0
			DropScroll.AutomaticCanvasSize = Enum.AutomaticSize.Y
			DropScroll.CanvasSize = UDim2.new(0, 0, 0, (#list * (itemHeight + paddingHeight)) + 4)
			DropScroll.ScrollBarThickness = 3
			DropScroll.Parent = DropMain

			local DropListLayout = Instance.new("UIListLayout")
			DropListLayout.SortOrder = Enum.SortOrder.LayoutOrder
			DropListLayout.Padding = UDim.new(0, paddingHeight)
			DropListLayout.Parent = DropScroll

			for _, option in ipairs(list) do
				local OptBtn = Instance.new("TextButton")
				OptBtn.Size = UDim2.new(1, -4, 0, itemHeight)
				OptBtn.BackgroundColor3 = currentTheme.Top
				OptBtn.Text = option
				OptBtn.TextColor3 = currentTheme.Sub
				OptBtn.TextSize = 10
				OptBtn.Font = Enum.Font.GothamMedium
				OptBtn.Parent = DropScroll
				Instance.new("UICorner", OptBtn).CornerRadius = UDim.new(0, 4)

				OptBtn.MouseButton1Click:Connect(function()
					TitleLbl.Text = name .. " : " .. option
					isOpen = false
					TweenService:Create(DropMain, TweenInfo.new(0.2), {Size = UDim2.new(1, 0, 0, closedHeight)}):Play()
					if callback then callback(option) end
				end)
			end

			DropBtn.MouseButton1Click:Connect(function()
				isOpen = not isOpen
				local targetHeight = isOpen and openedHeight or closedHeight
				TweenService:Create(DropMain, TweenInfo.new(0.2), {Size = UDim2.new(1, 0, 0, targetHeight)}):Play()
			end)
		end

		return TabObj
	end

	WindowObj.Notify = Notify
	return WindowObj
end

return Library
