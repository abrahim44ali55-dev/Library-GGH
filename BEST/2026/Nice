        TextXAlignment = Enum.TextXAlignment.Left,
        BackgroundColor3 = theme.Background3,
        BackgroundTransparency = 1,
        Size = UDim2.new(1,0,0,36),
        Parent = self._tabHolder
    })
    Util.Corner(tabBtn, 8)
    Util.Padding(tabBtn, 12,0,0,0)

    local tabContent = Util.Create("Frame", {
        Name = name.."_Content",
        Size = UDim2.new(1,0,0,0),
        AutomaticSize = Enum.AutomaticSize.Y,
        BackgroundTransparency = 1,
        Visible = false,
        Parent = self._content
    })
    Util.List(tabContent, Enum.FillDirection.Vertical, 10)

    local tabObj = {
        Name = name,
        _button = tabBtn,
        _frame = tabContent,
        _window = self,
        _elements = {}
    }

    function tabObj:Activate()
        for _,t in pairs(self._window._tabs) do
            t._frame.Visible = false
            Anim.Tween(t._button, {BackgroundTransparency = 1, TextColor3 = self._window._theme.TextDim}, 0.2)
        end
        self._frame.Visible = true
        Anim.Tween(self._button, {BackgroundTransparency = 0, TextColor3 = self._window._theme.Text}, 0.2)
        self._window._currentTab = self
    end

    tabBtn.MouseButton1Click:Connect(function() tabObj:Activate() end)

    if #self._tabs == 0 then
        task.defer(function() tabObj:Activate() end)
    end

    table.insert(self._tabs, tabObj)
    self[name] = tabObj

