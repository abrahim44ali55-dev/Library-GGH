-- Smooth Touch & Mouse Drag Logic
local draggingBar, dragStartBar, startPosBar
MoveBtn.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        draggingBar = true
        dragStartBar = input.Position
        startPosBar = MinimizeBar.Position
    end
end)

UserInputService.InputChanged:Connect(function(input)
    if draggingBar and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
        local delta = input.Position - dragStartBar
        MinimizeBar.Position = UDim2.new(startPosBar.X.Scale, startPosBar.X.Offset + delta.X, startPosBar.Y.Scale, startPosBar.Y.Offset + delta.Y)
    end
end)

UserInputService.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        draggingBar = false
    end
end)

