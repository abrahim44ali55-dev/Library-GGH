        ColorSequenceKeypoint.new(0.17,Color3.fromHSV(0.17,1,1)),
        ColorSequenceKeypoint.new(0.33,Color3.fromHSV(0.33,1,1)),
        ColorSequenceKeypoint.new(0.5,Color3.fromHSV(0.5,1,1)),
        ColorSequenceKeypoint.new(0.67,Color3.fromHSV(0.67,1,1)),
        ColorSequenceKeypoint.new(0.83,Color3.fromHSV(0.83,1,1)),
        ColorSequenceKeypoint.new(1,Color3.fromHSV(1,1,1))
    },Parent=hueBar})
    local hueCursor=Util:Create("Frame",{Size=UDim2.fromOffset(6,20),AnchorPoint=Vector2.new(0.5,0),BackgroundColor3=Color3.new(1,1,1),Position=UDim2.new(hue,0,0,0),Parent=hueBar})
    Util:Corner(hueCursor,3); Util:Stroke(hueCursor,Color3.new(0,0,0),1,0)

    local preview=Util:Create("Frame",{Size=UDim2.new(1,0,0,40),Position=UDim2.new(0,0,0,246),BackgroundColor3=defaultColor,Parent=box})
    Util:Corner(preview,8)

    local btnRow=Util:Create("Frame",{BackgroundTransparency=1,Size=UDim2.new(1,0,0,36),Position=UDim2.new(0,0,1,-36),Parent=box})
    Util:List(btnRow,Enum.FillDirection.Horizontal,8).HorizontalAlignment=Enum.HorizontalAlignment.Right
