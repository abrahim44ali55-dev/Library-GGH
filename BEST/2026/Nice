                Parent = InputFrame,
                Size = UDim2.fromScale(1,1),
                BackgroundTransparency = 1,
                PlaceholderText = Config.Placeholder or Config.Title or "Enter text...",
                Text = Config.Default or "",
                TextColor3 = Theme.Text,
                PlaceholderColor3 = Theme.Text2,
                Font = Enum.Font.Gotham,
                TextSize = 13,
                TextXAlignment = Enum.TextXAlignment.Left,
            }, {Create("UIPadding", {PaddingLeft = UDim.new(0,12), PaddingRight = UDim.new(0,12)})})
            Box.FocusLost:Connect(function()
                if Config.Callback then Config.Callback(Box.Text) end
                NovaUI.Options[Config.Flag or Config.Title] = {Value = Box.Text, Type = "Input"}
            end)
            return {Value = Box.Text, SetValue = function(_,v) Box.Text = v end}
        end
        
        function Tab:CreateColorpicker(Config)
            Config = Config or {}
            local Color = Config.Default or Color3.fromRGB(255,0,0)
            local CpFrame = Create("Frame", {
                Parent = TabContent,
                Size = UDim2.new(1,0,0,38),
                BackgroundColor3 = Theme.Background2,
            }, {Create("UICorner", {CornerRadius = UDim.new(0,8)}), Create("UIStroke", {Color = Theme.Border, Thickness = 1, Transparency = 0.7})})
            Create("TextLabel", {
                Parent = CpFrame,
                Position = UDim2.fromOffset(12,0),
                Size = UDim2.new(1,-60,1,0),
                BackgroundTransparency = 1,
                Text = Config.Title or "Colorpicker",
                TextColor3 = Theme.Text,
                Font = Enum.Font.GothamMedium,
                TextSize = 13,
                TextXAlignment = Enum.TextXAlignment.Left,
            })
            local Preview = Create("Frame", {
                Parent = CpFrame,
                AnchorPoint = Vector2.new(1,0.5),
                Position = UDim2.new(1,-12,0.5,0),
                Size = UDim2.fromOffset(24,24),
                BackgroundColor3 = Color,
            }, {Create("UICorner", {CornerRadius = UDim.new(0,6)})})
            Preview.InputBegan:Connect(function(i)
                if i.UserInputType == Enum.UserInputType.MouseButton1 then
                    -- Simple rainbow cycle for demo - can expand to HSV picker
                    local hue = 0
                    local conn
                    conn = RunService.RenderStepped:Connect(function()
                        hue = (hue+1)%360
                        local c = Color3.fromHSV(hue/360,1,1)
                        Preview.BackgroundColor3 = c
                        if Config.Callback then Config.Callback(c) end
                        if not UserInputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton1) then
                            conn:Disconnect()
                        end
                    end)
                end
            end)
            return {Value = Color, SetValue = function(_,c) Preview.BackgroundColor3 = c end}
        end
        
        function Tab:CreateParagraph(Config)
            Config = Config or {}
            local Para = Create("Frame", {
                Parent = TabContent,
                Size = UDim2.new(1,0,0,60),
                BackgroundColor3 = Theme.Background2,
                BackgroundTransparency = 0.4,
            }, {Create("UICorner", {CornerRadius = UDim.new(0,8)}), Create("UIPadding", {PaddingTop = UDim.new(0,8), PaddingLeft = UDim.new(0,10), PaddingRight = UDim.new(0,10)})})
            Create("TextLabel", {
                Parent = Para,
                Size = UDim2.new(1,0,0,16),
                BackgroundTransparency = 1,
                Text = Config.Title or "Paragraph",
                TextColor3 = Theme.Text,
                Font = Enum.Font.GothamBold,
                TextSize = 13,
                TextXAlignment = Enum.TextXAlignment.Left,
            })
            Create("TextLabel", {
                Parent = Para,
                Position = UDim2.fromOffset(0,18),
                Size = UDim2.new(1,0,1,-18),
                BackgroundTransparency = 1,
                Text = Config.Content or "",
                TextColor3 = Theme.Text2,
                Font = Enum.Font.Gotham,
                TextSize = 12,
                TextXAlignment = Enum.TextXAlignment.Left,
                TextYAlignment = Enum.TextYAlignment.Top,
                TextWrapped = true,
            })
            return Para
        end
        
        -- // NEW ELEMENTS - Not in Fluent/WindUI
        function Tab:CreateKeybind(Config)
            Config = Config or {}
            local Key = Config.Default or Enum.KeyCode.F
            local KeyFrame = Create("Frame", {
                Parent = TabContent,
                Size = UDim2.new(1,0,0,38),
                BackgroundColor3 = Theme.Background2,
            }, {Create("UICorner", {CornerRadius = UDim.new(0,8)})})
            Create("TextLabel", {
                Parent = KeyFrame,
                Position = UDim2.fromOffset(12,0),
                Size = UDim2.new(1,-80,1,0),
                BackgroundTransparency = 1,
                Text = Config.Title or "Keybind",
                TextColor3 = Theme.Text,
                Font = Enum.Font.GothamMedium,
                TextSize = 13,
                TextXAlignment = Enum.TextXAlignment.Left,
            })
            local KeyLabel = Create("TextLabel", {
                Parent = KeyFrame,
                AnchorPoint = Vector2.new(1,0.5),
                Position = UDim2.new(1,-12,0.5,0),
                Size = UDim2.fromOffset(60,24),
                BackgroundColor3 = Theme.Background,
                Text = Key.Name,
                TextColor3 = Theme.Text,
                Font = Enum.Font.Code,
                TextSize = 12,
            }, {Create("UICorner", {CornerRadius = UDim.new(0,6)})})
            local listening = false
            KeyFrame.InputBegan:Connect(function(i)
                if i.UserInputType == Enum.UserInputType.MouseButton1 and not listening then
                    listening = true
                    KeyLabel.Text = "..."
                    local conn
                    conn = UserInputService.InputBegan:Connect(function(inp)
                        if inp.UserInputType == Enum.UserInputType.Keyboard then
                            Key = inp.KeyCode
                            KeyLabel.Text = Key.Name
                            listening = false
                            conn:Disconnect()
                            if Config.Callback then Config.Callback(Key) end
                        end
                    end)
                end
            end)
            return {Value = Key}
        end
        
        function Tab:CreateNotification(Config)
            Config = Config or {}
            NovaUI:Notify(Config)
        end
        
        table.insert(Window.Tabs, Tab)
        if #Window.Tabs == 1 then
            TabButton:FindFirstChildOfClass("TextButton") -- trigger first tab
            TabContent.Visible = true
            TabButton.BackgroundColor3 = Theme.Accent
            TabButton.BackgroundTransparency = 0.15
            TabButton.TextColor3 = Theme.Text
        end
        return Tab
    end
    
    function Window:SelectTab(Index)
        local tab = Window.Tabs[Index]
        if tab then
            tab.Button.MouseButton1Click:Fire()
        end
    end
    
    -- Minimize key
    UserInputService.InputBegan:Connect(function(input)
        if input.KeyCode == MinimizeKey then
            MainFrame.Visible = not MainFrame.Visible
        end
    end)
    
    -- Entrance animation (WindUI style but smoother)
    MainFrame.Size = UDim2.fromOffset(0,0)
    Tween(MainFrame, {Size = Size}, 0.5, Enum.EasingStyle.Back, Enum.EasingDirection.Out):Play()
    
    table.insert(NovaUI.Windows, Window)
    return Window
end

function NovaUI:Notify(Config)
    Config = Config or {}
    local Title = Config.Title or "NovaUI"
    local Content = Config.Content or "Notification"
    local Duration = Config.Duration or 3
    
    local Gui = CoreGui:FindFirstChild("NovaUI") or Player.PlayerGui:FindFirstChild("NovaUI")
    if not Gui then return end
    
    local Notif = Create("Frame", {
        Parent = Gui,
        AnchorPoint = Vector2.new(1,1),
        Position = UDim2.new(1,-20,1,-20),
        Size = UDim2.fromOffset(300,60),
        BackgroundColor3 = NovaUI.CurrentTheme.Background2,
        BackgroundTransparency = 0.1,
    }, {
        Create("UICorner", {CornerRadius = UDim.new(0,10)}),
        Create("UIStroke", {Color = NovaUI.CurrentTheme.Border}),
        Create("TextLabel", {
            Position = UDim2.fromOffset(12,6),
            Size = UDim2.new(1,-24,0,18),
            BackgroundTransparency = 1,
            Text = Title,
            TextColor3 = NovaUI.CurrentTheme.Text,
            Font = Enum.Font.GothamBold,
            TextSize = 13,
            TextXAlignment = Enum.TextXAlignment.Left,
            Name = "Title",
        }),
        Create("TextLabel", {
            Position = UDim2.fromOffset(12,26),
            Size = UDim2.new(1,-24,0,28),
            BackgroundTransparency = 1,
            Text = Content,
            TextColor3 = NovaUI.CurrentTheme.Text2,
            Font = Enum.Font.Gotham,
            TextSize = 12,
            TextXAlignment = Enum.TextXAlignment.Left,
            TextWrapped = true,
            Name = "Content",
        })
    })
    
    Notif.Position = UDim2.new(1,20,1,-20)
    Tween(Notif, {Position = UDim2.new(1,-20,1,-20)}, 0.4, Enum.EasingStyle.Back):Play()
    task.delay(Duration, function()
        Tween(Notif, {Position = UDim2.new(1,20,1,-20)}, 0.3):Play()
        task.wait(0.3)
        Notif:Destroy()
    end)
end

function NovaUI:SetTheme(ThemeName)
    local t = NovaUI.Themes.List[ThemeName]
    if t then
        NovaUI.CurrentTheme = t
        NovaUI:Notify({Title = "Theme", Content = "Changed to " .. ThemeName, Duration = 2})
    end
end

-- Config System (Save/Load) - stronger than both
function NovaUI:SaveConfig(Name)
    local data = HttpService:JSONEncode(NovaUI.Options)
    if writefile then
        writefile("NovaUI_"..(Name or "Default")..".json", data)
        NovaUI:Notify({Title = "Config", Content = "Saved " .. (Name or "Default")})
    end
    return data
end

function NovaUI:LoadConfig(Name)
    local data
    if readfile and isfile and isfile("NovaUI_"..Name..".json") then
        data = readfile("NovaUI_"..Name..".json")
    end
    if data then
        local decoded = HttpService:JSONDecode(data)
        NovaUI.Options = decoded
        NovaUI:Notify({Title = "Config", Content = "Loaded " .. Name})
        return decoded
    end
end

return NovaUI
