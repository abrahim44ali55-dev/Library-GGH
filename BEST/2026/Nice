    self.Container = Utilities:Create("Frame", {Name="GGH_Notifications", AnchorPoint=Vector2.new(1,1), Position=UDim2.new(1,-20,1,-20), Size=UDim2.fromOffset(340, 600), BackgroundTransparency=1, ZIndex=100, ClipsDescendants=false, Parent=screenGui})
