function NiceLib:FormatTime(seconds)
    local mins = math.floor(seconds/60)
    local secs = seconds % 60
    return string.format("%02d:%02d", mins, secs)
end
function NiceLib:Clamp(val, min, max) return math.clamp(val, min, max) end
function NiceLib:Lerp(a,b,t) return a + (b-a)*t end
function NiceLib:Random(min,max) return math.random(min,max) end
function NiceLib:DeepCopy(t)
    if type(t) ~= "table" then return t end
    local copy = {}
    for k,v in pairs(t) do copy[k] = NiceLib:DeepCopy(v) end
    return copy
end
function NiceLib:TableToString(tbl, indent)
    indent = indent or 0
    local str = "{\n"
    for k,v in pairs(tbl) do
        str = str .. string.rep("  ", indent+1) .. tostring(k) .. " = " .. tostring(v) .. ",\n"
    end
    str = str .. string.rep("  ", indent) .. "}"
    return str
end
