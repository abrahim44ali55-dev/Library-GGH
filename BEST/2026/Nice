    function Elements:CreateKeybind(opts: {Name: string, Default: Enum.KeyCode?, Callback: (Enum.KeyCode)->()?})
        local theme = self._window._theme
        local container = Util.Create("Frame", {
            Size = UDim2.new(1,0,0,44),
            BackgroundColor3 = theme.Background3,
            Parent = self._frame
        })
        Util.Corner(container, 10)
        Util.Padding(container, 12,0,12,0)

        local label = Util.Create("TextLabel", {
            Text = opts.Name or "Keybind",
            Font = Enum.Font.Gotham,
            TextSize = 12,
            TextColor3 = theme.Text,
            BackgroundTransparency = 1,
            Size = UDim2.new(0.5,0,1,0),
            TextXAlignment = Enum.TextXAlignment.Left,
            Parent = container
        })

        local btn = Util.Create("TextButton", {
            Text = opts.Default and opts.Default.Name or "None",
            Font = Enum.Font.GothamBold,
            TextSize = 12,
            TextColor3 = theme.Text,
            BackgroundColor3 = theme.Surface,
            Size = UDim2.new(0,80,0,28),
            Position = UDim2.new(1,-86,0.5,-14),
            Parent = container
        })
        Util.Corner(btn, 8)

        local listening = false
        btn.MouseButton1Click:Connect(function()
            listening = true
            btn.Text = "..."
            local conn
            conn = UserInputService.InputBegan:Connect(function(input, gpe)
                if not gpe and input.UserInputType == Enum.UserInputType.Keyboard and listening then
                    listening = false
                    btn.Text = input.KeyCode.Name
                    if opts.Callback then task.spawn(opts.Callback, input.KeyCode) end
                    conn:Disconnect()
                end
            end)
        end)
        return btn
    end

    function Elements:CreateDivider()
        local theme = self._window._theme
        local div = Util.Create("Frame", {
            Size = UDim2.new(1,0,0,1),
            BackgroundColor3 = theme.Border,
            BackgroundTransparency = 0.5,
            Parent = self._frame
        })
        return div
    end

    -- Alias for compatibility
    Elements.CreateLabel = Elements.CreateParagraph

    for k,v in pairs(Elements) do
        tabObj[k] = v
    end

    return tabObj
end

function WindowClass:SetTheme(themeName: string)
    local theme = Themes[themeName]
    if not theme then return end
    self._theme = theme
    self._themeName = themeName
    -- Apply recursively
    local function applyColors(inst)
        if inst:IsA("Frame") then
            -- heuristic
            if inst.Name == "MainWindow" then inst.BackgroundColor3 = theme.Background end
        end
        for _,child in ipairs(inst:GetChildren()) do
            pcall(applyColors, child)
        end
    end
    applyColors(self._main)
    NotificationManager.Theme = theme
end

function WindowClass:Notify(opts: {Title: string, Content: string, Duration: number?})
    NotificationManager.Notify(opts)
end

-- PLUGIN SYSTEM
function GGH:RegisterPlugin(name: string, pluginTable: any)
    self._plugins = self._plugins or {}
    self._plugins[name] = pluginTable
    return pluginTable
end

function GGH:CreateWindow(config)
    return WindowClass:CreateWindow(config)
end

-- THEME EXPORT
function GGH:GetThemes() return Themes end

function GGH:CreateCustomTheme(name: string, colors: any)
    Themes[name] = colors
    return colors
end

return GGH
