-- ===================== WINDOW =====================
local function BuildWindow(screenGui, opts)
    local th = Theme.Current
    local shadow = Utilities:Create("ImageLabel", {Name="Shadow", BackgroundTransparency=1, Image="rbxassetid://1316045217", ImageColor3=th.Shadow, ImageTransparency=0.5, ScaleType=Enum.ScaleType.Slice, SliceCenter=Rect.new(10,10,118,118), Size=UDim2.new(1,30,1,30), Position=UDim2.fromOffset(-15,-15), ZIndex=1, Parent=screenGui})
    local main = Utilities:Create("Frame", {Name="GGH_Window", BackgroundColor3=th.Background, BorderSizePixel=0, Size=opts.Size or UDim2.fromOffset(700,500), Position=opts.Position or UDim2.fromOffset(100,100), ClipsDescendants=false, ZIndex=2, Parent=shadow})
    Utilities:Corner(main,14); Utilities:Stroke(main, th.Border,1,0.2)
    local topBar = Utilities:Create("Frame", {Name="TopBar", BackgroundColor3=th.Panel, Size=UDim2.new(1,0,0,42), BorderSizePixel=0, ZIndex=3, Parent=main})
    Utilities:Corner(topBar,14)
    Utilities:Create("Frame", {BackgroundColor3=th.Panel, Size=UDim2.new(1,0,0,14), Position=UDim2.new(0,0,1,-14), BorderSizePixel=0, ZIndex=3, Parent=topBar})
    local title = Utilities:Create("TextLabel", {Text=opts.Title or "GGH Lib", Font=Enum.Font.GothamBold, TextSize=15, TextColor3=th.Text, BackgroundTransparency=1, Size=UDim2.new(1,-120,1,0), Position=UDim2.fromOffset(16,0), TextXAlignment=Enum.TextXAlignment.Left, ZIndex=4, Parent=topBar})
    local btnHolder = Utilities:Create("Frame", {BackgroundTransparency=1, Size=UDim2.fromOffset(80,32), Position=UDim2.new(1,-88,0,5), ZIndex=4, Parent=topBar})
    Utilities:List(btnHolder, Enum.FillDirection.Horizontal,6)
    local minimizeBtn = Utilities:Create("TextButton", {Text="-", Font=Enum.Font.GothamBold, TextSize=18, TextColor3=th.SubText, BackgroundColor3=th.Secondary, Size=UDim2.fromOffset(32,32), AutoButtonColor=false, ZIndex=4, Parent=btnHolder})
    Utilities:Corner(minimizeBtn,8)
    local closeBtn = Utilities:Create("TextButton", {Text="×", Font=Enum.Font.GothamBold, TextSize=20, TextColor3=Color3.fromRGB(255,90,90), BackgroundColor3=th.Secondary, Size=UDim2.fromOffset(32,32), AutoButtonColor=false, ZIndex=4, Parent=btnHolder})
    Utilities:Corner(closeBtn,8)
    local content = Utilities:Create("Frame", {Name="Content", BackgroundTransparency=1, Size=UDim2.new(1,0,1,-42), Position=UDim2.fromOffset(0,42), ClipsDescendants=true, ZIndex=3, Parent=main})
    local tabBar = Utilities:Create("ScrollingFrame", {Name="TabBar", BackgroundColor3=th.Panel, BackgroundTransparency=0.3, Size=UDim2.new(0,180,1,0), ScrollBarThickness=2, CanvasSize=UDim2.new(0,0,0,0), AutomaticCanvasSize=Enum.AutomaticSize.Y, BorderSizePixel=0, ZIndex=3, Parent=content})
    Utilities:List(tabBar, Enum.FillDirection.Vertical,4); Utilities:Padding(tabBar,{8,8,8,8})
    local tabContent = Utilities:Create("Frame", {Name="TabContent", BackgroundTransparency=1, Size=UDim2.new(1,-180,1,0), Position=UDim2.new(0,180,0,0), ZIndex=3, Parent=content})
    local resizeHandle = Utilities:Create("Frame", {Name="Resize", BackgroundTransparency=1, AnchorPoint=Vector2.new(1,1), Position=UDim2.new(1,0,1,0), Size=UDim2.fromOffset(24,24), ZIndex=10, Parent=main})
    Utilities:Create("ImageLabel", {Image="rbxassetid://6031090997", BackgroundTransparency=1, Size=UDim2.fromOffset(14,14), Position=UDim2.fromOffset(5,5), ImageColor3=th.SubText, Parent=resizeHandle})

    -- Floating minimized bar
    local floatBar = Utilities:Create("Frame", {Name="FloatingBar", BackgroundColor3=th.Panel, Size=UDim2.fromOffset(260,44), Position=UDim2.new(0.5,-130,0,12), Visible=false, ZIndex=50, Parent=screenGui})
    Utilities:Corner(floatBar,22); Utilities:Stroke(floatBar, th.Border,1,0.1)
    local dragBtn = Utilities:Create("TextButton", {Text="≡", Font=Enum.Font.GothamBold, TextSize=18, TextColor3=th.SubText, BackgroundColor3=th.Secondary, Size=UDim2.fromOffset(36,36), Position=UDim2.fromOffset(4,4), AutoButtonColor=false, Parent=floatBar})
    Utilities:Corner(dragBtn,18)
    Utilities:Create("TextLabel", {Text="GGH Lib", Font=Enum.Font.GothamBold, TextSize=13, TextColor3=th.Text, BackgroundTransparency=1, Size=UDim2.new(1,-100,1,0), Position=UDim2.fromOffset(48,0), TextXAlignment=Enum.TextXAlignment.Left, Parent=floatBar})
    local restoreBtn = Utilities:Create("TextButton", {Text="↗", Font=Enum.Font.GothamBold, TextSize=16, TextColor3=th.Accent, BackgroundColor3=th.Background, Size=UDim2.fromOffset(36,36), Position=UDim2.new(1,-40,0,4), AutoButtonColor=false, Parent=floatBar})
    Utilities:Corner(restoreBtn,18)

    -- Drag logic
    local dragging, dragStart, startPos
    topBar.InputBegan:Connect(function(input) if input.UserInputType==Enum.UserInputType.MouseButton1 or input.UserInputType==Enum.UserInputType.Touch then dragging=true; dragStart=input.Position; startPos=shadow.Position end end)
    UserInputService.InputChanged:Connect(function(input) if dragging and (input.UserInputType==Enum.UserInputType.MouseMovement or input.UserInputType==Enum.UserInputType.Touch) then local delta=input.Position-dragStart; shadow.Position=UDim2.new(startPos.X.Scale, startPos.X.Offset+delta.X, startPos.Y.Scale, startPos.Y.Offset+delta.Y) end end)
    UserInputService.InputEnded:Connect(function(input) if input.UserInputType==Enum.UserInputType.MouseButton1 or input.UserInputType==Enum.UserInputType.Touch then dragging=false end end)
    
    -- Resize
    local resizing, rStart, rSize
    resizeHandle.InputBegan:Connect(function(input) if input.UserInputType==Enum.UserInputType.MouseButton1 or input.UserInputType==Enum.UserInputType.Touch then resizing=true; rStart=input.Position; rSize=main.Size end end)
    UserInputService.InputChanged:Connect(function(input) if resizing and (input.UserInputType==Enum.UserInputType.MouseMovement or input.UserInputType==Enum.UserInputType.Touch) then local delta=input.Position-rStart; main.Size=UDim2.new(0, math.clamp(rSize.X.Offset+delta.X, 480, 1200), 0, math.clamp(rSize.Y.Offset+delta.Y, 320, 800)) end end)
    UserInputService.InputEnded:Connect(function(input) if input.UserInputType==Enum.UserInputType.MouseButton1 or input.UserInputType==Enum.UserInputType.Touch then resizing=false end end)

    -- Minimize to floating bar
    local minimized=false
    local function setMinimized(state)
        minimized=state
        if state then
            TweenService:Create(shadow, TweenInfo.new(0.3, Enum.EasingStyle.Back, Enum.EasingDirection.In), {Size=UDim2.new(0,0,0,0)}):Play()
            task.wait(0.2); shadow.Visible=false; floatBar.Visible=true; floatBar.Size=UDim2.fromOffset(0,44)
            TweenService:Create(floatBar, TweenInfo.new(0.45, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {Size=UDim2.fromOffset(260,44)}):Play()
        else
            floatBar.Visible=false; shadow.Visible=true; TweenService:Create(shadow, TweenInfo.new(0.45, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {Size=UDim2.new(1,30,1,30)}):Play()
        end
    end
    minimizeBtn.MouseButton1Click:Connect(function() setMinimized(true) end)
    restoreBtn.MouseButton1Click:Connect(function() setMinimized(false) end)
    closeBtn.MouseButton1Click:Connect(function() screenGui:Destroy() end)
    Utilities:MakeDraggable(dragBtn, floatBar)

    -- Theme listener
    Theme:OnChanged(function(thNew)
        main.BackgroundColor3=thNew.Background; topBar.BackgroundColor3=thNew.Panel; title.TextColor3=thNew.Text; shadow.ImageColor3=thNew.Shadow
    end)

    return {Main=main, Shadow=shadow, TabBar=tabBar, TabContent=tabContent, FloatBar=floatBar}
end

-- ===================== MAIN API =====================
function GGH:CreateWindow(opts)
    opts=opts or {}
    local parent
    if gethui then parent=gethui()
    elseif syn and syn.protect_gui then parent=game.CoreGui
    else parent=LocalPlayer:WaitForChild("PlayerGui") end
    
    local screenGui = Instance.new("ScreenGui")
    screenGui.Name="GGH_"..(opts.Title or "Window").."_"..tostring(math.random(1000,9999))
    screenGui.ZIndexBehavior=Enum.ZIndexBehavior.Sibling
    screenGui.ResetOnSpawn=false
    screenGui.IgnoreGuiInset=true
    screenGui.Parent=parent

    Notification:Init(screenGui, Theme)

    local winParts = BuildWindow(screenGui, opts)
    local Tabs = {}
    
    local WindowObj = {}
    WindowObj.Gui=screenGui
    WindowObj.Main=winParts.Main
    WindowObj.Shadow=winParts.Shadow
    
    function WindowObj:CreateTab(name)
        local th=Theme.Current
        local tabBtn = Utilities:Create("TextButton", {Text=name, Font=Enum.Font.GothamBold, TextSize=13, TextColor3=th.SubText, BackgroundColor3=th.Secondary, Size=UDim2.new(1,0,0,38), AutoButtonColor=false, Parent=winParts.TabBar})
        Utilities:Corner(tabBtn,9)
        local page = Utilities:Create("ScrollingFrame", {Name=name.."Page", BackgroundTransparency=1, Size=UDim2.fromScale(1,1), Visible=false, ScrollBarThickness=2, CanvasSize=UDim2.new(0,0,0,0), AutomaticCanvasSize=Enum.AutomaticSize.Y, Parent=winParts.TabContent})
        Utilities:List(page, Enum.FillDirection.Vertical,8); Utilities:Padding(page,{12,12,16,16})
        
        local tabObj = {Button=tabBtn, Page=page, Name=name}
        
        tabBtn.MouseButton1Click:Connect(function()
            for _,t in pairs(Tabs) do t.Page.Visible=false; t.Button.BackgroundColor3=th.Secondary; t.Button.TextColor3=th.SubText end
            page.Visible=true; tabBtn.BackgroundColor3=th.Accent; tabBtn.TextColor3=Color3.new(1,1,1)
        end)
        
        if #Tabs==0 then tabBtn.BackgroundColor3=th.Accent; tabBtn.TextColor3=Color3.new(1,1,1); page.Visible=true end
        
        Tabs[name]=tabObj; table.insert(Tabs, tabObj)
        
        function tabObj:CreateButton(o) return CreateButton(page, o) end
        function tabObj:CreateToggle(o) return CreateToggle(page, o) end
        function tabObj:CreateSlider(o) return CreateSlider(page, o) end
        function tabObj:CreateDropdown(o) return CreateDropdown(page, o) end
        function tabObj:CreateTextbox(o) return CreateTextbox(page, o) end
        function tabObj:CreateParagraph(o) return CreateParagraph(page, o) end
        function tabObj:CreateSection(n) return CreateSection(page, n) end
        function tabObj:CreateDivider() return CreateDivider(page) end
        
        return tabObj
    end
    
    function WindowObj:Notify(o) return Notification:Notify(o) end
    function WindowObj:SetTheme(name) Theme:Set(name) end
    function WindowObj:CreateThemeEditor()
        local editor = self:CreateTab("Themes")
        editor:CreateParagraph({Title="15 Built-in Themes", Content="Click to switch instantly. Glassmorphism, Glow, Shadows auto-update."})
        for themeName,_ in pairs(Theme.Themes) do
            editor:CreateButton({Name=themeName, Callback=function() Theme:Set(themeName) end})
        end
        return editor
    end
    
    return WindowObj
end

function GGH:Notify(opts) return Notification:Notify(opts) end
function GGH:SetTheme(name) Theme:Set(name) end
GGH.Themes = Theme.Themes

return GGH
