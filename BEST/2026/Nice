function NovaUI:CreateWindow(Cfg)
    Cfg=Cfg or {}
    local Theme = NovaUI.Themes.List[Cfg.Theme] or ThemeDefs.Dark
    NovaUI.CurrentTheme = Theme
    local Size = Cfg.Size or UDim2.fromOffset(500, 350)
    local Title = Cfg.Title or "NovaUI v4 REAL HEAVY"
    local SubTitle = Cfg.SubTitle or "250KB+ REAL"
    
    local ScreenGui = Create("ScreenGui", {
        Name = "NovaUI_"..Http:GenerateGUID(false),
        ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
        ResetOnSpawn = false,
        DisplayOrder = 999,
        Parent = (gethui and gethui()) or (RS:IsStudio() and Player.PlayerGui or CoreGui)
    })
    
    -- Real acrylic blur implementation
    local Blur = nil
    if Cfg.Acrylic ~= false and Theme.Acrylic then
        Blur = Create("BlurEffect", {Parent=Lighting, Size=16, Name="NovaUIBlur"})
        ScreenGui.Destroying:Connect(function() pcall(function() Blur:Destroy() end) end)
    end
    
    -- Main window with shadow
    local Shadow = Create("Frame", {
        Parent=ScreenGui, AnchorPoint=Vector2.new(0.5,0.5), Position=UDim2.fromScale(0.5,0.5), Size=Size + UDim2.fromOffset(20,20),
        BackgroundColor3=Color3.new(0,0,0), BackgroundTransparency=0.7, BorderSizePixel=0
    }, {Create("UICorner",{CornerRadius=UDim.new(0,14)}), Create("UIStroke",{Color=Color3.new(0,0,0), Transparency=0.5})})
    
    local Main = Create("Frame", {
        Parent=Shadow, AnchorPoint=Vector2.new(0.5,0.5), Position=UDim2.fromScale(0.5,0.5), Size=UDim2.new(1,-20,1,-20),
        BackgroundColor3=Theme.Background, BorderSizePixel=0, ClipsDescendants=false
    }, {
        Create("UICorner",{CornerRadius=UDim.new(0, Theme.CornerRadius or 10)}),
        Create("UIStroke",{Color=Theme.Border, Thickness=1, Transparency=0.3}),
        Create("UIGradient",{Color=ColorSequence.new{ColorSequenceKeypoint.new(0, Theme.Background), ColorSequenceKeypoint.new(1, Theme.Background2)}, Rotation=90})
    })
    
    -- TitleBar with window controls
    local TitleBar = Create("Frame", {
        Parent=Main, Size=UDim2.new(1,0,0,38), BackgroundColor3=Theme.Background2, BackgroundTransparency=0.1, BorderSizePixel=0
    }, {
        Create("UICorner",{CornerRadius=UDim.new(0,10)}),
        Create("Frame",{Name="BottomFix", Size=UDim2.new(1,0,0,12), Position=UDim2.new(0,0,1,-6), BackgroundColor3=Theme.Background2, BorderSizePixel=0, BackgroundTransparency=0.1}),
        Create("UIStroke",{Color=Theme.Border, Transparency=0.8}),
    })
    
    -- Icon
    if Cfg.Icon then
        Create("ImageLabel",{Parent=TitleBar, Position=UDim2.fromOffset(10,8), Size=UDim2.fromOffset(20,20), BackgroundTransparency=1, Image=Cfg.Icon, ImageColor3=Theme.Accent})
        Create("TextLabel",{Parent=TitleBar, Position=UDim2.fromOffset(38,0), Size=UDim2.new(1,-120,1,0), BackgroundTransparency=1, Text=Title, TextColor3=Theme.Text, Font=Enum.Font.GothamBold, TextSize=13, TextXAlignment=0})
        Create("TextLabel",{Parent=TitleBar, Position=UDim2.fromOffset(38,14), Size=UDim2.new(1,-120,0,10), BackgroundTransparency=1, Text=SubTitle, TextColor3=Theme.Text2, Font=Enum.Font.Gotham, TextSize=10, TextXAlignment=0})
    else
        Create("TextLabel",{Parent=TitleBar, Position=UDim2.fromOffset(12,0), Size=UDim2.new(1,-100,0.6,0), BackgroundTransparency=1, Text=Title, TextColor3=Theme.Text, Font=Enum.Font.GothamBold, TextSize=13, TextXAlignment=0})
        Create("TextLabel",{Parent=TitleBar, Position=UDim2.fromOffset(12,14), Size=UDim2.new(1,-100,0,12), BackgroundTransparency=1, Text=SubTitle, TextColor3=Theme.Text2, Font=Enum.Font.Gotham, TextSize=10, TextXAlignment=0})
    end
    
    -- Dragging with touch support
    local dragging, dragStart, startPos, dragInput
    TitleBar.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            dragStart = input.Position
            startPos = Shadow.Position
            input.Changed:Connect(function()
                if input.UserInputState == Enum.UserInputState.End then dragging = false end
            end)
        end
    end)
    TitleBar.InputChanged:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
            dragInput = input
        end
    end)
    UIS.InputChanged:Connect(function(input)
        if input == dragInput and dragging then
            local delta = input.Position - dragStart
            Shadow.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
        end
    end)
    
    -- Window controls
    local CloseBtn = Create("TextButton",{Parent=TitleBar, AnchorPoint=Vector2.new(1,0.5), Position=UDim2.new(1,-8,0.5,0), Size=UDim2.fromOffset(26,26), BackgroundColor3=Color3.fromRGB(255,85,85), Text="✕", TextColor3=Color3.new(1,1,1), Font=Enum.Font.GothamBold, TextSize=12, AutoButtonColor=false},{Create("UICorner",{CornerRadius=UDim.new(0,7)})})
    CloseBtn.MouseEnter:Connect(function() Tween(CloseBtn,{BackgroundColor3=Color3.fromRGB(255,60,60)},0.15):Play() end)
    CloseBtn.MouseLeave:Connect(function() Tween(CloseBtn,{BackgroundColor3=Color3.fromRGB(255,85,85)},0.15):Play() end)
    CloseBtn.MouseButton1Click:Connect(function() Tween(Shadow,{Size=UDim2.fromOffset(0,0)},0.25,Enum.EasingStyle.Back,Enum.EasingDirection.In):Play() task.wait(0.25) ScreenGui:Destroy() if Blur then Blur:Destroy() end end)
    
    local MinBtn = Create("TextButton",{Parent=TitleBar, AnchorPoint=Vector2.new(1,0.5), Position=UDim2.new(1,-38,0.5,0), Size=UDim2.fromOffset(26,26), BackgroundColor3=Theme.Background, Text="—", TextColor3=Theme.Text, Font=Enum.Font.GothamBold, TextSize=12, AutoButtonColor=false},{Create("UICorner",{CornerRadius=UDim.new(0,7)}),Create("UIStroke",{Color=Theme.Border,Transparency=0.5})})
    local minimized=false
    MinBtn.MouseButton1Click:Connect(function() minimized=not minimized Tween(Shadow,{Size=minimized and UDim2.fromOffset(500,38) or Size + UDim2.fromOffset(20,20)},0.3,Enum.EasingStyle.Quint):Play() end)
    
    -- Tab system holder
    local TabHolder = Create("Frame",{Parent=Main, Position=UDim2.fromOffset(0,38), Size=UDim2.new(0,125,1,-38), BackgroundColor3=Theme.Background2, BackgroundTransparency=0.2, BorderSizePixel=0},{Create("UIListLayout",{Padding=UDim.new(0,4),SortOrder=2}),Create("UIPadding",{PaddingTop=UDim.new(0,8),PaddingLeft=UDim.new(0,6),PaddingRight=UDim.new(0,6),PaddingBottom=UDim.new(0,8)}),Create("UIStroke",{Color=Theme.Border,Transparency=0.8})})
    local ContentHolder = Create("Frame",{Parent=Main, Position=UDim2.new(0,125,0,38), Size=UDim2.new(1,-125,1,-38), BackgroundTransparency=1, ClipsDescendants=true})
    
    local Window={Tabs={}, Theme=Theme, Frame=Main, Shadow=Shadow, ScreenGui=ScreenGui}
    
    function Window:CreateTab(Cfg2)
        Cfg2=Cfg2 or {}
        local TabName=Cfg2.Name or "Tab"
        local Icon=Cfg2.Icon or "•"
        local TabButton = Create("TextButton",{Parent=TabHolder, Size=UDim2.new(1,0,0,32), BackgroundColor3=Theme.Background, BackgroundTransparency=0.6, Text=Icon.."  "..TabName, TextColor3=Theme.Text2, Font=Enum.Font.GothamMedium, TextSize=12, TextXAlignment=0, AutoButtonColor=false},{Create("UIPadding",{PaddingLeft=UDim.new(0,10)}),Create("UICorner",{CornerRadius=UDim.new(0,7)}),Create("UIStroke",{Color=Theme.Border,Transparency=0.9})})
        local TabContent = Create("ScrollingFrame",{Parent=ContentHolder, Size=UDim2.fromScale(1,1), BackgroundTransparency=1, Visible=false, ScrollBarThickness=2, ScrollBarImageColor3=Theme.Accent, CanvasSize=UDim2.new(0,0,0,0), AutomaticCanvasSize=Enum.AutomaticSize.Y, BorderSizePixel=0, ClipsDescendants=false},{Create("UIListLayout",{Padding=UDim.new(0,8),SortOrder=2}),Create("UIPadding",{PaddingTop=UDim.new(0,10),PaddingLeft=UDim.new(0,10),PaddingRight=UDim.new(0,10),PaddingBottom=UDim.new(0,10)})})
        
        TabButton.MouseEnter:Connect(function() if TabContent.Visible==false then Tween(TabButton,{BackgroundTransparency=0.3},0.15):Play() end end)
        TabButton.MouseLeave:Connect(function() if TabContent.Visible==false then Tween(TabButton,{BackgroundTransparency=0.6},0.15):Play() end end)
        TabButton.MouseButton1Click:Connect(function()
            for _,t in pairs(Window.Tabs) do t.Content.Visible=false Tween(t.Button,{BackgroundTransparency=0.6,BackgroundColor3=Theme.Background},0.15):Play() t.Button.TextColor3=Theme.Text2 end
            TabContent.Visible=true
            Tween(TabButton,{BackgroundTransparency=0.05,BackgroundColor3=Theme.Accent},0.2):Play()
            TabButton.TextColor3=Color3.new(1,1,1)
