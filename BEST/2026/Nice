local Theme = NiceLib.Themes.Dark

local function Tween(obj, info, props, callback)
    local tw = TweenService:Create(obj, info, props)
    tw:Play()
    if callback then tw.Completed:Connect(callback) end
    return tw
end

local function QTween(obj, time, props)
    return Tween(obj, TweenInfo.new(time or 0.25, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), props)
end

local Creator = {}
function Creator.New(className, properties, children)
    local instance = Instance.new(className)
    local parent
    for k,v in pairs(properties or {}) do
        if k == "Parent" then parent = v else pcall(function() instance[k] = v end) end
    end
    if parent then instance.Parent = parent end
    for _, child in ipairs(children or {}) do child.Parent = instance end
    return instance
end

function Creator.Corner(radius, parent)
    return Creator.New("UICorner", {CornerRadius = UDim.new(0, radius or 8), Parent = parent})
end

function Creator.Stroke(color, thick, trans, parent)
    return Creator.New("UIStroke", {Color = color or Theme.Border, Thickness = thick or 1, Transparency = trans or 0, Parent = parent})
end

function Creator.Padding(t,r,b,l, parent)
    return Creator.New("UIPadding", {PaddingTop=UDim.new(0,t or 0), PaddingRight=UDim.new(0,r or t or 0), PaddingBottom=UDim.new(0,b or t or 0), PaddingLeft=UDim.new(0,l or r or t or 0), Parent=parent})
end

