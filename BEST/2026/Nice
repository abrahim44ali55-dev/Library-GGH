    Util:Corner(glowStroke.Parent,16)

    local topBar=Util:Create("Frame",{Name="TopBar",BackgroundColor3=th.Panel,Size=UDim2.new(1,0,0,40),BorderSizePixel=0,ZIndex=3,Parent=main})
    Util:Corner(topBar,16)
    Util:Create("Frame",{BackgroundColor3=th.Panel,Size=UDim2.new(1,0,0,12),Position=UDim2.new(0,0,1,-12),BorderSizePixel=0,ZIndex=3,Parent=topBar})
