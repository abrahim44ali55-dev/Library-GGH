                btn.MouseLeave:Connect(function() Tween(btn,0.2,{BackgroundColor3=GGH.CurrentTheme.Button}) end)
                btn.MouseButton1Click:Connect(cfg.Callback)
                return btn
            end
            
            -- TOGGLE
            function Section:AddToggle(cfg)
                cfg.Title=cfg.Title or "Toggle"; cfg.Default=cfg.Default or false; cfg.Callback=cfg.Callback or function() end
                local toggled=cfg.Default
                local f = Create("Frame", {Size=UDim2.new(1,0,0,38), BackgroundColor3=GGH.CurrentTheme.Button, Parent=secFrame})
                Corner(f,8)
                Create("TextLabel", {Text=cfg.Title, Font=Enum.Font.Gotham, TextSize=13, TextColor3=GGH.CurrentTheme.Text, BackgroundTransparency=1, Size=UDim2.new(1,-60,1,0), Position=UDim2.new(0,12,0,0), TextXAlignment=Enum.TextXAlignment.Left, Parent=f})
