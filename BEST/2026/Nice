-- Helper function to validate and format dynamic image URLs
local function FormatImageUrl(url)
    if type(url) ~= "string" or url == "" then
        return "rbxassetid://7803241868"
    end
    if tonumber(url) then
        return "rbxassetid://" .. tostring(url)
    elseif string.sub(url, 1, 13) == "rbxassetid://" or string.sub(url, 1, 10) == "http://www" or string.sub(url, 1, 8) == "https://" or string.sub(url, 1, 7) == "http://" then
        return url
    else
        return "rbxassetid://7803241868"
    end
end

