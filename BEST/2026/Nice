    local btnHolder=Util:Create("Frame",{BackgroundTransparency=1,Size=UDim2.fromOffset(72,30),Position=UDim2.new(1,-80,0,5),ZIndex=4,Parent=topBar})
    Util:List(btnHolder,Enum.FillDirection.Horizontal,6)
    local minimizeBtn=Util:Create("TextButton",{Text="—",Font=Enum.Font.GothamBold,TextSize=12,TextColor3=th.Sub,BackgroundColor3=th.Sec,Size=UDim2.fromOffset(30,30),AutoButtonColor=false,ZIndex=4,Parent=btnHolder})
    Util:Corner(minimizeBtn,8)
    local closeBtn=Util:Create("TextButton",{Text="✕",Font=Enum.Font.GothamBold,TextSize=12,TextColor3=Color3.fromRGB(255,95,95),BackgroundColor3=th.Sec,Size=UDim2.fromOffset(30,30),AutoButtonColor=false,ZIndex=4,Parent=btnHolder})
    Util:Corner(closeBtn,8)

    local content=Util:Create("Frame",{Name="Content",BackgroundTransparency=1,Size=UDim2.new(1,0,1,-40),Position=UDim2.fromOffset(0,40),ClipsDescendants=true,ZIndex=3,Parent=main})
    local tabBar=Util:Create("ScrollingFrame",{Name="TabBar",BackgroundColor3=th.Panel,BackgroundTransparency=0.15,Size=UDim2.new(0,150,1,0),ScrollBarThickness=2,CanvasSize=UDim2.new(0,0,0,0),AutomaticCanvasSize=Enum.AutomaticSize.Y,BorderSizePixel=0,ZIndex=3,Parent=content,ScrollingDirection=Enum.ScrollingDirection.Y})
    Util:List(tabBar,Enum.FillDirection.Vertical,4); Util:Padding(tabBar,{8,8,8,8})
    local tabContent=Util:Create("Frame",{Name="TabContent",BackgroundTransparency=1,Size=UDim2.new(1,-150,1,0),Position=UDim2.new(0,150,0,0),ZIndex=3,Parent=content})

    local resizeHandle=Util:Create("Frame",{Name="Resize",BackgroundTransparency=1,AnchorPoint=Vector2.new(1,1),Position=UDim2.new(1,0,1,0),Size=UDim2.fromOffset(22,22),ZIndex=10,Parent=main})
    Util:Create("TextLabel",{Text="◢",Font=Enum.Font.Gotham,TextSize=10,TextColor3=th.Sub,BackgroundTransparency=1,Size=UDim2.fromScale(1,1),Parent=resizeHandle})

    local floatBar=Util:Create("Frame",{Name="FloatingBar",BackgroundColor3=th.Panel,Size=UDim2.fromOffset(220,40),Position=UDim2.new(0.5,-110,0,10),Visible=false,ZIndex=50,Parent=gui})
    Util:Corner(floatBar,20); Util:Stroke(floatBar,th.Border,1,0.1)
    local dragBtn=Util:Create("TextButton",{Text="≡",Font=Enum.Font.GothamBold,TextSize=16,TextColor3=th.Sub,BackgroundColor3=th.Sec,Size=UDim2.fromOffset(32,32),Position=UDim2.fromOffset(4,4),AutoButtonColor=false,Parent=floatBar})
    Util:Corner(dragBtn,16)
    Util:Create("TextLabel",{Text="GGH Lib",Font=Enum.Font.GothamBold,TextSize=12,TextColor3=th.Text,BackgroundTransparency=1,Size=UDim2.new(1,-90,1,0),Position=UDim2.fromOffset(42,0),TextXAlignment=Enum.TextXAlignment.Left,Parent=floatBar})
    local restoreBtn=Util:Create("TextButton",{Text="↗",Font=Enum.Font.GothamBold,TextSize=14,TextColor3=th.Accent,BackgroundColor3=th.Bg,Size=UDim2.fromOffset(32,32),Position=UDim2.new(1,-36,0,4),AutoButtonColor=false,Parent=floatBar})
    Util:Corner(restoreBtn,16)

    local dragging, dragStart, startPos, dragInput
    topBar.InputBegan:Connect(function(input) if input.UserInputType==Enum.UserInputType.MouseButton1 or input.UserInputType==Enum.UserInputType.Touch then dragging=true; dragStart=input.Position; startPos=main.Position end end)
    topBar.InputChanged:Connect(function(input) if input.UserInputType==Enum.UserInputType.MouseMovement or input.UserInputType==Enum.UserInputType.Touch then dragInput=input end end)
    UserInputService.InputChanged:Connect(function(input) if input==dragInput and dragging then local delta=input.Position-dragStart; main.Position=UDim2.new(startPos.X.Scale,startPos.X.Offset+delta.X,startPos.Y.Scale,startPos.Y.Offset+delta.Y) end end)
    UserInputService.InputEnded:Connect(function(input) if input.UserInputType==Enum.UserInputType.MouseButton1 or input.UserInputType==Enum.UserInputType.Touch then dragging=false end end)

    local resizing, rStart, rSize, rInput
    resizeHandle.InputBegan:Connect(function(input) if input.UserInputType==Enum.UserInputType.MouseButton1 or input.UserInputType==Enum.UserInputType.Touch then resizing=true; rStart=input.Position; rSize=main.Size end end)
    resizeHandle.InputChanged:Connect(function(input) if input.UserInputType==Enum.UserInputType.MouseMovement or input.UserInputType==Enum.UserInputType.Touch then rInput=input end end)
    UserInputService.InputChanged:Connect(function(input) if input==rInput and resizing then local delta=input.Position-rStart; main.Size=UDim2.new(0, math.clamp(rSize.X.Offset+delta.X, 460, 900), 0, math.clamp(rSize.Y.Offset+delta.Y, 300, 700)) end end)
    UserInputService.InputEnded:Connect(function() resizing=false end)

    local function setMinimized(state)
        if state then
            TweenService:Create(main,TweenInfo.new(0.25,Enum.EasingStyle.Back,Enum.EasingDirection.In),{Size=UDim2.fromOffset(0,0)}):Play()
            task.wait(0.22); main.Visible=false; floatBar.Visible=true; floatBar.Size=UDim2.fromOffset(0,40)
            TweenService:Create(floatBar,TweenInfo.new(0.4,Enum.EasingStyle.Back,Enum.EasingDirection.Out),{Size=UDim2.fromOffset(220,40)}):Play()
        else
            floatBar.Visible=false; main.Visible=true; main.Size=UDim2.fromOffset(0,0)
            TweenService:Create(main,TweenInfo.new(0.4,Enum.EasingStyle.Back,Enum.EasingDirection.Out),{Size=opts.Size or UDim2.fromOffset(580,420)}):Play()
        end
    end
    minimizeBtn.MouseButton1Click:Connect(function() setMinimized(true) end)
    restoreBtn.MouseButton1Click:Connect(function() setMinimized(false) end)
    closeBtn.MouseButton1Click:Connect(function()
        ShowConfirm(gui, "إغلاق الواجهة؟", "هل تريد إغلاق GGH Lib؟", function() gui:Destroy() end)
    end)
    Util:MakeDraggable(dragBtn,floatBar)

    Theme:OnChanged(function(t)
        main.BackgroundColor3=t.Bg; topBar.BackgroundColor3=t.Panel; title.TextColor3=t.Text; mainStroke.Color=t.Border; glowStroke.Color=t.Accent; tabBar.BackgroundColor3=t.Panel
    end)

    return {Main=main, TabBar=tabBar, TabContent=tabContent}
end

-- ============ MAIN API ============
function GGH:CreateWindow(opts)
    opts=opts or {}
    local parent = (gethui and gethui()) or LocalPlayer:WaitForChild("PlayerGui")
    local gui=Util:Create("ScreenGui",{Name="GGH_"..(opts.Title or "Window").."_"..math.random(1000,9999),ZIndexBehavior=Enum.ZIndexBehavior.Sibling,ResetOnSpawn=false,IgnoreGuiInset=true,Parent=parent})
    Notif:Init(gui)
    local parts=BuildWindow(gui, opts)
    local Tabs={}
    local WindowObj={Gui=gui, Main=parts.Main}

    function WindowObj:CreateTab(name)
        local th=Theme.Current
        local tabBtn=Util:Create("TextButton",{Text=name,Font=Enum.Font.GothamBold,TextSize=12,TextColor3=th.Sub,BackgroundColor3=th.Panel,BackgroundTransparency=0.3,Size=UDim2.new(1,0,0,36),AutoButtonColor=false,Parent=parts.TabBar})
        Util:Corner(tabBtn,9)
        local page=Util:Create("ScrollingFrame",{Name=name.."Page",BackgroundTransparency=1,Size=UDim2.fromScale(1,1),Visible=false,ScrollBarThickness=2,CanvasSize=UDim2.new(0,0,0,0),AutomaticCanvasSize=Enum.AutomaticSize.Y,ScrollingDirection=Enum.ScrollingDirection.Y,Parent=parts.TabContent})
        Util:List(page,Enum.FillDirection.Vertical,6); Util:Padding(page,{12,12,12,12})
        local tabObj={Button=tabBtn, Page=page, Name=name}
        tabBtn.MouseButton1Click:Connect(function()
            for _,t in pairs(Tabs) do t.Page.Visible=false; t.Button.BackgroundColor3=th.Panel; t.Button.TextColor3=th.Sub; t.Button.BackgroundTransparency=0.3 end
            page.Visible=true; tabBtn.BackgroundColor3=th.Accent; tabBtn.TextColor3=Color3.new(1,1,1); tabBtn.BackgroundTransparency=0
        end)
        if #Tabs==0 then tabBtn.BackgroundColor3=th.Accent; tabBtn.TextColor3=Color3.new(1,1,1); tabBtn.BackgroundTransparency=0; page.Visible=true end
        Tabs[name]=tabObj; table.insert(Tabs,tabObj)
        function tabObj:CreateButton(o) return CreateButton(page,o) end
        function tabObj:CreateToggle(o) return CreateToggle(page,o) end
        function tabObj:CreateSlider(o) return CreateSlider(page,o) end
        function tabObj:CreateDropdown(o) return CreateDropdown(page,o) end
        function tabObj:CreateMultiDropdown(o) return CreateMultiDropdown(page,o) end
        function tabObj:CreateTextbox(o) return CreateTextbox(page,o) end
        function tabObj:CreateColorPicker(o) return CreateColorPicker(page,o) end
        function tabObj:CreateKeybind(o) return CreateKeybind(page,o) end
        function tabObj:CreateProgress(o) return CreateProgress(page,o) end
        function tabObj:CreateParagraph(o) return CreateParagraph(page,o) end
        function tabObj:CreateSection(n) return CreateSection(page,n) end
        function tabObj:CreateDivider() return CreateDivider(page) end
        tabObj.CreateLabel = tabObj.CreateSection
        return tabObj
    end

    function WindowObj:Notify(o) return Notif:Notify(o) end
    function WindowObj:SetTheme(n) Theme:Set(n) end
    function WindowObj:CreateThemeEditor()
        local ed=self:CreateTab("🎨 Themes")
        ed:CreateParagraph({Title="15 ثيم فخم", Content="تطبق على كل العناصر فوراً مع Glow."})
        for name,_ in pairs(Theme.Themes) do
            ed:CreateButton({Name=name, Callback=function() Theme:Set(name) end})
        end
        return ed
    end

    Theme:OnChanged(function(t)
        for _,tab in ipairs(Tabs) do
            if tab.Page.Visible then tab.Button.BackgroundColor3=t.Accent else tab.Button.BackgroundColor3=t.Panel end
        end
    end)

    return WindowObj
end

function GGH:Notify(o) return Notif:Notify(o) end
function GGH:SetTheme(n) Theme:Set(n) end
GGH.Themes=Theme.Themes
return GGH
