        local function ActivateTab()
            for _, item in ipairs(Library.Registry) do
                if item.Type == "Tab" then
                    item.Page.Visible = false
                    item.Active = false
                    TweenService:Create(item.Button, TweenInfo.new(0.2), {BackgroundColor3 = Library.Themes[Library.CurrentTheme].TabsBg}):Play()
                    TweenService:Create(item.Text, TweenInfo.new(0.2), {TextColor3 = Library.Themes[Library.CurrentTheme].SubTextColor}):Play()
                    if item.Icon then
                        TweenService:Create(item.Icon, TweenInfo.new(0.2), {ImageColor3 = Library.Themes[Library.CurrentTheme].Accent}):Play()
                    end
                end
            end
            TabRecord.Active = true
            Page.Visible = true
            TweenService:Create(TabButton, TweenInfo.new(0.2), {BackgroundColor3 = Library.Themes[Library.CurrentTheme].Accent}):Play()
            TweenService:Create(TextLabel, TweenInfo.new(0.2), {TextColor3 = Library.Themes[Library.CurrentTheme].TextColor}):Play()
