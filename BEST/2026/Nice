function GGH:CreateWindow(options)
    options=options or {}
    local parent=GetParent()
    local gui=Util:Create("ScreenGui",{Name="GGH_"..(options.Title or "Window").."_"..math.random(1000,9999),ZIndexBehavior=Enum.ZIndexBehavior.Sibling,ResetOnSpawn=false,IgnoreGuiInset=true,Parent=parent})
    Notification:Init(gui)
    local parts=BuildWindowV5(gui, options)
    local tabs={}
    local tabList={}
    local WindowObj={Gui=gui, Main=parts.Main}

    function WindowObj:CreateTab(name)
        local th=Theme.Current
        local tabBtn=Util:Create("TextButton",{Text=name,Font=Enum.Font.GothamBold,TextSize=12,TextColor3=th.Sub,BackgroundColor3=th.Panel,BackgroundTransparency=0.4,Size=UDim2.new(1,0,0,36),AutoButtonColor=false,TextWrapped=true,Parent=parts.TabBar}); Util:Corner(tabBtn,9); tabBtn.AutoLocalize=false
        local page=Util:Create("ScrollingFrame",{Name=name.."_Page",BackgroundTransparency=1,Size=UDim2.fromScale(1,1),Visible=false,ScrollBarThickness=3,CanvasSize=UDim2.new(0,0,0,0),AutomaticCanvasSize=Enum.AutomaticSize.Y,ScrollingDirection=Enum.ScrollingDirection.Y,Parent=parts.TabContent})
        Util:List(page,Enum.FillDirection.Vertical,8); Util:Padding(page,{12,12,12,60})
        local tabObj={Button=tabBtn, Page=page, Name=name}
        tabBtn.MouseButton1Click:Connect(function()
            for _,t in pairs(tabs) do t.Page.Visible=false; t.Button.BackgroundColor3=th.Panel; t.Button.TextColor3=th.Sub; t.Button.BackgroundTransparency=0.4 end
            page.Visible=true; tabBtn.BackgroundColor3=th.Accent; tabBtn.TextColor3=Color3.new(1,1,1); tabBtn.BackgroundTransparency=0
        end)
        if #tabList==0 then tabBtn.BackgroundColor3=th.Accent; tabBtn.TextColor3=Color3.new(1,1,1); tabBtn.BackgroundTransparency=0; page.Visible=true end
        tabs[name]=tabObj; table.insert(tabList, tabObj)

        function tabObj:CreateButton(o) return ElButton(page,o) end
        function tabObj:CreateToggle(o) return ElToggle(page,o) end
        function tabObj:CreateSlider(o) return ElSlider(page,o) end
        function tabObj:CreateDropdown(o) return ElDropdown(page,o) end
        function tabObj:CreateMultiDropdown(o) return ElMultiDropdown(page,o) end
        function tabObj:CreateTextbox(o) return ElTextbox(page,o) end
        function tabObj:CreateColorPicker(o) return ElColorPicker(page,o) end
        function tabObj:CreateKeybind(o) return ElKeybind(page,o) end
        function tabObj:CreateParagraph(o) return ElParagraph(page,o) end
        function tabObj:CreateSection(n) return ElSection(page,n) end
        function tabObj:CreateDivider() return ElDivider(page) end
        function tabObj:CreateProgress(o) return ElProgress(page,o) end
        function tabObj:CreateImage(o) return ElImage(page,o) end
        function tabObj:CreateAvatar(o) return ElAvatar(page,o) end
        function tabObj:CreateCard(o) return ElCard(page,o) end
        function tabObj:CreateBadge(o) return ElBadge(page,o) end
        function tabObj:CreateSearchBox(o) return ElSearchBox(page,o) end
        function tabObj:CreateAccordion(o) return ElAccordion(page,o) end
        function tabObj:CreateGrid(o) return ElGrid(page,o) end
        function tabObj:CreateTooltip(o) return ElTooltip(page,o) end

        tabObj.CreateLabel=tabObj.CreateSection
        return tabObj
    end

    function WindowObj:Notify(o) return Notification:Notify(o) end
    function WindowObj:SetTheme(n) Theme:Set(n) end
    function WindowObj:SetTransparency(v) 
        Theme.Current.Transparency=v
        parts.Main.BackgroundTransparency=v
        Theme:Set(Theme.Current)
    end
    function WindowObj:CreateCustomTheme(o)
        local t=Theme:CreateCustomTheme(o)
        Theme:Set(t.Name)
        return t
    end
    function WindowObj:CreateThemeEditor()
        local ed=self:CreateTab("Themes")
        ed:CreateParagraph({Title="15 Correct Themes", Content="Every theme uses shades of its accent color. Bg, Panel, Sec all share same hue with different brightness."})
        ed:CreateDivider()
        for name,_ in pairs(Theme.Themes) do
            ed:CreateButton({Name=name, Callback=function() Theme:Set(name) end})
        end
        ed:CreateSection("Custom Theme")
        ed:CreateButton({Name="Create Gradient Theme", Callback=function()
            Theme:CreateCustomTheme({
                Name="MyGradient",
                Accent=Color3.fromRGB(124,58,237),
                Gradient=ColorSequence.new{ColorSequenceKeypoint.new(0,Color3.fromRGB(124,58,237)),ColorSequenceKeypoint.new(1,Color3.fromRGB(6,182,212))},
                Transparency=0.1
            })
            WindowObj:Notify({Title="Custom Theme", Content="Gradient theme created!", Type="Success"})
        end})
        ed:CreateButton({Name="Create Image Bg Theme", Callback=function()
            -- Example with external image
            Theme:CreateCustomTheme({
                Name="ImageTheme",
                Accent=Color3.fromRGB(255,255,255),
                ImageId="rbxassetid://6075440257",
                Transparency=0.2
            })
            WindowObj:Notify({Title="Custom Theme", Content="Image background theme!", Type="Success"})
        end})
        ed:CreateSlider({Name="Transparency", Min=0, Max=80, Default=0, Callback=function(v)
            WindowObj:SetTransparency(v/100)
        end})
        return ed
    end

    Theme:OnChanged(function(t)
        for _,tab in ipairs(tabList) do
            if tab.Page.Visible then
                tab.Button.BackgroundColor3=t.Accent
                tab.Button.TextColor3=Color3.new(1,1,1)
                tab.Button.BackgroundTransparency=0
            else
                tab.Button.BackgroundColor3=t.Panel
                tab.Button.TextColor3=t.Sub
                tab.Button.BackgroundTransparency=0.4
            end
        end
    end)

    return WindowObj
end

