    local WindowObj={Gui=gui, Main=parts.Main}

    function WindowObj:CreateTab(name)
        local th=Theme.Current
        local tabBtn=Util:Create("TextButton",{Text=name,Font=Enum.Font.GothamBold,TextSize=12,TextColor3=th.Sub,BackgroundColor3=th.Panel,BackgroundTransparency=0.3,Size=UDim2.new(1,0,0,34),AutoButtonColor=false,Parent=parts.TabBar}); Util:Corner(tabBtn,8); tabBtn.AutoLocalize=false
        local page=Util:Create("ScrollingFrame",{Name=name.."Page",BackgroundTransparency=1,Size=UDim2.fromScale(1,1),Visible=false,ScrollBarThickness=2,CanvasSize=UDim2.new(0,0,0,0),AutomaticCanvasSize=Enum.AutomaticSize.Y,ScrollingDirection=Enum.ScrollingDirection.Y,Parent=parts.TabContent})
        Util:List(page,Enum.FillDirection.Vertical,6); Util:Padding(page,{10,10,10,50})
        local tabObj={Button=tabBtn, Page=page, Name=name}
        tabBtn.MouseButton1Click:Connect(function()
            for _,t in pairs(Tabs) do t.Page.Visible=false; t.Button.BackgroundColor3=th.Panel; t.Button.TextColor3=th.Sub; t.Button.BackgroundTransparency=0.3 end
            page.Visible=true; tabBtn.BackgroundColor3=th.Accent; tabBtn.TextColor3=Color3.new(1,1,1); tabBtn.BackgroundTransparency=0
        end)
        if #Tabs==0 then tabBtn.BackgroundColor3=th.Accent; tabBtn.TextColor3=Color3.new(1,1,1); tabBtn.BackgroundTransparency=0; page.Visible=true end
        Tabs[name]=tabObj; table.insert(Tabs,tabObj)
        function tabObj:CreateButton(o) return CreateButton(page,o) end
        function tabObj:CreateToggle(o) return CreateToggle(page,o) end
        function tabObj:CreateSlider(o) return CreateSlider(page,o) end
        function tabObj:CreateDropdown(o) return CreateDropdown(page,o) end
        function tabObj:CreateTextbox(o) return CreateTextbox(page,o) end
        function tabObj:CreateColorPicker(o) return CreateColorPicker(page,o) end
        function tabObj:CreateParagraph(o) return CreateParagraph(page,o) end
        function tabObj:CreateSection(n) return CreateSection(page,n) end
        function tabObj:CreateDivider() return CreateDivider(page) end
        return tabObj
    end

    function WindowObj:Notify(o) return Notif:Notify(o) end
    function WindowObj:SetTheme(n) Theme:Set(n) end
    function WindowObj:CreateThemeEditor()
        local ed=self:CreateTab("Themes")
        ed:CreateParagraph({Title="15 Premium Themes", Content="All elements update instantly with high contrast text."})
        for name,_ in pairs(Theme.Themes) do ed:CreateButton({Name=name, Callback=function() Theme:Set(name) end}) end
        return ed
    end

    Theme:OnChanged(function(t) for _,tab in ipairs(Tabs) do if tab.Page.Visible then tab.Button.BackgroundColor3=t.Accent else tab.Button.BackgroundColor3=t.Panel end end end)
    return WindowObj
end

function GGH:Notify(o) return Notif:Notify(o) end
function GGH:SetTheme(n) Theme:Set(n) end
GGH.Themes=Theme.Themes
return GGH
