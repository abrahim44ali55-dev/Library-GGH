            local Section = {}
            
            -- BUTTON (WindUI + Orion style)
            function Section:AddButton(cfg)
                cfg.Title = cfg.Title or "Button"
                cfg.Callback = cfg.Callback or function() end
                local btn = Create("TextButton", {Text="", Size=UDim2.new(1,0,0,38), BackgroundColor3=GGH.CurrentTheme.Button, AutoButtonColor=false, Parent=secFrame})
                Corner(btn, 8)
                Stroke(btn, GGH.CurrentTheme.Stroke, 1)
