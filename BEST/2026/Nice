local function CreateSquircle(parent, size, pos, color, transparency, radius, useGlass)
    local frame = Instance.new("ImageLabel")
    frame.Name = "Squircle"
    frame.Size = size
    frame.Position = pos or UDim2.new(0,0,0,0)
    frame.BackgroundTransparency = 1
    frame.Image = useGlass and SquircleAssets.SquircleGlass or SquircleAssets.Squircle
    frame.ImageColor3 = color or Color3.fromRGB(20,20,25)
    frame.ImageTransparency = transparency or 0.2
    frame.ScaleType = Enum.ScaleType.Slice
    frame.SliceCenter = Rect.new(460,460,460,460)
    frame.SliceScale = (radius or 16) / 310
    frame.Parent = parent
    return frame
end

