            local function Update(newVal, noAnim)
                Value=newVal
                local dur=noAnim and 0 or 0.25
                Tween(Switch,{BackgroundColor3=Value and Theme.Accent or Theme.Border},dur,Enum.EasingStyle.Back):Play()
