function NiceLib.Anim:Shake(obj)
    local orig = obj.Position
    for i=1,6 do
        Tween(obj, TweenInfo.new(0.05), {Position=orig + UDim2.new(0,math.random(-6,6),0,0)})
        task.wait(0.05)
    end
    Tween(obj, TweenInfo.new(0.1), {Position=orig})
end
function NiceLib.Anim:Glow(obj, color)
    local stroke = obj:FindFirstChildOfClass("UIStroke") or Creator.Stroke(color or Theme.Accent,2,0,obj)
    Tween(stroke, TweenInfo.new(0.3), {Thickness=3})
    task.wait(0.3)
    Tween(stroke, TweenInfo.new(0.3), {Thickness=1})
end

