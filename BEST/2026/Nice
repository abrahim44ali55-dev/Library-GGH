-- Generate shades from base color
local function GenerateShades(baseAccent, isDark)
    -- isDark = true for dark themes
    if isDark then
        local h,s,v = Color3.toHSV(baseAccent)
        -- Generate bg/panel/sec with same hue but low saturation
        local bg = Color3.fromHSV(h, s*0.15, 0.06)
        local panel = Color3.fromHSV(h, s*0.18, 0.11)
        local sec = Color3.fromHSV(h, s*0.2, 0.17)
        local border = Color3.fromHSV(h, s*0.15, 0.22)
        local text = Color3.fromRGB(245,245,250)
        local sub = Color3.fromHSV(h, s*0.2, 0.65)
        return bg, panel, sec, text, sub, border
    else
        local h,s,v = Color3.toHSV(baseAccent)
        local bg = Color3.fromHSV(h, s*0.08, 0.97)
        local panel = Color3.fromHSV(0,0,1)
        local sec = Color3.fromHSV(h, s*0.08, 0.93)
        local border = Color3.fromHSV(h, s*0.12, 0.88)
        local text = Color3.fromRGB(18,18,22)
        local sub = Color3.fromHSV(h, s*0.15, 0.45)
        return bg, panel, sec, text, sub, border
    end
end

local function CreateThemeFromAccent(name, accent, isDark)
    isDark = (isDark == nil) and true or isDark
    local bg, panel, sec, text, sub, border = GenerateShades(accent, isDark)
    local accent2 = Color3.fromHSV(select(1, Color3.toHSV(accent)), math.clamp(select(2, Color3.toHSV(accent))*1.1,0,1), math.clamp(select(3, Color3.toHSV(accent))*1.15,0,1))
    return {
        Name=name,
        Bg=bg, Panel=panel, Sec=sec, Text=text, Sub=sub, Border=border,
        Accent=accent, Accent2=accent2,
        Success=Color3.fromRGB(16,185,129),
        Warn=Color3.fromRGB(245,158,11),
        Err=Color3.fromRGB(239,68,68),
        AccentHover=accent:Lerp(Color3.new(1,1,1),0.15),
        Transparency=0,
        Gradient=nil,
        ImageId=nil,
    }
end

