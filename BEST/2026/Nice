            Label.AutoLocalize = true
            RegisterThemable(Label, "TextColor3", "Text")
            local Bar = Instance.new("Frame", Frame)
            Bar.Size = UDim2.new(1,-20,0,8)
            Bar.Position = UDim2.new(0,10,0,32)
            Bar.BackgroundColor3 = CurrentTheme.ElementBg2
            Corner(Bar, 4)
            RegisterThemable(Bar, "BackgroundColor3", "ElementBg2")
            local Fill = Instance.new("Frame", Bar)
            Fill.Size = UDim2.new((Value - Cfg.Min) / math.max(1, Cfg.Max - Cfg.Min),0,1,0)
            Fill.BackgroundColor3 = CurrentTheme.Accent
            Corner(Fill, 4)
            RegisterThemable(Fill, "BackgroundColor3", "Accent")
            local Circle = Instance.new("Frame", Frame)
            Circle.Size = UDim2.new(0,18,0,18)
            Circle.AnchorPoint = Vector2.new(0.5,0.5)
            Circle.Position = UDim2.new(0, 10 + ((Value - Cfg.Min)/math.max(1,Cfg.Max-Cfg.Min))*200, 0, 36)
            Circle.BackgroundColor3 = Color3.fromRGB(255,255,255)
            Circle.ZIndex = 10
            Corner(Circle, 9)
            local S = Stroke(Circle, CurrentTheme.Accent, 2)
            RegisterThemable(S, "Stroke", "Accent")
            local DragArea = Instance.new("TextButton", Bar)
            DragArea.Size = UDim2.new(1,0,2.5,0)
            DragArea.Position = UDim2.new(0,0,0.5,-10)
            DragArea.BackgroundTransparency = 1
            DragArea.Text = ""
            local dragging = false
            local function UpdateSlider(inputX)
                local barPos = Bar.AbsolutePosition.X
                local barSize = Bar.AbsoluteSize.X
                if barSize <= 0 then barSize = 200 end
                local rel = math.clamp((inputX - barPos) / barSize, 0, 1)
                Value = math.floor(Cfg.Min + (Cfg.Max - Cfg.Min) * rel)
                Fill.Size = UDim2.new(rel,0,1,0)
                Circle.Position = UDim2.new(0, 10 + rel*barSize, 0, 36)
                Label.Text = Cfg.Title.." : "..Value
                pcall(Cfg.Callback or function() end, Value)
            end
            task.spawn(function()
                task.wait(0.05)
                local barSize = Bar.AbsoluteSize.X
                if barSize <= 0 then barSize = 200 end
                local rel = (Value - Cfg.Min)/math.max(1,Cfg.Max-Cfg.Min)
                Circle.Position = UDim2.new(0, 10 + rel*barSize, 0, 36)
            end)
            DragArea.InputBegan:Connect(function(input)
                if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then dragging = true UpdateSlider(input.Position.X) end
            end)
            Circle.InputBegan:Connect(function(input)
                if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then dragging = true end
            end)
            UserInputService.InputChanged:Connect(function(input)
                if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then UpdateSlider(input.Position.X) end
            end)
            UserInputService.InputEnded:Connect(function(input)
                if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then dragging = false end
            end)
        end

