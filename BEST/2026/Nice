local Utilities = {}
function Utilities:Create(className, props, children)
    local inst = Instance.new(className)
    for k,v in pairs(props or {}) do if k~="Parent" then pcall(function() inst[k]=v end) end end
    for _,child in ipairs(children or {}) do child.Parent=inst end
    if props and props.Parent then inst.Parent=props.Parent end
    return inst
end
function Utilities:Corner(parent, radius) return self:Create("UICorner", {CornerRadius=UDim.new(0,radius or 10), Parent=parent}) end
function Utilities:Stroke(parent, color, thickness, trans) return self:Create("UIStroke", {Color=color or Color3.fromRGB(60,60,70), Thickness=thickness or 1, Transparency=trans or 0, ApplyStrokeMode=Enum.ApplyStrokeMode.Border, Parent=parent}) end
function Utilities:Padding(parent, t) t=t or {8,8,8,8} return self:Create("UIPadding", {PaddingTop=UDim.new(0,t[1]), PaddingBottom=UDim.new(0,t[2]), PaddingLeft=UDim.new(0,t[3]), PaddingRight=UDim.new(0,t[4]), Parent=parent}) end
function Utilities:List(parent, dir, pad, sort) return self:Create("UIListLayout", {FillDirection=dir or Enum.FillDirection.Vertical, Padding=UDim.new(0,pad or 6), SortOrder=sort or Enum.SortOrder.LayoutOrder, Parent=parent}) end
function Utilities:MakeDraggable(handle, target, onMove)
    local dragging, dragInput, dragStart, startPos
    local function update(input)
        local delta = input.Position - dragStart
        target.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
        target.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
        if onMove then onMove(target.Position) end
    end
    handle.InputBegan:Connect(function(input)
        if input.UserInputType==Enum.UserInputType.MouseButton1 or input.UserInputType==Enum.UserInputType.Touch then
            dragging=true; dragStart=input.Position; startPos=target.Position
            input.Changed:Connect(function() if input.UserInputState==Enum.UserInputState.End then dragging=false end end)
        end
    end)
    handle.InputChanged:Connect(function(input) if input.UserInputType==Enum.UserInputType.MouseMovement or input.UserInputType==Enum.UserInputType.Touch then dragInput=input end end)
    UserInputService.InputChanged:Connect(function(input) if input==dragInput and dragging then update(input) end end)
end

-- ===================== ANIMATION =====================
local Animation = {}
local Spring = {}; Spring.__index=Spring
function Spring.new(mass, force, damping, speed)
    return setmetatable({mass=mass or 1, force=force or 120, damping=damping or 14, speed=speed or 1.2, target=0, position=0, velocity=0}, Spring)
end
function Spring:Update(dt)
    local f = self.force*(self.target-self.position)
    local d = -self.damping*self.velocity
    local a = (f+d)/self.mass
    self.velocity+=a*dt*self.speed
    self.position+=self.velocity*dt*self.speed
    return self.position
end
Animation.Spring=Spring
function Animation:Tween(obj, props, info)
    info=info or TweenInfo.new(0.25, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
    local t=TweenService:Create(obj, info, props); t:Play(); return t
end
function Animation:Ripple(button)
    local ripple = Instance.new("Frame")
    ripple.Name="Ripple"; ripple.AnchorPoint=Vector2.new(0.5,0.5); ripple.BackgroundColor3=Color3.new(1,1,1); ripple.BackgroundTransparency=0.7
    ripple.Size=UDim2.fromOffset(0,0); ripple.Position=UDim2.fromScale(0.5,0.5); ripple.ZIndex=20
    Instance.new("UICorner", ripple).CornerRadius=UDim.new(1,0)
    ripple.Parent=button
    Animation:Tween(ripple, {Size=UDim2.fromOffset(button.AbsoluteSize.X*2.5, button.AbsoluteSize.X*2.5), BackgroundTransparency=1}, TweenInfo.new(0.55, Enum.EasingStyle.Quad, Enum.EasingDirection.Out))
    game.Debris:AddItem(ripple, 0.6)
end
function Animation:HoverEffect(button, theme)
    local default=button.BackgroundColor3
    local hover=theme and theme.ButtonHover or default:Lerp(Color3.new(1,1,1),0.12)
    button.MouseEnter:Connect(function() Animation:Tween(button, {BackgroundColor3=hover}, TweenInfo.new(0.15)) end)
    button.MouseLeave:Connect(function() Animation:Tween(button, {BackgroundColor3=default}, TweenInfo.new(0.15)) end)
end

