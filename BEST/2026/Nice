            TextXAlignment = Enum.TextXAlignment.Left,
            BackgroundTransparency = 1,
            Size = UDim2.new(0.6,0,1,0),
            Parent = top
        })
        local valLabel = Util.Create("TextLabel", {
            Text = tostring(opts.Default or opts.Min or 0),
            Font = Enum.Font.GothamBold,
            TextSize = 12,
            TextColor3 = theme.Primary,
            TextXAlignment = Enum.TextXAlignment.Right,
            BackgroundTransparency = 1,
            Size = UDim2.new(0.4,0,1,0),
            Position = UDim2.new(0.6,0,0,0),
            Parent = top
        })

        local track = Util.Create("Frame", {
            Size = UDim2.new(1,0,0,6),
            Position = UDim2.new(0,0,0,28),
            BackgroundColor3 = theme.Surface,
            Parent = container
        })
        Util.Corner(track, 3)
        local fill = Util.Create("Frame", {
            Size = UDim2.new(0.5,0,1,0),
            BackgroundColor3 = theme.Primary,
            Parent = track
        })
        Util.Corner(fill, 3)
        local thumb = Util.Create("Frame", {
            Size = UDim2.fromOffset(16,16),
            AnchorPoint = Vector2.new(0.5,0.5),
            Position = UDim2.new(0.5,0,0.5,0),
            BackgroundColor3 = Color3.new(1,1,1),
            Parent = track
        })
        Util.Corner(thumb, 8)
        Util.Stroke(thumb, theme.Primary, 2)

        local minV = opts.Min or 0
        local maxV = opts.Max or 100
        local current = State.new(opts.Default or minV)

        local function setFromPercent(p)
            p = math.clamp(p,0,1)
            local v = math.floor(minV + (maxV-minV)*p)
            current:Set(v)
            valLabel.Text = tostring(v)
            fill.Size = UDim2.new(p,0,1,0)
            thumb.Position = UDim2.new(p,0,0.5,0)
            if opts.Callback then task.spawn(opts.Callback, v) end
        end

        current:Subscribe(function(v)
            local p = (v-minV)/(maxV-minV)
            fill.Size = UDim2.new(p,0,1,0)
            thumb.Position = UDim2.new(p,0,0.5,0)
            valLabel.Text = tostring(v)
        end)

        local dragging = false
        track.InputBegan:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                dragging = true
                local x = (input.Position.X - track.AbsolutePosition.X)/track.AbsoluteSize.X
                setFromPercent(x)
            end
        end)
        UserInputService.InputChanged:Connect(function(input)
            if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
                local x = (input.Position.X - track.AbsolutePosition.X)/track.AbsoluteSize.X
                setFromPercent(x)
            end
        end)
        UserInputService.InputEnded:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 then dragging = false end
        end)

        setFromPercent((current:Get()-minV)/(maxV-minV))
        return {Get = function() return current:Get() end, Set = function(_,v) setFromPercent((v-minV)/(maxV-minV)) end}
    end

