    -- Dynamic Theme Manager Function
    function Library:SetTheme(themeName)
        if not Library.Themes[themeName] then return end
        Library.CurrentTheme = themeName
        local t = Library.Themes[themeName]

        Main.BackgroundColor3 = t.MainBg
        MainStroke.Color = t.BorderColor
        Top.BackgroundColor3 = t.TopBg
        TopCover.BackgroundColor3 = t.TopBg
        Line.BackgroundColor3 = t.BorderColor
        Logo.ImageColor3 = t.Accent
        GameName.TextColor3 = t.TextColor
        Minimize.ImageColor3 = t.SubTextColor
        Close.ImageColor3 = t.SubTextColor
        Tabs.BackgroundColor3 = t.TabsBg
        TabsCover.BackgroundColor3 = t.TabsBg
        TabsContainer.ScrollBarImageColor3 = t.Accent
        Pages.BackgroundColor3 = t.MainBg
        Resize.ImageColor3 = t.Accent
        FloatingToggleBtn.BackgroundColor3 = t.TopBg
        FloatingStroke.Color = t.Accent
        FloatingIcon.ImageColor3 = t.Accent
        FloatingText.TextColor3 = t.TextColor

        for _, item in ipairs(Library.Registry) do
            if item.Type == "Tab" then
                if item.Active then
                    item.Button.BackgroundColor3 = t.Accent
                    item.Text.TextColor3 = t.TextColor
                    if item.Icon then item.Icon.ImageColor3 = t.TextColor end
                else
                    item.Button.BackgroundColor3 = t.TabsBg
                    item.Text.TextColor3 = t.SubTextColor
                    if item.Icon then item.Icon.ImageColor3 = t.Accent end
                end
            elseif item.Type == "Button" then
                item.Frame.BackgroundColor3 = t.Accent
                item.Frame.TextColor3 = t.TextColor
            elseif item.Type == "Toggle" then
                item.Frame.BackgroundColor3 = t.ElementBg
                item.Title.TextColor3 = t.TextColor
                item.Box.BackgroundColor3 = t.Accent
                item.Stroke.Color = t.Accent
            elseif item.Type == "Slider" then
                item.Frame.BackgroundColor3 = t.ElementBg
                item.Title.TextColor3 = t.TextColor
                item.Value.TextColor3 = t.TextColor
                item.Bar.BackgroundColor3 = t.TabsBg
                item.Drag.BackgroundColor3 = t.Accent
            elseif item.Type == "Keybind" then
                item.Frame.BackgroundColor3 = t.ElementBg
                item.Title.TextColor3 = t.TextColor
                item.KeyLabel.BackgroundColor3 = t.TabsBg
                item.KeyLabel.TextColor3 = t.TextColor
            elseif item.Type == "InputBox" then
                item.Frame.BackgroundColor3 = t.ElementBg
                item.Title.TextColor3 = t.TextColor
                item.Box.BackgroundColor3 = t.TabsBg
                item.Box.TextColor3 = t.TextColor
            elseif item.Type == "Dropdown" then
                item.Choose.BackgroundColor3 = t.ElementBg
                item.Title.TextColor3 = t.TextColor
                item.Arrow.ImageColor3 = t.Accent
                item.Holder.BackgroundColor3 = t.ElementBg
            elseif item.Type == "Label" then
                item.Frame.BackgroundColor3 = t.ElementBg
                item.Frame.TextColor3 = t.TextColor
            elseif item.Type == "Image" then
                item.Frame.BackgroundColor3 = t.ElementBg
            end
        end
    end

