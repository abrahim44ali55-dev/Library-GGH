-- // MAIN WINDOW CREATOR - Stronger than both
function NovaUI:CreateWindow(Config)
    Config = Config or {}
    local Title = Config.Title or "NovaUI"
    local SubTitle = Config.SubTitle or "v2.0 Strongest"
    local ThemeName = Config.Theme or "Dark"
    local Acrylic = Config.Acrylic ~= false
    local Size = Config.Size or UDim2.fromOffset(580, 460)
    local MinimizeKey = Config.MinimizeKey or Enum.KeyCode.LeftControl
    
    NovaUI.CurrentTheme = NovaUI.Themes.List[ThemeName] or NovaUI.Themes.List.Dark
    local Theme = NovaUI.CurrentTheme
    
    -- ScreenGui
    local ScreenGui = Create("ScreenGui", {
        Name = "NovaUI",
        Parent = RunService:IsStudio() and Player.PlayerGui or CoreGui,
        ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
        ResetOnSpawn = false,
    })
    pcall(function() ScreenGui.Parent = gethui and gethui() or CoreGui end)
    
    -- Blur effect (WindUI style + Fluent acrylic)
    local Blur = nil
    if Acrylic and Theme.Acrylic then
        Blur = Create("BlurEffect", {
            Parent = game:GetService("Lighting"),
            Size = 12,
        })
    end
    
    -- Main Window Frame
    local MainFrame = Create("Frame", {
        Parent = ScreenGui,
        AnchorPoint = Vector2.new(0.5,0.5),
        Position = UDim2.fromScale(0.5,0.5),
        Size = Size,
        BackgroundColor3 = Theme.Background,
        BackgroundTransparency = Acrylic and 0.15 or 0,
        ClipsDescendants = false,
    }, {
        Create("UICorner", {CornerRadius = UDim.new(0, 12)}),
        Create("UIStroke", {Color = Theme.Border, Thickness = 1, Transparency = 0.5}),
    })
    
    -- Title Bar (Fluent style but improved)
    local TitleBar = Create("Frame", {
        Parent = MainFrame,
        Size = UDim2.new(1,0,0,45),
        BackgroundColor3 = Theme.Background2,
        BackgroundTransparency = 0.1,
    }, {
        Create("UICorner", {CornerRadius = UDim.new(0,12)}),
        Create("Frame", {
            Size = UDim2.new(1,0,0,12),
            Position = UDim2.fromScale(0,1),
            AnchorPoint = Vector2.new(0,1),
            BackgroundColor3 = Theme.Background2,
            BackgroundTransparency = 0.1,
            BorderSizePixel = 0,
        })
    })
    
    local TitleLabel = Create("TextLabel", {
        Parent = TitleBar,
        Position = UDim2.fromOffset(18,0),
        Size = UDim2.new(1, -100, 1, 0),
        BackgroundTransparency = 1,
        Text = Title .. "  <font color=\"rgb(120,120,120)\">" .. SubTitle .. "</font>",
        RichText = true,
        TextColor3 = Theme.Text,
        TextXAlignment = Enum.TextXAlignment.Left,
        Font = Enum.Font.GothamBold,
        TextSize = 14,
    })
    
    -- Dragging (Better than both)
    local dragging, dragInput, dragStart, startPos
    TitleBar.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            dragging = true
            dragStart = input.Position
            startPos = MainFrame.Position
            input.Changed:Connect(function()
                if input.UserInputState == Enum.UserInputState.End then dragging = false end
            end)
        end
    end)
    TitleBar.InputChanged:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseMovement then dragInput = input end
    end)
    UserInputService.InputChanged:Connect(function(input)
        if input == dragInput and dragging then
            local delta = input.Position - dragStart
            Tween(MainFrame, {Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)}, 0.1):Play()
        end
    end)
    
    -- Close / Minimize
    local CloseBtn = Create("TextButton", {
        Parent = TitleBar,
        AnchorPoint = Vector2.new(1,0.5),
        Position = UDim2.new(1,-10,0.5,0),
        Size = UDim2.fromOffset(28,28),
        BackgroundColor3 = Color3.fromRGB(255,90,90),
        Text = "✕",
        TextColor3 = Color3.new(1,1,1),
        Font = Enum.Font.GothamBold,
        TextSize = 14,
    }, {
        Create("UICorner", {CornerRadius = UDim.new(0,8)})
    })
    CloseBtn.MouseButton1Click:Connect(function()
        Tween(MainFrame, {Size = UDim2.fromOffset(0,0)}, 0.25, Enum.EasingStyle.Back, Enum.EasingDirection.In):Play()
        task.wait(0.25)
        if Blur then Blur:Destroy() end
        ScreenGui:Destroy()
    end)
    
    -- Tab Holder
