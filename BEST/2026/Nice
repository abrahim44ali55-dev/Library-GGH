-- KitagawaUI V4 FIXED - No More Black Screen
local KitagawaUI = {}
local TweenService = game:GetService("TweenService")
local UIS = game:GetService("UserInputService")
local CoreGui = game.CoreGui

KitagawaUI.Emojis = {
    Fire="🔥", Star="⭐", Check="✅", Cross="❌", Warn="⚠️", Rocket="🚀", Crown="👑", Gem="💎",
    Sword="⚔️", Game="🎮", Trophy="🏆", Run="🏃", Speed="💨", Settings="⚙️", Lock="🔒", Money="💰", Heart="❤️"
}

local Sizes = {
    {W=500, Size=UDim2.new(0,360,0,320)},
    {W=800, Size=UDim2.new(0,460,0,360)},
    {W=1200, Size=UDim2.new(0,600,0,420)},
    {W=1600, Size=UDim2.new(0,680,0,460)},
    {W=9999, Size=UDim2.new(0,780,0,500)},
}
local function GetSize()
    local v = workspace.CurrentCamera.ViewportSize.X
    for _,s in ipairs(Sizes) do if v <= s.W then return s.Size end end
    return Sizes[5].Size
end

function KitagawaUI:New(cfg)
    cfg=cfg or {}
    local Title=cfg.Title or "KitagawaHub"
    local Accent=cfg.Accent or Color3.fromRGB(0,150,255)
    local MSize=cfg.Size or GetSize()

    local sg=Instance.new("ScreenGui", CoreGui)
    sg.Name="KitagawaUI"
    sg.ZIndexBehavior=Enum.ZIndexBehavior.Sibling
    sg.ResetOnSpawn=false

    local Main=Instance.new("Frame", sg)
    Main.Name="MainFrame"
    Main.AnchorPoint=Vector2.new(0.5,0.5)
    Main.Position=UDim2.new(0.5,0,0.5,0)
    Main.Size=MSize
    Main.BackgroundColor3=Color3.fromRGB(18,18,26)
    Main.BorderSizePixel=0
    Instance.new("UICorner", Main).CornerRadius=UDim.new(0,14)
    local st=Instance.new("UIStroke", Main)
    st.Color=Color3.fromRGB(60,60,80)
    st.Thickness=1.2

    -- TopBar
    local Top=Instance.new("Frame", Main)
    Top.Size=UDim2.new(1,0,0,48)
    Top.BackgroundColor3=Color3.fromRGB(24,24,34)
    Top.BorderSizePixel=0
    Instance.new("UICorner", Top).CornerRadius=UDim.new(0,14)
    local Fix=Instance.new("Frame", Top)
    Fix.Size=UDim2.new(1,0,0,14)
    Fix.Position=UDim2.new(0,0,1,-14)
    Fix.BackgroundColor3=Color3.fromRGB(24,24,34)
    Fix.BorderSizePixel=0

    local TitleL=Instance.new("TextLabel", Top)
    TitleL.Text=Title
    TitleL.Size=UDim2.new(1,-90,1,0)
    TitleL.Position=UDim2.new(0,16,0,0)
    TitleL.BackgroundTransparency=1
    TitleL.Font=Enum.Font.GothamBold
    TitleL.TextColor3=Color3.fromRGB(255,255,255)
    TitleL.TextSize=17
    TitleL.TextXAlignment=Enum.TextXAlignment.Left

    local Min=Instance.new("TextButton", Top)
    Min.Text="-"
    Min.Size=UDim2.new(0,28,0,28)
    Min.Position=UDim2.new(1,-68,0,10)
    Min.BackgroundColor3=Color3.fromRGB(35,35,48)
    Min.TextColor3=Color3.fromRGB(220,220,220)
    Min.Font=Enum.Font.GothamBold
    Min.TextSize=18
    Instance.new("UICorner", Min).CornerRadius=UDim.new(0,7)

    local Close=Instance.new("TextButton", Top)
    Close.Text="X"
    Close.Size=UDim2.new(0,28,0,28)
    Close.Position=UDim2.new(1,-34,0,10)
    Close.BackgroundColor3=Color3.fromRGB(50,25)
    Close.TextColor3=Color3.fromRGB(255,90,90)
    Close.Font=Enum.Font.GothamBold
    Close.TextSize=15
    Instance.new("UICorner", Close).CornerRadius=UDim.new(0,7)

    -- Confirm
    local Confirm=Instance.new("Frame", sg)
    Confirm.Size=UDim2.new(0,260,0,130)
    Confirm.Position=UDim2.new(0.5,0,0.5,0)
    Confirm.AnchorPoint=Vector2.new(0.5,0.5)
    Confirm.BackgroundColor3=Color3.fromRGB(25,25,35)
    Confirm.Visible=false
    Confirm.ZIndex=50
    Instance.new("UICorner", Confirm).CornerRadius=UDim.new(0,12)
    Instance.new("UIStroke", Confirm).Color=Color3.fromRGB(70,70,90)

    local CT=Instance.new("TextLabel", Confirm)
    CT.Text="⚠️ تريد تسد الواجهة؟"
    CT.Size=UDim2.new(1,0,0,50)
    CT.BackgroundTransparency=1
    CT.TextColor3=Color3.fromRGB(255,255,255)
    CT.Font=Enum.Font.GothamBold
    CT.TextSize=15

    local Yes=Instance.new("TextButton", Confirm)
    Yes.Text="✅ نعم"
    Yes.Position=UDim2.new(0,15,0,65)
    Yes.Size=UDim2.new(0,105,0,38)
    Yes.BackgroundColor3=Color3.fromRGB(180,50,50)
    Yes.TextColor3=Color3.fromRGB(255,255,255)
    Yes.Font=Enum.Font.GothamBold
    Instance.new("UICorner", Yes).CornerRadius=UDim.new(0,8)

    local No=Instance.new("TextButton", Confirm)
    No.Text="❌ لا"
    No.Position=UDim2.new(1,-120,0,65)
    No.Size=UDim2.new(0,105,0,38)
    No.BackgroundColor3=Color3.fromRGB(40,40,55)
    No.TextColor3=Color3.fromRGB(255,255,255)
    No.Font=Enum.Font.GothamBold
    Instance.new("UICorner", No).CornerRadius=UDim.new(0,8)

    Close.MouseButton1Click:Connect(function() Confirm.Visible=true end)
    No.MouseButton1Click:Connect(function() Confirm.Visible=false end)
    Yes.MouseButton1Click:Connect(function() sg:Destroy() end)

    -- Minimize Logic
    local minimized=false
    local oldSize=MSize
    Min.MouseButton1Click:Connect(function()
        minimized=not minimized
        if minimized then
            TweenService:Create(Main, TweenInfo.new(0.25), {Size=UDim2.new(oldSize.X.Scale, oldSize.X.Offset, 0, 48)}):Play()
            Min.Text="□"
        else
            TweenService:Create(Main, TweenInfo.new(0.25), {Size=oldSize}):Play()
            Min.Text="-"
        end
    end)

    -- Drag Logic (FIXED)
    local dragging, dragStart, startPos
    Top.InputBegan:Connect(function(inp)
        if inp.UserInputType==Enum.UserInputType.MouseButton1 or inp.UserInputType==Enum.UserInputType.Touch then
            dragging=true
            dragStart=inp.Position
            startPos=Main.Position
        end
    end)
    UIS.InputChanged:Connect(function(inp)
        if dragging and (inp.UserInputType==Enum.UserInputType.MouseMovement or inp.UserInputType==Enum.UserInputType.Touch) then
            local delta=inp.Position-dragStart
            Main.Position=UDim2.new(startPos.X.Scale, startPos.X.Offset+delta.X, startPos.Y.Scale, startPos.Y.Offset+delta.Y)
        end
    end)
    UIS.InputEnded:Connect(function(inp)
        if inp.UserInputType==Enum.UserInputType.MouseButton1 or inp.UserInputType==Enum.UserInputType.Touch then dragging=false end
    end)

    -- Sidebar + Content
    local Sidebar=Instance.new("Frame", Main)
    Sidebar.Position=UDim2.new(0,0,0,48)
    Sidebar.Size=UDim2.new(0,150,1,-48)
    Sidebar.BackgroundColor3=Color3.fromRGB(22,22,32)
    Sidebar.BorderSizePixel=0
    Instance.new("UICorner", Sidebar).CornerRadius=UDim.new(0,12)

    local TabList=Instance.new("Frame", Sidebar)
    TabList.BackgroundTransparency=1
    TabList.Position=UDim2.new(0,8,0,10)
    TabList.Size=UDim2.new(1,-16,1,-20)
    local L1=Instance.new("UIListLayout", TabList)
    L1.Padding=UDim.new(0,8)

    local Content=Instance.new("Frame", Main)
    Content.Position=UDim2.new(0,160,0,58)
    Content.Size=UDim2.new(1,-170,1,-68)
    Content.BackgroundTransparency=1
    Content.ClipsDescendants=true

    local tabs={}
    local selfAPI={}
    function selfAPI:AddTab(name)
        local Page=Instance.new("ScrollingFrame", Content)
        Page.Size=UDim2.new(1,0,1,0)
        Page.BackgroundTransparency=1
        Page.ScrollBarThickness=3
        Page.Visible=#tabs==0
        Page.CanvasSize=UDim2.new(0,0,0,0)
        Page.AutomaticCanvasSize=Enum.AutomaticSize.Y
        local L2=Instance.new("UIListLayout", Page)
        L2.Padding=UDim.new(0,8)

        local Btn=Instance.new("TextButton", TabList)
        Btn.Size=UDim2.new(1,0,0,36)
        Btn.Text=name
        Btn.Font=Enum.Font.GothamSemibold
        Btn.TextSize=13
        Btn.TextColor3=(#tabs==0 and Color3.new(1,1,1)) or Color3.fromRGB(160,160,180)
        Btn.BackgroundColor3=(#tabs==0 and Accent) or Color3.fromRGB(32,32,44)
        Instance.new("UICorner", Btn).CornerRadius=UDim.new(0,8)

        Btn.MouseButton1Click:Connect(function()
            for _,t in pairs(tabs) do
                t.Page.Visible=false
                TweenService:Create(t.Btn, TweenInfo.new(0.2), {BackgroundColor3=Color3.fromRGB(32,32,44), TextColor3=Color3.fromRGB(160,160,180)}):Play()
            end
            Page.Visible=true
            TweenService:Create(Btn, TweenInfo.new(0.2), {BackgroundColor3=Accent, TextColor3=Color3.new(1,1,1)}):Play()
        end)
        table.insert(tabs, {Btn=Btn, Page=Page})

        local tab={}
        function tab:AddToggle(text, def, cb)
            local F=Instance.new("Frame", Page)
            F.Size=UDim2.new(1,-6,0,48)
            F.BackgroundColor3=Color3.fromRGB(28,28,40)
            Instance.new("UICorner", F).CornerRadius=UDim.new(0,8)
            local Lb=Instance.new("TextLabel", F)
            Lb.Text=text
            Lb.Position=UDim2.new(0,12,0,0)
            Lb.Size=UDim2.new(0.6,0,1,0)
            Lb.BackgroundTransparency=1
            Lb.Font=Enum.Font.GothamSemibold
            Lb.TextColor3=Color3.new(1,1,1)
            Lb.TextXAlignment=Enum.TextXAlignment.Left
            Lb.TextSize=13
            local Sw=Instance.new("TextButton", F)
            Sw.Position=UDim2.new(1,-56,0.5,-13)
            Sw.Size=UDim2.new(0,46,0,26)
            Sw.Text=""
            Sw.BackgroundColor3=def and Color3.fromRGB(40,180,80) or Color3.fromRGB(50,50,65)
            Instance.new("UICorner", Sw).CornerRadius=UDim.new(0,13)
            local Dot=Instance.new("Frame", Sw)
            Dot.Size=UDim2.new(0,20,0,20)
            Dot.Position=UDim2.new(0, def and 23 or 3, 0.5, -10)
            Dot.BackgroundColor3=Color3.new(1,1,1)
            Instance.new("UICorner", Dot).CornerRadius=UDim.new(1,0)
            local en=def
            Sw.MouseButton1Click:Connect(function()
                en=not en
                cb(en)
                TweenService:Create(Sw, TweenInfo.new(0.2), {BackgroundColor3=en and Color3.fromRGB(40,180,80) or Color3.fromRGB(50,50,65)}):Play()
                TweenService:Create(Dot, TweenInfo.new(0.2), {Position=UDim2.new(0, en and 23 or 3, 0.5, -10)}):Play()
            end)
        end
        function tab:AddButton(text, cb)
            local B=Instance.new("TextButton", Page)
            B.Size=UDim2.new(1,-6,0,40)
            B.Text=text
            B.Font=Enum.Font.GothamBold
            B.TextColor3=Color3.new(1,1,1)
            B.BackgroundColor3=Accent
            Instance.new("UICorner", B).CornerRadius=UDim.new(0,8)
            B.MouseButton1Click:Connect(cb)
        end
        return tab
    end
    return selfAPI
end
return KitagawaUI
