-- Config system REAL
function NovaUI:SaveConfig(Name)
    Name=Name or "Default"
    local data={}
    for k,v in pairs(NovaUI.Options) do data[k]=v.Value end
    local json=Http:JSONEncode(data)
    if writefile then
        if not isfolder("NovaUI") then makefolder("NovaUI") end
        writefile("NovaUI/"..Name..".json", json)
        NovaUI:Notify({Title="Config", Content="Saved "..Name, Duration=2})
    end
    return json
end

function NovaUI:LoadConfig(Name)
    Name=Name or "Default"
    if readfile and isfile and isfile("NovaUI/"..Name..".json") then
        local data=Http:JSONDecode(readfile("NovaUI/"..Name..".json"))
        for k,v in pairs(data) do if NovaUI.Options[k] then NovaUI.Options[k].Value=v end end
        NovaUI:Notify({Title="Config", Content="Loaded "..Name, Duration=2})
        return data
    end
end

