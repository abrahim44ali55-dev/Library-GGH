            local newSize = Vector2.new(mouse.X - absPos.X, mouse.Y - absPos.Y)
            newSize = Vector2.new(math.clamp(newSize.X, 480, 1200), math.clamp(newSize.Y, 360, 800))
            main.Size = UDim2.fromOffset(newSize.X, newSize.Y)
            ConfigSystem.Save(saveKey.."_Size", {X=newSize.X, Y=newSize.Y})
        end
    end)
    UserInputService.InputEnded:Connect(function(input)
