local Util = {}
function Util.Create(className: string, props: {[string]: any}): Instance
    local inst = Instance.new(className)
    for k,v in pairs(props) do
        if k ~= "Parent" then
            (inst :: any)[k] = v
        end
    end
    if props.Parent then
        inst.Parent = props.Parent
    end
    return inst
end

function Util.Corner(parent: Instance, radius: number)
    return Util.Create("UICorner", {CornerRadius = UDim.new(0, radius), Parent = parent})
end

function Util.Stroke(parent: Instance, color: Color3, thickness: number, transparency: number?)
    return Util.Create("UIStroke", {
        Color = color,
        Thickness = thickness,
        Transparency = transparency or 0,
        ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
        Parent = parent
    })
end

function Util.Padding(parent: Instance, l:number, t:number, r:number, b:number)
    return Util.Create("UIPadding", {
        PaddingLeft = UDim.new(0,l),
        PaddingTop = UDim.new(0,t),
        PaddingRight = UDim.new(0,r),
        PaddingBottom = UDim.new(0,b),
        Parent = parent
    })
end

function Util.List(parent: Instance, dir: Enum.FillDirection, pad: number, align: Enum.HorizontalAlignment?, valign: Enum.VerticalAlignment?)
    return Util.Create("UIListLayout", {
        FillDirection = dir,
        Padding = UDim.new(0,pad),
        HorizontalAlignment = align or Enum.HorizontalAlignment.Left,
        VerticalAlignment = valign or Enum.VerticalAlignment.Top,
        SortOrder = Enum.SortOrder.LayoutOrder,
        Parent = parent
    })
end

-- ============================================================================
-- ANIMATION ENGINE - Original Spring + Tween Pool
-- ============================================================================
local Anim = {}
Anim.TweenPool = {}

function Anim.Tween(obj: Instance, props: {[string]: any}, duration: number, style: Enum.EasingStyle?, dir: Enum.EasingDirection?): Tween
    style = style or Enum.EasingStyle.Quad
    dir = dir or Enum.EasingDirection.Out
    local info = TweenInfo.new(duration, style, dir)
    local tween = TweenService:Create(obj, info, props)
    tween:Play()
    return tween
end

function Anim.Spring(current: number, target: number, velocity: number, damping: number, speed: number, dt: number)
    local f = 1 + damping * dt
    local oo = speed * speed * dt
    local det = f*f - oo
    if det < 0 then det = 0 end
    local c = (current - target) * oo + velocity * f
    local newVel = (velocity * f - c) / (f + det)
    local newVal = current + newVel * dt
    return newVal, newVel
end

function Anim.Ripple(button: GuiButton)
    button.ClipsDescendants = true
    button.MouseButton1Down:Connect(function()
        local ripple = Util.Create("Frame", {
            AnchorPoint = Vector2.new(0.5,0.5),
            BackgroundColor3 = Color3.new(1,1,1),
            BackgroundTransparency = 0.8,
            Size = UDim2.fromOffset(0,0),
            Position = UDim2.fromScale(0.5,0.5),
            Parent = button
        })
        Util.Corner(ripple, 1000)
        local mousePos = UserInputService:GetMouseLocation()
        local absPos = button.AbsolutePosition
        local relX = (mousePos.X - absPos.X) / button.AbsoluteSize.X
        local relY = (mousePos.Y - absPos.Y) / button.AbsoluteSize.Y
        ripple.Position = UDim2.fromScale(relX, relY)
        local size = math.max(button.AbsoluteSize.X, button.AbsoluteSize.Y) * 2.5
        Anim.Tween(ripple, {Size = UDim2.fromOffset(size,size), BackgroundTransparency = 1}, 0.6, Enum.EasingStyle.Quad)
        task.delay(0.6, function() ripple:Destroy() end)
    end)
end

function Anim.HoverScale(obj: GuiObject, normal: number, hover: number)
    obj.MouseEnter:Connect(function()
        Anim.Tween(obj, {Size = UDim2.fromScale(hover,hover)}, 0.15, Enum.EasingStyle.Back)
    end)
    obj.MouseLeave:Connect(function()
        Anim.Tween(obj, {Size = UDim2.fromScale(normal,normal)}, 0.15, Enum.EasingStyle.Quad)
    end)
end

-- ============================================================================
-- STATE MANAGER
-- ============================================================================
local State = {}
State.__index = State

function State.new(initial: any)
    return setmetatable({
        _value = initial,
        _listeners = {},
        _bindings = {}
    }, State)
end

function State:Get() return self._value end

function State:Set(newVal: any)
    if self._value ~= newVal then
        self._value = newVal
        for _,cb in ipairs(self._listeners) do
            task.spawn(cb, newVal)
        end
        for _,obj in ipairs(self._bindings) do
            if obj.Instance and obj.Property then
                obj.Instance[obj.Property] = newVal
            end
        end
    end
end

function State:Subscribe(cb: (any)->()): ()->()
    table.insert(self._listeners, cb)
    cb(self._value)
    return function()
        local idx = table.find(self._listeners, cb)
        if idx then table.remove(self._listeners, idx) end
    end
end

function State:Bind(instance: Instance, property: string)
    table.insert(self._bindings, {Instance=instance, Property=property})
    instance[property] = self._value
end

