function Theme:Get(name)
    return self.Themes[name] or self.CustomThemes[name] or self.Themes.Midnight
end

function Theme:Set(nameOrTable)
    local t
    if typeof(nameOrTable)=="string" then
        t=self:Get(nameOrTable)
    else
        t=nameOrTable
    end
    self.Current=t
    for _,cb in ipairs(self._listeners) do task.spawn(cb,t) end
end

function Theme:OnChanged(cb) table.insert(self._listeners,cb) end

function Theme:CreateCustomTheme(options)
    -- options: Name, Accent, Bg, Panel, Sec, Text, Gradient (ColorSequence), ImageId (rbxassetid or url), Transparency
    local name = options.Name or "Custom_"..tostring(math.random(1000,9999))
    local accent = options.Accent or Color3.fromRGB(124,58,237)
    local isDark = options.IsDark
    if isDark==nil then isDark=true end
    local bg, panel, sec, text, sub, border
    if options.Bg then
        bg=options.Bg; panel=options.Panel or bg:Lerp(Color3.new(1,1,1),0.05)
        sec=options.Sec or bg:Lerp(Color3.new(1,1,1),0.1)
        text=options.Text or (isDark and Color3.fromRGB(245,245,250) or Color3.fromRGB(18,18,22))
        sub=options.SubText or (isDark and Color3.fromRGB(150,150,168) or Color3.fromRGB(90,90,105))
        border=options.Border or bg:Lerp(Color3.new(1,1,1),0.15)
    else
        bg, panel, sec, text, sub, border = GenerateShades(accent, isDark)
    end

    local theme = {
        Name=name,
        Bg=bg, Panel=panel, Sec=sec, Text=text, Sub=sub, Border=border,
        Accent=accent,
        Accent2=options.Accent2 or accent:Lerp(Color3.new(1,1,1),0.15),
        Success=Color3.fromRGB(16,185,129),
        Warn=Color3.fromRGB(245,158,11),
        Err=Color3.fromRGB(239,68,68),
        AccentHover=accent:Lerp(Color3.new(1,1,1),0.15),
        Transparency=options.Transparency or 0,
        Gradient=options.Gradient,
        ImageId=options.ImageId,
        IsCustom=true,
    }
    self.CustomThemes[name]=theme
    self.Themes[name]=theme
    return theme
end

