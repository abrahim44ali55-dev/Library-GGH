		if Themes[themeName] then
			currentThemeName = themeName
			currentTheme = Themes[themeName]
			MainFrame.BackgroundColor3 = currentTheme.Bg
			TopBar.BackgroundColor3 = currentTheme.Top
			UIStroke.Color = currentTheme.Accent
			TitleLabel.TextColor3 = currentTheme.Text
			CloseButton.BackgroundColor3 = currentTheme.Elem
			CloseButton.TextColor3 = currentTheme.Text
			MinimizeButton.BackgroundColor3 = currentTheme.Elem
			MinimizeButton.TextColor3 = currentTheme.Text
			ConfirmBox.BackgroundColor3 = currentTheme.Top
			ConfirmText.TextColor3 = currentTheme.Text
			NoButton.BackgroundColor3 = currentTheme.Elem
			NoButton.TextColor3 = currentTheme.Text
			ResizeButton.TextColor3 = currentTheme.Sub
			
			Notify("Themes", "Theme changed to: " .. themeName, 2)
		end
	end

