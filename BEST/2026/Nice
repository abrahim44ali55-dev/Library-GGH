    local bar = Utilities:Create("Frame", {Size=UDim2.new(0,4,1,0), BackgroundColor3=accent, BorderSizePixel=0, Parent=frame})
    Utilities:Corner(bar,4)
    Utilities:Padding(frame,{10,10,18,14})
    local title = Utilities:Create("TextLabel", {Text=opts.Title or opts.Type or "Notification", Font=Enum.Font.GothamBold, TextSize=14, TextColor3=theme.Text, BackgroundTransparency=1, Size=UDim2.new(1,-10,0,18), TextXAlignment=Enum.TextXAlignment.Left, ZIndex=102, Parent=frame})
    local desc = Utilities:Create("TextLabel", {Text=opts.Content or opts.Message or "", Font=Enum.Font.Gotham, TextSize=13, TextColor3=theme.SubText, BackgroundTransparency=1, Size=UDim2.new(1,-10,0,0), AutomaticSize=Enum.AutomaticSize.Y, TextWrapped=true, TextXAlignment=Enum.TextXAlignment.Left, ZIndex=102, Parent=frame})
    Utilities:List(frame, Enum.FillDirection.Vertical, 4)
    frame.Parent=self.Container
    frame.Position=UDim2.fromOffset(400,0)
    TweenService:Create(frame, TweenInfo.new(0.45, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {Position=UDim2.fromOffset(0,0)}):Play()
    if opts.Duration~=0 then
        task.delay(opts.Duration or 4, function()
            if frame.Parent then
                local tw=TweenService:Create(frame, TweenInfo.new(0.3, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {Position=UDim2.fromOffset(400,0)})
                tw:Play(); tw.Completed:Wait(); frame:Destroy()
            end
        end)
    end
    return frame
end

