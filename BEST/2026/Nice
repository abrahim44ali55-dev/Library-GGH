-- ============================================
local AnimationEngine = {}
AnimationEngine.Easings = {
    Linear = function(t) return t end,
    InQuad = function(t) return t*t end,
    OutQuad = function(t) return t*(2-t) end,
    InOutQuad = function(t) if t<0.5 then return 2*t*t else return -1+(4-2*t)*t end end,
    OutBack = function(t) local s=1.70158; return (t-1)*(t-1)*((s+1)*(t-1)+s)+1 end
}
function AnimationEngine:Animate(obj, duration, easing, props)
    local start = tick()
    local initial = {}
    for k,v in pairs(props) do initial[k] = obj[k] end
    local conn
    conn = game:GetService("RunService").RenderStepped:Connect(function()
        local elapsed = tick() - start
        local alpha = math.clamp(elapsed/duration,0,1)
        local eased = (self.Easings[easing] or self.Easings.Linear)(alpha)
        for k,target in pairs(props) do
            if typeof(target)=="number" then obj[k] = initial[k] + (target-initial[k])*eased
            elseif typeof(target)=="Color3" then obj[k] = Color3.new(initial[k].R + (target.R-initial[k].R)*eased, initial[k].G + (target.G-initial[k].G)*eased, initial[k].B + (target.B-initial[k].B)*eased)
            end
        end
        if alpha>=1 then conn:Disconnect() end
    end)
end
