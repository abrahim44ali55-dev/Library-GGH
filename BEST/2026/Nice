    local storedSize = Main.Size

    local function ToggleMinimize()
        isMinimized = not isMinimized
        if isMinimized then
            storedSize = Main.Size
            TweenService:Create(Main, TweenInfo.new(0.35, Enum.EasingStyle.Back, Enum.EasingDirection.In), {
                Size = UDim2.new(0, 0, 0, 0),
                BackgroundTransparency = 1
            }):Play()
            task.delay(0.3, function()
                Main.Visible = false
                FloatingToggleBtn.Visible = true
                FloatingToggleBtn.Size = UDim2.new(0, 0, 0, 36)
                TweenService:Create(FloatingToggleBtn, TweenInfo.new(0.35, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
                    Size = UDim2.new(0, 220, 0, 36)
                }):Play()
            end)
        else
            FloatingToggleBtn.Visible = false
            Main.Visible = true
            Main.Size = UDim2.new(0, 0, 0, 0)
            Main.BackgroundTransparency = 0
            TweenService:Create(Main, TweenInfo.new(0.4, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
                Size = storedSize,
                BackgroundTransparency = 0
            }):Play()
        end
    end

