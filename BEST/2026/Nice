-- Config System - Save/Load
local ConfigSystem = {}
ConfigSystem.Flags = {}
ConfigSystem.CurrentProfile = "Default"
ConfigSystem.Profiles = {}
function ConfigSystem:RegisterFlag(name, defaultValue, setter)
    self.Flags[name] = {Value=defaultValue, Setter=setter}
end
function ConfigSystem:SetFlag(name, value)
    if self.Flags[name] then
        self.Flags[name].Value = value
        if self.Flags[name].Setter then
            pcall(self.Flags[name].Setter, value)
        end
    end
end
function ConfigSystem:GetFlag(name)
    return self.Flags[name] and self.Flags[name].Value or nil
end
function ConfigSystem:SaveProfile(name)
    name = name or self.CurrentProfile
    local data = {}
    for k,v in pairs(self.Flags) do data[k] = v.Value end
    self.Profiles[name] = data
    return data
end
function ConfigSystem:LoadProfile(name)
    name = name or self.CurrentProfile
    local data = self.Profiles[name]
    if data then
        for k,v in pairs(data) do
            if self.Flags[k] then self:SetFlag(k,v) end
        end
    end
end
function ConfigSystem:Export() 
    local data = {}
    for k,v in pairs(self.Flags) do data[k] = v.Value end
    return game:GetService("HttpService"):JSONEncode(data)
end

