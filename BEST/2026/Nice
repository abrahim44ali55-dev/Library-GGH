    local applyBtn=Util:Create("TextButton",{Text="Apply",Font=Enum.Font.GothamBold,TextSize=12,TextColor3=Color3.new(1,1,1),BackgroundColor3=th.Accent,Size=UDim2.fromOffset(80,36),AutoButtonColor=false,Parent=btnRow}); Util:Corner(applyBtn,8); applyBtn.AutoLocalize=false

    local function updateColor()
        local c=Color3.fromHSV(hue,sat,val)
        preview.BackgroundColor3=c
        svBox.BackgroundColor3=Color3.fromHSV(hue,1,1)
        whiteGrad:FindFirstChildOfClass("UIGradient").Color=ColorSequence.new{ColorSequenceKeypoint.new(0,Color3.new(1,1,1)),ColorSequenceKeypoint.new(1,Color3.fromHSV(hue,1,1))}
    end

    local draggingSV=false; local draggingHue=false
    svBox.InputBegan:Connect(function(input) if input.UserInputType==Enum.UserInputType.MouseButton1 or input.UserInputType==Enum.UserInputType.Touch then draggingSV=true end end)
    hueBar.InputBegan:Connect(function(input) if input.UserInputType==Enum.UserInputType.MouseButton1 or input.UserInputType==Enum.UserInputType.Touch then draggingHue=true end end)
    UserInputService.InputEnded:Connect(function(input) if input.UserInputType==Enum.UserInputType.MouseButton1 or input.UserInputType==Enum.UserInputType.Touch then draggingSV=false; draggingHue=false end end)
    UserInputService.InputChanged:Connect(function(input)
        if input.UserInputType==Enum.UserInputType.MouseMovement or input.UserInputType==Enum.UserInputType.Touch then
            if draggingSV then
                local rel = input.Position - svBox.AbsolutePosition
                sat=math.clamp(rel.X/svBox.AbsoluteSize.X,0,1)
                val=math.clamp(rel.Y/svBox.AbsoluteSize.Y,0,1)
                svCursor.Position=UDim2.new(sat,val,0,0)
                updateColor()
            elseif draggingHue then
                local rel = input.Position.X - hueBar.AbsolutePosition.X
                hue=math.clamp(rel/hueBar.AbsoluteSize.X,0,1)
                hueCursor.Position=UDim2.new(hue,0,0,0)
                updateColor()
            end
        end
    end)

    cancelBtn.MouseButton1Click:Connect(function() overlay:Destroy() end)
    applyBtn.MouseButton1Click:Connect(function()
        local c=Color3.fromHSV(hue,sat,val)
        overlay:Destroy()
        if callback then callback(c) end
    end)
end

