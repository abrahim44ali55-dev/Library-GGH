            tcontent.Visible=true; tbtn.BackgroundColor3=Color3.fromRGB(88,132,255)
        end)
        if first then tcontent.Visible=true; tbtn.BackgroundColor3=Color3.fromRGB(88,132,255); first=false end

        local Tab={}
        function Tab:Section(scfg)
            local sec=New("Frame", {Size=UDim2.new(1,-4,0,0), BackgroundColor3=Color3.fromRGB(38,38,42), AutomaticSize=Enum.AutomaticSize.Y, Parent=tcontent}, {Corner(8), Padding(nil,10), New("UIListLayout",{Padding=UDim.new(0,8)})})
            New("TextLabel", {Text=scfg.Title or "Section", Font=Enum.Font.GothamBold, TextSize=12, TextColor3=Color3.new(1,1,1), Size=UDim2.new(1,0,0,18), BackgroundTransparency=1, TextXAlignment=Left, Parent=sec})
            local El={}
            function El:Button(c) local b=New("TextButton", {Size=UDim2.new(1,0,0,36), BackgroundColor3=Color3.fromRGB(55,55,60), Text=c.Title or "Button", Font=Enum.Font.GothamMedium, TextSize=13, TextColor3=Color3.new(1,1,1), Parent=sec}, {Corner(6)}); b.MouseButton1Click:Connect(function() if c.Callback then c.Callback() end end) end
            function El:Toggle(c) local state=c.Default or false; local t=New("TextButton", {Size=UDim2.new(1,0,0,36), BackgroundColor3=Color3.fromRGB(55,55,60), Text="", Parent=sec}, {Corner(6)}); local l=New("TextLabel", {Text=c.Title or "Toggle", BackgroundTransparency=1, Size=UDim2.new(0.7,0,1,0), Position=UDim2.new(0,10,0,0), TextXAlignment=Left, Font=Enum.Font.Gotham, TextSize=13, TextColor3=Color3.new(1,1,1), Parent=t}); local d=New("Frame", {Size=UDim2.new(0,40,0,20), Position=UDim2.new(1,-50,0.5,-10), BackgroundColor3=state and Color3.fromRGB(88,132,255) or Color3.fromRGB(70,70,70), Parent=t}, {Corner(10)}); t.MouseButton1Click:Connect(function() state=not state; d.BackgroundColor3=state and Color3.fromRGB(88,132,255) or Color3.fromRGB(70,70,70); if c.Callback then c.Callback(state) end end) end
            function El:Label(c) New("TextLabel", {Text=c.Title or "Label", Size=UDim2.new(1,0,0,20), BackgroundTransparency=1, Font=Enum.Font.Gotham, TextSize=12, TextColor3=Color3.fromRGB(180,180,180), TextXAlignment=Left, Parent=sec}) end
            function El:Slider(c) local val=c.Default or c.Min or 0; local s=New("Frame", {Size=UDim2.new(1,0,0,44), BackgroundColor3=Color3.fromRGB(55,55,60), Parent=sec}, {Corner(6)}); local lbl=New("TextLabel", {Text=c.Title..": "..val, Size=UDim2.new(1,0,0,20), Position=UDim2.new(0,8,0,0), BackgroundTransparency=1, Font=Enum.Font.Gotham, TextSize=12, TextColor3=Color3.new(1,1,1), TextXAlignment=Left, Parent=s}); local bar=New("Frame", {Size=UDim2.new(1,-16,0,6), Position=UDim2.new(0,8,0,28), BackgroundColor3=Color3.fromRGB(70,70,75), Parent=s}, {Corner(3)}); local fill=New("Frame", {Size=UDim2.new((val-c.Min)/(c.Max-c.Min),0,1,0), BackgroundColor3=Color3.fromRGB(88,132,255), Parent=bar}, {Corner(3)}); local drag=false; bar.InputBegan:Connect(function(i) if i.UserInputType==Enum.UserInputType.MouseButton1 then drag=true end end); UIS.InputEnded:Connect(function() drag=false end); UIS.InputChanged:Connect(function(i) if drag and i.UserInputType==Enum.UserInputType.MouseMovement then local pct=math.clamp((i.Position.X-bar.AbsolutePosition.X)/bar.AbsoluteSize.X,0,1); val=math.floor(c.Min+(c.Max-c.Min)*pct); fill.Size=UDim2.new(pct,0,1,0); lbl.Text=c.Title..": "..val; if c.Callback then c.Callback(val) end end end) end
            function El:Dropdown(c) local opts=c.Options or {"A","B"}; local cur=c.Default or opts[1]; local d=New("TextButton", {Size=UDim2.new(1,0,0,36), BackgroundColor3=Color3.fromRGB(55,55,60), Text=cur.." ▼", Font=Enum.Font.Gotham, TextSize=12, TextColor3=Color3.new(1,1,1), Parent=sec}, {Corner(6)}); local open=false; local list=New("Frame", {Size=UDim2.new(1,0,0,0), Position=UDim2.new(0,0,1,4), BackgroundColor3=Color3.fromRGB(45,45,50), ClipsDescendants=true, Parent=d}, {Corner(6)}); for _,opt in ipairs(opts) do local ob=New("TextButton", {Size=UDim2.new(1,0,0,28), BackgroundColor3=Color3.fromRGB(45,45,50), Text=opt, Font=Enum.Font.Gotham, TextSize=12, TextColor3=Color3.new(1,1,1), Parent=list}); ob.MouseButton1Click:Connect(function() cur=opt; d.Text=cur.." ▼"; open=false; list.Size=UDim2.new(1,0,0,0); if c.Callback then c.Callback(opt) end end) end; d.MouseButton1Click:Connect(function() open=not open; list.Size=open and UDim2.new(1,0,0,#opts*28) or UDim2.new(1,0,0,0) end) end
            return El
        end
        return Tab
    end
    return Window
end
return NiceLib
