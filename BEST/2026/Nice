    NoBtn.ZIndex = 202
    Corner(NoBtn, 8)

    -- Draggable
    do
        local dragging, dragStart, startPos
        Header.InputBegan:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 then
                dragging = true
                dragStart = input.Position
                startPos = Main.Position
            end
        end)
        UserInputService.InputChanged:Connect(function(input)
            if dragging and input.UserInputType == Enum.UserInputType.MouseMovement then
                local delta = input.Position - dragStart
                Main.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
            end
        end)
        UserInputService.InputEnded:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 then dragging = false end
        end)
    end

    -- Close & Minimize Logic
    CloseBtn.MouseButton1Click:Connect(function() ConfirmFrame.Visible = true end)
    NoBtn.MouseButton1Click:Connect(function() ConfirmFrame.Visible = false end)
    YesBtn.MouseButton1Click:Connect(function()
        Tween(Main, {Size = UDim2.new(0,520,0,0)}, 0.2)
        task.wait(0.25)
        ScreenGui:Destroy()
    end)

    local minimized = false
    local savedSize = Main.Size
    MinBtn.MouseButton1Click:Connect(function()
        if not minimized then
            minimized = true
            savedSize = Main.Size
            Tween(Main, {Size = UDim2.new(0,520,0,44)}, 0.25)
            TabList.Visible = false
            Container.Visible = false
            MinBtn.Visible = false
            MaxBtn.Visible = true
        end
    end)
    MaxBtn.MouseButton1Click:Connect(function()
        if minimized then
            minimized = false
            Tween(Main, {Size = savedSize}, 0.25)
            task.wait(0.1)
            TabList.Visible = true
            Container.Visible = true
            MaxBtn.Visible = false
            MinBtn.Visible = true
        end
    end)

    local Window = {}
    local Tabs = {}
    local FirstTab = true

    function Window:CreateTab(Name)
        local TabButton = Instance.new("TextButton", TabList)
        TabButton.Size = UDim2.new(1,0,0,34)
        TabButton.BackgroundColor3 = Color3.fromRGB(26,26,32)
        TabButton.Text = Name
        TabButton.Font = Enum.Font.GothamMedium
        TabButton.TextSize = 12
        TabButton.TextColor3 = Color3.fromRGB(170,170,180)
        TabButton.AutoButtonColor = false
        Corner(TabButton, 8)

        local TabPage = Instance.new("ScrollingFrame", Container)
        TabPage.Name = Name.."Page"
        TabPage.Size = UDim2.new(1,0,1,0)
        TabPage.BackgroundTransparency = 1
        TabPage.Visible = false
        TabPage.CanvasSize = UDim2.new(0,0,0,0)
        TabPage.AutomaticCanvasSize = Enum.AutomaticSize.Y
        TabPage.ScrollBarThickness = 2
        TabPage.ScrollBarImageColor3 = Color3.fromRGB(90,70,255)
        TabPage.ScrollingDirection = Enum.ScrollingDirection.Y
        TabPage.BorderSizePixel = 0

        local Layout = Instance.new("UIListLayout", TabPage)
        Layout.Padding = UDim.new(0, 8)
        Layout.SortOrder = Enum.SortOrder.LayoutOrder

        local Padding = Instance.new("UIPadding", TabPage)
        Padding.PaddingTop = UDim.new(0,2)
        Padding.PaddingBottom = UDim.new(0, 20)
        Padding.PaddingLeft = UDim.new(0,2)
        Padding.PaddingRight = UDim.new(0,4)

        TabButton.MouseButton1Click:Connect(function()
            for _, t in pairs(Tabs) do
                if t.Page then t.Page.Visible = false end
                if t.Button then
                    Tween(t.Button, {BackgroundColor3 = Color3.fromRGB(26,26,32)}, 0.15)
                    t.Button.TextColor3 = Color3.fromRGB(170,170,180)
                end
            end
            TabPage.Visible = true
            Tween(TabButton, {BackgroundColor3 = Color3.fromRGB(90,70,255)}, 0.15)
            TabButton.TextColor3 = Color3.fromRGB(255,255,255)
        end)

        if FirstTab then
            FirstTab = false
            TabPage.Visible = true
            TabButton.BackgroundColor3 = Color3.fromRGB(90,70,255)
            TabButton.TextColor3 = Color3.fromRGB(255,255,255)
        end

        table.insert(Tabs, {Button = TabButton, Page = TabPage})

        local Elements = {}

        function Elements:Section(Cfg)
            local Sec = Instance.new("TextLabel", TabPage)
            Sec.Size = UDim2.new(1,-4,0,22)
            Sec.BackgroundTransparency = 1
            Sec.Text = (Cfg and Cfg.Title or "Section"):upper()
            Sec.Font = Enum.Font.GothamBold
            Sec.TextSize = 11
            Sec.TextColor3 = Color3.fromRGB(115,115,130)
            Sec.TextXAlignment = Enum.TextXAlignment.Left
        end

        function Elements:Paragraph(Cfg)
            local Frame = Instance.new("Frame", TabPage)
            Frame.Size = UDim2.new(1,-4,0,60)
            Frame.AutomaticSize = Enum.AutomaticSize.Y
            Frame.BackgroundColor3 = Color3.fromRGB(18,18,22)
            Frame.BorderSizePixel = 0
            Corner(Frame, 10)
            local pad = Instance.new("UIPadding", Frame)
            pad.PaddingTop = UDim.new(0,10) pad.PaddingBottom = UDim.new(0,10) pad.PaddingLeft = UDim.new(0,12) pad.PaddingRight = UDim.new(0,12)
            local T = Instance.new("TextLabel", Frame)
            T.Size = UDim2.new(1,0,0,20)
            T.AutomaticSize = Enum.AutomaticSize.Y
            T.BackgroundTransparency = 1
            T.Text = Cfg.Title .. "\n" .. (Cfg.Content or "")
            T.TextWrapped = true
            T.TextXAlignment = Enum.TextXAlignment.Left
            T.Font = Enum.Font.Gotham
            T.TextSize = 12
            T.TextColor3 = Color3.fromRGB(200,200,210)
        end

        function Elements:Button(Cfg)
            local Btn = Instance.new("TextButton", TabPage)
            Btn.Size = UDim2.new(1,-4,0,38)
            Btn.BackgroundColor3 = Color3.fromRGB(26,26,32)
            Btn.Text = Cfg.Title or "Button"
            Btn.Font = Enum.Font.GothamMedium
            Btn.TextSize = 12
            Btn.TextColor3 = Color3.fromRGB(255,255,255)
            Btn.BorderSizePixel = 0
            Corner(Btn, 9)
            Btn.MouseButton1Click:Connect(function() pcall(Cfg.Callback or function() end) end)
        end

        function Elements:Toggle(Cfg)
            local State = Cfg.Default or false
            local Frame = Instance.new("Frame", TabPage)
            Frame.Size = UDim2.new(1,-4,0,40)
            Frame.BackgroundColor3 = Color3.fromRGB(26,26,32)
            Frame.BorderSizePixel = 0
            Corner(Frame, 9)
            local Label = Instance.new("TextLabel", Frame)
            Label.Size = UDim2.new(1,-70,1,0)
            Label.Position = UDim2.new(0,12,0,0)
            Label.BackgroundTransparency = 1
            Label.Text = Cfg.Title
            Label.TextXAlignment = Enum.TextXAlignment.Left
            Label.Font = Enum.Font.GothamMedium
            Label.TextSize = 12
            Label.TextColor3 = Color3.fromRGB(230,230,235)
            local Switch = Instance.new("Frame", Frame)
            Switch.Size = UDim2.new(0,42,0,22)
            Switch.Position = UDim2.new(1,-52,0.5,-11)
            Switch.BackgroundColor3 = State and Color3.fromRGB(90,70,255) or Color3.fromRGB(40,40,50)
            Switch.BorderSizePixel = 0
            Corner(Switch, 11)
            local Dot = Instance.new("Frame", Switch)
            Dot.Size = UDim2.new(0,16,0,16)
            Dot.Position = State and UDim2.new(1,-19,0.5,-8) or UDim2.new(0,3,0.5,-8)
            Dot.BackgroundColor3 = Color3.fromRGB(255,255,255)
            Dot.BorderSizePixel = 0
            Corner(Dot, 8)
            local Btn = Instance.new("TextButton", Frame)
            Btn.Size = UDim2.new(1,0,1,0)
            Btn.BackgroundTransparency = 1
            Btn.Text = ""
            Btn.MouseButton1Click:Connect(function()
                State = not State
                Tween(Switch, {BackgroundColor3 = State and Color3.fromRGB(90,70,255) or Color3.fromRGB(40,40,50)}, 0.18)
                Tween(Dot, {Position = State and UDim2.new(1,-19,0.5,-8) or UDim2.new(0,3,0.5,-8)}, 0.18)
                pcall(Cfg.Callback or function() end, State)
            end)
        end

        function Elements:Slider(Cfg)
            local Value = Cfg.Default or Cfg.Min or 0
            local Frame = Instance.new("Frame", TabPage)
            Frame.Size = UDim2.new(1,-4,0,52)
            Frame.BackgroundColor3 = Color3.fromRGB(26,26,32)
            Frame.BorderSizePixel = 0
            Corner(Frame, 9)
            local Label = Instance.new("TextLabel", Frame)
            Label.Text = Cfg.Title.." : "..Value
            Label.Size = UDim2.new(1,-16,0,18)
            Label.Position = UDim2.new(0,10,0,6)
            Label.BackgroundTransparency = 1
            Label.TextXAlignment = Enum.TextXAlignment.Left
            Label.Font = Enum.Font.GothamMedium
            Label.TextSize = 12
            Label.TextColor3 = Color3.fromRGB(230,230,235)
            local Bar = Instance.new("Frame", Frame)
            Bar.Size = UDim2.new(1,-20,0,6)
            Bar.Position = UDim2.new(0,10,0,32)
            Bar.BackgroundColor3 = Color3.fromRGB(40,40,50)
            Bar.BorderSizePixel = 0
            Corner(Bar, 3)
            local Fill = Instance.new("Frame", Bar)
            Fill.Size = UDim2.new((Value - Cfg.Min)/(Cfg.Max - Cfg.Min),0,1,0)
            Fill.BackgroundColor3 = Color3.fromRGB(90,70,255)
            Fill.BorderSizePixel = 0
            Corner(Fill, 3)
            local Drag = Instance.new("TextButton", Bar)
            Drag.Size = UDim2.new(1,0,1,0)
            Drag.BackgroundTransparency = 1
            Drag.Text = ""
            local dragging = false
            Drag.InputBegan:Connect(function(i) if i.UserInputType == Enum.UserInputType.MouseButton1 then dragging = true end end)
            UserInputService.InputEnded:Connect(function(i) if i.UserInputType == Enum.UserInputType.MouseButton1 then dragging = false end end)
            UserInputService.InputChanged:Connect(function(i)
                if dragging and i.UserInputType == Enum.UserInputType.MouseMovement then
                    local pos = math.clamp((i.Position.X - Bar.AbsolutePosition.X) / Bar.AbsoluteSize.X, 0, 1)
                    Value = math.floor(Cfg.Min + (Cfg.Max - Cfg.Min) * pos)
                    Fill.Size = UDim2.new(pos,0,1,0)
                    Label.Text = Cfg.Title.." : "..Value
                    pcall(Cfg.Callback or function() end, Value)
                end
            end)
        end

        function Elements:Input(Cfg)
            local Frame = Instance.new("Frame", TabPage)
            Frame.Size = UDim2.new(1,-4,0,38)
            Frame.BackgroundColor3 = Color3.fromRGB(26,26,32)
            Frame.BorderSizePixel = 0
            Corner(Frame, 9)
            local Box = Instance.new("TextBox", Frame)
            Box.Size = UDim2.new(1,-20,1,-10)
            Box.Position = UDim2.new(0,10,0,5)
            Box.BackgroundTransparency = 1
            Box.PlaceholderText = Cfg.Placeholder or Cfg.Title
            Box.Text = Cfg.Default or ""
            Box.Font = Enum.Font.Gotham
            Box.TextSize = 12
            Box.TextColor3 = Color3.fromRGB(255,255,255)
            Box.TextXAlignment = Enum.TextXAlignment.Left
            Box.ClearTextOnFocus = false
            Box.FocusLost:Connect(function() pcall(Cfg.Callback or function() end, Box.Text) end)
        end

        function Elements:Dropdown(Cfg)
            local Selected = Cfg.Default or Cfg.Options[1]
            local Frame = Instance.new("Frame", TabPage)
            Frame.Size = UDim2.new(1,-4,0,38)
            Frame.BackgroundColor3 = Color3.fromRGB(26,26,32)
            Frame.BorderSizePixel = 0
            Frame.ClipsDescendants = true
            Corner(Frame, 9)
            local Btn = Instance.new("TextButton", Frame)
            Btn.Size = UDim2.new(1,0,0,38)
            Btn.BackgroundTransparency = 1
            Btn.Text = Cfg.Title.." : "..Selected
            Btn.Font = Enum.Font.GothamMedium
            Btn.TextSize = 12
            Btn.TextColor3 = Color3.fromRGB(255,255,255)
            local List = Instance.new("Frame", Frame)
            List.Position = UDim2.new(0,0,0,38)
            List.Size = UDim2.new(1,0,0,#Cfg.Options*30)
            List.BackgroundTransparency = 1
            Instance.new("UIListLayout", List).Padding = UDim.new(0,2)
            local Open = false
            Btn.MouseButton1Click:Connect(function()
                Open = not Open
                Tween(Frame, {Size = Open and UDim2.new(1,-4,0,38 + #Cfg.Options*30 + 6) or UDim2.new(1,-4,0,38)}, 0.2)
            end)
            for _, opt in ipairs(Cfg.Options) do
                local O = Instance.new("TextButton", List)
                O.Size = UDim2.new(1,0,0,28)
                O.BackgroundColor3 = Color3.fromRGB(35,35,45)
                O.Text = opt
                O.Font = Enum.Font.Gotham
                O.TextSize = 11
                O.TextColor3 = Color3.fromRGB(200,200,200)
                O.BorderSizePixel = 0
                Corner(O, 6)
                O.MouseButton1Click:Connect(function()
                    Selected = opt
                    Btn.Text = Cfg.Title.." : "..Selected
                    Open = false
                    Tween(Frame, {Size = UDim2.new(1,-4,0,38)}, 0.2)
                    pcall(Cfg.Callback or function() end, Selected)
                end)
            end
        end

        function Elements:Colorpicker(Cfg)
            local Color = Cfg.Default or Color3.fromRGB(90,70,255)
            local Frame = Instance.new("Frame", TabPage)
            Frame.Size = UDim2.new(1,-4,0,38)
            Frame.BackgroundColor3 = Color3.fromRGB(26,26,32)
            Frame.BorderSizePixel = 0
            Corner(Frame, 9)
            local Label = Instance.new("TextLabel", Frame)
            Label.Text = Cfg.Title
            Label.Size = UDim2.new(1,-60,1,0)
            Label.Position = UDim2.new(0,10,0,0)
            Label.BackgroundTransparency = 1
            Label.TextXAlignment = Enum.TextXAlignment.Left
            Label.Font = Enum.Font.GothamMedium
            Label.TextSize = 12
            Label.TextColor3 = Color3.fromRGB(255,255,255)
            local Preview = Instance.new("Frame", Frame)
            Preview.Size = UDim2.new(0,28,0,20)
            Preview.Position = UDim2.new(1,-38,0.5,-10)
            Preview.BackgroundColor3 = Color
            Preview.BorderSizePixel = 0
            Corner(Preview, 6)
            local Btn = Instance.new("TextButton", Frame)
            Btn.Size = UDim2.new(1,0,1,0)
            Btn.BackgroundTransparency = 1
            Btn.Text = ""
            Btn.MouseButton1Click:Connect(function()
                local newColor = Color3.fromHSV(math.random(),1,1)
                Preview.BackgroundColor3 = newColor
                pcall(Cfg.Callback or function() end, newColor)
            end)
