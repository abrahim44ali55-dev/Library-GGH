-- Nice Library V2 - With X & Minimize + Floating Button
local MyUI = {}
local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")

local Creator = {}
function Creator.New(className, props, children)
    local inst = Instance.new(className)
    for k,v in pairs(props or {}) do
        if k ~= "ThemeTag" and k ~= "Parent" then
            pcall(function() inst[k] = v end)
        end
    end
    if props.Parent then inst.Parent = props.Parent end
    for _, child in pairs(children or {}) do
        child.Parent = inst
    end
    return inst
end

function MyUI:CreateWindow(config)
    config = config or {}
    local Title = config.Title or "Nice Library"
    local Author = config.Author or "by abrahim"

    local ScreenGui = Creator.New("ScreenGui", {
        Name = Title,
        ResetOnSpawn = false,
        ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
        Parent = game.CoreGui
    })

    -- زر عائم (يظهر عند التصغير)
    local FloatingButton = Creator.New("TextButton", {
        Name = "FloatingBtn",
        Size = UDim2.new(0, 110, 0, 36),
        Position = UDim2.new(0.5, -55, 0, 15),
        BackgroundColor3 = Color3.fromRGB(35, 35, 40),
        Text = "🔥 "..Title,
        Font = Enum.Font.GothamBold,
