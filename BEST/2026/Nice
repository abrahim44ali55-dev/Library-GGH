local Settings = redzlib.Settings or {}
local Flags = redzlib.Flags or {}
local Instances = {}
redzlib.Instances = Instances
redzlib.Flags = Flags

local SetProps, SetChildren, InsertTheme, Create, Make, Funcs

InsertTheme = function(Instance, Type)
    table.insert(Instances, {Instance = Instance, Type = Type})
    return Instance
end

SetChildren = function(Instance, Children)
    if Children then
        for _,Child in pairs(Children) do Child.Parent = Instance end
    end
    return Instance
end

SetProps = function(Instance, Props)
    if Props then
        for k,v in pairs(Props) do
            pcall(function() Instance[k] = v end)
        end
    end
    return Instance
end

Create = function(Class, Parent, Props)
    local Inst = Instance.new(Class)
    SetProps(Inst, Props)
    Inst.Parent = Parent
    return Inst
end

Make = function(Type, Instance, Value)
    if Type == "Corner" then
        local Corner = Instance.new("UICorner")
        Corner.CornerRadius = Value or redzlib.CurrentCornerRadius
        Corner.Parent = Instance
        return Instance
    elseif Type == "Stroke" then
        local Stroke = Instance.new("UIStroke")
        Stroke.Color = Value or Color3.fromRGB(60,60,60)
        Stroke.Thickness = 1
        Stroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
        Stroke.Parent = Instance
        return Instance
    end
    return Instance
end

local function CreateTween(Info)
    local obj, prop, val, tim = Info[1], Info[2], Info[3], Info[4] or 0.2
    pcall(function()
        TweenService:Create(obj, TweenInfo.new(tim, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {[prop]=val}):Play()
    end)
end

Funcs = {}
function Funcs:ToggleVisible(obj, bool) obj.Visible = bool end

-- Notification System
function redzlib:Notification(title, desc, time)
    time = time or 3
    local gui = CoreGui:FindFirstChild("redzLib") or (Player.PlayerGui and Player.PlayerGui:FindFirstChild("redzLib"))
    if not gui then return end
    local holder = gui:FindFirstChild("GGH_Notifs")
    if not holder then
        holder = Instance.new("Frame", gui)
        holder.Name = "GGH_Notifs"
        holder.Size = UDim2.new(0, 300, 1, 0)
        holder.Position = UDim2.new(1, -310, 0, 10)
        holder.BackgroundTransparency = 1
        Instance.new("UIListLayout", holder).Padding = UDim.new(0, 6)
    end
    local notif = Create("Frame", holder, {Size = UDim2.new(1,0,0,60), BackgroundColor3 = Color3.fromRGB(35,35,35)})
    Make("Corner", notif, UDim.new(0,10))
    local s = Instance.new("UIStroke", notif) s.Color = Color3.fromRGB(88,101,242) s.Thickness = 1.5
    Create("TextLabel", notif, {Text=title, Font=Enum.Font.GothamBold, TextSize=13, TextColor3=Color3.fromRGB(255,255,255), BackgroundTransparency=1, Size=UDim2.new(1,-20,0,20), Position=UDim2.new(0,10,0,5), TextXAlignment="Left"})
    Create("TextLabel", notif, {Text=desc, Font=Enum.Font.Gotham, TextSize=11, TextColor3=Color3.fromRGB(180,180,180), BackgroundTransparency=1, Size=UDim2.new(1,-20,0,30), Position=UDim2.new(0,10,0,25), TextXAlignment="Left", TextWrapped=true})
    notif.Size = UDim2.new(1,0,0,0)
    CreateTween({notif, "Size", UDim2.new(1,0,0,60), 0.3})
    task.delay(time, function() CreateTween({notif, "Size", UDim2.new(1,0,0,0), 0.3}) task.wait(0.3) notif:Destroy() end)
end

