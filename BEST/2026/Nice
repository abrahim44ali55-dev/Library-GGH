            Label.Position = UDim2.new(0,10,0,0)
            Label.BackgroundTransparency = 1
            Label.TextXAlignment = Enum.TextXAlignment.Left
            Label.Font = Enum.Font.GothamMedium
            Label.TextSize = 12
            Label.TextColor3 = Color3.fromRGB(255,255,255)
            local Btn = Instance.new("TextButton", Frame)
            Btn.Size = UDim2.new(1,0,1,0)
            Btn.BackgroundTransparency = 1
            Btn.Text = ""
            Btn.MouseButton1Click:Connect(function()
                Label.Text = Cfg.Title.." : ..."
                local conn; conn = UserInputService.InputBegan:Connect(function(input)
                    if input.UserInputType == Enum.UserInputType.Keyboard then
                        Key = input.KeyCode
                        Label.Text = Cfg.Title.." : "..Key.Name
                        pcall(Cfg.Callback or function() end, Key)
                        conn:Disconnect()
                    end
                end)
            end)
        end

        function Elements:Code(Cfg)
            local Frame = Instance.new("Frame", TabPage)
            Frame.Size = UDim2.new(1,-4,0,80)
            Frame.BackgroundColor3 = Color3.fromRGB(18,18,22)
            Frame.BorderSizePixel = 0
            Corner(Frame, 10)
            local CodeLabel = Instance.new("TextLabel", Frame)
            CodeLabel.Size = UDim2.new(1,-16,1,-16)
            CodeLabel.Position = UDim2.new(0,8,0,8)
            CodeLabel.BackgroundTransparency = 1
            CodeLabel.Text = Cfg.Code or "-- code"
            CodeLabel.Font = Enum.Font.Code
            CodeLabel.TextSize = 11
            CodeLabel.TextColor3 = Color3.fromRGB(180,180,255)
            CodeLabel.TextXAlignment = Enum.TextXAlignment.Left
            CodeLabel.TextYAlignment = Enum.TextYAlignment.Top
            CodeLabel.TextWrapped = true
        end

        return Elements
    end

    return Window
end

return GGH
