--[[
    GGH Library v1.0
    Inspired by WindUI / Rayfield
    Elements: Button, Code, Colorpicker, Dropdown, Input, Keybind, Paragraph, Section, Slider, Toggle
    Host on: raw.githubusercontent.com
    
    Usage:
    local GGH = loadstring(game:HttpGet("YOUR_RAW_LINK_HERE"))()
]]

local GGH = {}
local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")

local function GetGuiParent()
    local success, parent = pcall(function() return gethui() end)
    if success and parent then return parent end
    return game:GetService("CoreGui")
end

local function MakeCorner(parent, radius)
    local c = Instance.new("UICorner")
    c.CornerRadius = UDim.new(0, radius or 8)
    c.Parent = parent
    return c
end

local function Tween(obj, props, duration)
    TweenService:Create(obj, TweenInfo.new(duration or 0.25, Enum.EasingStyle.Quint), props):Play()
end

function GGH:CreateWindow(Config)
    Config = Config or {}
    local Title = Config.Title or "GGH Library"
    local SubTitle = Config.SubTitle or "v1.0"

    local ScreenGui = Instance.new("ScreenGui")
    ScreenGui.Name = "GGH_Library"
    ScreenGui.ResetOnSpawn = false
    ScreenGui.Parent = GetGuiParent()

    local Main = Instance.new("Frame")
    Main.Name = "Main"
    Main.Size = UDim2.new(0, 600, 0, 420)
    Main.Position = UDim2.new(0.5, -300, 0.5, -210)
    Main.BackgroundColor3 = Color3.fromRGB(13, 13, 16)
    Main.BorderSizePixel = 0
    Main.Parent = ScreenGui
    MakeCorner(Main, 14)

    local Stroke = Instance.new("UIStroke", Main)
    Stroke.Color = Color3.fromRGB(35, 35, 45)
    Stroke.Thickness = 1

    -- Header
    local Header = Instance.new("Frame", Main)
    Header.Size = UDim2.new(1, 0, 0, 50)
    Header.BackgroundTransparency = 1

    local TitleLabel = Instance.new("TextLabel", Header)
    TitleLabel.Text = Title
    TitleLabel.Position = UDim2.new(0, 18, 0, 8)
    TitleLabel.Size = UDim2.new(0, 200, 0, 20)
    TitleLabel.TextXAlignment = Enum.TextXAlignment.Left
    TitleLabel.BackgroundTransparency = 1
    TitleLabel.Font = Enum.Font.GothamBold
    TitleLabel.TextSize = 16
    TitleLabel.TextColor3 = Color3.fromRGB(255,255,255)

    local SubLabel = Instance.new("TextLabel", Header)
    SubLabel.Text = SubTitle
    SubLabel.Position = UDim2.new(0, 18, 0, 28)
    SubLabel.Size = UDim2.new(0, 200, 0, 14)
    SubLabel.TextXAlignment = Enum.TextXAlignment.Left
    SubLabel.BackgroundTransparency = 1
    SubLabel.Font = Enum.Font.Gotham
    SubLabel.TextSize = 12
    SubLabel.TextColor3 = Color3.fromRGB(150,150,160)

    -- Left Tabs
    local TabList = Instance.new("ScrollingFrame", Main)
    TabList.Name = "TabList"
    TabList.Size = UDim2.new(0, 150, 1, -60)
    TabList.Position = UDim2.new(0, 10, 0, 50)
    TabList.BackgroundColor3 = Color3.fromRGB(18, 18, 22)
    TabList.BorderSizePixel = 0
    TabList.CanvasSize = UDim2.new(0,0,0,0)
    TabList.AutomaticCanvasSize = Enum.AutomaticSize.Y
    TabList.ScrollBarThickness = 0
    MakeCorner(TabList, 10)
    Instance.new("UIListLayout", TabList).Padding = UDim.new(0, 6)
    Instance.new("UIPadding", TabList).PaddingTop = UDim.new(0, 6)
    Instance.new("UIPadding", TabList).PaddingLeft = UDim.new(0, 6)
    Instance.new("UIPadding", TabList).PaddingRight = UDim.new(0, 6)

    local Container = Instance.new("Frame", Main)
    Container.Name = "Container"
    Container.Size = UDim2.new(1, -180, 1, -60)
    Container.Position = UDim2.new(0, 170, 0, 50)
    Container.BackgroundTransparency = 1

    -- Drag
    do
        local dragging, dragStart, startPos
        Header.InputBegan:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 then
                dragging = true
                dragStart = input.Position
                startPos = Main.Position
            end
        end)
        UserInputService.InputChanged:Connect(function(input)
            if dragging and input.UserInputType == Enum.UserInputType.MouseMovement then
                local delta = input.Position - dragStart
                Main.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
            end
        end)
        UserInputService.InputEnded:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 then dragging = false end
        end)
    end

    local Window = {}
    local Tabs = {}
    local FirstTab = true

    function Window:CreateTab(Name)
        local TabButton = Instance.new("TextButton", TabList)
        TabButton.Size = UDim2.new(1, -12, 0, 36)
        TabButton.BackgroundColor3 = Color3.fromRGB(26, 26, 32)
        TabButton.Text = Name
        TabButton.Font = Enum.Font.GothamMedium
        TabButton.TextSize = 13
        TabButton.TextColor3 = Color3.fromRGB(180,180,190)
        MakeCorner(TabButton, 8)

        local TabPage = Instance.new("ScrollingFrame", Container)
        TabPage.Name = Name
        TabPage.Size = UDim2.new(1, 0, 1, 0)
        TabPage.BackgroundTransparency = 1
        TabPage.Visible = false
        TabPage.CanvasSize = UDim2.new(0,0,0,0)
        TabPage.AutomaticCanvasSize = Enum.AutomaticSize.Y
        TabPage.ScrollBarThickness = 2
        Instance.new("UIListLayout", TabPage).Padding = UDim.new(0, 10)

        TabButton.MouseButton1Click:Connect(function()
            for _, t in pairs(Tabs) do
                t.Page.Visible = false
                Tween(t.Button, {BackgroundColor3 = Color3.fromRGB(26,26,32)}, 0.2)
                t.Button.TextColor3 = Color3.fromRGB(180,180,190)
            end
            TabPage.Visible = true
            Tween(TabButton, {BackgroundColor3 = Color3.fromRGB(90, 70, 255)}, 0.2)
            TabButton.TextColor3 = Color3.fromRGB(255,255,255)
        end)

        if FirstTab then
            FirstTab = false
            TabPage.Visible = true
            TabButton.BackgroundColor3 = Color3.fromRGB(90, 70, 255)
            TabButton.TextColor3 = Color3.fromRGB(255,255,255)
        end

        table.insert(Tabs, {Button = TabButton, Page = TabPage})

        local Elements = {}

        -- SECTION
        function Elements:Section(Config)
            local Sec = Instance.new("TextLabel", TabPage)
            Sec.Size = UDim2.new(1, -5, 0, 24)
            Sec.BackgroundTransparency = 1
            Sec.Text = (Config and Config.Title or "Section").upper()
            Sec.Font = Enum.Font.GothamBold
            Sec.TextSize = 12
            Sec.TextColor3 = Color3.fromRGB(120, 120, 135)
            Sec.TextXAlignment = Enum.TextXAlignment.Left
        end

        -- PARAGRAPH
        function Elements:Paragraph(Config)
            local Frame = Instance.new("Frame", TabPage)
            Frame.Size = UDim2.new(1, -5, 0, 60)
            Frame.AutomaticSize = Enum.AutomaticSize.Y
            Frame.BackgroundColor3 = Color3.fromRGB(18,18,22)
            MakeCorner(Frame, 10)
            local pad = Instance.new("UIPadding", Frame)
            pad.PaddingTop = UDim.new(0,10); pad.PaddingBottom=UDim.new(0,10); pad.PaddingLeft=UDim.new(0,12); pad.PaddingRight=UDim.new(0,12)
            local T = Instance.new("TextLabel", Frame)
            T.Size = UDim2.new(1,0,0,20)
            T.AutomaticSize = Enum.AutomaticSize.Y
            T.BackgroundTransparency = 1
            T.Text = Config.Title.."\n"..Config.Content
            T.TextWrapped = true
            T.TextXAlignment = Enum.TextXAlignment.Left
            T.Font = Enum.Font.Gotham
            T.TextSize = 13
            T.TextColor3 = Color3.fromRGB(200,200,210)
        end

        -- BUTTON
        function Elements:Button(Config)
            local Btn = Instance.new("TextButton", TabPage)
            Btn.Size = UDim2.new(1, -5, 0, 40)
            Btn.BackgroundColor3 = Color3.fromRGB(26,26,32)
            Btn.Text = Config.Title or "Button"
            Btn.Font = Enum.Font.GothamMedium
            Btn.TextSize = 13
            Btn.TextColor3 = Color3.fromRGB(255,255,255)
            MakeCorner(Btn, 10)
            Btn.MouseButton1Click:Connect(function() pcall(Config.Callback or function() end) end)
            return Btn
        end

        -- TOGGLE
        function Elements:Toggle(Config)
            local State = Config.Default or false
            local Frame = Instance.new("Frame", TabPage)
            Frame.Size = UDim2.new(1, -5, 0, 44)
            Frame.BackgroundColor3 = Color3.fromRGB(26,26,32)
            MakeCorner(Frame, 10)
            local Label = Instance.new("TextLabel", Frame)
            Label.Size = UDim2.new(1, -70, 1, 0)
            Label.Position = UDim2.new(0,12,0,0)
            Label.BackgroundTransparency = 1
            Label.Text = Config.Title
            Label.TextXAlignment = Enum.TextXAlignment.Left
            Label.Font = Enum.Font.GothamMedium
            Label.TextSize = 13
            Label.TextColor3 = Color3.fromRGB(230,230,235)
            local Switch = Instance.new("Frame", Frame)
            Switch.Size = UDim2.new(0, 44, 0, 24)
            Switch.Position = UDim2.new(1, -54, 0.5, -12)
            Switch.BackgroundColor3 = State and Color3.fromRGB(90,70,255) or Color3.fromRGB(40,40,50)
            MakeCorner(Switch, 12)
            local Dot = Instance.new("Frame", Switch)
            Dot.Size = UDim2.new(0,18,0,18)
            Dot.Position = State and UDim2.new(1,-21,0.5,-9) or UDim2.new(0,3,0.5,-9)
            Dot.BackgroundColor3 = Color3.fromRGB(255,255,255)
            MakeCorner(Dot, 9)
            local Btn = Instance.new("TextButton", Frame)
            Btn.Size = UDim2.new(1,0,1,0)
            Btn.BackgroundTransparency = 1
            Btn.Text = ""
            Btn.MouseButton1Click:Connect(function()
                State = not State
                Tween(Switch, {BackgroundColor3 = State and Color3.fromRGB(90,70,255) or Color3.fromRGB(40,40,50)}, 0.2)
                Tween(Dot, {Position = State and UDim2.new(1,-21,0.5,-9) or UDim2.new(0,3,0.5,-9)}, 0.2)
                pcall(Config.Callback or function() end, State)
            end)
        end

        -- SLIDER
        function Elements:Slider(Config)
            local Value = Config.Default or Config.Min or 0
            local Frame = Instance.new("Frame", TabPage)
            Frame.Size = UDim2.new(1, -5, 0, 56)
            Frame.BackgroundColor3 = Color3.fromRGB(26,26,32)
            MakeCorner(Frame, 10)
            local Label = Instance.new("TextLabel", Frame)
            Label.Text = Config.Title.." : "..Value
            Label.Size = UDim2.new(1,-20,0,20)
            Label.Position = UDim2.new(0,12,0,6)
            Label.BackgroundTransparency = 1
            Label.TextXAlignment = Enum.TextXAlignment.Left
            Label.Font = Enum.Font.GothamMedium
            Label.TextSize = 13
            Label.TextColor3 = Color3.fromRGB(230,230,235)
            local Bar = Instance.new("Frame", Frame)
            Bar.Size = UDim2.new(1,-24,0,6)
            Bar.Position = UDim2.new(0,12,0,36)
            Bar.BackgroundColor3 = Color3.fromRGB(40,40,50)
            MakeCorner(Bar, 3)
            local Fill = Instance.new("Frame", Bar)
            Fill.Size = UDim2.new((Value - Config.Min)/(Config.Max - Config.Min),0,1,0)
            Fill.BackgroundColor3 = Color3.fromRGB(90,70,255)
            MakeCorner(Fill, 3)
            local Drag = Instance.new("TextButton", Bar)
            Drag.Size = UDim2.new(1,0,1,0)
            Drag.BackgroundTransparency = 1
            Drag.Text = ""
            local dragging = false
            Drag.InputBegan:Connect(function(i) if i.UserInputType == Enum.UserInputType.MouseButton1 then dragging = true end end)
            UserInputService.InputEnded:Connect(function(i) if i.UserInputType == Enum.UserInputType.MouseButton1 then dragging = false end end)
            UserInputService.InputChanged:Connect(function(i)
                if dragging and i.UserInputType == Enum.UserInputType.MouseMovement then
                    local pos = math.clamp((i.Position.X - Bar.AbsolutePosition.X) / Bar.AbsoluteSize.X, 0, 1)
                    Value = math.floor(Config.Min + (Config.Max - Config.Min) * pos)
                    Fill.Size = UDim2.new(pos,0,1,0)
                    Label.Text = Config.Title.." : "..Value
                    pcall(Config.Callback or function() end, Value)
                end
            end)
        end

        -- INPUT
        function Elements:Input(Config)
            local Frame = Instance.new("Frame", TabPage)
            Frame.Size = UDim2.new(1, -5, 0, 44)
            Frame.BackgroundColor3 = Color3.fromRGB(26,26,32)
            MakeCorner(Frame, 10)
            local Box = Instance.new("TextBox", Frame)
            Box.Size = UDim2.new(1,-24,1,-12)
            Box.Position = UDim2.new(0,12,0,6)
            Box.BackgroundTransparency = 1
            Box.PlaceholderText = Config.Placeholder or Config.Title
            Box.Text = Config.Default or ""
            Box.Font = Enum.Font.Gotham
            Box.TextSize = 13
            Box.TextColor3 = Color3.fromRGB(255,255,255)
            Box.TextXAlignment = Enum.TextXAlignment.Left
            Box.FocusLost:Connect(function() pcall(Config.Callback or function() end, Box.Text) end)
        end

        -- DROPDOWN
        function Elements:Dropdown(Config)
            local Selected = Config.Default or Config.Options[1]
            local Frame = Instance.new("Frame", TabPage)
            Frame.Size = UDim2.new(1, -5, 0, 44)
            Frame.BackgroundColor3 = Color3.fromRGB(26,26,32)
            MakeCorner(Frame, 10)
            Frame.ClipsDescendants = true
            local Btn = Instance.new("TextButton", Frame)
            Btn.Size = UDim2.new(1,0,0,44)
            Btn.BackgroundTransparency = 1
            Btn.Text = Config.Title.." : "..Selected
            Btn.Font = Enum.Font.GothamMedium
            Btn.TextSize = 13
            Btn.TextColor3 = Color3.fromRGB(255,255,255)
            local List = Instance.new("Frame", Frame)
            List.Position = UDim2.new(0,0,0,44)
            List.Size = UDim2.new(1,0,0,#Config.Options*30)
            List.BackgroundTransparency = 1
            Instance.new("UIListLayout", List)
            local Open = false
            Btn.MouseButton1Click:Connect(function()
                Open = not Open
                Tween(Frame, {Size = Open and UDim2.new(1,-5,0,44 + #Config.Options*30) or UDim2.new(1,-5,0,44)}, 0.25)
            end)
            for _, opt in ipairs(Config.Options) do
                local O = Instance.new("TextButton", List)
                O.Size = UDim2.new(1,0,0,30)
                O.BackgroundColor3 = Color3.fromRGB(35,35,45)
                O.Text = opt
                O.Font = Enum.Font.Gotham
                O.TextSize = 12
                O.TextColor3 = Color3.fromRGB(200,200,200)
                O.MouseButton1Click:Connect(function()
                    Selected = opt
                    Btn.Text = Config.Title.." : "..Selected
                    Open = false
                    Tween(Frame, {Size = UDim2.new(1,-5,0,44)}, 0.25)
                    pcall(Config.Callback or function() end, Selected)
                end)
            end
        end

        -- COLORPICKER
        function Elements:Colorpicker(Config)
            local Color = Config.Default or Color3.fromRGB(90,70,255)
            local Frame = Instance.new("Frame", TabPage)
            Frame.Size = UDim2.new(1, -5, 0, 44)
            Frame.BackgroundColor3 = Color3.fromRGB(26,26,32)
            MakeCorner(Frame, 10)
            local Label = Instance.new("TextLabel", Frame)
            Label.Text = Config.Title
            Label.Size = UDim2.new(1,-60,1,0)
            Label.Position = UDim2.new(0,12,0,0)
            Label.BackgroundTransparency = 1
            Label.TextXAlignment = Enum.TextXAlignment.Left
            Label.Font = Enum.Font.GothamMedium
            Label.TextSize = 13
            Label.TextColor3 = Color3.fromRGB(255,255,255)
            local Preview = Instance.new("Frame", Frame)
            Preview.Size = UDim2.new(0,30,0,22)
            Preview.Position = UDim2.new(1,-42,0.5,-11)
            Preview.BackgroundColor3 = Color
            MakeCorner(Preview, 6)
            local Btn = Instance.new("TextButton", Frame)
            Btn.Size = UDim2.new(1,0,1,0)
            Btn.BackgroundTransparency = 1
            Btn.Text = ""
            Btn.MouseButton1Click:Connect(function()
                local newColor = Color3.fromHSV(math.random(),1,1) -- مبسط، تقدر تطوره لـ palette كامل
                Preview.BackgroundColor3 = newColor
                pcall(Config.Callback or function() end, newColor)
            end)
        end

        -- KEYBIND
        function Elements:Keybind(Config)
            local Key = Config.Default or Enum.KeyCode.F
            local Frame = Instance.new("Frame", TabPage)
            Frame.Size = UDim2.new(1, -5, 0, 44)
            Frame.BackgroundColor3 = Color3.fromRGB(26,26,32)
            MakeCorner(Frame, 10)
            local Label = Instance.new("TextLabel", Frame)
            Label.Text = Config.Title.." : "..Key.Name
            Label.Size = UDim2.new(1,-20,1,0)
            Label.Position = UDim2.new(0,12,0,0)
            Label.BackgroundTransparency = 1
            Label.TextXAlignment = Enum.TextXAlignment.Left
            Label.Font = Enum.Font.GothamMedium
            Label.TextSize = 13
            Label.TextColor3 = Color3.fromRGB(255,255,255)
            local Btn = Instance.new("TextButton", Frame)
            Btn.Size = UDim2.new(1,0,1,0)
            Btn.BackgroundTransparency = 1
            Btn.Text = ""
            Btn.MouseButton1Click:Connect(function()
                Label.Text = Config.Title.." : ..."
                local conn; conn = UserInputService.InputBegan:Connect(function(input)
                    if input.UserInputType == Enum.UserInputType.Keyboard then
                        Key = input.KeyCode
                        Label.Text = Config.Title.." : "..Key.Name
                        pcall(Config.Callback or function() end, Key)
                        conn:Disconnect()
                    end
                end)
            end)
        end

        -- CODE
        function Elements:Code(Config)
            local Frame = Instance.new("Frame", TabPage)
            Frame.Size = UDim2.new(1, -5, 0, 80)
            Frame.BackgroundColor3 = Color3.fromRGB(18,18,22)
            MakeCorner(Frame, 10)
            local CodeLabel = Instance.new("TextLabel", Frame)
            CodeLabel.Size = UDim2.new(1,-20,1,-20)
            CodeLabel.Position = UDim2.new(0,10,0,10)
            CodeLabel.BackgroundTransparency = 1
            CodeLabel.Text = Config.Code or "-- code"
            CodeLabel.Font = Enum.Font.Code
            CodeLabel.TextSize = 12
            CodeLabel.TextColor3 = Color3.fromRGB(180,180,255)
            CodeLabel.TextXAlignment = Enum.TextXAlignment.Left
            CodeLabel.TextYAlignment = Enum.TextYAlignment.Top
            CodeLabel.TextWrapped = true
        end

        return Elements
    end

    return Window
end

return GGH
