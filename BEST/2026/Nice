--[[
    NovaUI v2.2 Fixed - Small & Working
    رابطك الثابت: https://raw.githubusercontent.com/abrahim44ali55-dev/Library-GGH/refs/heads/main/BEST/2026/Nice
    Fix: حجم صغير + كل العناصر تشتغل + ما تطلع برا الشاشة
]]
local NovaUI = {}
NovaUI.Version = "2.2 Fixed"
NovaUI.Options = {}
NovaUI.Themes = {List = {
    Dark = {Background=Color3.fromRGB(25,25,25), Background2=Color3.fromRGB(35,35,35), Accent=Color3.fromRGB(0,120,212), Text=Color3.fromRGB(240,240,240), Text2=Color3.fromRGB(150,150,150), Border=Color3.fromRGB(50,50,50)},
    Cyber = {Background=Color3.fromRGB(10,15,20), Background2=Color3.fromRGB(18,25,35), Accent=Color3.fromRGB(0,255,150), Text=Color3.fromRGB(230,255,240), Text2=Color3.fromRGB(100,180,140), Border=Color3.fromRGB(0,80,60)},
    Amethyst = {Background=Color3.fromRGB(22,18,30), Background2=Color3.fromRGB(35,28,50), Accent=Color3.fromRGB(160,90,255), Text=Color3.fromRGB(240,230,255), Text2=Color3.fromRGB(150,130,180), Border=Color3.fromRGB(60,45,80)},
    Midnight = {Background=Color3.fromRGB(5,8,15), Background2=Color3.fromRGB(12,18,28), Accent=Color3.fromRGB(60,120,255), Text=Color3.fromRGB(220,230,255), Text2=Color3.fromRGB(120,130,160), Border=Color3.fromRGB(20,30,50)},
}}
NovaUI.CurrentTheme = NovaUI.Themes.List.Dark

local TS = game:GetService("TweenService")
local UIS = game:GetService("UserInputService")
local RS = game:GetService("RunService")
local Players = game:GetService("Players")
local Player = Players.LocalPlayer
local function Tween(o,p,t) return TS:Create(o,TweenInfo.new(t or 0.22,Enum.EasingStyle.Quad,Enum.EasingDirection.Out),p) end
local function Create(c,props,childs)
    local i=Instance.new(c)
    for k,v in pairs(props or {}) do if k~="Parent" then pcall(function() i[k]=v end) end end
    if childs then for _,ch in ipairs(childs) do ch.Parent=i end end
    if props.Parent then i.Parent=props.Parent end
    return i
end

function NovaUI:CreateWindow(Cfg)
    Cfg=Cfg or {}
    local Theme = NovaUI.Themes.List[Cfg.Theme] or NovaUI.Themes.List.Dark
    NovaUI.CurrentTheme = Theme
    -- حجم صغير يشتغل على كل الشاشات
    local Size = Cfg.Size or UDim2.fromOffset(480, 360) -- كان 620x500 كلش جبير، هسه 480x360
    local Title = Cfg.Title or "NovaUI"
    local Sub = Cfg.SubTitle or "v2.2 Fixed"
    
    local ScreenGui = Create("ScreenGui", {Name="NovaUI_"..HttpService and HttpService:GenerateGUID(false) or "UI", ZIndexBehavior=Enum.ZIndexBehavior.Sibling, ResetOnSpawn=false, Parent= (gethui and gethui()) or (RS:IsStudio() and Player.PlayerGui or game:GetService("CoreGui"))})
    
    -- خلفية شفافة تمنع الكليك يطلع برا
    local Main = Create("Frame", {Parent=ScreenGui, AnchorPoint=Vector2.new(0.5,0.5), Position=UDim2.fromScale(0.5,0.5), Size=Size, BackgroundColor3=Theme.Background, BorderSizePixel=0}, {
        Create("UICorner", {CornerRadius=UDim.new(0,10)}),
        Create("UIStroke", {Color=Theme.Border, Thickness=1, Transparency=0.3}),
        Create("UIScale", {Name="Scale"})
    })
    
    -- تصغير تلقائي اذا الشاشة صغيرة (موبايل)
    local vp = workspace.CurrentCamera.ViewportSize
    if vp.X < 600 or vp.Y < 500 then
        Main.UIScale.Scale = math.min(vp.X/600, vp.Y/500) * 0.9
    end
    
    local TitleBar = Create("Frame", {Parent=Main, Size=UDim2.new(1,0,0,36), BackgroundColor3=Theme.Background2, BorderSizePixel=0}, {
        Create("UICorner", {CornerRadius=UDim.new(0,10)}),
        Create("Frame", {Size=UDim2.new(1,0,0,10), Position=UDim2.new(0,0,1,-5), BackgroundColor3=Theme.Background2, BorderSizePixel=0})
    })
    Create("TextLabel", {Parent=TitleBar, Position=UDim2.fromOffset(12,0), Size=UDim2.new(1,-90,1,0), BackgroundTransparency=1, Text=Title.."  "..Sub, TextColor3=Theme.Text, Font=Enum.Font.GothamBold, TextSize=13, TextXAlignment=Enum.TextXAlignment.Left, TextTruncate=Enum.TextTruncate.AtEnd})
    
    -- Drag
    do
        local drag, start, sPos
        TitleBar.InputBegan:Connect(function(i) if i.UserInputType==Enum.UserInputType.MouseButton1 or i.UserInputType==Enum.UserInputType.Touch then drag=true start=i.Position sPos=Main.Position end end)
        UIS.InputChanged:Connect(function(i) if drag and (i.UserInputType==Enum.UserInputType.MouseMovement or i.UserInputType==Enum.UserInputType.Touch) then local d=i.Position-start Main.Position=UDim2.new(sPos.X.Scale,sPos.X.Offset+d.X,sPos.Y.Scale,sPos.Y.Offset+d.Y) end end)
        UIS.InputEnded:Connect(function(i) if i.UserInputType==Enum.UserInputType.MouseButton1 or i.UserInputType==Enum.UserInputType.Touch then drag=false end end)
    end
    
    local Close = Create("TextButton", {Parent=TitleBar, AnchorPoint=Vector2.new(1,0.5), Position=UDim2.new(1,-8,0.5,0), Size=UDim2.fromOffset(24,24), BackgroundColor3=Color3.fromRGB(255,90,90), Text="✕", TextColor3=Color3.new(1,1,1), Font=Enum.Font.GothamBold, TextSize=12}, {Create("UICorner", {CornerRadius=UDim.new(0,6)})})
    Close.MouseButton1Click:Connect(function() Tween(Main,{Size=UDim2.fromOffset(0,0)},0.2):Play() task.wait(0.2) ScreenGui:Destroy() end)
    
    local MinBtn = Create("TextButton", {Parent=TitleBar, AnchorPoint=Vector2.new(1,0.5), Position=UDim2.new(1,-36,0.5,0), Size=UDim2.fromOffset(24,24), BackgroundColor3=Theme.Background, Text="-", TextColor3=Theme.Text, Font=Enum.Font.GothamBold, TextSize=14}, {Create("UICorner", {CornerRadius=UDim.new(0,6)})})
    local minimized=false
    MinBtn.MouseButton1Click:Connect(function() minimized=not minimized Tween(Main,{Size=minimized and UDim2.fromOffset(480,36) or Size},0.25):Play() end)
    
    local Left = Create("Frame", {Parent=Main, Position=UDim2.fromOffset(0,36), Size=UDim2.new(0,130,1,-36), BackgroundColor3=Theme.Background2, BackgroundTransparency=0.2, BorderSizePixel=0}, {
        Create("UIListLayout", {Padding=UDim.new(0,4), SortOrder=Enum.SortOrder.LayoutOrder}),
        Create("UIPadding", {PaddingTop=UDim.new(0,6), PaddingLeft=UDim.new(0,6), PaddingRight=UDim.new(0,6)}),
    })
    local Right = Create("Frame", {Parent=Main, Position=UDim2.new(0,130,0,36), Size=UDim2.new(1,-130,1,-36), BackgroundTransparency=1, ClipsDescendants=true}, {})
    
    local Window={Tabs={}, Theme=Theme, Frame=Main}
    
    function Window:CreateTab(Cfg2)
        local tName=Cfg2.Name or "Tab"
        local Icon=Cfg2.Icon or "•"
        local Btn = Create("TextButton", {Parent=Left, Size=UDim2.new(1,0,0,32), BackgroundColor3=Theme.Background, BackgroundTransparency=0.5, Text=Icon.." "..tName, TextColor3=Theme.Text2, Font=Enum.Font.GothamMedium, TextSize=12, TextXAlignment=Enum.TextXAlignment.Left}, {
            Create("UIPadding", {PaddingLeft=UDim.new(0,8)}),
            Create("UICorner", {CornerRadius=UDim.new(0,6)}),
        })
        local Content = Create("ScrollingFrame", {Parent=Right, Size=UDim2.fromScale(1,1), BackgroundTransparency=1, Visible=false, ScrollBarThickness=3, ScrollBarImageColor3=Theme.Accent, CanvasSize=UDim2.new(0,0,0,0), AutomaticCanvasSize=Enum.AutomaticSize.Y, BorderSizePixel=0}, {
            Create("UIListLayout", {Padding=UDim.new(0,6), SortOrder=Enum.SortOrder.LayoutOrder}),
            Create("UIPadding", {PaddingTop=UDim.new(0,8), PaddingLeft=UDim.new(0,8), PaddingRight=UDim.new(0,8), PaddingBottom=UDim.new(0,8)}),
        })
        local Tab={}
        Btn.MouseButton1Click:Connect(function()
            for _,t in pairs(Window.Tabs) do t.Content.Visible=false Tween(t.Button,{BackgroundTransparency=0.5, BackgroundColor3=Theme.Background},0.15):Play() t.Button.TextColor3=Theme.Text2 end
            Content.Visible=true Tween(Btn,{BackgroundTransparency=0.1, BackgroundColor3=Theme.Accent},0.15):Play() Btn.TextColor3=Color3.new(1,1,1)
        end)
        
        function Tab:CreateSection(name)
            local f=Create("Frame", {Parent=Content, Size=UDim2.new(1,0,0,20), BackgroundTransparency=1})
            Create("TextLabel", {Parent=f, Size=UDim2.fromScale(1,1), BackgroundTransparency=1, Text=name:upper(), TextColor3=Theme.Text2, Font=Enum.Font.GothamBold, TextSize=10, TextXAlignment=Enum.TextXAlignment.Left})
            return f
        end
        function Tab:CreateButton(Cfg3)
            Cfg3=Cfg3 or {}
            local b=Create("TextButton", {Parent=Content, Size=UDim2.new(1,0,0,34), BackgroundColor3=Theme.Background2, Text=Cfg3.Title or "Button", TextColor3=Theme.Text, Font=Enum.Font.GothamMedium, TextSize=12, AutoButtonColor=false}, {Create("UICorner", {CornerRadius=UDim.new(0,6)}), Create("UIStroke", {Color=Theme.Border, Transparency=0.6})})
            b.MouseEnter:Connect(function() Tween(b,{BackgroundColor3=Theme.Accent},0.15):Play() end)
            b.MouseLeave:Connect(function() Tween(b,{BackgroundColor3=Theme.Background2},0.15):Play() end)
            if Cfg3.Callback then b.MouseButton1Click:Connect(Cfg3.Callback) end
            return {Set=function(_,t) b.Text=t end}
        end
        function Tab:CreateToggle(Cfg3)
            Cfg3=Cfg3 or {}
            local val=Cfg3.Default or false
            local f=Create("Frame", {Parent=Content, Size=UDim2.new(1,0,0,36), BackgroundColor3=Theme.Background2}, {Create("UICorner", {CornerRadius=UDim.new(0,6)}), Create("UIStroke", {Color=Theme.Border, Transparency=0.7})})
            Create("TextLabel", {Parent=f, Position=UDim2.fromOffset(10,0), Size=UDim2.new(1,-60,1,0), BackgroundTransparency=1, Text=Cfg3.Title or "Toggle", TextColor3=Theme.Text, Font=Enum.Font.GothamMedium, TextSize=12, TextXAlignment=Enum.TextXAlignment.Left})
            local sw=Create("Frame", {Parent=f, AnchorPoint=Vector2.new(1,0.5), Position=UDim2.new(1,-10,0.5,0), Size=UDim2.fromOffset(38,20), BackgroundColor3=val and Theme.Accent or Theme.Border}, {Create("UICorner", {CornerRadius=UDim.new(1,0)}), Create("Frame", {Name="Dot", Position=val and UDim2.fromOffset(20,2) or UDim2.fromOffset(2,2), Size=UDim2.fromOffset(16,16), BackgroundColor3=Color3.new(1,1,1)}, {Create("UICorner", {CornerRadius=UDim.new(1,0)})})})
            local function upd(v)
                val=v
                Tween(sw,{BackgroundColor3=v and Theme.Accent or Theme.Border},0.2):Play()
                Tween(sw.Dot,{Position=v and UDim2.fromOffset(20,2) or UDim2.fromOffset(2,2)},0.2):Play()
                if Cfg3.Callback then Cfg3.Callback(v) end
            end
            f.InputBegan:Connect(function(i) if i.UserInputType==Enum.UserInputType.MouseButton1 then upd(not val) end end)
            if val then upd(val) end
            return {Set=function(_,v) upd(v) end, Get=function() return val end}
        end
        function Tab:CreateSlider(Cfg3)
            Cfg3=Cfg3 or {}
            local min=Cfg3.Min or 0
            local max=Cfg3.Max or 100
            local val=Cfg3.Default or min
            local f=Create("Frame", {Parent=Content, Size=UDim2.new(1,0,0,44), BackgroundColor3=Theme.Background2}, {Create("UICorner", {CornerRadius=UDim.new(0,6)})})
            local lbl=Create("TextLabel", {Parent=f, Position=UDim2.fromOffset(10,4), Size=UDim2.new(1,-20,0,16), BackgroundTransparency=1, Text=(Cfg3.Title or "Slider")..": "..val, TextColor3=Theme.Text, Font=Enum.Font.GothamMedium, TextSize=11, TextXAlignment=Enum.TextXAlignment.Left})
            local track=Create("Frame", {Parent=f, Position=UDim2.fromOffset(10,26), Size=UDim2.new(1,-20,0,6), BackgroundColor3=Theme.Border}, {Create("UICorner", {CornerRadius=UDim.new(1,0)}), Create("Frame", {Name="Fill", Size=UDim2.fromScale((val-min)/math.max(1,max-min),1), BackgroundColor3=Theme.Accent}, {Create("UICorner", {CornerRadius=UDim.new(1,0)})})})
            local dragging=false
            local function setFromPos(x)
                local pct=math.clamp((x-track.AbsolutePosition.X)/math.max(1,track.AbsoluteSize.X),0,1)
                val=math.floor(min+pct*(max-min))
                lbl.Text=(Cfg3.Title or "Slider")..": "..val
                track.Fill.Size=UDim2.fromScale(pct,1)
                if Cfg3.Callback then Cfg3.Callback(val) end
            end
            track.InputBegan:Connect(function(i) if i.UserInputType==Enum.UserInputType.MouseButton1 or i.UserInputType==Enum.UserInputType.Touch then dragging=true setFromPos(i.Position.X) end end)
            UIS.InputChanged:Connect(function(i) if dragging and (i.UserInputType==Enum.UserInputType.MouseMovement or i.UserInputType==Enum.UserInputType.Touch) then setFromPos(i.Position.X) end end)
            UIS.InputEnded:Connect(function(i) dragging=false end)
            return {Set=function(_,v) val=v lbl.Text=(Cfg3.Title or "Slider")..": "..v track.Fill.Size=UDim2.fromScale((v-min)/math.max(1,max-min),1) end}
        end
        function Tab:CreateDropdown(Cfg3)
            Cfg3=Cfg3 or {}
            local opts=Cfg3.Options or {"Option 1"}
            local sel=Cfg3.Default or opts[1]
            local f=Create("Frame", {Parent=Content, Size=UDim2.new(1,0,0,34), BackgroundColor3=Theme.Background2, ClipsDescendants=false, ZIndex=2}, {Create("UICorner", {CornerRadius=UDim.new(0,6)}), Create("UIStroke", {Color=Theme.Border, Transparency=0.6})})
            Create("TextLabel", {Parent=f, Position=UDim2.fromOffset(10,0), Size=UDim2.new(0.5,-10,1,0), BackgroundTransparency=1, Text=Cfg3.Title or "Dropdown", TextColor3=Theme.Text, Font=Enum.Font.GothamMedium, TextSize=12, TextXAlignment=Enum.TextXAlignment.Left})
            local selLbl=Create("TextLabel", {Parent=f, AnchorPoint=Vector2.new(1,0), Position=UDim2.new(1,-30,0,0), Size=UDim2.new(0,80,1,0), BackgroundTransparency=1, Text=sel, TextColor3=Theme.Text2, Font=Enum.Font.Gotham, TextSize=11, TextXAlignment=Enum.TextXAlignment.Right, TextTruncate=Enum.TextTruncate.AtEnd})
            Create("TextLabel", {Parent=f, AnchorPoint=Vector2.new(1,0.5), Position=UDim2.new(1,-8,0.5,0), Size=UDim2.fromOffset(16,16), BackgroundTransparency=1, Text="▼", TextColor3=Theme.Text2, Font=Enum.Font.Gotham, TextSize=10})
            local list=Create("Frame", {Parent=f, Position=UDim2.fromOffset(0,38), Size=UDim2.new(1,0,0,0), BackgroundColor3=Theme.Background2, Visible=false, ClipsDescendants=true, ZIndex=10}, {Create("UICorner", {CornerRadius=UDim.new(0,6)}), Create("UIListLayout", {Padding=UDim.new(0,2)}), Create("UIPadding", {PaddingAll=UDim.new(0,4)}), Create("UIStroke", {Color=Theme.Border})})
            for _,opt in ipairs(opts) do
                local ob=Create("TextButton", {Parent=list, Size=UDim2.new(1,0,0,26), BackgroundColor3=Theme.Background, Text=opt, TextColor3=Theme.Text, Font=Enum.Font.Gotham, TextSize=11}, {Create("UICorner", {CornerRadius=UDim.new(0,4)})})
                ob.MouseButton1Click:Connect(function() sel=opt selLbl.Text=opt list.Visible=false list.Size=UDim2.new(1,0,0,0) if Cfg3.Callback then Cfg3.Callback(opt) end end)
            end
            local open=false
            f.InputBegan:Connect(function(i) if i.UserInputType==Enum.UserInputType.MouseButton1 then open=not open list.Visible=open Tween(list,{Size=open and UDim2.new(1,0,0,#opts*28+8) or UDim2.new(1,0,0,0)},0.2):Play() if not open then task.delay(0.2,function() if not open then list.Visible=false end end) end end end)
            return {}
        end
        function Tab:CreateInput(Cfg3)
            Cfg3=Cfg3 or {}
            local f=Create("Frame", {Parent=Content, Size=UDim2.new(1,0,0,34), BackgroundColor3=Theme.Background2}, {Create("UICorner", {CornerRadius=UDim.new(0,6)}), Create("UIStroke", {Color=Theme.Border, Transparency=0.6})})
            local box=Create("TextBox", {Parent=f, Size=UDim2.fromScale(1,1), BackgroundTransparency=1, PlaceholderText=Cfg3.Placeholder or Cfg3.Title or "...", Text=Cfg3.Default or "", TextColor3=Theme.Text, PlaceholderColor3=Theme.Text2, Font=Enum.Font.Gotham, TextSize=12, ClearTextOnFocus=false}, {Create("UIPadding", {PaddingLeft=UDim.new(0,10), PaddingRight=UDim.new(0,10)})})
            box.FocusLost:Connect(function() if Cfg3.Callback then Cfg3.Callback(box.Text) end end)
            return {}
        end
        function Tab:CreateParagraph(Cfg3)
            Cfg3=Cfg3 or {}
            local f=Create("Frame", {Parent=Content, Size=UDim2.new(1,0,0,50), BackgroundColor3=Theme.Background2, BackgroundTransparency=0.5}, {Create("UICorner", {CornerRadius=UDim.new(0,6)}), Create("UIPadding", {PaddingAll=UDim.new(0,8)})})
            Create("TextLabel", {Parent=f, Size=UDim2.new(1,0,0,14), BackgroundTransparency=1, Text=Cfg3.Title or "Info", TextColor3=Theme.Text, Font=Enum.Font.GothamBold, TextSize=11, TextXAlignment=Enum.TextXAlignment.Left})
            Create("TextLabel", {Parent=f, Position=UDim2.fromOffset(0,16), Size=UDim2.new(1,0,1,-16), BackgroundTransparency=1, Text=Cfg3.Content or "", TextColor3=Theme.Text2, Font=Enum.Font.Gotham, TextSize=11, TextWrapped=true, TextXAlignment=Enum.TextXAlignment.Left, TextYAlignment=Enum.TextYAlignment.Top})
            return f
        end
        
        Tab.Button=Btn Tab.Content=Content
        table.insert(Window.Tabs, Tab)
        if #Window.Tabs==1 then Content.Visible=true Btn.BackgroundTransparency=0.1 Btn.BackgroundColor3=Theme.Accent Btn.TextColor3=Color3.new(1,1,1) end
        return Tab
    end
    
    -- انيميشن دخول صغير
    Main.Size=UDim2.fromOffset(0,0)
    Tween(Main,{Size=Size},0.35,Enum.EasingStyle.Back):Play()
    return Window
end

function NovaUI:Notify(Cfg)
    Cfg=Cfg or {}
    local sg = game:GetService("CoreGui"):FindFirstChild("NovaUI") or game.Players.LocalPlayer.PlayerGui:FindFirstChild("NovaUI") or Instance.new("ScreenGui", game:GetService("CoreGui"))
    local f=Create("Frame", {Parent=sg, AnchorPoint=Vector2.new(1,1), Position=UDim2.new(1,20,1,-20), Size=UDim2.fromOffset(260,50), BackgroundColor3=NovaUI.CurrentTheme.Background2}, {Create("UICorner", {CornerRadius=UDim.new(0,8)}), Create("UIStroke", {Color=NovaUI.CurrentTheme.Border})})
    Create("TextLabel", {Parent=f, Position=UDim2.fromOffset(10,6), Size=UDim2.new(1,-20,0,16), BackgroundTransparency=1, Text=Cfg.Title or "Nova", TextColor3=NovaUI.CurrentTheme.Text, Font=Enum.Font.GothamBold, TextSize=12, TextXAlignment=Enum.TextXAlignment.Left})
    Create("TextLabel", {Parent=f, Position=UDim2.fromOffset(10,22), Size=UDim2.new(1,-20,0,22), BackgroundTransparency=1, Text=Cfg.Content or "", TextColor3=NovaUI.CurrentTheme.Text2, Font=Enum.Font.Gotham, TextSize=11, TextWrapped=true, TextXAlignment=Enum.TextXAlignment.Left})
    Tween(f,{Position=UDim2.new(1,-12,1,-20)},0.3):Play()
    task.delay(Cfg.Duration or 2.5, function() Tween(f,{Position=UDim2.new(1,20,1,-20)},0.3):Play() task.wait(0.3) f:Destroy() end)
end

return NovaUI
