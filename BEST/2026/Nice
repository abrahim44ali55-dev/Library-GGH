        Util.Padding(container, 12,8,12,8)

        local top = Util.Create("Frame", {Size=UDim2.new(1,0,0,18), BackgroundTransparency=1, Parent=container})
        local label = Util.Create("TextLabel", {
            Text = opts.Name or "Slider",
