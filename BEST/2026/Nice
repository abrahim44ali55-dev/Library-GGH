-- Advanced Color Utilities
local ColorUtils = {}
function ColorUtils:RGBToHex(color)
    return string.format("#%02X%02X%02X", math.floor(color.R*255), math.floor(color.G*255), math.floor(color.B*255))
end
function ColorUtils:HexToRGB(hex)
    hex = hex:gsub("#","")
    local r = tonumber("0x"..hex:sub(1,2))
    local g = tonumber("0x"..hex:sub(3,4))
    local b = tonumber("0x"..hex:sub(5,6))
    return Color3.fromRGB(r,g,b)
end
function ColorUtils:Complementary(color)
    local h,s,v = Color3.toHSV(color)
    return Color3.fromHSV((h+0.5)%1, s, v)
end
function ColorUtils:Triadic(color)
    local h,s,v = Color3.toHSV(color)
    return {
        Color3.fromHSV(h, s, v),
        Color3.fromHSV((h+0.33)%1, s, v),
        Color3.fromHSV((h+0.66)%1, s, v),
    }
end
function ColorUtils:Analogous(color)
    local h,s,v = Color3.toHSV(color)
    return {
        Color3.fromHSV((h-0.08)%1, s, v),
        color,
        Color3.fromHSV((h+0.08)%1, s, v),
    }
end

