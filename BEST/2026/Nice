-- CONFIG SYSTEM
-- ============================================================================
local ConfigSystem = {}
ConfigSystem.Profiles = {}
ConfigSystem.Current = {}

function ConfigSystem.Save(key: string, data: any)
    ConfigSystem.Current[key] = data
    -- In real executor, writefile support. Here we keep in memory + try writefile
    pcall(function()
        if writefile then
            writefile("GGHLib_"..key..".json", HttpService:JSONEncode(ConfigSystem.Current))
        end
    end)
end

function ConfigSystem.Load(key: string): any
    local success, result = pcall(function()
        if isfile and isfile("GGHLib_"..key..".json") then
            return HttpService:JSONDecode(readfile("GGHLib_"..key..".json"))
        end
        return nil
    end)
    if success and result then
        ConfigSystem.Current = result
        return result[key]
    end
    return ConfigSystem.Current[key]
end

function ConfigSystem.Export(): string
    return HttpService:JSONEncode(ConfigSystem.Current)
end

function ConfigSystem.Import(json: string)
    local ok, data = pcall(HttpService.JSONDecode, HttpService, json)
    if ok and typeof(data) == "table" then
        ConfigSystem.Current = data
    end
end

