        Font = Enum.Font.Gotham,
        TextSize = 13,
        TextColor3 = th.Text,
        BackgroundTransparency = 1,
        Size = UDim2.new(1, -70, 1, 0),
        Position = UDim2.fromOffset(12,0),
        TextXAlignment = Enum.TextXAlignment.Left,
        TextWrapped = true,
        Parent = frame
    })
    label.AutoLocalize = false

    local track = Util:Create("Frame", {
        BackgroundColor3 = th.Sec,
        Size = UDim2.fromOffset(48, 26),
        Position = UDim2.new(1, -60, 0.5, -13),
        Parent = frame
    })
    Util:Corner(track, 13)

    local thumb = Util:Create("Frame", {
        BackgroundColor3 = Color3.fromRGB(255,255,255),
        Size = UDim2.fromOffset(20,20),
        Position = UDim2.fromOffset(3,3),
        Parent = track
    })
    Util:Corner(thumb, 10)

    local state = options.Default or false

    local function ApplyState(value, instant)
        state = value
        local targetPos = value and UDim2.fromOffset(25,3) or UDim2.fromOffset(3,3)
        local targetColor = value and th.Accent or th.Sec

        if instant then
            thumb.Position = targetPos
            track.BackgroundColor3 = targetColor
        else
            -- Optimized: single tween, no lag
            TweenService:Create(thumb, TweenInfo.new(0.18, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {Position = targetPos}):Play()
            TweenService:Create(track, TweenInfo.new(0.18, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {BackgroundColor3 = targetColor}):Play()
        end

        if options.Callback then
            task.spawn(options.Callback, value)
        end
    end

    ApplyState(state, true)

    local clickArea = Util:Create("TextButton", {
        Text = "",
        BackgroundTransparency = 1,
        Size = UDim2.fromScale(1,1),
        ZIndex = 2,
        Parent = frame
    })

    clickArea.MouseButton1Click:Connect(function()
        th = Theme.Current
        ApplyState(not state, false)
    end)

    Theme:OnChanged(function(newTheme)
        th = newTheme
        frame.BackgroundColor3 = newTheme.Panel
        label.TextColor3 = newTheme.Text
        border.Color = newTheme.Border
        track.BackgroundColor3 = state and newTheme.Accent or newTheme.Sec
    end)

    return {
        Instance = frame,
        Set = function(_, value) ApplyState(value, false) end,
        Get = function() return state end
    }
end

local function CreateSliderElement(parent, options)
    local th = Theme.Current

    local frame = Util:Create("Frame", {
        BackgroundColor3 = th.Panel,
        Size = UDim2.new(1,0,0,60),
        Parent = parent
    })
    Util:Corner(frame, 10)
    local border = Util:Stroke(frame, th.Border, 1, 0.35)

    local label = Util:Create("TextLabel", {
        Text = (options.Name or "Slider") .. " : " .. tostring(options.Default or options.Min or 0),
        Font = Enum.Font.Gotham,
        TextSize = 12,
        TextColor3 = th.Text,
        BackgroundTransparency = 1,
        Size = UDim2.new(1,0,0,20),
        Position = UDim2.fromOffset(12,8),
        TextXAlignment = Enum.TextXAlignment.Left,
        TextWrapped = true,
        Parent = frame
    })
    label.AutoLocalize = false

    local track = Util:Create("Frame", {
        BackgroundColor3 = th.Sec,
        Size = UDim2.new(1, -24, 0, 6),
        Position = UDim2.new(0,12,0,34),
        Parent = frame
    })
    Util:Corner(track, 3)

    local fill = Util:Create("Frame", {
        BackgroundColor3 = th.Accent,
        Size = UDim2.new(0,0,1,0),
        Parent = track
    })
    Util:Corner(fill, 3)

    local knob = Util:Create("Frame", {
        BackgroundColor3 = Color3.fromRGB(255,255,255),
        Size = UDim2.fromOffset(16,16),
        AnchorPoint = Vector2.new(0.5,0.5),
        Position = UDim2.new(0,0,0.5,0),
        Parent = track
    })
    Util:Corner(knob, 8)
    local knobStroke = Util:Stroke(knob, th.Accent, 2, 0)

    local minVal = options.Min or 0
    local maxVal = options.Max or 100
    local currentVal = options.Default or minVal
    local dragging = false

    local function SetPercentage(pct, noCallback)
        pct = math.clamp(pct, 0, 1)
        currentVal = math.floor(minVal + (maxVal - minVal) * pct + 0.5)
        fill.Size = UDim2.new(pct,0,1,0)
        knob.Position = UDim2.new(pct,0,0.5,0)
        label.Text = (options.Name or "Slider") .. " : " .. tostring(currentVal)
        if not noCallback and options.Callback then
            task.spawn(options.Callback, currentVal)
        end
    end

    local function UpdateFromPosition(xPos)
        local pct = (xPos - track.AbsolutePosition.X) / track.AbsoluteSize.X
        SetPercentage(pct, false)
    end

    track.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            UpdateFromPosition(input.Position.X)
        end
    end)

    -- Single global listener for performance (no stutter)
    UserInputService.InputChanged:Connect(function(input)
        if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
            UpdateFromPosition(input.Position.X)
        end
    end)

    UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = false
        end
    end)

    SetPercentage((currentVal - minVal) / (maxVal - minVal), true)

    Theme:OnChanged(function(newTheme)
        frame.BackgroundColor3 = newTheme.Panel
        track.BackgroundColor3 = newTheme.Sec
        fill.BackgroundColor3 = newTheme.Accent
        label.TextColor3 = newTheme.Text
        border.Color = newTheme.Border
        knobStroke.Color = newTheme.Accent
    end)

    return {
        Instance = frame,
        Set = function(_, value)
            SetPercentage((value - minVal) / (maxVal - minVal), false)
        end
    }
end

