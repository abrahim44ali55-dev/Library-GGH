function NiceLib:CreateSliderWithInput(parent, cfg)
    cfg = cfg or {}
    local sMin = cfg.Min or 0
    local sMax = cfg.Max or 100
    local sVal = cfg.Default or sMin
    local frame = Create("Frame", {Size=UDim2.new(1,0,0,56), BackgroundColor3=Theme.Element, Parent=parent}, {AddCorner(10), AddPadding(10,10,10,10)})
    local top = Create("Frame", {Size=UDim2.new(1,0,0,18), BackgroundTransparency=1, Parent=frame})
    Create("TextLabel", {Text=cfg.Title or "Slider", Font=Enum.Font.GothamMedium, TextSize=12, TextColor3=Theme.Text, Size=UDim2.new(0.5,0,1,0), BackgroundTransparency=1, TextXAlignment=Left, Parent=top})
    local inputBox = Create("TextBox", {Size=UDim2.new(0,60,0,18), Position=UDim2.new(1,-60,0,0), BackgroundColor3=Theme.Secondary, Text=tostring(sVal), Font=Enum.Font.GothamBold, TextSize=11, TextColor3=Theme.Accent, Parent=top}, {AddCorner(4)})
    local track = Create("Frame", {Size=UDim2.new(1,0,0,6), Position=UDim2.new(0,0,0,28), BackgroundColor3=Theme.Secondary, Parent=frame}, {AddCorner(3)})
    local fill = Create("Frame", {Size=UDim2.new((sVal-sMin)/(sMax-sMin),0,1,0), BackgroundColor3=Theme.Accent, Parent=track}, {AddCorner(3)})
    local thumb = Create("Frame", {Size=UDim2.new(0,14,0,14), Position=UDim2.new((sVal-sMin)/(sMax-sMin),-7,0.5,-7), BackgroundColor3=Color3.new(1,1,1), Parent=track}, {AddCorner(7), AddStroke(Theme.Accent,2,0)})
    local dragging = false
    local function updateFromX(x)
        local pct = math.clamp((x - track.AbsolutePosition.X)/track.AbsoluteSize.X,0,1)
        local val = math.floor(sMin + (sMax-sMin)*pct)
        sVal = val
        inputBox.Text = tostring(val)
        fill.Size = UDim2.new(pct,0,1,0)
        thumb.Position = UDim2.new(pct,-7,0.5,-7)
        if cfg.Callback then pcall(cfg.Callback, val) end
    end
    track.InputBegan:Connect(function(input) if input.UserInputType==Enum.UserInputType.MouseButton1 then dragging=true; updateFromX(input.Position.X) end end)
    UserInputService.InputEnded:Connect(function(input) if input.UserInputType==Enum.UserInputType.MouseButton1 then dragging=false end end)
    UserInputService.InputChanged:Connect(function(input) if dragging and input.UserInputType==Enum.UserInputType.MouseMovement then updateFromX(input.Position.X) end end)
    inputBox.FocusLost:Connect(function()
        local num = tonumber(inputBox.Text)
        if num then
            num = math.clamp(num, sMin, sMax)
            sVal = num
            local pct = (num-sMin)/(sMax-sMin)
            fill.Size = UDim2.new(pct,0,1,0)
            thumb.Position = UDim2.new(pct,-7,0.5,-7)
            if cfg.Callback then pcall(cfg.Callback, num) end
        end
    end)
    return frame
end

