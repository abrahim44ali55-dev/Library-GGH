            local ChooseCorner = Instance.new("UICorner")
            ChooseCorner.CornerRadius = UDim.new(0, 6)
            ChooseCorner.Parent = Choose

            local Title = Instance.new("TextLabel")
            Title.Name = "Title"
            Title.Parent = Choose
            Title.BackgroundTransparency = 1.000
            Title.Position = UDim2.new(0, 10, 0, 0)
            Title.Size = UDim2.new(1, -35, 1, 0)
            Title.Font = Enum.Font.Gotham
            Title.Text = text or "Dropdown"
            Title.TextColor3 = Library.Themes[Library.CurrentTheme].TextColor
            Title.TextSize = 13.000
            Title.TextXAlignment = Enum.TextXAlignment.Left

            local Arrow = Instance.new("ImageButton")
            Arrow.Name = "Arrow"
            Arrow.Parent = Choose
            Arrow.AnchorPoint = Vector2.new(1, 0.5)
            Arrow.BackgroundTransparency = 1.000
            Arrow.Position = UDim2.new(1, -4, 0.5, 0)
            Arrow.Size = UDim2.new(0, 24, 0, 24)
            Arrow.Image = "rbxassetid://3926307971"
            Arrow.ImageColor3 = Library.Themes[Library.CurrentTheme].Accent
            Arrow.ImageRectOffset = Vector2.new(324, 524)
            Arrow.ImageRectSize = Vector2.new(36, 36)

            local OptionHolder = Instance.new("Frame")
            OptionHolder.Name = "OptionHolder"
            OptionHolder.Parent = Dropdown
            OptionHolder.BackgroundColor3 = Library.Themes[Library.CurrentTheme].ElementBg
            OptionHolder.BorderSizePixel = 0
            OptionHolder.Size = UDim2.new(1, 0, 0, 0)

            local OptionHolderCorner = Instance.new("UICorner")
            OptionHolderCorner.CornerRadius = UDim.new(0, 6)
            OptionHolderCorner.Parent = OptionHolder

            local OptionList = Instance.new("UIListLayout")
            OptionList.Parent = OptionHolder
            OptionList.HorizontalAlignment = Enum.HorizontalAlignment.Center
            OptionList.SortOrder = Enum.SortOrder.LayoutOrder
            OptionList.Padding = UDim.new(0, 4)

            local OptionPadding = Instance.new("UIPadding")
            OptionPadding.Parent = OptionHolder
            OptionPadding.PaddingTop = UDim.new(0, 6)
            OptionPadding.PaddingBottom = UDim.new(0, 6)

            local dropped = false
            local selected = {}

            local function updateTitle()
                if multiSelect then
                    local selectedList = {}
                    for item, _ in pairs(selected) do table.insert(selectedList, item) end
                    if #selectedList > 0 then
                        Title.Text = text .. ": " .. table.concat(selectedList, ", ")
                    else
                        Title.Text = text
                    end
                end
            end

            local function CreateOptions(opts)
                for _, child in ipairs(OptionHolder:GetChildren()) do
                    if child:IsA("TextButton") then child:Destroy() end
                end

                for _, option in ipairs(opts) do
                    local Option = Instance.new("TextButton")
                    Option.Name = "Option"
                    Option.Parent = OptionHolder
                    Option.BackgroundColor3 = Library.Themes[Library.CurrentTheme].Accent
                    Option.BorderSizePixel = 0
                    Option.Size = UDim2.new(1, -12, 0, 28)
                    Option.AutoButtonColor = false
                    Option.Font = Enum.Font.Gotham
                    Option.Text = option
                    Option.TextColor3 = Library.Themes[Library.CurrentTheme].TextColor
                    Option.TextSize = 13.000

                    local OptionCorner = Instance.new("UICorner")
                    OptionCorner.CornerRadius = UDim.new(0, 5)
                    OptionCorner.Parent = Option

                    Option.MouseButton1Click:Connect(function()
                        if multiSelect then
                            if selected[option] then
                                selected[option] = nil
                            else
                                selected[option] = true
                            end
                            updateTitle()
                            local selectedList = {}
                            for item, _ in pairs(selected) do table.insert(selectedList, item) end
                            callback(selectedList)
                        else
                            callback(option)
                            Title.Text = text .. ": " .. option
                            dropped = false
                            TweenService:Create(Arrow, TweenInfo.new(.15), {Rotation = 0}):Play()
                            Dropdown:TweenSize(UDim2.new(1, -6, 0, 34), Enum.EasingDirection.Out, Enum.EasingStyle.Quart, .15, true)
                        end
                    end)
                end
            end

            CreateOptions(options)

            OptionList:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
                if dropped then
                    OptionHolder.Size = UDim2.new(1, 0, 0, OptionList.AbsoluteContentSize.Y + 12)
                    Dropdown.Size = UDim2.new(1, -6, 0, 34 + OptionList.AbsoluteContentSize.Y + 12)
                end
            end)

            Choose.InputBegan:Connect(function(input)
                if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                    dropped = not dropped
                    if dropped then
                        Dropdown:TweenSize(UDim2.new(1, -6, 0, 34 + OptionList.AbsoluteContentSize.Y + 12), Enum.EasingDirection.Out, Enum.EasingStyle.Quad, .15, true)
                        TweenService:Create(Arrow, TweenInfo.new(.15), {Rotation = 180}):Play()
                    else
                        TweenService:Create(Arrow, TweenInfo.new(.15), {Rotation = 0}):Play()
                        Dropdown:TweenSize(UDim2.new(1, -6, 0, 34), Enum.EasingDirection.Out, Enum.EasingStyle.Quad, .15, true)
                    end
                end
            end)

            table.insert(Library.Registry, {Type = "Dropdown", Frame = Dropdown, Choose = Choose, Title = Title, Arrow = Arrow, Holder = OptionHolder})

            local DropdownFunctions = {}
            function DropdownFunctions:Refresh(newOptions)
                selected = {}
                dropped = false
                Title.Text = text
                TweenService:Create(Arrow, TweenInfo.new(.15), {Rotation = 0}):Play()
                Dropdown:TweenSize(UDim2.new(1, -6, 0, 34), Enum.EasingDirection.Out, Enum.EasingStyle.Quart, .15, true)
                CreateOptions(newOptions or {})
            end
            return DropdownFunctions
        end

        return Elements
    end

    return TabFunctions
end

