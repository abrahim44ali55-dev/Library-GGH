        end

        state:Subscribe(update)
        local btn = Util.Create("TextButton", {Text="", BackgroundTransparency=1, Size=UDim2.new(1,0,1,0), Parent=container})
        btn.MouseButton1Click:Connect(function() state:Set(not state:Get()) end)
