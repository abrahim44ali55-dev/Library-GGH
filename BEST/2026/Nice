local function BuildWindowV5(screenGui, options)
    local th=Theme.Current
    local viewport=workspace.CurrentCamera.ViewportSize
    local isMobile=viewport.X<700

    local defaultWidth=options.Size and options.Size.X.Offset or 560
    local defaultHeight=options.Size and options.Size.Y.Offset or 340
    -- Allow custom default height
    if options.Height then defaultHeight=options.Height end
    if options.DefaultHeight then defaultHeight=options.DefaultHeight end

    local winW=isMobile and math.min(viewport.X-20, defaultWidth) or defaultWidth
    local winH=isMobile and math.min(viewport.Y-100, defaultHeight) or defaultHeight

    local main=Util:Create("Frame",{Name="GGH_Window",BackgroundColor3=th.Bg,BackgroundTransparency=th.Transparency or 0,BorderSizePixel=0,Size=UDim2.fromOffset(winW,winH),Position=UDim2.new(0.5,-winW/2,0.5,-winH/2),ClipsDescendants=false,ZIndex=2,Parent=screenGui})
    Util:Corner(main,16)
    local mainBorder=Util:Stroke(main,th.Border,1,0.18)
    local glow=Util:Stroke(main,th.Accent,10,0.88)

    -- Background Image or Gradient
    if th.Gradient then
        local grad=Util:Create("UIGradient",{Color=th.Gradient,Parent=main})
    end
    if th.ImageId then
        local bgImg=Util:Create("ImageLabel",{Image=th.ImageId,BackgroundTransparency=1,Size=UDim2.fromScale(1,1),ImageTransparency=0.7,ZIndex=0,Parent=main})
        Util:Corner(bgImg,16)
    end

    -- Transparency control
    if options.Transparency then
        main.BackgroundTransparency=options.Transparency
    end

    local topBar=Util:Create("Frame",{Name="TopBar",BackgroundColor3=th.Panel,BackgroundTransparency=th.Transparency or 0,Size=UDim2.new(1,0,0,42),BorderSizePixel=0,ZIndex=3,Parent=main})
    Util:Corner(topBar,16)
    Util:Create("Frame",{BackgroundColor3=th.Panel,BackgroundTransparency=th.Transparency or 0,Size=UDim2.new(1,0,0,10),Position=UDim2.new(0,0,1,-10),BorderSizePixel=0,ZIndex=3,Parent=topBar})

    local titleLbl=Util:Create("TextLabel",{Text=options.Title or "GGH Lib",Font=Enum.Font.GothamBold,TextSize=14,TextColor3=th.Text,BackgroundTransparency=1,Size=UDim2.new(1,-90,1,0),Position=UDim2.fromOffset(14,0),TextXAlignment=Enum.TextXAlignment.Left,TextTruncate=Enum.TextTruncate.AtEnd,Parent=topBar}); titleLbl.AutoLocalize=false

    local btnHolder=Util:Create("Frame",{BackgroundTransparency=1,Size=UDim2.fromOffset(70,30),Position=UDim2.new(1,-78,0,6),ZIndex=4,Parent=topBar})
    Util:List(btnHolder,Enum.FillDirection.Horizontal,6)

    local minBtn=Util:Create("TextButton",{Text="-",Font=Enum.Font.GothamBold,TextSize=16,TextColor3=th.Sub,BackgroundColor3=th.Sec,Size=UDim2.fromOffset(30,30),AutoButtonColor=false,ZIndex=4,Parent=btnHolder}); Util:Corner(minBtn,8); minBtn.AutoLocalize=false
    local closeBtn=Util:Create("TextButton",{Text="X",Font=Enum.Font.GothamBold,TextSize=12,TextColor3=Color3.fromRGB(255,95,95),BackgroundColor3=th.Sec,Size=UDim2.fromOffset(30,30),AutoButtonColor=false,ZIndex=4,Parent=btnHolder}); Util:Corner(closeBtn,8); closeBtn.AutoLocalize=false

    local content=Util:Create("Frame",{Name="Content",BackgroundTransparency=1,Size=UDim2.new(1,0,1,-42),Position=UDim2.fromOffset(0,42),ClipsDescendants=true,ZIndex=3,Parent=main})

    local tabBar=Util:Create("ScrollingFrame",{Name="TabBar",BackgroundColor3=th.Panel,BackgroundTransparency=0.25,Size=UDim2.new(0,140,1,0),ScrollBarThickness=2,CanvasSize=UDim2.new(0,0,0,0),AutomaticCanvasSize=Enum.AutomaticSize.Y,BorderSizePixel=0,ZIndex=3,Parent=content,ScrollingDirection=Enum.ScrollingDirection.Y})
    Util:List(tabBar,Enum.FillDirection.Vertical,6); Util:Padding(tabBar,{8,8,8,50})

    local tabContent=Util:Create("Frame",{Name="TabContent",BackgroundTransparency=1,Size=UDim2.new(1,-140,1,0),Position=UDim2.new(0,140,0,0),ZIndex=3,Parent=content})

    local resize=Util:Create("Frame",{Name="ResizeHandle",BackgroundTransparency=1,AnchorPoint=Vector2.new(1,1),Position=UDim2.new(1,0,1,0),Size=UDim2.fromOffset(20,20),ZIndex=10,Parent=main})
    Util:Create("TextLabel",{Text="o",Font=Enum.Font.Gotham,TextSize=12,TextColor3=th.Sub,BackgroundTransparency=1,Size=UDim2.fromScale(1,1),Parent=resize}).AutoLocalize=false

    local floatBar=Util:Create("Frame",{Name="FloatingBar",BackgroundColor3=th.Panel,Size=UDim2.fromOffset(200,40),Position=UDim2.new(0.5,-100,0,16),Visible=false,ZIndex=50,Parent=screenGui})
    Util:Corner(floatBar,20); Util:Stroke(floatBar,th.Border,1,0.12)

    local dragBtn=Util:Create("TextButton",{Text="=",Font=Enum.Font.GothamBold,TextSize=16,TextColor3=th.Sub,BackgroundColor3=th.Sec,Size=UDim2.fromOffset(32,32),Position=UDim2.fromOffset(4,4),AutoButtonColor=false,Parent=floatBar}); Util:Corner(dragBtn,16); dragBtn.AutoLocalize=false
    local floatLbl=Util:Create("TextLabel",{Text="GGH Lib",Font=Enum.Font.GothamBold,TextSize=12,TextColor3=th.Text,BackgroundTransparency=1,Size=UDim2.new(1,-80,1,0),Position=UDim2.fromOffset(42,0),TextXAlignment=Enum.TextXAlignment.Left,Parent=floatBar}); floatLbl.AutoLocalize=false
    local restoreBtn=Util:Create("TextButton",{Text="+",Font=Enum.Font.GothamBold,TextSize=16,TextColor3=th.Accent,BackgroundColor3=th.Bg,Size=UDim2.fromOffset(32,32),Position=UDim2.new(1,-36,0,4),AutoButtonColor=false,Parent=floatBar}); Util:Corner(restoreBtn,16); restoreBtn.AutoLocalize=false

    -- Save size
    local savedSize=UDim2.fromOffset(winW,winH)

    -- Drag
    local dragging, dragStart, startPos, dragInput
    topBar.InputBegan:Connect(function(input) if input.UserInputType==Enum.UserInputType.MouseButton1 or input.UserInputType==Enum.UserInputType.Touch then dragging=true; dragStart=input.Position; startPos=main.Position end end)
    topBar.InputChanged:Connect(function(input) if input.UserInputType==Enum.UserInputType.MouseMovement or input.UserInputType==Enum.UserInputType.Touch then dragInput=input end end)
    UserInputService.InputChanged:Connect(function(input) if input==dragInput and dragging then local d=input.Position-dragStart; main.Position=UDim2.new(startPos.X.Scale,startPos.X.Offset+d.X,startPos.Y.Scale,startPos.Y.Offset+d.Y) end end)
    UserInputService.InputEnded:Connect(function(input) if input.UserInputType==Enum.UserInputType.MouseButton1 or input.UserInputType==Enum.UserInputType.Touch then dragging=false end end)

    -- Resize
    local resizing, rStart, rSize, rInput
    resize.InputBegan:Connect(function(input) if input.UserInputType==Enum.UserInputType.MouseButton1 or input.UserInputType==Enum.UserInputType.Touch then resizing=true; rStart=input.Position; rSize=Vector2.new(main.AbsoluteSize.X, main.AbsoluteSize.Y) end end)
    resize.InputChanged:Connect(function(input) if input.UserInputType==Enum.UserInputType.MouseMovement or input.UserInputType==Enum.UserInputType.Touch then rInput=input end end)
    UserInputService.InputChanged:Connect(function(input) if input==rInput and resizing then local d=input.Position-rStart; local vp=workspace.CurrentCamera.ViewportSize; local newW=math.clamp(rSize.X+d.X, 340, math.min(vp.X-20, 800)); local newH=math.clamp(rSize.Y+d.Y, 220, math.min(vp.Y-20, 650)); main.Size=UDim2.fromOffset(newW,newH); savedSize=main.Size end end)
    UserInputService.InputEnded:Connect(function() resizing=false end)

    -- Split Collect Animation: Tabs -> dragBtn, Elements -> restoreBtn, Window -> square
    local function MinimizeSplit()
        savedSize=main.Size
        local elements={}
        local tabs={}

        for _,page in ipairs(tabContent:GetChildren()) do
            if page:IsA("ScrollingFrame") then
                for _,child in ipairs(page:GetChildren()) do
                    if child:IsA("GuiObject") and child.Visible and child.Size.Y.Offset>5 and child.Name~="UIListLayout" and child.Name~="UIPadding" then
                        table.insert(elements, child)
                        child:SetAttribute("OrigSize", child.Size)
                    end
                end
            end
        end

        for _,child in ipairs(tabBar:GetChildren()) do
            if child:IsA("TextButton") then
                table.insert(tabs, child)
                child:SetAttribute("OrigSize", child.Size)
            end
        end

        -- Elements to restoreBtn
        for i,el in ipairs(elements) do
            task.delay((i-1)*0.01, function()
                if el and el.Parent then
                    TweenService:Create(el,TweenInfo.new(0.2,Enum.EasingStyle.Back,Enum.EasingDirection.In),{Size=UDim2.fromOffset(0,0)}):Play()
                end
            end)
        end

        -- Tabs to dragBtn
        for i,el in ipairs(tabs) do
            task.delay((i-1)*0.015, function()
                if el and el.Parent then
                    TweenService:Create(el,TweenInfo.new(0.2,Enum.EasingStyle.Back,Enum.EasingDirection.In),{Size=UDim2.fromOffset(0,0)}):Play()
                end
            end)
        end

        task.wait(math.max(#elements, #tabs)*0.015 + 0.2)

        -- Window to square
        TweenService:Create(main,TweenInfo.new(0.32,Enum.EasingStyle.Back,Enum.EasingDirection.In),{Size=UDim2.fromOffset(0,0),Position=UDim2.new(floatBar.Position.X.Scale,floatBar.Position.X.Offset+100,floatBar.Position.Y.Scale,floatBar.Position.Y.Offset+20)}):Play()
        task.wait(0.32)
        main.Visible=false
        floatBar.Visible=true
        floatBar.Size=UDim2.fromOffset(0,40)
        TweenService:Create(floatBar,TweenInfo.new(0.4,Enum.EasingStyle.Back,Enum.EasingDirection.Out),{Size=UDim2.fromOffset(200,40)}):Play()
    end

    local function RestoreSplit()
        floatBar.Visible=false
        main.Visible=true
        main.Size=UDim2.fromOffset(0,0)
        main.Position=UDim2.new(0.5,-savedSize.X.Offset/2,0.5,-savedSize.Y.Offset/2)
        TweenService:Create(main,TweenInfo.new(0.42,Enum.EasingStyle.Back,Enum.EasingDirection.Out),{Size=savedSize}):Play()
        task.wait(0.35)

        for _,page in ipairs(tabContent:GetChildren()) do
            if page:IsA("ScrollingFrame") then
                for _,child in ipairs(page:GetChildren()) do
                    if child:GetAttribute("OrigSize") then
                        local orig=child:GetAttribute("OrigSize")
                        child.Size=UDim2.fromOffset(0,0)
                        task.delay(math.random()*0.06, function()
                            if child and child.Parent then
                                TweenService:Create(child,TweenInfo.new(0.3,Enum.EasingStyle.Back,Enum.EasingDirection.Out),{Size=orig}):Play()
                            end
                        end)
                    end
                end
            end
        end

        for _,child in ipairs(tabBar:GetChildren()) do
            if child:GetAttribute("OrigSize") then
                local orig=child:GetAttribute("OrigSize")
                child.Size=UDim2.fromOffset(0,0)
                task.delay(math.random()*0.06, function()
                    if child and child.Parent then
                        TweenService:Create(child,TweenInfo.new(0.3,Enum.EasingStyle.Back,Enum.EasingDirection.Out),{Size=orig}):Play()
                    end
                end)
            end
        end
    end

    minBtn.MouseButton1Click:Connect(function() task.spawn(MinimizeSplit) end)
    restoreBtn.MouseButton1Click:Connect(function() task.spawn(RestoreSplit) end)
    closeBtn.MouseButton1Click:Connect(function() ShowConfirm(screenGui, function() screenGui:Destroy() end) end)

    Util:MakeDraggable(dragBtn,floatBar)
    Util:MakeDraggable(topBar,main)

    Theme:OnChanged(function(t)
        main.BackgroundColor3=t.Bg
        main.BackgroundTransparency=t.Transparency or options.Transparency or 0
        topBar.BackgroundColor3=t.Panel
        topBar.BackgroundTransparency=t.Transparency or 0
        titleLbl.TextColor3=t.Text
        mainBorder.Color=t.Border
        glow.Color=t.Accent
        tabBar.BackgroundColor3=t.Panel
        floatBar.BackgroundColor3=t.Panel
        floatLbl.TextColor3=t.Text
        minBtn.BackgroundColor3=t.Sec
        closeBtn.BackgroundColor3=t.Sec
        minBtn.TextColor3=t.Sub
    end)

    workspace.CurrentCamera:GetPropertyChangedSignal("ViewportSize"):Connect(function()
        local vp2=workspace.CurrentCamera.ViewportSize
        if main.AbsoluteSize.X>vp2.X-20 or main.AbsoluteSize.Y>vp2.Y-20 then
            local newW=math.min(main.AbsoluteSize.X, vp2.X-20)
            local newH=math.min(main.AbsoluteSize.Y, vp2.Y-20)
            main.Size=UDim2.fromOffset(newW,newH)
            main.Position=UDim2.new(0.5,-newW/2,0.5,-newH/2)
        end
    end)

    return {Main=main, TabBar=tabBar, TabContent=tabContent, SavedSize=savedSize}
end

