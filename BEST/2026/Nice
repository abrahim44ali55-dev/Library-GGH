                TextSize = 12,
            }, {
                Create("UICorner", {CornerRadius = UDim.new(0, 8)}),
                Create("UIPadding", {PaddingLeft=UDim.new(0,10)}),
            })
            box.FocusLost:Connect(function()
                if data.Callback then data.Callback(box.Text) end
            end)
        end
        
        table.insert(self.Tabs, tabObj)
        if #self.Tabs == 1 then self:SelectTab(1) end
        return tabObj
    end
    
    closeBtn.MouseButton1Click:Connect(function() windowObj:Destroy() end)
    
    return windowObj
end

function GGH:GetVersion()
    return self.Version.." - GGH Custom Design"
end

function GGH:AddTheme() end
function GGH:SetTheme() end

return GGH
