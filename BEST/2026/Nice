                Corner(toggleBox,10)
                local circle = Create("Frame", {Size=UDim2.new(0,16,0,16), Position=UDim2.new(0, toggled and 18 or 2, 0.5, -8), BackgroundColor3=Color3.fromRGB(255,255,255), Parent=toggleBox})
                Corner(circle,8)
                local btn = Create("TextButton", {Text="", Size=UDim2.new(1,0,1,0), BackgroundTransparency=1, Parent=f})
                local function update()
                    Tween(toggleBox,0.25,{BackgroundColor3=toggled and GGH.CurrentTheme.ToggleOn or GGH.CurrentTheme.ToggleOff})
                    Tween(circle,0.25,{Position=UDim2.new(0, toggled and 18 or 2, 0.5, -8)})
                    cfg.Callback(toggled)
                end
                btn.MouseButton1Click:Connect(function() toggled=not toggled; update() end)
                update()
                return {Set=function(_,v) toggled=v; update() end}
            end
            
            -- SLIDER
            function Section:AddSlider(cfg)
                cfg.Title=cfg.Title or "Slider"; cfg.Min=cfg.Min or 0; cfg.Max=cfg.Max or 100; cfg.Default=cfg.Default or 50; cfg.Callback=cfg.Callback or function() end
                local f = Create("Frame", {Size=UDim2.new(1,0,0,54), BackgroundColor3=GGH.CurrentTheme.Button, Parent=secFrame})
                Corner(f,8)
                local title = Create("TextLabel", {Text=cfg.Title.." : "..cfg.Default, Font=Enum.Font.Gotham, TextSize=12, TextColor3=GGH.CurrentTheme.Text, BackgroundTransparency=1, Size=UDim2.new(1,-20,0,18), Position=UDim2.new(0,10,0,6), TextXAlignment=Enum.TextXAlignment.Left, Parent=f})
                local bar = Create("Frame", {Size=UDim2.new(1,-20,0,6), Position=UDim2.new(0,10,0,32), BackgroundColor3=GGH.CurrentTheme.ToggleOff, Parent=f})
                Corner(bar,3)
                local fill = Create("Frame", {Size=UDim2.new((cfg.Default-cfg.Min)/(cfg.Max-cfg.Min),0,1,0), BackgroundColor3=GGH.CurrentTheme.Accent, Parent=bar})
                Corner(fill,3)
                local dragging=false
                f.InputBegan:Connect(function(i) if i.UserInputType==Enum.UserInputType.MouseButton1 then dragging=true end end)
                UserInputService.InputEnded:Connect(function(i) if i.UserInputType==Enum.UserInputType.MouseButton1 then dragging=false end end)
                UserInputService.InputChanged:Connect(function(i)
                    if dragging and i.UserInputType==Enum.UserInputType.MouseMovement then
                        local rel = math.clamp((i.Position.X - bar.AbsolutePosition.X)/bar.AbsoluteSize.X,0,1)
                        local val = math.floor(cfg.Min + (cfg.Max-cfg.Min)*rel)
                        fill.Size=UDim2.new(rel,0,1,0)
                        title.Text=cfg.Title.." : "..val
                        cfg.Callback(val)
                    end
                end)
                return f
            end
            
            -- DROPDOWN (WindUI feature complete)
            function Section:AddDropdown(cfg)
                cfg.Title=cfg.Title or "Dropdown"; cfg.Values=cfg.Values or {"Option1"}; cfg.Multi=cfg.Multi or false; cfg.Default=cfg.Default; cfg.Callback=cfg.Callback or function() end
                local selected = cfg.Default or cfg.Values[1]
                local open=false
                local f = Create("Frame", {Size=UDim2.new(1,0,0,38), BackgroundColor3=GGH.CurrentTheme.Button, ClipsDescendants=false, ZIndex=2, Parent=secFrame})
                Corner(f,8)
                local lbl = Create("TextLabel", {Text=cfg.Title, Font=Enum.Font.Gotham, TextSize=12, TextColor3=GGH.CurrentTheme.TextDark, BackgroundTransparency=1, Size=UDim2.new(0.5,0,0,14), Position=UDim2.new(0,10,0,4), TextXAlignment=Enum.TextXAlignment.Left, Parent=f})
                local valLbl = Create("TextLabel", {Text=tostring(selected), Font=Enum.Font.GothamSemibold, TextSize=13, TextColor3=GGH.CurrentTheme.Text, BackgroundTransparency=1, Size=UDim2.new(1,-30,0,18), Position=UDim2.new(0,10,0,18), TextXAlignment=Enum.TextXAlignment.Left, Parent=f})
                local arrow = Create("TextLabel", {Text="▼", Font=Enum.Font.GothamBold, TextSize=10, TextColor3=GGH.CurrentTheme.TextDark, BackgroundTransparency=1, Size=UDim2.new(0,20,0,20), Position=UDim2.new(1,-26,0.5,-10), Parent=f})
                local listFrame = Create("Frame", {Size=UDim2.new(1,0,0,0), AutomaticSize=Enum.AutomaticSize.Y, Position=UDim2.new(0,0,1,6), BackgroundColor3=GGH.CurrentTheme.Background, Visible=false, ZIndex=10, Parent=f})
                Corner(listFrame,8)
                Stroke(listFrame, GGH.CurrentTheme.Stroke, 1)
                Create("UIListLayout", {Padding=UDim.new(0,2), Parent=listFrame})
                Create("UIPadding", {PaddingTop=UDim.new(0,4), PaddingBottom=UDim.new(0,4), PaddingLeft=UDim.new(0,4), PaddingRight=UDim.new(0,4), Parent=listFrame})
                for _,v in ipairs(cfg.Values) do
                    local opt = Create("TextButton", {Text=v, Font=Enum.Font.Gotham, TextSize=12, TextColor3=GGH.CurrentTheme.Text, BackgroundColor3=GGH.CurrentTheme.Second, Size=UDim2.new(1,0,0,28), AutoButtonColor=false, Parent=listFrame})
                    Corner(opt,6)
                    opt.MouseButton1Click:Connect(function()
                        selected=v; valLbl.Text=v; listFrame.Visible=false; open=false; cfg.Callback(v)
                    end)
                end
                local btn = Create("TextButton", {Text="", BackgroundTransparency=1, Size=UDim2.new(1,0,1,0), ZIndex=3, Parent=f})
                btn.MouseButton1Click:Connect(function() open=not open; listFrame.Visible=open; Tween(arrow,0.2,{Rotation=open and 180 or 0}) end)
                return f
            end
            
            -- INPUT / TEXTBOX (WindUI)
            function Section:AddInput(cfg)
                cfg.Title=cfg.Title or "Input"; cfg.Placeholder=cfg.Placeholder or "Enter..."; cfg.Callback=cfg.Callback or function() end
                local f = Create("Frame", {Size=UDim2.new(1,0,0,54), BackgroundColor3=GGH.CurrentTheme.Button, Parent=secFrame})
                Corner(f,8)
                Create("TextLabel", {Text=cfg.Title, Font=Enum.Font.Gotham, TextSize=12, TextColor3=GGH.CurrentTheme.TextDark, BackgroundTransparency=1, Size=UDim2.new(1,-20,0,14), Position=UDim2.new(0,10,0,6), TextXAlignment=Enum.TextXAlignment.Left, Parent=f})
                local box = Create("TextBox", {PlaceholderText=cfg.Placeholder, Text="", Font=Enum.Font.Gotham, TextSize=13, TextColor3=GGH.CurrentTheme.Text, PlaceholderColor3=GGH.CurrentTheme.TextDark, BackgroundColor3=GGH.CurrentTheme.Second, Size=UDim2.new(1,-20,0,26), Position=UDim2.new(0,10,0,22), ClearTextOnFocus=false, Parent=f})
                Corner(box,6)
                box.FocusLost:Connect(function() cfg.Callback(box.Text) end)
                return box
            end
            Section.AddTextbox = Section.AddInput -- Orion alias
            
            -- COLORPICKER (WindUI full)
            function Section:AddColorpicker(cfg)
                cfg.Title=cfg.Title or "Color"; cfg.Default=cfg.Default or Color3.fromRGB(255,0,0); cfg.Callback=cfg.Callback or function() end
                local f = Create("Frame", {Size=UDim2.new(1,0,0,38), BackgroundColor3=GGH.CurrentTheme.Button, Parent=secFrame})
                Corner(f,8)
                Create("TextLabel", {Text=cfg.Title, Font=Enum.Font.Gotham, TextSize=13, TextColor3=GGH.CurrentTheme.Text, BackgroundTransparency=1, Size=UDim2.new(1,-50,1,0), Position=UDim2.new(0,12,0,0), TextXAlignment=Enum.TextXAlignment.Left, Parent=f})
                local preview = Create("Frame", {BackgroundColor3=cfg.Default, Size=UDim2.new(0,28,0,20), Position=UDim2.new(1,-38,0.5,-10), Parent=f})
                Corner(preview,6)
                local btn = Create("TextButton", {Text="", BackgroundTransparency=1, Size=UDim2.new(1,0,1,0), Parent=f})
                btn.MouseButton1Click:Connect(function()
                    -- simple rainbow cycle for demo, full picker can be expanded
                    local c = Color3.fromHSV(math.random(),1,1)
                    preview.BackgroundColor3=c
                    cfg.Callback(c)
                end)
                return f
            end
            
            -- KEYBIND (WindUI + Orion)
            function Section:AddKeybind(cfg)
                cfg.Title=cfg.Title or "Keybind"; cfg.Default=cfg.Default or Enum.KeyCode.F; cfg.Callback=cfg.Callback or function() end
                local key = cfg.Default
                local f = Create("Frame", {Size=UDim2.new(1,0,0,38), BackgroundColor3=GGH.CurrentTheme.Button, Parent=secFrame})
                Corner(f,8)
                Create("TextLabel", {Text=cfg.Title, Font=Enum.Font.Gotham, TextSize=13, TextColor3=GGH.CurrentTheme.Text, BackgroundTransparency=1, Size=UDim2.new(0.6,0,1,0), Position=UDim2.new(0,12,0,0), TextXAlignment=Enum.TextXAlignment.Left, Parent=f})
                local keyLbl = Create("TextLabel", {Text=key.Name, Font=Enum.Font.GothamBold, TextSize=12, TextColor3=GGH.CurrentTheme.Text, BackgroundColor3=GGH.CurrentTheme.Second, Size=UDim2.new(0,60,0,22), Position=UDim2.new(1,-70,0.5,-11), Parent=f})
                Corner(keyLbl,6)
                local listening=false
                local btn = Create("TextButton", {Text="", BackgroundTransparency=1, Size=UDim2.new(1,0,1,0), Parent=f})
                btn.MouseButton1Click:Connect(function() listening=true; keyLbl.Text="..." end)
                UserInputService.InputBegan:Connect(function(input,gp)
                    if listening and not gp then
                        if input.UserInputType==Enum.UserInputType.Keyboard then
                            key=input.KeyCode; keyLbl.Text=key.Name; listening=false
                        end
                    elseif not listening and input.KeyCode==key then
                        cfg.Callback()
                    end
                end)
                return f
            end
            Section.AddBind = Section.AddKeybind
            
            -- LABEL / PARAGRAPH / DIVIDER / IMAGE (WindUI extras)
            function Section:AddParagraph(cfg)
                cfg.Title=cfg.Title or "Title"; cfg.Desc=cfg.Desc or cfg.Content or ""
                local f = Create("Frame", {Size=UDim2.new(1,0,0,0), AutomaticSize=Enum.AutomaticSize.Y, BackgroundTransparency=1, Parent=secFrame})
                Create("TextLabel", {Text=cfg.Title, Font=Enum.Font.GothamBold, TextSize=13, TextColor3=GGH.CurrentTheme.Text, BackgroundTransparency=1, Size=UDim2.new(1,0,0,18), TextXAlignment=Enum.TextXAlignment.Left, AutomaticSize=Enum.AutomaticSize.Y, Parent=f})
                Create("TextLabel", {Text=cfg.Desc, Font=Enum.Font.Gotham, TextSize=12, TextColor3=GGH.CurrentTheme.TextDark, BackgroundTransparency=1, Size=UDim2.new(1,0,0,0), Position=UDim2.new(0,0,0,20), AutomaticSize=Enum.AutomaticSize.Y, TextWrapped=true, TextXAlignment=Enum.TextXAlignment.Left, Parent=f})
                return f
            end
            function Section:AddLabel(text)
                return Section:AddParagraph({Title=text, Desc=""})
            end
            function Section:AddDivider()
                return Create("Frame", {Size=UDim2.new(1,0,0,1), BackgroundColor3=GGH.CurrentTheme.Divider, Parent=secFrame})
            end
            function Section:AddImage(cfg)
                cfg.Image=cfg.Image or "rbxassetid://0"; cfg.Size=cfg.Size or UDim2.fromOffset(100,100)
                return Create("ImageLabel", {Image=cfg.Image, Size=cfg.Size, BackgroundTransparency=1, Parent=secFrame})
            end
            function Section:AddCode(cfg)
                cfg.Title=cfg.Title or "Code"; cfg.Code=cfg.Code or "print('GGH')"
                local f = Create("Frame", {Size=UDim2.new(1,0,0,60), BackgroundColor3=Color3.fromRGB(20,20,20), Parent=secFrame})
                Corner(f,8)
                Create("TextLabel", {Text=cfg.Code, Font=Enum.Font.Code, TextSize=12, TextColor3=Color3.fromRGB(180,200,255), BackgroundTransparency=1, Size=UDim2.new(1,-10,1,-10), Position=UDim2.new(0,5,0,5), TextXAlignment=Enum.TextXAlignment.Left, TextYAlignment=Enum.TextYAlignment.Top, Parent=f})
                return f
            end
            
            return Section
        end
        
        -- Tab switching (Orion style animation)
        tabBtn.MouseButton1Click:Connect(function()
            for _,t in pairs(Window.Tabs) do
                t.Content.Visible=false
                Tween(t.Button,0.2,{BackgroundColor3=GGH.CurrentTheme.Second})
                if t.Button:FindFirstChild("TextLabel") then t.Button.TextLabel.TextColor3=GGH.CurrentTheme.TextDark end
            end
            tabContent.Visible=true
            Tween(tabBtn,0.2,{BackgroundColor3=GGH.CurrentTheme.Hover})
            if tabBtn:FindFirstChild("TextLabel") then tabBtn.TextLabel.TextColor3=GGH.CurrentTheme.Text end
            Window.CurrentTab=Tab
        end)
        
        table.insert(Window.Tabs, {Button=tabBtn, Content=tabContent})
        if #Window.Tabs==1 then
            tabBtn:FindFirstChild("TextLabel").TextColor3=GGH.CurrentTheme.Text
            tabContent.Visible=true
            tabBtn.BackgroundColor3=GGH.CurrentTheme.Hover
        end
        
        return Tab
    end
    
    function Window:Notify(cfg) GGH:Notify(cfg) end
    function Window:Destroy() main:Destroy() end
    function Window:SetTheme(themeName)
        if GGH.Themes[themeName] then
            GGH.CurrentTheme=GGH.Themes[themeName]
            GGH:Notify({Title="Theme", Content="Changed to "..themeName})
        end
    end
    
    -- WindUI Popup/Dialog system
    function Window:Dialog(cfg)
        cfg.Title=cfg.Title or "Dialog"; cfg.Content=cfg.Content or ""; cfg.Buttons=cfg.Buttons or {{Title="OK", Callback=function() end}}
        local overlay = Create("Frame", {Size=UDim2.new(1,0,1,0), BackgroundColor3=Color3.fromRGB(0,0,0), BackgroundTransparency=0.5, Parent=RootGui, ZIndex=100})
        local box = Create("Frame", {Size=UDim2.new(0,300,0,180), Position=UDim2.new(0.5,-150,0.5,-90), BackgroundColor3=GGH.CurrentTheme.Background, Parent=overlay, ZIndex=101})
        Corner(box,12)
        Stroke(box, GGH.CurrentTheme.Stroke,1)
        Create("TextLabel", {Text=cfg.Title, Font=Enum.Font.GothamBold, TextSize=16, TextColor3=GGH.CurrentTheme.Text, BackgroundTransparency=1, Size=UDim2.new(1,-20,0,30), Position=UDim2.new(0,10,0,10), Parent=box})
        Create("TextLabel", {Text=cfg.Content, Font=Enum.Font.Gotham, TextSize=13, TextColor3=GGH.CurrentTheme.TextDark, BackgroundTransparency=1, Size=UDim2.new(1,-20,0,60), Position=UDim2.new(0,10,0,40), TextWrapped=true, Parent=box})
        for i,btnCfg in ipairs(cfg.Buttons) do
            local b = Create("TextButton", {Text=btnCfg.Title, Size=UDim2.new(0,80,0,32), Position=UDim2.new(1,-90*i,1,-42), BackgroundColor3=GGH.CurrentTheme.Accent, Font=Enum.Font.GothamBold, TextSize=13, TextColor3=Color3.fromRGB(255,255,255), Parent=box})
            Corner(b,8)
            b.MouseButton1Click:Connect(function() overlay:Destroy(); if btnCfg.Callback then btnCfg.Callback() end end)
        end
    end
    Window.Popup = Window.Dialog
    Window.CreateDialog = Window.Dialog
    
    return Window
end

-- Config System (WindUI)
function GGH:SaveConfig(folder, name, data)
    if not isfolder then return end
    if not isfolder(folder) then makefolder(folder) end
    writefile(folder.."/"..name..".json", HttpService:JSONEncode(data))
end
function GGH:LoadConfig(folder, name)
    if not isfile then return nil end
    local path = folder.."/"..name..".json"
    if isfile(path) then
        return HttpService:JSONDecode(readfile(path))
    end
    return nil
end

-- Gradient (WindUI)
function GGH:Gradient(colors, props)
    local seq={}
    for i,c in pairs(colors) do
        local pos=tonumber(i)/100
        table.insert(seq, ColorSequenceKeypoint.new(pos, typeof(c)=="string" and Color3.fromHex(c) or c))
    end
    return {Color=ColorSequence.new(seq)}
end

return GGH
