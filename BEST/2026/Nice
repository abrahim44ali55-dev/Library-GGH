    local title=Util:Create("TextLabel",{
        Text=opts.Title or "Notification",
        Font=Enum.Font.GothamBold,
        TextSize=12,
        TextColor3=th.Text,
        BackgroundTransparency=1,
        Size=UDim2.new(1,0,0,16),
        TextXAlignment=Enum.TextXAlignment.Left,
        TextTruncate=Enum.TextTruncate.AtEnd,
        Parent=frame
    })
    title.AutoLocalize=false

    local content=Util:Create("TextLabel",{
        Text=opts.Content or "",
        Font=Enum.Font.Gotham,
        TextSize=11,
        TextColor3=th.Sub,
        BackgroundTransparency=1,
        Size=UDim2.new(1,0,0,0),
        AutomaticSize=Enum.AutomaticSize.Y,
        TextWrapped=true,
        TextXAlignment=Enum.TextXAlignment.Left,
        Parent=frame
    })
    content.AutoLocalize=false
    -- Limit content length to prevent long notification
    if #content.Text>80 then
        content.Text=string.sub(content.Text,1,80).."..."
    end

    frame.Position=UDim2.fromOffset(320,0)
    TweenService:Create(frame,TweenInfo.new(0.38,Enum.EasingStyle.Back,Enum.EasingDirection.Out),{Position=UDim2.fromOffset(0,0)}):Play()

    task.delay(opts.Duration or 2.5, function()
        if frame and frame.Parent then
            local tw=TweenService:Create(frame,TweenInfo.new(0.24,Enum.EasingStyle.Quad,Enum.EasingDirection.In),{Position=UDim2.fromOffset(320,0)})
            tw:Play(); tw.Completed:Wait(); frame:Destroy()
        end
    end)
