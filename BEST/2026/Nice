        local Elements = {}

        -- NEW UNIFIED ADD API - This is what you asked for
        function Elements:Add(Type, Cfg)
            Cfg = Cfg or {}
            Type = string.lower(tostring(Type))
            if Type == "section" then CreateSection(Cfg)
            elseif Type == "paragraph" then CreateParagraph(Cfg)
            elseif Type == "button" then CreateButton(Cfg)
            elseif Type == "toggle" then CreateToggle(Cfg)
            elseif Type == "slider" then CreateSlider(Cfg)
            elseif Type == "input" then CreateInput(Cfg)
            elseif Type == "dropdown" then CreateDropdown(Cfg)
            elseif Type == "colorpicker" or Type == "color" then CreateColorpicker(Cfg)
            elseif Type == "keybind" or Type == "key" then CreateKeybind(Cfg)
            elseif Type == "code" then CreateCode(Cfg)
            elseif Type == "label" then CreateLabel(Cfg)
            elseif Type == "separator" or Type == "line" or Type == "divider" then CreateSeparator(Cfg)
            elseif Type == "image" or Type == "img" or Type == "logo" then CreateImage(Cfg)
            else warn("[GGH Library v1.8.0] Unknown Add type: "..tostring(Type))
            end
        end

        -- Keep old methods for backward compatibility but they now call Add internally
        function Elements:Section(Cfg) return self:Add("Section", Cfg) end
        function Elements:Paragraph(Cfg) return self:Add("Paragraph", Cfg) end
        function Elements:Button(Cfg) return self:Add("Button", Cfg) end
        function Elements:Toggle(Cfg) return self:Add("Toggle", Cfg) end
