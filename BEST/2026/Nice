local function CreateButton(parent, opts)
    local th=Theme.Current
    local btn=Util:Create("TextButton",{Text=opts.Name or "Button",Font=Enum.Font.GothamBold,TextSize=13,TextColor3=Color3.new(1,1,1),BackgroundColor3=opts.Color or th.Accent,Size=UDim2.new(1,0,0,38),AutoButtonColor=false,Parent=parent})
    Util:Corner(btn,10); btn.AutoLocalize=false
    btn.MouseEnter:Connect(function() Anim:Tween(btn,{BackgroundColor3=(opts.Color or th.Accent):Lerp(Color3.new(1,1,1),0.12)},TweenInfo.new(0.12)) end)
    btn.MouseLeave:Connect(function() Anim:Tween(btn,{BackgroundColor3=opts.Color or th.Accent},TweenInfo.new(0.12)) end)
    btn.MouseButton1Click:Connect(function() Anim:Ripple(btn) if opts.Callback then task.spawn(opts.Callback) end end)
    Theme:OnChanged(function(t) if not opts.Color then btn.BackgroundColor3=t.Accent end end)
    return {Instance=btn}
end

