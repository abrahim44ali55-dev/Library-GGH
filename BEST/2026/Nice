function NiceLib:DeepCopy(orig)
    local orig_type = type(orig)
    local copy
    if orig_type == 'table' then
        copy = {}
        for orig_key, orig_value in next, orig, nil do copy[NiceLib:DeepCopy(orig_key)] = NiceLib:DeepCopy(orig_value) end
        setmetatable(copy, NiceLib:DeepCopy(getmetatable(orig)))
    else copy = orig end
    return copy
end

function NiceLib:ClampString(str, maxLen)
    if #str > maxLen then return str:sub(1,maxLen).."..." else return str end
end

