local Notification = {}
Notification.Container = nil

function Notification:Init(screenGui)
    if screenGui:FindFirstChild("GGH_Notifications") then
        self.Container = screenGui:FindFirstChild("GGH_Notifications")
        return
    end
    self.Container = Util:Create("Frame", {
        Name = "GGH_Notifications",
        AnchorPoint = Vector2.new(1,1),
        Position = UDim2.new(1, -14, 1, -14),
        Size = UDim2.fromOffset(320, 500),
        BackgroundTransparency = 1,
        ZIndex = 200,
        ClipsDescendants = false,
        Parent = screenGui
    })
    local list = Util:List(self.Container, Enum.FillDirection.Vertical, 8)
    list.VerticalAlignment = Enum.VerticalAlignment.Bottom
end

function Notification:Notify(options)
    options = options or {}
    local th = Theme.Current
    local typeColors = {
        Success = th.Success,
        Error = th.Err,
        Warning = th.Warn,
        Info = th.Accent
    }
    local accent = typeColors[options.Type or "Info"] or th.Accent

    local frame = Util:Create("Frame", {
        Size = UDim2.fromOffset(320, 0),
        AutomaticSize = Enum.AutomaticSize.Y,
        BackgroundColor3 = th.Panel,
        BorderSizePixel = 0,
        ZIndex = 201,
        Parent = self.Container
    })
    Util:Corner(frame, 12)
    Util:Stroke(frame, th.Border, 1, 0.12)

    local bar = Util:Create("Frame", {
        Size = UDim2.new(0, 4, 1, 0),
        BackgroundColor3 = accent,
        BorderSizePixel = 0,
        Parent = frame
    })
    Util:Corner(bar, 4)

    Util:Padding(frame, {10, 10, 18, 12})
    Util:List(frame, Enum.FillDirection.Vertical, 4)

    local titleLabel = Util:Create("TextLabel", {
        Text = options.Title or options.Type or "Notification",
        Font = Enum.Font.GothamBold,
        TextSize = 13,
        TextColor3 = th.Text,
        BackgroundTransparency = 1,
        Size = UDim2.new(1, 0, 0, 18),
        TextXAlignment = Enum.TextXAlignment.Left,
        TextWrapped = true,
        Parent = frame
    })
    titleLabel.AutoLocalize = false

    local contentLabel = Util:Create("TextLabel", {
        Text = options.Content or options.Message or "",
        Font = Enum.Font.Gotham,
        TextSize = 12,
        TextColor3 = th.Sub,
        BackgroundTransparency = 1,
        Size = UDim2.new(1, 0, 0, 0),
        AutomaticSize = Enum.AutomaticSize.Y,
        TextWrapped = true,
        TextXAlignment = Enum.TextXAlignment.Left,
        Parent = frame
    })
    contentLabel.AutoLocalize = false

    frame.Position = UDim2.fromOffset(360, 0)
    Anim:Tween(frame, {Position = UDim2.fromOffset(0,0)}, TweenInfo.new(0.42, Enum.EasingStyle.Back, Enum.EasingDirection.Out))

    local duration = options.Duration or 3.5
    if duration ~= 0 then
        task.delay(duration, function()
            if frame and frame.Parent then
                local tween = Anim:Tween(frame, {Position = UDim2.fromOffset(360,0)}, TweenInfo.new(0.28, Enum.EasingStyle.Quad, Enum.EasingDirection.In))
                tween.Completed:Wait()
                frame:Destroy()
            end
        end)
    end

    return frame
end

