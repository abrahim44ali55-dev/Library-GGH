function GGH:CreateWindow(cfg)
    local win = WindowFactory:Create(cfg or {})
    local api = {}
    api._window = win
    api._tabs = {}

    function api:AddTab(name)
        local th = Theme.Current
        local tabBtn = UI.Create("TextButton", {
            Text = name,
            Font = Enum.Font.Gotham,
            TextSize = 13,
            TextColor3 = th.SubText,
            BackgroundColor3 = th.Secondary,
            Size = UDim2.new(1,-8,0,36),
            Parent = win.TabContainer
        })
        UI.Corner(tabBtn, 8)

        local page = UI.Create("Frame", {
            Name = name.."_Page",
            Size = UDim2.new(1,0,0,0),
            AutomaticSize = Enum.AutomaticSize.Y,
            BackgroundTransparency = 1,
            Visible = false,
            Parent = win.Content
        })
        UI.List(page, Enum.FillDirection.Vertical, 8)

        local firstTab = #win.TabContainer:GetChildren() == 1
        if firstTab then
            page.Visible = true
            tabBtn.BackgroundColor3 = th.Accent
            tabBtn.TextColor3 = Color3.new(1,1,1)
        end

        tabBtn.MouseButton1Click:Connect(function()
            for _,c in ipairs(win.Content:GetChildren()) do if c:IsA("Frame") or c:IsA("ScrollingFrame") then c.Visible=false end end
            page.Visible=true
            for _,b in ipairs(win.TabContainer:GetChildren()) do if b:IsA("TextButton") then b.BackgroundColor3=th.Secondary b.TextColor3=th.SubText end end
            tabBtn.BackgroundColor3=th.Accent tabBtn.TextColor3=Color3.new(1,1,1)
        end)

        local tabApi = {}
        function tabApi:AddButton(c) return CreateButton(page,c) end
        function tabApi:AddToggle(c) return CreateToggle(page,c) end
        function tabApi:AddSlider(c) return CreateSlider(page,c) end
        function tabApi:AddDropdown(c) return CreateDropdown(page,c) end
        function tabApi:AddLabel(text)
            local lbl = UI.Create("TextLabel", {Text=text, Font=Enum.Font.Gotham, TextSize=13, TextColor3=th.Text, BackgroundTransparency=1, Size=UDim2.new(1,0,0,22), TextXAlignment=Enum.TextXAlignment.Left, Parent=page})
            return lbl
        end
        function tabApi:AddSection(name)
            local sec = UI.Create("TextLabel", {Text=name:upper(), Font=Enum.Font.GothamBold, TextSize=11, TextColor3=th.SubText, BackgroundTransparency=1, Size=UDim2.new(1,0,0,20), TextXAlignment=Enum.TextXAlignment.Left, Parent=page})
            local div = UI.Create("Frame", {Size=UDim2.new(1,0,0,1), BackgroundColor3=th.Border, BackgroundTransparency=0.5, Parent=page})
            return sec
        end
        return tabApi
    end

    function api:SetTitle(t) win.Title.Text = t end
    function api:Destroy() win.Gui:Destroy() end
    function api:Minimize() MinimizeSystem:Toggle(win) end

    return api
end

function GGH:SetTheme(name) Theme.Set(name) end
function GGH:GetThemes() local list={} for k,_ in pairs(Theme.List) do table.insert(list,k) end return list end

function GGH:Notify(title, message, duration)
    local th = Theme.Current
    local notif = UI.Create("Frame", {Size=UDim2.fromOffset(300,72), Position=UDim2.new(1,-310,1,20), BackgroundColor3=th.Panel, Parent=GuiParent})
    UI.Corner(notif,12)
    UI.Stroke(notif, th.Border,1,0.2)
    local t1 = UI.Create("TextLabel", {Text=title, Font=Enum.Font.GothamBold, TextSize=13, TextColor3=th.Text, BackgroundTransparency=1, Position=UDim2.fromOffset(14,10), Size=UDim2.new(1,-28,0,18), TextXAlignment=Enum.TextXAlignment.Left, Parent=notif})
    local t2 = UI.Create("TextLabel", {Text=message, Font=Enum.Font.Gotham, TextSize=11, TextColor3=th.SubText, BackgroundTransparency=1, Position=UDim2.fromOffset(14,32), Size=UDim2.new(1,-28,0,30), TextWrapped=true, TextXAlignment=Enum.TextXAlignment.Left, TextYAlignment=Enum.TextYAlignment.Top, Parent=notif})
    Anim.Tween(notif, {Position=UDim2.new(1,-310,1,-82)},0.38,Enum.EasingStyle.Back,Enum.EasingDirection.Out)
    task.delay(duration or 3, function()
        Anim.Tween(notif, {Position=UDim2.new(1,-310,1,20)},0.3,Enum.EasingStyle.Quad,Enum.EasingDirection.In)
        task.wait(0.32)
        notif:Destroy()
    end)
end

