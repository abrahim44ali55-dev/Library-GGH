	local function updateAllElementsColors()
		MainFrame.BackgroundColor3 = currentTheme.Bg
		TopBar.BackgroundColor3 = currentTheme.Top
		TitleLabel.TextColor3 = currentTheme.Text
		ConfirmBox.BackgroundColor3 = currentTheme.Top
		ConfirmText.TextColor3 = currentTheme.Text
		NoButton.BackgroundColor3 = currentTheme.Elem
		NoButton.TextColor3 = currentTheme.Text
		ResizeButton.TextColor3 = currentTheme.Sub
		CloseButton.BackgroundColor3 = currentTheme.Elem
		CloseButton.TextColor3 = currentTheme.Text
		MinimizeButton.BackgroundColor3 = currentTheme.Elem
		MinimizeButton.TextColor3 = currentTheme.Text

		for _, btn in ipairs(Sidebar:GetChildren()) do
			if btn:IsA("TextButton") then
				local isSelected = (btn.BackgroundColor3 == currentTheme.Top or btn.TextColor3 == currentTheme.Text)
				btn.BackgroundColor3 = isSelected and currentTheme.Top or currentTheme.Elem
				btn.TextColor3 = isSelected and currentTheme.Text or currentTheme.Sub
			end
		end

		for _, page in ipairs(ContainerHolder:GetChildren()) do
			if page:IsA("ScrollingFrame") then
				for _, item in ipairs(page:GetChildren()) do
					if item:IsA("Frame") or item:IsA("TextButton") then
						if item.Name ~= "Switch" and item.Name ~= "Circle" and item.Name ~= "Fill" then
							if item.BackgroundColor3 ~= Color3.fromRGB(45, 45, 55) and item.BackgroundColor3 ~= Color3.fromRGB(50, 50, 60) then
								item.BackgroundColor3 = currentTheme.Elem
							end
							for _, subChild in ipairs(item:GetDescendants()) do
								if subChild:IsA("TextLabel") then
									if subChild.TextColor3 ~= currentTheme.Accent and subChild.TextColor3 ~= Color3.fromRGB(255, 255, 255) then
										subChild.TextColor3 = currentTheme.Text
									end
								elseif subChild:IsA("Frame") and subChild.Size.X.Offset == 34 then
									subChild.BackgroundColor3 = currentTheme.Accent
								end
							end
						end
					end
				end
			end
		end
	end

	function WindowObj:SetTheme(themeName)
		if Themes[themeName] then
			currentThemeName = themeName
			currentTheme = Themes[themeName]
			updateAnimationState()
			updateAllElementsColors()
			Notify("الثيمات", "تم تغيير الثيم إلى: " .. themeName, 2)
		end
	end

