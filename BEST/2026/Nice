    Util:Corner(topBar, 16)
    local topBarFix = Util:Create("Frame", {
        BackgroundColor3 = th.Panel,
        Size = UDim2.new(1,0,0,10),
        Position = UDim2.new(0,0,1,-10),
        BorderSizePixel = 0,
        ZIndex = 3,
        Parent = topBar
    })

    local titleLabel = Util:Create("TextLabel", {
        Text = options.Title or "GGH Lib",
        Font = Enum.Font.GothamBold,
        TextSize = 14,
        TextColor3 = th.Text,
        BackgroundTransparency = 1,
        Size = UDim2.new(1, -100, 1, 0),
        Position = UDim2.fromOffset(14,0),
        TextXAlignment = Enum.TextXAlignment.Left,
        TextTruncate = Enum.TextTruncate.AtEnd,
        Parent = topBar
    })
    titleLabel.AutoLocalize = false

    local buttonHolder = Util:Create("Frame", {
        BackgroundTransparency = 1,
        Size = UDim2.fromOffset(70,30),
        Position = UDim2.new(1, -78, 0, 6),
        ZIndex = 4,
        Parent = topBar
    })
    Util:List(buttonHolder, Enum.FillDirection.Horizontal, 6)

    local minimizeBtn = Util:Create("TextButton", {
        Text = "-",
        Font = Enum.Font.GothamBold,
        TextSize = 16,
        TextColor3 = th.Sub,
        BackgroundColor3 = th.Sec,
        Size = UDim2.fromOffset(30,30),
        AutoButtonColor = false,
        ZIndex = 4,
        Parent = buttonHolder
    })
    Util:Corner(minimizeBtn, 8)
    minimizeBtn.AutoLocalize = false

    local closeBtn = Util:Create("TextButton", {
        Text = "X",
        Font = Enum.Font.GothamBold,
        TextSize = 12,
        TextColor3 = Color3.fromRGB(255,95,95),
        BackgroundColor3 = th.Sec,
        Size = UDim2.fromOffset(30,30),
        AutoButtonColor = false,
        ZIndex = 4,
        Parent = buttonHolder
    })
    Util:Corner(closeBtn, 8)
    closeBtn.AutoLocalize = false

    -- Content Area
    local content = Util:Create("Frame", {
        Name = "Content",
        BackgroundTransparency = 1,
        Size = UDim2.new(1,0,1,-42),
        Position = UDim2.fromOffset(0,42),
        ClipsDescendants = true,
        ZIndex = 3,
        Parent = main
    })

    -- Tab Bar (Left)
    local tabBar = Util:Create("ScrollingFrame", {
        Name = "TabBar",
        BackgroundColor3 = th.Panel,
        BackgroundTransparency = 0.25,
        Size = UDim2.new(0,140,1,0),
        ScrollBarThickness = 2,
        CanvasSize = UDim2.new(0,0,0,0),
        AutomaticCanvasSize = Enum.AutomaticSize.Y,
        BorderSizePixel = 0,
        ZIndex = 3,
        Parent = content,
        ScrollingDirection = Enum.ScrollingDirection.Y
    })
    Util:List(tabBar, Enum.FillDirection.Vertical, 6)
    Util:Padding(tabBar, {8,8,8,45})

    -- Tab Content (Right)
    local tabContent = Util:Create("Frame", {
        Name = "TabContent",
        BackgroundTransparency = 1,
        Size = UDim2.new(1,-140,1,0),
        Position = UDim2.new(0,140,0,0),
        ZIndex = 3,
        Parent = content
    })

    -- Resize Handle (Bottom Right)
    local resizeHandle = Util:Create("Frame", {
        Name = "ResizeHandle",
        BackgroundTransparency = 1,
        AnchorPoint = Vector2.new(1,1),
        Position = UDim2.new(1,0,1,0),
        Size = UDim2.fromOffset(20,20),
        ZIndex = 10,
        Parent = main
    })

    local resizeIcon = Util:Create("TextLabel", {
        Text = "o",
        Font = Enum.Font.Gotham,
        TextSize = 12,
        TextColor3 = th.Sub,
        TextTransparency = 0.3,
        BackgroundTransparency = 1,
        Size = UDim2.fromScale(1,1),
        Parent = resizeHandle
    })
    resizeIcon.AutoLocalize = false

    -- Floating Minimized Bar
    local floatBar = Util:Create("Frame", {
        Name = "FloatingBar",
        BackgroundColor3 = th.Panel,
        Size = UDim2.fromOffset(200,40),
        Position = UDim2.new(0.5,-100,0,16),
        Visible = false,
        ZIndex = 50,
        Parent = screenGui
    })
    Util:Corner(floatBar, 20)
    Util:Stroke(floatBar, th.Border, 1, 0.12)

    local dragBtn = Util:Create("TextButton", {
        Text = "=",
        Font = Enum.Font.GothamBold,
        TextSize = 16,
        TextColor3 = th.Sub,
        BackgroundColor3 = th.Sec,
        Size = UDim2.fromOffset(32,32),
        Position = UDim2.fromOffset(4,4),
        AutoButtonColor = false,
        Parent = floatBar
    })
    Util:Corner(dragBtn, 16)
    dragBtn.AutoLocalize = false

    local floatLabel = Util:Create("TextLabel", {
        Text = "GGH Lib",
        Font = Enum.Font.GothamBold,
        TextSize = 12,
        TextColor3 = th.Text,
        BackgroundTransparency = 1,
        Size = UDim2.new(1, -80, 1, 0),
        Position = UDim2.fromOffset(42,0),
        TextXAlignment = Enum.TextXAlignment.Left,
        Parent = floatBar
    })
    floatLabel.AutoLocalize = false

    local restoreBtn = Util:Create("TextButton", {
        Text = "+",
        Font = Enum.Font.GothamBold,
        TextSize = 16,
        TextColor3 = th.Accent,
        BackgroundColor3 = th.Bg,
        Size = UDim2.fromOffset(32,32),
        Position = UDim2.new(1, -36, 0, 4),
        AutoButtonColor = false,
        Parent = floatBar
    })
    Util:Corner(restoreBtn, 16)
    restoreBtn.AutoLocalize = false

    -- Drag Logic for Main Window
    local draggingMain = false
    local dragStartMain = Vector2.new(0,0)
    local startPosMain = UDim2.new(0,0,0,0)
    local dragInputMain = nil

    topBar.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            draggingMain = true
            dragStartMain = input.Position
            startPosMain = main.Position
        end
    end)

    topBar.InputChanged:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
            dragInputMain = input
        end
    end)

    UserInputService.InputChanged:Connect(function(input)
        if input == dragInputMain and draggingMain then
            local delta = input.Position - dragStartMain
            main.Position = UDim2.new(
                startPosMain.X.Scale, startPosMain.X.Offset + delta.X,
                startPosMain.Y.Scale, startPosMain.Y.Offset + delta.Y
            )
        end
    end)

    UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            draggingMain = false
        end
    end)

    -- Resize Logic
    local resizing = false
    local resizeStart = Vector2.new(0,0)
    local resizeSize = Vector2.new(0,0)
    local resizeInput = nil

    resizeHandle.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            resizing = true
            resizeStart = input.Position
            resizeSize = Vector2.new(main.AbsoluteSize.X, main.AbsoluteSize.Y)
        end
    end)

    resizeHandle.InputChanged:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
            resizeInput = input
        end
    end)

    UserInputService.InputChanged:Connect(function(input)
        if input == resizeInput and resizing then
            local delta = input.Position - resizeStart
            local vp = workspace.CurrentCamera.ViewportSize
            local newW = math.clamp(resizeSize.X + delta.X, 340, math.min(vp.X - 20, 800))
            local newH = math.clamp(resizeSize.Y + delta.Y, 260, math.min(vp.Y - 20, 650))
            main.Size = UDim2.fromOffset(newW, newH)
        end
    end)

    UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            resizing = false
        end
    end)

    -- Collect Animation Logic (Premium)
    local function CollectAndMinimize()
        -- Save original sizes and animate all elements to 0 towards dragBtn
        local elementsToAnimate = {}

        -- Collect from tab content (all pages)
        for _, page in ipairs(tabContent:GetChildren()) do
            if page:IsA("ScrollingFrame") then
                for _, child in ipairs(page:GetChildren()) do
                    if child:IsA("GuiObject") and child.Visible and child.Size.Y.Offset > 5 then
                        if child.Name ~= "UIListLayout" and child.Name ~= "UIPadding" then
                            table.insert(elementsToAnimate, child)
                            child:SetAttribute("OriginalSize", child.Size)
                        end
                    end
                end
            end
        end

        -- Collect from tab bar
        for _, child in ipairs(tabBar:GetChildren()) do
            if child:IsA("TextButton") then
                table.insert(elementsToAnimate, child)
                child:SetAttribute("OriginalSize", child.Size)
            end
        end

        -- Animate each with stagger
        for i, el in ipairs(elementsToAnimate) do
            task.delay((i-1)*0.012, function()
                if el and el.Parent then
                    TweenService:Create(el, TweenInfo.new(0.2, Enum.EasingStyle.Back, Enum.EasingDirection.In), {
                        Size = UDim2.fromOffset(0,0)
                    }):Play()
                end
            end)
        end

        task.wait(#elementsToAnimate*0.012 + 0.22)

        -- Shrink main window to float bar position
        local targetPos = floatBar.Position
        TweenService:Create(main, TweenInfo.new(0.32, Enum.EasingStyle.Back, Enum.EasingDirection.In), {
            Size = UDim2.fromOffset(0,0),
            Position = UDim2.new(targetPos.X.Scale, targetPos.X.Offset + 100, targetPos.Y.Scale, targetPos.Y.Offset + 20)
        }):Play()

        task.wait(0.32)
        main.Visible = false

        -- Show float bar with bounce
        floatBar.Visible = true
        floatBar.Size = UDim2.fromOffset(0,40)
        TweenService:Create(floatBar, TweenInfo.new(0.45, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
            Size = UDim2.fromOffset(200,40)
        }):Play()
    end

    local function ExpandAndRestore()
        floatBar.Visible = false
        main.Visible = true

        local vp = workspace.CurrentCamera.ViewportSize
        local targetW = isMobile and math.min(vp.X - 24, 480) or 560
        local targetH = isMobile and math.min(vp.Y - 120, 360) or 380

        main.Size = UDim2.fromOffset(0,0)
        main.Position = UDim2.new(0.5, -targetW/2, 0.5, -targetH/2)

        TweenService:Create(main, TweenInfo.new(0.45, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
            Size = UDim2.fromOffset(targetW, targetH)
        }):Play()

        task.wait(0.35)

        -- Restore elements with stagger
        for _, page in ipairs(tabContent:GetChildren()) do
            if page:IsA("ScrollingFrame") then
                for _, child in ipairs(page:GetChildren()) do
                    if child:GetAttribute("OriginalSize") then
                        local orig = child:GetAttribute("OriginalSize")
                        child.Size = UDim2.fromOffset(0,0)
                        task.delay(math.random()*0.08, function()
                            if child and child.Parent then
                                TweenService:Create(child, TweenInfo.new(0.32, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
                                    Size = orig
                                }):Play()
                            end
                        end)
                    end
                end
            end
        end

        for _, child in ipairs(tabBar:GetChildren()) do
            if child:GetAttribute("OriginalSize") then
                local orig = child:GetAttribute("OriginalSize")
                child.Size = UDim2.fromOffset(0,0)
                task.delay(math.random()*0.08, function()
                    if child and child.Parent then
                        TweenService:Create(child, TweenInfo.new(0.32, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
                            Size = orig
                        }):Play()
                    end
                end)
            end
        end
    end

    minimizeBtn.MouseButton1Click:Connect(function()
        task.spawn(CollectAndMinimize)
    end)

    restoreBtn.MouseButton1Click:Connect(function()
        task.spawn(ExpandAndRestore)
    end)

    closeBtn.MouseButton1Click:Connect(function()
        ShowConfirmDialog(screenGui, function()
            screenGui:Destroy()
        end)
    end)

    Util:MakeDraggable(dragBtn, floatBar)
    Util:MakeDraggable(topBar, main)

    -- Theme Live Update
    Theme:OnChanged(function(newTheme)
        main.BackgroundColor3 = newTheme.Bg
        topBar.BackgroundColor3 = newTheme.Panel
        topBarFix.BackgroundColor3 = newTheme.Panel
        titleLabel.TextColor3 = newTheme.Text
        mainBorder.Color = newTheme.Border
        glow.Color = newTheme.Accent
        tabBar.BackgroundColor3 = newTheme.Panel
        floatBar.BackgroundColor3 = newTheme.Panel
        floatLabel.TextColor3 = newTheme.Text
        minimizeBtn.BackgroundColor3 = newTheme.Sec
        closeBtn.BackgroundColor3 = newTheme.Sec
        minimizeBtn.TextColor3 = newTheme.Sub
        resizeIcon.TextColor3 = newTheme.Sub
    end)

    -- Responsive: prevent going off-screen
    workspace.CurrentCamera:GetPropertyChangedSignal("ViewportSize"):Connect(function()
        local vp2 = workspace.CurrentCamera.ViewportSize
        local currentSize = main.AbsoluteSize
        if currentSize.X > vp2.X - 20 or currentSize.Y > vp2.Y - 20 then
            local newW = math.min(currentSize.X, vp2.X - 20)
            local newH = math.min(currentSize.Y, vp2.Y - 20)
            main.Size = UDim2.fromOffset(newW, newH)
            main.Position = UDim2.new(0.5, -newW/2, 0.5, -newH/2)
        end
    end)

    return {
        Main = main,
        TabBar = tabBar,
        TabContent = tabContent
    }
end

-- ============================================================================
-- MAIN API - CreateWindow, Notify, Themes
-- ============================================================================
function GGH:CreateWindow(options)
    options = options or {}

    local parent = GetParent()

    local screenGui = Util:Create("ScreenGui", {
        Name = "GGH_" .. (options.Title or "Window") .. "_" .. tostring(math.random(1000,9999)),
        ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
        ResetOnSpawn = false,
        IgnoreGuiInset = true,
        Parent = parent
    })

    Notification:Init(screenGui)

    local windowParts = BuildWindow(screenGui, options)
    local tabs = {}
    local tabList = {}

    local WindowObject = {}
    WindowObject.Gui = screenGui
    WindowObject.Main = windowParts.Main

    function WindowObject:CreateTab(name)
        local th = Theme.Current

        local tabButton = Util:Create("TextButton", {
            Text = name,
            Font = Enum.Font.GothamBold,
            TextSize = 12,
            TextColor3 = th.Sub,
            BackgroundColor3 = th.Panel,
            BackgroundTransparency = 0.4,
            Size = UDim2.new(1,0,0,36),
            AutoButtonColor = false,
            TextWrapped = true,
            Parent = windowParts.TabBar
        })
        Util:Corner(tabButton, 9)
        tabButton.AutoLocalize = false

        local page = Util:Create("ScrollingFrame", {
            Name = name .. "_Page",
            BackgroundTransparency = 1,
            Size = UDim2.fromScale(1,1),
            Visible = false,
            ScrollBarThickness = 3,
            CanvasSize = UDim2.new(0,0,0,0),
            AutomaticCanvasSize = Enum.AutomaticSize.Y,
            ScrollingDirection = Enum.ScrollingDirection.Y,
            Parent = windowParts.TabContent
        })
        Util:List(page, Enum.FillDirection.Vertical, 8)
        Util:Padding(page, {12,12,12,60})

        local tabObject = {
            Button = tabButton,
            Page = page,
            Name = name
        }

        tabButton.MouseButton1Click:Connect(function()
            for _, t in pairs(tabs) do
                t.Page.Visible = false
                t.Button.BackgroundColor3 = th.Panel
                t.Button.TextColor3 = th.Sub
                t.Button.BackgroundTransparency = 0.4
            end
            page.Visible = true
            tabButton.BackgroundColor3 = th.Accent
            tabButton.TextColor3 = Color3.fromRGB(255,255,255)
            tabButton.BackgroundTransparency = 0
        end)

        if #tabList == 0 then
            tabButton.BackgroundColor3 = th.Accent
            tabButton.TextColor3 = Color3.fromRGB(255,255,255)
            tabButton.BackgroundTransparency = 0
            page.Visible = true
        end

        tabs[name] = tabObject
        table.insert(tabList, tabObject)

        -- Element Creation Methods
        function tabObject:CreateButton(opts) return CreateButtonElement(page, opts) end
        function tabObject:CreateToggle(opts) return CreateToggleElement(page, opts) end
        function tabObject:CreateSlider(opts) return CreateSliderElement(page, opts) end
        function tabObject:CreateDropdown(opts) return CreateDropdownElement(page, opts) end
        function tabObject:CreateTextbox(opts) return CreateTextboxElement(page, opts) end
        function tabObject:CreateColorPicker(opts) return CreateColorPickerElement(page, opts) end
        function tabObject:CreateKeybind(opts) return CreateKeybindElement(page, opts) end
        function tabObject:CreateParagraph(opts) return CreateParagraphElement(page, opts) end
        function tabObject:CreateSection(name) return CreateSectionElement(page, name) end
        function tabObject:CreateDivider() return CreateDividerElement(page) end
        function tabObject:CreateProgress(opts) return CreateProgressElement(page, opts) end

        -- Aliases for compatibility
        tabObject.CreateLabel = tabObject.CreateSection

        return tabObject
    end

    function WindowObject:Notify(opts)
        return Notification:Notify(opts)
    end

    function WindowObject:SetTheme(name)
        Theme:Set(name)
    end

    function WindowObject:CreateThemeEditor()
        local editor = self:CreateTab("Themes")
        editor:CreateParagraph({
            Title = "15 Premium Themes",
            Content = "All themes have guaranteed high contrast text. Click to apply instantly with glow and border updates."
        })
        editor:CreateDivider()
        for themeName, _ in pairs(Theme.Themes) do
            editor:CreateButton({
                Name = themeName,
                Callback = function()
                    Theme:Set(themeName)
                end
            })
        end
        return editor
    end

    -- Theme listener for tab buttons
    Theme:OnChanged(function(newTheme)
        for _, tab in ipairs(tabList) do
            if tab.Page.Visible then
                tab.Button.BackgroundColor3 = newTheme.Accent
                tab.Button.TextColor3 = Color3.fromRGB(255,255,255)
                tab.Button.BackgroundTransparency = 0
            else
                tab.Button.BackgroundColor3 = newTheme.Panel
                tab.Button.TextColor3 = newTheme.Sub
                tab.Button.BackgroundTransparency = 0.4
            end
        end
    end)

    return WindowObject
end

function GGH:Notify(options)
    return Notification:Notify(options)
end

function GGH:SetTheme(name)
    Theme:Set(name)
end

GGH.Themes = Theme.Themes
GGH.Theme = Theme

return GGH
