        -- [عنصر 2] مفتاح تشغيل/إيقاف (Toggle)
        function TabObj:CreateToggle(Config)
            local State = Config.Default or false
            local Tog = Instance.new("TextButton")
            Tog.Size = UDim2.new(1, -10, 0, 35)
            Tog.BackgroundColor3 = CurrentTheme.Container
            Tog.Text = (Config.Name or "Toggle") .. " : " .. (State and "[ON]" or "[OFF]")
            Tog.TextColor3 = State and CurrentTheme.Accent or CurrentTheme.Text
            Tog.Parent = TabPage
            Instance.new("UICorner", Tog).CornerRadius = UDim.new(0, 6)

            Tog.MouseButton1Click:Connect(function()
                State = not State
                Tog.Text = (Config.Name or "Toggle") .. " : " .. (State and "[ON]" or "[OFF]")
                Tog.TextColor3 = State and CurrentTheme.Accent or CurrentTheme.Text
                pcall(Config.Callback or function() end, State)
            end)
            return Tog
        end

