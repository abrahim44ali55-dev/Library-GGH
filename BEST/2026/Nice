        BackgroundColor3 = th.Accent,
        Size = UDim2.fromOffset(85,38),
        AutoButtonColor = false,
        Parent = btnRow
    })
    Util:Corner(applyBtn, 10)
    applyBtn.AutoLocalize = false

    local function UpdatePreview()
        local color = Color3.fromHSV(currentH, currentS, currentV)
        preview.BackgroundColor3 = color
        svContainer.BackgroundColor3 = Color3.fromHSV(currentH,1,1)
        whiteGrad.Color = ColorSequence.new{
            ColorSequenceKeypoint.new(0, Color3.new(1,1,1)),
            ColorSequenceKeypoint.new(1, Color3.fromHSV(currentH,1,1))
        }
        -- Update text color for contrast
        local lum = (color.R*0.299 + color.G*0.587 + color.B*0.114)
        previewLabel.TextColor3 = lum > 0.5 and Color3.new(0,0,0) or Color3.new(1,1,1)
    end

