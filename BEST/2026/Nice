-- MyWindUI - Inspired by WindUI
-- ضع هذا في ملف واحد واعمله ModuleScript

local MyUI = {}
MyUI.__index = MyUI

local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")

local Creator = {}
function Creator.New(className, props, children)
    local inst = Instance.new(className)
    for k,v in pairs(props or {}) do
        if k ~= "ThemeTag" then
            pcall(function() inst[k] = v end)
        end
    end
    for _, child in pairs(children or {}) do
        child.Parent = inst
    end
    return inst
end

function MyUI:CreateWindow(config)
    config = config or {}
    local Title = config.Title or "My Hub"
    local Author = config.Author or "by You"

    -- ScreenGui
    local ScreenGui = Creator.New("ScreenGui", {
        Name = Title,
        ResetOnSpawn = false,
        ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
        Parent = game.CoreGui
    })

    -- Main Blur Frame
    local Main = Creator.New("Frame", {
        Size = UDim2.new(0, 580, 0, 420),
        Position = UDim2.new(0.5, -290, 0.5, -210),
        BackgroundColor3 = Color3.fromRGB(20, 20, 22),
        BackgroundTransparency = 0.1,
        BorderSizePixel = 0,
        Parent = ScreenGui
    }, {
        Creator.New("UICorner", {CornerRadius = UDim.new(0, 14)}),
        Creator.New("UIStroke", {Color = Color3.fromRGB(60,60,65), Thickness = 1, Transparency = 0.5})
    })

    -- Acrylic Effect (WindUI Style)
    local blur = Creator.New("Frame", {
        Size = UDim2.new(1,0,1,0),
        BackgroundColor3 = Color3.fromRGB(28,28,30),
        BackgroundTransparency = 0.2,
        ZIndex = 0,
        Parent = Main
    }, {
        Creator.New("UICorner", {CornerRadius = UDim.new(0, 14)})
    })

    -- TopBar
    local TopBar = Creator.New("Frame", {
        Size = UDim2.new(1,0,0,45),
        BackgroundTransparency = 1,
        Parent = Main
    })
    Creator.New("TextLabel", {
        Text = Title,
        Font = Enum.Font.GothamBold,
        TextSize = 16,
        TextColor3 = Color3.new(1,1,1),
        Position = UDim2.new(0, 18, 0, 8),
        Size = UDim2.new(0, 200, 0, 20),
        BackgroundTransparency = 1,
        Parent = TopBar
    })
    Creator.New("TextLabel", {
        Text = Author,
        Font = Enum.Font.Gotham,
        TextSize = 12,
        TextColor3 = Color3.fromRGB(150,150,150),
        Position = UDim2.new(0, 18, 0, 26),
        Size = UDim2.new(0, 200, 0, 12),
        BackgroundTransparency = 1,
        Parent = TopBar
    })

    -- Tab Holder
    local TabHolder = Creator.New("Frame", {
        Size = UDim2.new(0, 140, 1, -60),
        Position = UDim2.new(0, 10, 0, 50),
        BackgroundTransparency = 1,
        Parent = Main
    }, { Creator.New("UIListLayout", {Padding = UDim.new(0, 6), SortOrder = Enum.SortOrder.LayoutOrder}) })

    local ContentHolder = Creator.New("Frame", {
        Size = UDim2.new(1, -165, 1, -60),
        Position = UDim2.new(0, 155, 0, 50),
        BackgroundColor3 = Color3.fromRGB(32,32,35),
        Parent = Main
    }, {
        Creator.New("UICorner", {CornerRadius = UDim.new(0, 10)}),
        Creator.New("UIPadding", {PaddingTop = UDim.new(0,10), PaddingLeft = UDim.new(0,10), PaddingRight = UDim.new(0,10), PaddingBottom = UDim.new(0,10)})
    })

    -- Dragging
    local dragging, dragStart, startPos
    TopBar.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            dragging = true
            dragStart = input.Position
            startPos = Main.Position
        end
    end)
    UserInputService.InputChanged:Connect(function(input)
        if dragging and input.UserInputType == Enum.UserInputType.MouseMovement then
            local delta = input.Position - dragStart
            Main.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
        end
    end)
    UserInputService.InputEnded:Connect(function(input) if input.UserInputType == Enum.UserInputType.MouseButton1 then dragging = false end end)

    local Window = {}
    local firstTab = true

    function Window:Tab(tabConfig)
        local tabName = tabConfig.Title or "Tab"
        local tabIcon = tabConfig.Icon or "rbxassetid://0"

        local TabButton = Creator.New("TextButton", {
            Size = UDim2.new(1,0,0,36),
            BackgroundColor3 = Color3.fromRGB(35,35,38),
            Text = " "..tabName,
            Font = Enum.Font.GothamMedium,
            TextSize = 13,
            TextColor3 = Color3.fromRGB(180,180,180),
            TextXAlignment = Enum.TextXAlignment.Left,
            Parent = TabHolder
        }, { Creator.New("UICorner", {CornerRadius = UDim.new(0, 8)}) })

        local TabContent = Creator.New("ScrollingFrame", {
            Size = UDim2.new(1,0,1,0),
            BackgroundTransparency = 1,
            CanvasSize = UDim2.new(0,0,0),
            ScrollBarThickness = 2,
            Visible = false,
            Parent = ContentHolder
        }, { Creator.New("UIListLayout", {Padding = UDim.new(0, 10)}), Creator.New("UIPadding", {PaddingBottom = UDim.new(0,20)}) })

        TabContent:WaitForChild("UIListLayout"):GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
            TabContent.CanvasSize = UDim2.new(0,0,0,TabContent.UIListLayout.AbsoluteContentSize.Y + 20)
        end)

        TabButton.MouseButton1Click:Connect(function()
            for _,v in pairs(ContentHolder:GetChildren()) do if v:IsA("ScrollingFrame") then v.Visible = false end end
            for _,v in pairs(TabHolder:GetChildren()) do if v:IsA("TextButton") then TweenService:Create(v, TweenInfo.new(0.2), {BackgroundColor3 = Color3.fromRGB(35,35,38)}):Play() end end
            TabContent.Visible = true
            TweenService:Create(TabButton, TweenInfo.new(0.2), {BackgroundColor3 = Color3.fromRGB(55,55,60)}):Play()
        end)

        if firstTab then
            TabContent.Visible = true
            TabButton.BackgroundColor3 = Color3.fromRGB(55,55,60)
            firstTab = false
        end

        local Tab = {}
        function Tab:Section(secConfig)
            local SectionFrame = Creator.New("Frame", {
                Size = UDim2.new(1,-5,0,40),
                BackgroundColor3 = Color3.fromRGB(40,40,43),
                AutomaticSize = Enum.AutomaticSize.Y,
                Parent = TabContent
            }, {
                Creator.New("UICorner", {CornerRadius = UDim.new(0, 8)}),
                Creator.New("UIPadding", {PaddingTop = UDim.new(0,10), PaddingLeft = UDim.new(0,12), PaddingRight = UDim.new(0,12), PaddingBottom = UDim.new(0,10)}),
                Creator.New("UIListLayout", {Padding = UDim.new(0, 8)})
            })
            Creator.New("TextLabel", {
                Text = secConfig.Title or "Section",
                Font = Enum.Font.GothamBold,
                TextSize = 13,
                TextColor3 = Color3.new(1,1,1),
                Size = UDim2.new(1,0,0,18),
                BackgroundTransparency = 1,
                TextXAlignment = Enum.TextXAlignment.Left,
                Parent = SectionFrame
            })

            local Section = {}
            function Section:Button(btnConfig)
                local B = Creator.New("TextButton", {
                    Size = UDim2.new(1,0,0,34),
                    BackgroundColor3 = Color3.fromRGB(55,55,60),
                    Text = btnConfig.Title or "Button",
                    Font = Enum.Font.GothamMedium,
                    TextSize = 13,
                    TextColor3 = Color3.new(1,1,1),
                    Parent = SectionFrame
                }, { Creator.New("UICorner", {CornerRadius = UDim.new(0, 6)}) })
                B.MouseButton1Click:Connect(function() if btnConfig.Callback then btnConfig.Callback() end end)
                return B
            end
            function Section:Toggle(togConfig)
                local state = togConfig.Default or false
                local T = Creator.New("TextButton", {
                    Size = UDim2.new(1,0,0,34),
                    BackgroundColor3 = Color3.fromRGB(55,55,60),
                    Text = "",
                    Parent = SectionFrame
                }, { Creator.New("UICorner", {CornerRadius = UDim.new(0, 6)}) })
                local Label = Creator.New("TextLabel", { Text = togConfig.Title or "Toggle", BackgroundTransparency = 1, Size = UDim2.new(0.7,0,1,0), Position = UDim2.new(0,10,0,0), TextXAlignment = Left, Font = Enum.Font.Gotham, TextSize = 13, TextColor3 = Color3.new(1,1,1), Parent = T })
                local Dot = Creator.New("Frame", { Size = UDim2.new(0,20,0,20), Position = UDim2.new(1,-30,0.5,-10), BackgroundColor3 = state and Color3.fromRGB(90, 150, 255) or Color3.fromRGB(70,70,70), Parent = T }, { Creator.New("UICorner", {CornerRadius = UDim.new(1,0)}) })
                T.MouseButton1Click:Connect(function()
                    state = not state
                    TweenService:Create(Dot, TweenInfo.new(0.2), {BackgroundColor3 = state and Color3.fromRGB(90,150,255) or Color3.fromRGB(70,70,70)}):Play()
                    if togConfig.Callback then togConfig.Callback(state) end
                end)
            end
            function Section:Slider(sliConfig)
                -- نفس فكرة الـ Toggle تكدر تضيفها هنا
            end
            return Section
        end
        return Tab
    end
    return Window
end

return MyUI
