function GGH_Window:_createControlButton(name, iconName, order, theme, isClose)
    local button = Instance.new("TextButton")
    button.Name = name .. "Button"
    button.Size = UDim2.fromOffset(32, 28)
    button.LayoutOrder = order
    button.BackgroundColor3 = isClose and Color3.fromRGB(239, 68, 68) or theme.BackgroundTertiary or Color3.fromRGB(32, 32, 44)
    button.BackgroundTransparency = isClose and 0.85 or 0.6
    button.BorderSizePixel = 0
    button.Text = ""
    button.AutoButtonColor = false
    button.Parent = self.controlsContainer

    self.themeModule:CreateCorner(button, theme.Radius.Small)

    local baseColor = isClose and Color3.fromRGB(239, 68, 68) or theme.TextSecondary
    local icon = GGH_Icons:CreateIcon(iconName, button, UDim2.fromOffset(14, 14), baseColor)
    icon.Name = "Icon"
    icon.Position = UDim2.fromScale(0.5, 0.5)
    icon.AnchorPoint = Vector2.new(0.5, 0.5)

    self:Connect(button.MouseEnter, function()
        if not self:_isInteractive() then return end
        if isClose then
            self.themeModule:Tween(button, {BackgroundTransparency = 0.1}, 0.15)
            GGH_Icons:SetColor(icon, Color3.fromRGB(255, 255, 255))
        else
            self.themeModule:Tween(button, {BackgroundTransparency = 0.2, BackgroundColor3 = theme.BackgroundHover or Color3.fromRGB(40, 40, 56)}, 0.15)
            GGH_Icons:SetColor(icon, theme.TextPrimary)
        end
    end)
    self:Connect(button.MouseLeave, function()
        if isClose then
            self.themeModule:Tween(button, {BackgroundTransparency = 0.85}, 0.15)
        else
            self.themeModule:Tween(button, {BackgroundTransparency = 0.6}, 0.15)
        end
        GGH_Icons:SetColor(icon, baseColor)
    end)

    button:SetAttribute("ControlType", name)
    return button
end

function GGH_Window:_setupDragging()
    local dragging = false
    local dragStart, startPos

    self:Connect(self.header.InputBegan, function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            if self.state == self.States.Closed then return end
            dragging = true
            dragStart = input.Position
            startPos = self.mainFrame.Position
        end
    end)

    self:Connect(UserInputService.InputChanged, function(input)
        if not dragging then return end
        if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
            local delta = input.Position - dragStart
            self.mainFrame.Position = UDim2.new(
                startPos.X.Scale, startPos.X.Offset + delta.X,
                startPos.Y.Scale, startPos.Y.Offset + delta.Y
            )
        end
    end)

    self:Connect(UserInputService.InputEnded, function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = false
        end
    end)
end

function GGH_Window:_setupKeybind()
    self:Connect(UserInputService.InputBegan, function(input, gameProcessed)
        if gameProcessed then return end
        if input.UserInputType ~= Enum.UserInputType.Keyboard then return end
        if input.KeyCode == self.config.ToggleUIKeybind then
            if self.state == self.States.Minimized then
                self:Restore()
            elseif self.state == self.States.Normal or self.state == self.States.HeaderOnly then
                self:Minimize()
            end
        end
    end)

    self:Connect(self.collapseButton.MouseButton1Click, function()
        self:ToggleSidebarCompact()
    end)
end

function GGH_Window:_setupStateMachine()
    self:Connect(self.closeButton.MouseButton1Click, function()
        if self.state == self.States.Closed then return end
        self:ShowCloseConfirmation()
    end)

    self:Connect(self.minimizeButton.MouseButton1Click, function()
        if self.state == self.States.Minimized then
            self:Restore()
        else
            self:Minimize()
        end
    end)

    self:Connect(self.headerOnlyButton.MouseButton1Click, function()
        self:ToggleHeaderOnly()
    end)
end

function GGH_Window:_isInteractive()
    return self.state ~= self.States.Closed and not self.destroyed
end

function GGH_Window:_animateIn()
    local T = self.themeModule
    self.mainFrame.ClipsDescendants = true
    self.mainFrame.Size = UDim2.fromOffset(0, 0)
    self.mainFrame.BackgroundTransparency = 1
    T:Tween(self.mainFrame, {Size = self.config.Size, BackgroundTransparency = 0}, 0.35)
    task.delay(0.4, function()
        if self.mainFrame and self.mainFrame.Parent then
            self.mainFrame.ClipsDescendants = false
        end
    end)
end

-- Applies a window state (Normal / Minimized / HeaderOnly)
function GGH_Window:_applyState(state)
    if self.state == self.States.Closed or self.destroyed then return end
    local T = self.themeModule
    local full = self.config.Size
    self.state = state

    if state == self.States.Normal then
        T:Tween(self.mainFrame, {Size = full}, 0.3)
        T:Tween(self.contentContainer, {Size = UDim2.new(1, 0, 1, -56)}, 0.3)
        self.headerFix.Visible = true
    elseif state == self.States.Minimized then
        T:Tween(self.contentContainer, {Size = UDim2.new(1, 0, 0, 0)}, 0.25)
        T:Tween(self.mainFrame, {Size = UDim2.fromOffset(300, 56)}, 0.3)
        self.headerFix.Visible = false
    elseif state == self.States.HeaderOnly then
        T:Tween(self.contentContainer, {Size = UDim2.new(1, 0, 0, 0)}, 0.25)
        T:Tween(self.mainFrame, {Size = UDim2.new(full.X.Scale, full.X.Offset, 0, 56)}, 0.3)
        self.headerFix.Visible = false
    end

    self.minimizeButton:SetAttribute("Minimized", state == self.States.Minimized)
    self.headerOnlyButton:SetAttribute("HeaderOnly", state == self.States.HeaderOnly)
end

function GGH_Window:Minimize()
    if self.state == self.States.Minimized then return end
    self:_applyState(self.States.Minimized)
end

function GGH_Window:Restore()
    if self.state == self.States.Normal then return end
    self:_applyState(self.States.Normal)
end

function GGH_Window:ToggleHeaderOnly()
    if self.state == self.States.HeaderOnly then
        self:_applyState(self.States.Normal)
    else
        self:_applyState(self.States.HeaderOnly)
    end
end

function GGH_Window:ToggleSidebarCompact()
    self.sidebarCompact = not self.sidebarCompact
    local targetWidth = self.sidebarCompact and self.sidebarWidthCompact or self.sidebarWidthExpanded

    self.themeModule:Tween(self.sidebar, {Size = UDim2.new(0, targetWidth, 1, 0)}, 0.25)
    self.themeModule:Tween(self.contentArea, {Size = UDim2.new(1, -targetWidth, 1, 0), Position = UDim2.new(0, targetWidth, 0, 0)}, 0.25)

    for _, tab in ipairs(self.tabs) do
        if tab.SetCompact then
            tab:SetCompact(self.sidebarCompact)
        end
    end
end


