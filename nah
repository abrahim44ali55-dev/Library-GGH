        descLabel.Size = UDim2.new(1, -textOffset - 20, 0, 12)
        descLabel.Position = UDim2.new(0, textOffset, 0, 24)
        descLabel.BackgroundTransparency = 1
        descLabel.Text = props.Description or props.description or ""
        descLabel.TextColor3 = theme.TextSecondary
        descLabel.TextXAlignment = Enum.TextXAlignment.Left
        descLabel.Font = Enum.Font.Gotham
        descLabel.TextSize = 11
        descLabel.Parent = content
    end
    
    -- Clickable button
    local button = Instance.new("TextButton")
    button.Name = "Button"
    button.Size = UDim2.fromScale(1,1)
    button.BackgroundTransparency = 1
    button.Text = ""
    button.Parent = main
    
    local debounce = false
    local disabled = props.Disabled or false
    
    local function setDisabled(state)
        disabled = state
        main.BackgroundTransparency = state and 0.6 or 0.15
        titleLabel.TextTransparency = state and 0.5 or 0
        button.Active = not state
    end
    
    setDisabled(disabled)
    
    window:Connect(button.MouseEnter, function()
        if disabled or not window:_isInteractive() then return end
        themeModule:Tween(hoverOverlay, {BackgroundTransparency = 0.6}, 0.15)
        themeModule:Tween(stroke, {Transparency = 0}, 0.15)
    end)
    
    window:Connect(button.MouseLeave, function()
        themeModule:Tween(hoverOverlay, {BackgroundTransparency = 1}, 0.15)
        themeModule:Tween(stroke, {Transparency = 0.3}, 0.15)
    end)
    
    window:Connect(button.MouseButton1Down, function()
        if disabled then return end
        themeModule:Tween(main, {Size = UDim2.new(1, -18, 0, 42)}, 0.08)
    end)
    
    window:Connect(button.MouseButton1Up, function()
        themeModule:Tween(main, {Size = UDim2.new(1, -16, 0, 44)}, 0.08)
    end)
    
    window:Connect(button.MouseButton1Click, function()
        if disabled or debounce then return end
        debounce = true
        -- Press animation
        themeModule:Tween(main, {BackgroundColor3 = theme.Accent}, 0.08)
        task.wait(0.08)
        themeModule:Tween(main, {BackgroundColor3 = theme.ElementBackground}, 0.15)
        
        if props.Callback or props.callback then
            local cb = props.Callback or props.callback
            window:_runGuarded({Name = main.Name}, cb)
        end
        
        task.wait(0.2)
        debounce = false
    end)
    
    table.insert(tab.components, main)
    
    local api = {}
    api.Frame = main
    api.Name = main.Name
    function api:SetText(text)
        titleLabel.Text = text
    end
    function api:SetDisabled(state)
        setDisabled(state)
    end
    function api:Destroy()
        if main.Parent then main:Destroy() end
    end
    function api:SetCallback(cb)
        props.Callback = cb
    end
    
    return api
end

-- TOGGLE - Modern switch with smooth animation
function GGH_Components.CreateToggle(tab, props)
    props = props or {}
    local theme = tab.theme
    local themeModule = tab.themeModule
    local window = tab.window
    
    local currentValue = props.CurrentValue or props.currentValue or props.Default or false
    if props.Flag then window.flags[props.Flag] = currentValue end
    
    local main = Instance.new("Frame")
    main.Name = props.Name or props.name or "Toggle"
    main.Size = UDim2.new(1, -16, 0, 46)
    main.BackgroundColor3 = theme.BackgroundTertiary or Color3.fromRGB(28,28,36)
    main.BackgroundTransparency = 0.1
    main.BorderSizePixel = 0
    main.Parent = tab.content
    main.LayoutOrder = #tab.components + 1
    
    themeModule:CreateCorner(main, theme.Radius.Medium)
    local stroke = themeModule:CreateStroke(main, theme.Border, 1, 0.3)
    
    local titleLabel = Instance.new("TextLabel")
    titleLabel.Name = "Title"
    titleLabel.Size = UDim2.new(1, -70, 0, 18)
    titleLabel.Position = UDim2.new(0, 12, 0, 8)
    titleLabel.BackgroundTransparency = 1
    titleLabel.Text = props.Name or props.name or "Toggle"
    titleLabel.TextColor3 = theme.TextPrimary
    titleLabel.TextXAlignment = Enum.TextXAlignment.Left
    titleLabel.Font = Enum.Font.GothamMedium
    titleLabel.TextSize = 13
    titleLabel.Parent = main
    
    local descLabel
    if props.Description then
        descLabel = Instance.new("TextLabel")
        descLabel.Size = UDim2.new(1, -70, 0, 12)
        descLabel.Position = UDim2.new(0, 12, 0, 26)
        descLabel.BackgroundTransparency = 1
        descLabel.Text = props.Description
        descLabel.TextColor3 = theme.TextSecondary
        descLabel.TextXAlignment = Enum.TextXAlignment.Left
        descLabel.Font = Enum.Font.Gotham
        descLabel.TextSize = 11
        descLabel.Parent = main
    end
    
    -- Toggle Track
    local track = Instance.new("Frame")
    track.Name = "Track"
    track.Size = UDim2.fromOffset(44, 24)
    track.Position = UDim2.new(1, -56, 0.5, 0)
    track.AnchorPoint = Vector2.new(0, 0.5)
    track.BackgroundColor3 = currentValue and (theme.ToggleOn or theme.Accent) or (theme.ToggleOff or Color3.fromRGB(50,50,65))
    track.BorderSizePixel = 0
    track.Parent = main
    themeModule:CreateCorner(track, 12)
    
    -- Thumb
    local thumb = Instance.new("Frame")
    thumb.Name = "Thumb"
    thumb.Size = UDim2.fromOffset(18, 18)
    thumb.Position = currentValue and UDim2.new(1, -21, 0.5, 0) or UDim2.new(0, 3, 0.5, 0)
    thumb.AnchorPoint = Vector2.new(0, 0.5)
    thumb.BackgroundColor3 = Color3.fromRGB(255,255,255)
    thumb.BorderSizePixel = 0
    thumb.Parent = track
    themeModule:CreateCorner(thumb, 9)
    
    -- Shadow
    local thumbStroke = Instance.new("UIStroke")
    thumbStroke.Color = Color3.fromRGB(0,0,0)
    thumbStroke.Transparency = 0.8
    thumbStroke.Thickness = 1
    thumbStroke.Parent = thumb
    
    local button = Instance.new("TextButton")
    button.Size = UDim2.fromScale(1,1)
    button.BackgroundTransparency = 1
    button.Text = ""
    button.Parent = main
    
    local function updateVisual(value, animate)
        currentValue = value
        local targetColor = value and (theme.ToggleOn or theme.Accent) or (theme.ToggleOff or Color3.fromRGB(50,50,65))
        local targetPos = value and UDim2.new(1, -21, 0.5, 0) or UDim2.new(0, 3, 0.5, 0)
        
        if animate then
            themeModule:Tween(track, {BackgroundColor3 = targetColor}, 0.25)
            themeModule:Tween(thumb, {Position = targetPos}, 0.25)
        else
            track.BackgroundColor3 = targetColor
            thumb.Position = targetPos
        end
        
        if props.Flag then window.flags[props.Flag] = value end
    end
    
    local function setValue(value, callCallback)
        if callCallback == nil then callCallback = true end
        updateVisual(value, true)
        if callCallback and (props.Callback or props.callback) then
            local cb = props.Callback or props.callback
            window:_runGuarded({Name = main.Name, Value = value}, function()
                cb(value)
            end)
        end
        -- Register active feature for cleanup
        if value then
            window:RegisterFeature(main.Name, {
                Stop = function()
                    updateVisual(false, true)
                end
            })
            window:RegisterOriginalState(main.Name .. "_toggle", false, function()
                updateVisual(false, false)
            end)
        else
            window:UnregisterFeature(main.Name)
        end
    end
    
    window:Connect(button.MouseButton1Click, function()
        setValue(not currentValue, true)
    end)
    
    window:Connect(button.MouseEnter, function()
        themeModule:Tween(stroke, {Transparency = 0, Color = theme.BorderHover or theme.Border}, 0.15)
    end)
    window:Connect(button.MouseLeave, function()
        themeModule:Tween(stroke, {Transparency = 0.3}, 0.15)
    end)
    
    -- Initial sync
    updateVisual(currentValue, false)
    if currentValue then
        window:RegisterFeature(main.Name, {Stop = function() updateVisual(false, true) end})
    end
    
    table.insert(tab.components, main)
    
    local api = {}
    api.Frame = main
    api.Value = currentValue
    api.Name = main.Name
    function api:Set(value)
        setValue(value, false)
    end
    function api:SetValue(value) -- Compatibility
        setValue(value, true)
    end
    function api:Get()
        return currentValue
    end
    function api:Destroy()
        if main.Parent then main:Destroy() end
        window:UnregisterFeature(main.Name)
    end
    
    return api
end

-- SLIDER - Modern with thumb and value display
function GGH_Components.CreateSlider(tab, props)
    props = props or {}
    local theme = tab.theme
    local themeModule = tab.themeModule
    local window = tab.window
    
    local min = props.Min or props.min or props.Range and props.Range[1] or 0
    local max = props.Max or props.max or props.Range and props.Range[2] or 100
    local increment = props.Increment or props.increment or 1
    local current = props.CurrentValue or props.currentValue or props.Default or min
    current = math.clamp(current, min, max)
    
    local main = Instance.new("Frame")
    main.Name = props.Name or "Slider"
    main.Size = UDim2.new(1, -16, 0, 58)
    main.BackgroundColor3 = theme.BackgroundTertiary or Color3.fromRGB(28,28,36)
    main.BackgroundTransparency = 0.1
    main.BorderSizePixel = 0
    main.Parent = tab.content
    main.LayoutOrder = #tab.components + 1
    themeModule:CreateCorner(main, theme.Radius.Medium)
    themeModule:CreateStroke(main, theme.Border, 1, 0.3)
    
    local title = Instance.new("TextLabel")
    title.Size = UDim2.new(1, -80, 0, 16)
    title.Position = UDim2.new(0, 12, 0, 8)
    title.BackgroundTransparency = 1
    title.Text = props.Name or "Slider"
    title.TextColor3 = theme.TextPrimary
    title.TextXAlignment = Enum.TextXAlignment.Left
    title.Font = Enum.Font.GothamMedium
    title.TextSize = 13
    title.Parent = main
    
    local valueLabel = Instance.new("TextLabel")
    valueLabel.Name = "Value"
    valueLabel.Size = UDim2.fromOffset(60, 18)
    valueLabel.Position = UDim2.new(1, -68, 0, 7)
    valueLabel.BackgroundColor3 = theme.BackgroundSecondary or Color3.fromRGB(22,22,28)
    valueLabel.Text = tostring(current)
    valueLabel.TextColor3 = theme.TextPrimary
    valueLabel.Font = Enum.Font.GothamMedium
    valueLabel.TextSize = 12
    valueLabel.Parent = main
    themeModule:CreateCorner(valueLabel, theme.Radius.Small)
    
    -- Track
    local track = Instance.new("Frame")
    track.Name = "Track"
    track.Size = UDim2.new(1, -24, 0, 4)
    track.Position = UDim2.new(0, 12, 0, 36)
    track.BackgroundColor3 = theme.SliderTrack or Color3.fromRGB(40,40,55)
    track.BorderSizePixel = 0
    track.Parent = main
    themeModule:CreateCorner(track, 2)
    
    local fill = Instance.new("Frame")
    fill.Name = "Fill"
    fill.Size = UDim2.new((current - min) / (max - min), 0, 1, 0)
    fill.BackgroundColor3 = theme.SliderFill or theme.Accent
    fill.BorderSizePixel = 0
    fill.Parent = track
    themeModule:CreateCorner(fill, 2)
    
    local thumb = Instance.new("Frame")
    thumb.Name = "Thumb"
    thumb.Size = UDim2.fromOffset(16, 16)
    thumb.Position = UDim2.new((current - min) / (max - min), 0, 0.5, 0)
    thumb.AnchorPoint = Vector2.new(0.5, 0.5)
    thumb.BackgroundColor3 = theme.SliderThumb or Color3.fromRGB(255,255,255)
    thumb.BorderSizePixel = 0
    thumb.Parent = track
    themeModule:CreateCorner(thumb, 8)
    local thumbStroke = themeModule:CreateStroke(thumb, theme.Border, 1, 0.5)
    
    local dragging = false
    
    local function updateValue(newValue, callCallback)
        if callCallback == nil then callCallback = true end
        newValue = math.clamp(newValue, min, max)
        -- Snap to increment
        if increment ~= 0 then
            newValue = math.floor((newValue - min) / increment + 0.5) * increment + min
        end
        newValue = math.clamp(newValue, min, max)
        current = newValue
        valueLabel.Text = tostring(math.floor(newValue * 100) / 100)
        local ratio = (newValue - min) / (max - min)
        if dragging then
            fill.Size = UDim2.new(ratio, 0, 1, 0)
            thumb.Position = UDim2.new(ratio, 0, 0.5, 0)
        else
            themeModule:Tween(fill, {Size = UDim2.new(ratio, 0, 1, 0)}, 0.15)
            themeModule:Tween(thumb, {Position = UDim2.new(ratio, 0, 0.5, 0)}, 0.15)
        end
        if props.Flag then window.flags[props.Flag] = newValue end
        if callCallback and (props.Callback or props.callback) then
            local cb = props.Callback or props.callback
            -- Throttle: only call if not dragging too frequently
            window:_runGuarded({Name = main.Name, Value = newValue}, function()
                cb(newValue)
            end)
        end
    end
    
    local function getValueFromPosition(xPos)
        local trackAbsPos = track.AbsolutePosition
        local trackAbsSize = track.AbsoluteSize
        local relative = math.clamp((xPos - trackAbsPos.X) / trackAbsSize.X, 0, 1)
        return min + relative * (max - min)
    end
    
    window:Connect(track.InputBegan, function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            local val = getValueFromPosition(input.Position.X)
            updateValue(val, true)
            themeModule:Tween(thumb, {Size = UDim2.fromOffset(20,20)}, 0.1)
        end
    end)
    
    window:Connect(UserInputService.InputChanged, function(input)
        if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
            local val = getValueFromPosition(input.Position.X)
            updateValue(val, true)
        end
    end)
    
    window:Connect(UserInputService.InputEnded, function(input)
        if dragging and (input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch) then
            dragging = false
            themeModule:Tween(thumb, {Size = UDim2.fromOffset(16,16)}, 0.1)
        end
    end)
    
    -- Also make thumb draggable
    window:Connect(thumb.InputBegan, function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            dragging = true
        end
    end)
    
    table.insert(tab.components, main)
    
    local api = {}
    api.Frame = main
    api.Value = current
    function api:Set(value)
        updateValue(value, false)
    end
    function api:SetValue(v)
        updateValue(v, true)
    end
    function api:Get()
        return current
    end
    function api:Destroy()
        if main.Parent then main:Destroy() end
    end
    
    return api
end

