-- Works with both  GGH:CreateWindow({...})  and  GGH.CreateWindow({...})
function GGH.CreateWindow(selfOrConfig, maybeConfig)
    local config = selfOrConfig
    if selfOrConfig == GGH then
        config = maybeConfig
    end
    if type(config) ~= "table" then
        config = {}
    end

    config.Name = config.Name or "GGH UI Library"
    config.Subtitle = config.Subtitle or "Developed by AM_BRCR7"
    config.Theme = config.Theme or "GGH Dark"

    local window = GGH_Window.new(config, {
        Theme = GGH_Theme,
        Icons = GGH_Icons,
        Tab = GGH_Tab,
        Components = GGH_Components
    })

    table.insert(GGH.Windows, window)
    return window
end

function GGH:LoadConfiguration()
    for _, window in ipairs(self.Windows) do
        if not window.destroyed then
            window:LoadConfiguration()
        end
    end
end

function GGH:Notify(props)
    for i = #self.Windows, 1, -1 do
        local window = self.Windows[i]
        if not window.destroyed then
            return window:Notify(props)
        end
    end
end

function GGH:Destroy()
    for _, window in ipairs(self.Windows) do
        if not window.destroyed then
            window:Destroy()
        end
    end
    self.Windows = {}
end

function GGH:GetIdentity()
    return {
        Name = self.Name,
        DisplayName = self.DisplayName,
        Developer = self.Developer,
        Version = self.Version,
        Identity = self.Identity
    }
end

return GGH
