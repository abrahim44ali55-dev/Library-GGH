function GGH_Tab:_createComponent(typeName, props)
    local creator = self._componentsModule and self._componentsModule[typeName]
    if not creator then
        warn("[GGH] Unknown component: " .. tostring(typeName))
        return {}
    end
    if type(props) ~= "table" then props = {} end
    local ok, result = pcall(creator, self, props)
    if not ok then
        warn("[GGH] Failed to create " .. tostring(typeName) .. ": " .. tostring(result))
        return {}
    end
    return result
end

