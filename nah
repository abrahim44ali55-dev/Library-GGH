local GGH_Window = (function()
-- GGH UI Library - GGH_Window
-- Developer: AM_BRCR7
-- Professional Window System with State Machine & Cleanup Lifecycle

local GGH_Window = {}
GGH_Window.__index = GGH_Window

local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")
local RunService = game:GetService("RunService")

-- Dependencies (will be required dynamically)
local GGH_Theme
local GGH_Icons
local GGH_Tab

-- Window State Machine
GGH_Window.States = {
    Normal = "Normal",
    Minimized = "Minimized",
    HeaderOnly = "HeaderOnly",
    Closed = "Closed"
}

GGH_Window.Transitions = {
    [GGH_Window.States.Normal] = {GGH_Window.States.Minimized, GGH_Window.States.HeaderOnly, GGH_Window.States.Closed},
    [GGH_Window.States.Minimized] = {GGH_Window.States.Normal, GGH_Window.States.Closed},
    [GGH_Window.States.HeaderOnly] = {GGH_Window.States.Normal, GGH_Window.States.Minimized, GGH_Window.States.Closed},
    [GGH_Window.States.Closed] = {}
}

function GGH_Window:CanTransition(from, to)
    local allowed = self.Transitions[from]
    if not allowed then return false end
    for _, state in ipairs(allowed) do
        if state == to then return true end
    end
    return false
end

-- Utility: Get GUI parent (executor compatible)
local function getGuiParent()
    local success, result = pcall(function()
        if gethui then return gethui() end
        if get_hidden_gui then return get_hidden_gui() end
        return game:GetService("CoreGui")
    end)
    if success and result then return result end
    
    local player = game:GetService("Players").LocalPlayer
    if player then
        return player:WaitForChild("PlayerGui")
    end
    return game:GetService("CoreGui")
end

function GGH_Window.new(config, dependencies)
    local self = setmetatable({}, GGH_Window)
    
    -- Load dependencies
    if dependencies then
        GGH_Theme = dependencies.Theme
        GGH_Icons = dependencies.Icons
        GGH_Tab = dependencies.Tab
    else
        -- Fallback requires
        local function safeRequire(path)
            local ok, mod = pcall(require, path)
            return ok and mod or nil
        end
        GGH_Theme = safeRequire(script.Parent:WaitForChild("GGH_Theme")) or safeRequire(script.Parent.Parent:WaitForChild("GGH_Theme"))
        GGH_Icons = safeRequire(script.Parent:WaitForChild("GGH_Icons")) or safeRequire(script.Parent.Parent:WaitForChild("GGH_Icons"))
        -- Tab will be lazy loaded
    end
    
    if not GGH_Theme then
        -- Minimal fallback theme if module missing
        GGH_Theme = {Default = {
            Background = Color3.fromRGB(14,14,18),
            BackgroundSecondary = Color3.fromRGB(22,22,28),
            BackgroundTertiary = Color3.fromRGB(28,28,36),
            TextPrimary = Color3.fromRGB(245,245,255),
            TextSecondary = Color3.fromRGB(160,165,180),
