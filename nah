        }}
        GGH_Theme.Default = GGH_Theme.Default or GGH_Theme
        function GGH_Theme:GetTheme() return self.Default end
        function GGH_Theme:CreateCorner(parent, r) local c=Instance.new("UICorner") c.CornerRadius=UDim.new(0,r or 8) c.Parent=parent return c end
        function GGH_Theme:CreateStroke(parent, col, thick) local s=Instance.new("UIStroke") s.Color=col or Color3.fromRGB(45,45,60) s.Thickness=thick or 1 s.Parent=parent return s end
        function GGH_Theme:CreatePadding(parent, pad) local p=Instance.new("UIPadding") p.PaddingTop=UDim.new(0,pad or 8) p.PaddingBottom=UDim.new(0,pad or 8) p.PaddingLeft=UDim.new(0,pad or 8) p.PaddingRight=UDim.new(0,pad or 8) p.Parent=parent return p end
        function GGH_Theme:Tween(obj, props, dur) local tw=TweenService:Create(obj, TweenInfo.new(dur or 0.25, Enum.EasingStyle.Quint, Enum.EasingDirection.Out), props) tw:Play() return tw end
    end
    
    if not GGH_Icons then
        GGH_Icons = {Assets={}, RobloxAssetMap={}, Get=function() return "" end, GetRobloxAsset=function() return "rbxassetid://0" end, CreateIcon=function(_,_,parent) local f=Instance.new("Frame") f.Size=UDim2.fromOffset(20,20) f.BackgroundTransparency=1 f.Parent=parent return f end, ApplyToImageLabel=function() end}
    end
    
    -- Config with defaults
    config = config or {}
    self.config = {
        Name = config.Name or "GGH UI Library",
        Subtitle = config.Subtitle or "Developed by AM_BRCR7",
        LoadingTitle = config.LoadingTitle or "GGH UI Library",
