        descLabel.Name = "Description"
    end

    local button = makeClickArea(main)
    button.Name = "Button"

    local debounce = false
    local disabled = props.Disabled == true

    local function setDisabled(state)
        disabled = state == true
        main.BackgroundTransparency = disabled and 0.6 or 0.15
        titleLabel.TextTransparency = disabled and 0.5 or 0
