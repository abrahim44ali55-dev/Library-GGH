local function make(className, props, parent)
	local inst = Instance.new(className)
	for key, value in pairs(props) do
		inst[key] = value
	end
	inst.Parent = parent
	return inst
end

local function round(inst, radius)
	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0, radius)
	corner.Parent = inst
	return corner
end

local function outline(inst, thickness)
	local line = Instance.new("UIStroke")
	line.Thickness = thickness
	line.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
	line.Parent = inst
	return line
end

local function tween(inst, props, duration, style, direction)
	local playing = TweenService:Create(inst, TweenInfo.new(duration or 0.14, style or Enum.EasingStyle.Quad, direction or Enum.EasingDirection.Out), props)
	playing:Play()
	return playing
end

local function paintProps(inst, props, animate, duration, style, direction)
	if animate then
		return tween(inst, props, duration, style, direction)
	end
	for key, value in pairs(props) do
		inst[key] = value
	end
	return nil
end

local function fire(callback, ...)
	if type(callback) ~= "function" then
		return
	end
	local ok, err = pcall(callback, ...)
	if not ok then
		warn("GGH callback error: " .. tostring(err))
	end
end

local function applyFont(inst, font)
	pcall(function()
		if typeof(font) == "Font" then
			inst.FontFace = font
		else
			inst.Font = font
		end
	end)
end

local function isPointer(input)
	return input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch
end

local function isMove(input)
	return input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch
end

local function copyList(list)
	local result = {}
	for index, value in ipairs(list) do
		result[index] = value
	end
	return result
end

local function shade(inst)
	make("UIGradient", {
		Rotation = 90,
		Color = ColorSequence.new(WHITE, Color3.fromRGB(196, 196, 196)),
	}, inst)
end

local Cleanup = {}
Cleanup.__index = Cleanup

local function runTask(item)
	local kind = typeof(item)
	if kind == "RBXScriptConnection" then
		item:Disconnect()
	elseif kind == "Instance" then
		item:Destroy()
	elseif kind == "function" then
		pcall(item)
	elseif kind == "thread" then
		pcall(task.cancel, item)
	elseif kind == "table" then
		if type(item.Destroy) == "function" then
			pcall(item.Destroy, item)
		elseif type(item.Disconnect) == "function" then
			pcall(item.Disconnect, item)
		end
	end
end

function Cleanup.new()
	return setmetatable({ _tasks = {}, _destroyed = false }, Cleanup)
end

function Cleanup:Add(item)
	if self._destroyed then
		runTask(item)
		return item
	end
	table.insert(self._tasks, item)
	return item
end

function Cleanup:Track(original, restore)
	return self:Add(function()
		restore(original)
	end)
end

function Cleanup:Destroy()
	if self._destroyed then
		return
	end
	self._destroyed = true
	local tasks = self._tasks
	self._tasks = {}
	for index = #tasks, 1, -1 do
		runTask(tasks[index])
	end
end

local Icons = {}

local function bar(parent, color, length, dx, dy, rotation)
	local piece = Instance.new("Frame")
	piece.AnchorPoint = Vector2.new(0.5, 0.5)
	piece.Position = UDim2.new(0.5, dx, 0.5, dy)
	piece.Size = UDim2.fromOffset(length, 2)
	piece.Rotation = rotation
	piece.BackgroundColor3 = color
	piece.BorderSizePixel = 0
	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(1, 0)
	corner.Parent = piece
	piece.Parent = parent
end

local function ring(parent, color, size, dx, dy, thickness)
	local piece = Instance.new("Frame")
	piece.AnchorPoint = Vector2.new(0.5, 0.5)
	piece.Position = UDim2.new(0.5, dx, 0.5, dy)
	piece.Size = UDim2.fromOffset(size, size)
	piece.BackgroundTransparency = 1
	piece.BorderSizePixel = 0
	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(1, 0)
	corner.Parent = piece
	local line = Instance.new("UIStroke")
	line.Color = color
	line.Thickness = thickness
	line.Parent = piece
	piece.Parent = parent
end

