function GGH_Icons:Get(iconName)
    if not iconName then return nil end
    local normalized = string.lower(iconName)
    -- Check direct
    if self.Assets[normalized] then
        return self.Assets[normalized]
    end
    -- Check legacy
    if self.LegacyMap[normalized] then
        return self.Assets[self.LegacyMap[normalized]]
    end
    return nil
end

function GGH_Icons:GetRobloxAsset(iconName)
    if not iconName then return "rbxassetid://0" end
    local normalized = string.lower(iconName)
    if self.RobloxAssetMap[normalized] then
        return self.RobloxAssetMap[normalized]
    end
    if self.LegacyMap[normalized] and self.RobloxAssetMap[self.LegacyMap[normalized]] then
        return self.RobloxAssetMap[self.LegacyMap[normalized]]
    end
    -- Default fallback to a generic icon
    return "rbxassetid://6031090997"
end

function GGH_Icons:Exists(iconName)
    return self:Get(iconName) ~= nil
end

function GGH_Icons:GetAllNames()
    local names = {}
    for name, _ in pairs(self.Assets) do
        table.insert(names, name)
    end
    return names
end

-- Tint helper: recolors every element of an icon that is flagged "IconTint"
function GGH_Icons:SetColor(iconFrame, color)
    if not iconFrame or not color then return end
    for _, d in ipairs(iconFrame:GetDescendants()) do
        if d:GetAttribute("IconTint") then
            if d:IsA("ImageLabel") then
                d.ImageColor3 = color
            elseif d:IsA("TextLabel") then
                d.TextColor3 = color
            elseif d:IsA("UIStroke") then
                d.Color = color
            elseif d:IsA("Frame") then
                d.BackgroundColor3 = color
            end
        end
    end
end

local function makeBar(parent, color, size, position, rotation)
    local bar = Instance.new("Frame")
    bar.Name = "Bar"
    bar.AnchorPoint = Vector2.new(0.5, 0.5)
    bar.Position = position or UDim2.fromScale(0.5, 0.5)
    bar.Size = size
    bar.Rotation = rotation or 0
    bar.BorderSizePixel = 0
    bar.BackgroundColor3 = color
    bar.Parent = parent
    bar:SetAttribute("IconTint", true)
    local c = Instance.new("UICorner")
    c.CornerRadius = UDim.new(0, 1)
    c.Parent = bar
    return bar
end

local function makeBox(parent, color)
    local box = Instance.new("Frame")
    box.Name = "Box"
    box.AnchorPoint = Vector2.new(0.5, 0.5)
    box.Position = UDim2.fromScale(0.5, 0.5)
    box.Size = UDim2.fromScale(0.9, 0.9)
    box.BackgroundTransparency = 1
    box.BorderSizePixel = 0
    box.Parent = parent
    local c = Instance.new("UICorner")
    c.CornerRadius = UDim.new(0, 3)
    c.Parent = box
    local s = Instance.new("UIStroke")
    s.Thickness = 1.5
    s.Color = color
    s.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
    s.Parent = box
    s:SetAttribute("IconTint", true)
    return box
end

-- Creates an icon built only from Roblox UI objects (no external assets needed).
-- iconName: "ggh_logo", "close", "minimize", "layout_sidebar", "header_only",
--           an rbxassetid / number for a custom image, or any other name
--           (shown as a letter badge).
function GGH_Icons:CreateIcon(iconName, parent, size, color)
    iconName = iconName or "settings"
    color = color or Color3.fromRGB(255, 255, 255)
    local name = string.lower(tostring(iconName))

    local iconFrame = Instance.new("Frame")
    iconFrame.Name = "GGH_Icon_" .. name
    iconFrame.BackgroundTransparency = 1
    iconFrame.BorderSizePixel = 0
    iconFrame.Size = size or UDim2.fromOffset(20, 20)
    if parent then
        iconFrame.Parent = parent
    end
    iconFrame:SetAttribute("IconName", name)

    if name == "ggh_logo" then
        iconFrame.Size = size or UDim2.fromOffset(32, 32)
        local glow = Instance.new("Frame")
        glow.Name = "Glow"
        glow.BackgroundColor3 = Color3.fromRGB(56, 189, 248)
        glow.BackgroundTransparency = 0.85
        glow.BorderSizePixel = 0
        glow.Size = UDim2.fromScale(1, 1)
        glow.Position = UDim2.fromScale(0.5, 0.5)
        glow.AnchorPoint = Vector2.new(0.5, 0.5)
        glow.Parent = iconFrame
        local glowCorner = Instance.new("UICorner")
        glowCorner.CornerRadius = UDim.new(0, 8)
        glowCorner.Parent = glow

        local gghLabel = Instance.new("TextLabel")
        gghLabel.Name = "GGH"
        gghLabel.BackgroundTransparency = 1
        gghLabel.Size = UDim2.fromScale(0.8, 0.8)
        gghLabel.Position = UDim2.fromScale(0.5, 0.5)
        gghLabel.AnchorPoint = Vector2.new(0.5, 0.5)
        gghLabel.Text = "GGH"
        gghLabel.TextColor3 = color
        gghLabel.TextScaled = true
        gghLabel.Font = Enum.Font.GothamBold
        gghLabel.Parent = iconFrame

        local accent = Instance.new("Frame")
        accent.Name = "Accent"
        accent.BackgroundColor3 = Color3.fromRGB(56, 189, 248)
        accent.BorderSizePixel = 0
        accent.Size = UDim2.fromOffset(4, 4)
        accent.Position = UDim2.new(0.5, 0, 0, 1)
        accent.AnchorPoint = Vector2.new(0.5, 0)
        accent.Parent = iconFrame
        local accentCorner = Instance.new("UICorner")
        accentCorner.CornerRadius = UDim.new(1, 0)
        accentCorner.Parent = accent

    elseif name == "close" then
        makeBar(iconFrame, color, UDim2.new(1, 0, 0, 2), nil, 45)
        makeBar(iconFrame, color, UDim2.new(1, 0, 0, 2), nil, -45)

    elseif name == "minimize" then
        makeBar(iconFrame, color, UDim2.new(0.8, 0, 0, 2))

    elseif name == "layout_sidebar" then
        makeBox(iconFrame, color)
        makeBar(iconFrame, color, UDim2.new(0, 2, 0.9, 0), UDim2.fromScale(0.38, 0.5))

    elseif name == "header_only" then
        makeBox(iconFrame, color)
        makeBar(iconFrame, color, UDim2.new(0.9, 0, 0, 2), UDim2.fromScale(0.5, 0.36))

    elseif tonumber(name) or string.find(name, "rbxassetid", 1, true) or string.find(name, "rbxasset://", 1, true) then
        local img = Instance.new("ImageLabel")
        img.Name = "IconImage"
        img.BackgroundTransparency = 1
        img.Size = UDim2.fromScale(1, 1)
        img.Image = tonumber(name) and ("rbxassetid://" .. name) or tostring(iconName)
        img.ImageColor3 = color
        img.ScaleType = Enum.ScaleType.Fit
        img.Parent = iconFrame
        img:SetAttribute("IconTint", true)

    else
        -- Letter badge fallback (always renders correctly)
        local box = makeBox(iconFrame, color)
        local letter = Instance.new("TextLabel")
        letter.Name = "Letter"
        letter.BackgroundTransparency = 1
        letter.Size = UDim2.fromScale(1, 1)
        letter.Text = string.upper(string.sub(tostring(iconName), 1, 1))
        letter.TextColor3 = color
        letter.Font = Enum.Font.GothamBold
        letter.TextScaled = true
        letter.Parent = box
        local limit = Instance.new("UITextSizeConstraint")
        limit.MaxTextSize = 12
        limit.MinTextSize = 6
        limit.Parent = letter
        letter:SetAttribute("IconTint", true)
    end

    return iconFrame
end

-- Apply icon to existing ImageLabel (for compatibility)
function GGH_Icons:ApplyToImageLabel(imageLabel, iconName, color)
    if not imageLabel or not imageLabel:IsA("ImageLabel") then return end
    local n = tostring(iconName or "")
    if tonumber(n) then
        imageLabel.Image = "rbxassetid://" .. n
    elseif string.find(n, "rbxasset", 1, true) then
        imageLabel.Image = n
    end
    if color then
        imageLabel.ImageColor3 = color
    end
end

function GGH_Icons:CleanupExternalReferences(gui)
    if not gui then return end
    for _, d in ipairs(gui:GetDescendants()) do
        if d:IsA("ImageLabel") or d:IsA("ImageButton") then
            local img = d.Image
            if img and (string.find(img, "http://", 1, true) or string.find(img, "https://", 1, true)) then
                d.Image = ""
            end
        end
    end
end

return GGH_Icons

end)()

