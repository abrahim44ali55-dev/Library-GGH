function GGH_Theme:GetTheme(name)
    if not name then return self.Default end
    return self.Themes[name] or self.Default
end

function GGH_Theme:GetAllThemes()
    local list = {}
    for name, _ in pairs(self.Themes) do
        table.insert(list, name)
    end
    return list
end

function GGH_Theme:ApplyToFrame(frame, theme, style)
    if not frame or not theme then return end
    style = style or "default"
    
    if style == "window" then
        frame.BackgroundColor3 = theme.Background
        frame.BorderSizePixel = 0
    elseif style == "sidebar" then
        frame.BackgroundColor3 = theme.SidebarBackground
    elseif style == "card" or style == "element" then
        frame.BackgroundColor3 = theme.BackgroundTertiary
        frame.BackgroundTransparency = theme.ElementTransparency or 0.1
    elseif style == "button" then
        frame.BackgroundColor3 = theme.ElementBackground
    elseif style == "input" then
        frame.BackgroundColor3 = theme.BackgroundTertiary
    end
end

function GGH_Theme:CreateCorner(parent, radius)
    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, radius or self.Default.Radius.Medium)
    corner.Parent = parent
    return corner
end

function GGH_Theme:CreateStroke(parent, color, thickness, transparency)
    local stroke = Instance.new("UIStroke")
    stroke.Color = color or self.Default.Border
    stroke.Thickness = thickness or 1
    stroke.Transparency = transparency or 0
    stroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
    stroke.Parent = parent
    return stroke
end

function GGH_Theme:CreatePadding(parent, padding)
    local pad = Instance.new("UIPadding")
    if typeof(padding) == "number" then
        pad.PaddingTop = UDim.new(0, padding)
        pad.PaddingBottom = UDim.new(0, padding)
        pad.PaddingLeft = UDim.new(0, padding)
        pad.PaddingRight = UDim.new(0, padding)
    elseif typeof(padding) == "table" then
        -- Expect {top, right, bottom, left} or similar
        pad.PaddingTop = UDim.new(0, padding[1] or 0)
        pad.PaddingRight = UDim.new(0, padding[2] or padding[1] or 0)
        pad.PaddingBottom = UDim.new(0, padding[3] or padding[1] or 0)
        pad.PaddingLeft = UDim.new(0, padding[4] or padding[2] or padding[1] or 0)
    end
    pad.Parent = parent
    return pad
end

function GGH_Theme:Tween(object, properties, duration, easingStyle, easingDirection)
    local tweenService = game:GetService("TweenService")
    local info = TweenInfo.new(
        duration or self.Default.Animation.Normal,
        easingStyle or self.Default.Animation.Easing,
        easingDirection or self.Default.Animation.Direction
    )
    local tween = tweenService:Create(object, info, properties)
    tween:Play()
    return tween
end

function GGH_Theme:ApplyThemeToHierarchy(root, theme)
    if not root or not theme then return end
    -- Recursive theme application with attribute checking
    for _, descendant in ipairs(root:GetDescendants()) do
        local themeRole = descendant:GetAttribute("ThemeRole")
        if themeRole then
            if themeRole == "Background" then
                if descendant:IsA("Frame") or descendant:IsA("ScrollingFrame") then
                    descendant.BackgroundColor3 = theme.Background
                end
            elseif themeRole == "BackgroundSecondary" then
                if descendant:IsA("Frame") then
                    descendant.BackgroundColor3 = theme.BackgroundSecondary
                end
            elseif themeRole == "TextPrimary" then
                if descendant:IsA("TextLabel") or descendant:IsA("TextButton") or descendant:IsA("TextBox") then
                    descendant.TextColor3 = theme.TextPrimary
                end
            elseif themeRole == "TextSecondary" then
                if descendant:IsA("TextLabel") or descendant:IsA("TextButton") then
                    descendant.TextColor3 = theme.TextSecondary
                end
            elseif themeRole == "Border" then
                if descendant:IsA("UIStroke") then
                    descendant.Color = theme.Border
                end
            elseif themeRole == "Accent" then
                if descendant:IsA("Frame") then
                    descendant.BackgroundColor3 = theme.Accent
                elseif descendant:IsA("TextLabel") then
                    descendant.TextColor3 = theme.Accent
                elseif descendant:IsA("ImageLabel") then
                    descendant.ImageColor3 = theme.Accent
                end
            end
        end
    end
end

return GGH_Theme

end)()
