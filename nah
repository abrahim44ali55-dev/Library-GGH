		percent.TextColor3 = theme.TextDim
		paint(false)
	end)
	function element:Get()
		return value
	end
	function element:Set(newValue)
		value = math.clamp(tonumber(newValue) or 0, 0, 1)
		paint(true)
	end
	return element
