    pcall(function()
        if syn and syn.protect_gui then syn.protect_gui(self.screenGui) end
    end)

    -- Find a parent we are actually allowed to use (executor hidden UI, CoreGui, PlayerGui)
    local parents = {}
    pcall(function()
