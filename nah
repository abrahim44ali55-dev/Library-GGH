-- ================= GGH_Tab =================
local GGH_Tab = {}
GGH_Tab.__index = GGH_Tab

function GGH_Tab.new(window, name, icon, theme, themeModule, iconsModule)
    local self = setmetatable({}, GGH_Tab)
    self.window = window
    self.name = name or "Tab"
    self.iconName = icon or "settings"
    self.theme = theme or window.theme
    self.themeModule = themeModule or window.themeModule
    self.iconsModule = iconsModule
    self.compact = false
    self.components = {}
    self._componentsModule = GGH_Components
    self:_buildTabButton()
    self:_buildContentArea()
    return self
end

function GGH_Tab:_buildTabButton()
    local theme = self.theme
    local window = self.window
    self.button = Instance.new("TextButton")
    self.button.Name = self.name .. "_TabButton"
    self.button.Size = UDim2.new(1, -8, 0, 44)
    self.button.BackgroundColor3 = theme.SidebarBackground
    self.button.BackgroundTransparency = 1
    self.button.BorderSizePixel = 0
    self.button.Text = ""
    self.button.AutoButtonColor = false
    self.button.Parent = window.sidebarScroll
    self.button.LayoutOrder = #window.tabs + 1
    self.themeModule:CreateCorner(self.button, theme.Radius and theme.Radius.Medium or 8)
    self.activeIndicator = Instance.new("Frame")
    self.activeIndicator.Name = "ActiveIndicator"
    self.activeIndicator.Size = UDim2.new(0, 3, 0, 24)
    self.activeIndicator.Position = UDim2.new(0, 0, 0.5, 0)
    self.activeIndicator.AnchorPoint = Vector2.new(0, 0.5)
    self.activeIndicator.BackgroundColor3 = theme.Accent
    self.activeIndicator.BorderSizePixel = 0
    self.activeIndicator.Visible = false
    self.activeIndicator.Parent = self.button
    self.themeModule:CreateCorner(self.activeIndicator, 2)
    self.iconFrame = self.iconsModule:CreateIcon(self.iconName, self.button, UDim2.fromOffset(20,20), theme.TextSecondary)
    self.iconFrame.Name = "TabIcon"
    self.iconFrame.Position = UDim2.new(0, 12, 0.5, 0)
    self.iconFrame.AnchorPoint = Vector2.new(0, 0.5)
    self.label = Instance.new("TextLabel")
    self.label.Name = "TabLabel"
    self.label.Size = UDim2.new(1, -50, 1, 0)
    self.label.Position = UDim2.new(0, 42, 0, 0)
    self.label.BackgroundTransparency = 1
    self.label.Text = self.name
    self.label.TextColor3 = theme.TextSecondary
    self.label.TextXAlignment = Enum.TextXAlignment.Left
    self.label.TextYAlignment = Enum.TextYAlignment.Center
    self.label.Font = Enum.Font.GothamMedium
    self.label.TextSize = 13
    self.label.TextTruncate = Enum.TextTruncate.AtEnd
    self.label.Parent = self.button
    window:Connect(self.button.MouseEnter, function()
        if window.selectedTab == self then return end
        window.themeModule:Tween(self.button, {BackgroundTransparency = 0.4, BackgroundColor3 = theme.SidebarItemHover or Color3.fromRGB(28,28,38)}, 0.15)
        window.themeModule:Tween(self.label, {TextColor3 = theme.TextPrimary}, 0.15)
    end)
    window:Connect(self.button.MouseLeave, function()
        if window.selectedTab == self then return end
        window.themeModule:Tween(self.button, {BackgroundTransparency = 1}, 0.15)
        window.themeModule:Tween(self.label, {TextColor3 = theme.TextSecondary}, 0.15)
    end)
    window:Connect(self.button.MouseButton1Click, function()
        window:SelectTab(self)
    end)
    window:Connect(self.button.MouseButton1Down, function()
        window.themeModule:Tween(self.button, {Size = UDim2.new(1, -10, 0, 42)}, 0.08)
    end)
    window:Connect(self.button.MouseButton1Up, function()
        window.themeModule:Tween(self.button, {Size = UDim2.new(1, -8, 0, 44)}, 0.08)
    end)
end

function GGH_Tab:_buildContentArea()
    local theme = self.theme
    local window = self.window
    self.content = Instance.new("ScrollingFrame")
    self.content.Name = self.name .. "_Content"
    self.content.Size = UDim2.fromScale(1, 1)
    self.content.BackgroundTransparency = 1
    self.content.BorderSizePixel = 0
    self.content.CanvasSize = UDim2.new(0, 0, 0, 0)
    self.content.ScrollBarThickness = 3
    self.content.ScrollBarImageColor3 = theme.Border
    self.content.ScrollingDirection = Enum.ScrollingDirection.Y
    self.content.Visible = false
    self.content.Parent = window.contentArea
    self.layout = Instance.new("UIListLayout")
    self.layout.FillDirection = Enum.FillDirection.Vertical
    self.layout.SortOrder = Enum.SortOrder.LayoutOrder
    self.layout.Padding = UDim.new(0, 10)
    self.layout.Parent = self.content
    self.padding = self.themeModule:CreatePadding(self.content, 16)
    window:Connect(self.layout:GetPropertyChangedSignal("AbsoluteContentSize"), function()
        self.content.CanvasSize = UDim2.new(0, 0, 0, self.layout.AbsoluteContentSize.Y + 32)
    end)
end

function GGH_Tab:OnSelected()
    self.activeIndicator.Visible = true
    self.themeModule:Tween(self.activeIndicator, {Size = UDim2.new(0, 3, 0, 24)}, 0.2)
end

function GGH_Tab:OnDeselected()
    self.activeIndicator.Visible = false
end

function GGH_Tab:SetCompact(compact)
    self.compact = compact
    if compact then
        self.label.Visible = false
        self.button.Size = UDim2.new(1, -8, 0, 44)
        self.iconFrame.Position = UDim2.new(0.5, 0, 0.5, 0)
        self.iconFrame.AnchorPoint = Vector2.new(0.5, 0.5)
    else
        self.label.Visible = true
        self.iconFrame.Position = UDim2.new(0, 12, 0.5, 0)
        self.iconFrame.AnchorPoint = Vector2.new(0, 0.5)
    end
end

function GGH_Tab:CreateSection(name)
    local theme = self.theme
    local sectionFrame = Instance.new("Frame")
    sectionFrame.Name = name .. "_Section"
    sectionFrame.Size = UDim2.new(1, 0, 0, 30)
    sectionFrame.BackgroundTransparency = 1
    sectionFrame.Parent = self.content
    sectionFrame.LayoutOrder = #self.components + 1
    local sectionLabel = Instance.new("TextLabel")
    sectionLabel.Size = UDim2.new(1, 0, 1, 0)
    sectionLabel.BackgroundTransparency = 1
    sectionLabel.Text = string.upper(name)
    sectionLabel.TextColor3 = theme.TextTertiary or theme.TextSecondary
    sectionLabel.TextXAlignment = Enum.TextXAlignment.Left
    sectionLabel.Font = Enum.Font.GothamBold
    sectionLabel.TextSize = 11
    sectionLabel.Parent = sectionFrame
    local divider = Instance.new("Frame")
    divider.Size = UDim2.new(1, 0, 0, 1)
    divider.Position = UDim2.new(0, 0, 1, -1)
    divider.BackgroundColor3 = theme.Divider or theme.Border
    divider.BorderSizePixel = 0
    divider.Parent = sectionFrame
    table.insert(self.components, sectionFrame)
    return {
        Name = name,
        Frame = sectionFrame,
        SetText = function(_, text) sectionLabel.Text = string.upper(text) end,
        Destroy = function() if sectionFrame.Parent then sectionFrame:Destroy() end end
    }
end

function GGH_Tab:_createComponent(typeName, props)
    if self._componentsModule and self._componentsModule[typeName] then
        return self._componentsModule[typeName](self, props)
    end
    return {}
end

