function GGH_Window:_createControlButton(name, iconName, order, theme, isClose)
    local button = Instance.new("TextButton")
    button.Name = name .. "Button"
    button.Size = UDim2.fromOffset(32, 28)
    button.LayoutOrder = order
    button.BackgroundColor3 = isClose and Color3.fromRGB(239, 68, 68) or theme.BackgroundTertiary or Color3.fromRGB(32,32,44)
    button.BackgroundTransparency = isClose and 0.9 or 0.6
    button.Text = ""
    button.AutoButtonColor = false
    button.Parent = self.controlsContainer
    
    self.themeModule:CreateCorner(button, theme.Radius and theme.Radius.Small or 6)
    
    local icon = GGH_Icons:CreateIcon(iconName, button, UDim2.fromOffset(16, 16), isClose and Color3.fromRGB(239,68,68) or theme.TextSecondary)
    icon.Name = "Icon"
    icon.Position = UDim2.fromScale(0.5, 0.5)
    icon.AnchorPoint = Vector2.new(0.5, 0.5)
    
    -- Hover effects
    self:Connect(button.MouseEnter, function()
        if not self:_isInteractive() then return end
        if isClose then
            self.themeModule:Tween(button, {BackgroundTransparency = 0.2, BackgroundColor3 = Color3.fromRGB(239,68,68)}, 0.15)
            self.themeModule:Tween(icon, {Rotation = 90}, 0.15)
            -- Change icon color to white
            for _, desc in ipairs(icon:GetDescendants()) do
                if desc:IsA("ImageLabel") then
                    self.themeModule:Tween(desc, {ImageColor3 = Color3.fromRGB(255,255,255)}, 0.15)
                end
            end
        else
            self.themeModule:Tween(button, {BackgroundTransparency = 0.2, BackgroundColor3 = theme.BackgroundHover or Color3.fromRGB(40,40,56)}, 0.15)
        end
    end)
    
    self:Connect(button.MouseLeave, function()
        if isClose then
            self.themeModule:Tween(button, {BackgroundTransparency = 0.9, BackgroundColor3 = Color3.fromRGB(239, 68, 68)}, 0.15)
            self.themeModule:Tween(icon, {Rotation = 0}, 0.15)
            for _, desc in ipairs(icon:GetDescendants()) do
                if desc:IsA("ImageLabel") then
                    self.themeModule:Tween(desc, {ImageColor3 = Color3.fromRGB(239,68,68)}, 0.15)
                end
            end
        else
            self.themeModule:Tween(button, {BackgroundTransparency = 0.6}, 0.15)
        end
    end)
    
    self:Connect(button.MouseButton1Down, function()
        self.themeModule:Tween(button, {Size = UDim2.fromOffset(30, 26)}, 0.08)
    end)
    
    self:Connect(button.MouseButton1Up, function()
        self.themeModule:Tween(button, {Size = UDim2.fromOffset(32, 28)}, 0.08)
    end)
    
    -- Click handlers (assigned later in _setupStateMachine)
    button:SetAttribute("ControlType", name)
    
    return button
end

function GGH_Window:_setupDragging()
    local dragging = false
    local dragStart, startPos
    
    self:Connect(self.header.InputBegan, function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            if self.state ~= self.States.Normal and self.state ~= self.States.HeaderOnly then return end
            dragging = true
            dragStart = input.Position
            startPos = self.mainFrame.Position
            
            local conn
            conn = UserInputService.InputChanged:Connect(function(inp)
                if inp.UserInputType == Enum.UserInputType.MouseMovement or inp.UserInputType == Enum.UserInputType.Touch then
                    if dragging then
                        local delta = inp.Position - dragStart
                        local newPos = UDim2.new(
                            startPos.X.Scale,
                            startPos.X.Offset + delta.X,
                            startPos.Y.Scale,
                            startPos.Y.Offset + delta.Y
                        )
                        self.mainFrame.Position = newPos
                    end
                end
            end)
            
            local function endDrag()
                dragging = false
                if conn then conn:Disconnect() end
            end
            
            self:Connect(input.Changed, function()
                if input.UserInputState == Enum.UserInputState.End then
                    endDrag()
                end
            end)
        end
    end)
end

function GGH_Window:_setupKeybind()
    self:Connect(UserInputService.InputBegan, function(input, gameProcessed)
        if gameProcessed then return end
        if input.KeyCode == self.config.ToggleUIKeybind then
            if self.state == self.States.Minimized then
                self:Restore()
            elseif self.state == self.States.Normal or self.state == self.States.HeaderOnly then
                self:Minimize()
            end
        end
    end)
    
    -- Collapse toggle
    self:Connect(self.collapseButton.MouseButton1Click, function()
        self:ToggleSidebarCompact()
    end)
end

function GGH_Window:_setupStateMachine()
    -- Close Button -> Confirmation
    self:Connect(self.closeButton.MouseButton1Click, function()
        if self.state == self.States.Closed then return end
        self:ShowCloseConfirmation()
    end)
    
    -- Minimize Full
    self:Connect(self.minimizeButton.MouseButton1Click, function()
        if self.state == self.States.Minimized then
            self:Restore()
        else
            self:Minimize()
        end
    end)
    
    -- Header-only
    self:Connect(self.headerOnlyButton.MouseButton1Click, function()
        if self.state == self.States.HeaderOnly then
            self:Restore()
        else
            self:ToggleHeaderOnly()
        end
    end)
end

function GGH_Window:_isInteractive()
    return self.state ~= self.States.Closed and not self.destroyed
end

function GGH_Window:_animateIn()
    self.mainFrame.Size = UDim2.fromOffset(0, 0)
    self.mainFrame.BackgroundTransparency = 1
    self.themeModule:Tween(self.mainFrame, {Size = self.config.Size, BackgroundTransparency = 0}, 0.35)
    task.wait(0.05)
    self.mainFrame.ClipsDescendants = false
end

-- State Transitions
function GGH_Window:Minimize()
    if not self:CanTransition(self.state, self.States.Minimized) then return end
    if self.state == self.States.Minimized then return end
    
    self.previousState = self.state
    self.previousSize = self.mainFrame.Size
    self.previousPosition = self.mainFrame.Position
    self.state = self.States.Minimized
    
    -- Animate to minimized bar
    local minimizedSize = UDim2.fromOffset(240, 48)
    self.themeModule:Tween(self.contentContainer, {Size = UDim2.new(1,0,0,0)}, 0.25)
    self.themeModule:Tween(self.mainFrame, {Size = minimizedSize}, 0.3)
    
    -- Show minimized indicator
    self.minimizeButton:SetAttribute("Minimized", true)
    
    -- Do NOT stop features - per requirement
end

function GGH_Window:Restore()
    if self.state == self.States.Normal then return end
    if self.state == self.States.Closed then return end
    
    local targetState = self.States.Normal
    if not self:CanTransition(self.state, targetState) then
        -- Try to go to Normal from any via intermediate if needed
        if self.state == self.States.Minimized or self.state == self.States.HeaderOnly then
            -- Allowed
        else
            return
        end
    end
    
    self.state = targetState
    
    -- Restore size
    local restoreSize = self.previousSize or self.config.Size
    self.themeModule:Tween(self.mainFrame, {Size = restoreSize}, 0.3)
    task.wait(0.1)
    self.themeModule:Tween(self.contentContainer, {Size = UDim2.new(1,0,1,-56)}, 0.25)
    
    self.minimizeButton:SetAttribute("Minimized", false)
    self.headerOnlyButton:SetAttribute("HeaderOnly", false)
end

function GGH_Window:ToggleHeaderOnly()
    if self.state == self.States.HeaderOnly then
        self:Restore()
        return
    end
    
    if not self:CanTransition(self.state, self.States.HeaderOnly) then return end
    
    self.previousState = self.state
    self.previousSize = self.mainFrame.Size
    self.state = self.States.HeaderOnly
    
    -- Keep header, hide tabs and content only
    self.themeModule:Tween(self.contentContainer, {Size = UDim2.new(1,0,0,0)}, 0.25)
    task.wait(0.05)
    self.themeModule:Tween(self.mainFrame, {Size = UDim2.new(self.mainFrame.Size.X, UDim.new(0, 56))}, 0.3)
    
    self.headerOnlyButton:SetAttribute("HeaderOnly", true)
end

function GGH_Window:ToggleSidebarCompact()
    self.sidebarCompact = not self.sidebarCompact
    local targetWidth = self.sidebarCompact and self.sidebarWidthCompact or self.sidebarWidthExpanded
    
    self.themeModule:Tween(self.sidebar, {Size = UDim2.new(0, targetWidth, 1, 0)}, 0.25)
    self.themeModule:Tween(self.contentArea, {Size = UDim2.new(1, -targetWidth, 1, 0), Position = UDim2.new(0, targetWidth, 0, 0)}, 0.25)
    
    -- Update tab buttons for compact mode
    for _, tab in ipairs(self.tabs) do
        if tab.SetCompact then
            tab:SetCompact(self.sidebarCompact)
        end
    end
end

