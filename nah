function GGH_Components.CreateSlider(tab, props)
    props = props or {}
    local theme = tab.theme
    local themeModule = tab.themeModule
    local window = tab.window
    local name = props.Name or props.name or "Slider"
    local suffix = props.Suffix or props.suffix
    local range = props.Range or props.range

    local min = props.Min or props.min or (range and range[1]) or 0
    local max = props.Max or props.max or (range and range[2]) or 100
    if max == min then max = min + 1 end
    local increment = props.Increment or props.increment or 1
    local current = props.CurrentValue
    if current == nil then current = props.currentValue end
    if current == nil then current = props.Default end
    if current == nil then current = min end
    current = math.clamp(current, min, max)

    local main = createCard(tab, name, 58)

    makeLabel(main, name, theme.TextPrimary, Enum.Font.GothamMedium, 13,
        UDim2.new(1, -100, 0, 16), UDim2.new(0, 12, 0, 8)).Name = "Title"

    local function formatValue(v)
        local text = tostring(math.floor(v * 100 + 0.5) / 100)
        if suffix then text = text .. " " .. tostring(suffix) end
        return text
    end

    local valueLabel = Instance.new("TextLabel")
    valueLabel.Name = "Value"
    valueLabel.Size = UDim2.fromOffset(80, 18)
    valueLabel.Position = UDim2.new(1, -88, 0, 7)
    valueLabel.BackgroundColor3 = theme.BackgroundSecondary or Color3.fromRGB(22, 22, 28)
    valueLabel.BorderSizePixel = 0
    valueLabel.Text = formatValue(current)
    valueLabel.TextColor3 = theme.TextPrimary
    valueLabel.Font = Enum.Font.GothamMedium
    valueLabel.TextSize = 12
    valueLabel.Parent = main
    themeModule:CreateCorner(valueLabel, theme.Radius.Small)

    local track = Instance.new("Frame")
    track.Name = "Track"
    track.Size = UDim2.new(1, -24, 0, 4)
    track.Position = UDim2.new(0, 12, 0, 38)
    track.BackgroundColor3 = theme.SliderTrack or Color3.fromRGB(40, 40, 55)
    track.BorderSizePixel = 0
    track.Parent = main
    themeModule:CreateCorner(track, 2)

    local ratio0 = (current - min) / (max - min)
    local fill = Instance.new("Frame")
    fill.Name = "Fill"
    fill.Size = UDim2.new(ratio0, 0, 1, 0)
    fill.BackgroundColor3 = theme.SliderFill or theme.Accent
    fill.BorderSizePixel = 0
    fill.Parent = track
    themeModule:CreateCorner(fill, 2)

    local thumb = Instance.new("Frame")
    thumb.Name = "Thumb"
    thumb.Size = UDim2.fromOffset(16, 16)
    thumb.Position = UDim2.new(ratio0, 0, 0.5, 0)
    thumb.AnchorPoint = Vector2.new(0.5, 0.5)
    thumb.BackgroundColor3 = theme.SliderThumb or Color3.fromRGB(255, 255, 255)
    thumb.BorderSizePixel = 0
    thumb.Parent = track
    themeModule:CreateCorner(thumb, 8)

    -- Large invisible hit area so the slider is easy to grab
    local hit = Instance.new("TextButton")
    hit.Name = "HitArea"
    hit.Size = UDim2.new(1, -8, 0, 26)
    hit.Position = UDim2.new(0, 4, 0, 28)
    hit.BackgroundTransparency = 1
    hit.BorderSizePixel = 0
    hit.Text = ""
    hit.AutoButtonColor = false
    hit.Parent = main

    local dragging = false
    local lastFired = nil

    local function setValue(newValue, callCallback)
        newValue = math.clamp(newValue, min, max)
        if increment ~= 0 then
            newValue = math.floor((newValue - min) / increment + 0.5) * increment + min
        end
        newValue = math.clamp(newValue, min, max)
        current = newValue
        valueLabel.Text = formatValue(newValue)
        local ratio = (newValue - min) / (max - min)
        if dragging then
            fill.Size = UDim2.new(ratio, 0, 1, 0)
            thumb.Position = UDim2.new(ratio, 0, 0.5, 0)
        else
            themeModule:Tween(fill, {Size = UDim2.new(ratio, 0, 1, 0)}, 0.15)
            themeModule:Tween(thumb, {Position = UDim2.new(ratio, 0, 0.5, 0)}, 0.15)
        end
        window:_setFlag(props.Flag, newValue)
        if callCallback and lastFired ~= newValue then
            lastFired = newValue
            fireCallback(window, name, getCallback(props), newValue)
        end
    end

    local function valueFromX(x)
        local pos = track.AbsolutePosition.X
        local width = math.max(track.AbsoluteSize.X, 1)
        local r = math.clamp((x - pos) / width, 0, 1)
        return min + r * (max - min)
    end

    window:Connect(hit.InputBegan, function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            themeModule:Tween(thumb, {Size = UDim2.fromOffset(20, 20)}, 0.1)
            setValue(valueFromX(input.Position.X), true)
        end
    end)
    window:Connect(UserInputService.InputChanged, function(input)
        if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
            setValue(valueFromX(input.Position.X), true)
        end
    end)
    window:Connect(UserInputService.InputEnded, function(input)
        if dragging and (input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch) then
            dragging = false
            themeModule:Tween(thumb, {Size = UDim2.fromOffset(16, 16)}, 0.1)
        end
    end)

    window:_setFlag(props.Flag, current, true)
    table.insert(tab.components, main)

    local api = {}
    api.Frame = main
    api.Name = name
    function api:Set(value) lastFired = nil; setValue(value, false) end
    function api:SetValue(value) setValue(value, true) end
    function api:Get() return current end
    function api:Destroy() if main.Parent then main:Destroy() end end
    if props.Flag then
        window.flagSetters[props.Flag] = function(v) setValue(tonumber(v) or current, true) end
    end
    return api
end

