-- ================= GGH_Tab =================
local GGH_Tab = {}
GGH_Tab.__index = GGH_Tab

function GGH_Tab.new(window, name, icon, theme, themeModule, iconsModule)
    local self = setmetatable({}, GGH_Tab)
    self.window = window
    self.name = name or "Tab"
    self.Name = self.name
    self.iconName = icon or string.sub(self.name, 1, 1)
    self.theme = theme or window.theme
    self.themeModule = themeModule or window.themeModule
    self.iconsModule = iconsModule
    self.compact = false
    self.components = {}
    self._componentsModule = GGH_Components
    self:_buildTabButton()
    self:_buildContentArea()
    -- Aliases used by the window (SelectTab reads Button / Content)
    self.Button = self.button
    self.Content = self.content
    return self
end

function GGH_Tab:_buildTabButton()
    local theme = self.theme
    local window = self.window
    self.button = Instance.new("TextButton")
    self.button.Name = self.name .. "_TabButton"
    self.button.Size = UDim2.new(1, -8, 0, 44)
    self.button.BackgroundColor3 = theme.SidebarBackground
    self.button.BackgroundTransparency = 1
    self.button.BorderSizePixel = 0
    self.button.Text = ""
    self.button.AutoButtonColor = false
    self.button.LayoutOrder = #window.tabs + 1
    self.button.Parent = window.sidebarScroll
    self.themeModule:CreateCorner(self.button, theme.Radius and theme.Radius.Medium or 8)

    self.activeIndicator = Instance.new("Frame")
    self.activeIndicator.Name = "ActiveIndicator"
    self.activeIndicator.Size = UDim2.new(0, 3, 0, 24)
    self.activeIndicator.Position = UDim2.new(0, 0, 0.5, 0)
    self.activeIndicator.AnchorPoint = Vector2.new(0, 0.5)
    self.activeIndicator.BackgroundColor3 = theme.Accent
    self.activeIndicator.BorderSizePixel = 0
    self.activeIndicator.Visible = false
    self.activeIndicator.Parent = self.button
    self.themeModule:CreateCorner(self.activeIndicator, 2)

    self.iconFrame = self.iconsModule:CreateIcon(self.iconName, self.button, UDim2.fromOffset(20, 20), theme.TextSecondary)
    self.iconFrame.Name = "TabIcon"
    self.iconFrame.Position = UDim2.new(0, 12, 0.5, 0)
