    local function openPicker()
        -- Create simple RGB picker
        local pickerOverlay = Instance.new("Frame")
        pickerOverlay.Name = "ColorPickerPopup"
        pickerOverlay.Size = UDim2.fromOffset(200, 160)
        pickerOverlay.Position = UDim2.fromScale(0.5, 0.5)
        pickerOverlay.AnchorPoint = Vector2.new(0.5, 0.5)
        pickerOverlay.BackgroundColor3 = theme.BackgroundSecondary
        pickerOverlay.BorderSizePixel = 0
        pickerOverlay.ZIndex = 10
        pickerOverlay.Parent = window.screenGui
        themeModule:CreateCorner(pickerOverlay, theme.Radius.Large)
        themeModule:CreateStroke(pickerOverlay, theme.Border, 1)
        themeModule:CreatePadding(pickerOverlay, 12)
        
        local r, g, b = math.floor(currentColor.R * 255), math.floor(currentColor.G * 255), math.floor(currentColor.B * 255)
        
        local function createRGBSlider(name, value, yPos)
            local label = Instance.new("TextLabel")
            label.Size = UDim2.new(0, 20, 0, 20)
            label.Position = UDim2.new(0, 0, 0, yPos)
            label.BackgroundTransparency = 1
            label.Text = name
            label.TextColor3 = theme.TextPrimary
            label.Font = Enum.Font.GothamBold
            label.TextSize = 12
            label.Parent = pickerOverlay
            
            local sliderTrack = Instance.new("Frame")
            sliderTrack.Size = UDim2.new(1, -60, 0, 4)
            sliderTrack.Position = UDim2.new(0, 30, 0, yPos + 8)
            sliderTrack.BackgroundColor3 = Color3.fromRGB(60,60,75)
            sliderTrack.Parent = pickerOverlay
            themeModule:CreateCorner(sliderTrack, 2)
            
            local fill = Instance.new("Frame")
            fill.Size = UDim2.new(value / 255, 0, 1, 0)
            fill.BackgroundColor3 = (name == "R" and Color3.fromRGB(239,68,68)) or (name == "G" and Color3.fromRGB(34,197,94)) or Color3.fromRGB(56,189,248)
            fill.Parent = sliderTrack
            themeModule:CreateCorner(fill, 2)
            
            local box = Instance.new("TextBox")
            box.Size = UDim2.fromOffset(36, 20)
            box.Position = UDim2.new(1, -36, 0, yPos)
            box.BackgroundColor3 = theme.BackgroundTertiary
            box.Text = tostring(value)
            box.TextColor3 = theme.TextPrimary
            box.Font = Enum.Font.Gotham
            box.TextSize = 11
            box.Parent = pickerOverlay
            themeModule:CreateCorner(box, 4)
            
            return {track = sliderTrack, fill = fill, box = box, label = label}
        end
        
        local rSlider = createRGBSlider("R", r, 0)
        local gSlider = createRGBSlider("G", g, 30)
        local bSlider = createRGBSlider("B", b, 60)
        
        local applyBtn = Instance.new("TextButton")
        applyBtn.Size = UDim2.new(1, 0, 0, 32)
        applyBtn.Position = UDim2.new(0, 0, 1, -32)
        applyBtn.BackgroundColor3 = theme.Accent
        applyBtn.Text = "Apply"
        applyBtn.TextColor3 = Color3.fromRGB(255,255,255)
        applyBtn.Font = Enum.Font.GothamBold
        applyBtn.TextSize = 13
        applyBtn.Parent = pickerOverlay
        themeModule:CreateCorner(applyBtn, theme.Radius.Medium)
        
        window:Connect(applyBtn.MouseButton1Click, function()
            local nr = tonumber(rSlider.box.Text) or r
            local ng = tonumber(gSlider.box.Text) or g
            local nb = tonumber(bSlider.box.Text) or b
            nr = math.clamp(nr, 0, 255)
            ng = math.clamp(ng, 0, 255)
            nb = math.clamp(nb, 0, 255)
            currentColor = Color3.fromRGB(nr, ng, nb)
            preview.BackgroundColor3 = currentColor
            if props.Flag then window.flags[props.Flag] = currentColor end
            if props.Callback or props.callback then
                local cb = props.Callback or props.callback
                window:_runGuarded({Name = main.Name, Color = currentColor}, function()
                    cb(currentColor)
                end)
            end
            pickerOverlay:Destroy()
        end)
    end
    
    window:Connect(button.MouseButton1Click, openPicker)
    
    table.insert(tab.components, main)
    
    local api = {}
    api.Frame = main
    function api:Set(color)
        currentColor = color
        preview.BackgroundColor3 = color
    end
    function api:Get()
        return currentColor
    end
    function api:Destroy()
        if main.Parent then main:Destroy() end
    end
    
    return api
end

