            self.themeModule:Tween(notifFrame, {Position = UDim2.new(1, 20, 0, 0), BackgroundTransparency = 1}, 0.25)
            task.wait(0.26)
            if notifFrame.Parent then
                notifFrame:Destroy()
            end
        end
    end)
    
    return notifFrame
end

function GGH_Window:ChangeTheme(themeName)
    local newTheme = self.themeModule:GetTheme(themeName)
    if not newTheme then return end
    self.theme = newTheme
    self.themeModule:ApplyThemeToHierarchy(self.mainFrame, newTheme)
    self.themeModule:ApplyThemeToHierarchy(self.screenGui, newTheme)
end

-- Cleanup registration system
function GGH_Window:Connect(signal, callback)
    if not signal then return nil end
    local conn = signal:Connect(callback)
    if conn then
        table.insert(self.connections, conn)
    end
    return conn
end

function GGH_Window:RegisterCleanup(callback)
    if typeof(callback) == "function" then
        table.insert(self.cleanupCallbacks, callback)
    end
end

function GGH_Window:RegisterOriginalState(key, value, restoreFn)
    self.originalStates[key] = {
        value = value,
        restoreFn = restoreFn
    }
end

function GGH_Window:RegisterFeature(name, featureObj)
    self.activeFeatures[name] = featureObj
end

function GGH_Window:UnregisterFeature(name)
    self.activeFeatures[name] = nil
end

function GGH_Window:Show()
    if self.mainFrame then
        self.mainFrame.Visible = true
    end
end

function GGH_Window:Hide()
    if self.mainFrame then
        self.mainFrame.Visible = false
    end
end

function GGH_Window:Destroy()
    self:_executeFullCleanup()
end

function GGH_Window:Unload()
    self:Destroy()
end
return GGH_Window
end)()

