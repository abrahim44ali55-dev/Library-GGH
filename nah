function GGH_Components.CreateInput(tab, props)
    props = props or {}
    local theme = tab.theme
    local themeModule = tab.themeModule
    local window = tab.window
    local name = props.Name or props.name or "Input"

    local main, stroke = createCard(tab, name, 50)

    makeLabel(main, name, theme.TextPrimary, Enum.Font.GothamMedium, 12,
        UDim2.new(1, -24, 0, 14), UDim2.new(0, 12, 0, 6)).Name = "Title"

    local inputFrame = Instance.new("Frame")
    inputFrame.Name = "InputFrame"
    inputFrame.Size = UDim2.new(1, -24, 0, 24)
    inputFrame.Position = UDim2.new(0, 12, 0, 22)
    inputFrame.BackgroundColor3 = theme.BackgroundSecondary or Color3.fromRGB(22, 22, 28)
    inputFrame.BorderSizePixel = 0
    inputFrame.Parent = main
    themeModule:CreateCorner(inputFrame, theme.Radius.Small)
    local inputStroke = themeModule:CreateStroke(inputFrame, theme.Border, 1, 0.2)

    local textBox = Instance.new("TextBox")
    textBox.Name = "InputBox"
    textBox.Size = UDim2.new(1, -16, 1, 0)
    textBox.Position = UDim2.new(0, 8, 0, 0)
    textBox.BackgroundTransparency = 1
    textBox.BorderSizePixel = 0
    textBox.Text = tostring(props.CurrentValue or props.Default or "")
    textBox.PlaceholderText = props.PlaceholderText or props.placeholder or "Enter text..."
    textBox.PlaceholderColor3 = theme.TextTertiary or Color3.fromRGB(110, 115, 130)
    textBox.TextColor3 = theme.TextPrimary
    textBox.Font = Enum.Font.Gotham
    textBox.TextSize = 12
    textBox.TextXAlignment = Enum.TextXAlignment.Left
    textBox.ClearTextOnFocus = false
    textBox.Parent = inputFrame

    window:Connect(textBox.Focused, function()
        themeModule:Tween(inputStroke, {Color = theme.Accent, Transparency = 0}, 0.15)
        themeModule:Tween(stroke, {Color = theme.Accent, Transparency = 0}, 0.15)
    end)

    window:Connect(textBox.FocusLost, function(enterPressed)
        themeModule:Tween(inputStroke, {Color = theme.Border, Transparency = 0.2}, 0.15)
        themeModule:Tween(stroke, {Color = theme.Border, Transparency = 0.3}, 0.15)
        local text = textBox.Text
        window:_setFlag(props.Flag, text)
        fireCallback(window, name, getCallback(props), text, enterPressed)
        if props.RemoveTextAfterFocusLost then
            textBox.Text = ""
        end
    end)

    window:_setFlag(props.Flag, textBox.Text, true)
    table.insert(tab.components, main)

    local api = {}
    api.Frame = main
    api.Name = name
    api.TextBox = textBox
    function api:Set(text) textBox.Text = tostring(text) end
    function api:SetValue(text)
        textBox.Text = tostring(text)
        window:_setFlag(props.Flag, textBox.Text)
        fireCallback(window, name, getCallback(props), textBox.Text, false)
    end
    function api:Get() return textBox.Text end
    function api:SetError(state)
        if state then
            themeModule:Tween(inputStroke, {Color = theme.Error or Color3.fromRGB(239, 68, 68), Transparency = 0}, 0.15)
        else
            themeModule:Tween(inputStroke, {Color = theme.Border, Transparency = 0.2}, 0.15)
        end
    end
    function api:Destroy() if main.Parent then main:Destroy() end end
    if props.Flag then
        window.flagSetters[props.Flag] = function(v) api:SetValue(v) end
    end
    return api
end

-- =========================== COLORPICKER ===========================
function GGH_Components.CreateColorPicker(tab, props)
    props = props or {}
    local theme = tab.theme
    local themeModule = tab.themeModule
    local window = tab.window
    local name = props.Name or props.name or "ColorPicker"

    local currentColor = props.Color or props.Default or Color3.fromRGB(255, 255, 255)
    if typeof(currentColor) ~= "Color3" then currentColor = Color3.fromRGB(255, 255, 255) end

    local main = createCard(tab, name, 46)

    local title = makeLabel(main, name, theme.TextPrimary, Enum.Font.GothamMedium, 13,
        UDim2.new(1, -60, 0, 16), UDim2.new(0, 12, 0.5, 0))
    title.AnchorPoint = Vector2.new(0, 0.5)
    title.Name = "Title"

    local preview = Instance.new("Frame")
    preview.Name = "Preview"
    preview.Size = UDim2.fromOffset(32, 24)
    preview.Position = UDim2.new(1, -44, 0.5, 0)
    preview.AnchorPoint = Vector2.new(0, 0.5)
    preview.BackgroundColor3 = currentColor
    preview.BorderSizePixel = 0
    preview.Parent = main
    themeModule:CreateCorner(preview, theme.Radius.Small)
    themeModule:CreateStroke(preview, theme.Border, 1, 0)

    local button = makeClickArea(main)

    local popup
    local popupConns = {}

    local function closePopup()
        for _, c in ipairs(popupConns) do
            pcall(function() c:Disconnect() end)
        end
        popupConns = {}
        if popup then
            popup:Destroy()
            popup = nil
        end
    end
    window:RegisterCleanup(closePopup)

    local function applyColor(color, callCallback)
        currentColor = color
        preview.BackgroundColor3 = color
        window:_setFlag(props.Flag, color)
        if callCallback then
            fireCallback(window, name, getCallback(props), color)
        end
    end

    local function openPicker()
        if popup then
            closePopup()
            return
        end

        popup = Instance.new("Frame")
        popup.Name = "ColorPickerPopup"
        popup.Size = UDim2.fromOffset(220, 170)
        popup.Position = UDim2.fromScale(0.5, 0.5)
        popup.AnchorPoint = Vector2.new(0.5, 0.5)
        popup.BackgroundColor3 = theme.BackgroundSecondary
        popup.BorderSizePixel = 0
        popup.Active = true
        popup.ZIndex = 10
        popup.Parent = window.screenGui
        themeModule:CreateCorner(popup, theme.Radius.Large)
        themeModule:CreateStroke(popup, theme.Border, 1)
        themeModule:CreatePadding(popup, 12)

        local rgb = {
            math.floor(currentColor.R * 255 + 0.5),
            math.floor(currentColor.G * 255 + 0.5),
            math.floor(currentColor.B * 255 + 0.5)
        }

        local swatch = Instance.new("Frame")
        swatch.Name = "Swatch"
        swatch.Size = UDim2.new(1, 0, 0, 20)
        swatch.BackgroundColor3 = currentColor
        swatch.BorderSizePixel = 0
        swatch.Parent = popup
        themeModule:CreateCorner(swatch, 4)

        local tracks, fills, boxes = {}, {}, {}
        local channelNames = {"R", "G", "B"}
        local channelColors = {Color3.fromRGB(239, 68, 68), Color3.fromRGB(34, 197, 94), Color3.fromRGB(56, 189, 248)}

        local function refresh()
            swatch.BackgroundColor3 = Color3.fromRGB(rgb[1], rgb[2], rgb[3])
        end

        local function setChannel(i, value)
            rgb[i] = math.clamp(math.floor(value + 0.5), 0, 255)
            fills[i].Size = UDim2.new(rgb[i] / 255, 0, 1, 0)
            boxes[i].Text = tostring(rgb[i])
            refresh()
        end

        local dragIndex = nil

        for i = 1, 3 do
            local y = 30 * i
            local label = makeLabel(popup, channelNames[i], theme.TextPrimary, Enum.Font.GothamBold, 12,
                UDim2.new(0, 20, 0, 20), UDim2.new(0, 0, 0, y))
            label.Name = "Label" .. channelNames[i]

            local sliderTrack = Instance.new("Frame")
            sliderTrack.Name = "Track" .. channelNames[i]
            sliderTrack.Size = UDim2.new(1, -72, 0, 4)
            sliderTrack.Position = UDim2.new(0, 24, 0, y + 8)
            sliderTrack.BackgroundColor3 = Color3.fromRGB(60, 60, 75)
            sliderTrack.BorderSizePixel = 0
            sliderTrack.Parent = popup
            themeModule:CreateCorner(sliderTrack, 2)

            local fill = Instance.new("Frame")
            fill.Name = "Fill"
            fill.Size = UDim2.new(rgb[i] / 255, 0, 1, 0)
            fill.BackgroundColor3 = channelColors[i]
            fill.BorderSizePixel = 0
            fill.Parent = sliderTrack
            themeModule:CreateCorner(fill, 2)

            local hit = Instance.new("TextButton")
            hit.Name = "Hit" .. channelNames[i]
            hit.Size = UDim2.new(1, -72, 0, 20)
            hit.Position = UDim2.new(0, 24, 0, y)
            hit.BackgroundTransparency = 1
            hit.BorderSizePixel = 0
            hit.Text = ""
            hit.AutoButtonColor = false
            hit.Parent = popup

            local box = Instance.new("TextBox")
            box.Name = "Box" .. channelNames[i]
            box.Size = UDim2.fromOffset(40, 20)
            box.Position = UDim2.new(1, -40, 0, y)
            box.BackgroundColor3 = theme.BackgroundTertiary
            box.BorderSizePixel = 0
            box.Text = tostring(rgb[i])
            box.TextColor3 = theme.TextPrimary
            box.Font = Enum.Font.Gotham
            box.TextSize = 11
            box.ClearTextOnFocus = false
            box.Parent = popup
            themeModule:CreateCorner(box, 4)

            tracks[i], fills[i], boxes[i] = sliderTrack, fill, box

            table.insert(popupConns, hit.InputBegan:Connect(function(input)
                if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                    dragIndex = i
                    local r = math.clamp((input.Position.X - sliderTrack.AbsolutePosition.X) / math.max(sliderTrack.AbsoluteSize.X, 1), 0, 1)
                    setChannel(i, r * 255)
                end
            end))
            table.insert(popupConns, box.FocusLost:Connect(function()
                setChannel(i, tonumber(box.Text) or rgb[i])
            end))
        end

        table.insert(popupConns, UserInputService.InputChanged:Connect(function(input)
            if dragIndex and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
                local t = tracks[dragIndex]
                local r = math.clamp((input.Position.X - t.AbsolutePosition.X) / math.max(t.AbsoluteSize.X, 1), 0, 1)
                setChannel(dragIndex, r * 255)
            end
        end))
        table.insert(popupConns, UserInputService.InputEnded:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                dragIndex = nil
            end
        end))

        local applyBtn = Instance.new("TextButton")
        applyBtn.Name = "Apply"
        applyBtn.Size = UDim2.new(1, 0, 0, 28)
        applyBtn.Position = UDim2.new(0, 0, 1, -28)
        applyBtn.BackgroundColor3 = theme.Accent
        applyBtn.BorderSizePixel = 0
        applyBtn.Text = "Apply"
        applyBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
        applyBtn.Font = Enum.Font.GothamBold
        applyBtn.TextSize = 13
        applyBtn.AutoButtonColor = true
        applyBtn.Parent = popup
        themeModule:CreateCorner(applyBtn, theme.Radius.Medium)

        table.insert(popupConns, applyBtn.MouseButton1Click:Connect(function()
            applyColor(Color3.fromRGB(rgb[1], rgb[2], rgb[3]), true)
            closePopup()
        end))
    end

    window:Connect(button.MouseButton1Click, openPicker)

    window:_setFlag(props.Flag, currentColor, true)
    table.insert(tab.components, main)

    local api = {}
    api.Frame = main
    api.Name = name
    function api:Set(color)
        if typeof(color) == "Color3" then applyColor(color, false) end
    end
    function api:SetValue(color)
        if typeof(color) == "Color3" then applyColor(color, true) end
    end
    function api:Get() return currentColor end
    function api:Destroy()
        closePopup()
        if main.Parent then main:Destroy() end
    end
    if props.Flag then
        window.flagSetters[props.Flag] = function(v)
            if type(v) == "table" and v.__color then
                api:SetValue(Color3.fromRGB(v.r, v.g, v.b))
            end
        end
    end
    return api
end

-- ============================ KEYBIND ============================
function GGH_Components.CreateKeybind(tab, props)
    props = props or {}
    local theme = tab.theme
    local themeModule = tab.themeModule
    local window = tab.window
    local name = props.Name or props.name or "Keybind"

    local currentKey = props.CurrentKeybind or props.currentKeybind or props.Default or "K"
    if typeof(currentKey) == "EnumItem" then currentKey = currentKey.Name end
    currentKey = tostring(currentKey)

    local main = createCard(tab, name, 46)

    local title = makeLabel(main, name, theme.TextPrimary, Enum.Font.GothamMedium, 13,
        UDim2.new(1, -100, 0, 16), UDim2.new(0, 12, 0.5, 0))
    title.AnchorPoint = Vector2.new(0, 0.5)
    title.Name = "Title"

    local keyFrame = Instance.new("Frame")
    keyFrame.Name = "KeyFrame"
    keyFrame.Size = UDim2.fromOffset(76, 26)
    keyFrame.Position = UDim2.new(1, -86, 0.5, 0)
    keyFrame.AnchorPoint = Vector2.new(0, 0.5)
    keyFrame.BackgroundColor3 = theme.BackgroundSecondary or Color3.fromRGB(22, 22, 28)
    keyFrame.BorderSizePixel = 0
    keyFrame.Parent = main
    themeModule:CreateCorner(keyFrame, theme.Radius.Small)
    themeModule:CreateStroke(keyFrame, theme.Border, 1, 0.2)

    local keyLabel = Instance.new("TextLabel")
    keyLabel.Name = "KeyLabel"
    keyLabel.Size = UDim2.fromScale(1, 1)
    keyLabel.BackgroundTransparency = 1
    keyLabel.Text = currentKey
    keyLabel.TextColor3 = theme.TextPrimary
    keyLabel.Font = Enum.Font.GothamMedium
    keyLabel.TextSize = 11
    keyLabel.TextTruncate = Enum.TextTruncate.AtEnd
    keyLabel.Parent = keyFrame

    local button = makeClickArea(main)
    local listening = false

    local function resetVisual()
        keyLabel.Text = currentKey
        themeModule:Tween(keyFrame, {BackgroundColor3 = theme.BackgroundSecondary}, 0.15)
        themeModule:Tween(keyLabel, {TextColor3 = theme.TextPrimary}, 0.15)
    end

    local function setKey(newKey, notify)
        if typeof(newKey) == "EnumItem" then newKey = newKey.Name end
        currentKey = tostring(newKey)
        keyLabel.Text = currentKey
        window:_setFlag(props.Flag, currentKey)
        if notify then
            fireCallback(window, name, props.OnChanged or props.onChanged, currentKey)
        end
    end

    window:Connect(button.MouseButton1Click, function()
        if listening then return end
        listening = true
        keyLabel.Text = "..."
        themeModule:Tween(keyFrame, {BackgroundColor3 = theme.Accent}, 0.15)
        themeModule:Tween(keyLabel, {TextColor3 = Color3.fromRGB(255, 255, 255)}, 0.15)
    end)

    -- One shared handler: rebinding while listening, firing the callback otherwise
    window:Connect(UserInputService.InputBegan, function(input, gameProcessed)
        if input.UserInputType ~= Enum.UserInputType.Keyboard then return end
        if listening then
            listening = false
            if input.KeyCode ~= Enum.KeyCode.Escape then
                setKey(input.KeyCode.Name, true)
            end
            resetVisual()
            return
        end
        if gameProcessed then return end
        if input.KeyCode.Name == currentKey then
            fireCallback(window, name, getCallback(props), currentKey)
        end
    end)

    window:_setFlag(props.Flag, currentKey, true)
    table.insert(tab.components, main)

    local api = {}
    api.Frame = main
    api.Name = name
    function api:Set(key) setKey(key, false) end
    function api:SetValue(key) setKey(key, true) end
    function api:Get() return currentKey end
    function api:Destroy() if main.Parent then main:Destroy() end end
    if props.Flag then
        window.flagSetters[props.Flag] = function(v) setKey(v, true) end
    end
    return api
end

