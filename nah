    selectedLabel.Font = Enum.Font.Gotham
    selectedLabel.TextSize = 12
    selectedLabel.TextTruncate = Enum.TextTruncate.AtEnd
    selectedLabel.Parent = selectedFrame
    
    local arrow = Instance.new("TextLabel")
    arrow.Size = UDim2.fromOffset(16, 16)
    arrow.Position = UDim2.new(1, -20, 0.5, 0)
    arrow.AnchorPoint = Vector2.new(0, 0.5)
    arrow.BackgroundTransparency = 1
    arrow.Text = "▼"
    arrow.TextColor3 = theme.TextSecondary
    arrow.Font = Enum.Font.Gotham
    arrow.TextSize = 10
    arrow.Parent = selectedFrame
    
    local button = Instance.new("TextButton")
    button.Size = UDim2.fromScale(1,1)
    button.BackgroundTransparency = 1
    button.Text = ""
    button.Parent = selectedFrame
    
    -- Dropdown list
    local listFrame = Instance.new("ScrollingFrame")
    listFrame.Name = "DropdownList"
    listFrame.Size = UDim2.new(1, 0, 0, 0)
    listFrame.Position = UDim2.new(0, 0, 1, 4)
    listFrame.BackgroundColor3 = theme.BackgroundSecondary
    listFrame.BorderSizePixel = 0
    listFrame.CanvasSize = UDim2.new(0,0,0,0)
    listFrame.ScrollBarThickness = 2
    listFrame.Visible = false
    listFrame.ZIndex = 5
    listFrame.Parent = main
    themeModule:CreateCorner(listFrame, theme.Radius.Medium)
    themeModule:CreateStroke(listFrame, theme.Border, 1)
    
    local listLayout = Instance.new("UIListLayout")
    listLayout.Padding = UDim.new(0, 2)
    listLayout.Parent = listFrame
    
    themeModule:CreatePadding(listFrame, 4)
    
    local isOpen = false
    
    local function updateList()
        -- Clear
        for _, child in ipairs(listFrame:GetChildren()) do
            if child:IsA("TextButton") then child:Destroy() end
        end
        local totalHeight = 0
        for i, option in ipairs(options) do
            local optText = type(option) == "table" and option[1] or tostring(option)
            local optButton = Instance.new("TextButton")
            optButton.Name = "Option_" .. optText
            optButton.Size = UDim2.new(1, -8, 0, 28)
            optButton.BackgroundColor3 = (optText == tostring(current)) and (theme.SidebarItemActive or Color3.fromRGB(36,36,50)) or Color3.fromRGB(0,0,0)
            optButton.BackgroundTransparency = (optText == tostring(current)) and 0.3 or 1
            optButton.Text = optText
            optButton.TextColor3 = (optText == tostring(current)) and theme.TextPrimary or theme.TextSecondary
            optButton.Font = Enum.Font.Gotham
            optButton.TextSize = 12
            optButton.Parent = listFrame
            themeModule:CreateCorner(optButton, theme.Radius.Small)
            
            window:Connect(optButton.MouseButton1Click, function()
                current = optText
                selectedLabel.Text = optText
                if props.Flag then window.flags[props.Flag] = optText end
                -- Close
                isOpen = false
                themeModule:Tween(listFrame, {Size = UDim2.new(1,0,0,0)}, 0.15)
                task.wait(0.16)
                listFrame.Visible = false
                themeModule:Tween(arrow, {Rotation = 0}, 0.15)
                
                if props.Callback or props.callback then
                    local cb = props.Callback or props.callback
                    window:_runGuarded({Name = main.Name, Option = optText}, function()
                        cb(optText)
                    end)
                end
            end)
            
            totalHeight = totalHeight + 30
        end
        listFrame.CanvasSize = UDim2.new(0,0,0,totalHeight)
        return math.min(totalHeight + 8, 160)
    end
    
    local function toggleDropdown()
        if isOpen then
            isOpen = false
            themeModule:Tween(listFrame, {Size = UDim2.new(1,0,0,0)}, 0.15)
            themeModule:Tween(arrow, {Rotation = 0}, 0.15)
            task.wait(0.16)
            listFrame.Visible = false
        else
            local height = updateList()
            isOpen = true
            listFrame.Visible = true
            listFrame.Size = UDim2.new(1,0,0,0)
            themeModule:Tween(listFrame, {Size = UDim2.new(1,0,0,height)}, 0.2)
            themeModule:Tween(arrow, {Rotation = 180}, 0.15)
            main.Size = UDim2.new(1, -16, 0, 46 + height + 4)
        end
    end
    
    window:Connect(button.MouseButton1Click, toggleDropdown)
    
    -- Close when clicking outside
    window:Connect(UserInputService.InputBegan, function(input)
        if isOpen and input.UserInputType == Enum.UserInputType.MouseButton1 then
            local mousePos = UserInputService:GetMouseLocation()
            local absPos = main.AbsolutePosition
            local absSize = main.AbsoluteSize
            if mousePos.X < absPos.X or mousePos.X > absPos.X + absSize.X or mousePos.Y < absPos.Y or mousePos.Y > absPos.Y + absSize.Y + listFrame.AbsoluteSize.Y then
                toggleDropdown()
            end
        end
    end)
    
    if props.Flag then window.flags[props.Flag] = current end
    table.insert(tab.components, main)
    
    local api = {}
    api.Frame = main
    function api:Set(option)
        current = option
        selectedLabel.Text = tostring(option)
        if props.Flag then window.flags[props.Flag] = option end
    end
    function api:SetOptions(newOptions)
        options = newOptions
        updateList()
    end
    function api:Get()
        return current
    end
    function api:Destroy()
        if main.Parent then main:Destroy() end
    end
    
    return api
end

-- INPUT / TEXTBOX - Modern with placeholder and focus states
function GGH_Components.CreateInput(tab, props)
    props = props or {}
    local theme = tab.theme
