function Window.new(config)
	config = config or {}
	local self = setmetatable({}, Window)
	self.State = "Normal"
	self.Title = config.Title or GGH.Name
	self.Developer = config.Developer or GGH.Developer
	self.Flags = {}
	self._cleanup = Cleanup.new()
	self._destroyed = false
	self._busy = false
	self._confirmOpen = false
	self._returnState = "Normal"
	self._binds = {}
	self._bindCounter = 0
	self._tabs = {}
	self._selected = nil
	self._compact = false
	self._onClose = config.OnClose
	self._dialogDanger = true

	self.Theme = {}
	for key, value in pairs(DEFAULT_THEME) do
		self.Theme[key] = value
	end
	if config.Theme then
		for key, value in pairs(config.Theme) do
			if DEFAULT_THEME[key] ~= nil then
				self.Theme[key] = value
			end
		end
	end

	local viewport = workspace.CurrentCamera and workspace.CurrentCamera.ViewportSize or Vector2.new(1280, 720)
	self._width = math.min(config.Width or 580, viewport.X - 24)
	self._height = math.min(config.Height or 380, viewport.Y - 24)

	local parent = resolveParent()
	local previous = parent:FindFirstChild("GGH_UI")
	if previous then
		previous:Destroy()
	end
	self.Gui = make("ScreenGui", {
		Name = "GGH_UI",
		ResetOnSpawn = false,
		IgnoreGuiInset = true,
		DisplayOrder = 100,
		ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
	}, parent)
	self._cleanup:Add(self.Gui)

	self.Root = make("Frame", {
		Name = "Window",
		Size = UDim2.fromOffset(self._width, self._height),
		Position = UDim2.fromOffset(math.floor((viewport.X - self._width) / 2), math.floor((viewport.Y - self._height) / 2)),
		BorderSizePixel = 0,
		ClipsDescendants = true,
	}, self.Gui)
	round(self.Root, METRICS.Radius)
	local rootStroke = outline(self.Root, 1)
	self:_bind(function(theme)
		self.Root.BackgroundColor3 = theme.Background
		rootStroke.Color = theme.Stroke
	end)

	local header = make("Frame", {
		Name = "Header",
		Size = UDim2.new(1, 0, 0, METRICS.HeaderHeight),
		BackgroundTransparency = 1,
	}, self.Root)
	local headerLine = make("Frame", {
		Size = UDim2.new(1, 0, 0, 1),
		Position = UDim2.new(0, 0, 1, -1),
		BorderSizePixel = 0,
	}, header)
	self:_bind(function(theme)
		headerLine.BackgroundColor3 = theme.Stroke
	end)

	local dragZone = make("Frame", {
		Name = "DragZone",
		Size = UDim2.new(1, -112, 1, 0),
		BackgroundTransparency = 1,
		Active = true,
	}, header)
	local logoSlot = make("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.new(0, 26, 0.5, 0),
		Size = UDim2.fromOffset(20, 20),
		BackgroundTransparency = 1,
	}, dragZone)
	local drawnLogo
	local titleLabel = make("TextLabel", {
		Position = UDim2.fromOffset(46, 6),
		Size = UDim2.new(1, -52, 0, 18),
		BackgroundTransparency = 1,
		Text = self.Title,
		TextSize = 15,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextTruncate = Enum.TextTruncate.AtEnd,
	}, dragZone)
	local developerLabel = make("TextLabel", {
		Position = UDim2.fromOffset(46, 24),
		Size = UDim2.new(1, -52, 0, 14),
		BackgroundTransparency = 1,
		Text = "by " .. self.Developer,
		TextSize = 11,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextTruncate = Enum.TextTruncate.AtEnd,
	}, dragZone)
	self:_bind(function(theme)
		applyFont(titleLabel, theme.Font)
		titleLabel.TextColor3 = theme.Text
		applyFont(developerLabel, theme.Font)
		developerLabel.TextColor3 = theme.TextDim
		if drawnLogo then
			drawnLogo:Destroy()
		end
		drawnLogo = Icons.Draw("ggh_logo", logoSlot, theme.Text, theme.Accent)
	end)

	local buttonRow = make("Frame", {
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, -8, 0.5, 0),
		Size = UDim2.fromOffset(98, 30),
		BackgroundTransparency = 1,
	}, header)
	local rowLayout = make("UIListLayout", {
		FillDirection = Enum.FillDirection.Horizontal,
		Padding = UDim.new(0, 4),
		SortOrder = Enum.SortOrder.LayoutOrder,
	}, buttonRow)
	rowLayout.HorizontalAlignment = Enum.HorizontalAlignment.Right

	local function headerButton(order, iconName, danger, onClick)
		local button = make("TextButton", {
			LayoutOrder = order,
			Size = UDim2.fromOffset(30, 30),
			Text = "",
			AutoButtonColor = false,
			BackgroundTransparency = 1,
			BorderSizePixel = 0,
		}, buttonRow)
		round(button, 8)
		local state = { hover = false, down = false, icon = nil, iconName = iconName }
		local function redraw(theme)
			button.BackgroundColor3 = danger and theme.Danger or theme.Raised
			button.BackgroundTransparency = (state.hover or state.down) and (state.down and 0.1 or 0.35) or 1
			if state.icon then
				state.icon:Destroy()
			end
			local iconColor = (danger and (state.hover or state.down)) and Color3.new(1, 1, 1) or theme.Text
			state.icon = Icons.Draw(state.iconName, button, iconColor)
		end
		self:_bind(redraw)
		self._cleanup:Add(button.MouseEnter:Connect(function()
			state.hover = true
			redraw(self.Theme)
		end))
		self._cleanup:Add(button.MouseLeave:Connect(function()
			state.hover = false
			state.down = false
			redraw(self.Theme)
		end))
		self._cleanup:Add(button.MouseButton1Down:Connect(function()
			state.down = true
			redraw(self.Theme)
		end))
		self._cleanup:Add(button.MouseButton1Up:Connect(function()
			state.down = false
			redraw(self.Theme)
		end))
		self._cleanup:Add(button.Activated:Connect(onClick))
		return state, redraw
	end

	self._headerOnlyState, self._headerOnlyRedraw = headerButton(1, "chevron_up", false, function()
		if self.State == "Normal" then
			self:SetState("HeaderOnly")
		elseif self.State == "HeaderOnly" then
			self:SetState("Normal")
		end
	end)
	headerButton(2, "minimize", false, function()
		self:SetState("Minimized")
	end)
	headerButton(3, "close", true, function()
		self:RequestClose()
	end)

	self.Body = make("Frame", {
		Name = "Body",
		Position = UDim2.fromOffset(0, METRICS.HeaderHeight),
		Size = UDim2.new(1, 0, 1, -METRICS.HeaderHeight),
		BackgroundTransparency = 1,
	}, self.Root)

	self.Sidebar = make("Frame", {
		Name = "Sidebar",
		Size = UDim2.new(0, METRICS.SidebarWidth, 1, 0),
		BorderSizePixel = 0,
	}, self.Body)
	local sidebarLine = make("Frame", {
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.fromScale(1, 0),
		Size = UDim2.new(0, 1, 1, 0),
		BorderSizePixel = 0,
	}, self.Sidebar)
	self.TabList = make("ScrollingFrame", {
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ScrollBarThickness = 2,
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		CanvasSize = UDim2.new(),
	}, self.Sidebar)
	make("UIListLayout", { Padding = UDim.new(0, 4), SortOrder = Enum.SortOrder.LayoutOrder }, self.TabList)
	make("UIPadding", {
		PaddingTop = UDim.new(0, 8),
		PaddingBottom = UDim.new(0, 8),
		PaddingLeft = UDim.new(0, 8),
		PaddingRight = UDim.new(0, 8),
	}, self.TabList)
	self:_bind(function(theme)
		self.Sidebar.BackgroundColor3 = theme.Surface
		sidebarLine.BackgroundColor3 = theme.Stroke
		self.TabList.ScrollBarImageColor3 = theme.Stroke
	end)

	self.ContentHost = make("Frame", {
		Name = "Content",
		Position = UDim2.fromOffset(METRICS.SidebarWidth, 0),
		Size = UDim2.new(1, -METRICS.SidebarWidth, 1, 0),
		BackgroundTransparency = 1,
		ClipsDescendants = true,
	}, self.Body)

	self.Pill = make("TextButton", {
		Name = "MinimizedPill",
		Size = UDim2.fromOffset(150, 34),
		Position = self.Root.Position,
		Visible = false,
		AutoButtonColor = false,
		Text = self.Title,
		TextSize = 13,
		TextTruncate = Enum.TextTruncate.AtEnd,
		BorderSizePixel = 0,
	}, self.Gui)
	round(self.Pill, 17)
	local pillStroke = outline(self.Pill, 1)
	self:_bind(function(theme)
		self.Pill.BackgroundColor3 = theme.Surface
		self.Pill.TextColor3 = theme.Text
		applyFont(self.Pill, theme.Font)
		pillStroke.Color = theme.Accent
	end)

	makeDraggable(dragZone, self.Root, self._cleanup, function()
		self.Pill.Position = self.Root.Position
	end)
	local pillDrag = makeDraggable(self.Pill, self.Root, self._cleanup, function()
		self.Pill.Position = self.Root.Position
	end)
	self._cleanup:Add(self.Pill.Activated:Connect(function()
		if not pillDrag.Moved and self.State == "Minimized" then
			self:SetState(self._returnState)
		end
	end))

	self.NotifyHost = make("Frame", {
		Name = "Notifications",
		AnchorPoint = Vector2.new(1, 1),
		Position = UDim2.new(1, -16, 1, -16),
		Size = UDim2.new(0, 280, 1, -32),
		BackgroundTransparency = 1,
		ZIndex = 40,
	}, self.Gui)
	local notifyLayout = make("UIListLayout", {
		Padding = UDim.new(0, 8),
		SortOrder = Enum.SortOrder.LayoutOrder,
	}, self.NotifyHost)
	notifyLayout.VerticalAlignment = Enum.VerticalAlignment.Bottom
	self._notifyOrder = 0

	self:_buildDialog()
	table.insert(GGH.Windows, self)
	return self
end

function Window:_bind(apply)
	self._bindCounter = self._bindCounter + 1
	local id = self._bindCounter
	self._binds[id] = apply
	apply(self.Theme)
	return id
end

function Window:_unbind(id)
	self._binds[id] = nil
end

function Window:SetTheme(overrides)
	if self._destroyed then
		return
	end
	for key, value in pairs(overrides) do
		if DEFAULT_THEME[key] == nil then
			warn("GGH: unknown theme key '" .. tostring(key) .. "'")
		else
			self.Theme[key] = value
		end
	end
	for _, apply in pairs(self._binds) do
		pcall(apply, self.Theme)
	end
end

function Window:RegisterCleanup(item)
	return self._cleanup:Add(item)
end

function Window:Track(original, restore)
	return self._cleanup:Track(original, restore)
end

function Window:_buildDialog()
	self.DialogOverlay = make("Frame", {
		Name = "DialogOverlay",
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = Color3.new(0, 0, 0),
		BackgroundTransparency = 0.45,
		BorderSizePixel = 0,
		Visible = false,
		Active = true,
		ZIndex = 50,
	}, self.Gui)
	local dialog = make("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromOffset(300, 150),
		BorderSizePixel = 0,
		ZIndex = 51,
	}, self.DialogOverlay)
	round(dialog, METRICS.Radius)
	local dialogStroke = outline(dialog, 1)
	local heading = make("TextLabel", {
		Position = UDim2.fromOffset(16, 14),
		Size = UDim2.new(1, -32, 0, 22),
		BackgroundTransparency = 1,
		Text = "",
		TextSize = 16,
		TextXAlignment = Enum.TextXAlignment.Left,
		ZIndex = 52,
	}, dialog)
	local message = make("TextLabel", {
		Position = UDim2.fromOffset(16, 42),
		Size = UDim2.new(1, -32, 0, 50),
		BackgroundTransparency = 1,
		Text = "",
		TextSize = 13,
		TextWrapped = true,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextYAlignment = Enum.TextYAlignment.Top,
		ZIndex = 52,
	}, dialog)

	local function dialogButton(xScale, onClick)
		local button = make("TextButton", {
			AnchorPoint = Vector2.new(xScale, 1),
			Position = UDim2.new(xScale, xScale == 0 and 16 or -16, 1, -14),
			Size = UDim2.new(0.5, -22, 0, 32),
			Text = "",
			TextSize = 13,
			AutoButtonColor = false,
			BorderSizePixel = 0,
			ZIndex = 52,
		}, dialog)
		round(button, 8)
		self._cleanup:Add(button.MouseEnter:Connect(function()
			tween(button, { BackgroundTransparency = 0.15 })
		end))
		self._cleanup:Add(button.MouseLeave:Connect(function()
			tween(button, { BackgroundTransparency = 0 })
		end))
		self._cleanup:Add(button.Activated:Connect(onClick))
		return button
	end

	local function dismiss(which)
		local callback = self[which]
		self._dialogConfirm = nil
		self._dialogCancel = nil
		self.DialogOverlay.Visible = false
		self._confirmOpen = false
		fire(callback)
	end

	local cancelButton = dialogButton(0, function()
		dismiss("_dialogCancel")
	end)
	local confirmButton = dialogButton(1, function()
		dismiss("_dialogConfirm")
	end)
	self._dialogHeading = heading
	self._dialogMessage = message
	self._dialogCancelButton = cancelButton
	self._dialogConfirmButton = confirmButton

	self:_bind(function(theme)
		dialog.BackgroundColor3 = theme.Surface
		dialogStroke.Color = theme.Stroke
		applyFont(heading, theme.Font)
		heading.TextColor3 = theme.Text
		applyFont(message, theme.Font)
		message.TextColor3 = theme.TextDim
		applyFont(cancelButton, theme.Font)
		cancelButton.BackgroundColor3 = theme.Raised
		cancelButton.TextColor3 = theme.Text
		applyFont(confirmButton, theme.Font)
		confirmButton.BackgroundColor3 = self._dialogDanger and theme.Danger or theme.Accent
		confirmButton.TextColor3 = Color3.new(1, 1, 1)
	end)
end

function Window:Confirm(opts)
	if self._destroyed or self._confirmOpen then
		return false
	end
	opts = opts or {}
	self._confirmOpen = true
	self._dialogDanger = opts.Danger == true
	self._dialogConfirm = opts.OnConfirm
	self._dialogCancel = opts.OnCancel
	self._dialogHeading.Text = opts.Title or "Confirm"
	self._dialogMessage.Text = opts.Message or ""
	self._dialogCancelButton.Text = opts.CancelText or "Cancel"
	self._dialogConfirmButton.Text = opts.ConfirmText or "OK"
	self._dialogConfirmButton.BackgroundColor3 = self._dialogDanger and self.Theme.Danger or self.Theme.Accent
	self.DialogOverlay.Visible = true
	return true
end

function Window:RequestClose()
	self:Confirm({
		Title = "Close GGH?",
		Message = "Active features will be stopped and the interface will be removed completely.",
		ConfirmText = "Close",
		CancelText = "Cancel",
		Danger = true,
		OnConfirm = function()
			self:Destroy()
		end,
	})
end

function Window:_syncHeaderIcon()
	self._headerOnlyState.iconName = self.State == "HeaderOnly" and "chevron_down" or "chevron_up"
	self._headerOnlyRedraw(self.Theme)
end

function Window:_tweenRoot(size, onFinished)
	local finished = false
	local function finish()
		if finished or self._destroyed then
			return
		end
		finished = true
		onFinished()
	end
	self._tween = tween(self.Root, { Size = size }, METRICS.TweenTime + 0.04)
	self._tween.Completed:Once(finish)
	task.delay(METRICS.TweenTime + 0.2, finish)
end

function Window:SetState(target)
	if self._destroyed or self._busy or self._confirmOpen then
		return false
	end
	local from = self.State
	if not (ALLOWED[from] and ALLOWED[from][target]) then
		return false
	end
	if target == "Minimized" then
		self._returnState = from
		self.Pill.Position = self.Root.Position
		self.Root.Visible = false
		self.Pill.Visible = true
		self.State = "Minimized"
		self:_syncHeaderIcon()
	elseif from == "Minimized" then
		self.Pill.Visible = false
		self.Root.Visible = true
		self.State = target
		self:_syncHeaderIcon()
	elseif target == "HeaderOnly" then
		self._busy = true
		self:_tweenRoot(UDim2.fromOffset(self._width, METRICS.HeaderHeight), function()
			self.Body.Visible = false
			self.State = "HeaderOnly"
			self._busy = false
			self:_syncHeaderIcon()
		end)
	elseif target == "Normal" then
		self._busy = true
		self.Body.Visible = true
		self:_tweenRoot(UDim2.fromOffset(self._width, self._height), function()
			self.Root.Size = UDim2.fromOffset(self._width, self._height)
			self.State = "Normal"
			self._busy = false
			self:_syncHeaderIcon()
		end)
	end
	return true
end

function Window:SetCompact(compact)
	if self._destroyed then
		return
	end
	self._compact = compact and true or false
	local width = self._compact and METRICS.SidebarCompactWidth or METRICS.SidebarWidth
	tween(self.Sidebar, { Size = UDim2.new(0, width, 1, 0) }, METRICS.TweenTime)
	tween(self.ContentHost, { Position = UDim2.fromOffset(width, 0), Size = UDim2.new(1, -width, 1, 0) }, METRICS.TweenTime)
	for _, tab in ipairs(self._tabs) do
		tab._applyCompact()
	end
end

function Window:CreateTab(title, icon)
	local window = self
	local tab = setmetatable({
		Title = title,
		Icon = icon,
		Window = window,
		_hover = false,
		_down = false,
		_order = 0,
		_elements = {},
	}, Tab)

	tab.Button = make("TextButton", {
		Name = "Tab_" .. title,
		LayoutOrder = #self._tabs + 1,
		Size = UDim2.new(1, 0, 0, 36),
		Text = "",
		AutoButtonColor = false,
		BorderSizePixel = 0,
	}, self.TabList)
	round(tab.Button, 8)
	local accentBar = make("Frame", {
		AnchorPoint = Vector2.new(0, 0.5),
		Position = UDim2.new(0, 2, 0.5, 0),
		Size = UDim2.fromOffset(3, 16),
		BorderSizePixel = 0,
		Visible = false,
	}, tab.Button)
	round(accentBar, 2)
	local iconHolder = make("Frame", {
		Name = "IconSlot",
		Position = UDim2.fromOffset(10, 8),
		Size = UDim2.fromOffset(20, 20),
		BackgroundTransparency = 1,
	}, tab.Button)
	local label = make("TextLabel", {
		BackgroundTransparency = 1,
		Text = title,
		TextSize = 13,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextTruncate = Enum.TextTruncate.AtEnd,
	}, tab.Button)
	local drawnIcon

	tab.Content = make("ScrollingFrame", {
		Name = "Page_" .. title,
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ScrollBarThickness = 3,
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		CanvasSize = UDim2.new(),
		Visible = false,
	}, self.ContentHost)
	make("UIListLayout", { Padding = UDim.new(0, 8), SortOrder = Enum.SortOrder.LayoutOrder }, tab.Content)
	make("UIPadding", {
		PaddingTop = UDim.new(0, 12),
		PaddingBottom = UDim.new(0, 12),
		PaddingLeft = UDim.new(0, 12),
		PaddingRight = UDim.new(0, 14),
	}, tab.Content)

	local hasIcon = icon ~= nil and Icons.Has(icon)

	function tab._applyCompact()
		iconHolder.Visible = hasIcon
		if window._compact and not hasIcon then
			label.TextXAlignment = Enum.TextXAlignment.Center
			label.Position = UDim2.fromOffset(0, 0)
			label.Size = UDim2.fromScale(1, 1)
			label.Text = string.upper(string.sub(title, 1, 1))
			label.Visible = true
		elseif window._compact then
			label.Visible = false
		else
			label.Visible = true
			label.TextXAlignment = Enum.TextXAlignment.Left
			label.Position = UDim2.fromOffset(hasIcon and 38 or 14, 0)
			label.Size = UDim2.new(1, hasIcon and -44 or -20, 1, 0)
			label.Text = title
		end
	end

	local function refresh()
		local theme = window.Theme
		local selected = window._selected == tab
		if selected then
			tab.Button.BackgroundColor3 = theme.Raised
			tab.Button.BackgroundTransparency = 0
		elseif tab._down then
			tab.Button.BackgroundColor3 = theme.Stroke
			tab.Button.BackgroundTransparency = 0
		elseif tab._hover then
			tab.Button.BackgroundColor3 = theme.Hover
			tab.Button.BackgroundTransparency = 0
		else
			tab.Button.BackgroundTransparency = 1
		end
		accentBar.BackgroundColor3 = theme.Accent
		accentBar.Visible = selected
		applyFont(label, theme.Font)
		label.TextColor3 = selected and theme.Text or theme.TextDim
		tab.Content.ScrollBarImageColor3 = theme.Stroke
		if drawnIcon then
			drawnIcon:Destroy()
			drawnIcon = nil
		end
		if hasIcon then
			drawnIcon = Icons.Draw(icon, iconHolder, selected and theme.Accent or theme.TextDim)
		end
	end
	tab._refresh = refresh

	self._cleanup:Add(tab.Button.MouseEnter:Connect(function()
		tab._hover = true
		refresh()
	end))
	self._cleanup:Add(tab.Button.MouseLeave:Connect(function()
		tab._hover = false
		tab._down = false
		refresh()
	end))
	self._cleanup:Add(tab.Button.MouseButton1Down:Connect(function()
		tab._down = true
		refresh()
	end))
	self._cleanup:Add(tab.Button.MouseButton1Up:Connect(function()
		tab._down = false
		refresh()
	end))
	self._cleanup:Add(tab.Button.Activated:Connect(function()
		window:SelectTab(tab)
	end))

	table.insert(self._tabs, tab)
	tab._bindId = self:_bind(refresh)
	tab._applyCompact()
	if not self._selected then
		self:SelectTab(tab)
	end
	return tab
end

function Window:SelectTab(tab)
	if self._destroyed or self._selected == tab or not table.find(self._tabs, tab) then
		return
	end
	local previous = self._selected
	self._selected = tab
	if previous then
		previous.Content.Visible = false
	end
	tab.Content.Position = UDim2.fromOffset(10, 0)
	tab.Content.Visible = true
	tween(tab.Content, { Position = UDim2.fromOffset(0, 0) }, 0.16)
	for _, other in ipairs(self._tabs) do
		other._refresh()
	end
end

function Window:RemoveTab(tab)
	local index = table.find(self._tabs, tab)
	if self._destroyed or not index then
		return
	end
	for _, element in ipairs(copyList(tab._elements)) do
		element:Destroy()
	end
	table.remove(self._tabs, index)
	self:_unbind(tab._bindId)
	if self._selected == tab then
		self._selected = nil
		local fallback = self._tabs[math.min(index, #self._tabs)]
		if fallback then
			self:SelectTab(fallback)
		end
	end
	tab.Button:Destroy()
	tab.Content:Destroy()
end

local TOAST_COLORS = { Info = "Accent", Success = "Success", Warning = "Warning", Error = "Danger" }

function Window:Notify(opts)
	if self._destroyed then
		return
	end
	opts = opts or {}
	local theme = self.Theme
	local accent = theme[TOAST_COLORS[opts.Type or "Info"] or "Accent"]
	self._notifyOrder = self._notifyOrder + 1

	local toast = make("CanvasGroup", {
		LayoutOrder = self._notifyOrder,
		Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundColor3 = theme.Surface,
		BorderSizePixel = 0,
		GroupTransparency = 1,
	}, self.NotifyHost)
	round(toast, 8)
	local toastStroke = outline(toast, 1)
	toastStroke.Color = theme.Stroke
	make("Frame", {
		Size = UDim2.new(0, 3, 1, 0),
		BackgroundColor3 = accent,
		BorderSizePixel = 0,
	}, toast)
	local stack = make("Frame", {
		Position = UDim2.fromOffset(14, 0),
		Size = UDim2.new(1, -24, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundTransparency = 1,
	}, toast)
	make("UIListLayout", { Padding = UDim.new(0, 2), SortOrder = Enum.SortOrder.LayoutOrder }, stack)
	make("UIPadding", { PaddingTop = UDim.new(0, 10), PaddingBottom = UDim.new(0, 10) }, stack)
	local heading = make("TextLabel", {
		LayoutOrder = 1,
		Size = UDim2.new(1, 0, 0, 16),
		BackgroundTransparency = 1,
		Text = opts.Title or self.Title,
		TextSize = 13,
		TextColor3 = theme.Text,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextTruncate = Enum.TextTruncate.AtEnd,
	}, stack)
	applyFont(heading, theme.Font)
	local body = make("TextLabel", {
		LayoutOrder = 2,
		Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundTransparency = 1,
		Text = opts.Content or "",
		TextSize = 12,
		TextColor3 = theme.TextDim,
		TextWrapped = true,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextYAlignment = Enum.TextYAlignment.Top,
	}, stack)
	applyFont(body, theme.Font)

	tween(toast, { GroupTransparency = 0 }, 0.2)
	task.delay(opts.Duration or 4, function()
		if self._destroyed or not toast.Parent then
			return
		end
		tween(toast, { GroupTransparency = 1 }, 0.25)
		task.delay(0.3, function()
			if toast.Parent then
				toast:Destroy()
			end
		end)
	end)
end

local function configPath(name)
	return "GGH/" .. tostring(name):gsub("[^%w_%-]", "_") .. ".json"
end

function Window:SaveConfig(name)
	if type(writefile) ~= "function" then
		return false, "file functions are unavailable in this environment"
	end
	local data = {}
	for flag, element in pairs(self.Flags) do
		local ok, value = pcall(element.Serialize or element.Get, element)
		if ok then
			data[flag] = value
		end
	end
	pcall(function()
		if type(isfolder) == "function" and not isfolder("GGH") then
			makefolder("GGH")
		end
	end)
	local ok, err = pcall(writefile, configPath(name), HttpService:JSONEncode(data))
	if not ok then
		return false, tostring(err)
	end
	return true
end

function Window:LoadConfig(name)
	if type(readfile) ~= "function" then
		return false, "file functions are unavailable in this environment"
	end
	local okRead, raw = pcall(readfile, configPath(name))
	if not okRead then
		return false, "config not found"
	end
	local okDecode, data = pcall(HttpService.JSONDecode, HttpService, raw)
	if not okDecode or type(data) ~= "table" then
		return false, "config file is not valid JSON"
	end
	for flag, value in pairs(data) do
		local element = self.Flags[flag]
		if element then
			pcall(element.Set, element, value, false)
		end
	end
	return true
end

local function newElement(tab, height, bare)
	local window = tab.Window
	tab._order = tab._order + 1
	local element = { Window = window, Tab = tab, Maid = Cleanup.new(), _binds = {}, _destroyed = false, Enabled = true }
	element.Row = make("Frame", {
		Size = UDim2.new(1, 0, 0, height),
		BorderSizePixel = 0,
		LayoutOrder = tab._order,
		ClipsDescendants = true,
		BackgroundTransparency = bare and 1 or 0,
	}, tab.Content)
	element._rowColor = function(theme)
		return theme.Surface
	end
	local rowStroke
	if not bare then
		round(element.Row, 8)
		rowStroke = outline(element.Row, 1)
	end

	function element:Bind(apply)
		table.insert(self._binds, window:_bind(apply))
	end
	if not bare then
		element:Bind(function(theme)
			element.Row.BackgroundColor3 = element._rowColor(theme)
			rowStroke.Color = theme.Stroke
		end)
	end

	function element:Destroy()
		if self._destroyed then
			return
		end
		self._destroyed = true
		for _, id in ipairs(self._binds) do
			window:_unbind(id)
		end
		self.Maid:Destroy()
		if self.Flag and window.Flags[self.Flag] == self then
			window.Flags[self.Flag] = nil
		end
		self.Row:Destroy()
		local index = table.find(tab._elements, self)
		if index then
			table.remove(tab._elements, index)
		end
	end

	table.insert(tab._elements, element)
	return element
end

local function registerFlag(element, flag)
	if not flag then
		return
	end
	local window = element.Window
	if window.Flags[flag] then
		warn("GGH: duplicate flag '" .. tostring(flag) .. "', the newest element replaces it")
	end
	window.Flags[flag] = element
	element.Flag = flag
end

local function titleLabel(element, text, description, reserve, topHeight)
	local title = make("TextLabel", {
		BackgroundTransparency = 1,
		Position = UDim2.fromOffset(12, description and 7 or 0),
		Size = UDim2.new(1, -(reserve or 90), 0, description and 18 or (topHeight or 40)),
		Text = text,
		TextSize = 13,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextTruncate = Enum.TextTruncate.AtEnd,
	}, element.Row)
	local subtitle
	if description then
		subtitle = make("TextLabel", {
			BackgroundTransparency = 1,
			Position = UDim2.fromOffset(12, 26),
			Size = UDim2.new(1, -(reserve or 90), 0, 16),
			Text = description,
			TextSize = 11,
			TextXAlignment = Enum.TextXAlignment.Left,
			TextTruncate = Enum.TextTruncate.AtEnd,
		}, element.Row)
	end
	element:Bind(function(theme)
		applyFont(title, theme.Font)
		title.TextColor3 = theme.Text
		if subtitle then
			applyFont(subtitle, theme.Font)
			subtitle.TextColor3 = theme.TextDim
		end
	end)
	return title, subtitle
end

local function iconSlot(element, parent, name, size, position, anchor, colorKey)
	local holder = make("Frame", {
		AnchorPoint = anchor,
		Position = position,
		Size = UDim2.fromOffset(size, size),
		BackgroundTransparency = 1,
	}, parent)
	local drawn
	element:Bind(function(theme)
		if drawn then
			drawn:Destroy()
		end
		drawn = Icons.Draw(name, holder, theme[colorKey or "TextDim"])
	end)
	return holder
end

