    arrow.Position = UDim2.new(1, -20, 0.5, 0)
    arrow.AnchorPoint = Vector2.new(0, 0.5)
    arrow.BackgroundTransparency = 1
    arrow.Text = "v"
    arrow.TextColor3 = theme.TextSecondary
    arrow.Font = Enum.Font.GothamBold
    arrow.TextSize = 11
    arrow.Parent = selectedFrame

    local button = makeClickArea(selectedFrame)

    local listFrame = Instance.new("ScrollingFrame")
    listFrame.Name = "DropdownList"
    listFrame.Size = UDim2.new(1, -24, 0, 0)
    listFrame.Position = UDim2.new(0, 12, 0, 52)
    listFrame.BackgroundColor3 = theme.BackgroundSecondary or Color3.fromRGB(22, 22, 28)
    listFrame.BorderSizePixel = 0
    listFrame.CanvasSize = UDim2.new(0, 0, 0, 0)
    listFrame.ScrollBarThickness = 2
    listFrame.ScrollingDirection = Enum.ScrollingDirection.Y
    listFrame.ClipsDescendants = true
    listFrame.Visible = false
    listFrame.Parent = main
    themeModule:CreateCorner(listFrame, theme.Radius.Small)
    themeModule:CreateStroke(listFrame, theme.Border, 1)
    themeModule:CreatePadding(listFrame, 4)

    local listLayout = Instance.new("UIListLayout")
    listLayout.Padding = UDim.new(0, 2)
    listLayout.SortOrder = Enum.SortOrder.LayoutOrder
    listLayout.Parent = listFrame

    local isOpen = false
    local api = {}

    local function setCurrent(option, callCallback)
        current = tostring(option)
        selectedLabel.Text = current
        window:_setFlag(props.Flag, current)
        if callCallback then
            local cb = getCallback(props)
            if cb then
                window:_runGuarded({Name = name}, function()
                    cb(current, {current})
                end)
            end
        end
    end

    local function closeList()
        if not isOpen then return end
        isOpen = false
        themeModule:Tween(listFrame, {Size = UDim2.new(1, -24, 0, 0)}, 0.15)
        themeModule:Tween(main, {Size = UDim2.new(1, -16, 0, 46)}, 0.15)
        task.delay(0.16, function()
            if not isOpen and listFrame.Parent then
                listFrame.Visible = false
            end
        end)
    end

    local function buildList()
        for _, child in ipairs(listFrame:GetChildren()) do
            if child:IsA("TextButton") then child:Destroy() end
        end
        for i, option in ipairs(options) do
            local optText = tostring(option)
            local selected = optText == current
            local optButton = Instance.new("TextButton")
            optButton.Name = "Option_" .. i
            optButton.LayoutOrder = i
            optButton.Size = UDim2.new(1, 0, 0, 28)
            optButton.BackgroundColor3 = theme.SidebarItemActive or Color3.fromRGB(36, 36, 50)
            optButton.BackgroundTransparency = selected and 0.3 or 1
            optButton.BorderSizePixel = 0
            optButton.Text = optText
            optButton.TextColor3 = selected and theme.TextPrimary or theme.TextSecondary
            optButton.Font = Enum.Font.Gotham
            optButton.TextSize = 12
            optButton.AutoButtonColor = false
            optButton.Parent = listFrame
            themeModule:CreateCorner(optButton, theme.Radius.Small)

            window:Connect(optButton.MouseEnter, function()
                if optText ~= current then
                    themeModule:Tween(optButton, {BackgroundTransparency = 0.6}, 0.1)
                end
            end)
            window:Connect(optButton.MouseLeave, function()
                if optText ~= current then
                    themeModule:Tween(optButton, {BackgroundTransparency = 1}, 0.1)
                end
            end)
            window:Connect(optButton.MouseButton1Click, function()
                setCurrent(optText, true)
                closeList()
            end)
        end
        local count = #options
        listFrame.CanvasSize = UDim2.new(0, 0, 0, count * 30 + 4)
        return math.min(count * 30 + 8, 168)
    end

    local function openList()
        local height = buildList()
        isOpen = true
        listFrame.Visible = true
        listFrame.Size = UDim2.new(1, -24, 0, 0)
        themeModule:Tween(listFrame, {Size = UDim2.new(1, -24, 0, height)}, 0.2)
        themeModule:Tween(main, {Size = UDim2.new(1, -16, 0, 52 + height + 8)}, 0.2)
    end

    window:Connect(button.MouseButton1Click, function()
        if isOpen then closeList() else openList() end
    end)

    -- Close when clicking outside the control
    window:Connect(UserInputService.InputBegan, function(input)
        if not isOpen then return end
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            local pos = input.Position
            local absPos = main.AbsolutePosition
            local absSize = main.AbsoluteSize
            if pos.X < absPos.X or pos.X > absPos.X + absSize.X or pos.Y < absPos.Y or pos.Y > absPos.Y + absSize.Y then
                closeList()
            end
        end
    end)

    window:_setFlag(props.Flag, current, true)
    table.insert(tab.components, main)

    api.Frame = main
    api.Name = name
    function api:Set(option) setCurrent(option, false) end
    function api:SetValue(option) setCurrent(option, true) end
    function api:Refresh(newOptions)
        options = newOptions or {}
        if isOpen then closeList() end
    end
    api.SetOptions = api.Refresh
    function api:Get() return current end
    function api:Destroy() if main.Parent then main:Destroy() end end
    if props.Flag then
        window.flagSetters[props.Flag] = function(v) setCurrent(v, true) end
    end
    return api
end

