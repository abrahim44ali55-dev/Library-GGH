local function resolveParent()
	local okHidden, hidden = pcall(function()
		return gethui and gethui()
	end)
	if okHidden and hidden then
		return hidden
	end
	local okCore, core = pcall(function()
		return game:GetService("CoreGui")
	end)
	if okCore and core then
		local probe = Instance.new("Folder")
		local writable = pcall(function()
			probe.Parent = core
		end)
		probe:Destroy()
		if writable then
			return core
		end
	end
	return Players.LocalPlayer:WaitForChild("PlayerGui")
end

local function makeDraggable(handle, target, cleanup, onMove)
	local drag = { Moved = false }
	local active = false
	local startPointer, startPosition
	cleanup:Add(handle.InputBegan:Connect(function(input)
		if isPointer(input) then
			active = true
			drag.Moved = false
			startPointer = input.Position
			startPosition = target.Position
		end
	end))
	cleanup:Add(UserInputService.InputChanged:Connect(function(input)
		if active and isMove(input) then
			local delta = input.Position - startPointer
			if delta.Magnitude > 4 then
				drag.Moved = true
			end
			target.Position = UDim2.new(startPosition.X.Scale, startPosition.X.Offset + delta.X, startPosition.Y.Scale, startPosition.Y.Offset + delta.Y)
			onMove()
		end
	end))
	cleanup:Add(UserInputService.InputEnded:Connect(function(input)
		if isPointer(input) then
			active = false
		end
	end))
	return drag
end

