        Content = contentFrame,
        window = self
    }
    
    function tabObj:Select()
        self.window:SelectTab(self)
    end
    
    self:Connect(tabButton.MouseButton1Click, function()
        self:SelectTab(tabObj)
    end)
    
    table.insert(self.tabs, tabObj)
    if #self.tabs == 1 then
        self:SelectTab(tabObj)
    end
    
    return tabObj
end

function GGH_Window:SelectTab(tab)
    if not tab then return end
    if self.selectedTab == tab then return end
    if self.state == self.States.Closed then return end
    
    -- Deselect previous
    if self.selectedTab then
        if self.selectedTab.Button then
            self.themeModule:Tween(self.selectedTab.Button, {BackgroundColor3 = self.theme.SidebarBackground, BackgroundTransparency = 1}, 0.15)
            -- Update text color
            for _, child in ipairs(self.selectedTab.Button:GetDescendants()) do
                if child:IsA("TextLabel") and child.Name == "TabLabel" then
                    self.themeModule:Tween(child, {TextColor3 = self.theme.TextSecondary}, 0.15)
                end
            end
        end
        if self.selectedTab.Content then
            self.selectedTab.Content.Visible = false
        end
        if self.selectedTab.OnDeselected then
            pcall(function() self.selectedTab:OnDeselected() end)
        end
    end
    
    -- Select new
    self.selectedTab = tab
    if tab.Button then
        self.themeModule:Tween(tab.Button, {BackgroundColor3 = self.theme.SidebarItemActive or Color3.fromRGB(36,36,50), BackgroundTransparency = 0}, 0.15)
        for _, child in ipairs(tab.Button:GetDescendants()) do
            if child:IsA("TextLabel") and child.Name == "TabLabel" then
                self.themeModule:Tween(child, {TextColor3 = self.theme.TextPrimary}, 0.15)
            end
            if child:IsA("ImageLabel") then
                self.themeModule:Tween(child, {ImageColor3 = self.theme.Accent}, 0.15)
            end
        end
    end
    if tab.Content then
        tab.Content.Visible = true
        -- Animate in
        tab.Content.BackgroundTransparency = 1
        self.themeModule:Tween(tab.Content, {BackgroundTransparency = 1}, 0.15)
    end
    if tab.OnSelected then
        pcall(function() tab:OnSelected() end)
    end
end

function GGH_Window:_updateSidebarCanvas()
    task.wait()
    if self.sidebarListLayout then
        self.sidebarScroll.CanvasSize = UDim2.new(0, 0, 0, self.sidebarListLayout.AbsoluteContentSize.Y + 20)
    end
end

