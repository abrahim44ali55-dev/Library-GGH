        MinSize = Vector2.new(500, 380),
        MaxSize = Vector2.new(900, 700)
    }
    
    -- State
    self.state = GGH_Window.States.Normal
    self.previousState = nil
    self.previousSize = self.config.Size
    self.previousPosition = self.config.Position
    self.unloaded = false
    self.destroyed = false
    
    -- Collections for cleanup lifecycle
    self.connections = {} -- RBXScriptConnections
    self.threads = {} -- Active threads
    self.cleanupCallbacks = {} -- Functions to call on close
    self.originalStates = {} -- Original values to restore
    self.activeFeatures = {} -- Track active toggles/systems
