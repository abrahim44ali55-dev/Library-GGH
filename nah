function Icons.Register(name, drawer)
	drawers[name] = drawer
end

function Icons.Has(name)
	return drawers[name] ~= nil or (type(name) == "string" and name:sub(1, 13) == "rbxassetid://")
end

function Icons.Draw(name, parent, color, accent)
	local holder = Instance.new("Frame")
	holder.Name = "Icon"
	holder.AnchorPoint = Vector2.new(0.5, 0.5)
	holder.Position = UDim2.fromScale(0.5, 0.5)
	holder.Size = UDim2.fromOffset(20, 20)
	holder.BackgroundTransparency = 1
	holder.BorderSizePixel = 0
	holder.Parent = parent
	if type(name) == "string" and name:sub(1, 13) == "rbxassetid://" then
		local image = Instance.new("ImageLabel")
		image.Size = UDim2.fromScale(1, 1)
		image.BackgroundTransparency = 1
		image.Image = name
		image.ImageColor3 = color
		image.Parent = holder
	elseif drawers[name] then
		drawers[name](holder, color, accent or color)
	end
	return holder
end

