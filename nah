    cancelButton.Parent = buttonContainer
    self.themeModule:CreateCorner(cancelButton, theme.Radius and theme.Radius.Medium or 8)
    
    local closeButton = Instance.new("TextButton")
    closeButton.Name = "ConfirmCloseButton"
    closeButton.Size = UDim2.fromOffset(120, 36)
    closeButton.BackgroundColor3 = Color3.fromRGB(239, 68, 68)
    closeButton.Text = "Close"
    closeButton.TextColor3 = Color3.fromRGB(255,255,255)
    closeButton.Font = Enum.Font.GothamBold
    closeButton.TextSize = 13
    closeButton.AutoButtonColor = false
    closeButton.Parent = buttonContainer
    self.themeModule:CreateCorner(closeButton, theme.Radius and theme.Radius.Medium or 8)
    
    -- Animations
    dialog.Size = UDim2.fromOffset(300, 180)
    dialog.BackgroundTransparency = 1
    title.TextTransparency = 1
    message.TextTransparency = 1
    
    self.themeModule:Tween(overlay, {BackgroundTransparency = theme.OverlayTransparency or 0.6}, 0.2)
    self.themeModule:Tween(dialog, {Size = UDim2.fromOffset(340, 200), BackgroundTransparency = 0}, 0.25)
    task.wait(0.1)
    self.themeModule:Tween(title, {TextTransparency = 0}, 0.15)
    self.themeModule:Tween(message, {TextTransparency = 0}, 0.15)
    
    self.confirmationFrame = overlay
    
    -- Cancel -> close confirmation only, return to GGH
    local function closeConfirmationOnly()
        self.themeModule:Tween(dialog, {Size = UDim2.fromOffset(300, 180), BackgroundTransparency = 1}, 0.2)
        self.themeModule:Tween(overlay, {BackgroundTransparency = 1}, 0.2)
        task.wait(0.2)
        if overlay.Parent then
            overlay:Destroy()
        end
        self.confirmationFrame = nil
        -- No state change, return to GGH
    end
    
    self:Connect(cancelButton.MouseButton1Click, closeConfirmationOnly)
    self:Connect(overlay.InputBegan, function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            -- Check if click outside dialog
            local mousePos = UserInputService:GetMouseLocation()
            local dialogPos = dialog.AbsolutePosition
            local dialogSize = dialog.AbsoluteSize
            if mousePos.X < dialogPos.X or mousePos.X > dialogPos.X + dialogSize.X or
               mousePos.Y < dialogPos.Y or mousePos.Y > dialogPos.Y + dialogSize.Y then
                closeConfirmationOnly()
            end
        end
    end)
    
    -- Confirm Close -> full cleanup lifecycle
    self:Connect(closeButton.MouseButton1Click, function()
        closeButton.Text = "Closing..."
        closeButton.AutoButtonColor = false
        task.wait(0.15)
        self:_executeFullCleanup()
        -- Destroy confirmation
        if overlay.Parent then
            overlay:Destroy()
        end
        self.confirmationFrame = nil
    end)
    
    -- Hover effects
    self:Connect(cancelButton.MouseEnter, function()
        self.themeModule:Tween(cancelButton, {BackgroundColor3 = theme.BackgroundHover or Color3.fromRGB(40,40,56)}, 0.15)
    end)
    self:Connect(cancelButton.MouseLeave, function()
        self.themeModule:Tween(cancelButton, {BackgroundColor3 = theme.BackgroundTertiary}, 0.15)
    end)
    self:Connect(closeButton.MouseEnter, function()
        self.themeModule:Tween(closeButton, {BackgroundColor3 = Color3.fromRGB(248, 113, 113)}, 0.15)
    end)
    self:Connect(closeButton.MouseLeave, function()
        self.themeModule:Tween(closeButton, {BackgroundColor3 = Color3.fromRGB(239,68,68)}, 0.15)
    end)
end

function GGH_Window:_executeFullCleanup()
    if self.state == self.States.Closed then return end
    
    -- Save settings before anything is stopped
    pcall(function() self:SaveConfiguration() end)
    
    -- Prevent multiple closes
    self.state = self.States.Closed
    
    -- Stop all active features
    for featureName, feature in pairs(self.activeFeatures) do
        if feature and feature.Stop then
            local ok, err = pcall(function() feature:Stop() end)
            if not ok then
                warn("[GGH] Error stopping feature " .. tostring(featureName) .. ": " .. tostring(err))
            end
        end
        if feature and feature.Disable then
            pcall(function() feature:Disable() end)
        end
    end
    
    -- Restore original values where safe
    for key, original in pairs(self.originalStates) do
        -- Only restore if we have safe method
        -- This is tracked per feature
        if original.restoreFn then
            pcall(original.restoreFn, original.value)
        end
    end
    
    -- Execute registered cleanup callbacks
    for _, callback in ipairs(self.cleanupCallbacks) do
        local ok, err = pcall(callback)
        if not ok then
            warn("[GGH] Cleanup callback error: " .. tostring(err))
        end
    end
    
    -- Disconnect all connections
    for _, conn in ipairs(self.connections) do
        if conn and conn.Disconnect then
            pcall(function() conn:Disconnect() end)
        end
    end
    self.connections = {}
    
    -- Cancel threads
    for _, thread in ipairs(self.threads) do
        if thread and typeof(thread) == "thread" then
            pcall(function() task.cancel(thread) end)
        end
    end
    
    -- Remove popups, notifications
    for _, notif in ipairs(self.notifications) do
        if notif and notif.Parent then
            pcall(function() notif:Destroy() end)
        end
    end
    
    -- Animate out and destroy
    if self.mainFrame and self.mainFrame.Parent then
        self.themeModule:Tween(self.mainFrame, {Size = UDim2.fromOffset(0,0), BackgroundTransparency = 1}, 0.25)
        task.wait(0.26)
    end
    
    if self.screenGui and self.screenGui.Parent then
        self.screenGui:Destroy()
    end
    
    self.unloaded = true
    self.destroyed = true
    
    -- Clear references to prevent memory leaks
    self.tabs = {}
    self.activeFeatures = {}
    self.originalStates = {}
    self.cleanupCallbacks = {}
    self.flags = {}
end


-- ---------------- Public API ----------------
function GGH_Window:CreateTab(name, icon)
    name = tostring(name or "Tab")
    local tab = GGH_Tab.new(self, name, icon, self.theme, self.themeModule, GGH_Icons)
    table.insert(self.tabs, tab)

    if self.sidebarCompact then
        tab:SetCompact(true)
    end

    if #self.tabs == 1 then
        self:SelectTab(tab)
    end

    return tab
end

function GGH_Window:SelectTab(tab)
    if not tab then return end
    if self.selectedTab == tab then return end
    if self.state == self.States.Closed then return end

    local T = self.themeModule
    local theme = self.theme

    local prev = self.selectedTab
    if prev then
        if prev.Button then
            T:Tween(prev.Button, {BackgroundTransparency = 1}, 0.15)
        end
        if prev.label then
            T:Tween(prev.label, {TextColor3 = theme.TextSecondary}, 0.15)
        end
        if prev.iconFrame and GGH_Icons.SetColor then
            GGH_Icons:SetColor(prev.iconFrame, theme.TextSecondary)
        end
        if prev.Content then
            prev.Content.Visible = false
        end
        if prev.OnDeselected then
            pcall(function() prev:OnDeselected() end)
        end
    end

    self.selectedTab = tab

    if tab.Button then
        T:Tween(tab.Button, {BackgroundColor3 = theme.SidebarItemActive or Color3.fromRGB(36, 36, 50), BackgroundTransparency = 0}, 0.15)
    end
    if tab.label then
        T:Tween(tab.label, {TextColor3 = theme.TextPrimary}, 0.15)
    end
    if tab.iconFrame and GGH_Icons.SetColor then
        GGH_Icons:SetColor(tab.iconFrame, theme.Accent)
    end
    if tab.Content then
        tab.Content.Visible = true
    end
    if tab.OnSelected then
        pcall(function() tab:OnSelected() end)
    end
end

function GGH_Window:Notify(props)
    props = props or {}
    if self.destroyed or not self.notificationContainer then return end
    local theme = self.theme
    local T = self.themeModule
    local title = tostring(props.Title or props.title or "GGH Notification")
    local content = tostring(props.Content or props.content or "")
    local duration = props.Duration or props.duration or 4

    -- The holder is positioned by the list layout; the inner frame slides in/out
    local holder = Instance.new("Frame")
    holder.Name = "NotificationHolder"
    holder.Size = UDim2.fromOffset(300, 70)
    holder.BackgroundTransparency = 1
    holder.BorderSizePixel = 0
    holder.Parent = self.notificationContainer

    local notifFrame = Instance.new("Frame")
    notifFrame.Name = "Notification"
    notifFrame.Size = UDim2.fromScale(1, 1)
    notifFrame.Position = UDim2.new(1, 320, 0, 0)
    notifFrame.BackgroundColor3 = theme.BackgroundSecondary
    notifFrame.BorderSizePixel = 0
    notifFrame.Parent = holder

    T:CreateCorner(notifFrame, theme.Radius.Medium)
    T:CreateStroke(notifFrame, theme.Border, 1)

    local accentBar = Instance.new("Frame")
    accentBar.Name = "AccentBar"
    accentBar.Size = UDim2.new(0, 3, 1, -16)
    accentBar.Position = UDim2.new(0, 8, 0, 8)
    accentBar.BackgroundColor3 = theme.Accent
    accentBar.BorderSizePixel = 0
    accentBar.Parent = notifFrame
    T:CreateCorner(accentBar, 2)

    local titleLabel = Instance.new("TextLabel")
    titleLabel.Name = "Title"
    titleLabel.Size = UDim2.new(1, -32, 0, 18)
    titleLabel.Position = UDim2.new(0, 20, 0, 8)
    titleLabel.BackgroundTransparency = 1
    titleLabel.BorderSizePixel = 0
    titleLabel.Text = title
    titleLabel.TextColor3 = theme.TextPrimary
    titleLabel.TextXAlignment = Enum.TextXAlignment.Left
    titleLabel.Font = Enum.Font.GothamBold
    titleLabel.TextSize = 13
    titleLabel.TextTruncate = Enum.TextTruncate.AtEnd
    titleLabel.Parent = notifFrame

    local contentLabel = Instance.new("TextLabel")
    contentLabel.Name = "Content"
    contentLabel.Size = UDim2.new(1, -32, 0, 34)
    contentLabel.Position = UDim2.new(0, 20, 0, 28)
    contentLabel.BackgroundTransparency = 1
    contentLabel.BorderSizePixel = 0
    contentLabel.Text = content
    contentLabel.TextColor3 = theme.TextSecondary
    contentLabel.TextXAlignment = Enum.TextXAlignment.Left
    contentLabel.TextYAlignment = Enum.TextYAlignment.Top
    contentLabel.Font = Enum.Font.Gotham
    contentLabel.TextSize = 11
    contentLabel.TextWrapped = true
    contentLabel.Parent = notifFrame

    table.insert(self.notifications, holder)

    T:Tween(notifFrame, {Position = UDim2.new(0, 0, 0, 0)}, 0.3)

    task.delay(duration, function()
        if holder.Parent and notifFrame.Parent then
            T:Tween(notifFrame, {Position = UDim2.new(1, 320, 0, 0)}, 0.25)
            task.wait(0.27)
            if holder.Parent then holder:Destroy() end
        end
    end)

    return holder
end

function GGH_Window:ChangeTheme(themeName)
    local newTheme = self.themeModule:GetTheme(themeName)
    if not newTheme then return end
    self.theme = newTheme
    self.themeModule:ApplyThemeToHierarchy(self.screenGui, newTheme)
end

-- ---------------- Flags & configuration ----------------
function GGH_Window:_setFlag(flag, value, silent)
    if not flag then return end
    self.flags[flag] = value
    if silent or self._loadingConfig then return end
    local cfg = self.config.ConfigurationSaving
    if cfg and cfg.Enabled and not self._saveQueued then
        self._saveQueued = true
        task.delay(1, function()
            self._saveQueued = false
            if not self.destroyed then
                self:SaveConfiguration()
            end
        end)
    end
end

local function configPath(cfg)
    local folder = tostring(cfg.FolderName or "GGH")
    local file = tostring(cfg.FileName or "Config")
    if string.sub(file, -5) ~= ".json" then
        file = file .. ".json"
    end
    return folder, folder .. "/" .. file
end

function GGH_Window:SaveConfiguration()
    local cfg = self.config.ConfigurationSaving
    if not (cfg and cfg.Enabled) then return false end
    if typeof(writefile) ~= "function" then return false end

    local data = {}
    for flag, value in pairs(self.flags) do
        local t = typeof(value)
        if t == "boolean" or t == "number" or t == "string" then
            data[flag] = value
        elseif t == "Color3" then
            data[flag] = {
                __color = true,
                r = math.floor(value.R * 255 + 0.5),
                g = math.floor(value.G * 255 + 0.5),
                b = math.floor(value.B * 255 + 0.5)
            }
        end
    end

    local ok = pcall(function()
        local folder, path = configPath(cfg)
        if typeof(isfolder) == "function" and typeof(makefolder) == "function" and not isfolder(folder) then
            makefolder(folder)
        end
        writefile(path, HttpService:JSONEncode(data))
    end)
    return ok
end

function GGH_Window:LoadConfiguration()
    local cfg = self.config.ConfigurationSaving
    if not (cfg and cfg.Enabled) then return false end
    if typeof(readfile) ~= "function" or typeof(isfile) ~= "function" then return false end

    local ok, data = pcall(function()
        local _, path = configPath(cfg)
        if not isfile(path) then return nil end
        return HttpService:JSONDecode(readfile(path))
    end)
    if not ok or type(data) ~= "table" then return false end

    self._loadingConfig = true
    for flag, value in pairs(data) do
        local setter = self.flagSetters[flag]
        if setter then
            pcall(setter, value)
        end
    end
    self._loadingConfig = false
    return true
end

-- Runs user callbacks safely so one bad callback never breaks the UI
function GGH_Window:_runGuarded(context, callback)
    local success, err = pcall(callback)
    if not success then
        local name = (context and context.Name) or "component"
        warn("[GGH] Error in " .. tostring(name) .. ": " .. tostring(err))
        if self._isInteractive and self:_isInteractive() then
            self:Notify({
                Title = "GGH Error",
                Content = "Error in " .. tostring(name) .. ": " .. string.sub(tostring(err), 1, 100),
                Duration = 5
            })
        end
    end
    return success
end

-- ---------------- Cleanup registration ----------------
function GGH_Window:Connect(signal, callback)
    if not signal then return nil end
    local conn = signal:Connect(callback)
    if conn then
        table.insert(self.connections, conn)
    end
    return conn
end

function GGH_Window:RegisterCleanup(callback)
    if typeof(callback) == "function" then
        table.insert(self.cleanupCallbacks, callback)
    end
end

function GGH_Window:RegisterOriginalState(key, value, restoreFn)
    self.originalStates[key] = {value = value, restoreFn = restoreFn}
end

function GGH_Window:RegisterFeature(name, featureObj)
    self.activeFeatures[name] = featureObj
end

function GGH_Window:UnregisterFeature(name)
    self.activeFeatures[name] = nil
end

function GGH_Window:Show()
    if self.mainFrame then self.mainFrame.Visible = true end
end

function GGH_Window:Hide()
    if self.mainFrame then self.mainFrame.Visible = false end
end

function GGH_Window:SetVisibility(visible)
    if self.mainFrame then self.mainFrame.Visible = visible and true or false end
end

function GGH_Window:IsVisible()
    return self.mainFrame ~= nil and self.mainFrame.Visible
end

function GGH_Window:Destroy()
    self:_executeFullCleanup()
end

function GGH_Window:Unload()
    self:Destroy()
end

return GGH_Window
end)()

