function Tab:AddSlider(opts)
	opts = opts or {}
	local window = self.Window
	local minimum, maximum = opts.Min or 0, opts.Max or 100
	local step = opts.Step or 1
	local suffix = opts.Suffix or ""
	local decimals = (tostring(step):match("%.(%d+)") or ""):len()
	local element = newElement(self, 56)
	titleLabel(element, opts.Title or "Slider", nil, 116, 34)
	local valueLabel = make("TextLabel", {
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -14, 0, 0),
		Size = UDim2.fromOffset(100, 34),
		BackgroundTransparency = 1,
		TextSize = 12,
		TextXAlignment = Enum.TextXAlignment.Right,
	}, element.Row)
	local hit = make("TextButton", {
		Position = UDim2.fromOffset(14, 34),
		Size = UDim2.new(1, -28, 0, 18),
		BackgroundTransparency = 1,
		Text = "",
		AutoButtonColor = false,
	}, element.Row)
	local track = make("Frame", {
		AnchorPoint = Vector2.new(0, 0.5),
		Position = UDim2.fromScale(0, 0.5),
		Size = UDim2.new(1, 0, 0, 6),
		BorderSizePixel = 0,
	}, hit)
	round(track, 3)
	local fill = make("Frame", { Size = UDim2.fromScale(0, 1), BorderSizePixel = 0 }, track)
	round(fill, 3)
	shade(fill)
	local knob = make("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0, 0.5),
		Size = UDim2.fromOffset(12, 12),
		BorderSizePixel = 0,
		BackgroundColor3 = WHITE,
	}, track)
	round(knob, 8)
	local knobStroke = outline(knob, 2)

	local function snap(raw)
		local clamped = math.clamp(raw, minimum, maximum)
		local stepped = minimum + math.floor((clamped - minimum) / step + 0.5) * step
		return math.clamp(math.floor(stepped * 1e6 + 0.5) / 1e6, minimum, maximum)
	end
	local value = snap(opts.Default or minimum)
	local dragging, hovering = false, false

	local function paint(animate)
		local alpha = maximum == minimum and 0 or (value - minimum) / (maximum - minimum)
		paintProps(fill, { Size = UDim2.fromScale(alpha, 1) }, animate, 0.12)
		paintProps(knob, { Position = UDim2.fromScale(alpha, 0.5) }, animate, 0.12)
		valueLabel.Text = string.format("%." .. decimals .. "f", value) .. suffix
	end
	local function paintKnob()
		local big = dragging or hovering
		tween(knob, { Size = UDim2.fromOffset(big and 17 or 12, big and 17 or 12) }, 0.16, Enum.EasingStyle.Back)
		tween(valueLabel, { TextColor3 = big and window.Theme.Accent or window.Theme.TextDim }, 0.16)
	end
	element:Bind(function(theme)
		track.BackgroundColor3 = theme.Raised
		fill.BackgroundColor3 = theme.Accent
		knobStroke.Color = theme.Accent
		applyFont(valueLabel, theme.Font)
		valueLabel.TextColor3 = theme.TextDim
		paint(false)
	end)
	element:Interactive(nil)
	element.Maid:Add(hit.MouseEnter:Connect(function()
		hovering = true
		paintKnob()
	end))
	element.Maid:Add(hit.MouseLeave:Connect(function()
		hovering = false
		paintKnob()
	end))

	local function apply(newValue, silent)
		newValue = snap(newValue)
		if newValue == value then
			return
		end
		value = newValue
		paint(not dragging)
		if not silent then
			fire(opts.Callback, value)
		end
	end
	local function fromPointer(x)
		local width = track.AbsoluteSize.X
		if width <= 0 then
			return
		end
		local alpha = math.clamp((x - track.AbsolutePosition.X) / width, 0, 1)
		apply(minimum + alpha * (maximum - minimum), false)
	end

	local function stopDrag()
		if dragging then
			dragging = false
			self.Content.ScrollingEnabled = true
			paintKnob()
		end
	end
	element.Maid:Add(hit.InputBegan:Connect(function(input)
		if isPointer(input) then
			dragging = true
			self.Content.ScrollingEnabled = false
			paintKnob()
			fromPointer(input.Position.X)
		end
	end))
	element.Maid:Add(UserInputService.InputChanged:Connect(function(input)
		if dragging and isMove(input) then
			fromPointer(input.Position.X)
		end
	end))
	element.Maid:Add(UserInputService.InputEnded:Connect(function(input)
		if isPointer(input) then
			stopDrag()
		end
	end))
	element.Maid:Add(stopDrag)

	function element:Get()
		return value
	end
	function element:Set(newValue, silent)
		if type(newValue) == "number" then
			apply(newValue, silent)
		end
	end
	function element:SetRange(newMin, newMax)
		minimum, maximum = newMin, newMax
		value = snap(value)
		paint(true)
	end
	registerFlag(element, opts.Flag)
	return element
end

function Tab:AddDropdown(opts)
	opts = opts or {}
	local window = self.Window
	local element = newElement(self, ROW)
	local options = copyList(opts.Options or {})
	local current = opts.Default
	local placeholder = opts.Placeholder or "Select..."
	titleLabel(element, opts.Title or "Dropdown", nil, 190)
	local header = make("TextButton", {
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		Text = "",
		AutoButtonColor = false,
		ZIndex = 2,
	}, element.Row)
	local valueLabel = make("TextLabel", {
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, -38, 0.5, 0),
		Size = UDim2.fromOffset(140, 18),
		BackgroundTransparency = 1,
		TextSize = 12,
		TextXAlignment = Enum.TextXAlignment.Right,
		TextTruncate = Enum.TextTruncate.AtEnd,
	}, element.Row)
	local chevron = iconSlot(element, element.Row, "chevron_down", 20, UDim2.new(1, -10, 0.5, 0), Vector2.new(1, 0.5), "TextDim")
	element:Interactive(header)

	local function paintValue()
		valueLabel.Text = current ~= nil and tostring(current) or placeholder
		local theme = window.Theme
		valueLabel.TextColor3 = current ~= nil and theme.Accent or theme.TextDim
	end
	element:Bind(function(theme)
		applyFont(valueLabel, theme.Font)
		paintValue()
	end)

	local catcher
	local function close(instant)
		if not catcher then
			return
		end
		local old = catcher
		catcher = nil
		tween(chevron, { Rotation = 0 }, 0.2, Enum.EasingStyle.Back)
		if instant or window._destroyed then
			old:Destroy()
			return
		end
		local panel = old:FindFirstChild("Panel")
		if panel then
			tween(panel, { GroupTransparency = 1, Size = UDim2.fromOffset(panel.Size.X.Offset, 0) }, 0.16, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
		end
		task.delay(0.18, function()
			old:Destroy()
		end)
	end
	element.Maid:Add(function()
		close(true)
	end)

	local function choose(option, silent)
		current = option
		paintValue()
		if not silent then
			fire(opts.Callback, current)
		end
	end

	local function open()
		if catcher or window._destroyed then
			return
		end
		local theme = window.Theme
		local absolute, size = element.Row.AbsolutePosition, element.Row.AbsoluteSize
		local viewport = workspace.CurrentCamera and workspace.CurrentCamera.ViewportSize or Vector2.new(1280, 720)
		local searchable = opts.Search == true or #options > 8
		local listHeight = math.min(#options * 30 + (searchable and 38 or 0) + 8, 230)
		local y = absolute.Y + size.Y + 4
		if y + listHeight > viewport.Y - 8 then
			y = math.max(8, absolute.Y - listHeight - 4)
		end
		catcher = make("TextButton", {
			Size = UDim2.fromScale(1, 1),
			BackgroundTransparency = 1,
			Text = "",
			AutoButtonColor = false,
			ZIndex = 60,
		}, window.Gui)
		catcher.Activated:Connect(function()
			close(false)
		end)
		local panel = make("CanvasGroup", {
			Name = "Panel",
			Position = UDim2.fromOffset(absolute.X, y),
			Size = UDim2.fromOffset(size.X, 0),
			BackgroundColor3 = theme.Surface,
			BorderSizePixel = 0,
			GroupTransparency = 1,
			ZIndex = 61,
		}, catcher)
		round(panel, 10)
		outline(panel, 1).Color = theme.Stroke
		tween(panel, { Size = UDim2.fromOffset(size.X, listHeight), GroupTransparency = 0 }, 0.22, Enum.EasingStyle.Quint)
		tween(chevron, { Rotation = 180 }, 0.24, Enum.EasingStyle.Back)

		local listTop = 4
		local search
		if searchable then
			search = make("TextBox", {
				Position = UDim2.fromOffset(6, 6),
				Size = UDim2.new(1, -12, 0, 26),
				BackgroundColor3 = theme.Raised,
				BorderSizePixel = 0,
				Text = "",
				PlaceholderText = "Search...",
				PlaceholderColor3 = theme.TextDim,
				TextColor3 = theme.Text,
				TextSize = 12,
				ClearTextOnFocus = false,
				TextXAlignment = Enum.TextXAlignment.Left,
				ZIndex = 62,
			}, panel)
			round(search, 6)
			make("UIPadding", { PaddingLeft = UDim.new(0, 8) }, search)
			applyFont(search, theme.Font)
			listTop = 38
		end
		local list = make("ScrollingFrame", {
			Position = UDim2.fromOffset(4, listTop),
			Size = UDim2.new(1, -8, 1, -listTop - 4),
			BackgroundTransparency = 1,
			BorderSizePixel = 0,
			ScrollBarThickness = 2,
			ScrollBarImageColor3 = theme.Stroke,
			AutomaticCanvasSize = Enum.AutomaticSize.Y,
			CanvasSize = UDim2.new(),
			ZIndex = 62,
		}, panel)
		make("UIListLayout", { Padding = UDim.new(0, 2), SortOrder = Enum.SortOrder.LayoutOrder }, list)

		local function populate(filter)
			for _, child in ipairs(list:GetChildren()) do
				if child:IsA("TextButton") then
					child:Destroy()
				end
			end
			local needle = string.lower(filter or "")
			for index, option in ipairs(options) do
				local text = tostring(option)
				if needle == "" or string.find(string.lower(text), needle, 1, true) then
					local selected = option == current
					local item = make("TextButton", {
						LayoutOrder = index,
						Size = UDim2.new(1, 0, 0, 28),
						BackgroundColor3 = theme.Raised,
						BackgroundTransparency = selected and 0 or 1,
						BorderSizePixel = 0,
						AutoButtonColor = false,
						Text = text,
						TextSize = 12,
						TextColor3 = selected and theme.Accent or theme.Text,
						TextXAlignment = Enum.TextXAlignment.Left,
						TextTruncate = Enum.TextTruncate.AtEnd,
						ZIndex = 63,
					}, list)
					round(item, 7)
					make("UIPadding", { PaddingLeft = UDim.new(0, 10), PaddingRight = UDim.new(0, 8) }, item)
					applyFont(item, theme.Font)
					item.MouseEnter:Connect(function()
						if option ~= current then
							tween(item, { BackgroundTransparency = 0.45 }, 0.1)
						end
					end)
					item.MouseLeave:Connect(function()
						if option ~= current then
							tween(item, { BackgroundTransparency = 1 }, 0.1)
						end
					end)
					item.Activated:Connect(function()
						choose(option, false)
						close(false)
					end)
				end
			end
		end
		populate("")
		if search then
			search:GetPropertyChangedSignal("Text"):Connect(function()
				populate(search.Text)
			end)
		end
	end

	element.Maid:Add(header.Activated:Connect(function()
		if catcher then
			close(false)
		else
			open()
		end
	end))

	function element:Get()
		return current
	end
	function element:Set(option, silent)
		if option == nil then
			choose(nil, silent)
		elseif table.find(options, option) then
			choose(option, silent)
		end
	end
	function element:SetOptions(newOptions, keepSelection)
		options = copyList(newOptions or {})
		close(true)
		if not (keepSelection and current ~= nil and table.find(options, current)) then
			current = nil
		end
		paintValue()
	end
	registerFlag(element, opts.Flag)
	return element
end

function Tab:AddInput(opts)
	opts = opts or {}
	local window = self.Window
	local element = newElement(self, 62)
	local baseTitle = opts.Title or "Input"
	local title = titleLabel(element, baseTitle, nil, 26, 30)
	local box = make("TextBox", {
		Position = UDim2.fromOffset(14, 31),
		Size = UDim2.new(1, -28, 0, 26),
		BorderSizePixel = 0,
		Text = tostring(opts.Default or ""),
		PlaceholderText = opts.Placeholder or "",
		ClearTextOnFocus = false,
		TextSize = 12,
		TextXAlignment = Enum.TextXAlignment.Left,
	}, element.Row)
	round(box, 7)
	make("UIPadding", { PaddingLeft = UDim.new(0, 9), PaddingRight = UDim.new(0, 9) }, box)
	local boxStroke = outline(box, 1)

	local value = box.Text
	local focused, failed = false, false
	local function paint(animate)
		local theme = window.Theme
		box.TextColor3 = theme.Text
		box.PlaceholderColor3 = theme.TextDim
		applyFont(box, theme.Font)
		paintProps(box, { BackgroundColor3 = focused and theme.Surface or theme.Background }, animate, 0.14)
		paintProps(boxStroke, {
			Color = failed and theme.Danger or (focused and theme.Accent or theme.Stroke),
			Thickness = focused and 1.5 or 1,
		}, animate, 0.14)
	end
	element:Bind(function()
		paint(false)
	end)

	local function shake()
		task.spawn(function()
			local base = box.Position
			for _, dx in ipairs({ -5, 5, -3, 3, 0 }) do
				if element._destroyed then
					return
				end
				tween(box, { Position = UDim2.new(base.X.Scale, base.X.Offset + dx, base.Y.Scale, base.Y.Offset) }, 0.04)
				task.wait(0.045)
			end
		end)
	end

	element.Maid:Add(box.Focused:Connect(function()
		focused = true
		paint(true)
	end))
	element.Maid:Add(box.FocusLost:Connect(function(enterPressed)
		focused = false
		local text = box.Text
		local valid, reason = true, nil
		if opts.Validate then
			local ok, result, message = pcall(opts.Validate, text)
			valid = ok and result ~= false
			reason = message
		end
		if not valid then
			failed = true
			box.Text = value
			title.Text = baseTitle .. (reason and (" - " .. tostring(reason)) or "")
			paint(true)
			shake()
			task.delay(1.5, function()
				if element._destroyed then
					return
				end
				failed = false
				title.Text = baseTitle
				paint(true)
			end)
			return
		end
		paint(true)
		if text ~= value then
			value = text
			fire(opts.Callback, text, enterPressed)
		end
	end))

	function element:Get()
		return value
	end
	function element:Set(text, silent)
		text = tostring(text)
		box.Text = text
		if text ~= value then
			value = text
			if not silent then
				fire(opts.Callback, text, false)
			end
		end
	end
	registerFlag(element, opts.Flag)
	return element
end

local function toHex(color)
	return string.format("#%02X%02X%02X", math.floor(color.R * 255 + 0.5), math.floor(color.G * 255 + 0.5), math.floor(color.B * 255 + 0.5))
end

local function fromHex(text)
	local digits = tostring(text):gsub("^#", "")
	if #digits ~= 6 or digits:find("%X") then
		return nil
	end
	return Color3.fromRGB(tonumber(digits:sub(1, 2), 16), tonumber(digits:sub(3, 4), 16), tonumber(digits:sub(5, 6), 16))
end

function Tab:AddColorPicker(opts)
	opts = opts or {}
	local window = self.Window
	local useAlpha = opts.Alpha == true
	local collapsedHeight = ROW
	local expandedHeight = useAlpha and 218 or 194
	local element = newElement(self, collapsedHeight)
	titleLabel(element, opts.Title or "Color", nil, 64)
	local header = make("TextButton", {
		Size = UDim2.new(1, 0, 0, collapsedHeight),
		BackgroundTransparency = 1,
		Text = "",
		AutoButtonColor = false,
		ZIndex = 2,
	}, element.Row)
	local swatch = make("Frame", {
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, -14, 0, collapsedHeight / 2),
		Size = UDim2.fromOffset(36, 22),
		BorderSizePixel = 0,
	}, element.Row)
	round(swatch, 6)
	local swatchStroke = outline(swatch, 1)
	element:Interactive(header)

	local panel = make("CanvasGroup", {
		Position = UDim2.fromOffset(0, collapsedHeight),
		Size = UDim2.new(1, 0, 0, expandedHeight - collapsedHeight),
		BackgroundTransparency = 1,
		Visible = false,
		GroupTransparency = 1,
	}, element.Row)

	local svBase = make("Frame", {
		Position = UDim2.fromOffset(14, 4),
		Size = UDim2.fromOffset(150, 100),
		BorderSizePixel = 0,
		ClipsDescendants = true,
	}, panel)
	round(svBase, 5)
	local whiteLayer = make("Frame", { Size = UDim2.fromScale(1, 1), BackgroundColor3 = WHITE, BorderSizePixel = 0 }, svBase)
	make("UIGradient", { Transparency = NumberSequence.new(0, 1) }, whiteLayer)
	local blackLayer = make("Frame", { Size = UDim2.fromScale(1, 1), BackgroundColor3 = Color3.new(0, 0, 0), BorderSizePixel = 0 }, svBase)
	make("UIGradient", { Rotation = 90, Transparency = NumberSequence.new(1, 0) }, blackLayer)
	local svHit = make("TextButton", { Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Text = "", AutoButtonColor = false }, svBase)
	local svCursor = make("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Size = UDim2.fromOffset(10, 10),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
	}, svBase)
	round(svCursor, 5)
	outline(svCursor, 2).Color = WHITE

	local hueBar = make("Frame", {
		Position = UDim2.fromOffset(174, 4),
		Size = UDim2.fromOffset(16, 100),
		BorderSizePixel = 0,
		BackgroundColor3 = WHITE,
	}, panel)
	round(hueBar, 5)
	make("UIGradient", {
		Rotation = 90,
		Color = ColorSequence.new({
			ColorSequenceKeypoint.new(0, Color3.fromHSV(0, 1, 1)),
			ColorSequenceKeypoint.new(0.167, Color3.fromHSV(0.167, 1, 1)),
			ColorSequenceKeypoint.new(0.333, Color3.fromHSV(0.333, 1, 1)),
			ColorSequenceKeypoint.new(0.5, Color3.fromHSV(0.5, 1, 1)),
			ColorSequenceKeypoint.new(0.667, Color3.fromHSV(0.667, 1, 1)),
			ColorSequenceKeypoint.new(0.833, Color3.fromHSV(0.833, 1, 1)),
			ColorSequenceKeypoint.new(1, Color3.fromHSV(0, 1, 1)),
		}),
	}, hueBar)
	local hueHit = make("TextButton", { Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Text = "", AutoButtonColor = false }, hueBar)
	local hueCursor = make("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Size = UDim2.new(1, 4, 0, 4),
		BackgroundColor3 = WHITE,
		BorderSizePixel = 0,
	}, hueBar)
	round(hueCursor, 2)

	local function numberBox(x, width, text)
		local box = make("TextBox", {
			Position = UDim2.fromOffset(x, 114),
			Size = UDim2.fromOffset(width, 24),
			BorderSizePixel = 0,
			Text = text,
			ClearTextOnFocus = false,
			TextSize = 11,
		}, panel)
		round(box, 6)
		return box, outline(box, 1)
	end
	local hexBox, hexStroke = numberBox(14, 76, "#FFFFFF")
	local redBox, redStroke = numberBox(98, 40, "255")
	local greenBox, greenStroke = numberBox(144, 40, "255")
	local blueBox, blueStroke = numberBox(190, 40, "255")

	local alphaHit, alphaFill, alphaTrack
	if useAlpha then
		alphaHit = make("TextButton", {
			Position = UDim2.fromOffset(14, 148),
			Size = UDim2.new(1, -28, 0, 16),
			BackgroundTransparency = 1,
			Text = "",
			AutoButtonColor = false,
		}, panel)
		alphaTrack = make("Frame", {
			AnchorPoint = Vector2.new(0, 0.5),
			Position = UDim2.fromScale(0, 0.5),
			Size = UDim2.new(1, 0, 0, 6),
			BorderSizePixel = 0,
		}, alphaHit)
		round(alphaTrack, 3)
		alphaFill = make("Frame", { Size = UDim2.fromScale(1, 1), BorderSizePixel = 0 }, alphaTrack)
		round(alphaFill, 3)
	end

	local hue, saturation, brightness = 0, 0, 1
	local alpha = 1
	do
		local start = typeof(opts.Default) == "Color3" and opts.Default or Color3.fromRGB(255, 255, 255)
		hue, saturation, brightness = start:ToHSV()
		alpha = math.clamp(opts.DefaultAlpha or 1, 0, 1)
	end
	local function currentColor()
		return Color3.fromHSV(hue, saturation, brightness)
	end

	local function paint(skipBoxes)
		local theme = window.Theme
		local color = currentColor()
		svBase.BackgroundColor3 = Color3.fromHSV(hue, 1, 1)
		svCursor.Position = UDim2.fromScale(saturation, 1 - brightness)
		hueCursor.Position = UDim2.fromScale(0.5, hue)
		swatch.BackgroundColor3 = color
		swatch.BackgroundTransparency = 1 - alpha
		swatchStroke.Color = theme.Stroke
		for _, pair in ipairs({ { hexBox, hexStroke }, { redBox, redStroke }, { greenBox, greenStroke }, { blueBox, blueStroke } }) do
			pair[1].BackgroundColor3 = theme.Background
			pair[1].TextColor3 = theme.Text
			applyFont(pair[1], theme.Font)
			pair[2].Color = theme.Stroke
		end
		if alphaTrack then
			alphaTrack.BackgroundColor3 = theme.Raised
			alphaFill.BackgroundColor3 = color
			alphaFill.Size = UDim2.fromScale(alpha, 1)
		end
		if not skipBoxes then
			hexBox.Text = toHex(color)
			redBox.Text = tostring(math.floor(color.R * 255 + 0.5))
			greenBox.Text = tostring(math.floor(color.G * 255 + 0.5))
			blueBox.Text = tostring(math.floor(color.B * 255 + 0.5))
		end
	end
	element:Bind(function()
		paint(false)
	end)

	local function commit(silent, skipBoxes)
		paint(skipBoxes)
		if not silent then
			fire(opts.Callback, currentColor(), alpha)
		end
	end

	local activeDrag
	local function stopDrag()
		if activeDrag then
			activeDrag = nil
			self.Content.ScrollingEnabled = true
		end
	end
	local function startDrag(name, input)
		if isPointer(input) then
			activeDrag = name
			self.Content.ScrollingEnabled = false
			return true
		end
		return false
	end
	local function updateDrag(position)
		if activeDrag == "sv" then
			local size = svBase.AbsoluteSize
			saturation = math.clamp((position.X - svBase.AbsolutePosition.X) / size.X, 0, 1)
			brightness = 1 - math.clamp((position.Y - svBase.AbsolutePosition.Y) / size.Y, 0, 1)
		elseif activeDrag == "hue" then
			hue = math.clamp((position.Y - hueBar.AbsolutePosition.Y) / hueBar.AbsoluteSize.Y, 0, 0.999)
		elseif activeDrag == "alpha" then
			alpha = math.clamp((position.X - alphaTrack.AbsolutePosition.X) / alphaTrack.AbsoluteSize.X, 0, 1)
		else
			return
		end
		commit(false, false)
	end

	element.Maid:Add(svHit.InputBegan:Connect(function(input)
		if startDrag("sv", input) then
			updateDrag(input.Position)
		end
	end))
	element.Maid:Add(hueHit.InputBegan:Connect(function(input)
		if startDrag("hue", input) then
			updateDrag(input.Position)
		end
	end))
	if alphaHit then
		element.Maid:Add(alphaHit.InputBegan:Connect(function(input)
			if startDrag("alpha", input) then
				updateDrag(input.Position)
			end
		end))
	end
	element.Maid:Add(UserInputService.InputChanged:Connect(function(input)
		if activeDrag and isMove(input) then
			updateDrag(input.Position)
		end
	end))
	element.Maid:Add(UserInputService.InputEnded:Connect(function(input)
		if isPointer(input) then
			stopDrag()
		end
	end))
	element.Maid:Add(stopDrag)

	local function setColor(color, silent)
		hue, saturation, brightness = color:ToHSV()
		commit(silent, false)
	end
	element.Maid:Add(hexBox.FocusLost:Connect(function()
		local color = fromHex(hexBox.Text)
		if color then
			setColor(color, false)
		else
			paint(false)
		end
	end))
	local function channelHandler(box)
		return box.FocusLost:Connect(function()
			local red = tonumber(redBox.Text)
			local green = tonumber(greenBox.Text)
			local blue = tonumber(blueBox.Text)
			if red and green and blue then
				setColor(Color3.fromRGB(math.clamp(math.floor(red), 0, 255), math.clamp(math.floor(green), 0, 255), math.clamp(math.floor(blue), 0, 255)), false)
			else
				paint(false)
			end
		end)
	end
	element.Maid:Add(channelHandler(redBox))
	element.Maid:Add(channelHandler(greenBox))
	element.Maid:Add(channelHandler(blueBox))

	local expanded = false
	element.Maid:Add(header.Activated:Connect(function()
		expanded = not expanded
		if expanded then
			panel.Visible = true
			tween(panel, { GroupTransparency = 0 }, 0.24)
		else
			tween(panel, { GroupTransparency = 1 }, 0.14)
			task.delay(0.2, function()
				if not expanded and not element._destroyed then
					panel.Visible = false
				end
			end)
		end
		tween(element.Row, { Size = UDim2.new(1, 0, 0, expanded and expandedHeight or collapsedHeight) }, 0.24, Enum.EasingStyle.Quint)
	end))

	function element:Get()
		return currentColor()
	end
	function element:GetAlpha()
		return alpha
	end
	function element:Set(value, silent)
		if typeof(value) == "Color3" then
			setColor(value, silent)
		elseif type(value) == "string" then
			local color = fromHex(value)
			if color then
				setColor(color, silent)
			end
		elseif type(value) == "table" and value.r and value.g and value.b then
			if value.a then
				alpha = math.clamp(value.a, 0, 1)
			end
			setColor(Color3.fromRGB(value.r, value.g, value.b), silent)
		end
	end
	function element:Serialize()
		local color = currentColor()
		return {
			r = math.floor(color.R * 255 + 0.5),
			g = math.floor(color.G * 255 + 0.5),
			b = math.floor(color.B * 255 + 0.5),
			a = alpha,
		}
	end
	registerFlag(element, opts.Flag)
	return element
end

function Tab:AddKeybind(opts)
	opts = opts or {}
	local window = self.Window
	local element = newElement(self, ROW)
	titleLabel(element, opts.Title or "Keybind", nil, 116)
	local keyButton = make("TextButton", {
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, -14, 0.5, 0),
		Size = UDim2.fromOffset(94, 26),
		BorderSizePixel = 0,
		AutoButtonColor = false,
		Text = "",
		TextSize = 12,
		ZIndex = 2,
	}, element.Row)
	round(keyButton, 7)
	local keyScale = make("UIScale", {}, keyButton)
	local keyStroke = outline(keyButton, 1)
	element:Interactive(nil)

	local current = typeof(opts.Default) == "EnumItem" and opts.Default or nil
	local listening = false
	local pulse
	local function stopPulse()
		if pulse then
			pulse:Cancel()
			pulse = nil
		end
		keyStroke.Transparency = 0
	end
	local function paint(animate)
		local theme = window.Theme
		keyButton.Text = listening and "Press a key..." or (current and current.Name or "None")
		applyFont(keyButton, theme.Font)
		paintProps(keyButton, {
			BackgroundColor3 = listening and theme.Surface or theme.Background,
			TextColor3 = listening and theme.Accent or theme.Text,
		}, animate, 0.14)
		paintProps(keyStroke, { Color = listening and theme.Accent or theme.Stroke }, animate, 0.14)
	end
	element:Bind(function()
		paint(false)
	end)
	element.Maid:Add(stopPulse)

	local function setListening(state)
		listening = state
		stopPulse()
		if listening then
			pulse = TweenService:Create(keyStroke, TweenInfo.new(0.55, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut, -1, true), { Transparency = 0.75 })
			pulse:Play()
		end
		paint(true)
	end

	element.Maid:Add(keyButton.MouseButton1Down:Connect(function()
		tween(keyScale, { Scale = 0.93 }, 0.08)
	end))
	element.Maid:Add(keyButton.MouseButton1Up:Connect(function()
		tween(keyScale, { Scale = 1 }, 0.16, Enum.EasingStyle.Back)
	end))
	element.Maid:Add(keyButton.Activated:Connect(function()
		setListening(not listening)
	end))
	element.Maid:Add(UserInputService.InputBegan:Connect(function(input, processed)
		if listening then
			if input.UserInputType == Enum.UserInputType.Keyboard then
				if input.KeyCode ~= Enum.KeyCode.Escape then
					if input.KeyCode == Enum.KeyCode.Delete or input.KeyCode == Enum.KeyCode.Backspace then
						current = nil
					else
						current = input.KeyCode
					end
					fire(opts.OnChanged, current)
				end
				setListening(false)
			end
			return
		end
		if processed then
			return
		end
		if current and input.UserInputType == Enum.UserInputType.Keyboard and input.KeyCode == current then
			fire(opts.Callback, current)
		end
	end))

	function element:Get()
		return current
	end
	function element:Set(value, silent)
		local resolved
		if typeof(value) == "EnumItem" then
			resolved = value
		elseif type(value) == "string" and value ~= "None" then
			local ok, key = pcall(function()
				return Enum.KeyCode[value]
			end)
			resolved = ok and key or nil
		end
		current = resolved
		paint(true)
		if not silent then
			fire(opts.OnChanged, current)
		end
	end
	function element:Serialize()
		return current and current.Name or "None"
	end
	registerFlag(element, opts.Flag)
	return element
end

