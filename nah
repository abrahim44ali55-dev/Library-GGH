    end)
end

function GGH_Window:_executeFullCleanup()
    if self.state == self.States.Closed then return end
    
    -- Prevent multiple closes
    self.state = self.States.Closed
    
    -- Stop all active features
    for featureName, feature in pairs(self.activeFeatures) do
        if feature and feature.Stop then
            local ok, err = pcall(function() feature:Stop() end)
            if not ok then
                warn("[GGH] Error stopping feature " .. tostring(featureName) .. ": " .. tostring(err))
            end
        end
        if feature and feature.Disable then
            pcall(function() feature:Disable() end)
        end
    end
    
    -- Restore original values where safe
    for key, original in pairs(self.originalStates) do
        -- Only restore if we have safe method
        -- This is tracked per feature
        if original.restoreFn then
            pcall(original.restoreFn, original.value)
        end
    end
    
    -- Execute registered cleanup callbacks
    for _, callback in ipairs(self.cleanupCallbacks) do
        local ok, err = pcall(callback)
        if not ok then
            warn("[GGH] Cleanup callback error: " .. tostring(err))
        end
    end
    
    -- Disconnect all connections
    for _, conn in ipairs(self.connections) do
        if conn and conn.Disconnect then
            pcall(function() conn:Disconnect() end)
        end
    end
    self.connections = {}
    
    -- Cancel threads
    for _, thread in ipairs(self.threads) do
        if thread and typeof(thread) == "thread" then
            pcall(function() task.cancel(thread) end)
        end
    end
    
    -- Remove popups, notifications
    for _, notif in ipairs(self.notifications) do
        if notif and notif.Parent then
            pcall(function() notif:Destroy() end)
        end
    end
    
    -- Animate out and destroy
    if self.mainFrame and self.mainFrame.Parent then
        self.themeModule:Tween(self.mainFrame, {Size = UDim2.fromOffset(0,0), BackgroundTransparency = 1}, 0.25)
        task.wait(0.26)
    end
    
    if self.screenGui and self.screenGui.Parent then
        self.screenGui:Destroy()
    end
    
    self.unloaded = true
    self.destroyed = true
    
    -- Clear references to prevent memory leaks
    self.tabs = {}
    self.activeFeatures = {}
    self.originalStates = {}
    self.cleanupCallbacks = {}
    self.flags = {}
end

-- Public API Methods
function GGH_Window:CreateTab(name, icon)
    -- Lazy load Tab module
    if not GGH_Tab then
        local ok, mod = pcall(require, script.Parent:FindFirstChild("GGH_Tab"))
        if not ok then
            ok, mod = pcall(require, script.Parent.Parent:FindFirstChild("GGH_Tab"))
        end
        if ok then GGH_Tab = mod end
    end
    
    if not GGH_Tab then
        -- Fallback inline tab creation if module missing
        return self:_createTabFallback(name, icon)
    end
    
    local tab = GGH_Tab.new(self, name, icon, self.theme, self.themeModule, GGH_Icons)
    table.insert(self.tabs, tab)
    
    -- Update canvas size
    self:_updateSidebarCanvas()
    
    -- Auto-select first tab
    if #self.tabs == 1 then
        self:SelectTab(tab)
    end
    
    return tab
end

