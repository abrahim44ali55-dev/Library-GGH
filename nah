		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		Visible = false,
		Active = true,
		ZIndex = 50,
	}, self.Gui)
	local dialog = make("CanvasGroup", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromOffset(310, 156),
		BorderSizePixel = 0,
		GroupTransparency = 1,
		ZIndex = 51,
	}, self.DialogOverlay)
	round(dialog, 12)
	self._dialogBox = dialog
	self._dialogScale = make("UIScale", { Scale = 0.9 }, dialog)
	local dialogStroke = outline(dialog, 1)
	local heading = make("TextLabel", {
		Position = UDim2.fromOffset(18, 16),
		Size = UDim2.new(1, -36, 0, 22),
		BackgroundTransparency = 1,
		Text = "",
		TextSize = 16,
		TextXAlignment = Enum.TextXAlignment.Left,
		ZIndex = 52,
	}, dialog)
	local message = make("TextLabel", {
		Position = UDim2.fromOffset(18, 44),
		Size = UDim2.new(1, -36, 0, 50),
		BackgroundTransparency = 1,
		Text = "",
		TextSize = 13,
		TextWrapped = true,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextYAlignment = Enum.TextYAlignment.Top,
		ZIndex = 52,
	}, dialog)

	local function dialogButton(xScale, onClick)
		local button = make("TextButton", {
			AnchorPoint = Vector2.new(xScale, 1),
			Position = UDim2.new(xScale, xScale == 0 and 18 or -18, 1, -16),
			Size = UDim2.new(0.5, -24, 0, 34),
			Text = "",
			TextSize = 13,
			AutoButtonColor = false,
			BorderSizePixel = 0,
			ZIndex = 52,
		}, dialog)
		round(button, 9)
		local scale = make("UIScale", {}, button)
		self._cleanup:Add(button.MouseEnter:Connect(function()
			tween(button, { BackgroundTransparency = 0.18 }, 0.12)
		end))
		self._cleanup:Add(button.MouseLeave:Connect(function()
			tween(button, { BackgroundTransparency = 0 }, 0.12)
			tween(scale, { Scale = 1 }, 0.12, Enum.EasingStyle.Back)
		end))
		self._cleanup:Add(button.MouseButton1Down:Connect(function()
			tween(scale, { Scale = 0.94 }, 0.08)
		end))
		self._cleanup:Add(button.MouseButton1Up:Connect(function()
			tween(scale, { Scale = 1 }, 0.14, Enum.EasingStyle.Back)
		end))
		self._cleanup:Add(button.Activated:Connect(onClick))
		return button
	end

	local function dismiss(which)
		local callback = self[which]
		self._dialogConfirm = nil
		self._dialogCancel = nil
		self._confirmOpen = false
		self:_showDialog(false)
		fire(callback)
	end

	local cancelButton = dialogButton(0, function()
		dismiss("_dialogCancel")
	end)
	local confirmButton = dialogButton(1, function()
		dismiss("_dialogConfirm")
	end)
	self._dialogHeading = heading
	self._dialogMessage = message
	self._dialogCancelButton = cancelButton
	self._dialogConfirmButton = confirmButton

	self:_bind(function(theme)
		dialog.BackgroundColor3 = theme.Surface
		dialogStroke.Color = theme.Stroke
		heading.Font = Enum.Font.GothamBold
		heading.TextColor3 = theme.Text
		applyFont(message, theme.Font)
		message.TextColor3 = theme.TextDim
		applyFont(cancelButton, theme.Font)
		cancelButton.BackgroundColor3 = theme.Raised
		cancelButton.TextColor3 = theme.Text
		applyFont(confirmButton, theme.Font)
		confirmButton.BackgroundColor3 = self._dialogDanger and theme.Danger or theme.Accent
		confirmButton.TextColor3 = WHITE
	end)
end

function Window:_showDialog(show)
	self._dialogToken = self._dialogToken + 1
	local token = self._dialogToken
	if show then
		self.DialogOverlay.Visible = true
		self.DialogOverlay.BackgroundTransparency = 1
		self._dialogBox.GroupTransparency = 1
		self._dialogScale.Scale = 0.9
		tween(self.DialogOverlay, { BackgroundTransparency = 0.45 }, 0.2)
		tween(self._dialogBox, { GroupTransparency = 0 }, 0.2)
		tween(self._dialogScale, { Scale = 1 }, 0.26, Enum.EasingStyle.Back)
	else
		tween(self.DialogOverlay, { BackgroundTransparency = 1 }, 0.16)
		tween(self._dialogBox, { GroupTransparency = 1 }, 0.14)
		tween(self._dialogScale, { Scale = 0.95 }, 0.14)
		self:_after(0.18, function()
			if self._dialogToken == token then
				self.DialogOverlay.Visible = false
			end
		end)
	end
end

function Window:Confirm(opts)
	if self._destroyed or self._confirmOpen then
		return false
	end
	opts = opts or {}
	self._confirmOpen = true
	self._dialogDanger = opts.Danger == true
	self._dialogConfirm = opts.OnConfirm
	self._dialogCancel = opts.OnCancel
	self._dialogHeading.Text = opts.Title or "Confirm"
	self._dialogMessage.Text = opts.Message or ""
	self._dialogCancelButton.Text = opts.CancelText or "Cancel"
	self._dialogConfirmButton.Text = opts.ConfirmText or "OK"
	self._dialogConfirmButton.BackgroundColor3 = self._dialogDanger and self.Theme.Danger or self.Theme.Accent
	self:_showDialog(true)
	return true
end

function Window:RequestClose()
	self:Confirm({
		Title = "Close GGH?",
		Message = "Active features will be stopped and the interface will be removed completely.",
		ConfirmText = "Close",
		CancelText = "Cancel",
		Danger = true,
		OnConfirm = function()
			self:Destroy()
		end,
	})
end

function Window:_setChevron(headerOnly)
	tween(self._chevron, { Rotation = headerOnly and 180 or 0 }, 0.28, Enum.EasingStyle.Back)
end

function Window:_tweenRoot(size, onFinished)
	local finished = false
	local function finish()
		if finished or self._destroyed then
			return
		end
		finished = true
		onFinished()
	end
	self._tween = tween(self.Root, { Size = size }, METRICS.TweenTime, Enum.EasingStyle.Quint)
	self._tween.Completed:Once(finish)
	task.delay(METRICS.TweenTime + 0.15, finish)
end

function Window:SetState(target)
	if self._destroyed or self._busy or self._confirmOpen then
		return false
	end
	local from = self.State
	if not (ALLOWED[from] and ALLOWED[from][target]) then
		return false
	end

	if target == "Minimized" then
		self._returnState = from
		self._busy = true
		self.Pill.Position = self.Root.Position
		tween(self.RootScale, { Scale = 0.88 }, 0.16, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
		tween(self.Root, { GroupTransparency = 1 }, 0.16)
		self:_after(0.17, function()
			self.Root.Visible = false
			self.RootScale.Scale = 1
			self.Root.GroupTransparency = 0
			self.Pill.Visible = true
			self.PillScale.Scale = 0.7
			self.Pill.GroupTransparency = 1
			tween(self.PillScale, { Scale = 1 }, 0.24, Enum.EasingStyle.Back)
			tween(self.Pill, { GroupTransparency = 0 }, 0.16)
			self.State = "Minimized"
			self._busy = false
		end)
	elseif from == "Minimized" then
		self._busy = true
		tween(self.PillScale, { Scale = 0.7 }, 0.14)
		tween(self.Pill, { GroupTransparency = 1 }, 0.14)
		self:_after(0.15, function()
			self.Pill.Visible = false
			self.State = self._returnState
			self:_popIn()
			self:_after(0.24, function()
				self._busy = false
				if target ~= self.State then
					self:SetState(target)
				end
			end)
		end)
	elseif target == "HeaderOnly" then
		self._busy = true
		self:_setChevron(true)
		self:_tweenRoot(UDim2.fromOffset(self._width, METRICS.HeaderHeight), function()
			self.Body.Visible = false
			self.State = "HeaderOnly"
			self._busy = false
		end)
	elseif target == "Normal" then
		self._busy = true
		self.Body.Visible = true
		self:_setChevron(false)
		self:_tweenRoot(UDim2.fromOffset(self._width, self._height), function()
			self.Root.Size = UDim2.fromOffset(self._width, self._height)
			self.State = "Normal"
			self._busy = false
		end)
	end
	return true
end

function Window:SetCompact(compact)
	if self._destroyed then
		return
	end
	self._compact = compact and true or false
	local width = self._compact and METRICS.SidebarCompactWidth or METRICS.SidebarWidth
	tween(self.Sidebar, { Size = UDim2.new(0, width, 1, 0) }, 0.24, Enum.EasingStyle.Quint)
	tween(self.ContentHost, { Position = UDim2.fromOffset(width, 0), Size = UDim2.new(1, -width, 1, 0) }, 0.24, Enum.EasingStyle.Quint)
	self.Footer.Visible = not self._compact
	for _, tab in ipairs(self._tabs) do
		tab._applyCompact()
	end
end

function Window:CreateTab(title, icon)
	local window = self
	local tab = setmetatable({
		Title = title,
		Icon = icon,
		Window = window,
		_hover = false,
		_down = false,
		_order = 0,
		_elements = {},
	}, Tab)

	tab.Button = make("TextButton", {
		Name = "Tab_" .. title,
		LayoutOrder = #self._tabs + 1,
		Size = UDim2.new(1, 0, 0, 38),
		Text = "",
		AutoButtonColor = false,
		BorderSizePixel = 0,
	}, self.TabList)
	round(tab.Button, 9)
	local buttonScale = make("UIScale", {}, tab.Button)
	local accentBar = make("Frame", {
		AnchorPoint = Vector2.new(0, 0.5),
		Position = UDim2.new(0, 3, 0.5, 0),
		Size = UDim2.fromOffset(3, 0),
		BorderSizePixel = 0,
	}, tab.Button)
	round(accentBar, 2)
	local iconHolder = make("Frame", {
		Name = "IconSlot",
		Position = UDim2.fromOffset(12, 9),
		Size = UDim2.fromOffset(20, 20),
		BackgroundTransparency = 1,
	}, tab.Button)
	local label = make("TextLabel", {
		BackgroundTransparency = 1,
		Text = title,
		TextSize = 13,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextTruncate = Enum.TextTruncate.AtEnd,
	}, tab.Button)

	tab.Page = make("CanvasGroup", {
		Name = "Page_" .. title,
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		Visible = false,
	}, self.ContentHost)
	tab.Content = make("ScrollingFrame", {
		Name = "Scroll",
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ScrollBarThickness = 3,
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		CanvasSize = UDim2.new(),
	}, tab.Page)
	make("UIListLayout", { Padding = UDim.new(0, 8), SortOrder = Enum.SortOrder.LayoutOrder }, tab.Content)
	make("UIPadding", {
		PaddingTop = UDim.new(0, 12),
		PaddingBottom = UDim.new(0, 12),
		PaddingLeft = UDim.new(0, 12),
		PaddingRight = UDim.new(0, 14),
	}, tab.Content)

	local hasIcon = icon ~= nil and Icons.Has(icon)
	local drawnIcon
	if hasIcon then
		drawnIcon = Icons.Draw(icon, iconHolder, window.Theme.TextDim)
	end

	function tab._applyCompact()
		iconHolder.Visible = hasIcon
		if window._compact and not hasIcon then
			label.TextXAlignment = Enum.TextXAlignment.Center
			label.Position = UDim2.fromOffset(0, 0)
			label.Size = UDim2.fromScale(1, 1)
			label.Text = string.upper(string.sub(title, 1, 1))
			label.Visible = true
		elseif window._compact then
			label.Visible = false
		else
			label.Visible = true
			label.TextXAlignment = Enum.TextXAlignment.Left
			label.Position = UDim2.fromOffset(hasIcon and 40 or 16, 0)
			label.Size = UDim2.new(1, hasIcon and -46 or -22, 1, 0)
			label.Text = title
		end
	end

	local function refresh(animate)
		local theme = window.Theme
		local selected = window._selected == tab
		local fill, transparency = theme.Raised, 1
		if selected then
			transparency = 0
		elseif tab._down then
			fill, transparency = theme.Stroke, 0
		elseif tab._hover then
			fill, transparency = theme.Hover, 0
		end
		paintProps(tab.Button, { BackgroundColor3 = fill, BackgroundTransparency = transparency }, animate, 0.16)
		paintProps(accentBar, { BackgroundColor3 = theme.Accent, Size = UDim2.fromOffset(3, selected and 18 or 0) }, animate, 0.22, Enum.EasingStyle.Back)
		applyFont(label, theme.Font)
		paintProps(label, { TextColor3 = selected and theme.Text or (tab._hover and theme.Text or theme.TextDim) }, animate, 0.16)
		tab.Content.ScrollBarImageColor3 = theme.Stroke
		if drawnIcon then
			Icons.Tween(drawnIcon, selected and theme.Accent or theme.TextDim, animate and 0.16 or 0)
		end
		paintProps(buttonScale, { Scale = tab._down and 0.96 or 1 }, animate, 0.12, Enum.EasingStyle.Back)
	end
	tab._refresh = refresh

	self._cleanup:Add(tab.Button.MouseEnter:Connect(function()
		tab._hover = true
		refresh(true)
	end))
	self._cleanup:Add(tab.Button.MouseLeave:Connect(function()
		tab._hover = false
		tab._down = false
		refresh(true)
	end))
	self._cleanup:Add(tab.Button.MouseButton1Down:Connect(function()
		tab._down = true
		refresh(true)
	end))
	self._cleanup:Add(tab.Button.MouseButton1Up:Connect(function()
		tab._down = false
		refresh(true)
	end))
	self._cleanup:Add(tab.Button.Activated:Connect(function()
		window:SelectTab(tab)
	end))

	table.insert(self._tabs, tab)
	tab._bindId = self:_bind(function()
		refresh(false)
	end)
	tab._applyCompact()
	if not self._selected then
		self:SelectTab(tab)
	end
	return tab
end

function Window:SelectTab(tab)
	if self._destroyed or self._selected == tab or not table.find(self._tabs, tab) then
		return
	end
	local previous = self._selected
	self._selected = tab
	if previous then
		previous.Page.Visible = false
	end
	tab.Page.Position = UDim2.fromOffset(18, 0)
	tab.Page.GroupTransparency = 1
	tab.Page.Visible = true
	tween(tab.Page, { Position = UDim2.fromOffset(0, 0), GroupTransparency = 0 }, 0.26, Enum.EasingStyle.Quint)
	for _, other in ipairs(self._tabs) do
		other._refresh(true)
	end
end

function Window:RemoveTab(tab)
	local index = table.find(self._tabs, tab)
	if self._destroyed or not index then
		return
	end
	for _, element in ipairs(copyList(tab._elements)) do
		element:Destroy()
	end
	table.remove(self._tabs, index)
	self:_unbind(tab._bindId)
	if self._selected == tab then
		self._selected = nil
		local fallback = self._tabs[math.min(index, #self._tabs)]
		if fallback then
			self:SelectTab(fallback)
		end
	end
	tab.Button:Destroy()
	tab.Content:Destroy()
	tab.Page:Destroy()
end

local TOAST_COLORS = { Info = "Accent", Success = "Success", Warning = "Warning", Error = "Danger" }

function Window:Notify(opts)
	if self._destroyed then
		return
	end
	opts = opts or {}
	local theme = self.Theme
	local accent = theme[TOAST_COLORS[opts.Type or "Info"] or "Accent"]
	local duration = opts.Duration or 4
	self._notifyOrder = self._notifyOrder + 1

	local holder = make("Frame", {
		LayoutOrder = self._notifyOrder,
		Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundTransparency = 1,
	}, self.NotifyHost)
	local toast = make("CanvasGroup", {
		Position = UDim2.fromOffset(300, 0),
		Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundColor3 = theme.Surface,
		BorderSizePixel = 0,
		GroupTransparency = 1,
	}, holder)
	round(toast, 10)
	outline(toast, 1).Color = theme.Stroke
	make("Frame", {
		Size = UDim2.new(0, 3, 1, 0),
		BackgroundColor3 = accent,
		BorderSizePixel = 0,
	}, toast)
	local timer = make("Frame", {
		AnchorPoint = Vector2.new(0, 1),
		Position = UDim2.fromScale(0, 1),
		Size = UDim2.new(1, 0, 0, 2),
		BackgroundColor3 = accent,
		BackgroundTransparency = 0.35,
		BorderSizePixel = 0,
		ZIndex = 2,
	}, toast)
	local stack = make("Frame", {
		Position = UDim2.fromOffset(15, 0),
		Size = UDim2.new(1, -26, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundTransparency = 1,
	}, toast)
	make("UIListLayout", { Padding = UDim.new(0, 2), SortOrder = Enum.SortOrder.LayoutOrder }, stack)
	make("UIPadding", { PaddingTop = UDim.new(0, 11), PaddingBottom = UDim.new(0, 13) }, stack)
	local heading = make("TextLabel", {
		LayoutOrder = 1,
		Size = UDim2.new(1, 0, 0, 16),
		BackgroundTransparency = 1,
		Text = opts.Title or self.Title,
		TextSize = 13,
		TextColor3 = theme.Text,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextTruncate = Enum.TextTruncate.AtEnd,
	}, stack)
	heading.Font = Enum.Font.GothamBold
	local body = make("TextLabel", {
		LayoutOrder = 2,
		Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundTransparency = 1,
		Text = opts.Content or "",
		TextSize = 12,
		TextColor3 = theme.TextDim,
		TextWrapped = true,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextYAlignment = Enum.TextYAlignment.Top,
	}, stack)
	applyFont(body, theme.Font)

	tween(toast, { Position = UDim2.fromOffset(0, 0), GroupTransparency = 0 }, 0.32, Enum.EasingStyle.Quint)
	tween(timer, { Size = UDim2.new(0, 0, 0, 2) }, duration, Enum.EasingStyle.Linear)
	task.delay(duration, function()
		if self._destroyed or not holder.Parent then
			return
		end
		tween(toast, { Position = UDim2.fromOffset(300, 0), GroupTransparency = 1 }, 0.26, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
		task.delay(0.3, function()
			if holder.Parent then
				holder:Destroy()
			end
		end)
	end)
end

local function configPath(name)
	return "GGH/" .. tostring(name):gsub("[^%w_%-]", "_") .. ".json"
end

function Window:SaveConfig(name)
	if type(writefile) ~= "function" then
		return false, "file functions are unavailable in this environment"
	end
	local data = {}
	for flag, element in pairs(self.Flags) do
		local ok, value = pcall(element.Serialize or element.Get, element)
		if ok then
			data[flag] = value
		end
	end
	pcall(function()
		if type(isfolder) == "function" and not isfolder("GGH") then
			makefolder("GGH")
		end
	end)
	local ok, err = pcall(writefile, configPath(name), HttpService:JSONEncode(data))
	if not ok then
		return false, tostring(err)
	end
	return true
end

function Window:LoadConfig(name)
	if type(readfile) ~= "function" then
		return false, "file functions are unavailable in this environment"
	end
	local okRead, raw = pcall(readfile, configPath(name))
	if not okRead then
		return false, "config not found"
	end
	local okDecode, data = pcall(HttpService.JSONDecode, HttpService, raw)
	if not okDecode or type(data) ~= "table" then
		return false, "config file is not valid JSON"
	end
	for flag, value in pairs(data) do
		local element = self.Flags[flag]
		if element then
			pcall(element.Set, element, value, false)
		end
	end
	return true
end

local function newElement(tab, height, bare)
	local window = tab.Window
	tab._order = tab._order + 1
	local element = {
		Window = window,
		Tab = tab,
		Maid = Cleanup.new(),
		_binds = {},
		_destroyed = false,
		_hover = false,
		_down = false,
		Enabled = true,
	}
	element.Row = make("Frame", {
		Size = UDim2.new(1, 0, 0, height),
		BorderSizePixel = 0,
		LayoutOrder = tab._order,
		ClipsDescendants = true,
		BackgroundTransparency = bare and 1 or 0,
	}, tab.Content)
	local rowStroke
	if not bare then
		round(element.Row, 10)
		rowStroke = outline(element.Row, 1)
	end

	function element:Bind(apply)
		table.insert(self._binds, window:_bind(apply))
	end

	function element:Paint(animate)
		if bare then
			return
		end
		local theme = window.Theme
		local fill, line = theme.Surface, theme.Stroke
		if not self.Enabled then
			fill = theme.Background
		elseif self._down then
			fill, line = theme.Hover, theme.Accent
		elseif self._hover then
			fill, line = theme.Raised, theme.Accent:Lerp(theme.Stroke, 0.5)
		end
		paintProps(self.Row, { BackgroundColor3 = fill }, animate, 0.14)
		paintProps(rowStroke, { Color = line }, animate, 0.14)
	end
	if not bare then
		element:Bind(function()
			element:Paint(false)
		end)
	end

	function element:Interactive(hit, pressScale)
		local source = hit or self.Row
		local scale
		if pressScale then
			scale = make("UIScale", {}, self.Row)
		end
		self.Maid:Add(source.MouseEnter:Connect(function()
			self._hover = true
			self:Paint(true)
		end))
		self.Maid:Add(source.MouseLeave:Connect(function()
			self._hover = false
			self._down = false
			self:Paint(true)
			if scale then
				tween(scale, { Scale = 1 }, 0.14, Enum.EasingStyle.Back)
			end
		end))
		if hit then
			self.Maid:Add(hit.MouseButton1Down:Connect(function()
				self._down = true
				self:Paint(true)
				if scale then
					tween(scale, { Scale = pressScale }, 0.08)
				end
			end))
			self.Maid:Add(hit.MouseButton1Up:Connect(function()
				self._down = false
				self:Paint(true)
				if scale then
					tween(scale, { Scale = 1 }, 0.16, Enum.EasingStyle.Back)
				end
			end))
		end
	end

	function element:Destroy()
		if self._destroyed then
			return
		end
		self._destroyed = true
		for _, id in ipairs(self._binds) do
			window:_unbind(id)
		end
		self.Maid:Destroy()
		if self.Flag and window.Flags[self.Flag] == self then
			window.Flags[self.Flag] = nil
		end
		self.Row:Destroy()
		local index = table.find(tab._elements, self)
		if index then
			table.remove(tab._elements, index)
		end
	end

	table.insert(tab._elements, element)
	return element
end

local function registerFlag(element, flag)
	if not flag then
		return
	end
	local window = element.Window
	if window.Flags[flag] then
		warn("GGH: duplicate flag '" .. tostring(flag) .. "', the newest element replaces it")
	end
	window.Flags[flag] = element
	element.Flag = flag
end

local function titleLabel(element, text, description, reserve, topHeight)
	local title = make("TextLabel", {
		BackgroundTransparency = 1,
