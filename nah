    main.LayoutOrder = #tab.components + 1
    themeModule:CreateCorner(main, theme.Radius.Medium)
    themeModule:CreateStroke(main, theme.Border, 1, 0.3)
    
    local title = Instance.new("TextLabel")
    title.Size = UDim2.new(1, -90, 0, 16)
    title.Position = UDim2.new(0, 12, 0.5, 0)
    title.AnchorPoint = Vector2.new(0, 0.5)
    title.BackgroundTransparency = 1
    title.Text = props.Name or "Keybind"
    title.TextColor3 = theme.TextPrimary
    title.TextXAlignment = Enum.TextXAlignment.Left
    title.Font = Enum.Font.GothamMedium
    title.TextSize = 13
    title.Parent = main
    
    local keyFrame = Instance.new("Frame")
    keyFrame.Size = UDim2.fromOffset(70, 26)
    keyFrame.Position = UDim2.new(1, -80, 0.5, 0)
    keyFrame.AnchorPoint = Vector2.new(0, 0.5)
    keyFrame.BackgroundColor3 = theme.BackgroundSecondary or Color3.fromRGB(22,22,28)
    keyFrame.BorderSizePixel = 0
    keyFrame.Parent = main
    themeModule:CreateCorner(keyFrame, theme.Radius.Small)
    themeModule:CreateStroke(keyFrame, theme.Border, 1, 0.2)
    
    local keyLabel = Instance.new("TextLabel")
    keyLabel.Size = UDim2.fromScale(1,1)
    keyLabel.BackgroundTransparency = 1
    keyLabel.Text = tostring(currentKey)
    keyLabel.TextColor3 = theme.TextPrimary
    keyLabel.Font = Enum.Font.GothamMedium
    keyLabel.TextSize = 11
    keyLabel.Parent = keyFrame
    
    local button = Instance.new("TextButton")
    button.Size = UDim2.fromScale(1,1)
    button.BackgroundTransparency = 1
    button.Text = ""
    button.Parent = main
    
    local listening = false
    local connection
    
    local function setKey(newKey)
        currentKey = newKey
        keyLabel.Text = tostring(newKey)
        if props.Flag then window.flags[props.Flag] = newKey end
        if props.Callback or props.callback then
            local cb = props.Callback or props.callback
            window:_runGuarded({Name = main.Name, Key = newKey}, function()
                cb(newKey)
            end)
        end
    end
    
    window:Connect(button.MouseButton1Click, function()
        if listening then return end
        listening = true
        keyLabel.Text = "..."
        themeModule:Tween(keyFrame, {BackgroundColor3 = theme.Accent}, 0.15)
        themeModule:Tween(keyLabel, {TextColor3 = Color3.fromRGB(255,255,255)}, 0.15)
        
        if connection then connection:Disconnect() end
        connection = UserInputService.InputBegan:Connect(function(input, gp)
            if not listening then return end
            if gp then return end
            if input.UserInputType == Enum.UserInputType.Keyboard then
                if input.KeyCode == Enum.KeyCode.Escape then
                    -- Cancel
                    listening = false
                    keyLabel.Text = tostring(currentKey)
                    themeModule:Tween(keyFrame, {BackgroundColor3 = theme.BackgroundSecondary}, 0.15)
                    themeModule:Tween(keyLabel, {TextColor3 = theme.TextPrimary}, 0.15)
                    if connection then connection:Disconnect() end
                else
                    listening = false
                    setKey(input.KeyCode.Name)
                    themeModule:Tween(keyFrame, {BackgroundColor3 = theme.BackgroundSecondary}, 0.15)
                    themeModule:Tween(keyLabel, {TextColor3 = theme.TextPrimary}, 0.15)
                    if connection then connection:Disconnect() end
                end
            end
        end)
        
        window:RegisterCleanup(function()
            if connection then connection:Disconnect() end
        end)
    end)
    
    table.insert(tab.components, main)
    
    local api = {}
    api.Frame = main
    function api:Set(key)
        setKey(key)
    end
    function api:Get()
        return currentKey
    end
    function api:Destroy()
        if connection then connection:Disconnect() end
        if main.Parent then main:Destroy() end
    end
    
    return api
end

