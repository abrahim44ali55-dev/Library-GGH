function Tab:AddConsole(opts)
	opts = opts or {}
	local window = self.Window
	local maxLines = opts.MaxLines or 200
	local element = newElement(self, opts.Height or 140)
	local scroll = make("ScrollingFrame", {
		Position = UDim2.fromOffset(8, 8),
		Size = UDim2.new(1, -16, 1, -16),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ScrollBarThickness = 3,
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		CanvasSize = UDim2.new(),
	}, element.Row)
	make("UIListLayout", { SortOrder = Enum.SortOrder.LayoutOrder }, scroll)
	local lines = {}
	local counter = 0
	local colorKeys = { Info = "Text", Success = "Success", Warning = "Warning", Error = "Danger" }
	element:Bind(function(theme)
		scroll.ScrollBarImageColor3 = theme.Stroke
		for _, entry in ipairs(lines) do
			applyFont(entry.label, theme.Font)
			entry.label.TextColor3 = theme[colorKeys[entry.kind] or "Text"]
		end
	end)
	function element:Log(text, kind)
		kind = colorKeys[kind] and kind or "Info"
		counter = counter + 1
		local label = make("TextLabel", {
			LayoutOrder = counter,
			Size = UDim2.new(1, 0, 0, 0),
			AutomaticSize = Enum.AutomaticSize.Y,
			BackgroundTransparency = 1,
			Text = tostring(text),
			TextSize = 11,
			TextWrapped = true,
			TextXAlignment = Enum.TextXAlignment.Left,
			TextYAlignment = Enum.TextYAlignment.Top,
		}, scroll)
		applyFont(label, window.Theme.Font)
		label.TextColor3 = window.Theme[colorKeys[kind]]
		table.insert(lines, { label = label, kind = kind })
		if #lines > maxLines then
			local oldest = table.remove(lines, 1)
			oldest.label:Destroy()
		end
		scroll.CanvasPosition = Vector2.new(0, math.max(0, scroll.AbsoluteCanvasSize.Y))
	end
	function element:Clear()
		for _, entry in ipairs(lines) do
			entry.label:Destroy()
		end
		lines = {}
	end
	return element
end

function Window:Destroy()
	if self._destroyed then
		return
	end
	self._destroyed = true
	self.State = "Closed"
	if self._tween then
		self._tween:Cancel()
	end
	for _, tab in ipairs(copyList(self._tabs)) do
		for _, element in ipairs(copyList(tab._elements)) do
			pcall(element.Destroy, element)
		end
	end
	self._cleanup:Destroy()
	self._binds = {}
	self._tabs = {}
	self._selected = nil
	self.Flags = {}
	local index = table.find(GGH.Windows, self)
	if index then
		table.remove(GGH.Windows, index)
	end
	fire(self._onClose)
end

function GGH.CreateWindow(config)
	return Window.new(config)
end

function GGH.Unload()
	for _, window in ipairs(copyList(GGH.Windows)) do
		window:Destroy()
	end
end

return GGH
