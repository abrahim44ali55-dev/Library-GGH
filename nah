function GGH_Components.CreateToggle(tab, props)
    props = props or {}
    local theme = tab.theme
    local themeModule = tab.themeModule
    local window = tab.window
    local name = props.Name or props.name or "Toggle"
    local desc = props.Description or props.description

    local currentValue = props.CurrentValue
    if currentValue == nil then currentValue = props.currentValue end
    if currentValue == nil then currentValue = props.Default end
    currentValue = currentValue == true

    local main, stroke = createCard(tab, name, 46)

    makeLabel(main, name, theme.TextPrimary, Enum.Font.GothamMedium, 13,
        UDim2.new(1, -70, 0, 18), UDim2.new(0, 12, 0, desc and 8 or 14)).Name = "Title"
    if desc then
        makeLabel(main, desc, theme.TextSecondary, Enum.Font.Gotham, 11,
            UDim2.new(1, -70, 0, 12), UDim2.new(0, 12, 0, 26)).Name = "Description"
    end

    local onColor = theme.ToggleOn or theme.Accent
    local offColor = theme.ToggleOff or Color3.fromRGB(50, 50, 65)

    local track = Instance.new("Frame")
    track.Name = "Track"
    track.Size = UDim2.fromOffset(44, 24)
    track.Position = UDim2.new(1, -56, 0.5, 0)
    track.AnchorPoint = Vector2.new(0, 0.5)
    track.BackgroundColor3 = currentValue and onColor or offColor
    track.BorderSizePixel = 0
    track.Parent = main
    themeModule:CreateCorner(track, 12)

    local thumb = Instance.new("Frame")
    thumb.Name = "Thumb"
    thumb.Size = UDim2.fromOffset(18, 18)
    thumb.Position = currentValue and UDim2.new(1, -21, 0.5, 0) or UDim2.new(0, 3, 0.5, 0)
    thumb.AnchorPoint = Vector2.new(0, 0.5)
    thumb.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
    thumb.BorderSizePixel = 0
    thumb.Parent = track
    themeModule:CreateCorner(thumb, 9)

    local button = makeClickArea(main)

    local function updateVisual(value, animate)
        currentValue = value
        local targetColor = value and onColor or offColor
        local targetPos = value and UDim2.new(1, -21, 0.5, 0) or UDim2.new(0, 3, 0.5, 0)
        if animate then
            themeModule:Tween(track, {BackgroundColor3 = targetColor}, 0.25)
            themeModule:Tween(thumb, {Position = targetPos}, 0.25)
        else
            track.BackgroundColor3 = targetColor
            thumb.Position = targetPos
        end
    end

    local featureKey = "toggle_" .. nextId()
    local function registerFeature(on)
        if on then
            window:RegisterFeature(featureKey, {
                Stop = function()
                    updateVisual(false, false)
                    local cb = getCallback(props)
                    if cb then cb(false) end
                end
            })
        else
            window:UnregisterFeature(featureKey)
        end
    end

    local function setValue(value, callCallback)
        value = value == true
        updateVisual(value, true)
        registerFeature(value)
        window:_setFlag(props.Flag, value)
        if callCallback then
            fireCallback(window, name, getCallback(props), value)
        end
    end

    window:Connect(button.MouseButton1Click, function()
        setValue(not currentValue, true)
    end)
    window:Connect(button.MouseEnter, function()
        themeModule:Tween(stroke, {Transparency = 0, Color = theme.BorderHover or theme.Border}, 0.15)
    end)
    window:Connect(button.MouseLeave, function()
        themeModule:Tween(stroke, {Transparency = 0.3, Color = theme.Border}, 0.15)
    end)

    window:_setFlag(props.Flag, currentValue, true)
    if currentValue then registerFeature(true) end
    table.insert(tab.components, main)

    local api = {}
    api.Frame = main
    api.Name = name
    function api:Set(value) setValue(value, false) end
    function api:SetValue(value) setValue(value, true) end
    function api:Get() return currentValue end
    function api:Destroy()
        window:UnregisterFeature(featureKey)
        if main.Parent then main:Destroy() end
    end
    if props.Flag then
        window.flagSetters[props.Flag] = function(v) setValue(v, true) end
    end
    return api
end

