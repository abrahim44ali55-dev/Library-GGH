function GGH_Icons:Get(iconName: string): string?
    if not iconName then return nil end
    local normalized = string.lower(iconName)
    -- Check direct
    if self.Assets[normalized] then
        return self.Assets[normalized]
    end
    -- Check legacy
    if self.LegacyMap[normalized] then
        return self.Assets[self.LegacyMap[normalized]]
    end
    return nil
end

function GGH_Icons:GetRobloxAsset(iconName: string): string
    if not iconName then return "rbxassetid://0" end
    local normalized = string.lower(iconName)
    if self.RobloxAssetMap[normalized] then
        return self.RobloxAssetMap[normalized]
    end
    if self.LegacyMap[normalized] and self.RobloxAssetMap[self.LegacyMap[normalized]] then
        return self.RobloxAssetMap[self.LegacyMap[normalized]]
    end
    -- Default fallback to a generic icon
    return "rbxassetid://6031090997"
end

function GGH_Icons:Exists(iconName: string): boolean
    return self:Get(iconName) ~= nil
end

function GGH_Icons:GetAllNames(): {string}
    local names = {}
    for name, _ in pairs(self.Assets) do
        table.insert(names, name)
    end
    return names
end

-- Create a Roblox UI representation of an icon
-- This creates a Frame with proper styling that visually represents the icon
function GGH_Icons:CreateIcon(iconName: string, parent: Instance?, size: UDim2?, color: Color3?): Frame
    local iconFrame = Instance.new("Frame")
    iconFrame.Name = "GGH_Icon_" .. (iconName or "unknown")
    iconFrame.BackgroundTransparency = 1
    iconFrame.Size = size or UDim2.fromOffset(20, 20)
    iconFrame.BorderSizePixel = 0
    
    if parent then
        iconFrame.Parent = parent
    end
    
    -- For ggh_logo, create custom GGH logo using Roblox UI
    if iconName == "ggh_logo" then
        iconFrame.Size = size or UDim2.fromOffset(32, 32)
        -- Background glow
        local glow = Instance.new("Frame")
        glow.Name = "Glow"
        glow.BackgroundColor3 = Color3.fromRGB(56, 189, 248)
        glow.BackgroundTransparency = 0.85
        glow.Size = UDim2.fromScale(1.2, 1.2)
        glow.Position = UDim2.fromScale(0.5, 0.5)
        glow.AnchorPoint = Vector2.new(0.5, 0.5)
        glow.Parent = iconFrame
        local glowCorner = Instance.new("UICorner")
        glowCorner.CornerRadius = UDim.new(0, 8)
        glowCorner.Parent = glow
        
        -- GGH Text representation
        local textContainer = Instance.new("Frame")
        textContainer.Name = "LogoContainer"
        textContainer.BackgroundTransparency = 1
        textContainer.Size = UDim2.fromScale(1, 1)
        textContainer.Parent = iconFrame
        
        local gghLabel = Instance.new("TextLabel")
        gghLabel.Name = "GGH"
        gghLabel.BackgroundTransparency = 1
        gghLabel.Size = UDim2.fromScale(1, 1)
        gghLabel.Text = "GGH"
        gghLabel.TextColor3 = color or Color3.fromRGB(255, 255, 255)
        gghLabel.TextScaled = true
        gghLabel.Font = Enum.Font.GothamBold
        gghLabel.Parent = textContainer
        
        -- Accent dots
        local topAccent = Instance.new("Frame")
        topAccent.Name = "TopAccent"
        topAccent.BackgroundColor3 = Color3.fromRGB(56, 189, 248)
        topAccent.Size = UDim2.fromOffset(4, 4)
        topAccent.Position = UDim2.new(0.5, 0, 0, 2)
        topAccent.AnchorPoint = Vector2.new(0.5, 0)
        topAccent.Parent = textContainer
        local topCorner = Instance.new("UICorner")
        topCorner.CornerRadius = UDim.new(1, 0)
        topCorner.Parent = topAccent
        
        local bottomAccent = topAccent:Clone()
        bottomAccent.Name = "BottomAccent"
        bottomAccent.Position = UDim2.new(0.5, 0, 1, -6)
        bottomAccent.Parent = textContainer
        
    else
        -- For other icons, use TextLabel with Unicode or ImageLabel fallback
        local iconLabel = Instance.new("ImageLabel")
        iconLabel.Name = "IconImage"
        iconLabel.BackgroundTransparency = 1
        iconLabel.Size = UDim2.fromScale(1, 1)
        iconLabel.Image = self:GetRobloxAsset(iconName)
        iconLabel.ImageColor3 = color or Color3.fromRGB(255, 255, 255)
        iconLabel.ScaleType = Enum.ScaleType.Fit
        iconLabel.Parent = iconFrame
        
        -- Store SVG reference as attribute for debugging / future rendering
        iconFrame:SetAttribute("SVG_Source", self:Get(iconName) or "")
        iconFrame:SetAttribute("IconName", iconName)
    end
    
    return iconFrame
end

-- Apply icon to existing ImageLabel (for compatibility)
function GGH_Icons:ApplyToImageLabel(imageLabel: ImageLabel, iconName: string, color: Color3?)
    if not imageLabel or not imageLabel:IsA("ImageLabel") then return end
    local asset = self:GetRobloxAsset(iconName)
    imageLabel.Image = asset
    if color then
        imageLabel.ImageColor3 = color
    end
    imageLabel:SetAttribute("GGH_Icon", iconName)
    imageLabel:SetAttribute("SVG_Asset", self:Get(iconName) or "")
end

-- Replace external links cleanup
function GGH_Icons:CleanupExternalReferences(gui: Instance)
    -- This function would scan for any old external asset references
    -- and replace them with local GGH assets
    -- Implementation is defensive - no external calls
    if not gui then return end
    for _, descendant in ipairs(gui:GetDescendants()) do
        if descendant:IsA("ImageLabel") or descendant:IsA("ImageButton") then
            local img = descendant.Image
            if img and (string.find(img, "http://") or string.find(img, "https://")) then
                -- Replace external HTTP links with local fallback
                if string.find(string.lower(descendant.Name), "logo") then
                    descendant.Image = self:GetRobloxAsset("ggh_logo")
                else
                    descendant.Image = self:GetRobloxAsset("settings")
                end
            end
        end
    end
end

return GGH_Icons

end)()

