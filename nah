    config.Subtitle = config.Subtitle or "Developed by AM_BRCR7"
    config.Theme = config.Theme or "GGH Dark"
    config.Size = config.Size or UDim2.fromOffset(650, 480)
    config.Position = config.Position or UDim2.fromScale(0.5, 0.5)
    config.ToggleUIKeybind = config.ToggleUIKeybind or Enum.KeyCode.K
    
    local window = GGH_Window.new(config, {
        Theme = GGH_Theme,
        Icons = GGH_Icons,
        Tab = GGH_Tab,
        Components = GGH_Components
    })
    
    function window:_runGuarded(context, callback)
        local success, err = pcall(callback)
        if not success then
            warn("[GGH] Error in " .. (context.Name or "unknown") .. ": " .. tostring(err))
            self:Notify({
                Title = "GGH Error",
                Content = "Error in " .. (context.Name or "component") .. ": " .. tostring(err):sub(1, 100),
                Duration = 5
            })
        end
        return success
    end
    
    function window:_settled()
        return self.state ~= self.States.Closed and not self.destroyed
    end
    
    function window:_interactive()
        return self:_settled() and self.state ~= self.States.Minimized
    end
    
    return window
end

function GGH.CreateWindow(_, config)
    return GGH:CreateWindow(config)
end

function GGH:GetIdentity()
    return {
        Name = self.Name,
        DisplayName = self.DisplayName,
        Developer = self.Developer,
        Version = self.Version,
        Identity = self.Identity
    }
end

return GGH
