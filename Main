local BASE_URL = "https://raw.githubusercontent.com/abrahim44ali55-dev/Library-GGH/main/"
local moduleCache = {}

local function loadModule(path)
	if moduleCache[path] ~= nil then
		return moduleCache[path]
	end

	local fetched, source = pcall(function()
		return game:HttpGet(BASE_URL .. path)
	end)
	if not fetched or type(source) ~= "string" or source == "" then
		error("[GGH v1.9] Could not fetch module " .. path .. ": " .. tostring(source), 0)
	end

	local compiled, chunk, compileError = pcall(loadstring, source)
	if not compiled or type(chunk) ~= "function" then
		error("[GGH v1.9] Could not compile module " .. path .. ": " .. tostring(compileError or chunk), 0)
	end

	local executed, module = pcall(chunk)
	if not executed then
		error("[GGH v1.9] Module failed during initialization (" .. path .. "): " .. tostring(module), 0)
	end
	if module == nil then
		error("[GGH v1.9] Module returned no value: " .. path, 0)
	end

	moduleCache[path] = module
	return module
end

local success, result = pcall(function()
	local core = loadModule("GGH/Core.lua")
	local GGH = core.new()
	local modules = {
		Themes = loadModule("GGH/Themes.lua"),
		ConnectionBag = loadModule("GGH/Systems/ConnectionBag.lua"),
		Viewport = loadModule("GGH/Systems/Viewport.lua"),
		ElementRegistry = loadModule("GGH/Elements/Registry.lua"),
	}

	modules.Icons = loadModule("GGH/Icons.lua")(GGH)
	modules.Utils = loadModule("GGH/Utils.lua")(GGH)
	loadModule("GGH/Window.lua")(GGH, modules)
	loadModule("GGH/Systems/KeySystem.lua")(GGH, modules)
	return GGH
end)

if not success then
	error("[GGH v1.9] Initialization failed: " .. tostring(result), 0)
end

return result