local function GoToRefillStation()
    if isGoingToRefill == true then return end
    isGoingToRefill = true
    mainButton.Text = "GO REFILL..."
    mainButton.BackgroundColor3 = Color3.fromRGB(255, 100, 0)
    strokeInstance.Color = Color3.fromRGB(255, 255, 0)
    local hrp = getHumanoidRootPartFunctionHelper()
    if hrp == nil then isGoingToRefill = false return end
    pcall(function()
        local tween = TweenService:Create(hrp, TweenInfo.new(1.2, Enum.EasingStyle.Linear), {CFrame = REFILL_CFRAME})
        tween:Play()
        tween.Completed:Wait()
    end)
    pcall(function() hrp.CFrame = REFILL_CFRAME end)
    local arrived = false
    for i = 1, 50 do
        task.wait(0.1)
        local cur = getHumanoidRootPartFunctionHelper()
        if cur and (cur.Position - REFILL_CFRAME.Position).Magnitude < 15 then arrived = true break end
    end
    if arrived then
        mainButton.Text = "ARRIVED! 0.7s"
        task.wait(0.7)
        mainButton.Text = "PRESS R"
        PressROnce()
        mainButton.Text = "WAIT 4s"
        task.wait(4)
    end
    isGoingToRefill = false
    isReloadingBlade = false
    if isEnabled then
        mainButton.Text = "AUTO BROKEN ONLY"
        mainButton.BackgroundColor3 = Color3.fromRGB(0, 170, 0)
        strokeInstance.Color = Color3.fromRGB(255, 255, 255)
    end
end

