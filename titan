local function experimentalPullAllMapDoubleJumpNoclip()
    enableNoClipForPlayerFunctionHelper()
    enableNoTouchFunctionHelper()
    startAutoSlash005NonStopFunctionHelper()
    startSmartBladeCheckLoop()
    startDoubleJumpNonStopTillAllDead()
    local lastSizeChangeTime = tick()
    local pulseState = true
    heartbeatConnectionVariable = RunServiceService.Heartbeat:Connect(function()
        if not isEnabled then return end
        local hrpLocal = getHumanoidRootPartFunctionHelper()
        if hrpLocal == nil then return end
        local titansFolderLocal = WorkspaceService:FindFirstChild("Titans") or workspace:FindFirstChild("Titans")
        if titansFolderLocal == nil then return end
        local aliveCount = 0
        local angleStep = 0
        if tick() - lastSizeChangeTime >= SIZE_CHANGE_INTERVAL_SETTING then lastSizeChangeTime = tick() pulseState = not pulseState end
        for _, titan in pairs(titansFolderLocal:GetChildren()) do
            if isTitanAliveFunctionHelper(titan) then
                local nape = getNapeFromTitanFunctionHelper(titan)
                local hum = getHumanoidFromTitanFunctionHelper(titan)
                if nape ~= nil and hum ~= nil then
                    aliveCount = aliveCount + 1
                    pcall(function() nape.Anchored = true end)
                    local angle = angleStep * (360 / math.max(1, aliveCount))
                    angleStep = angleStep + 1
                    local offsetX = math.cos(math.rad(angle)) * PULL_DISTANCE_SETTING
                    local offsetZ = math.sin(math.rad(angle)) * PULL_DISTANCE_SETTING
                    local targetPos = hrpLocal.Position + Vector3.new(offsetX, -1, offsetZ)
                    pcall(function() titan:PivotTo(CFrame.new(targetPos, Vector3.new(hrpLocal.Position.X, targetPos.Y, hrpLocal.Position.Z))) end)
                    local distanceToPlayer = (targetPos - hrpLocal.Position).Magnitude
                    local dynamicSize = pulseState and (distanceToPlayer * 2.6 + HITBOX_HEIGHT_FROM_PLAYER_SETTING + 10) or (distanceToPlayer * 1.3 + 5)
                    if dynamicSize < 12 then dynamicSize = 12 end
                    if dynamicSize > 500 then dynamicSize = 500 end
                    pcall(function()
                        nape.CFrame = hrpLocal.CFrame + Vector3.new(0, HITBOX_HEIGHT_FROM_PLAYER_SETTING, 0)
                        nape.Size = Vector3.new(dynamicSize, dynamicSize, dynamicSize)
                        nape.Transparency = 0.32
                        nape.CanCollide = false
                        nape.CanTouch = true
                    end)
                end
            end
        end
        if isEnabled then
            if aliveCount > 0 then mainButton.Text = "AUTO:"..tostring(aliveCount).." BROKEN ONLY"
            else mainButton.Text = "ALL DEAD! RETRY" end
        end
    end)
    while isEnabled do
        task.wait(0.5)
        local titansFolderCheck = WorkspaceService:FindFirstChild("Titans") or workspace:FindFirstChild("Titans")
        local aliveCheck = 0
        if titansFolderCheck then for _, titan in pairs(titansFolderCheck:GetChildren()) do if isTitanAliveFunctionHelper(titan) then aliveCheck = aliveCheck + 1 end end end
        if aliveCheck == 0 then
            mainButton.Text = "ALL DEAD! WAITING RETRY"
            local retryFound = false
            for i = 1, 30 do task.wait(1) pcall(function() local retryBtn = game.Players.LocalPlayer.PlayerGui.Interface.Rewards.Main.Info.Main.Buttons.Retry if retryBtn and retryBtn.Visible then retryFound = true end end) if retryFound then break end end
            PressRetryButtonToJoinNewGame()
            break
        end
    end
end

