local function getCharacterFunctionHelper()
    local character = localPlayer.Character
    if character == nil then character = localPlayer.CharacterAdded:Wait() end
    return character
end

local function getHumanoidRootPartFunctionHelper()
    local character = getCharacterFunctionHelper()
    if character == nil then return nil end
    return character:FindFirstChild("HumanoidRootPart") or character:WaitForChild("HumanoidRootPart", 5)
end

local function getNapeFromTitanFunctionHelper(titan)
    if titan == nil then return nil end
    local success, result = pcall(function() return titan.Hitboxes.Hit.Nape end)
    if success and result then return result end
    return titan:FindFirstChild("Nape", true)
end

local function getHumanoidFromTitanFunctionHelper(titan)
    if titan == nil then return nil end
    return titan:FindFirstChildOfClass("Humanoid")
end

local function isTitanAliveFunctionHelper(titan)
    if titan == nil or titan.Parent == nil then return false end
    local humanoid = getHumanoidFromTitanFunctionHelper(titan)
    if humanoid == nil or humanoid.Health <= 0 then return false end
    return true
end

local function Blade_Check_Function_Real()
    local character = localPlayer.Character
    if character == nil then return false end
    local brokenCount = 0
    local totalCount = 0
    for _, rig in pairs(character:GetChildren()) do
        if rig.Name:find("Rig_") or rig.Name:find("Rig") then
            for _, handName in pairs({"LeftHand", "RightHand"}) do
                local hand = rig:FindFirstChild(handName)
                if hand ~= nil then
                    for bladeIndex = 1, 7 do
                        local blade = hand:FindFirstChild("Blade_" .. tostring(bladeIndex))
                        if blade ~= nil then
                            totalCount = totalCount + 1
                            local brokenAttribute = nil
                            pcall(function() brokenAttribute = blade:GetAttribute("Broken") end)
                            if brokenAttribute == true then brokenCount = brokenCount + 1 end
                        end
                    end
                end
            end
        end
    end
    if totalCount == 0 then return false end
    if brokenCount >= totalCount then return true end
    return false
end

