local function PressRetryButtonToJoinNewGame()
    mainButton.Text = "FOUND RETRY! CLICKING..."
    local pressed = false
    pcall(function()
        local retryBtn = game.Players.LocalPlayer.PlayerGui.Interface.Rewards.Main.Info.Main.Buttons.Retry
        if retryBtn ~= nil then
            if getconnections ~= nil then
                for _, conn in pairs(getconnections(retryBtn.MouseButton1Click)) do conn:Fire() pressed = true end
                for _, conn in pairs(getconnections(retryBtn.Activated)) do conn:Fire() pressed = true end
            end
            if pressed == false and firesignal ~= nil then firesignal(retryBtn.MouseButton1Click) pressed = true end
            if pressed == false then
                local absPos = retryBtn.AbsolutePosition
                local absSize = retryBtn.AbsoluteSize
                local x = absPos.X + absSize.X/2
                local y = absPos.Y + absSize.Y/2
                VirtualInputManagerService:SendMouseButtonEvent(x, y, 0, true, game, 0)
                task.wait(0.1)
                VirtualInputManagerService:SendMouseButtonEvent(x, y, 0, false, game, 0)
                pressed = true
            end
        end
    end)
    if pressed == false then
        mainButton.Text = "RETRY NOT FOUND! TELEPORT"
        task.wait(1)
        pcall(function() TeleportServiceService:Teleport(game.PlaceId, localPlayer) end)
    else
        mainButton.Text = "RETRY PRESSED! NEW GAME"
    end
    return pressed
end

local function enableNoClipForPlayerFunctionHelper()
    if noclipConnectionVariable then noclipConnectionVariable:Disconnect() end
    noclipConnectionVariable = RunServiceService.Stepped:Connect(function()
        if not isEnabled then return end
        local character = localPlayer.Character
        if character == nil then return end
        for _, part in pairs(character:GetDescendants()) do if part:IsA("BasePart") and part.CanCollide then part.CanCollide = false end end
    end)
end

local function disableNoClipForPlayerFunctionHelper()
    if noclipConnectionVariable then noclipConnectionVariable:Disconnect() noclipConnectionVariable = nil end
end

local function enableNoTouchFunctionHelper()
    if noTouchConnectionVariable then noTouchConnectionVariable:Disconnect() end
    noTouchConnectionVariable = RunServiceService.Heartbeat:Connect(function()
        if not isEnabled then return end
        if isGoingToRefill then return end
        local titansFolder = WorkspaceService:FindFirstChild("Titans") or workspace:FindFirstChild("Titans")
        if titansFolder == nil then return end
        for _, titan in pairs(titansFolder:GetChildren()) do
            if isTitanAliveFunctionHelper(titan) then
                local nape = getNapeFromTitanFunctionHelper(titan)
                for _, part in pairs(titan:GetDescendants()) do
                    if part:IsA("BasePart") then
                        if part == nape then part.CanCollide = false part.CanTouch = true part.Massless = true
                        else part.CanCollide = false part.CanTouch = false part.Massless = true end
                    end
                end
            end
        end
    end)
end

