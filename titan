local function Blade_Check_Function_Real()
    local character = localPlayer.Character
    if character == nil then return false end
    for _, rig in pairs(character:GetChildren()) do
        if rig.Name:find("Rig_") or rig.Name:find("Rig") then
            for _, handName in pairs({"LeftHand", "RightHand"}) do
                local hand = rig:FindFirstChild(handName)
                if hand ~= nil then
                    for bladeIndex = 1, 7 do
                        local blade = hand:FindFirstChild("Blade_" .. tostring(bladeIndex))
                        if blade ~= nil then
                            local brokenAttribute = nil
                            pcall(function() brokenAttribute = blade:GetAttribute("Broken") end)
                            if brokenAttribute == true then return true end
                        end
                    end
                    for _, child in pairs(hand:GetChildren()) do
                        if child.Name:find("Blade_") then
                            local brokenAttr = nil
                            pcall(function() brokenAttr = child:GetAttribute("Broken") end)
                            if brokenAttr == true then return true end
                        end
                    end
                end
            end
        end
    end
    for _, tool in pairs(character:GetDescendants()) do
        if tool.Name:find("Blade") then
            local brokenAttr = nil
            pcall(function() brokenAttr = tool:GetAttribute("Broken") end)
            if brokenAttr == true then return true end
        end
    end
    return false
end

